// rok::core::reflect - `Reflect` / `Inspect` (refs-lang 6.10, stdlib 2.12).
//
// `Reflect` is implemented by the compiler for every type (no impl in
// source; a manual one is an error): `T::type_name()`, `T::size()`,
// `T::align()` are the type's answer, constants; `x.type_name_of_val()` /
// `x.size_of_val()` are the value's: they look at the variant an `any` or
// sum value holds at run time. A type's own method of the same name wins.
//
// `Inspect` is opt-in through `#[derive(Inspect)]`, written below as a
// meta block (6.10.2): field names and types, enum variant names, dynamic
// field get / set through `any`, and the type's inherent methods. Private
// fields are listed too: deriving it is the type's consent.

/// Type facts every type has; the compiler implements it (6.10.1).
pub trait Reflect {
    /// The type's name.
    fn type_name() -> str;
    /// The type's size in bytes.
    fn size() -> usize;
    /// The type's alignment in bytes.
    fn align() -> usize;
    /// The name of `self`'s type.
    fn type_name_of_val(self) -> str;
    /// The size of `self`'s type in bytes.
    fn size_of_val(self) -> usize;
}

/// Field and method listing, opt-in through `#[derive(Inspect)]`
/// (6.10.2).
pub trait Inspect: Reflect {
    /// The field names, in declaration order.
    fn field_names() -> List<str>;
    /// The value of field `name` (of the current variant for an enum), or
    /// `none` when there is no such field.
    fn get_field(self, name: str) -> any | none;
    /// Sets field `name` to `value`; `false` when there is no such field or
    /// `value` holds another type.
    fn set_field(ref self, name: str, value: any) -> bool;
    /// The inherent methods, by name.
    fn methods() -> List<MethodInfo> {
        return methods_of::<Self>();
    }

    /// The fields with their types, in declaration order.
    fn fields() -> List<FieldInfo> {
        return fields_of::<Self>();
    }

    /// An enum's variant names, in declaration order; empty for a struct.
    fn variant_names() -> List<str> {
        return List::new();
    }

    /// The variant `self` holds (`"Circle"`); for a struct, its type name.
    fn variant_name(self) -> str {
        return self.type_name_of_val();
    }

    /// The fields `self` holds: a struct's fields, or the fields of the
    /// variant an enum value holds (`"0"`, `"1"` for a tuple variant).
    fn field_names_of_val(self) -> List<str> {
        let names: List<str> = List::new();
        for f in fields_of::<Self>() {
            names.push(f.name);
        }
        return names;
    }
}

/// One field of an `Inspect` type. `type_name` is the instantiated type
/// (`f64` for `v: T` in `Box<f64>`); `name` is `"0"`, `"1"`, .. for a
/// tuple struct; `is_pub` is true only for a plain `pub` field.
#[non_exhaustive]
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct FieldInfo {
    pub name: str;
    pub type_name: str;
    pub is_pub: bool;
}

/// One inherent method of an `Inspect` type. 6.10 names `name` / `arity` /
/// `is_static`, 2.12 `name` / `arg_types` / `return_type`: both are here.
/// `arity` and `arg_types` leave out `self`.
#[non_exhaustive]
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct MethodInfo {
    pub name: str;
    pub arity: usize;
    pub is_static: bool;
    pub arg_types: List<str>;
    pub return_type: str;
}

/// `value` as a `T`: the value when it holds a `T`; an integer of another
/// integer type when it fits in `T` (`set_field("id", 42)` on a `u64`
/// field); else `none`.
#[intrinsic("rok.any_cast")]
pub fn cast<T>(value: any) -> T | none;

// `T`'s inherent methods, one per line: `name \t static(0/1) \t return
// type \t argument types..`.
#[intrinsic("rok.method_table")]
fn method_table<T>() -> str;

/// `T`'s inherent methods, by name: the body of `Inspect::methods`.
pub(pkg) const fn methods_of<T>() -> List<MethodInfo> {
    let out: List<MethodInfo> = List::new();
    for line in method_table::<T>().split("\n") {
        if line.len() == 0 {
            continue;
        }
        let parts: List<str> = List::new();
        for p in line.split("\t") {
            parts.push(p);
        }
        let args: List<str> = List::new();
        let i: usize = 3;
        while i < parts.len() {
            args.push(parts[i]);
            i += 1;
        }
        out.push(MethodInfo {
            name: parts[0],
            arity: args.len(),
            is_static: parts[1] == "1",
            arg_types: args,
            return_type: parts[2],
        });
    }
    return out;
}

// `T`'s fields, one per line: `name \t pub(0/1) \t type`. Empty for
// anything but a struct.
#[intrinsic("rok.field_table")]
fn field_table<T>() -> str;

/// `T`'s fields with their types, in declaration order: the body of
/// `Inspect::fields`.
pub(pkg) const fn fields_of<T: Inspect>() -> List<FieldInfo> {
    let out: List<FieldInfo> = List::new();
    for line in field_table::<T>().split("\n") {
        if line.len() == 0 {
            continue;
        }
        let parts: List<str> = List::new();
        for p in line.split("\t") {
            parts.push(p);
        }
        out.push(FieldInfo { name: parts[0], type_name: parts[2], is_pub: parts[1] == "1" });
    }
    return out;
}

// The type's own fields are the struct's; an enum has none at the type
// level (`@for_fields` needs a variant), only per value: `get_field`
// and `field_names_of_val` look at the variant held. A variant's payload is
// read-only here, `set_field` on an enum is `false`. A field is boxed in
// `any` first so a `T | none` field holding `none` is not "no field".
#[impl_derive(Inspect)]
pub @derive {
    impl rok::core::reflect::Inspect for @Self {
        fn field_names() -> List<str> {
            let names: List<str> = List::new();
            @if_struct {
                @for_fields {
                    names.push(@field.name.as_str());
                }
            }
            return names;
        }

        fn get_field(self, name: str) -> any | none {
            @if_struct {
                @for_fields {
                    if name == @field.name.as_str() {
                        let held: any = self.@field;
                        return held;
                    }
                }
            }
            @if_enum {
                match self {
                    @for_variants {
                        @variant.pattern => {
                            @for_fields {
                                if name == @field.name.as_str() {
                                    let held: any = @field;
                                    return held;
                                }
                            }
                        },
                    }
                }
            }
            return none;
        }

        fn set_field(ref self, name: str, value: any) -> bool {
            @if_struct {
                @for_fields {
                    if name == @field.name.as_str() {
                        match rok::core::reflect::cast::<@field.type>(value) {
                            v: @field.type => {
                                self.@field = v;
                                return true;
                            },
                            none => {
                                return false;
                            },
                        }
                    }
                }
            }
            return false;
        }

        @if_enum {
            fn variant_name(self) -> str {
                return match self {
                    @for_variants {
                        @variant.pattern => @variant.name.as_str(),
                    }
                };
            }

            fn variant_names() -> List<str> {
                let names: List<str> = List::new();
                @for_variants {
                    names.push(@variant.name.as_str());
                }
                return names;
            }

            fn field_names_of_val(self) -> List<str> {
                let names: List<str> = List::new();
                match self {
                    @for_variants {
                        @variant.pattern => {
                            @for_fields {
                                names.push(@field.name.as_str());
                            }
                        },
                    }
                }
                return names;
            }
        }
    }
}

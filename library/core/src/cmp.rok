// rok::core::cmp - total equality, ordering and hashing.
// `PartialEq` / `PartialOrd` carry the comparison operators and
// stay with the other operator traits in `ops.rok`. `Eq` is a pure
// marker with no methods, so it has no slot.

/// Total equality: `==` is reflexive, symmetric and transitive (no NaN).
/// A marker over `PartialEq` with no methods.
pub trait Eq: PartialEq {}

/// The result of a three-way comparison.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

impl Ordering {
    /// `true` for `Less`.
    pub const fn is_lt(self) -> bool { match self { Ordering::Less => true, _ => false } }
    /// `true` for `Equal`.
    pub const fn is_eq(self) -> bool { match self { Ordering::Equal => true, _ => false } }
    /// `true` for `Greater`.
    pub const fn is_gt(self) -> bool { match self { Ordering::Greater => true, _ => false } }
    /// `Less` and `Greater` swapped; `Equal` stays.
    pub const fn reverse(self) -> Ordering {
        match self {
            Ordering::Less => Ordering::Greater,
            Ordering::Equal => Ordering::Equal,
            Ordering::Greater => Ordering::Less,
        }
    }
}

impl Debug for Ordering {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(match self {
            Ordering::Less => "Less",
            Ordering::Equal => "Equal",
            Ordering::Greater => "Greater",
        })
    }
}

/// A total order.
#[lang("ord_trait")]
pub trait Ord: PartialOrd + Eq {
    /// Compares `self` with `rhs`: `Less`, `Equal` or `Greater`.
    fn cmp(self, rhs: Self) -> Ordering;

    /// The smaller of `self` and `rhs`; `self` when they are equal.
    #[must_use]
    const fn min(self, rhs: Self) -> Self {
        if self.le(rhs) { self } else { rhs }
    }

    /// The larger of `self` and `rhs`; `rhs` when they are equal.
    #[must_use]
    const fn max(self, rhs: Self) -> Self {
        if rhs.ge(self) { rhs } else { self }
    }

    /// `low` when `self` is below it, `high` when above it, else `self`.
    /// Panics when `low > high`.
    #[must_use]
    #[track_caller]
    const fn clamp(self, low: Self, high: Self) -> Self {
        if low.gt(high) {
            panic("Ord::clamp: low > high; pass the bounds in order, `x.clamp(low, high)`");
        }
        if self.lt(low) { return low; }
        if self.gt(high) { return high; }
        self
    }
}

/// Feeds a value to a `Hasher`: equal values make the same
/// writes, so `a == b` hashes alike - what `Dict` / `Set` rely on.
#[lang("hash_trait")]
pub trait Hash: Eq {
    /// The hash of `self`; equal values hash equal.
    fn hash<H: Hasher>(self, ref h: H);
}

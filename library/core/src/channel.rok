// rok::core::channel - message passing between threads (stdlib spec
// 2.17). Multi-producer, multi-consumer (2.17.4): a `Receiver` copy
// shares the queue, and each value goes to one receiver. `recv` / `send`
// block the OS thread, `recv_async` / `for await` / `send_async` suspend
// the task (`task::park`: receivers on the `meta` address, senders one
// past it).
//
// The queue (2.17.6): a bounded channel's is a lock-free ring (Vyukov's
// MPMC: per-slot stamps, CAS on head / tail), an unbounded one's a list
// of fixed segments behind its own lock (it grows without copying, and
// drained segments are dropped). Waiting needs no lock: a waiter counts
// itself in a wait word (`rx` / `tx`) and looks at the queue again before
// sleeping on it; a push / pop wakes only when someone is counted.

use rok::core::marker::hand_over;
use rok::core::rt::{atomic_add, atomic_cas, atomic_load, atomic_sub, atomic_xchg, key};

/// What `send` hands back when this sender was closed.
pub enum SendError<T> {
    Closed(T),
}

pub enum TrySendError<T> {
    Full(T),
    Closed(T),
}

impl<T> SendError<T> {
    pub const fn message(self) -> str { "sending on a closed channel" }
}

impl<T> TrySendError<T> {
    pub const fn message(self) -> str {
        match self {
            TrySendError::Full(_) => "sending on a full channel",
            TrySendError::Closed(_) => "sending on a closed channel",
        }
    }
}

// Errors (2.14.3) whatever `T` is: the value they carry is not shown.
impl<T> Display for SendError<T> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}

impl<T> Debug for SendError<T> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Closed(..)") }
}

impl<T> Error for SendError<T> {}

impl<T> Display for TrySendError<T> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}

impl<T> Debug for TrySendError<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            TrySendError::Full(_) => try f.write_str("Full(..)"),
            TrySendError::Closed(_) => try f.write_str("Closed(..)"),
        }
    }
}

impl<T> Error for TrySendError<T> {}

/// `try_recv_status`: nothing is queued, and a sender is still open.
pub struct Empty;

/// `try_recv_status`: nothing is queued, and every sender has closed.
pub struct Closed;

// By hand: a derive's `Closed` would also name the send errors'
// variant.
impl PartialEq for Empty { const fn eq(self, rhs: Empty) -> bool { true } }
impl Eq for Empty {}
impl Debug for Empty {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Empty") }
}
impl PartialEq for Closed { const fn eq(self, rhs: Closed) -> bool { true } }
impl Eq for Closed {}
impl Debug for Closed {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Closed") }
}

// `meta` slots.
const SENDERS: usize = 0;
/// 1: `channel_bounded(0)`, a send returns once a receiver took it.
const RENDEZVOUS: usize = 1;

// Wait words `rx` / `tx` (futex-style, `rok_sync_wait`): a sequence
// bumped on every wake, threads blocked, tasks suspended.
const SEQ: usize = 0;
const BLOCKED: usize = 1;
const SUSPENDED: usize = 2;

/// `push` result of a full bounded queue.
const FULL: usize = usize::MAX;

struct Chan<T> {
    meta: GcBuf<usize>;
    queue: Ring<T> | Segments<T>;
    /// The receiver waits here for a value or a close.
    rx: GcBuf<i32>;
    /// Senders wait here for room or for a rendezvous value to be taken.
    tx: GcBuf<i32>;
}

unsafe impl<T: Send> Send for Chan<T> {}
unsafe impl<T: Send> Sync for Chan<T> {}

impl<T> Chan<T> {
    fn senders(self) -> usize {
        atomic_load(self.meta, SENDERS, SeqCst)
    }

    fn rendezvous(self) -> bool {
        atomic_load(self.meta, RENDEZVOUS, SeqCst) == 1
    }

    /// Queue `v`; its position (rendezvous), or `FULL`.
    fn push(self, v: T) -> usize {
        match self.queue {
            q: Ring<T> => q.push(v),
            q: Segments<T> => q.push(v),
        }
    }

    /// The oldest value, waking senders waiting for room; `none` if empty.
    fn take(self) -> T | none {
        let v = match self.queue {
            q: Ring<T> => q.pop(),
            q: Segments<T> => q.pop(),
        };
        if !(v is none) {
            self.wake_senders();
        }
        v
    }

    const fn len(self) -> usize {
        match self.queue {
            q: Ring<T> => q.len(),
            q: Segments<T> => q.len(),
        }
    }

    /// Whether the value queued at `pos` has been taken.
    fn taken(self, pos: usize) -> bool {
        match self.queue {
            q: Ring<T> => atomic_load(q.head, 0, SeqCst) > pos,
            q: Segments<T> => true,
        }
    }

    /// After a push or a close.
    fn wake_receiver(self) {
        if wake_blocked(self.rx) {
            rok::core::task::unpark(self.recv_key());
        }
    }

    /// After a pop.
    fn wake_senders(self) {
        if wake_blocked(self.tx) {
            rok::core::task::unpark(self.send_key());
        }
    }

    fn recv_key(self) -> usize {
        key(self.meta)
    }

    fn send_key(self) -> usize {
        key(self.meta) + 1
    }

}

/// Wake the threads blocked on `w`; whether tasks are suspended on it.
/// Each waiter counts itself in `w` before its last look at the queue,
/// and each change to the queue is sequentially consistent before this
/// reads the counts: one of the two sees the other.
fn wake_blocked(w: GcBuf<i32>) -> bool {
    if atomic_load(w, BLOCKED, SeqCst) > 0 {
        atomic_add(w, SEQ, 1, SeqCst);
        unsafe { rok_sync_wake(w, SEQ) };
    }
    atomic_load(w, SUSPENDED, SeqCst) > 0
}

// Blocking on a wait word: `let s = enter(w)`, look at the queue once
// more, `sleep(w, s)` if still not done, then `leave(w)`.
fn enter(w: GcBuf<i32>) -> i32 {
    let s = atomic_load(w, SEQ, SeqCst);
    atomic_add(w, BLOCKED, 1, SeqCst);
    s
}

fn sleep(w: GcBuf<i32>, s: i32) {
    unsafe { rok_sync_wait(w, SEQ, s, -1) };
}

fn leave(w: GcBuf<i32>) {
    atomic_sub(w, BLOCKED, 1, SeqCst);
}

/// A bounded MPMC ring (Vyukov): a slot's stamp is `2 * pos` while the
/// producer of position `pos` may fill it, `2 * pos + 1` once filled
/// (the consumer of `pos` may take it), then `2 * (pos + cap)`. Producers
/// claim positions by CAS on `tail`, the consumer on `head`; the value
/// moves under the stamp's release / acquire.
struct Ring<T> {
    slots: GcBuf<T>;
    stamps: GcBuf<usize>;
    head: GcBuf<usize>;
    tail: GcBuf<usize>;
    /// One zeroed `T`: what a vacated slot holds (so it keeps nothing alive).
    zero: GcBuf<T>;
    cap: usize;
}

const fn ring<T>(cap: usize) -> Ring<T> {
    unsafe {
        let stamps: GcBuf<usize> = buf_new(cap);
        for i in 0..cap {
            stamps[i] = 2 * i;
        }
        Ring { slots: buf_new(cap), stamps: stamps, head: buf_new(1), tail: buf_new(1), zero: buf_new(1), cap: cap }
    }
}

impl<T> Ring<T> {
    fn len(self) -> usize {
        let h = atomic_load(self.head, 0, SeqCst);
        atomic_load(self.tail, 0, SeqCst) - h
    }

    fn push(self, v: T) -> usize {
        unsafe {
            loop {
                let pos = atomic_load(self.tail, 0, Relaxed);
                let i = pos % self.cap;
                let s = atomic_load(self.stamps, i, SeqCst);
                if s == 2 * pos {
                    if atomic_cas(self.tail, 0, pos, pos + 1, SeqCst, Relaxed) == pos {
                        self.slots[i] = v;
                        atomic_xchg(self.stamps, i, 2 * pos + 1, SeqCst);
                        return pos;
                    }
                } else if s < 2 * pos {
                    return FULL;
                }
            }
        }
    }

    fn pop(self) -> T | none {
        unsafe {
            loop {
                let pos = atomic_load(self.head, 0, Relaxed);
                let i = pos % self.cap;
                let s = atomic_load(self.stamps, i, SeqCst);
                if s == 2 * pos + 1 {
                    if atomic_cas(self.head, 0, pos, pos + 1, SeqCst, Relaxed) == pos {
                        let v = self.slots[i];
                        self.slots[i] = self.zero[0];
                        atomic_xchg(self.stamps, i, 2 * (pos + self.cap), SeqCst);
                        return v;
                    }
                } else if s < 2 * pos + 1 {
                    return none;
                }
            }
        }
    }
}

/// Slots per segment of an unbounded queue.
const SEGMENT: usize = 32;

struct Segment<T> {
    slots: GcBuf<T>;
    next: GcBuf<Segment<T> | none>;
}

const fn segment<T>() -> Segment<T> {
    unsafe {
        let next: GcBuf<Segment<T> | none> = buf_new(1);
        next[0] = none;
        Segment { slots: buf_new(SEGMENT), next: next }
    }
}

/// An unbounded FIFO behind its own lock: values enter the tail segment
/// and leave the head one; a full tail links a new segment, a drained
/// head is unlinked.
struct Segments<T> {
    lock: Mutex<i32>;
    /// `[head, tail]`.
    ends: GcBuf<Segment<T>>;
    /// `[head index, tail index, len]`.
    at: GcBuf<usize>;
    /// One zeroed `T`: what a vacated slot holds (so it keeps nothing alive).
    zero: GcBuf<T>;
}

const fn segments<T>() -> Segments<T> {
    unsafe {
        let ends: GcBuf<Segment<T>> = buf_new(2);
        let s = segment();
        ends[0] = s;
        ends[1] = s;
        Segments { lock: Mutex::new(0), ends: ends, at: buf_new(3), zero: buf_new(1) }
    }
}

impl<T> Segments<T> {
    fn len(self) -> usize {
        using g = self.lock.lock() {
            return unsafe { self.at[2] };
        }
    }

    fn push(self, v: T) -> usize {
        unsafe {
            using g = self.lock.lock() {
                if self.at[1] == SEGMENT {
                    let s = segment();
                    self.ends[1].next[0] = s;
                    self.ends[1] = s;
                    self.at[1] = 0;
                }
                self.ends[1].slots[self.at[1]] = v;
                self.at[1] += 1;
                self.at[2] += 1;
            }
        }
        0
    }

    fn pop(self) -> T | none {
        unsafe {
            using g = self.lock.lock() {
                if self.at[2] == 0 {
                    return none;
                }
                if self.at[0] == SEGMENT {
                    self.ends[0] = self.ends[0].next[0] ?? panic("channel: segment list broken");
                    self.at[0] = 0;
                }
                let head = self.ends[0];
                let v = head.slots[self.at[0]];
                head.slots[self.at[0]] = self.zero[0];
                self.at[0] += 1;
                self.at[2] -= 1;
                return v;
            }
        }
    }
}

const fn make<T>(limit: usize, rendezvous: bool) -> (Sender<T>, Receiver<T>) {
    unsafe {
        let meta: GcBuf<usize> = buf_new(2);
        meta[SENDERS] = 1;
        if rendezvous {
            meta[RENDEZVOUS] = 1;
        }
        let ch = Chan {
            meta: meta,
            queue: if limit > 0 {
                ring::<T>(limit)
            } else {
                segments::<T>()
            },
            rx: buf_new(3),
            tx: buf_new(3),
        };
        let open: GcBuf<bool> = buf_new(1);
        open[0] = true;
        (Sender { ch: ch, open: open }, Receiver { ch: ch })
    }
}

/// An unbounded channel.
pub const fn channel<T: Send>() -> (Sender<T>, Receiver<T>) {
    make(0usize, false)
}

/// A channel holding at most `cap` queued values: `send` blocks while
/// it is full. `cap` 0 is a rendezvous channel: `send` returns once a
/// receiver has taken the value.
pub const fn channel_bounded<T: Send>(cap: usize) -> (Sender<T>, Receiver<T>) {
    if cap == 0 {
        return make(1usize, true);
    }
    make(cap, false)
}

/// The sending end. Each clone is its own sender and is closed on its
/// own; the channel closes when every sender has closed (2.17.3).
pub struct Sender<T> {
    ch: Chan<T>;
    open: GcBuf<bool>;
}

impl<T> Sender<T> {
    fn is_open(self) -> bool {
        atomic_load(self.open, 0, SeqCst)
    }

    /// Queue `value` (blocking while a bounded channel is full, and on a
    /// rendezvous channel until it is received). Throws it back if this
    /// sender was closed.
    #[track_caller]
    pub fn send(self, value: T) throws (SendError<T>) {
        if !self.is_open() {
            throw SendError::Closed(value);
        }
        let value = hand_over::<T>(value);
        let ch = self.ch;
        let pos = ch.push(value);
        while pos == FULL {
            let s = enter(ch.tx);
            pos = ch.push(value);
            if pos == FULL {
                sleep(ch.tx, s);
            }
            leave(ch.tx);
        }
        ch.wake_receiver();
        if ch.rendezvous() {
            while !ch.taken(pos) {
                let s = enter(ch.tx);
                if !ch.taken(pos) {
                    sleep(ch.tx, s);
                }
                leave(ch.tx);
            }
        }
    }

    /// Queue `value` without blocking: `Full` if a bounded channel is
    /// full, or if no receiver is waiting on a rendezvous channel.
    #[track_caller]
    pub fn try_send(self, value: T) throws (TrySendError<T>) {
        if !self.is_open() {
            throw TrySendError::Closed(value);
        }
        let ch = self.ch;
        if ch.rendezvous() {
            let waiting = atomic_load(ch.rx, BLOCKED, SeqCst) + atomic_load(ch.rx, SUSPENDED, SeqCst);
            if waiting as usize <= ch.len() {
                throw TrySendError::Full(value);
            }
        }
        if ch.push(hand_over::<T>(value)) == FULL {
            throw TrySendError::Full(value);
        }
        ch.wake_receiver();
    }

    /// `try await tx.send_async(v)` inside async code: like `send`, but
    /// suspends the task (not the thread) while a bounded channel is
    /// full, and on a rendezvous channel until the value is received.
    #[track_caller]
    pub const fn send_async(self, value: T) -> SendFuture<T> {
        SendFuture { ch: self.ch, open: self.open, value: value, handed: false, pushed: false, ticket: 0, counted: false }
    }

    /// Close this sender; later `send`s on it throw `Closed`.
    pub fn close(self) {
        if atomic_xchg(self.open, 0, false, SeqCst) {
            atomic_sub(self.ch.meta, SENDERS, 1, SeqCst);
        }
        self.ch.wake_receiver();
    }
}

/// The compiler releases a `Sender` where its last owner leaves scope
/// (and when a task ends): the channel closes once every sender is gone.
impl<T> Drop for Sender<T> {
    fn drop(ref self) { self.close(); }
}

impl<T> Clone for Sender<T> {
    /// Another open sender on the same channel.
    fn clone(self) -> Sender<T> {
        unsafe {
            atomic_add(self.ch.meta, SENDERS, 1, SeqCst);
            let open: GcBuf<bool> = buf_new(1);
            open[0] = true;
            Sender { ch: self.ch, open: open }
        }
    }
}

/// The receiving end.
pub struct Receiver<T> {
    ch: Chan<T>;
}

impl<T> Receiver<T> {
    /// `await rx.recv_async()` inside async code: like `recv`, but
    /// suspends the task instead of blocking the thread.
    pub const fn recv_async(self) -> RecvFuture<T> {
        RecvFuture { rx: self }
    }

    /// The next value, blocking until one arrives; `none` once the queue
    /// is empty and every sender has closed.
    pub fn recv(self) -> T | none {
        let ch = self.ch;
        loop {
            // `closed` first: what a sender queued before closing is in
            // the queue by then.
            let closed = ch.senders() == 0;
            let v = ch.take();
            if closed || !(v is none) {
                return v;
            }
            let s = enter(ch.rx);
            closed = ch.senders() == 0;
            v = ch.take();
            if closed || !(v is none) {
                leave(ch.rx);
                return v;
            }
            sleep(ch.rx, s);
            leave(ch.rx);
        }
    }

    /// The next value if one is queued; `none` if empty or closed
    /// (`try_recv_status` tells the two apart).
    pub fn try_recv(self) -> T | none {
        self.ch.take()
    }

    /// The next value if one is queued, else whether a sender may still
    /// send one (`Empty`) or every sender has closed (`Closed`).
    pub fn try_recv_status(self) -> T | Empty | Closed {
        // `closed` first, as in `recv`.
        let closed = self.ch.senders() == 0;
        if let v: T = self.ch.take() {
            return v;
        }
        // By path: `Closed` alone is also a variant of the send errors.
        if closed { rok::core::channel::Closed } else { rok::core::channel::Empty }
    }

    /// Values until the channel closes (also `for v in rx`).
    pub fn iter(self) -> ChannelIter<T> {
        ChannelIter { rx: self }
    }
}

/// `for v in rx` (2.17.5).
impl<T> IntoIterator for Receiver<T> {
    type IntoIter = ChannelIter<T>;
    type Item = T;
    const fn into_iter(self) -> ChannelIter<T> {
        ChannelIter { rx: self }
    }
}

pub struct ChannelIter<T> {
    rx: Receiver<T>;
}

impl<T> Iterator for ChannelIter<T> {
    type Item = T;
    fn next(ref self) -> T | none {
        self.rx.recv()
    }
}

/// `Receiver::recv_async`.
pub struct RecvFuture<T> {
    rx: Receiver<T>;
}

impl<T> rok::core::future::Future for RecvFuture<T> {
    type Output = T | none;
    fn poll(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<T | none> {
        let rx = self.rx;
        rx.poll_next(ref ctx)
    }
}

/// `for await v in rx` (2.17.5): values until every sender has closed.
impl<T> rok::core::stream::Stream for Receiver<T> {
    type Item = T;
    fn poll_next(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<T | none> {
        let ch = self.ch;
        // A cancelled task leaves at this `await`: a value taken now
        // would be dropped, so leave it queued (and stop counting as a
        // suspended receiver).
        if rok::core::task::cancel_requested(ctx) {
            atomic_xchg(ch.rx, SUSPENDED, 0, SeqCst);
            return rok::core::future::Poll::Pending;
        }
        // Park and count before looking, so a send after the look
        // unparks us (single consumer: the count is a flag).
        rok::core::task::park(ch.recv_key(), ctx.waker());
        atomic_xchg(ch.rx, SUSPENDED, 1, SeqCst);
        let closed = ch.senders() == 0;
        let v = ch.take();
        if closed || !(v is none) {
            atomic_xchg(ch.rx, SUSPENDED, 0, SeqCst);
            return rok::core::future::Poll::Ready(v);
        }
        rok::core::future::Poll::Pending
    }
}

/// `Sender::send_async`.
pub struct SendFuture<T> {
    /// The sender's channel and open flag: the future borrows the sender,
    /// which stays with its owner.
    ch: Chan<T>;
    open: GcBuf<bool>;
    value: T;
    /// `value` is the hand-off's copy (made at the first push).
    handed: bool;
    pushed: bool;
    ticket: usize;
    /// Counted in the channel's suspended senders.
    counted: bool;
}

impl<T> SendFuture<T> {
    fn uncount(ref self) {
        if self.counted {
            atomic_sub(self.ch.tx, SUSPENDED, 1, SeqCst);
            self.counted = false;
        }
    }

    pub fn poll(ref self, ref ctx: rok::core::future::Context) throws (SendError<T>) -> rok::core::future::Poll<()> {
        let ch = self.ch;
        // A cancelled task does not send.
        if rok::core::task::cancel_requested(ctx) && !self.pushed {
            self.uncount();
            return rok::core::future::Poll::Pending;
        }
        // Park and count before looking, so a receive after the look
        // unparks us.
        rok::core::task::park(ch.send_key(), ctx.waker());
        if !self.counted {
            atomic_add(ch.tx, SUSPENDED, 1, SeqCst);
            self.counted = true;
        }
        if !self.pushed {
            if !atomic_load(self.open, 0, SeqCst) {
                self.uncount();
                throw SendError::Closed(self.value);
            }
            if !self.handed {
                self.value = hand_over::<T>(self.value);
                self.handed = true;
            }
            let pos = ch.push(self.value);
            if pos == FULL {
                return rok::core::future::Poll::Pending;
            }
            self.pushed = true;
            self.ticket = pos;
            ch.wake_receiver();
        }
        // Rendezvous: done once a receiver took our value.
        if ch.rendezvous() && !ch.taken(self.ticket) {
            return rok::core::future::Poll::Pending;
        }
        self.uncount();
        rok::core::future::Poll::Ready(())
    }
}

// The module paths of stdlib 2.17.6.
pub mod sender {
    pub use rok::core::channel::{Sender, SendFuture, SendError, TrySendError};
}
pub mod receiver {
    pub use rok::core::channel::{Receiver, RecvFuture, ChannelIter};
}

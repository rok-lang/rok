// Secret storage (2.21.5): a buffer in the large-object space, so the
// collector never moves or copies it, zeroed by `wipe`, by `using`
// release and by the collection that frees it (`rok_gc_secret_new`).
// `Secret` is the public byte form; `SecretWords` holds the algorithms'
// 32-bit key schedules and polynomials.

use rok::core::collections::raw::{GcBuf, buf_erase, cap_mul};
use rok::core::index::index_oob;
use rok::core::marker::{Memo, Transfer, buf_is_null};

/// A fixed-length secret byte string. Copies share the bytes.
pub struct Secret {
    w: GcBuf<u32>;
    len: usize;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl !Sync for Secret {}

impl Secret {
    /// `len` zero bytes.
    pub fn zeroed(len: usize) -> Secret {
        Secret { w: unsafe { rok_gc_secret_new(len) }, len }
    }

    /// A copy of `bytes`.
    pub fn new<B: AsBytes>(bytes: B) -> Secret {
        let b = bytes.byte_slice();
        let s = Secret::zeroed(b.len());
        let d = buf_erase(s.w);
        for i in 0..b.len() {
            unsafe { d[i] = b[i]; }
        }
        s
    }

    pub const fn len(self) -> usize { self.len }

    /// The bytes where they are, not a copy: a view reads zeros once
    /// the secret is wiped.
    pub const fn as_bytes(self) -> Slice<u8> {
        unsafe { Slice::from_raw_parts(buf_erase(self.w), 0, self.len) }
    }

    /// Overwrite the bytes with zeros now; every copy and view sees it.
    pub fn wipe(self) {
        unsafe { rok_gc_secret_wipe(self.w) };
    }
}

/// The bytes where they are, as `as_bytes`.
impl AsBytes for Secret {
    const fn byte_slice(self) -> Slice<u8> { self.as_bytes() }
}

impl Index<usize> for Secret {
    type Output = u8;
    #[track_caller]
    const fn index(self, i: usize) -> u8 {
        if i >= self.len { index_oob("Secret index", i, self.len); }
        unsafe { buf_erase(self.w)[i] }
    }
}

impl IndexSet<usize> for Secret {
    type Value = u8;
    #[track_caller]
    const fn index_set(self, i: usize, v: u8) {
        if i >= self.len { index_oob("Secret index", i, self.len); }
        unsafe { buf_erase(self.w)[i] = v; }
    }
}

/// `s[a:b]`: a view of those bytes in place, like `as_bytes`.
impl Sliceable<Range<usize>> for Secret {
    type Output = Slice<u8>;
    const fn slice(self, r: Range<usize>) -> Slice<u8> { self.as_bytes().slice(r) }
}

/// `using` release wipes.
impl Drop for Secret {
    fn drop(ref self) { self.wipe(); }
}

/// The length only.
impl Debug for Secret {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"Secret({self.len} bytes)") }
}

/// `n` secret words, zeroed at first.
pub(pkg) struct SecretWords {
    w: GcBuf<u32>;
    n: usize;
}

impl !Sync for SecretWords {}

impl SecretWords {
    #[track_caller]
    pub(pkg) fn new(n: usize) -> SecretWords {
        SecretWords { w: unsafe { rok_gc_secret_new(cap_mul(n, 4)) }, n }
    }

    pub(pkg) const fn len(self) -> usize { self.n }

    /// Word `i`, unchecked: the caller checked `i < len`.
    pub(pkg) const unsafe fn at(self, i: usize) -> u32 { unsafe { self.w[i] } }

    pub(pkg) fn wipe(self) {
        unsafe { rok_gc_secret_wipe(self.w) };
    }
}

impl Index<usize> for SecretWords {
    type Output = u32;
    #[track_caller]
    const fn index(self, i: usize) -> u32 {
        if i >= self.n { index_oob("SecretWords index", i, self.n); }
        unsafe { self.w[i] }
    }
}

impl IndexSet<usize> for SecretWords {
    type Value = u32;
    #[track_caller]
    const fn index_set(self, i: usize, v: u32) {
        if i >= self.n { index_oob("SecretWords index", i, self.n); }
        unsafe { self.w[i] = v; }
    }
}

/// A hand-off's copy (stdlib 2.13.9): a new secret buffer, so `par`
/// workers never share one.
impl Transfer for Secret {
    const fn transfer_copy(self, m: Memo) -> Secret {
        Secret { w: secret_copy(self.w, self.len, m), len: self.len }
    }

    const fn transfer_keep(self, m: Memo) -> Secret {
        if !buf_is_null(self.w) {
            m.keep(self.w);
        }
        self
    }

    const fn transfer_visit(self, m: Memo) -> Secret {
        if !buf_is_null(self.w) {
            let _ = m.visit(self.w);
        }
        self
    }
}

impl Transfer for SecretWords {
    const fn transfer_copy(self, m: Memo) -> SecretWords {
        SecretWords { w: secret_copy(self.w, cap_mul(self.n, 4), m), n: self.n }
    }

    const fn transfer_keep(self, m: Memo) -> SecretWords {
        if !buf_is_null(self.w) {
            m.keep(self.w);
        }
        self
    }

    const fn transfer_visit(self, m: Memo) -> SecretWords {
        if !buf_is_null(self.w) {
            let _ = m.visit(self.w);
        }
        self
    }
}

/// `len` bytes of `w` in a new secret buffer, once per hand-off.
const fn secret_copy(w: GcBuf<u32>, len: usize, m: Memo) -> GcBuf<u32> {
    if buf_is_null(w) {
        return w;
    }
    if let got: GcBuf<u32> = m.find(w) {
        return got;
    }
    unsafe {
        let c = rok_gc_secret_new(len);
        m.note(w, c);
        rok_buf_copy(buf_erase(c), 0, buf_erase(w), 0, len);
        c
    }
}

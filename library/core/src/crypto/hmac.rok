// HMAC (RFC 2104) and HKDF (RFC 5869) over a SHA-2 function, and the
// one-shot `_sha3` forms over a SHA-3 one.

use sup::{view, ByteInput, Secret};
use sup::constant_time_eq;
use sup::sha2::{HashAlgorithm, Digest};
use sup::sha3::{Sha3Algorithm, Keccak};

/// HMAC over SHA-3, the key absorbed; `update` on `inner`.
struct Sha3Mac {
    alg: Sha3Algorithm;
    inner: Keccak;
    outer: Keccak;
}

impl Sha3Mac {
    fn new(alg: Sha3Algorithm, key: ByteInput) -> Sha3Mac {
        let k = view(key);
        let bl = alg.block_len();
        // The key, zero-padded to a block, in arrays: no list holds it.
        let kb: [u8; 168] = [0u8; 168];
        if k.len() > bl {
            let d = alg.sponge();
            d.absorb(k);
            kb = d.squeeze_raw(alg.output_len());
        } else {
            for i in 0..k.len() { kb[i] = k[i]; }
        }
        let pad: [u8; 168] = [0u8; 168];
        for i in 0..bl { pad[i] = kb[i] ^ 0x36u8; }
        let inner = alg.sponge();
        inner.absorb_raw(pad, bl);
        for i in 0..bl { pad[i] = kb[i] ^ 0x5cu8; }
        let outer = alg.sponge();
        outer.absorb_raw(pad, bl);
        Sha3Mac { alg, inner, outer }
    }

    /// The tag in the first `output_len` bytes of an array.
    const fn finish_raw(self) -> [u8; 168] {
        let n = self.alg.output_len();
        let i = self.inner;
        let h = i.squeeze_raw(n);
        let o = self.outer;
        o.absorb_raw(h, n);
        o.squeeze_raw(n)
    }
}

/// A running HMAC. A value: copying it forks the running MAC.
pub struct Hmac {
    inner: Digest;
    outer: Digest;
}

impl Hmac {
    pub fn new(alg: HashAlgorithm, key: ByteInput) -> Hmac {
        let k = view(key);
        let bl = alg.block_len();
        // The key, zero-padded to a block, in arrays: no list holds it.
        let kb: [u8; 128] = [0u8; 128];
        if k.len() > bl {
            let d = Digest::new(alg);
            d.update(k);
            let h = d.finish_raw();
            for i in 0..alg.output_len() { kb[i] = h[i]; }
        } else {
            for i in 0..k.len() { kb[i] = k[i]; }
        }
        let pad: [u8; 128] = [0u8; 128];
        for i in 0..bl { pad[i] = kb[i] ^ 0x36u8; }
        let inner = Digest::new(alg);
        inner.update_raw(pad, bl);
        for i in 0..bl { pad[i] = kb[i] ^ 0x5cu8; }
        let outer = Digest::new(alg);
        outer.update_raw(pad, bl);
        Hmac { inner, outer }
    }

    /// The tag of `data` under `key`.
    pub fn mac(alg: HashAlgorithm, key: ByteInput, data: ByteInput) -> List<u8> {
        let h = Hmac::new(alg, key);
        h.update(data);
        h.finish()
    }

    /// Whether `tag` is the tag of `data`, compared in constant time.
    pub fn verify(alg: HashAlgorithm, key: ByteInput, data: ByteInput, tag: ByteInput) -> bool {
        constant_time_eq(Hmac::mac(alg, key, data), tag)
    }

    /// `mac` over a SHA-3 function: `Hmac::mac_sha3(Sha3_256, key, data)`.
    pub fn mac_sha3(alg: Sha3Algorithm, key: ByteInput, data: ByteInput) -> List<u8> {
        let m = Sha3Mac::new(alg, key);
        m.inner.absorb(data);
        let t = m.finish_raw();
        let out: List<u8> = List::with_capacity(alg.output_len());
        for i in 0..alg.output_len() { out.push(t[i]); }
        out
    }

    /// `verify` over a SHA-3 function.
    pub fn verify_sha3(alg: Sha3Algorithm, key: ByteInput, data: ByteInput, tag: ByteInput) -> bool {
        constant_time_eq(Hmac::mac_sha3(alg, key, data), tag)
    }

    pub fn update(ref self, data: ByteInput) { self.inner.update(data); }

    pub const fn finish(self) -> List<u8> {
        self.outer_raw().finish()
    }

    /// The outer hash with the inner one absorbed (through an array).
    const fn outer_raw(self) -> Digest {
        let alg = self.outer.algorithm();
        let h = self.inner.finish_raw();
        let b: [u8; 128] = [0u8; 128];
        for i in 0..alg.output_len() { b[i] = h[i]; }
        let o = self.outer;
        o.update_raw(b, alg.output_len());
        o
    }
}

/// HKDF: `extract` a pseudorandom key, `expand` it into output keying
/// material.
pub struct Hkdf;

impl Hkdf {
    /// `HMAC(salt, ikm)`; an empty salt is `output_len` zero bytes.
    pub fn extract(alg: HashAlgorithm, salt: ByteInput, ikm: ByteInput) -> Secret {
        let s = view(salt);
        // A zero key and an empty one give the same HMAC.
        let h = Hmac::new(alg, s);
        h.update(ikm);
        let prk = Secret::zeroed(alg.output_len());
        let t = h.outer_raw().finish_raw();
        for i in 0..alg.output_len() { prk[i] = t[i]; }
        prk
    }

    /// `len` bytes of output keying material; `len` is at most
    /// `255 * output_len`.
    pub fn expand(alg: HashAlgorithm, prk: ByteInput, info: ByteInput, len: usize) throws (ValueError) -> Secret {
        let ol = alg.output_len();
        if len > 255 * ol {
            throw ValueError { msg: "HKDF output too long" };
        }
        let base = Hmac::new(alg, prk);
        let inf = view(info);
        let out = Secret::zeroed(len);
        // T(i - 1) || i, in an array.
        let t: [u8; 128] = [0u8; 128];
        let tn = 0usize;
        let i = 1u8;
        let at = 0usize;
        while at < len {
            let h = base;
            h.inner.update_raw(t, tn);
            h.update(inf);
            let c: [u8; 128] = [0u8; 128];
            c[0] = i;
            h.inner.update_raw(c, 1);
            let d = h.outer_raw().finish_raw();
            for j in 0..ol {
                t[j] = d[j];
                if at < len {
                    out[at] = d[j];
                    at += 1;
                }
            }
            tn = ol;
            i = i.wrapping_add(1u8);
        }
        out
    }

    /// `extract` over a SHA-3 function.
    pub fn extract_sha3(alg: Sha3Algorithm, salt: ByteInput, ikm: ByteInput) -> Secret {
        let m = Sha3Mac::new(alg, view(salt));
        m.inner.absorb(ikm);
        let prk = Secret::zeroed(alg.output_len());
        let t = m.finish_raw();
        for i in 0..alg.output_len() { prk[i] = t[i]; }
        prk
    }

    /// `expand` over a SHA-3 function; `len` is at most
    /// `255 * output_len`.
    pub fn expand_sha3(alg: Sha3Algorithm, prk: ByteInput, info: ByteInput, len: usize) throws (ValueError) -> Secret {
        let ol = alg.output_len();
        if len > 255 * ol {
            throw ValueError { msg: "HKDF output too long" };
        }
        let base = Sha3Mac::new(alg, prk);
        let inf = view(info);
        let out = Secret::zeroed(len);
        // T(i - 1) || i, in an array.
        let t: [u8; 168] = [0u8; 168];
        let tn = 0usize;
        let i = 1u8;
        let at = 0usize;
        while at < len {
            let h = base;
            h.inner.absorb_raw(t, tn);
            h.inner.absorb(inf);
            let c: [u8; 168] = [0u8; 168];
            c[0] = i;
            h.inner.absorb_raw(c, 1);
            let d = h.finish_raw();
            for j in 0..ol {
                t[j] = d[j];
                if at < len {
                    out[at] = d[j];
                    at += 1;
                }
            }
            tn = ol;
            i = i.wrapping_add(1u8);
        }
        out
    }
}

// Fixed-width natural numbers for RSA: little-endian
// 32-bit limbs (`List<u32>`, products in `u64`, so 32-bit targets need
// no wide multiply), a width fixed per modulus. Arithmetic runs in time
// that depends only on the width (and, for `pow`, the exponent's
// length): carries and final subtractions are masks, not branches.
// `Nat::bits` and the conversions are variable-time; they see public
// sizes only.

use sup::ct_mask;

pub(pkg) struct Nat;

impl Nat {
    pub(pkg) const fn zero(n: usize) -> List<u32> {
        let r: List<u32> = List::with_capacity(n);
        for _ in 0..n { r.push(0u32); }
        r
    }

    /// Big-endian bytes as `n` limbs; `none` if the value needs more.
    #[must_use]
    pub(pkg) const fn from_be(b: Slice<u8>, n: usize) -> List<u32> | none {
        let r = Nat::zero(n);
        let len = b.len();
        for i in 0..len {
            let k = len - 1 - i;
            let x = b[i];
            if k / 4 >= n {
                if x != 0u8 { return none; }
                continue;
            }
            r[k / 4] = r[k / 4] | ((x as u32) << (8 * (k % 4)) as u32);
        }
        r
    }

    /// The low `len` bytes of `a`, big-endian.
    #[must_use]
    pub(pkg) const fn to_be(a: List<u32>, len: usize) -> List<u8> {
        let out: List<u8> = List::with_capacity(len);
        for i in 0..len {
            let k = len - 1 - i;
            let v = if k / 4 < a.len() { (a[k / 4] >> (8 * (k % 4)) as u32) as u8 } else { 0u8 };
            out.push(v);
        }
        out
    }

    /// A constant from hex digits (no prefix).
    pub(pkg) fn from_hex(s: str) -> List<u32> {
        let b = s.as_bytes();
        let n = (b.len() + 7) / 8;
        let r = Nat::zero(n);
        for i in 0..b.len() {
            let c = b[b.len() - 1 - i];
            let v = if c <= 0x39u8 { c - 0x30u8 } else if c >= 0x61u8 { c - 0x61u8 + 10u8 } else { c - 0x41u8 + 10u8 };
            r[i / 8] = r[i / 8] | ((v as u32) << (4 * (i % 8)) as u32);
        }
        r
    }

    /// `a - b` (equal widths) and the borrow out (0 or 1).
    pub(pkg) const fn sub(a: List<u32>, b: List<u32>) -> (List<u32>, u32) {
        let n = a.len();
        let r = Nat::zero(n);
        let borrow = 0u64;
        for i in 0..n {
            let t = (a[i] as u64).wrapping_sub(b[i] as u64).wrapping_sub(borrow);
            r[i] = t as u32;
            borrow = t >> 63u64;
        }
        (r, borrow as u32)
    }

    /// `a + b` (equal widths) and the carry out (0 or 1).
    pub(pkg) const fn add(a: List<u32>, b: List<u32>) -> (List<u32>, u32) {
        let n = a.len();
        let r = Nat::zero(n);
        let carry = 0u64;
        for i in 0..n {
            let t = (a[i] as u64) + (b[i] as u64) + carry;
            r[i] = t as u32;
            carry = t >> 32u64;
        }
        (r, carry as u32)
    }

    /// `a` if `mask` is all ones, `b` if it is zero.
    pub(pkg) const fn select(mask: u32, a: List<u32>, b: List<u32>) -> List<u32> {
        let n = a.len();
        let r = Nat::zero(n);
        for i in 0..n {
            r[i] = (a[i] & mask) | (b[i] & ~mask);
        }
        r
    }

    /// Whether `a < b` (equal widths).
    pub(pkg) const fn lt(a: List<u32>, b: List<u32>) -> bool {
        let (_, borrow) = Nat::sub(a, b);
        borrow == 1u32
    }

    #[must_use]
    pub(pkg) const fn is_zero(a: List<u32>) -> bool {
        let d = 0u32;
        for x in a { d = d | x; }
        d == 0u32
    }

    pub(pkg) const fn eq(a: List<u32>, b: List<u32>) -> bool {
        let d = 0u32;
        for i in 0..a.len() { d = d | (a[i] ^ b[i]); }
        d == 0u32
    }

    /// Significant bits (variable-time).
    pub(pkg) const fn bits(a: List<u32>) -> usize {
        let i = a.len();
        while i > 0 {
            i -= 1;
            if a[i] != 0u32 { return 32 * i + 32 - (a[i].leading_zeros() as usize); }
        }
        0
    }

    /// `a` widened (or cut) to `n` limbs.
    pub(pkg) const fn resize(a: List<u32>, n: usize) -> List<u32> {
        let r = Nat::zero(n);
        for i in 0..n {
            if i < a.len() { r[i] = a[i]; }
        }
        r
    }
}

/// An odd modulus `m` and its Montgomery constants (`R = 2^(32 n)`).
pub(pkg) struct Modulus {
    pub(pkg) m: List<u32>;
    pub(pkg) n: usize;
    inv: u32;
    r1: List<u32>;
    r2: List<u32>;
}

impl Modulus {
    /// `m` odd, its top limb non-zero.
    pub(pkg) fn new(m: List<u32>) -> Modulus {
        let n = m.len();
        // -m^-1 mod 2^32 by Newton's iteration (x = m0 is right to 3 bits).
        let m0 = m[0];
        let x = m0;
        for _ in 0..4 {
            x = x.wrapping_mul(2u32.wrapping_sub(m0.wrapping_mul(x)));
        }
        let md = Modulus { m, n, inv: 0u32.wrapping_sub(x), r1: Nat::zero(n), r2: Nat::zero(n) };
        // R mod m: 1 doubled 32 n times; one more is 2 in Montgomery
        // form, and 2^(32 n) of that is R^2 mod m.
        let r = Nat::zero(n);
        r[0] = 1u32;
        for _ in 0..32 * n {
            r = md.add(r, r);
        }
        md.r1 = r;
        let k = 32 * n;
        let kb: List<u8> = [(k >> 8) as u8, k as u8];
        md.r2 = md.pow(md.add(r, r), kb[0:2]);
        md
    }

    /// `(a + b) mod m` for `a, b < m`.
    pub(pkg) fn add(self, a: List<u32>, b: List<u32>) -> List<u32> {
        let (s, carry) = Nat::add(a, b);
        let (d, borrow) = Nat::sub(s, self.m);
        // Keep the difference when the sum overflowed or reached m.
        Nat::select(ct_mask(carry | (borrow ^ 1u32)), d, s)
    }

    /// `(a - b) mod m` for `a, b < m`.
    pub(pkg) fn sub(self, a: List<u32>, b: List<u32>) -> List<u32> {
        let (d, borrow) = Nat::sub(a, b);
        let mask = ct_mask(borrow);
        let corr = Nat::zero(self.n);
        for i in 0..self.n { corr[i] = self.m[i] & mask; }
        let (r, _) = Nat::add(d, corr);
        r
    }

    /// `a mod m` for `a < 2m` (equal widths).
    pub(pkg) fn reduce_once(self, a: List<u32>) -> List<u32> {
        let (d, borrow) = Nat::sub(a, self.m);
        Nat::select(ct_mask(borrow ^ 1u32), d, a)
    }

    /// Montgomery product `a b R^-1 mod m` (CIOS) for `a, b < m`.
    pub(pkg) fn mul(self, a: List<u32>, b: List<u32>) -> List<u32> {
        let n = self.n;
        let t = Nat::zero(n + 2);
        for i in 0..n {
            let bi = b[i] as u64;
            let c = 0u64;
            for j in 0..n {
                let s = (t[j] as u64) + (a[j] as u64) * bi + c;
                t[j] = s as u32;
                c = s >> 32u64;
            }
            let s = (t[n] as u64) + c;
            t[n] = s as u32;
            t[n + 1] = (s >> 32u64) as u32;
            let q = (t[0].wrapping_mul(self.inv)) as u64;
            let s0 = (t[0] as u64) + q * (self.m[0] as u64);
            c = s0 >> 32u64;
            for j in 1..n {
                let s2 = (t[j] as u64) + q * (self.m[j] as u64) + c;
                t[j - 1] = s2 as u32;
                c = s2 >> 32u64;
            }
            let s3 = (t[n] as u64) + c;
            t[n - 1] = s3 as u32;
            t[n] = t[n + 1] + ((s3 >> 32u64) as u32);
        }
        // t < 2m: subtract m once if t[n] is set or t >= m.
        let lo = Nat::resize(t, n);
        let (d, borrow) = Nat::sub(lo, self.m);
        Nat::select(ct_mask(t[n] | (borrow ^ 1u32)), d, lo)
    }

    pub(pkg) fn to_mont(self, a: List<u32>) -> List<u32> { self.mul(a, self.r2) }

    pub(pkg) fn from_mont(self, a: List<u32>) -> List<u32> {
        let one = Nat::zero(self.n);
        one[0] = 1u32;
        self.mul(a, one)
    }

    /// `R mod m`: one in Montgomery form.
    pub(pkg) const fn one(self) -> List<u32> { self.r1 }

    /// `a^e` in Montgomery form (`a` in Montgomery form), `e` big-endian.
    /// Every bit squares and multiplies, so time depends on `e`'s length
    /// only.
    #[must_use]
    pub(pkg) fn pow(self, a: List<u32>, e: Slice<u8>) -> List<u32> {
        let r = self.one();
        for byte in e {
            for k in 0..8 {
                r = self.mul(r, r);
                let ra = self.mul(r, a);
                let bit = ((byte >> (7 - k) as u8) & 1u8) as u32;
                r = Nat::select(ct_mask(bit), ra, r);
            }
        }
        r
    }

    /// `a^-1` (Montgomery form in and out) for prime `m`, by Fermat.
    pub(pkg) fn inv_prime(self, a: List<u32>) -> List<u32> {
        let two = Nat::zero(self.n);
        two[0] = 2u32;
        let (e, _) = Nat::sub(self.m, two);
        self.pow(a, Nat::to_be(e, 4 * self.n)[0:4 * self.n])
    }
}

impl Modulus {
    /// `x mod m` for `x` of any width (plain values): Horner over
    /// `n`-limb chunks, `acc R + chunk`, each step a Montgomery product.
    pub(pkg) fn reduce(self, x: List<u32>) -> List<u32> {
        let n = self.n;
        let acc = Nat::zero(n);
        let chunks = (x.len() + n - 1) / n;
        let i = chunks;
        while i > 0 {
            i -= 1;
            let c = Nat::zero(n);
            for j in 0..n {
                if i * n + j < x.len() { c[j] = x[i * n + j]; }
            }
            // acc R mod m, and the chunk (below R) mod m.
            acc = self.add(self.to_mont(acc), self.from_mont(self.to_mont(c)));
        }
        acc
    }

    /// `x^-1 mod m` (plain values, `x < m`), `none` if `x` and `m` are
    /// not coprime. Binary extended GCD in constant time: a fixed
    /// `64 n` steps, each a masked swap, subtraction and halving.
    /// Invariants: `a = u x`, `b = v x` (mod m), `b` odd.
    pub(pkg) fn inv(self, x: List<u32>) -> List<u32> | none {
        let n = self.n;
        let m = self.m;
        let a = Nat::resize(x, n);
        let b = Nat::resize(m, n);
        let u = Nat::zero(n);
        u[0] = 1u32;
        let v = Nat::zero(n);
        for _ in 0..64 * n {
            // If a is odd and a < b: swap (a, u) with (b, v).
            let odd = ct_mask(a[0] & 1u32);
            let borrow = 0u64;
            for i in 0..n {
                borrow = ((a[i] as u64).wrapping_sub(b[i] as u64).wrapping_sub(borrow)) >> 63u64;
            }
            let sw = odd & ct_mask(borrow as u32);
            for i in 0..n {
                let t = (a[i] ^ b[i]) & sw;
                a[i] = a[i] ^ t;
                b[i] = b[i] ^ t;
                let w = (u[i] ^ v[i]) & sw;
                u[i] = u[i] ^ w;
                v[i] = v[i] ^ w;
            }
            // If a is odd: a -= b, u -= v (mod m). Then a is even.
            let br = 0u64;
            let bu = 0u64;
            for i in 0..n {
                let t = (a[i] as u64).wrapping_sub((b[i] & odd) as u64).wrapping_sub(br);
                a[i] = t as u32;
                br = t >> 63u64;
                let s = (u[i] as u64).wrapping_sub((v[i] & odd) as u64).wrapping_sub(bu);
                u[i] = s as u32;
                bu = s >> 63u64;
            }
            let fix = ct_mask(bu as u32);
            let c = 0u64;
            for i in 0..n {
                let t = (u[i] as u64) + ((m[i] & fix) as u64) + c;
                u[i] = t as u32;
                c = t >> 32u64;
            }
            // a /= 2; u /= 2 (mod m): add m first when u is odd.
            let uo = ct_mask(u[0] & 1u32);
            let c2 = 0u64;
            for i in 0..n {
                let t = (u[i] as u64) + ((m[i] & uo) as u64) + c2;
                u[i] = t as u32;
                c2 = t >> 32u64;
            }
            for i in 0..n {
                let hi_a = if i + 1 < n { a[i + 1] << 31u32 } else { 0u32 };
                a[i] = (a[i] >> 1u32) | hi_a;
                let hi_u = if i + 1 < n { u[i + 1] << 31u32 } else { (c2 as u32) << 31u32 };
                u[i] = (u[i] >> 1u32) | hi_u;
            }
        }
        // gcd(x, m) is b; 1 when invertible.
        let one = Nat::zero(n);
        one[0] = 1u32;
        if !Nat::eq(b, one) { return none; }
        v
    }
}

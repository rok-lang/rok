// HKDF (RFC 5869) over any `HashAlgorithm`: `extract` a pseudorandom
// key, `expand` it into output keying material.

use sup::Secret;
use sup::HashAlgorithm;
use sup::hmac::Hmac;

/// `HMAC(salt, ikm)`; an empty salt is `output_len` zero bytes.
pub fn extract<S: AsBytes, I: AsBytes>(alg: HashAlgorithm, salt: S, ikm: I) -> Secret {
    // A zero key and an empty one give the same HMAC.
    let h = Hmac::new(alg, salt);
    h.update(ikm);
    let prk = Secret::zeroed(alg.output_len());
    let t = h.outer_raw().finish_raw();
    for i in 0..alg.output_len() { prk[i] = t[i]; }
    prk
}

/// `len` bytes of output keying material; `len` is at most
/// `255 * output_len`.
pub fn expand<P: AsBytes, I: AsBytes>(alg: HashAlgorithm, prk: P, info: I, len: usize) throws (ValueError) -> Secret {
    let ol = alg.output_len();
    if len > 255 * ol {
        throw ValueError::new("HKDF output too long");
    }
    let base = Hmac::new(alg, prk);
    let inf = info.byte_slice();
    let out = Secret::zeroed(len);
    // T(i - 1) || i, in an array.
    let t: [u8; 168] = [0u8; 168];
    let tn = 0usize;
    let i = 1u8;
    let at = 0usize;
    while at < len {
        let h = base;
        h.update_raw(t, tn);
        h.update(inf);
        let c: [u8; 168] = [0u8; 168];
        c[0] = i;
        h.update_raw(c, 1);
        let d = h.outer_raw().finish_raw();
        for j in 0..ol {
            t[j] = d[j];
            if at < len {
                out[at] = d[j];
                at += 1;
            }
        }
        tn = ol;
        i = i.wrapping_add(1u8);
    }
    out
}

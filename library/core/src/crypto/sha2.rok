const IV512: [u64; 8] = [
    0x6a09e667f3bcc908u64, 0xbb67ae8584caa73bu64, 0x3c6ef372fe94f82bu64, 0xa54ff53a5f1d36f1u64,
    0x510e527fade682d1u64, 0x9b05688c2b3e6c1fu64, 0x1f83d9abfb41bd6bu64, 0x5be0cd19137e2179u64,
];

const IV384: [u64; 8] = [
    0xcbbb9d5dc1059ed8u64, 0x629a292a367cd507u64, 0x9159015a3070dd17u64, 0x152fecd8f70e5939u64,
    0x67332667ffc00b31u64, 0x8eb44a8768581511u64, 0xdb0c2e0d64f98fa7u64, 0x47b5481dbefa4fa4u64,
];

/// One SHA-256 compression of `buf` into `hs`.
const fn compress256(hs: [u32; 8], buf: [u8; 64]) -> [u32; 8] {
    let w: [u32; 64] = [0u32; 64];
    for i in 0..16 {
        w[i] = ((buf[4 * i] as u32) << 24) | ((buf[4 * i + 1] as u32) << 16)
            | ((buf[4 * i + 2] as u32) << 8) | (buf[4 * i + 3] as u32);
    }
    for i in 16..64 {
        let x = w[i - 15];
        let y = w[i - 2];
        let s0 = x.rotate_right(7) ^ x.rotate_right(18) ^ (x >> 3);
        let s1 = y.rotate_right(17) ^ y.rotate_right(19) ^ (y >> 10);
        w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
    }
    let a = hs[0];
    let b = hs[1];
    let c = hs[2];
    let d = hs[3];
    let e = hs[4];
    let f = hs[5];
    let g = hs[6];
    let h = hs[7];
    for i in 0..64 {
        let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
        let ch = (e & f) ^ (~e & g);
        let t1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(K256[i]).wrapping_add(w[i]);
        let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        h = g;
        g = f;
        f = e;
        e = d.wrapping_add(t1);
        d = c;
        c = b;
        b = a;
        a = t1.wrapping_add(s0.wrapping_add(maj));
    }
    hs[0] = hs[0].wrapping_add(a);
    hs[1] = hs[1].wrapping_add(b);
    hs[2] = hs[2].wrapping_add(c);
    hs[3] = hs[3].wrapping_add(d);
    hs[4] = hs[4].wrapping_add(e);
    hs[5] = hs[5].wrapping_add(f);
    hs[6] = hs[6].wrapping_add(g);
    hs[7] = hs[7].wrapping_add(h);
    hs
}

/// One SHA-512 compression of `buf` into `hs`.
const fn compress512(hs: [u64; 8], buf: [u8; 128]) -> [u64; 8] {
    let w: [u64; 80] = [0u64; 80];
    for i in 0..16 {
        let v = 0u64;
        for j in 0..8 {
            v = (v << 8) | (buf[8 * i + j] as u64);
        }
        w[i] = v;
    }
    for i in 16..80 {
        let x = w[i - 15];
        let y = w[i - 2];
        let s0 = x.rotate_right(1) ^ x.rotate_right(8) ^ (x >> 7);
        let s1 = y.rotate_right(19) ^ y.rotate_right(61) ^ (y >> 6);
        w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
    }
    let a = hs[0];
    let b = hs[1];
    let c = hs[2];
    let d = hs[3];
    let e = hs[4];
    let f = hs[5];
    let g = hs[6];
    let h = hs[7];
    for i in 0..80 {
        let s1 = e.rotate_right(14) ^ e.rotate_right(18) ^ e.rotate_right(41);
        let ch = (e & f) ^ (~e & g);
        let t1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(K512[i]).wrapping_add(w[i]);
        let s0 = a.rotate_right(28) ^ a.rotate_right(34) ^ a.rotate_right(39);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        h = g;
        g = f;
        f = e;
        e = d.wrapping_add(t1);
        d = c;
        c = b;
        b = a;
        a = t1.wrapping_add(s0.wrapping_add(maj));
    }
    hs[0] = hs[0].wrapping_add(a);
    hs[1] = hs[1].wrapping_add(b);
    hs[2] = hs[2].wrapping_add(c);
    hs[3] = hs[3].wrapping_add(d);
    hs[4] = hs[4].wrapping_add(e);
    hs[5] = hs[5].wrapping_add(f);
    hs[6] = hs[6].wrapping_add(g);
    hs[7] = hs[7].wrapping_add(h);
    hs
}

/// SHA-256 state: 64-byte blocks.
struct Sha256State {
    h: [u32; 8];
    buf: [u8; 64];
    n: usize;
    total: u64;
}

impl Sha256State {
    const fn new() -> Sha256State {
        Sha256State {
            h: [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32,
                0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32],
            buf: [0u8; 64],
            n: 0,
            total: 0u64,
        }
    }

    fn update<B: AsBytes>(ref self, data: B) {
        let s = data.byte_slice();
        // Locals, written back once: per-byte field access is slow.
        let h = self.h;
        let buf = self.buf;
        let n = self.n;
        for x in s {
            buf[n] = x;
            n += 1;
            if n == 64 {
                h = compress256(h, buf);
                n = 0;
            }
        }
        self.h = h;
        self.buf = buf;
        self.n = n;
        self.total = self.total.wrapping_add(s.len() as u64);
    }

    /// `update` with `b[0:len]`.
    const fn update_raw(ref self, b: [u8; 168], len: usize) {
        let h = self.h;
        let buf = self.buf;
        let n = self.n;
        for i in 0..len {
            buf[n] = b[i];
            n += 1;
            if n == 64 {
                h = compress256(h, buf);
                n = 0;
            }
        }
        self.h = h;
        self.buf = buf;
        self.n = n;
        self.total = self.total.wrapping_add(len as u64);
    }

    /// The digest in the first 32 bytes (of a copy: `self` is a value).
    const fn finish(self) -> [u8; 64] {
        let bits = self.total.wrapping_mul(8u64);
        self.buf[self.n] = 0x80u8;
        self.n += 1;
        if self.n > 56 {
            while self.n < 64 { self.buf[self.n] = 0u8; self.n += 1; }
            self.h = compress256(self.h, self.buf);
            self.n = 0;
        }
        while self.n < 56 { self.buf[self.n] = 0u8; self.n += 1; }
        for i in 0..8 {
            self.buf[56 + i] = (bits >> (56 - 8 * i) as u64) as u8;
        }
        self.h = compress256(self.h, self.buf);
        let out: [u8; 64] = [0u8; 64];
        for i in 0..32 {
            out[i] = (self.h[i / 4] >> (24 - 8 * (i % 4)) as u32) as u8;
        }
        out
    }
}

/// SHA-512 state (and, with another start and a cut output, SHA-384):
/// 128-byte blocks.
struct Sha512State {
    h: [u64; 8];
    buf: [u8; 128];
    n: usize;
    total: u64;
    out_len: usize;
}

impl Sha512State {
    const fn new(iv: [u64; 8], out_len: usize) -> Sha512State {
        Sha512State { h: iv, buf: [0u8; 128], n: 0, total: 0u64, out_len }
    }

    fn update<B: AsBytes>(ref self, data: B) {
        let s = data.byte_slice();
        // Locals, written back once: per-byte field access is slow.
        let h = self.h;
        let buf = self.buf;
        let n = self.n;
        for x in s {
            buf[n] = x;
            n += 1;
            if n == 128 {
                h = compress512(h, buf);
                n = 0;
            }
        }
        self.h = h;
        self.buf = buf;
        self.n = n;
        self.total = self.total.wrapping_add(s.len() as u64);
    }

    const fn update_raw(ref self, b: [u8; 168], len: usize) {
        let h = self.h;
        let buf = self.buf;
        let n = self.n;
        for i in 0..len {
            buf[n] = b[i];
            n += 1;
            if n == 128 {
                h = compress512(h, buf);
                n = 0;
            }
        }
        self.h = h;
        self.buf = buf;
        self.n = n;
        self.total = self.total.wrapping_add(len as u64);
    }

    const fn finish(self) -> [u8; 64] {
        // Message lengths stay below 2^61 bytes: the high length word is 0.
        let bits = self.total.wrapping_mul(8u64);
        self.buf[self.n] = 0x80u8;
        self.n += 1;
        if self.n > 112 {
            while self.n < 128 { self.buf[self.n] = 0u8; self.n += 1; }
            self.h = compress512(self.h, self.buf);
            self.n = 0;
        }
        while self.n < 120 { self.buf[self.n] = 0u8; self.n += 1; }
        for i in 0..8 {
            self.buf[120 + i] = (bits >> (56 - 8 * i) as u64) as u8;
        }
        self.h = compress512(self.h, self.buf);
        let out: [u8; 64] = [0u8; 64];
        for i in 0..self.out_len {
            out[i] = (self.h[i / 8] >> (56 - 8 * (i % 8)) as u64) as u8;
        }
        out
    }
}

/// A hash function chosen at run time (HMAC, HKDF, signatures, TLS).
#[non_exhaustive]
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub enum HashAlgorithm {
    Sha256,
    Sha384,
    Sha512,
    Sha3_256,
    Sha3_512,
}

impl HashAlgorithm {
    pub const fn output_len(self) -> usize {
        match self {
            HashAlgorithm::Sha256 => 32,
            HashAlgorithm::Sha384 => 48,
            HashAlgorithm::Sha512 => 64,
            HashAlgorithm::Sha3_256 => 32,
            HashAlgorithm::Sha3_512 => 64,
        }
    }

    /// The block length; for SHA-3 the sponge rate (HMAC's block).
    pub const fn block_len(self) -> usize {
        match self {
            HashAlgorithm::Sha256 => 64,
            HashAlgorithm::Sha384 => 128,
            HashAlgorithm::Sha512 => 128,
            HashAlgorithm::Sha3_256 => 136,
            HashAlgorithm::Sha3_512 => 72,
        }
    }

    pub fn digest<B: AsBytes>(self, data: B) -> List<u8> {
        let d = Digest::new(self);
        d.update(data);
        d.finish()
    }

    const fn is_sha3(self) -> bool {
        self == HashAlgorithm::Sha3_256 || self == HashAlgorithm::Sha3_512
    }
}

/// A running hash of a `HashAlgorithm`. A value: copying it forks the
/// running hash (a transcript hash read mid-way).
pub struct Digest {
    alg: HashAlgorithm;
    s256: Sha256State;
    s512: Sha512State;
    k: Keccak;
}

impl Digest {
    pub const fn new(alg: HashAlgorithm) -> Digest {
        let s512 = match alg {
            HashAlgorithm::Sha384 => Sha512State::new(IV384, 48),
            _ => Sha512State::new(IV512, 64),
        };
        let rate = if alg.is_sha3() { alg.block_len() } else { 136 };
        Digest { alg, s256: Sha256State::new(), s512, k: Keccak::new(rate, 0x06u8) }
    }

    pub const fn algorithm(self) -> HashAlgorithm { self.alg }

    pub fn update<B: AsBytes>(ref self, data: B) {
        match self.alg {
            HashAlgorithm::Sha256 => self.s256.update(data),
            HashAlgorithm::Sha384 => self.s512.update(data),
            HashAlgorithm::Sha512 => self.s512.update(data),
            HashAlgorithm::Sha3_256 => self.k.absorb(data),
            HashAlgorithm::Sha3_512 => self.k.absorb(data),
        }
    }

    pub const fn finish(self) -> List<u8> {
        let d = self.finish_raw();
        let out: List<u8> = List::with_capacity(self.alg.output_len());
        for i in 0..self.alg.output_len() { out.push(d[i]); }
        out
    }

    /// `update` with `b[0:len]`: secret input that is in no list.
    pub(pkg) const fn update_raw(ref self, b: [u8; 168], len: usize) {
        match self.alg {
            HashAlgorithm::Sha256 => self.s256.update_raw(b, len),
            HashAlgorithm::Sha384 => self.s512.update_raw(b, len),
            HashAlgorithm::Sha512 => self.s512.update_raw(b, len),
            HashAlgorithm::Sha3_256 => self.k.absorb_raw(b, len),
            HashAlgorithm::Sha3_512 => self.k.absorb_raw(b, len),
        }
    }

    /// `finish` into the first `output_len` bytes of an array.
    pub(pkg) const fn finish_raw(self) -> [u8; 64] {
        if self.alg.is_sha3() {
            let k = self.k;
            let s = k.squeeze_raw(self.alg.output_len());
            let out: [u8; 64] = [0u8; 64];
            for i in 0..self.alg.output_len() { out[i] = s[i]; }
            return out;
        }
        if self.alg == HashAlgorithm::Sha256 { self.s256.finish() } else { self.s512.finish() }
    }
}

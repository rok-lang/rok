// SHA-2 (FIPS 180-4): SHA-256, SHA-384 and SHA-512. `HashAlgorithm`
// chooses a SHA-2 or a SHA-3 function (`sha3`); `Digest` is a running
// hash of either.

use sup::sha3::Keccak;


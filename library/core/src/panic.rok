// rok::core::panic - the compiler hooks `panic_fn` / `oom_fn` /
// `unreachable_fn`: print a message to stderr and
// exit 101. They never return: `-> !` fits any slot.

/// Abort with `msg`, reporting the first caller outside a
/// `#[track_caller]` chain.
#[lang("panic_fn")]
#[track_caller]
pub const fn panic(msg: str) -> ! {
    unsafe { rok_panic_at(msg) };
}

/// Out of memory (Fatal). The runtime's allocation failures end in the
/// same `rok_oom`.
#[lang("oom_fn")]
pub const fn oom() -> ! {
    unsafe { rok_oom() };
}

/// Abort: code the program believed it could never reach ran.
#[lang("unreachable_fn")]
#[track_caller]
pub const fn unreachable() -> ! {
    unsafe { rok_panic_at("internal error: entered unreachable code") };
}

/// Abort unless `cond` holds.
#[track_caller]
pub const fn assert(cond: bool, msg: str = "") {
    if !cond {
        panic(if msg == "" { "assertion failed" } else { f"assertion failed: {msg}" });
    }
}

/// Abort unless `left == right`; the message shows both via `Debug`.
#[track_caller]
pub const fn assert_eq<T: PartialEq + Debug>(left: T, right: T, msg: str = "") {
    if !(left == right) {
        panic(assert_failed("==", f"{left:?}", f"{right:?}", msg));
    }
}

/// Abort if `left == right`; the message shows both via `Debug`.
#[track_caller]
pub const fn assert_ne<T: PartialEq + Debug>(left: T, right: T, msg: str = "") {
    if left == right {
        panic(assert_failed("!=", f"{left:?}", f"{right:?}", msg));
    }
}

const fn assert_failed(op: str, left: str, right: str, msg: str) -> str {
    let tail = if msg == "" { "" } else { f": {msg}" };
    f"assertion `left {op} right` failed{tail}\n  left: {left}\n right: {right}"
}

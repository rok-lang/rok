// rok::core::collections - List / Dict / Set / OrderedDict / OrderedSet /
// Slice (stdlib spec 2.9), Deque and BinaryHeap.
//
// Each collection is a small handle struct over GC buffers (`raw`):
// copying the handle shares the collection, so the mutating methods
// take `self` (spec writes `ref self`; the handle makes that moot).

pub(pkg) mod raw;
pub mod list;
pub mod deque;
pub mod heap;
pub mod dict;
pub mod set;
pub mod ordered_dict;
pub mod ordered_set;
pub mod slice;
pub mod broadcast;

// `use rok::core::collections::List` (stdlib 2.9).
pub use list::{List, ListIter, ListIntoIter};
pub use deque::{Deque, DequeIter};
pub use heap::BinaryHeap;
pub use dict::{Dict, Entry, KeysIter, ValuesIter, EntriesIter};
pub use set::Set;
pub use ordered_dict::OrderedDict;
pub use ordered_set::OrderedSet;
pub use slice::{Slice, SliceIter, SliceMut, SliceMutIter};

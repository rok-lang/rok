// rok::core::collections - List / Dict / Set / Slice,
// Deque and BinaryHeap.
//
// Each collection is a small handle struct over GC buffers (`raw`):
// copying the handle shares the collection, so the mutating methods
// take `self` (not `ref self`: the handle is what they change).

pub(pkg) mod raw;
pub mod list;
pub mod deque;
pub mod heap;
pub mod dict;
pub mod set;
pub mod slice;
pub mod broadcast;

// `use rok::core::collections::List`.
pub use list::{List, ListIter, ListIntoIter};
pub use deque::{Deque, DequeIter};
pub use heap::{BinaryHeap, HeapIter};
pub use dict::{Dict, Entry, Keys, Values, DictIter};
pub use set::{Set, SetIter};
pub use slice::{Slice, SliceIter, SliceMut, SliceMutIter};

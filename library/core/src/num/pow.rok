// rok::core::num::pow - `**` and `**=` on the primitives. An integer
// base takes a `u32` exponent (exact, overflow checked like `*`); a
// float base takes its own float type (`pow`) or an `i32` (`powi`,
// repeated multiplication).

impl Pow<u32> for i8 {
    type Output = i8;
    #[track_caller]
    const fn pow(self, rhs: u32) -> i8 { self.pow(rhs) }
}

impl PowAssign<u32> for i8 {
    #[track_caller]
    const fn pow_assign(ref self, rhs: u32) { self = self.pow(rhs); }
}

impl Pow<u32> for i16 {
    type Output = i16;
    #[track_caller]
    const fn pow(self, rhs: u32) -> i16 { self.pow(rhs) }
}

impl PowAssign<u32> for i16 {
    #[track_caller]
    const fn pow_assign(ref self, rhs: u32) { self = self.pow(rhs); }
}

impl Pow<u32> for i32 {
    type Output = i32;
    #[track_caller]
    const fn pow(self, rhs: u32) -> i32 { self.pow(rhs) }

// rok::core::num::bigint: `int`, the arbitrary-precision integer.
// `#[keyword("int")]` routes the type name
// here; an unsuffixed literal in an `int` slot is built by
// `Int::from_i64` / `Int::from_literal`.
//
// A value that fits `i64` lives in `small`, anything larger is sign +
// magnitude (`IntMag`, base-2^32 limbs). Results that fit `i64` always
// drop back to `small`, so `==` / `hash` stay a field compare.
// Limb buffers are never written once in an `Int`, so copies share them
// (`int` is `Copy`).
//
// add / sub / shifts / products / Knuth D / gcd are runtime kernels
// (`rokr/src/bignum.rs`). Here: Burnikel-Ziegler division above `BZ`
// limbs, Barrett above `MU`, divide-and-conquer radix conversion over
// chunk^(2^i), small remainders from a product mod B^m - 1, and cached
// NTT transforms for an operand multiplied many times.

use rok::core::collections::raw::{GcBuf, buf_new};
use rok::core::convert::AsBytes;

/// Divisor limbs below which (or quotient limbs below which) division
/// is schoolbook (Knuth D); limb / digit counts below which radix
/// conversion is quadratic; power limbs from which output divides by a
/// reciprocal. Measured on aarch64.
const BZ: usize = 60;
const MU: usize = 3000;
const STR_SMALL: usize = 40;
const PARSE_SMALL: usize = 400;
const BARRETT: usize = 200;
const RECIP_SMALL: usize = 120;

/// A magnitude: little-endian base-2^32 limbs `d[0..n]`, no leading
/// zero limb (`n == 0` is zero). `d` may be longer than `n`.
pub(pkg) struct IntMag {
    d: GcBuf<u32>;
    n: usize;
}

impl IntMag {
    const fn zero() -> IntMag {
        unsafe {
            IntMag { d: buf_new(0), n: 0 }
        }
    }

    /// `d[0..n]` without its leading zero limbs (shares `d`).
    #[must_use]
    const fn trim(d: GcBuf<u32>, n: usize) -> IntMag {
        unsafe {
            let k = n;
            while k > 0 && d[k - 1] == 0u32 { k -= 1; }
            IntMag { d: d, n: k }
        }
    }

    #[must_use]
    const fn from_u64(v: u64) -> IntMag {
        unsafe {
            let d: GcBuf<u32> = buf_new(2);
            d[0] = v as u32;
            d[1] = (v >> 32u64) as u32;
            IntMag::trim(d, 2)
        }
    }

    /// Limb `i`, zero past the top.
    const fn limb(self, i: usize) -> u64 {
        unsafe {
            if i < self.n { self.d[i] as u64 } else { 0u64 }
        }
    }

    /// The low 64 bits.
    const fn low64(self) -> u64 { (self.limb(1) << 32u64) | self.limb(0) }

    /// Number of significant bits (0 for zero).
    const fn bits(self) -> u64 {
        unsafe {
            if self.n == 0 { return 0u64; }
            (self.n as u64) * 32u64 - (self.d[self.n - 1].leading_zeros() as u64)
        }
    }

    /// `self` vs `b`: -1, 0 or 1.
    const fn cmp3(self, b: IntMag) -> i32 {
        unsafe {
            if self.n != b.n { return if self.n < b.n { -1 } else { 1 }; }
            let i = self.n;
            while i > 0 {
                i -= 1;
                if self.d[i] != b.d[i] { return if self.d[i] < b.d[i] { -1 } else { 1 }; }
            }
            0
        }
    }

    const fn plus(self, b: IntMag) -> IntMag {
        unsafe {
            if self.n < b.n { return b.plus(self); }
            let r: GcBuf<u32> = buf_new(self.n + 1);
            r[self.n] = rok_nat_add(r, self.d, self.n, b.d, b.n);
            IntMag::trim(r, self.n + 1)
        }
    }

    /// `self - b`, `self >= b`.
    const fn minus(self, b: IntMag) -> IntMag {
        unsafe {
            let r: GcBuf<u32> = buf_new(self.n);
            rok_nat_sub(r, self.d, self.n, b.d, b.n);
            IntMag::trim(r, self.n)
        }
    }

    /// `hi B^k + lo` for `lo < B^k`.
    const fn join(hi: IntMag, lo: IntMag, k: usize) -> IntMag {
        unsafe {
            let r: GcBuf<u32> = buf_new(k + hi.n + 1);
            rok_nat_shl(r, 0, lo.d, lo.n, 0u32);
            rok_nat_shl(r, k, hi.d, hi.n, 0u32);
            IntMag::trim(r, k + hi.n + 1)
        }
    }

    /// Limbs `lo..hi` (a copy).
    const fn slice(self, lo: usize, hi: usize) -> IntMag {
        unsafe {
            let h = if hi < self.n { hi } else { self.n };
            if lo >= h { return IntMag::zero(); }
            let r: GcBuf<u32> = buf_new(h - lo);
            rok_nat_shr(r, self.d, h, (lo as u64) * 32u64);
            IntMag::trim(r, h - lo)
        }
    }

    /// Limbs `0..k` (shares `d`).
    const fn low(self, k: usize) -> IntMag {
        IntMag::trim(self.d, if k < self.n { k } else { self.n })
    }

    /// B^n - 1.
    const fn ones(n: usize) -> IntMag {
        unsafe {
            let d: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            while i < n {
                d[i] = 0xFFFF_FFFFu32;
                i += 1;
            }
            IntMag { d: d, n: n }
        }
    }

    /// `self * b` (squares when `b` is `self`).
    fn times(self, b: IntMag) -> IntMag {
        unsafe {
            if self.n == 0 || b.n == 0 { return IntMag::zero(); }
            let n = self.n + b.n;
            let r: GcBuf<u32> = buf_new(n);
            let t: GcBuf<u32> = buf_new(rok_nat_mul_scratch(self.n, b.n));
            rok_nat_mul(r, self.d, self.n, b.d, b.n, t);
            IntMag::trim(r, n)
        }
    }

    /// `self << s` bits.
    const fn shl(self, s: u64) -> IntMag {
        unsafe {
            if self.n == 0 { return self; }
            let limbs = (s / 32u64) as usize;
            let r: GcBuf<u32> = buf_new(self.n + limbs + 1);
            rok_nat_shl(r, limbs, self.d, self.n, (s % 32u64) as u32);
            IntMag::trim(r, self.n + limbs + 1)
        }
    }

    /// `self >> s` bits (floor).
    const fn shr(self, s: u64) -> IntMag {
        unsafe {
            if s / 32u64 >= self.n as u64 { return IntMag::zero(); }
            let n = self.n - (s / 32u64) as usize;
            let r: GcBuf<u32> = buf_new(n);
            rok_nat_shr(r, self.d, self.n, s);
            IntMag::trim(r, n)
        }
    }

    /// `(self / b, self % b)`, `b != 0`. Short divisors or quotients go
    /// to Knuth D; otherwise the normalized dividend is divided in base
    /// B^n digits (`n` the divisor's limbs), each a Burnikel-Ziegler
    /// 2n/1n step over one plan of the divisor's levels.
    fn divmod(self, b: IntMag) -> (IntMag, IntMag) {
        unsafe {
            if self.cmp3(b) < 0 { return (IntMag::zero(), self); }
            if b.n < BZ || self.n < b.n + BZ { return self.divmod_knuth(b); }
            let s = b.d[b.n - 1].leading_zeros() as u64;
            let bs = b.shl(s);
            let a = self.shl(s);
            if bs.n >= MU && a.n >= bs.n + MU {
                let (q, r) = a.divmod_mu(bs);
                return (q, r.shr(s));
            }
            let n = bs.n;
            let (plan, w, wn) = bz_plan(bs);
            let k = (a.n + n - 1) / n;
            let q: GcBuf<u32> = buf_new(k * n);
            let r = IntMag::zero();
            let i = k;
            while i > 0 {
                i -= 1;
                let (qd, rd) = IntMag::join(r, a.slice(i * n, i * n + n), n).div2n1n(plan, 0, w, wn);
                let j = 0usize;
                while j < qd.n {
                    q[i * n + j] = qd.d[j];
                    j += 1;
                }
                r = rd;
            }
            (IntMag::trim(q, k * n), r.shr(s))
        }
    }

    /// `(self / b, self % b)` for `b` of `n` limbs with its top bit set,
    /// `self.n > n` (Barrett): the dividend in base B^k digits from the
    /// top, `k` the quotient's limbs up to `n`. Each digit of the
    /// quotient is estimated from the top `dl = min(k + 1, n)` limbs of
    /// the divisor (`d`; off by 1 at most) by `inv = floor(B^(dl+k) /
    /// d)` (2 short at most); the remainder, a few `b` either way, comes
    /// from `q b` mod B^m - 1.
    fn divmod_mu(self, b: IntMag) -> (IntMag, IntMag) {
        unsafe {
            let n = b.n;
            let qn = self.n - n;
            let nb = (qn + n - 1) / n;
            let c = mu_cost(qn, n, nb);
            let j = nb + 1;
            while j <= nb + 4 {
                let cj = mu_cost(qn, n, j);
                if cj < c {
                    c = cj;
                    nb = j;
                }
                j += 1;
            }
            let k = (qn + nb - 1) / nb;
            let dl = if k + 1 < n { k + 1 } else { n };
            let inv = b.slice(n - dl, n).recip_approx().shr(((dl - k) as u64) * 32u64);
            let m = rok_nat_mulmod_len(k + 1, n, n + 2);
            // Every digit multiplies by `inv` and `b`: their transforms.
            let len = rok_nat_ntt_len(k + 1, k + 1);
            let wn = if len > m { len } else { m };
            let w: GcBuf<u32> = buf_new(if len > 0 { 6 * wn } else { 0 });
            let invf: GcBuf<u32> = buf_new(if len > 0 { 3 * len } else { 0 });
            let bf: GcBuf<u32> = buf_new(if len > 0 { 3 * m } else { 0 });
            if len > 0 {
                rok_nat_ntt_roots(w, wn);
                rok_nat_ntt_prep(invf, inv.d, inv.n, len, w, wn);
                rok_nat_ntt_prep(bf, b.d, b.n, m, w, wn);
            }
            let one = IntMag::from_u64(1u64);
            let q: GcBuf<u32> = buf_new(k * nb + 1);
            let r = self.slice(k * nb, self.n);
            if r.cmp3(b) >= 0 {
                q[k * nb] = 1u32;
                r = r.minus(b);
            }
            let i = nb;
            while i > 0 {
                i -= 1;
                let y = IntMag::join(r, self.slice(i * k, i * k + k), k);
                // floor(floor(y / B^(n - dl)) / B^(dl - 1) * inv / B^(k + 1)).
                let qe = y.slice(n - 1, y.n).times_prep(inv, invf, len, w, wn).slice(k + 1, 2 * k + 3);
                let qb = if len > 0 { qe.times_prep(b, bf, m, w, wn) } else { qe.mulmod(b, m) };
                let (neg, rr) = y.fold(m).wrap_sub(qb, m);
                while neg {
                    qe = qe.minus(one);
                    if rr.cmp3(b) <= 0 {
                        neg = false;
                        rr = b.minus(rr);
                    } else {
                        rr = rr.minus(b);
                    }
                }
                while rr.cmp3(b) >= 0 {
                    qe = qe.plus(one);
                    rr = rr.minus(b);
                }
                let j = 0usize;
                while j < qe.n {
                    q[i * k + j] = qe.d[j];
                    j += 1;
                }
                r = rr;
            }
            (IntMag::trim(q, k * nb + 1), r)
        }
    }

    /// `(self / b, self % b)` for `self < b B^n`, `b` of `n` limbs with
    /// its top bit set (`plan[d]`; Burnikel-Ziegler 1998, algorithm 1):
    /// two 3n/2n steps on half-size digits.
    fn div2n1n(self, plan: List<BzLevel>, d: usize, w: GcBuf<u32>, wn: usize) -> (IntMag, IntMag) {
        let l = plan[d];
        if l.n < BZ || self.n < l.n + BZ { return self.divmod_knuth(l.b); }
        let a = if l.odd { self.shl(32u64) } else { self };
        let e = 2 * l.h;
        let (q1, r1) = IntMag::div3n2n(a.slice(e, a.n), a.slice(l.h, e), plan, d, w, wn);
        let (q2, r2) = IntMag::div3n2n(r1, a.low(l.h), plan, d, w, wn);
        let q = IntMag::join(q1, q2, l.h);
        (q, if l.odd { r2.shr(32u64) } else { r2 })
    }

    /// `(a12 B^h + a3) / v` for `plan[d]`'s `v = v1 B^h + v2` (`a12 < v
    /// B^h`, `a3 < B^h`; algorithm 2).
    fn div3n2n(a12: IntMag, a3: IntMag, plan: List<BzLevel>, d: usize, w: GcBuf<u32>, wn: usize) -> (IntMag, IntMag) {
        let l = plan[d];
        let n = l.h;
        let sh = (n as u64) * 32u64;
        let (q, r) = if a12.shr(sh).cmp3(l.v1) == 0 {
            (IntMag::ones(n), a12.minus(l.v1.shl(sh)).plus(l.v1))
        } else {
            a12.div2n1n(plan, d + 1, w, wn)
        };
        // The estimate is at most 2 too big.
        let t = IntMag::join(r, a3, n);
        let p = q.times_prep(l.v2, l.f, l.len, w, wn);
        while t.cmp3(p) < 0 {
            q = q.minus(IntMag::from_u64(1u64));
            t = t.plus(l.v);
        }
        (q, t.minus(p))
    }

    /// floor(B^2n / self), `n = self.n`: `recip_approx` made exact. The
    /// residue D = B^2n - x self is a few `self` at most, so it comes
    /// from a product mod B^m - 1 (`m >= n + 2`).
    #[must_use]
    fn recip(self) -> IntMag {
        let one = IntMag::from_u64(1u64);
        let n = self.n;
        let x = self.recip_approx();
        let m = unsafe { rok_nat_mulmod_len(x.n, n, n + 2) };
        let (neg, d) = IntMag::wrap_pow(2 * n, m).wrap_sub(x.mulmod(self, m), m);
        while neg {
            x = x.minus(one);
            if d.cmp3(self) <= 0 {
                neg = false;
                d = self.minus(d);
            } else {
                d = d.minus(self);
            }
        }
        while d.cmp3(self) >= 0 {
            x = x.plus(one);
            d = d.minus(self);
        }
        x
    }

    /// floor(B^2n / self) or up to 2 less (`n = self.n`) from `up`, the
    /// next power (`up.p = self^2` of `N` limbs, `up.inv` at most 2 below
    /// floor(B^2N / up.p)): B^2n / self = self B^2N / up.p / B^e, `e = 2N
    /// - 2n`; `up.inv` without its low `e - n - 2` limbs changes that by
    /// less than 1.
    fn recip_from(self, up: Pow) -> IntMag {
        let e = 2 * up.p.n - 2 * self.n;
        let j = e - self.n - 2;
        self.times(up.inv.slice(j, up.inv.n)).shr(((e - j) as u64) * 32u64)
    }

    /// floor(B^2n / self) within a few units (`n = self.n`): one Newton
    /// step from the reciprocal of the top `h = n/2 + 2` limbs. With
    /// X = R_h B^(n-h), B^2n - self X = B^(n-h) E for E = B^(n+h) -
    /// self R_h, so X' = X + R_h E / B^2h; the error squares. |E| is a
    /// few B^n at most, so it comes from a product mod B^m - 1 (`m >=
    /// n + 2`), and E below B^(h-1) changes R_h E / B^2h by less than 1.
    fn recip_approx(self) -> IntMag {
        let n = self.n;
        let one = IntMag::from_u64(1u64);
        if n < RECIP_SMALL {
            let (q, _) = one.shl((n as u64) * 64u64).divmod(self);
            return q;
        }
        let h = n / 2 + 2;
        let rh = self.slice(n - h, n).recip_approx();
        let x = rh.shl(((n - h) as u64) * 32u64);
        let m = unsafe { rok_nat_mulmod_len(n, rh.n, n + 2) };
        if unsafe { rok_nat_ntt_len(h + 1, h + 1) } == 0 {
            let (neg, e) = IntMag::wrap_pow(n + h, m).wrap_sub(self.mulmod(rh, m), m);
            let c = rh.times(e.slice(h - 1, e.n)).shr(((h + 1) as u64) * 32u64);
            return if neg { x.minus(c).minus(one) } else { x.plus(c) };
        }
        // Both products take `rh`: its transform once (length m).
        unsafe {
            let w: GcBuf<u32> = buf_new(6 * m);
            rok_nat_ntt_roots(w, m);
            let f: GcBuf<u32> = buf_new(3 * m);
            rok_nat_ntt_prep(f, rh.d, rh.n, m, w, m);
            let p = self.times_prep(rh, f, m, w, m).fold(m);
            let (neg, e) = IntMag::wrap_pow(n + h, m).wrap_sub(p, m);
            let et = e.slice(h - 1, e.n);
            let c = (if et.n + rh.n <= m { et.times_prep(rh, f, m, w, m) } else { rh.times(et) }).shr(((h + 1) as u64) * 32u64);
            if neg { x.minus(c).minus(one) } else { x.plus(c) }
        }
    }

    /// `self * b mod (B^m - 1)` (`m` from `rok_nat_mulmod_len`).
    fn mulmod(self, b: IntMag, m: usize) -> IntMag {
        unsafe {
            if self.n == 0 || b.n == 0 { return IntMag::zero(); }
            let r: GcBuf<u32> = buf_new(m);
            let t: GcBuf<u32> = buf_new(rok_nat_mulmod_scratch(self.n, b.n, m));
            rok_nat_mulmod(r, self.d, self.n, b.d, b.n, m, t);
            IntMag::trim(r, m)
        }
    }

    /// `self mod (B^m - 1)`.
    const fn fold(self, m: usize) -> IntMag {
        unsafe {
            let x = self;
            while x.n > m { x = x.low(m).plus(x.slice(m, x.n)); }
            if x.n < m { return x; }
            let i = 0usize;
            while i < m {
                if x.d[i] != 0xFFFF_FFFFu32 { return x; }
                i += 1;
            }
            IntMag::zero()
        }
    }

    /// B^e mod (B^m - 1).
    const fn wrap_pow(e: usize, m: usize) -> IntMag {
        IntMag::from_u64(1u64).shl(((e % m) as u64) * 32u64)
    }

    /// The `v = self - y (mod B^m - 1)` of least magnitude, as its sign
    /// and magnitude (`self`, `y` below B^m - 1).
    const fn wrap_sub(self, y: IntMag, m: usize) -> (bool, IntMag) {
        let neg = self.cmp3(y) < 0;
        let d = if neg { y.minus(self) } else { self.minus(y) };
        // Past B^m / 2: the other way round.
        if d.bits() >= (m as u64) * 32u64 { return (!neg, IntMag::ones(m).minus(d)); }
        (neg, d)
    }

    /// `self * v` for `f` the transforms of `v` (`rok_nat_ntt_prep` for
    /// length `len`, roots `w` of `wn`), mod B^len - 1 past `len` limbs;
    /// `len == 0` is a plain product.
    fn times_prep(self, v: IntMag, f: GcBuf<u32>, len: usize, w: GcBuf<u32>, wn: usize) -> IntMag {
        unsafe {
            if len == 0 || self.n == 0 || v.n == 0 { return self.times(v); }
            let n = if self.n + v.n > len { len } else { self.n + v.n };
            let r: GcBuf<u32> = buf_new(n);
            let t: GcBuf<u32> = buf_new(3 * len);
            rok_nat_ntt_mul(r, self.d, self.n, f, v.n, len, w, wn, t);
            IntMag::trim(r, n)
        }
    }

    /// `(self / p, self % p)` for `self < B^2n` (`n = p.n`), by `d.inv`,
    /// floor(B^2n / p) or up to 2 less (Barrett: the estimate is at most
    /// 4 short, so the remainder, below 5p, comes from `q p` mod B^m - 1).
    fn barrett(self, d: Pow, w: GcBuf<u32>, wn: usize) -> (IntMag, IntMag) {
        let p = d.p;
        let n = p.n;
        let t = self.slice(n - 1, self.n).times_prep(d.inv, d.invf, d.len, w, wn);
        let q = t.slice(n + 1, t.n);
        let qp = if d.len > 0 { q.times_prep(p, d.pf, d.m, w, wn) } else { q.mulmod(p, d.m) };
        let (_, r) = self.fold(d.m).wrap_sub(qp, d.m);
        while r.cmp3(p) >= 0 {
            q = q.plus(IntMag::from_u64(1u64));
            r = r.minus(p);
        }
        (q, r)
    }

    /// Knuth TAOCP 4.3.1 algorithm D (a runtime kernel; `b != 0`).
    fn divmod_knuth(self, b: IntMag) -> (IntMag, IntMag) {
        unsafe {
            if self.cmp3(b) < 0 { return (IntMag::zero(), self); }
            if b.n == 1 {
                let q: GcBuf<u32> = buf_new(self.n);
                let rem = rok_nat_divmod_small(q, self.d, self.n, b.d[0]);
                return (IntMag::trim(q, self.n), IntMag::from_u64(rem as u64));
            }
            let m = self.n - b.n + 1;
            let q: GcBuf<u32> = buf_new(m);
            let r: GcBuf<u32> = buf_new(b.n);
            let t: GcBuf<u32> = buf_new(rok_nat_divmod_scratch(self.n, b.n));
            rok_nat_divmod(q, r, self.d, self.n, b.d, b.n, t);
            (IntMag::trim(q, m), IntMag::trim(r, b.n))
        }
    }
}

/// The transforms `divmod_mu` takes with `nb` digits for a quotient of
/// `qn` limbs by `n` (cycles about `t log t` for each of length `t`):
/// the reciprocal (about 15 of length P, the digit's), the two
/// prepared operands, and per digit the inverse and a forward transform
/// of the quotient product (length L) and of the remainder's (m).
const fn mu_cost(qn: usize, n: usize, nb: usize) -> u64 {
    let k = (qn + nb - 1) / nb;
    let lp = pow2_log(k + 2);
    let ll = pow2_log(2 * k + 2);
    let lm = pow2_log(n + 2);
    let t = |l: u64| (l << l);
    15u64 * t(lp) + t(ll) + t(lm) + (nb as u64) * 2u64 * (t(ll) + t(lm))
}

/// log2 of the smallest power of two at least `x`.
const fn pow2_log(x: usize) -> u64 {
    let l = 0u64;
    while (1usize << (l as usize)) < x { l += 1u64; }
    l
}

/// One level of a Burnikel-Ziegler division by `b` (`n` limbs, top bit
/// set): `v` = `b`, times B when `n` is odd (`odd`), its halves `v1`,
/// `v2` of `h` limbs, and the transforms of `v2` for the `h`-limb
/// quotients times it (`len == 0`: plain products). A level with `n <
/// BZ` ends the plan (Knuth D).
struct BzLevel {
    b: IntMag;
    n: usize;
    odd: bool;
    v: IntMag;
    v1: IntMag;
    v2: IntMag;
    h: usize;
    f: GcBuf<u32>;
    len: usize;
}

/// The levels dividing by `b` takes (each next one divides by `v1`),
/// with roots `w` of `wn` for their transforms: every quotient product
/// of a level multiplies by the same `v2`.
fn bz_plan(b: IntMag) -> (List<BzLevel>, GcBuf<u32>, usize) {
    unsafe {
        let none_buf: GcBuf<u32> = buf_new(0);
        let plan: List<BzLevel> = List::new();
        let cur = b;
        let wn = 0usize;
        while true {
            let n = cur.n;
            if n < BZ {
                plan.push(BzLevel { b: cur, n: n, odd: false, v: cur, v1: cur, v2: cur, h: 0, f: none_buf, len: 0 });
                break;
            }
            let odd = n % 2 == 1;
            let v = if odd { cur.shl(32u64) } else { cur };
            let h = (n + 1) / 2;
            let len = rok_nat_ntt_len(h, h);
            if len > wn { wn = len; }
            let v1 = v.slice(h, 2 * h);
            plan.push(BzLevel { b: cur, n: n, odd: odd, v: v, v1: v1, v2: v.low(h), h: h, f: none_buf, len: len });
            cur = v1;
        }
        let w: GcBuf<u32> = buf_new(6 * wn);
        if wn > 0 { rok_nat_ntt_roots(w, wn); }
        for i in 0..plan.len() {
            let l = plan[i];
            if l.len > 0 {
                l.f = buf_new(3 * l.len);
                rok_nat_ntt_prep(l.f, l.v2.d, l.v2.n, l.len, w, wn);
                plan[i] = l;
            }
        }
        (plan, w, wn)
    }
}

/// A power chunk^(2^i) of the radix conversion with what dividing by it
/// takes: its reciprocal (`inv.n == 0`: plain division), the transforms
/// of the reciprocal for products up to `len` limbs and of the power
/// for products mod B^m - 1 (`len == 0`: plain products).
struct Pow {
    p: IntMag;
    inv: IntMag;
    pf: GcBuf<u32>;
    invf: GcBuf<u32>;
    len: usize;
    m: usize;
}

/// The powers of a radix conversion: `pw[i]` = chunk^(2^i), `k` of
/// them, roots `w` of `wn` for their transforms.
struct PowTable {
    pw: List<Pow>;
    k: usize;
    w: GcBuf<u32>;
    wn: usize;
}

/// The table for writing `m` in base `radix`: powers up to the first
/// whose square exceeds `m`, those below it with their reciprocals and
/// transforms (every level but the top divides more than once).
fn str_levels(radix: u32, m: IntMag) -> PowTable {
    unsafe {
        let none_buf: GcBuf<u32> = buf_new(0);
        let (chunk, _) = radix_chunk(radix);
        let pw: List<Pow> = List::new();
        pw.push(Pow { p: IntMag::from_u64(chunk as u64), inv: IntMag::zero(), pf: none_buf, invf: none_buf, len: 0, m: 0 });
        while m.n > STR_SMALL && pw[pw.len() - 1].p.bits() * 2u64 <= m.bits() + 1u64 {
            let p = pw[pw.len() - 1].p;
            pw.push(Pow { p: p.times(p), inv: IntMag::zero(), pf: none_buf, invf: none_buf, len: 0, m: 0 });
        }
        let k = pw.len();
        let wn = 0usize;
        let i = k - 1;
        while i > 0 {
            i -= 1;
            let d = pw[i];
            if d.p.n >= BARRETT {
                d.inv = if i + 2 < k && pw[i + 1].inv.n > 0 { d.p.recip_from(pw[i + 1]) } else { d.p.recip() };
                d.len = rok_nat_ntt_len(d.p.n + 1, d.p.n + 1);
                d.m = rok_nat_mulmod_len(d.p.n + 1, d.p.n, d.p.n + 2);
                if d.len > wn { wn = d.len; }
                pw[i] = d;
            }
        }
        let w: GcBuf<u32> = buf_new(6 * wn);
        if wn > 0 { rok_nat_ntt_roots(w, wn); }
        for i in 0..k - 1 {
            let d = pw[i];
            if d.len > 0 {
                d.pf = buf_new(3 * d.m);
                rok_nat_ntt_prep(d.pf, d.p.d, d.p.n, d.m, w, wn);
                d.invf = buf_new(3 * d.len);
                rok_nat_ntt_prep(d.invf, d.inv.d, d.inv.n, d.len, w, wn);
                pw[i] = d;
            }
        }
        PowTable { pw: pw, k: k, w: w, wn: wn }
    }
}

/// The digits of `x` in base `radix` ending at `out[end]` (exclusive),
/// zero-padded to `width`; the start. By halves: `x < pw[k - 1]^2`
/// splits at `pw[k - 1]` (`per 2^(k-1)` digits) into two `put_digits`
/// on `k - 1`, down to a runtime kernel at `STR_SMALL` (<= 64) limbs.
/// `w` (of `wn`) holds the transforms' roots.
fn put_digits(x: IntMag, pw: List<Pow>, w: GcBuf<u32>, wn: usize, k: usize, per: usize, out: GcBuf<u8>, end: usize, width: usize, radix: u32) -> usize {
    if k == 0 || x.n <= STR_SMALL { return unsafe { rok_nat_put_digits(out, end, x.d, x.n, width, radix) }; }
    let d = pw[k - 1];
    // A leading part may be short: no padding then.
    if x.cmp3(d.p) < 0 { return put_digits(x, pw, w, wn, k - 1, per, out, end, width, radix); }
    let (q, r) = if d.inv.n > 0 { x.barrett(d, w, wn) } else { x.divmod(d.p) };
    let s = per << (k - 1);
    _ = put_digits(r, pw, w, wn, k - 1, per, out, end, s, radix);
    put_digits(q, pw, w, wn, k - 1, per, out, end - s, if width > s { width - s } else { 0 }, radix)
}

/// The value of the checked digits `bs[lo..hi]`, folded `per` at a
/// time: acc = acc * radix^k + chunk (quadratic).
const fn fold_digits(bs: Slice<u8>, lo: usize, hi: usize, radix: u32, per: u32) -> IntMag {
    unsafe {
        let acc: GcBuf<u32> = buf_new((hi - lo) / (per as usize) + 2);
        let len = 0usize;
        let i = lo;
        while i < hi {
            let v = 0u64;
            let mul = 1u64;
            let k = 0u32;
            while k < per && i < hi {
                v = v * (radix as u64) + (digit_of(bs[i]) as u64);
                mul = mul * (radix as u64);
                k += 1u32;
                i += 1;
            }
            // mul <= chunk < 2^32.
            let carry = v;
            let j = 0usize;
            while j < len {
                let t = (acc[j] as u64) * mul + carry;
                acc[j] = t as u32;
                carry = t >> 32u64;
                j += 1;
            }
            if carry != 0u64 {
                acc[len] = carry as u32;
                len += 1;
            }
        }
        IntMag::trim(acc, len)
    }
}

/// `fold_digits` by halves: the low part is the largest `per 2^j`
/// digits shorter than the run, its weight `pw[j]`.
fn parse_digits(bs: Slice<u8>, lo: usize, hi: usize, radix: u32, per: u32, pw: List<IntMag>) -> IntMag {
    let len = hi - lo;
    if len <= PARSE_SMALL { return fold_digits(bs, lo, hi, radix, per); }
    let j = 0usize;
    while ((per as usize) << (j + 1)) < len { j += 1; }
    let l = (per as usize) << j;
    let top = parse_digits(bs, lo, hi - l, radix, per, pw);
    top.times(pw[j]).plus(parse_digits(bs, hi - l, hi, radix, per, pw))
}

/// An arbitrary-precision integer. Write it `int`.
#[lang("int_type")]
#[keyword("int")]
pub struct Int {
    small: i64;
    neg: bool;
    big: IntMag | none;
}

const fn gcd_u64(a: u64, b: u64) -> u64 {
    while b != 0u64 {
        let r = a % b;
        a = b;
        b = r;
    }
    a
}

/// `(10^9, 9)` for base 10: the largest power of `radix` below 2^32 and
/// its digit count.
const fn radix_chunk(radix: u32) -> (u32, u32) {
    let p = radix;
    let k = 1u32;
    while (p as u64) * (radix as u64) < 0x1_0000_0000u64 {
        p = p * radix;
        k += 1u32;
    }
    (p, k)
}

/// Digit value of an ASCII digit or letter (either case).
const fn digit_of(c: u8) -> u32 {
    let v = c as u32;
    if v >= 48u32 && v <= 57u32 { return v - 48u32; }
    if v >= 97u32 && v <= 122u32 { return v - 87u32; }
    v - 55u32
}

/// Zero bits below the lowest one bit of `m != 0`.
const fn mag_trailing_zeros(m: IntMag) -> u64 {
    unsafe {
        let i = 0usize;
        while m.d[i] == 0u32 { i += 1; }
        (i as u64) * 32u64 + (m.d[i].trailing_zeros() as u64)
    }
}

/// Bit `n` of `m`, 0 past the top.
const fn mag_bit(m: IntMag, n: u64) -> bool {
    let i = n / 32u64;
    if i >= m.n as u64 { return false; }
    (m.limb(i as usize) >> (n % 32u64)) & 1u64 == 1u64
}

impl Int {
    /// The value `n`.
    #[must_use]
    pub const fn from_i64(n: i64) -> Int { Int { small: n, neg: false, big: none } }
    /// The value `n`.
    #[must_use]
    pub const fn from_i32(n: i32) -> Int { Int::from_i64(n as i64) }
    /// The value `n`.
    #[must_use]
    pub const fn from_u64(n: u64) -> Int { Int::from_parts(false, IntMag::from_u64(n)) }

    /// An integer literal's digits (`_`, `0x` / `0o` / `0b` allowed):
    /// what an unsuffixed literal too big for `i64` in an `int` slot
    /// lowers to.
    #[internal("to make an `Int` from text, write `try s.parse::<Int>()`")]
    pub fn from_literal(s: str) -> Int {
        let t = if s.contains("_") { s.replace("_", "") } else { s };
        let radix = 10u32;
        if t.len() > 2 && t.as_bytes()[0] == 48u8 {
            // `0x` / `0o` / `0b`, either case.
            let c = t.as_bytes()[1] | 32u8;
            if c == 120u8 { radix = 16u32; }
            if c == 111u8 { radix = 8u32; }
            if c == 98u8 { radix = 2u32; }
            if radix != 10u32 { t = t[2:]; }
        }
        match try? Int::parse_radix(t, radix) {
            v: Int => v,
            none => panic(f"malformed integer literal `{s}`"),
        }
    }

    /// `s` in base `radix`: an optional sign, then digits of either
    /// case. The grammar is the runtime's, the same the primitives'
    /// `FromStr` reads. Panics when `radix` is outside 2..=36.
    #[track_caller]
    #[must_use]
    pub fn parse_radix(s: str, radix: u32) throws (ParseError) -> Int {
        if radix < 2u32 || radix > 36u32 {
            panic(f"Int::parse_radix: radix {radix} is out of 2..=36");
        }
        unsafe {
            let out: GcBuf<i64> = buf_new(1);
            let st = rok_str_parse_int(s, radix, 1, 64u32, out);
            if st == 0 { return Int::from_i64(out[0]); }
            if st == 1 { throw ParseError::new(s, 0, "empty string"); }
            if st != 3 { throw ParseError::new(s, 0, "invalid digit"); }
            // Past `i64`: the checked digits, by halves over the powers
            // pw[j] = chunk^(2^j).
            let bs = s.as_bytes();
            let n = s.len();
            let neg = bs[0] == 45u8;
            let i = if bs[0] == 45u8 || bs[0] == 43u8 { 1usize } else { 0usize };
            let (chunk, per) = radix_chunk(radix);
            let pw: List<IntMag> = List::new();
            pw.push(IntMag::from_u64(chunk as u64));
            while n - i > PARSE_SMALL && ((per as usize) << pw.len()) < n - i {
                let p = pw[pw.len() - 1];
                pw.push(p.times(p));
            }
            Int::from_parts(neg, parse_digits(bs, i, n, radix, per, pw))
        }
    }

    /// The digits in base `radix` (2..=36, lowercase), `-` first when
    /// negative.
    #[track_caller]
    #[must_use]
    pub fn to_str_radix(self, radix: u32) -> str {
        unsafe {
            if radix < 2u32 || radix > 36u32 { panic(f"Int::to_str_radix: radix {radix} is out of 2..=36"); }
            let (neg, m) = self.parts();
            if m.n == 0 { return "0"; }
            let (_, per) = radix_chunk(radix);
            let t = str_levels(radix, m);
            // Digits <= bits / floor(log2 radix) + 1, plus the sign.
            let total = (m.bits() / ((31u32 - radix.leading_zeros()) as u64)) as usize + 2;
            let out: GcBuf<u8> = buf_new(total);
            let at = put_digits(m, t.pw, t.w, t.wn, t.k, per as usize, out, total, 0, radix);
            if neg {
                at -= 1;
                out[at] = 45u8;
            }
            rok_str_from_buf(out, at, total - at)
        }
    }

    /// The value as an `i32`; `none` when it does not fit.
    #[must_use]
    pub const fn to_i32(self) -> i32 | none {
        let v = self.to_i64()?;
        if v < -2147483648 || v > 2147483647 { return none; }
        v as i32
    }

    /// The value as an `i64`; `none` when it does not fit.
    #[must_use]
    pub const fn to_i64(self) -> i64 | none {
        if self.big is none { return self.small; }
        none
    }

    /// The value as a `u64`; `none` when negative or too large.
    #[must_use]
    pub const fn to_u64(self) -> u64 | none {
        if self.big is none {
            if self.small < 0 { return none; }
            return self.small as u64;
        }
        let (neg, m) = self.parts();
        if neg || m.n > 2 { return none; }
        m.low64()
    }

    /// The nearest `f64` (ties to even; `±inf` past `f64::MAX`).
    #[must_use]
    pub fn to_f64(self) -> f64 {
        if self.big is none { return self.small as f64; }
        rok::core::num::bigfloat::Float::from_int(self).to_f64()
    }

    /// `true` for 0.
    #[must_use]
    pub const fn is_zero(self) -> bool { self.big is none && self.small == 0 }
    /// `true` below 0.
    #[must_use]
    pub const fn is_negative(self) -> bool {
        if self.big is none { self.small < 0 } else { self.neg }
    }
    /// `true` above 0.
    #[must_use]
    pub const fn is_positive(self) -> bool { !self.is_zero() && !self.is_negative() }

    /// `-1`, `0` or `1`.
    #[must_use]
    pub const fn signum(self) -> Int {
        if self.is_zero() { return Int::from_i64(0); }
        if self.is_negative() { Int::from_i64(-1) } else { Int::from_i64(1) }
    }

    /// The magnitude.
    #[must_use]
    pub const fn abs(self) -> Int {
        if self.is_negative() { -self } else { self }
    }

    /// Bits of `|self|` without leading zeros (0 for zero; Python's
    /// `bit_length`).
    #[must_use]
    pub const fn bit_length(self) -> u64 {
        let (_, m) = self.parts();
        m.bits()
    }

    /// One bits of `|self|` (Python's `bit_count`): a negative number
    /// has infinitely many in two's complement.
    #[must_use]
    pub const fn count_ones(self) -> u64 {
        unsafe {
            if self.big is none { return self.small.unsigned_abs().count_ones() as u64; }
            let (_, m) = self.parts();
            let c = 0u64;
            let i = 0usize;
            while i < m.n {
                c += m.d[i].count_ones() as u64;
                i += 1;
            }
            c
        }
    }

    /// Zero bits below the lowest one bit, the same for `self` and
    /// `-self`; `none` for zero, which has no one bit.
    #[must_use]
    pub const fn trailing_zeros(self) -> u64 | none {
        if self.is_zero() { return none; }
        if self.big is none { return self.small.trailing_zeros() as u64; }
        let (_, m) = self.parts();
        mag_trailing_zeros(m)
    }

    /// Bit `n` of `self` in two's complement, sign-extended forever: a
    /// negative number has every high bit set.
    #[must_use]
    pub const fn bit(self, n: u64) -> bool {
        if self.big is none {
            if n >= 63u64 { return self.small < 0; }
            return (self.small >> (n as i64)) & 1 == 1;
        }
        let (neg, m) = self.parts();
        if !neg { return mag_bit(m, n); }
        // -m = ~(m - 1): bits below m's lowest one are 0, that one is 1,
        // the rest are m's flipped.
        let tz = mag_trailing_zeros(m);
        if n < tz { return false; }
        if n == tz { return true; }
        !mag_bit(m, n)
    }

    /// Sets bit `n` (as `bit` reads it) to `value`.
    pub const fn set_bit(ref self, n: u64, value: bool) {
        if self.bit(n) == value { return; }
        let p = Int::from_parts(false, IntMag::from_u64(1u64).shl(n));
        self = if value { self + p } else { self - p };
    }

    /// `self == 2^k` for some `k`; false for zero and negatives.
    #[must_use]
    pub const fn is_power_of_two(self) -> bool { self.is_positive() && self.count_ones() == 1u64 }

    /// The smallest power of two `>= self`; `1` for `self <= 1`.
    #[must_use]
    pub const fn next_power_of_two(self) -> Int {
        if self <= Int::from_i64(1) { return Int::from_i64(1); }
        if self.is_power_of_two() { return self; }
        Int::from_parts(false, IntMag::from_u64(1u64).shl(self.bit_length()))
    }

    /// `floor(log2(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog2(self) -> u64 { self.checked_ilog2() ?? panic("Int::ilog2: the number is not positive; use `checked_ilog2` to get `none` instead") }

    /// `floor(log2(self))`; `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog2(self) -> u64 | none {
        if !self.is_positive() { return none; }
        self.bit_length() - 1u64
    }

    /// The shortest two's complement, least significant first: the top
    /// bit is the sign (`-1` is `[255]`, `128` is `[128, 0]`); zero is
    /// `[0]`. Fixed-width integers' `to_le_bytes` agree in their width.
    #[must_use]
    pub fn to_le_bytes(self) -> List<u8> { self.bytes(true, false, "to_le_bytes") }

    /// As `to_le_bytes`, most significant first.
    #[must_use]
    pub fn to_be_bytes(self) -> List<u8> { self.bytes(true, true, "to_be_bytes") }

    /// The magnitude, least significant first, with no sign bit (`255`
    /// is `[255]`); zero is `[0]`. Panics on a negative number.
    #[must_use]
    #[track_caller]
    pub fn to_le_bytes_unsigned(self) -> List<u8> { self.bytes(false, false, "to_le_bytes_unsigned") }

    /// As `to_le_bytes_unsigned`, most significant first.
    #[must_use]
    #[track_caller]
    pub fn to_be_bytes_unsigned(self) -> List<u8> { self.bytes(false, true, "to_be_bytes_unsigned") }

    /// The length of `to_le_bytes()`.
    #[must_use]
    pub fn byte_len(self) -> usize { self.byte_count(true, "byte_len") }

    /// The length of `to_le_bytes_unsigned()`; panics on a negative
    /// number.
    #[must_use]
    #[track_caller]
    pub fn byte_len_unsigned(self) -> usize { self.byte_count(false, "byte_len_unsigned") }

    /// The `int` of `bytes` in two's complement, least significant
    /// first (a set top bit is negative). No bytes is zero.
    #[must_use]
    pub fn from_le_bytes<B: AsBytes>(bytes: B) -> Int { Int::from_bytes(bytes.byte_slice(), true, false) }

    /// As `from_le_bytes`, most significant first.
    #[must_use]
    pub fn from_be_bytes<B: AsBytes>(bytes: B) -> Int { Int::from_bytes(bytes.byte_slice(), true, true) }

    /// The `int` of the magnitude `bytes`, least significant first;
    /// never negative. No bytes is zero.
    #[must_use]
    pub fn from_le_bytes_unsigned<B: AsBytes>(bytes: B) -> Int { Int::from_bytes(bytes.byte_slice(), false, false) }

    /// As `from_le_bytes_unsigned`, most significant first.
    #[must_use]
    pub fn from_be_bytes_unsigned<B: AsBytes>(bytes: B) -> Int { Int::from_bytes(bytes.byte_slice(), false, true) }

    /// `self` in two's complement in exactly `out.len()` bytes, least
    /// significant first, sign-extended. Panics if it needs more bytes
    /// (`byte_len() > out.len()`).
    #[track_caller]
    pub fn write_le_bytes(self, out: SliceMut<u8>) { self.write_bytes(out, true, false, "write_le_bytes") }

    /// As `write_le_bytes`, most significant first.
    #[track_caller]
    pub fn write_be_bytes(self, out: SliceMut<u8>) { self.write_bytes(out, true, true, "write_be_bytes") }

    /// The magnitude in exactly `out.len()` bytes, least significant
    /// first, zero-extended. Panics on a negative number or if it needs
    /// more bytes (`byte_len_unsigned() > out.len()`).
    #[track_caller]
    pub fn write_le_bytes_unsigned(self, out: SliceMut<u8>) { self.write_bytes(out, false, false, "write_le_bytes_unsigned") }

    /// As `write_le_bytes_unsigned`, most significant first.
    #[track_caller]
    pub fn write_be_bytes_unsigned(self, out: SliceMut<u8>) { self.write_bytes(out, false, true, "write_be_bytes_unsigned") }

    #[track_caller]
    fn write_bytes(self, out: SliceMut<u8>, signed: bool, be: bool, name: str) {
        unsafe {
            let nb = out.len();
            if !self.is_zero() {
                let need = self.byte_count(signed, name);
                if need > nb {
                    panic(f"Int::{name}: the value needs {need} bytes but `out` has {nb}; pass a view of at least {need} bytes");
                }
            }
            let limbs = self.twos(nb / 4 + 1);
            let i = 0usize;
            while i < nb {
                let k = if be { nb - 1 - i } else { i };
                out[i] = (limbs[k / 4] >> ((k % 4) as u32 * 8u32)) as u8;
                i += 1;
            }
        }
    }

    #[track_caller]
    fn byte_count(self, signed: bool, name: str) -> usize {
        unsafe {
            let (neg, m) = self.parts();
            if neg && !signed {
                let plain = name.replace("_unsigned", "");
                panic(f"Int::{name}: negative value; use {plain} for two's complement or call .abs() first");
            }
            // Sign bit included: -m needs the bits of m - 1, plus one.
            if !signed {
                if m.n == 0 { 1usize } else { ((m.bits() + 7u64) / 8u64) as usize }
            } else if neg {
                (m.minus(IntMag::from_u64(1u64)).bits() / 8u64) as usize + 1
            } else {
                (m.bits() / 8u64) as usize + 1
            }
        }
    }

    #[track_caller]
    fn bytes(self, signed: bool, be: bool, name: str) -> List<u8> {
        unsafe {
            let nb = self.byte_count(signed, name);
            let limbs = self.twos(nb / 4 + 1);
            let out: List<u8> = List::with_capacity(nb);
            let i = 0usize;
            while i < nb {
                let k = if be { nb - 1 - i } else { i };
                out.push((limbs[k / 4] >> ((k % 4) as u32 * 8u32)) as u8);
                i += 1;
            }
            out
        }
    }

    fn from_bytes(v: Slice<u8>, signed: bool, be: bool) -> Int {
        unsafe {
            let n = v.len();
            if n == 0 { return Int::from_i64(0); }
            // One spare byte or more: room for the sign extension.
            let k = n / 4 + 1;
            let top = if be { v[0] } else { v[n - 1] };
            let fill = if signed && top >= 0x80u8 { 0xFFu8 } else { 0u8 };
            let r: GcBuf<u32> = buf_new(k);
            let i = 0usize;
            while i < 4 * k {
                let b = if i < n { (if be { v[n - 1 - i] } else { v[i] }) } else { fill };
                let w = if i % 4 == 0 { 0u32 } else { r[i / 4] };
                r[i / 4] = w | ((b as u32) << ((i % 4) as u32 * 8u32));
                i += 1;
            }
            if signed { Int::from_twos(r, k) } else { Int::from_parts(false, IntMag::trim(r, k)) }
        }
    }

    /// `self^exp` (square and multiply).
    #[must_use]
    pub fn pow(self, exp: u32) -> Int {
        let acc = Int::from_i64(1);
        let base = self;
        let e = exp;
        while e > 0u32 {
            if e & 1u32 == 1u32 { acc = acc * base; }
            e = e >> 1u32;
            if e > 0u32 { base = base * base; }
        }
        acc
    }

    /// `self^exp %% m`: in `0..m` for `m > 0`, `m + 1..=0` for `m < 0`
    /// (the sign of `m`, as `%%`). Panics if `m` is zero or `exp`
    /// negative.
    #[track_caller]
    #[must_use]
    pub fn modpow(self, exp: Int, m: Int) -> Int {
        unsafe {
            if m.is_zero() { panic("Int::modpow: the modulus is zero"); }
            if exp.is_negative() { panic("Int::modpow: the exponent is negative"); }
            let (_, mm) = m.parts();
            let (_, em) = exp.parts();
            let (_, b) = (self %% m.abs()).parts();
            // Left to right over the exponent's bits.
            let (_, acc) = IntMag::from_u64(1u64).divmod(mm);
            let i = em.n;
            while i > 0 {
                i -= 1;
                let w = em.d[i];
                let k = 32u32;
                while k > 0u32 {
                    k -= 1u32;
                    let (_, sq) = acc.times(acc).divmod(mm);
                    acc = sq;
                    if (w >> k) & 1u32 == 1u32 {
                        let (_, pr) = acc.times(b).divmod(mm);
                        acc = pr;
                    }
                }
            }
            let r = Int::from_parts(false, acc);
            if m.is_negative() && !r.is_zero() { r + m } else { r }
        }
    }

    /// The greatest common divisor, never negative (`gcd(0, 0) == 0`).
    /// A runtime kernel (half-gcd reductions, then Lehmer's algorithm)
    /// after one division that brings the operands to about the same
    /// length.
    #[must_use]
    pub fn gcd(self, other: Int) -> Int {
        unsafe {
            if self.big is none && other.big is none {
                return Int::from_u64(gcd_u64(self.small.unsigned_abs(), other.small.unsigned_abs()));
            }
            let (_, a) = self.parts();
            let (_, b) = other.parts();
            if a.cmp3(b) < 0 {
                let t = a;
                a = b;
                b = t;
            }
            if b.n == 0 { return Int::from_parts(false, a); }
            if a.n >= b.n + BZ {
                let (_, r) = a.divmod(b);
                if r.n == 0 { return Int::from_parts(false, b); }
                a = b;
                b = r;
            }
            let g: GcBuf<u32> = buf_new(b.n);
            let t: GcBuf<u32> = buf_new(rok_nat_gcd_scratch(a.n, b.n));
            let n = rok_nat_gcd(g, a.d, a.n, b.d, b.n, t);
            Int::from_parts(false, IntMag::trim(g, n))
        }
    }

    /// The least common multiple, never negative (`0` if either is).
    #[must_use]
    pub fn lcm(self, other: Int) -> Int {
        if self.is_zero() || other.is_zero() { return Int::from_i64(0); }
        (self / self.gcd(other) * other).abs()
    }

    /// The quotient rounded so that `rem_euclid` is never negative;
    /// panics on zero.
    #[track_caller]
    #[must_use]
    pub fn div_euclid(self, rhs: Int) -> Int {
        let (q, r) = self.div_rem(rhs);
        if !r.is_negative() { return q; }
        if rhs.is_positive() { q - Int::from_i64(1) } else { q + Int::from_i64(1) }
    }

    /// The remainder in `0..rhs.abs()`; panics on zero.
    #[track_caller]
    #[must_use]
    pub fn rem_euclid(self, rhs: Int) -> Int {
        let r = self % rhs;
        if r.is_negative() { r + rhs.abs() } else { r }
    }

    /// floor(sqrt(self)); panics on a negative number.
    #[track_caller]
    #[must_use]
    pub fn isqrt(self) -> Int {
        self.checked_isqrt() ?? panic("Int::isqrt: the number is negative; use `checked_isqrt` to get `none` instead")
    }

    /// floor(sqrt(self)), `none` for a negative number. Newton steps
    /// doubling the precision (the recursion of Python's `math.isqrt`):
    /// each refines the root of the top `2d` bits from that of the top
    /// `2e` bits, `e = d / 2`.
    #[must_use]
    pub fn checked_isqrt(self) -> Int | none {
        if self.is_negative() { return none; }
        if self.big is none { return Int::from_i64(self.small.isqrt()); }
        let c = (self.bit_length() - 1u64) / 2u64;
        let a = Int::from_i64(1);
        let d = 0u64;
        let s = 64u32 - c.leading_zeros();
        while s > 0u32 {
            s -= 1u32;
            let e = d;
            d = c >> (s as u64);
            a = (a << ((d - e - 1u64) as u32)) + (self >> ((2u64 * c - e - d + 1u64) as u32)) / a;
        }
        if a * a > self { a - Int::from_i64(1) } else { a }
    }

    /// `(self / rhs, self % rhs)` in one division (truncating, like
    /// `/` and `%`); panics on zero.
    #[track_caller]
    #[must_use]
    pub fn div_rem(self, rhs: Int) -> (Int, Int) {
        if rhs.is_zero() { panic("attempt to divide an int by zero"); }
        if self.big is none && rhs.big is none && !(self.small == -9223372036854775807 - 1 && rhs.small == -1) {
            return (Int::from_i64(self.small / rhs.small), Int::from_i64(self.small % rhs.small));
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        let (q, r) = am.divmod(bm);
        (Int::from_parts(an != bn, q), Int::from_parts(an, r))
    }

    /// Sign and magnitude.
    pub(pkg) const fn parts(self) -> (bool, IntMag) {
        if let m: IntMag = self.big { return (self.neg, m); }
        let v = self.small;
        if v < 0 { (true, IntMag::from_u64(0u64.wrapping_sub(v as u64))) } else { (false, IntMag::from_u64(v as u64)) }
    }

    /// The canonical `int` of sign `neg` and magnitude `m`.
    pub(pkg) const fn from_parts(neg: bool, m: IntMag) -> Int {
        if m.n <= 2 {
            let v = m.low64();
            if v <= 0x7FFF_FFFF_FFFF_FFFFu64 { return Int::from_i64(if neg { -(v as i64) } else { v as i64 }); }
            if neg && v == 0x8000_0000_0000_0000u64 { return Int::from_i64(v as i64); }
        }
        Int { small: 0, neg: neg, big: m }
    }

    /// `self` vs `rhs`: -1, 0 or 1.
    const fn cmp3(self, rhs: Int) -> i32 {
        if self.big is none && rhs.big is none {
            if self.small < rhs.small { return -1; }
            return if self.small > rhs.small { 1 } else { 0 };
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        if an != bn { return if an { -1 } else { 1 }; }
        let c = am.cmp3(bm);
        if an { -c } else { c }
    }

    /// Two's complement limbs over `n` limbs (`n` past the magnitude).
    const fn twos(self, n: usize) -> GcBuf<u32> {
        unsafe {
            let (neg, m) = self.parts();
            let r: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            let carry = 1u64;
            while i < n {
                let v = m.limb(i);
                if neg {
                    let t = ((~(v as u32)) as u64) + carry;
                    r[i] = t as u32;
                    carry = t >> 32u64;
                } else {
                    r[i] = v as u32;
                }
                i += 1;
            }
            r
        }
    }

    /// The `int` of two's complement limbs `r[0..n]` (top bit = sign).
    const fn from_twos(r: GcBuf<u32>, n: usize) -> Int {
        unsafe {
            if r[n - 1] & 0x8000_0000u32 == 0u32 { return Int::from_parts(false, IntMag::trim(r, n)); }
            let m: GcBuf<u32> = buf_new(n);
            let carry = 1u64;
            let i = 0usize;
            while i < n {
                let t = ((~r[i]) as u64) + carry;
                m[i] = t as u32;
                carry = t >> 32u64;
                i += 1;
            }
            Int::from_parts(true, IntMag::trim(m, n))
        }
    }

    /// A bitwise op (`op`: 0 and, 1 or, 2 xor) on infinite two's
    /// complement (Python semantics).
    const fn bitwise(self, rhs: Int, op: i32) -> Int {
        unsafe {
            if self.big is none && rhs.big is none {
                let a = self.small;
                let b = rhs.small;
                return Int::from_i64(if op == 0 { a & b } else if op == 1 { a | b } else { a ^ b });
            }
            let (_, am) = self.parts();
            let (_, bm) = rhs.parts();
            let n = (if am.n > bm.n { am.n } else { bm.n }) + 1;
            let x = self.twos(n);
            let y = rhs.twos(n);
            let r: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            while i < n {
                r[i] = if op == 0 { x[i] & y[i] } else if op == 1 { x[i] | y[i] } else { x[i] ^ y[i] };
                i += 1;
            }
            Int::from_twos(r, n)
        }
    }
}

impl Add for Int {
    type Output = Int;
    const fn add(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_add(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        add_signed(an, am, bn, bm)
    }
}

const fn add_signed(an: bool, am: IntMag, bn: bool, bm: IntMag) -> Int {
    if an == bn { return Int::from_parts(an, am.plus(bm)); }
    let c = am.cmp3(bm);
    if c == 0 { return Int::from_i64(0); }
    if c > 0 { Int::from_parts(an, am.minus(bm)) } else { Int::from_parts(bn, bm.minus(am)) }
}

impl Sub for Int {
    type Output = Int;
    const fn sub(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_sub(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        add_signed(an, am, !bn, bm)
    }
}

impl Mul for Int {
    type Output = Int;
    fn mul(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_mul(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        Int::from_parts(an != bn, am.times(bm))
    }
}

/// Truncating division (`-7 / 2 == -3`); panics on zero.
impl Div for Int {
    type Output = Int;
    #[track_caller]
    fn div(self, rhs: Int) -> Int {
        let (q, _) = self.div_rem(rhs);
        q
    }
}

/// The remainder of `/`: takes the dividend's sign (`-7 % 2 == -1`).
impl Rem for Int {
    type Output = Int;
    #[track_caller]
    fn rem(self, rhs: Int) -> Int {
        let (_, r) = self.div_rem(rhs);
        r
    }
}

/// `%%`: takes the divisor's sign (`-7 %% 2 == 1`).
impl Modulo for Int {
    type Output = Int;
    #[track_caller]
    fn modulo(self, rhs: Int) -> Int {
        let r = self % rhs;
        if !r.is_zero() && r.is_negative() != rhs.is_negative() { r + rhs } else { r }
    }
}

impl Neg for Int {
    type Output = Int;
    const fn neg(self) -> Int {
        if self.big is none {
            if let s: i64 = self.small.checked_neg() { return Int::from_i64(s); }
        }
        let (n, m) = self.parts();
        Int::from_parts(!n, m)
    }
}

impl BitAnd for Int {
    type Output = Int;
    const fn bitand(self, rhs: Int) -> Int { self.bitwise(rhs, 0) }
}

impl BitOr for Int {
    type Output = Int;
    const fn bitor(self, rhs: Int) -> Int { self.bitwise(rhs, 1) }
}

impl BitXor for Int {
    type Output = Int;
    const fn bitxor(self, rhs: Int) -> Int { self.bitwise(rhs, 2) }
}

/// `~x == -x - 1`.
impl BitNot for Int {
    type Output = Int;
    const fn bitnot(self) -> Int { -self - Int::from_i64(1) }
}

/// `x << n == x * 2^n`.
impl Shl<u32> for Int {
    type Output = Int;
    const fn shl(self, n: u32) -> Int {
        let (neg, m) = self.parts();
        Int::from_parts(neg, m.shl(n as u64))
    }
}

/// `x >> n == floor(x / 2^n)` (an arithmetic shift).
impl Shr<u32> for Int {
    type Output = Int;
    const fn shr(self, n: u32) -> Int {
        if self.big is none {
            if n >= 63u32 { return Int::from_i64(if self.small < 0 { -1 } else { 0 }); }
            return Int::from_i64(self.small >> (n as i64));
        }
        let (neg, m) = self.parts();
        if !neg { return Int::from_parts(false, m.shr(n as u64)); }
        // floor(-m / 2^n) = -((m - 1) >> n) - 1.
        let t = m.minus(IntMag::from_u64(1u64)).shr(n as u64);
        Int::from_parts(true, t.plus(IntMag::from_u64(1u64)))
    }
}

impl PartialEq for Int {
    const fn eq(self, rhs: Int) -> bool { self.cmp3(rhs) == 0 }
    const fn ne(self, rhs: Int) -> bool { self.cmp3(rhs) != 0 }
}

impl Eq for Int {}

impl PartialOrd for Int {
    const fn lt(self, rhs: Int) -> bool { self.cmp3(rhs) < 0 }
    const fn gt(self, rhs: Int) -> bool { self.cmp3(rhs) > 0 }
    const fn le(self, rhs: Int) -> bool { self.cmp3(rhs) <= 0 }
    const fn ge(self, rhs: Int) -> bool { self.cmp3(rhs) >= 0 }
}

impl Ord for Int {
    const fn cmp(self, rhs: Int) -> Ordering {
        let c = self.cmp3(rhs);
        if c < 0 { Ordering::Less } else if c > 0 { Ordering::Greater } else { Ordering::Equal }
    }
}

/// The sign, then the magnitude's 32-bit limbs after their count: the
/// same writes for the small and big forms of one value.
impl Hash for Int {
    const fn hash<H: Hasher>(self, ref h: H) {
        unsafe {
            if let m: IntMag = self.big {
                let n = m.n;
                while n > 0 && m.d[n - 1] == 0u32 {
                    n -= 1;
                }
                h.write_u8(if self.neg && n > 0 { 1u8 } else { 0u8 });
                h.write_length_prefix(n);
                for i in 0..n {
                    h.write_u32(m.d[i]);
                }
                return;
            }
            let mag = if self.small < 0 { 0u64.wrapping_sub(self.small as u64) } else { self.small as u64 };
            let n = if mag == 0u64 { 0usize } else if mag >> 32u64 == 0u64 { 1usize } else { 2usize };
            h.write_u8(if self.small < 0 { 1u8 } else { 0u8 });
            h.write_length_prefix(n);
            if n > 0 {
                h.write_u32(mag as u32);
            }
            if n > 1 {
                h.write_u32((mag >> 32u64) as u32);
            }
        }
    }
}

impl Clone for Int {
    const fn clone(self) -> Int { self }
}

impl Copy for Int {}

impl Default for Int {
    const fn default() -> Int { Int::from_i64(0) }
}

impl Zero for Int {
    const fn zero() -> Int { Int::from_i64(0) }
}

impl One for Int {
    const fn one() -> Int { Int::from_i64(1) }
}

/// `b o x X` show the sign and magnitude: `int` has no width for a
/// two's complement form (`{-255:x}` is `-ff`).
impl Display for Int {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        if self.big is none {
            f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self.small, 1u32, 0u32) };
        } else {
            let t = f.ty();
            let r = if t == 'b' { 2u32 } else if t == 'o' { 8u32 } else if t == 'x' || t == 'X' { 16u32 } else { 10u32 };
            let digits = self.abs().to_str_radix(r);
            f.t = unsafe { rok_fmt_digits(f.t, f.flags, f.counts, if self.is_negative() { 1u32 } else { 0u32 }, digits) };
        }
    }
}

impl Debug for Int {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

impl FromStr for Int {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> Int {
        try Int::parse_radix(s, 10u32)
    }
}

// conversions

const fn overflow(ty: str) -> OverflowError { OverflowError::new("try_from", ty) }

/// The low 64 bits of the two's complement form (`wrapping_into`).
const fn low_bits(v: Int) -> u64 {
    if v.big is none { return v.small as u64; }
    let (neg, m) = v.parts();
    let low = m.low64();
    if neg { low.wrapping_neg() } else { low }
}

impl From<i8> for Int { const fn from(value: i8) -> Int { Int::from_i64(value as i64) } }
impl From<i16> for Int { const fn from(value: i16) -> Int { Int::from_i64(value as i64) } }
impl From<i32> for Int { const fn from(value: i32) -> Int { Int::from_i64(value as i64) } }
impl From<i64> for Int { const fn from(value: i64) -> Int { Int::from_i64(value) } }
impl From<isize> for Int { const fn from(value: isize) -> Int { Int::from_i64(value as i64) } }
impl From<u8> for Int { const fn from(value: u8) -> Int { Int::from_i64(value as i64) } }
impl From<u16> for Int { const fn from(value: u16) -> Int { Int::from_i64(value as i64) } }
impl From<u32> for Int { const fn from(value: u32) -> Int { Int::from_i64(value as i64) } }
impl From<u64> for Int { const fn from(value: u64) -> Int { Int::from_u64(value) } }
impl From<usize> for Int { const fn from(value: usize) -> Int { Int::from_u64(value as u64) } }

/// Rounds to nearest (ties to even); throws past `±f64::MAX`.
/// `to_f64` is the infallible form.
impl TryFrom<Int> for f64 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> f64 {
        let r = value.to_f64();
        if r.is_infinite() { throw overflow("f64"); }
        r
    }
}

/// Rounds to nearest; `±f64::MAX` past the range.
impl SaturatingFrom<Int> for f64 {
    fn saturating_from(value: Int) -> f64 {
        let r = value.to_f64();
        if r.is_infinite() { return if r < 0.0 { -f64::MAX } else { f64::MAX }; }
        r
    }
}

impl TryFrom<Int> for i8 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i8 {
        let v = value.to_i64() ?? 128;
        if v < -128 || v > 127 { throw overflow("i8"); }
        v as i8
    }
}
impl TryFrom<Int> for i16 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i16 {
        let v = value.to_i64() ?? 32768;
        if v < -32768 || v > 32767 { throw overflow("i16"); }
        v as i16
    }
}
impl TryFrom<Int> for i32 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i32 {
        match value.to_i32() {
            v: i32 => v,
            none => throw overflow("i32"),
        }
    }
}
impl TryFrom<Int> for i64 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i64 {
        match value.to_i64() {
            v: i64 => v,
            none => throw overflow("i64"),
        }
    }
}
impl TryFrom<Int> for isize {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> isize {
        match value.to_i64() {
            v: i64 => v as isize,
            none => throw overflow("isize"),
        }
    }
}
impl TryFrom<Int> for u8 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u8 {
        let v = value.to_u64() ?? 256u64;
        if v > 255u64 { throw overflow("u8"); }
        v as u8
    }
}
impl TryFrom<Int> for u16 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u16 {
        let v = value.to_u64() ?? 65536u64;
        if v > 65535u64 { throw overflow("u16"); }
        v as u16
    }
}
impl TryFrom<Int> for u32 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u32 {
        let v = value.to_u64() ?? 0x1_0000_0000u64;
        if v > 0xFFFF_FFFFu64 { throw overflow("u32"); }
        v as u32
    }
}
impl TryFrom<Int> for u64 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u64 {
        match value.to_u64() {
            v: u64 => v,
            none => throw overflow("u64"),
        }
    }
}
impl TryFrom<Int> for usize {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> usize {
        match value.to_u64() {
            v: u64 => v as usize,
            none => throw overflow("usize"),
        }
    }
}

/// `value` clamped to `lo..=hi` as an `i64`.
const fn clamp_i64(value: Int, lo: i64, hi: i64) -> i64 {
    if value < Int::from_i64(lo) { return lo; }
    if value > Int::from_i64(hi) { return hi; }
    value.small
}

/// `value` clamped to `0..=hi` as a `u64`.
const fn clamp_u64(value: Int, hi: u64) -> u64 {
    if value.is_negative() { return 0u64; }
    match value.to_u64() {
        v: u64 => if v > hi { hi } else { v },
        none => hi,
    }
}

impl SaturatingFrom<Int> for i8 { const fn saturating_from(value: Int) -> i8 { clamp_i64(value, -128, 127) as i8 } }
impl SaturatingFrom<Int> for i16 { const fn saturating_from(value: Int) -> i16 { clamp_i64(value, -32768, 32767) as i16 } }
impl SaturatingFrom<Int> for i32 {
    const fn saturating_from(value: Int) -> i32 { clamp_i64(value, -2147483648, 2147483647) as i32 }
}
impl SaturatingFrom<Int> for i64 {
    const fn saturating_from(value: Int) -> i64 { clamp_i64(value, -9223372036854775807 - 1, 9223372036854775807) }
}
impl SaturatingFrom<Int> for isize {
    const fn saturating_from(value: Int) -> isize {
        clamp_i64(value, -9223372036854775807 - 1, 9223372036854775807) as isize
    }
}
impl SaturatingFrom<Int> for u8 { const fn saturating_from(value: Int) -> u8 { clamp_u64(value, 255u64) as u8 } }
impl SaturatingFrom<Int> for u16 { const fn saturating_from(value: Int) -> u16 { clamp_u64(value, 65535u64) as u16 } }
impl SaturatingFrom<Int> for u32 { const fn saturating_from(value: Int) -> u32 { clamp_u64(value, 0xFFFF_FFFFu64) as u32 } }
impl SaturatingFrom<Int> for u64 {
    const fn saturating_from(value: Int) -> u64 { clamp_u64(value, 0xFFFF_FFFF_FFFF_FFFFu64) }
}
impl SaturatingFrom<Int> for usize {
    const fn saturating_from(value: Int) -> usize { clamp_u64(value, 0xFFFF_FFFF_FFFF_FFFFu64) as usize }
}

// `wrapping_into` / `as`: the low bits of the two's complement form.
impl WrappingFrom<Int> for i8 { const fn wrapping_from(value: Int) -> i8 { low_bits(value) as i8 } }
impl WrappingFrom<Int> for i16 { const fn wrapping_from(value: Int) -> i16 { low_bits(value) as i16 } }
impl WrappingFrom<Int> for i32 { const fn wrapping_from(value: Int) -> i32 { low_bits(value) as i32 } }
impl WrappingFrom<Int> for i64 { const fn wrapping_from(value: Int) -> i64 { low_bits(value) as i64 } }
impl WrappingFrom<Int> for isize { const fn wrapping_from(value: Int) -> isize { low_bits(value) as isize } }
impl WrappingFrom<Int> for u8 { const fn wrapping_from(value: Int) -> u8 { low_bits(value) as u8 } }
impl WrappingFrom<Int> for u16 { const fn wrapping_from(value: Int) -> u16 { low_bits(value) as u16 } }
impl WrappingFrom<Int> for u32 { const fn wrapping_from(value: Int) -> u32 { low_bits(value) as u32 } }
impl WrappingFrom<Int> for u64 { const fn wrapping_from(value: Int) -> u64 { low_bits(value) } }
impl WrappingFrom<Int> for usize { const fn wrapping_from(value: Int) -> usize { low_bits(value) as usize } }

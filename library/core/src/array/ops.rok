// The dot operators on `Array`: array with array of the same rank
// (stretched to one shape by the broadcast rule, `broadcast_shape`),
// array with scalar and scalar with array. Arithmetic gives an array
// of the element type, comparisons an `Array<bool, N>`.

impl<T: Add<Output = T>, const N: usize> DotAdd<Array<T, N>> for Array<T, N> {
    type Output = Array<T, N>;
    #[track_caller]
    fn dot_add(self, rhs: Array<T, N>) -> Array<T, N> { zip_with(self, rhs, |a: T, b: T| -> T { a + b }) }
}

impl<T: Add<Output = T>, const N: usize> DotAdd<T> for Array<T, N> {
    type Output = Array<T, N>;
    fn dot_add(self, rhs: T) -> Array<T, N> { map_right(self, rhs, |a: T, b: T| -> T { a + b }) }
}

impl<T: Add<Output = T>, const N: usize> DotAdd<Array<T, N>> for T {
    type Output = Array<T, N>;
    fn dot_add(self, rhs: Array<T, N>) -> Array<T, N> { map_left(self, rhs, |a: T, b: T| -> T { a + b }) }
}


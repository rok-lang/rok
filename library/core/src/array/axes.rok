        let view: Array<T, N> = self.select([Ax::Others]);
        view.assign(v);
    }
}

/// `a[i, a:b]`.
impl<T, const N: usize> Index<(isize, SliceArg)> for Array<T, N> {
    type Output = Array<T, { N - 1 }>;
    #[track_caller]
    fn index(self, i: (isize, SliceArg)) -> Array<T, { N - 1 }> { self.select([Ax::At(i.0), Ax::Span(i.1)]) }
}

impl<T, const N: usize> IndexSet<(isize, SliceArg), T> for Array<T, N> {
    #[track_caller]
    fn index_set(self, i: (isize, SliceArg), v: T) {

    type Output = T;
    #[track_caller]
    fn index(self, i: (isize, isize, isize, isize)) -> T { self.elem_at([i.0, i.1, i.2, i.3]) }
}

impl<T> IndexSet<(isize, isize, isize, isize), T> for Array<T, 4> {
    #[track_caller]
    fn index_set(self, i: (isize, isize, isize, isize), v: T) { self.elem_set([i.0, i.1, i.2, i.3], v); }
}

/// `a[mask]`: the elements where the same-shape `mask` is `true`, a
/// rank-1 copy.
impl<T, const N: usize> Index<Array<bool, N>> for Array<T, N> {
    type Output = Array<T, 1>;
    #[track_caller]
    fn index(self, mask: Array<bool, N>) -> Array<T, 1> { self.masked(mask) }
}

impl<T, const N: usize> IndexSet<Array<bool, N>, T> for Array<T, N> {
    #[track_caller]
    fn index_set(self, mask: Array<bool, N>, v: T) { self.fill_masked(mask, v); }
}

impl<T, const N: usize> IndexSet<Array<bool, N>, Array<T, 1>> for Array<T, N> {
    #[track_caller]
    fn index_set(self, mask: Array<bool, N>, v: Array<T, 1>) { self.assign_masked(mask, v); }
}

// The `Index` / `IndexSet` impls of `Array` over axis arguments: every
// tuple of `isize` (a position), `SliceArg` (`a:b:k`), `NewAxis`
// (`none`) and `Rest` (`..`) of up to two parts, and of three parts
// without `none`; four positions on a rank-4 array. A position drops
// its axis, `none` adds one. A bracket that keeps an axis gives a view;
// storing into it writes the array (`a[:, 0] = 0.0`, `a[1:3] = b`).

/// `a[a:b]`.
impl<T, const N: usize> Index<SliceArg> for Array<T, N> {
    type Output = Array<T, N>;
    #[track_caller]
    fn index(self, i: SliceArg) -> Array<T, N> { self.select([Ax::Span(i)]) }
}

impl<T, const N: usize> IndexSet<SliceArg, T> for Array<T, N> {
    #[track_caller]
    fn index_set(self, i: SliceArg, v: T) {
        let view: Array<T, N> = self.select([Ax::Span(i)]);
        view.fill(v);
    }
}

impl<T, const N: usize> IndexSet<SliceArg, Array<T, N>> for Array<T, N> {
    #[track_caller]
    fn index_set(self, i: SliceArg, v: Array<T, N>) {
        let view: Array<T, N> = self.select([Ax::Span(i)]);
        view.assign(v);
    }
}

/// `a[none]`.
impl<T, const N: usize> Index<NewAxis> for Array<T, N> {
    type Output = Array<T, { N + 1 }>;
    #[track_caller]
    fn index(self, i: NewAxis) -> Array<T, { N + 1 }> { self.select([Ax::Insert]) }
}

impl<T, const N: usize> IndexSet<NewAxis, T> for Array<T, N> {
    #[track_caller]
    fn index_set(self, i: NewAxis, v: T) {
        let view: Array<T, { N + 1 }> = self.select([Ax::Insert]);
        view.fill(v);
    }
}

impl<T, const N: usize> IndexSet<NewAxis, Array<T, { N + 1 }>> for Array<T, N> {
    #[track_caller]
    fn index_set(self, i: NewAxis, v: Array<T, { N + 1 }>) {
        let view: Array<T, { N + 1 }> = self.select([Ax::Insert]);
        view.assign(v);
    }
}

/// `a[..]`.
impl<T, const N: usize> Index<Rest> for Array<T, N> {
    type Output = Array<T, N>;
    #[track_caller]
    fn index(self, i: Rest) -> Array<T, N> { self.select([Ax::Others]) }
}

impl<T, const N: usize> IndexSet<Rest, T> for Array<T, N> {
    #[track_caller]
    fn index_set(self, i: Rest, v: T) {
        let view: Array<T, N> = self.select([Ax::Others]);

// Operator traits: the source of every operator token.
//
// `rokc` binds each token to the trait method carrying its `#[infix]` /
// `#[prefix]` / `#[postfix]`; precedence and associativity are fixed by
// the language (3.2.3). `#[lang(...)]` (6.4) binds each trait to a
// compiler slot.

#[lang("add_trait")]
pub trait Add<Rhs = Self> {
    type Output;
    #[infix("+")]
    fn add(self, rhs: Rhs) -> Output;
}

/// `%%`: floored modulo (2.3) - the result takes the divisor's sign, so
/// a positive divisor gives `[0, rhs)` (Python's `%`). No lang slot.
pub trait Modulo<Rhs = Self> {
    type Output;
    #[infix("%%")]
    fn modulo(self, rhs: Rhs) -> Output;
}

#[lang("sub_trait")]
pub trait Sub<Rhs = Self> {
    type Output;
    #[infix("-")]
    fn sub(self, rhs: Rhs) -> Output;
}

#[lang("mul_trait")]
pub trait Mul<Rhs = Self> {
    type Output;
    #[infix("*")]
    fn mul(self, rhs: Rhs) -> Output;
}

#[lang("div_trait")]
pub trait Div<Rhs = Self> {
    type Output;
    #[infix("/")]
    fn div(self, rhs: Rhs) -> Output;
}

#[lang("rem_trait")]
pub trait Rem<Rhs = Self> {
    type Output;
    #[infix("%")]
    fn rem(self, rhs: Rhs) -> Output;
}

#[lang("neg_trait")]
pub trait Neg {
    type Output;
    #[prefix("-")]
    fn neg(self) -> Output;
}

#[lang("not_trait")]
pub trait Not {
    type Output;
    #[prefix("!")]
    fn not(self) -> Output;
}

#[lang("bitnot_trait")]
pub trait BitNot {
    type Output;
    #[prefix("~")]
    fn bitnot(self) -> Output;
}

#[lang("bitand_trait")]
pub trait BitAnd<Rhs = Self> {
    type Output;
    #[infix("&")]
    fn bitand(self, rhs: Rhs) -> Output;
}

#[lang("bitor_trait")]
pub trait BitOr<Rhs = Self> {
    type Output;
    #[infix("|")]
    fn bitor(self, rhs: Rhs) -> Output;
}

#[lang("bitxor_trait")]
pub trait BitXor<Rhs = Self> {
    type Output;
    #[infix("^")]
    fn bitxor(self, rhs: Rhs) -> Output;
}

#[lang("shl_trait")]
pub trait Shl<Rhs = Self> {
    type Output;
    #[infix("<<")]
    fn shl(self, rhs: Rhs) -> Output;
}

#[lang("shr_trait")]
pub trait Shr<Rhs = Self> {
    type Output;
    #[infix(">>")]
    fn shr(self, rhs: Rhs) -> Output;
}

#[lang("eq_trait")]
pub trait PartialEq<Rhs = Self> {
    #[infix("==")]
    fn eq(self, rhs: Rhs) -> bool;

    #[infix("!=")]
    const fn ne(self, rhs: Rhs) -> bool { !self.eq(rhs) }
}

#[lang("cmp_trait")]
pub trait PartialOrd<Rhs = Self>: PartialEq<Rhs> {
    #[infix("<")]
    fn lt(self, rhs: Rhs) -> bool;

    #[infix(">")]
    fn gt(self, rhs: Rhs) -> bool;

    #[infix("<=")]
    fn le(self, rhs: Rhs) -> bool;

    #[infix(">=")]
    fn ge(self, rhs: Rhs) -> bool;

    /// The order, or `none` when the two are incomparable (NaN).
    const fn partial_cmp(self, rhs: Rhs) -> rok::core::cmp::Ordering | none {
        if self.lt(rhs) { return rok::core::cmp::Ordering::Less; }
        if self.gt(rhs) { return rok::core::cmp::Ordering::Greater; }
        if self.le(rhs) { return rok::core::cmp::Ordering::Equal; }
        none
    }
}

#[lang("logical_and_trait")]
pub trait LogicalAnd<Rhs = Self> {
    #[infix("&&")]
    fn logical_and(self, rhs: Rhs) -> bool;
}

#[lang("logical_or_trait")]
pub trait LogicalOr<Rhs = Self> {
    #[infix("||")]
    fn logical_or(self, rhs: Rhs) -> bool;
}

// Compound assignment (stdlib 2.4): `a op= b` calls `op_assign(ref a, b)`
// when the type implements the trait (an in-place update), else it is
// `a = a op b`.

/// `+=`
pub trait AddAssign<Rhs = Self> {
    #[infix("+=")]
    fn add_assign(ref self, rhs: Rhs);
}

/// `-=`
pub trait SubAssign<Rhs = Self> {
    #[infix("-=")]
    fn sub_assign(ref self, rhs: Rhs);
}

/// `*=`
pub trait MulAssign<Rhs = Self> {
    #[infix("*=")]
    fn mul_assign(ref self, rhs: Rhs);
}

/// `/=`
pub trait DivAssign<Rhs = Self> {
    #[infix("/=")]
    fn div_assign(ref self, rhs: Rhs);
}

/// `%=`
pub trait RemAssign<Rhs = Self> {
    #[infix("%=")]
    fn rem_assign(ref self, rhs: Rhs);
}

/// `%%=`
pub trait ModuloAssign<Rhs = Self> {
    #[infix("%%=")]
    fn modulo_assign(ref self, rhs: Rhs);
}

/// `&=`
pub trait BitAndAssign<Rhs = Self> {
    #[infix("&=")]
    fn bitand_assign(ref self, rhs: Rhs);
}

/// `|=`
pub trait BitOrAssign<Rhs = Self> {
    #[infix("|=")]
    fn bitor_assign(ref self, rhs: Rhs);
}

/// `^=`
pub trait BitXorAssign<Rhs = Self> {
    #[infix("^=")]
    fn bitxor_assign(ref self, rhs: Rhs);
}

/// `<<=`
pub trait ShlAssign<Rhs = Self> {
    #[infix("<<=")]
    fn shl_assign(ref self, rhs: Rhs);
}

/// `>>=`
pub trait ShrAssign<Rhs = Self> {
    #[infix(">>=")]
    fn shr_assign(ref self, rhs: Rhs);
}

// Element-wise ("broadcast") counterparts. Same precedence as their
// scalar siblings; the only difference is the trait method they target.

pub trait DotAdd<Rhs = Self> {
    type Output;
    #[infix(".+")]
    fn dot_add(self, rhs: Rhs) -> Output;
}

pub trait DotSub<Rhs = Self> {
    type Output;
    #[infix(".-")]
    fn dot_sub(self, rhs: Rhs) -> Output;
}

pub trait DotMul<Rhs = Self> {
    type Output;
    #[infix(".*")]
    fn dot_mul(self, rhs: Rhs) -> Output;
}

pub trait DotDiv<Rhs = Self> {
    type Output;
    #[infix("./")]
    fn dot_div(self, rhs: Rhs) -> Output;
}

pub trait DotRem<Rhs = Self> {
    type Output;
    #[infix(".%")]
    fn dot_rem(self, rhs: Rhs) -> Output;
}

pub trait DotModulo<Rhs = Self> {
    type Output;
    #[infix(".%%")]
    fn dot_modulo(self, rhs: Rhs) -> Output;
}

pub trait DotEq<Rhs = Self> {
    type Output;
    #[infix(".==")]
    fn dot_eq(self, rhs: Rhs) -> Output;
}

pub trait DotNe<Rhs = Self> {
    type Output;
    #[infix(".!=")]
    fn dot_ne(self, rhs: Rhs) -> Output;
}

pub trait DotLt<Rhs = Self> {
    type Output;
    #[infix(".<")]
    fn dot_lt(self, rhs: Rhs) -> Output;
}

pub trait DotGt<Rhs = Self> {
    type Output;
    #[infix(".>")]
    fn dot_gt(self, rhs: Rhs) -> Output;
}

pub trait DotLe<Rhs = Self> {
    type Output;
    #[infix(".<=")]
    fn dot_le(self, rhs: Rhs) -> Output;
}

pub trait DotGe<Rhs = Self> {
    type Output;
    #[infix(".>=")]
    fn dot_ge(self, rhs: Rhs) -> Output;
}

/// `.&&` / `.||`: element-wise, both sides always evaluated (2.6).
pub trait DotLogicalAnd<Rhs = Self> {
    type Output;
    #[infix(".&&")]
    fn dot_logical_and(self, rhs: Rhs) -> Output;
}

pub trait DotLogicalOr<Rhs = Self> {
    type Output;
    #[infix(".||")]
    fn dot_logical_or(self, rhs: Rhs) -> Output;
}

pub trait DotBitAnd<Rhs = Self> {
    type Output;
    #[infix(".&")]
    fn dot_bitand(self, rhs: Rhs) -> Output;
}

pub trait DotBitOr<Rhs = Self> {
    type Output;
    #[infix(".|")]
    fn dot_bitor(self, rhs: Rhs) -> Output;
}

pub trait DotBitXor<Rhs = Self> {
    type Output;
    #[infix(".^")]
    fn dot_bitxor(self, rhs: Rhs) -> Output;
}

pub trait DotShl<Rhs = Self> {
    type Output;
    #[infix(".<<")]
    fn dot_shl(self, rhs: Rhs) -> Output;
}

pub trait DotShr<Rhs = Self> {
    type Output;
    #[infix(".>>")]
    fn dot_shr(self, rhs: Rhs) -> Output;
}

// Unicode math operators (stdlib spec 2.3.10). Each method has an ASCII
// name, so it can be called by name too. `÷` is `Div`, and `≡ ≠ ≤ ≥`
// are the comparison traits (the lexer reads them as `== != <= >=`).

pub trait Cross<Rhs = Self> {
    type Output;
    #[infix("×")]
    fn cross(self, rhs: Rhs) -> Output;
}

pub trait Dot<Rhs = Self> {
    type Output;
    #[infix("⋅")]
    fn dot(self, rhs: Rhs) -> Output;
}

pub trait Compose<Rhs> {
    type Output;
    #[infix("∘")]
    fn compose(self, rhs: Rhs) -> Output;
}

pub trait Sqrt {
    type Output;
    #[prefix("√")]
    fn sqrt(self) -> Output;
}

// `a ∈ s` is `s.contains(a)` (`swap`, refs-lang 6.7.2).
pub trait Contains<Item> {
    #[infix("∈", swap)]
    fn contains(self, item: Item) -> bool;
    #[infix("∉", swap)]
    const fn not_contains(self, item: Item) -> bool { !self.contains(item) }
}

pub trait Subset<Rhs = Self> {
    #[infix("⊂")]
    fn is_proper_subset(self, rhs: Rhs) -> bool;
    #[infix("⊆")]
    fn is_subset(self, rhs: Rhs) -> bool;
}

pub trait Union<Rhs = Self> {
    type Output;
    #[infix("∪")]
    fn union(self, rhs: Rhs) -> Output;
}

pub trait Intersect<Rhs = Self> {
    type Output;
    #[infix("∩")]
    fn intersection(self, rhs: Rhs) -> Output;
}

// The 2.3.10 table's standard implementations. Set's methods of the
// same names are inherent (`Set::union`), so these spell out the
// bodies over them.

impl<T: PartialEq> Contains<T> for List<T> {
    const fn contains(self, item: T) -> bool { List::contains(self, item) }
}

impl<T: Hash> Contains<T> for Set<T> {
    fn contains(self, item: T) -> bool { Set::contains(self, item) }
}

/// The keys.
impl<K: Hash, V> Contains<K> for Dict<K, V> {
    const fn contains(self, item: K) -> bool { self.contains_key(item) }
}

/// A substring.
impl Contains<str> for str {
    const fn contains(self, item: str) -> bool { str::contains(self, item) }
}

/// `start <= item < end`.
impl<T: PartialOrd> Contains<T> for Range<T> {
    const fn contains(self, item: T) -> bool { self.start <= item && item < self.end }
}

impl<T: Hash> Subset for Set<T> {
    const fn is_proper_subset(self, rhs: Set<T>) -> bool { self.len() < rhs.len() && Set::is_subset(self, rhs) }
    const fn is_subset(self, rhs: Set<T>) -> bool { Set::is_subset(self, rhs) }
}

impl<T: Hash> Union for Set<T> {
    type Output = Set<T>;
    const fn union(self, rhs: Set<T>) -> Set<T> { Set::union(self, rhs) }
}

impl<T: Hash> Intersect for Set<T> {
    type Output = Set<T>;
    const fn intersection(self, rhs: Set<T>) -> Set<T> { Set::intersection(self, rhs) }
}

/// `(f ∘ g)(x) = f(g(x))`.
impl<A, B, C> Compose<fn(A) -> B> for fn(B) -> C {
    type Output = fn(A) -> C;
    const fn compose(self, rhs: fn(A) -> B) -> fn(A) -> C { |x| self(rhs(x)) }
}

// The module path of stdlib 2.6: the broadcast (dot operator) traits.
pub mod broadcast {
    pub use rok::core::ops::{
        DotAdd, DotSub, DotMul, DotDiv, DotRem, DotModulo, DotEq, DotNe, DotLt, DotGt, DotLe,
        DotGe, DotLogicalAnd, DotLogicalOr, DotBitAnd, DotBitOr, DotBitXor, DotShl, DotShr, Dot,
    };
}

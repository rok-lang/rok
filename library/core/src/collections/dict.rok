// rok::core::collections::dict - `Dict<K, V>`, a hash map (stdlib spec
// 2.9.3), compact: entries are appended to dense key / value / hash
// arrays, and a power-of-two index of linear-probed slots maps a hash to
// its entry. A table of at most `SMALL` entries has no index: lookup
// scans the hashes. `remove` leaves a hole; holes are squeezed out when
// the entries are full. One object holds the counts and the current
// arrays, swapped on growth. Iteration follows the entries, so it is in
// insertion order (which `OrderedDict` relies on; for `Dict` the spec
// leaves it unspecified).

use rok::core::marker::{Memo, Transfer, buf_is_null, copy_buf};

/// The dict's object. `keys` / `vals` have one more slot that stays
/// zero: a hole's key and value are overwritten with it, so a removed
/// entry keeps nothing alive. `meta` holds `cap` entry hashes (0: a
/// hole), then `slots` index slots (0: empty, else entry + 1). An index
/// slot of a removed entry stays, pointing at the hole: a tombstone,
/// passed over because no lookup hash is 0. Index slots in use never
/// exceed `cap`, at most 2/3 of `slots`, so probing always ends.
pub struct DictHead<K, V> {
    len: usize;
    n: usize;
    cap: usize;
    slots: usize;
    keys: GcBuf<K>;
    vals: GcBuf<V>;
    meta: GcBuf<u64>;
}

/// Entries a table holds without an index.
const SMALL: usize = 16;

/// `find`'s answer for an absent key.
const ABSENT: usize = usize::MAX;

/// `k.hash()` mixed, so a weak hash (an integer's own value) still
/// spreads over the low bits; never 0, which marks a hole.
#[inline]
const fn mix(h: u64) -> u64 {
    let x = h.wrapping_mul(0x9E37_79B9_7F4A_7C15u64);
    let y = x ^ (x >> 32u64);
    if y == 0u64 { 1u64 } else { y }
}

/// Index slots for `cap` entries: none up to `SMALL`, else a power of
/// two of at least 3/2 `cap`.
#[track_caller]
const fn index_slots(cap: usize) -> usize {
    if cap <= SMALL {
        return 0;
    }
    let want = cap_add(cap, cap / 2);
    let s = 32usize;
    while s < want {
        s = cap_mul(s, 2);
    }
    s
}

/// An empty table of `cap` entries.
#[track_caller]
const fn new_table<K, V>(cap: usize) -> DictHead<K, V> {
    unsafe {
        let n = cap_add(cap, 1);
        let slots = index_slots(cap);
        DictHead {
            len: 0,
            n: 0,
            cap,
            slots,
            keys: buf_new(buf_len(n, size_of::<K>())),
            vals: buf_new(buf_len(n, size_of::<V>())),
            meta: buf_new(buf_len(cap_add(cap, slots), 8)),
        }
    }
}

pub struct Dict<K, V> {
    h: GcBuf<DictHead<K, V>>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<K, V> !Sync for Dict<K, V> {}

/// `pairs.collect::<Dict<K, V>>()`; a later pair's value wins.
impl<K: Hash, V> FromIterator<(K, V)> for Dict<K, V> {
    const fn from_iter<I: IntoIterator<Item = (K, V)>>(it: I) -> Dict<K, V> {
        let out: Dict<K, V> = Dict::new();
        for (k, v) in it {
            out.insert(k, v);
        }
        out
    }
}

impl<K: Hash, V> Dict<K, V> {
    pub const fn new() -> Dict<K, V> {
        Dict::with_capacity(4)
    }

    /// Room for `cap` entries before the first growth.
    #[track_caller]
    pub const fn with_capacity(cap: usize) -> Dict<K, V> {
        unsafe {
            let h: GcBuf<DictHead<K, V>> = buf_new(1);
            h[0] = new_table(cap);
            Dict { h }
        }
    }

    pub const fn len(self) -> usize {
        unsafe {
            self.h[0].len
        }
    }

    pub const fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// The entry holding `k` (mixed hash `h`), or `ABSENT`.
    const fn find(self, k: K, h: u64) -> usize {
        unsafe {
            let s = self.h[0];
            if s.slots == 0 {
                for i in 0..s.n {
                    if s.meta[i] == h && s.keys[i] == k {
                        return i;
                    }
                }
                return ABSENT;
            }
            let mask = s.slots - 1;
            let i = (h as usize) & mask;
            loop {
                let e = s.meta[s.cap + i];
                if e == 0u64 {
                    return ABSENT;
                }
                let at = (e - 1u64) as usize;
                if s.meta[at] == h && s.keys[at] == k {
                    return at;
                }
                i = (i + 1) & mask;
            }
        }
    }

    /// Append `k` (absent, mixed hash `h`) and `v`; the entries have
    /// room.
    const fn append(self, k: K, v: V, h: u64) {
        unsafe {
            let s = self.h[0];
            let at = s.n;
            s.keys[at] = k;
            s.vals[at] = v;
            s.meta[at] = h;
            if s.slots != 0 {
                let mask = s.slots - 1;
                let i = (h as usize) & mask;
                while s.meta[s.cap + i] != 0u64 {
                    i = (i + 1) & mask;
                }
                s.meta[s.cap + i] = (at + 1) as u64;
            }
            self.h[0].n = at + 1;
            self.h[0].len += 1;
        }
    }

    /// Make room for one more entry: squeeze out the holes when they
    /// are more than half the entries, else grow by half.
    #[track_caller]
    const fn grow(self) {
        unsafe {
            let old = self.h[0];
            let cap = old.cap;
            if old.len * 2 >= cap {
                cap = cap_add(cap, cap / 2).max(4);
            }
            self.h[0] = new_table(cap);
            for i in 0..old.n {
                let h = old.meta[i];
                if h != 0u64 {
                    self.append(old.keys[i], old.vals[i], h);
                }
            }
        }
    }

    /// Insert or replace; the old value, or `none`.
    pub const fn insert(self, k: K, v: V) -> V | none {
        unsafe {
            let h = mix(k.hash());
            let at = self.find(k, h);
            if at != ABSENT {
                let s = self.h[0];
                let old = s.vals[at];
                s.vals[at] = v;
                return old;
            }
            if self.h[0].n == self.h[0].cap {
                self.grow();
            }
            self.append(k, v, h);
            none
        }
    }

    pub const fn get(self, k: K) -> V | none {
        unsafe {
            let at = self.find(k, mix(k.hash()));
            if at == ABSENT {
                return none;
            }
            let s = self.h[0];
            s.vals[at]
        }
    }

    pub const fn contains_key(self, k: K) -> bool {
        self.find(k, mix(k.hash())) != ABSENT
    }

    pub const fn remove(self, k: K) -> V | none {
        unsafe {
            let at = self.find(k, mix(k.hash()));
            if at == ABSENT {
                return none;
            }
            let s = self.h[0];
            let v = s.vals[at];
            s.keys[at] = s.keys[s.cap];
            s.vals[at] = s.vals[s.cap];
            s.meta[at] = 0u64;
            self.h[0].len -= 1;
            v
        }
    }

    /// Drop every entry (a fresh small table).
    pub const fn clear(self) {
        unsafe {
            self.h[0] = new_table(4);
        }
    }

    /// The first live entry at or after `from`, or `n`.
    const fn next_full(self, from: usize) -> usize {
        unsafe {
            let s = self.h[0];
            let i = from;
            while i < s.n && s.meta[i] == 0u64 {
                i += 1;
            }
            i
        }
    }

    /// The keys, lazily (2.9.3; insertion order).
    pub const fn keys(self) -> KeysIter<K, V> {
        KeysIter { d: self, at: 0 }
    }

    /// The values, lazily.
    pub const fn values(self) -> ValuesIter<K, V> {
        ValuesIter { d: self, at: 0 }
    }

    /// `(key, value)` pairs, lazily.
    pub const fn entries(self) -> EntriesIter<K, V> {
        EntriesIter { d: self, at: 0 }
    }

    /// `k`'s place in the dict, present or not (2.9.3).
    pub const fn entry(self, k: K) -> Entry<K, V> {
        Entry { d: self, key: k }
    }
}

/// `d.entry(k)`: read or fill one key's slot. Each call looks the key
/// up again.
pub struct Entry<K, V> {
    d: Dict<K, V>;
    key: K;
}

impl<K: Hash, V> Entry<K, V> {
    pub fn key(self) -> K {
        self.key
    }

    /// The value, after inserting `v` if the key is absent.
    pub const fn or_insert(self, v: V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, v);
        }
        self.d[self.key]
    }

    /// The value, after inserting `f()` if the key is absent.
    pub const fn or_insert_with(self, f: fn() -> V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, f());
        }
        self.d[self.key]
    }

    /// A present value replaced by `f(value)`; an absent key is left alone.
    pub const fn and_modify(self, f: fn(V) -> V) -> Entry<K, V> {
        if self.d.contains_key(self.key) {
            self.d.insert(self.key, f(self.d[self.key]));
        }
        self
    }
}

impl<K: Hash, V: Default> Entry<K, V> {
    /// The value, after inserting `V::default()` if the key is absent.
    pub const fn or_default(self) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, V::default());
        }
        self.d[self.key]
    }
}

// The iterators walk the live table; a dict changed while iterated
// gives unspecified (but memory-safe) results.

pub struct KeysIter<K, V> {
    d: Dict<K, V>;
    at: usize;
}

impl<K: Hash, V> Iterator for KeysIter<K, V> {
    type Item = K;
    const fn next(ref self) -> K | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            s.keys[i]
        }
    }
}

pub struct ValuesIter<K, V> {
    d: Dict<K, V>;
    at: usize;
}

impl<K: Hash, V> Iterator for ValuesIter<K, V> {
    type Item = V;
    const fn next(ref self) -> V | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            s.vals[i]
        }
    }
}

pub struct EntriesIter<K, V> {
    d: Dict<K, V>;
    at: usize;
}

impl<K: Hash, V> Iterator for EntriesIter<K, V> {
    type Item = (K, V);
    const fn next(ref self) -> (K, V) | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            (s.keys[i], s.vals[i])
        }
    }
}

impl<K: Hash, V> Default for Dict<K, V> {
    fn default() -> Dict<K, V> { Dict::new() }
}

/// A new dict with every key and value cloned (stdlib 2.13.2).
impl<K: Hash + Clone, V: Clone> Clone for Dict<K, V> {
    const fn clone(self) -> Dict<K, V> {
        let r: Dict<K, V> = Dict::new();
        for (k, v) in self {
            r.insert(k.clone(), v.clone());
        }
        r
    }
}

/// The pairs of a list; a later pair's value wins.
impl<K: Hash, V> From<List<(K, V)>> for Dict<K, V> {
    const fn from(pairs: List<(K, V)>) -> Dict<K, V> {
        let d: Dict<K, V> = Dict::with_capacity(pairs.len());
        for (k, v) in pairs {
            d.insert(k, v);
        }
        d
    }
}

/// `d += e`: merge `e` in place; its values win (stdlib 2.4.6).
impl<K: Hash, V> AddAssign<Dict<K, V>> for Dict<K, V> {
    const fn add_assign(ref self, rhs: Dict<K, V>) {
        for (k, v) in rhs {
            self.insert(k, v);
        }
    }
}

/// `for (k, v) in d` (2.9.9).
impl<K: Hash, V> IntoIterator for Dict<K, V> {
    type IntoIter = EntriesIter<K, V>;
    type Item = (K, V);
    const fn into_iter(self) -> EntriesIter<K, V> {
        self.entries()
    }
}

/// `d[k]`; panics when the key is absent.
impl<K: Hash, V> Index<K> for Dict<K, V> {
    type Output = V;
    #[track_caller]
    const fn index(self, k: K) -> V {
        unsafe {
            let at = self.find(k, mix(k.hash()));
            if at == ABSENT {
                return panic("Dict: key not found");
            }
            let s = self.h[0];
            s.vals[at]
        }
    }
}

/// `d[k] = v` inserts or replaces.
impl<K: Hash, V> IndexSet<K> for Dict<K, V> {
    type Value = V;
    const fn index_set(self, k: K, v: V) {
        self.insert(k, v);
    }
}

/// Same keys, equal values (insertion order does not matter).
impl<K: Hash, V: PartialEq> PartialEq for Dict<K, V> {
    const fn eq(self, rhs: Dict<K, V>) -> bool {
        if self.len() != rhs.len() { return false; }
        for (k, v) in self {
            if !rhs.contains_key(k) { return false; }
            if rhs[k] != v { return false; }
        }
        true
    }
    fn ne(self, rhs: Dict<K, V>) -> bool { !self.eq(rhs) }
}

impl<K: Hash, V: Eq> Eq for Dict<K, V> {}

/// Order-independent: entries combine by xor.
impl<K: Hash, V: Hash> Hash for Dict<K, V> {
    const fn hash(self) -> u64 {
        let h = self.len() as u64;
        for (k, v) in self {
            let vh = v.hash();
            h ^= k.hash() ^ ((vh << 17u64) | (vh >> 47u64));
        }
        h
    }
}

/// `{k: v, ..}` with each key's and value's `Debug`, in iteration order.
impl<K: Hash + Debug, V: Debug> Debug for Dict<K, V> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for (k, v) in self {
            if !first { try f.write_str(", "); }
            try Debug::fmt(k, ref f);
            try f.write_str(": ");
            try Debug::fmt(v, ref f);
            first = false;
        }
        try f.write_str("}")
    }
}

/// `{k: v, ..}` (refs-lang 6.5.1, 6.5.6).
#[literal("{" {expr ":" expr} % "," * "}")]
pub const fn dict_literal<K: Hash, V>(pairs: ...(K, V)) -> Dict<K, V> {
    let d: Dict<K, V> = Dict::new();
    for (k, v) in pairs {
        d.insert(k, v);
    }
    return d;
}

/// A hand-off's copy (stdlib 2.13.9): the same table; keys and values go
/// through `transfer` from the memo's queue (holes stay zero).
impl<K, V> Transfer for Dict<K, V> {
    const fn transfer_copy(self, m: Memo) -> Dict<K, V> {
        if buf_is_null(self.h) {
            return self;
        }
        if let got: GcBuf<DictHead<K, V>> = m.find(self.h) {
            return Dict { h: got };
        }
        unsafe {
            let s = self.h[0];
            let h: GcBuf<DictHead<K, V>> = buf_new(1);
            m.note(self.h, h);
            let n = cap_add(s.cap, 1);
            let index = cap_add(s.cap, s.slots);
            h[0] = DictHead {
                len: s.len,
                n: s.n,
                cap: s.cap,
                slots: s.slots,
                keys: copy_buf(s.keys, 0, s.n, 1, n, m),
                vals: copy_buf(s.vals, 0, s.n, 1, n, m),
                meta: copy_buf(s.meta, 0, index, 1, index, m),
            };
            Dict { h }
        }
    }

    const fn transfer_keep(self, m: Memo) -> Dict<K, V> {
        if !buf_is_null(self.h) {
            m.keep(self.h);
        }
        self
    }

    const fn transfer_visit(self, m: Memo) -> Dict<K, V> {
        if !buf_is_null(self.h) && m.visit(self.h) {
            unsafe {
                let s = self.h[0];
                m.later_visit(s.keys, s.n);
                m.later_visit(s.vals, s.n);
            }
        }
        self
    }
}

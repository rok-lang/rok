// rok::core::collections::dict - `Dict<K, V, S>`, a hash map (stdlib
// spec 2.9.3) hashing with `S` (the process-keyed `RandomState` by
// default), compact: entries are appended to dense key / value / hash
// arrays, and a power-of-two index of linear-probed slots maps a hash to
// its entry. A table of at most `SMALL` entries has no index: lookup
// scans the hashes. `remove` leaves a hole; holes are squeezed out when
// the entries are full. One object holds the counts and the current
// arrays, swapped on growth. Iteration follows the entries, so it is in
// insertion order, as the spec guarantees: a present key re-inserted
// keeps its place, a removed one re-inserted goes last.

use rok::core::hash::{BuildHasher, RandomState};
use rok::core::marker::{Memo, Transfer, buf_is_null, copy_buf};

/// The dict's object. `keys` / `vals` have one more slot that stays
/// zero: a hole's key and value are overwritten with it, so a removed
/// entry keeps nothing alive. `meta` holds `cap` entry hashes (0: a
/// hole), then `slots` index slots (0: empty, else entry + 1). An index
/// slot of a removed entry stays, pointing at the hole: a tombstone,
/// passed over because no lookup hash is 0. Index slots in use never
/// exceed `cap`, at most 2/3 of `slots`, so probing always ends.
pub struct DictHead<K, V, S> {
    len: usize;
    n: usize;
    cap: usize;
    slots: usize;
    keys: GcBuf<K>;
    vals: GcBuf<V>;
    meta: GcBuf<u64>;
    state: S;
    /// The hashes were made at compile time, with the reserved key: the
    /// first operation at run time rehashes.
    stale: bool;
}

/// Entries a table holds without an index.
const SMALL: usize = 16;

/// `find`'s answer for an absent key.
const ABSENT: usize = usize::MAX;

/// Compile-time evaluation: the process key reads as all zero there.
const fn compile_time() -> bool {
    RandomState::new().is_reserved()
}

/// `k`'s hash with a hasher of `state`'s; never 0, which marks a hole.
#[inline]
const fn hash_with<K: Hash, S: BuildHasher>(state: S, k: K) -> u64 {
    let h = state.build_hasher();
    k.hash(ref h);
    let x = h.finish();
    if x == 0u64 { 1u64 } else { x }
}

/// Index slots for `cap` entries: none up to `SMALL`, else a power of
/// two of at least 3/2 `cap`.
#[track_caller]
const fn index_slots(cap: usize) -> usize {
    if cap <= SMALL {
        return 0;
    }
    let want = cap_add(cap, cap / 2);
    let s = 32usize;
    while s < want {
        s = cap_mul(s, 2);
    }
    s
}

/// An empty table of `cap` entries.
#[track_caller]
const fn new_table<K, V, S>(cap: usize, state: S, stale: bool) -> DictHead<K, V, S> {
    unsafe {
        let n = cap_add(cap, 1);
        let slots = index_slots(cap);
        DictHead {
            len: 0,
            n: 0,
            cap,
            slots,
            keys: buf_new(buf_len(n, size_of::<K>())),
            vals: buf_new(buf_len(n, size_of::<V>())),
            meta: buf_new(buf_len(cap_add(cap, slots), 8)),
            state,
            stale,
        }
    }
}

/// `S` builds the hashers (`RandomState`: the process key).
pub struct Dict<K, V, S = RandomState> {
    h: GcBuf<DictHead<K, V, S>>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<K, V, S> !Sync for Dict<K, V, S> {}

/// `pairs.collect::<Dict<K, V>>()`; a later pair's value wins.
impl<K: Hash, V, S: BuildHasher + Default> FromIterator<(K, V)> for Dict<K, V, S> {
    const fn from_iter<I: IntoIterator<Item = (K, V)>>(it: I) -> Dict<K, V, S> {
        let out: Dict<K, V, S> = Dict::with_hasher(S::default());
        for (k, v) in it {
            out.insert(k, v);
        }
        out
    }
}

impl<K: Hash, V> Dict<K, V> {
    pub const fn new() -> Dict<K, V> {
        Dict::with_capacity(4)
    }

    /// Room for `cap` entries before the first growth.
    #[track_caller]
    pub const fn with_capacity(cap: usize) -> Dict<K, V> {
        let state = RandomState::new();
        Dict::make(cap, state, state.is_reserved())
    }
}

impl<K: Hash, V, S: BuildHasher> Dict<K, V, S> {
    /// An empty dict hashing with `state`'s hashers.
    pub const fn with_hasher(state: S) -> Dict<K, V, S> {
        Dict::with_capacity_and_hasher(4, state)
    }

    /// Room for `cap` entries, hashing with `state`'s hashers.
    #[track_caller]
    pub const fn with_capacity_and_hasher(cap: usize, state: S) -> Dict<K, V, S> {
        Dict::make(cap, state, compile_time())
    }

    #[track_caller]
    const fn make(cap: usize, state: S, stale: bool) -> Dict<K, V, S> {
        unsafe {
            let h: GcBuf<DictHead<K, V, S>> = buf_new(1);
            h[0] = new_table(cap, state, stale);
            Dict { h }
        }
    }

    /// What builds the dict's hashers.
    pub const fn hasher(self) -> S {
        unsafe {
            self.h[0].state
        }
    }

    pub const fn len(self) -> usize {
        unsafe {
            self.h[0].len
        }
    }

    pub const fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// `k`'s hash.
    #[inline]
    const fn hash_of(self, k: K) -> u64 {
        unsafe {
            if self.h[0].stale {
                self.rehash();
            }
            hash_with(self.h[0].state, k)
        }
    }

    /// Hash every entry again, with the run time's key: a table built
    /// at compile time, on its first use. O(n), once.
    const fn rehash(self) {
        if compile_time() {
            return;
        }
        unsafe {
            let old = self.h[0];
            self.h[0] = new_table(old.cap, old.state, false);
            for i in 0..old.n {
                if old.meta[i] != 0u64 {
                    self.append(old.keys[i], old.vals[i], hash_with(old.state, old.keys[i]));
                }
            }
        }
    }

    /// The entry holding `k` (hash `h`), or `ABSENT`.
    const fn find(self, k: K, h: u64) -> usize {
        unsafe {
            let s = self.h[0];
            if s.slots == 0 {
                for i in 0..s.n {
                    if s.meta[i] == h && s.keys[i] == k {
                        return i;
                    }
                }
                return ABSENT;
            }
            let mask = s.slots - 1;
            let i = (h as usize) & mask;
            loop {
                let e = s.meta[s.cap + i];
                if e == 0u64 {
                    return ABSENT;
                }
                let at = (e - 1u64) as usize;
                if s.meta[at] == h && s.keys[at] == k {
                    return at;
                }
                i = (i + 1) & mask;
            }
        }
    }

    /// Append `k` (absent, hash `h`) and `v`; the entries have
    /// room.
    const fn append(self, k: K, v: V, h: u64) {
        unsafe {
            let s = self.h[0];
            let at = s.n;
            s.keys[at] = k;
            s.vals[at] = v;
            s.meta[at] = h;
            if s.slots != 0 {
                let mask = s.slots - 1;
                let i = (h as usize) & mask;
                while s.meta[s.cap + i] != 0u64 {
                    i = (i + 1) & mask;
                }
                s.meta[s.cap + i] = (at + 1) as u64;
            }
            self.h[0].n = at + 1;
            self.h[0].len += 1;
        }
    }

    /// Make room for one more entry: squeeze out the holes when they
    /// are more than half the entries, else grow by half.
    #[track_caller]
    const fn grow(self) {
        unsafe {
            let old = self.h[0];
            let cap = old.cap;
            if old.len * 2 >= cap {
                cap = cap_add(cap, cap / 2).max(4);
            }
            self.h[0] = new_table(cap, old.state, old.stale);
            for i in 0..old.n {
                let h = old.meta[i];
                if h != 0u64 {
                    self.append(old.keys[i], old.vals[i], h);
                }
            }
        }
    }

    /// Insert or replace; the old value, or `none`.
    #[discardable]
    pub const fn insert(self, k: K, v: V) -> V | none {
        unsafe {
            let h = self.hash_of(k);
            let at = self.find(k, h);
            if at != ABSENT {
                let s = self.h[0];
                let old = s.vals[at];
                s.vals[at] = v;
                return old;
            }
            if self.h[0].n == self.h[0].cap {
                self.grow();
            }
            self.append(k, v, h);
            none
        }
    }

    pub const fn get(self, k: K) -> V | none {
        unsafe {
            let at = self.find(k, self.hash_of(k));
            if at == ABSENT {
                return none;
            }
            let s = self.h[0];
            s.vals[at]
        }
    }

    pub const fn contains_key(self, k: K) -> bool {
        self.find(k, self.hash_of(k)) != ABSENT
    }

    #[discardable]
    pub const fn remove(self, k: K) -> V | none {
        unsafe {
            let at = self.find(k, self.hash_of(k));
            if at == ABSENT {
                return none;
            }
            let v = self.h[0].vals[at];
            self.hole(at);
            v
        }
    }

    /// Turn live entry `at` into a hole.
    const unsafe fn hole(self, at: usize) {
        let s = self.h[0];
        s.keys[at] = s.keys[s.cap];
        s.vals[at] = s.vals[s.cap];
        s.meta[at] = 0u64;
        self.h[0].len -= 1;
    }

    /// Keep only the entries `keep` accepts, in place; O(n).
    pub const fn retain(self, keep: fn(K, V) -> bool) {
        unsafe {
            let i: usize = 0;
            while i < self.h[0].n {
                let s = self.h[0];
                // Re-read after `keep`: it may have changed the dict
                // (unspecified, as for the iterators), not memory or `len`.
                if s.meta[i] != 0u64 && !keep(s.keys[i], s.vals[i]) && i < self.h[0].n && self.h[0].meta[i] != 0u64 {
                    self.hole(i);
                }
                i += 1;
            }
        }
    }

    /// Insert every `(key, value)` pair of `pairs`, in order; a later
    /// pair's value wins.
    pub const fn extend<I: IntoIterator<Item = (K, V)>>(self, pairs: I) {
        for (k, v) in pairs {
            self.insert(k, v);
        }
    }

    /// Drop every entry (a fresh small table).
    pub const fn clear(self) {
        unsafe {
            self.h[0] = new_table(4, self.h[0].state, self.h[0].stale);
        }
    }

    /// The first live entry at or after `from`, or `n`.
    const fn next_full(self, from: usize) -> usize {
        unsafe {
            let s = self.h[0];
            let i = from;
            while i < s.n && s.meta[i] == 0u64 {
                i += 1;
            }
            i
        }
    }

    /// The keys, lazily (2.9.3; insertion order).
    pub const fn keys(self) -> Keys<K, V, S> {
        Keys { d: self, at: 0 }
    }

    /// The values, lazily.
    pub const fn values(self) -> Values<K, V, S> {
        Values { d: self, at: 0 }
    }

    /// `(key, value)` pairs, lazily (insertion order).
    pub const fn iter(self) -> DictIter<K, V, S> {
        DictIter { d: self, at: 0 }
    }

    /// `k`'s place in the dict, present or not (2.9.3).
    pub const fn entry(self, k: K) -> Entry<K, V, S> {
        Entry { d: self, key: k }
    }
}

/// `d.entry(k)`: read or fill one key's slot. Each call looks the key
/// up again.
pub struct Entry<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    key: K;
}

impl<K, V, S> Debug for Entry<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Entry") }
}

impl<K: Hash, V, S: BuildHasher> Entry<K, V, S> {
    pub fn key(self) -> K {
        self.key
    }

    /// The value, after inserting `v` if the key is absent.
    pub const fn or_insert(self, v: V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, v);
        }
        self.d[self.key]
    }

    /// The value, after inserting `f()` if the key is absent.
    pub const fn or_insert_with(self, f: fn() -> V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, f());
        }
        self.d[self.key]
    }

    /// A present value replaced by `f(value)`; an absent key is left alone.
    pub const fn and_modify(self, f: fn(V) -> V) -> Entry<K, V, S> {
        if self.d.contains_key(self.key) {
            self.d.insert(self.key, f(self.d[self.key]));
        }
        self
    }
}

impl<K: Hash, V: Default, S: BuildHasher> Entry<K, V, S> {
    /// The value, after inserting `V::default()` if the key is absent.
    pub const fn or_default(self) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, V::default());
        }
        self.d[self.key]
    }
}

// The iterators walk the live table; a dict changed while iterated
// gives unspecified (but memory-safe) results.

pub struct Keys<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    at: usize;
}

impl<K, V, S> Debug for Keys<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Keys") }
}

impl<K: Hash, V, S: BuildHasher> Iterator for Keys<K, V, S> {
    type Item = K;
    const fn next(ref self) -> K | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            s.keys[i]
        }
    }
}

pub struct Values<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    at: usize;
}

impl<K, V, S> Debug for Values<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Values") }
}

impl<K: Hash, V, S: BuildHasher> Iterator for Values<K, V, S> {
    type Item = V;
    const fn next(ref self) -> V | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            s.vals[i]
        }
    }
}

pub struct DictIter<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    at: usize;
}

impl<K, V, S> Debug for DictIter<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("DictIter") }
}

impl<K: Hash, V, S: BuildHasher> Iterator for DictIter<K, V, S> {
    type Item = (K, V);
    const fn next(ref self) -> (K, V) | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            (s.keys[i], s.vals[i])
        }
    }
}

impl<K: Hash, V, S: BuildHasher + Default> Default for Dict<K, V, S> {
    fn default() -> Dict<K, V, S> { Dict::with_hasher(S::default()) }
}

/// A new dict with every key and value cloned (stdlib 2.13.2).
impl<K: Hash + Clone, V: Clone, S: BuildHasher> Clone for Dict<K, V, S> {
    const fn clone(self) -> Dict<K, V, S> {
        let r: Dict<K, V, S> = Dict::with_hasher(self.hasher());
        for (k, v) in self {
            r.insert(k.clone(), v.clone());
        }
        r
    }
}

/// The pairs of a list; a later pair's value wins.
impl<K: Hash, V, S: BuildHasher + Default> From<List<(K, V)>> for Dict<K, V, S> {
    const fn from(pairs: List<(K, V)>) -> Dict<K, V, S> {
        let d: Dict<K, V, S> = Dict::with_capacity_and_hasher(pairs.len(), S::default());
        for (k, v) in pairs {
            d.insert(k, v);
        }
        d
    }
}

/// `d += e`: merge `e` in place; its values win (stdlib 2.4.6).
impl<K: Hash, V, S: BuildHasher> AddAssign<Dict<K, V, S>> for Dict<K, V, S> {
    const fn add_assign(ref self, rhs: Dict<K, V, S>) {
        for (k, v) in rhs {
            self.insert(k, v);
        }
    }
}

/// `for (k, v) in d` (2.9.9).
impl<K: Hash, V, S: BuildHasher> IntoIterator for Dict<K, V, S> {
    type IntoIter = DictIter<K, V, S>;
    type Item = (K, V);
    const fn into_iter(self) -> DictIter<K, V, S> {
        self.iter()
    }
}

/// `d[k]`; panics when the key is absent.
impl<K: Hash, V, S: BuildHasher> Index<K> for Dict<K, V, S> {
    type Output = V;
    #[track_caller]
    const fn index(self, k: K) -> V {
        unsafe {
            let at = self.find(k, self.hash_of(k));
            if at == ABSENT {
                return key_missing::<K, V>(k);
            }
            let s = self.h[0];
            s.vals[at]
        }
    }
}

/// Panics: `key {k:?} not found`, `<K>` for a key without `Debug`. Out
/// of line, as `index_oob`.
#[track_caller]
const fn key_missing<K, V>(k: K) -> ! {
    panic(f"key {rok::core::fmt::shown::<K>(k)} not found; use `d.get(k)` to get `{V::type_name()} | none`")
}

/// `d[k] = v` inserts or replaces.
impl<K: Hash, V, S: BuildHasher> IndexSet<K> for Dict<K, V, S> {
    type Value = V;
    const fn index_set(self, k: K, v: V) {
        self.insert(k, v);
    }
}

/// Same keys, equal values (insertion order does not matter).
impl<K: Hash, V: PartialEq, S: BuildHasher> PartialEq for Dict<K, V, S> {
    const fn eq(self, rhs: Dict<K, V, S>) -> bool {
        if self.len() != rhs.len() { return false; }
        for (k, v) in self {
            if !rhs.contains_key(k) { return false; }
            if rhs[k] != v { return false; }
        }
        true
    }
    fn ne(self, rhs: Dict<K, V, S>) -> bool { !self.eq(rhs) }
}

impl<K: Hash, V: Eq, S: BuildHasher> Eq for Dict<K, V, S> {}

/// Order-independent, as `==`: each entry hashed alone with the
/// process key (the same for every `S`), the results summed; then the
/// length and the sum.
impl<K: Hash, V: Hash, S: BuildHasher> Hash for Dict<K, V, S> {
    const fn hash<H: Hasher>(self, ref h: H) {
        let st = RandomState::new();
        let sum = 0u64;
        for (k, v) in self {
            let e = st.build_hasher();
            k.hash(ref e);
            v.hash(ref e);
            sum = sum.wrapping_add(e.finish());
        }
        h.write_length_prefix(self.len());
        h.write_u64(sum);
    }
}

/// `{k: v, ..}` with each key's and value's `Debug`, in iteration order.
impl<K: Hash + Debug, V: Debug, S: BuildHasher> Debug for Dict<K, V, S> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for (k, v) in self {
            try f.debug_pair(k, v, first);
            first = false;
        }
        try f.debug_close("}", first, false)
    }
}

/// `{k: v, ..}` (refs-lang 6.5.1, 6.5.6).
#[literal("{" {expr ":" expr} % "," * "}")]
pub const fn dict_literal<K: Hash, V>(pairs: ...(K, V)) -> Dict<K, V> {
    let d: Dict<K, V> = Dict::new();
    for (k, v) in pairs {
        d.insert(k, v);
    }
    return d;
}

/// A hand-off's copy (stdlib 2.13.9): the same table; keys and values go
/// through `transfer` from the memo's queue (holes stay zero).
impl<K, V, S> Transfer for Dict<K, V, S> {
    const fn transfer_copy(self, m: Memo) -> Dict<K, V, S> {
        if buf_is_null(self.h) {
            return self;
        }
        if let got: GcBuf<DictHead<K, V, S>> = m.find(self.h) {
            return Dict { h: got };
        }
        unsafe {
            let s = self.h[0];
            let h: GcBuf<DictHead<K, V, S>> = buf_new(1);
            m.note(self.h, h);
            let n = cap_add(s.cap, 1);
            let index = cap_add(s.cap, s.slots);
            h[0] = DictHead {
                len: s.len,
                n: s.n,
                cap: s.cap,
                slots: s.slots,
                keys: copy_buf(s.keys, 0, s.n, 1, n, m),
                vals: copy_buf(s.vals, 0, s.n, 1, n, m),
                meta: copy_buf(s.meta, 0, index, 1, index, m),
                state: s.state,
                stale: s.stale,
            };
            Dict { h }
        }
    }

    const fn transfer_keep(self, m: Memo) -> Dict<K, V, S> {
        if !buf_is_null(self.h) {
            m.keep(self.h);
        }
        self
    }

    const fn transfer_visit(self, m: Memo) -> Dict<K, V, S> {
        if !buf_is_null(self.h) && m.visit(self.h) {
            unsafe {
                let s = self.h[0];
                m.later_visit(s.keys, s.n);
                m.later_visit(s.vals, s.n);
            }
        }
        self
    }
}

// rok::core::collections::raw - the GC buffer the collections are built
// on. `GcBuf<T>` is compiler-known: one GC reference to an object
// holding a run of `T`s, zeroed at allocation; when `T` holds GC
// references the collector traces every element. It carries no length -
// its owner tracks that. The functions below are compiler intrinsics
// (unchecked indexing); their bodies never run. Reading, writing and
// allocating are `unsafe`, and so is `b[i]` on a `GcBuf`: nothing checks
// the index, and a fresh buffer's zero bytes need not be a valid `T`.

// Defined in bare, which names no core item.
pub use rok::bare::mem::{GcBuf, buf_get, buf_new, buf_same, buf_set};

/// `buf` typed as `GcBuf<u8>`: a runtime parameter that takes any GC
/// object.
#[intrinsic("rok.buf_erase")]
pub(pkg) fn buf_erase<T>(buf: GcBuf<T>) -> GcBuf<u8> {
    buf_erase(buf)
}

/// `buf` as a buffer of the slot's element type (no check: the caller
/// knows what the object holds).
#[intrinsic("rok.buf_cast")]
pub(pkg) unsafe fn buf_cast<T, U>(buf: GcBuf<T>) -> GcBuf<U> {
    buf_cast(buf)
}

#[intrinsic("rok.size_of")]
pub(pkg) fn size_of<T>() -> usize;

/// `len` as the length of a buffer of `size`-byte elements: panics with
/// "capacity overflow" when the bytes would not fit one allocation, at
/// every opt level. Not generic, so it is one function, not one per `T`.
/// The compile-time evaluator answers a call with `len` without
/// evaluating `size` (its buffers hold elements, not bytes), so no type
/// layout is needed there.
#[track_caller]
pub(pkg) const fn buf_len(len: usize, size: usize) -> usize {
    // Head room for the object header.
    if size != 0 && len > (isize::MAX as usize - 4096) / size {
        panic("capacity overflow");
    }
    len
}

/// `a + b` for a capacity: panics instead of wrapping.
#[track_caller]
pub(pkg) const fn cap_add(a: usize, b: usize) -> usize {
    let n = a.checked_add(b);
    if n is usize {
        return n;
    }
    panic("capacity overflow")
}

/// `a * b` for a capacity: panics instead of wrapping.
#[track_caller]
pub(pkg) const fn cap_mul(a: usize, b: usize) -> usize {
    let n = a.checked_mul(b);
    if n is usize {
        return n;
    }
    panic("capacity overflow")
}

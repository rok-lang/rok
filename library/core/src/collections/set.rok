// rok::core::collections::set - `Set<T>`, a hash set (stdlib spec
// 2.9.4) over `Dict<T, bool>`, so it iterates in insertion order.

pub struct Set<T> {
    d: Dict<T, bool>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<T> !Sync for Set<T> {}

impl<T: Hash> Set<T> {
    /// An empty set.
    pub const fn new() -> Set<T> {
        Set { d: Dict::new() }
    }

    /// The number of members.
    pub const fn len(self) -> usize {
        self.d.len()
    }

    /// `true` when the set has no member.
    pub const fn is_empty(self) -> bool {
        self.d.is_empty()
    }

    /// `true` when `x` was not there yet.
    #[discardable]
    pub const fn insert(self, x: T) -> bool {
        self.d.insert(x, true) is none
    }

    /// `true` when `x` was there.
    #[discardable]
    pub const fn remove(self, x: T) -> bool {
        !(self.d.remove(x) is none)
    }

    /// `true` when `x` is a member.
    pub const fn contains(self, x: T) -> bool {
        self.d.contains_key(x)
    }

    /// Drop every member.
    pub const fn clear(self) {
        self.d.clear();
    }

    /// Keep only the members `keep` accepts, in place; O(n).
    pub const fn retain(self, keep: fn(T) -> bool) {
        self.d.retain(|x: T, _: bool| keep(x));
    }

    /// Insert every item of `items`.
    pub const fn extend<I: IntoIterator<Item = T>>(self, items: I) {
        for x in items {
            self.insert(x);
        }
    }

    /// The members of either set.
    pub const fn union(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in self.d.keys() {
            out.insert(x);
        }
        for x in other.d.keys() {
            out.insert(x);
        }
        out
    }

    /// The members of both sets.
    pub const fn intersection(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in self.d.keys() {
            if other.contains(x) {
                out.insert(x);
            }
        }
        out
    }

    /// The members of `self` not in `other`.
    pub const fn difference(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in self.d.keys() {
            if !other.contains(x) {
                out.insert(x);
            }
        }
        out
    }

    /// The members of exactly one set.
    pub const fn symmetric_difference(self, other: Set<T>) -> Set<T> {
        self.difference(other).union(other.difference(self))
    }

    /// `true` when every member of `self` is in `other`.
    pub const fn is_subset(self, other: Set<T>) -> bool {
        for x in self.d.keys() {
            if !other.contains(x) {
                return false;
            }
        }
        true
    }

    /// `true` when every member of `other` is in `self`.
    pub const fn is_superset(self, other: Set<T>) -> bool {
        other.is_subset(self)
    }

    /// `true` when no member is in both sets.
    pub const fn is_disjoint(self, other: Set<T>) -> bool {
        self.intersection(other).is_empty()
    }

    /// The members in a new list, in iteration order.
    pub const fn to_list(self) -> List<T> {
        self.d.keys().collect()
    }

    /// The members, lazily (insertion order).
    pub const fn iter(self) -> SetIter<T> {
        SetIter { it: self.d.keys() }
    }
}

/// The members of a set, in insertion order.
pub struct SetIter<T> {
    it: Keys<T, bool>;
}

impl<T: Hash> Iterator for SetIter<T> {
    type Item = T;
    const fn next(ref self) -> T | none {
        self.it.next()
    }
}

impl<T: Hash> Default for Set<T> {
    fn default() -> Set<T> { Set::new() }
}

/// A new set with every element cloned (stdlib 2.13.2).
impl<T: Hash + Clone> Clone for Set<T> {
    const fn clone(self) -> Set<T> {
        let r: Set<T> = Set::new();
        for x in self {
            r.insert(x.clone());
        }
        r
    }
}

/// `for x in s` (2.9.9).
impl<T: Hash> IntoIterator for Set<T> {
    type IntoIter = SetIter<T>;
    type Item = T;
    const fn into_iter(self) -> SetIter<T> {
        self.iter()
    }
}

/// `it.collect()` into a set (2.9.9).
impl<T: Hash> FromIterator<T> for Set<T> {
    const fn from_iter<I: IntoIterator<Item = T>>(it: I) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in it {
            out.insert(x);
        }
        out
    }
}

/// The items of a list (duplicates dropped).
impl<T: Hash> From<List<T>> for Set<T> {
    const fn from(items: List<T>) -> Set<T> {
        let s: Set<T> = Set { d: Dict::with_capacity(items.len()) };
        for x in items {
            s.insert(x);
        }
        s
    }
}

/// `s += x`: insert `x` (stdlib 2.4.6).
impl<T: Hash> AddAssign<T> for Set<T> {
    const fn add_assign(ref self, rhs: T) {
        self.insert(rhs);
    }
}

/// Same members.
impl<T: Hash> PartialEq for Set<T> {
    const fn eq(self, rhs: Set<T>) -> bool {
        if self.len() != rhs.len() { return false; }
        for x in self {
            if !rhs.contains(x) { return false; }
        }
        true
    }
    fn ne(self, rhs: Set<T>) -> bool { !self.eq(rhs) }
}

impl<T: Hash> Eq for Set<T> {}

/// Order-independent: member hashes combine by xor.
impl<T: Hash> Hash for Set<T> {
    const fn hash(self) -> u64 {
        let h = self.len() as u64;
        for x in self { h ^= x.hash(); }
        h
    }
}

/// `{a, b, ..}` with each member's `Debug`, in iteration order.
impl<T: Hash + Debug> Debug for Set<T> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for x in self {
            try f.debug_entry("", x, first, false);
            first = false;
        }
        try f.debug_close("}", first, false)
    }
}

/// `{a, b}` / `{a,}` (refs-lang 6.5.1, 6.5.6; `{ a }` is a block).
#[literal("{" {expr} % "," + "}")]
pub const fn set_literal<T: Hash>(items: ...T) -> Set<T> {
    let s: Set<T> = Set::new();
    for x in items {
        s.insert(x);
    }
    return s;
}

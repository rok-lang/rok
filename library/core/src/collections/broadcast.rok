// `[T; N]`: element-wise into an array of the same length (2.6.7).
// No `T op [T; N]` impls: a blanket `for T` impl whose argument holds
// a const parameter the receiver leaves open cannot be matched (the
// operator form is fused by the compiler instead).

/// `out` with `out[i] = f(a[i], b[i])`; `out` only supplies the
/// storage, so an empty array calls nothing.
const fn array_zip<A, B, C, const N: usize>(out: [C; N], a: [A; N], b: [B; N], f: fn(A, B) -> C) -> [C; N] {
    for i in 0..N {
        out[i] = f(a[i], b[i]);
    }
    out
}

/// `out` with `out[i] = f(a[i], b)`.
const fn array_right<A, B, C, const N: usize>(out: [C; N], a: [A; N], b: B, f: fn(A, B) -> C) -> [C; N] {
    for i in 0..N {
        out[i] = f(a[i], b);
    }
    out
}

impl<T: Add<Output = T>, const N: usize> DotAdd<[T; N]> for [T; N] {
    type Output = [T; N];
    const fn dot_add(self, rhs: [T; N]) -> [T; N] { array_zip(self, self, rhs, |a: T, b: T| -> T { a + b }) }
}


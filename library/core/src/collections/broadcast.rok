/// No short-circuit: both lists are evaluated (2.6.2).
impl DotLogicalAnd for List<bool> {
    type Output = List<bool>;
    #[track_caller]
    const fn dot_logical_and(self, rhs: List<bool>) -> List<bool> {
        zip_with("List::dot_logical_and", self, rhs, |a: bool, b: bool| -> bool { a && b })
    }
}

/// No short-circuit: both lists are evaluated (2.6.2).
impl DotLogicalOr for List<bool> {
    type Output = List<bool>;
    #[track_caller]
    const fn dot_logical_or(self, rhs: List<bool>) -> List<bool> {
        zip_with("List::dot_logical_or", self, rhs, |a: bool, b: bool| -> bool { a || b })
    }
}


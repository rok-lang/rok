// In place (stdlib 2.4.10): `xs.dot_add_assign(ys)` sets `xs[i] = xs[i] + ys[i]`
// (no `.+=` token); the lengths must agree.
impl<T> List<T> {
    /// `self[i] = self[i] + rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub const fn dot_add_assign(self, rhs: List<T>) where T: Add<Output = T> {
        let n = self.len();
        check_len_in("List::dot_add_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] + rhs[i];
        }
    }
    /// `self[i] = self[i] - rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub fn dot_sub_assign(self, rhs: List<T>) where T: Sub<Output = T> {
        let n = self.len();
        check_len_in("List::dot_sub_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] - rhs[i];
        }
    }
    /// `self[i] = self[i] * rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub const fn dot_mul_assign(self, rhs: List<T>) where T: Mul<Output = T> {
        let n = self.len();
        check_len_in("List::dot_mul_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] * rhs[i];
        }
    }
    /// `self[i] = self[i] / rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub fn dot_div_assign(self, rhs: List<T>) where T: Div<Output = T> {
        let n = self.len();
        check_len_in("List::dot_div_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] / rhs[i];
        }
    }
    /// `self[i] = self[i] % rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub fn dot_rem_assign(self, rhs: List<T>) where T: Rem<Output = T> {
        let n = self.len();
        check_len_in("List::dot_rem_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] % rhs[i];
        }
    }
    /// `self[i] = self[i] %% rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub const fn dot_modulo_assign(self, rhs: List<T>) where T: Modulo<Output = T> {
        let n = self.len();
        check_len_in("List::dot_modulo_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] %% rhs[i];
        }
    }
    /// `self[i] = self[i] & rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub fn dot_bitand_assign(self, rhs: List<T>) where T: BitAnd<Output = T> {
        let n = self.len();
        check_len_in("List::dot_bitand_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] & rhs[i];
        }
    }
    /// `self[i] = self[i] | rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub fn dot_bitor_assign(self, rhs: List<T>) where T: BitOr<Output = T> {
        let n = self.len();
        check_len_in("List::dot_bitor_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] | rhs[i];
        }
    }
    /// `self[i] = self[i] ^ rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub fn dot_bitxor_assign(self, rhs: List<T>) where T: BitXor<Output = T> {
        let n = self.len();
        check_len_in("List::dot_bitxor_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] ^ rhs[i];
        }
    }
    /// `self[i] = self[i] << rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub const fn dot_shl_assign(self, rhs: List<T>) where T: Shl<Output = T> {
        let n = self.len();
        check_len_in("List::dot_shl_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] << rhs[i];
        }
    }
    /// `self[i] = self[i] >> rhs[i]` for each `i`. Panics if the lengths
    /// differ.
    #[track_caller]
    pub const fn dot_shr_assign(self, rhs: List<T>) where T: Shr<Output = T> {
        let n = self.len();
        check_len_in("List::dot_shr_assign", rhs.len(), n);
        for i in 0..n {
            self[i] = self[i] >> rhs[i];
        }
    }
}

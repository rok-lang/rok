// rok::core::collections::broadcast - the element-wise dot operators
// on `List<T>` (stdlib spec 2.6.7): `List op List` (same length, else a
// panic), `List op T` and `T op List` (the scalar applies to every
// element). Arithmetic / bitwise ones give `List<T>`, comparisons
// `List<bool>`; `.&&` / `.||` combine `List<bool>`s without
// short-circuit. An operator on core collections in source is fused
// into one loop by the compiler (2.6.6); these impls serve trait
// bounds, method calls and `fn` values.

/// Lengths of two broadcast operands agree (each collection is checked
/// against the first). A fused expression may hold several operators,
/// so it names none.
#[track_caller]
#[lang("broadcast_len_fn")]
pub(pkg) const fn check_len(len: usize, want: usize) { check_len_in("broadcast", len, want); }

/// `check_len`, the panic naming `what`.
#[track_caller]
const fn check_len_in(what: str, len: usize, want: usize) {
    if len != want {
        panic(f"{what}: lengths {want} and {len} differ; make both sides the same length");
    }
}

/// `[f(a[i], b[i])]`; panics, naming `what`, when the lengths differ.
#[track_caller]
const fn zip_with<A, B, C>(what: str, a: List<A>, b: List<B>, f: fn(A, B) -> C) -> List<C> {
    let n = a.len();
    check_len_in(what, b.len(), n);
    let out: List<C> = List::with_capacity(n);
    for i in 0..n {
        out.push(f(a[i], b[i]));
    }
    out
}

/// `[f(a[i], b)]`.
const fn map_right<A, B, C>(a: List<A>, b: B, f: fn(A, B) -> C) -> List<C> {
    let out: List<C> = List::with_capacity(a.len());
    for x in a {
        out.push(f(x, b));
    }
    out
}

/// `[f(a, b[i])]`.
const fn map_left<A, B, C>(a: A, b: List<B>, f: fn(A, B) -> C) -> List<C> {
    let out: List<C> = List::with_capacity(b.len());
    for x in b {
        out.push(f(a, x));
    }
    out
}

impl<T: Add<Output = T>> DotAdd<List<T>> for List<T> {
    type Output = List<T>;
    #[track_caller]
    fn dot_add(self, rhs: List<T>) -> List<T> { zip_with("List::dot_add", self, rhs, |a: T, b: T| -> T { a + b }) }
}

impl<T: Add<Output = T>> DotAdd<T> for List<T> {
    type Output = List<T>;
    const fn dot_add(self, rhs: T) -> List<T> { map_right(self, rhs, |a: T, b: T| -> T { a + b }) }
}

impl<T: Add<Output = T>> DotAdd<List<T>> for T {
    type Output = List<T>;
    const fn dot_add(self, rhs: List<T>) -> List<T> { map_left(self, rhs, |a: T, b: T| -> T { a + b }) }
}


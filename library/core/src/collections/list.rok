// rok::core::collections::list - `List<T>`, a growable array (stdlib
// spec 2.9.2): one object holding the length, the capacity and the
// current element buffer, swapped for a bigger one on growth. The buffer has one
// slot past the capacity that is never written: a zero `T` that vacated
// slots are overwritten with, so the list keeps no removed value alive.

use rok::core::marker::{Memo, Transfer, buf_is_null, copy_shared};

pub struct List<T> {
    h: GcBuf<ListHead<T>>;
}

struct ListHead<T> {
    len: usize;
    cap: usize;
    buf: GcBuf<T>;
}

impl List<str> {
    /// The items with `sep` between each two: `["a", "b"].join(", ")`.
    pub const fn join(self, sep: str) -> str {
        let b = StrBuf::new();
        for (i, s) in self.iter().enumerate() {
            if i > 0 {
                b.push_str(sep);
            }
            b.push_str(s);
        }
        b.to_str()
    }
}

// Copies of a collection handle share one mutable buffer with no lock,
// so a collection cannot be shared between threads (stdlib 2.13.9):
// share it through `Mutex` / `RwLock` / a channel.
impl<T> !Sync for List<T> {}

impl<T> List<T> {
    pub const fn new() -> List<T> {
        List::with_capacity(4)
    }

    #[track_caller]
    pub const fn with_capacity(cap: usize) -> List<T> {
        unsafe {
            let h: GcBuf<ListHead<T>> = buf_new(1);
            h[0] = ListHead { len: 0, cap, buf: buf_new(buf_len(cap_add(cap, 1), size_of::<T>())) };
            List { h }
        }
    }

    pub const fn len(self) -> usize {
        unsafe {
            self.h[0].len
        }
    }

    pub const fn is_empty(self) -> bool {
        self.len() == 0
    }

    pub const fn capacity(self) -> usize {
        unsafe {
            self.h[0].cap
        }
    }

    /// The current element buffer (`Slice` views it).
    pub(pkg) const fn buffer(self) -> GcBuf<T> {
        unsafe {
            self.h[0].buf
        }
    }

    /// Room for `additional` more elements (doubling).
    #[track_caller]
    pub const fn reserve(self, additional: usize) {
        unsafe {
            let n = self.len();
            let cap = self.capacity();
            let need = cap_add(n, additional);
            if need <= cap {
                return;
            }
            let new_cap = cap.saturating_mul(2).max(need);
            let old = self.h[0].buf;
            let store: GcBuf<T> = buf_new(buf_len(cap_add(new_cap, 1), size_of::<T>()));
            for i in 0..n {
                store[i] = old[i];
            }
            self.h[0].buf = store;
            self.h[0].cap = new_cap;
        }
    }

    /// Capacity cut down to the length.
    pub const fn shrink_to_fit(self) {
        unsafe {
            let n = self.len();
            if n == self.capacity() {
                return;
            }
            let old = self.h[0].buf;
            let store: GcBuf<T> = buf_new(buf_len(cap_add(n, 1), size_of::<T>()));
            for i in 0..n {
                store[i] = old[i];
            }
            self.h[0].buf = store;
            self.h[0].cap = n;
        }
    }

    /// The elements in reverse order, in place.
    pub const fn reverse(self) {
        unsafe {
            let store = self.h[0].buf;
            let n = self.len();
            for i in 0..n / 2 {
                let x = store[i];
                store[i] = store[n - 1 - i];
                store[n - 1 - i] = x;
            }
        }
    }

    /// Push every item of `items`, in order.
    pub const fn extend<I: IntoIterator<Item = T>>(self, items: I) {
        for x in items {
            self.push(x);
        }
    }

    pub const fn push(self, x: T) {
        unsafe {
            let n = self.len();
            if n == self.capacity() {
                return self.push_grown(x);
            }
            self.h[0].buf[n] = x;
            self.h[0].len = n + 1;
        }
    }

    /// `push` into a full list, out of line: a `push` that fits reaches
    /// no safepoint, so it keeps no frame.
    #[cold]
    const fn push_grown(self, x: T) {
        unsafe {
            // One read of the length: the slot written and the new length
            // agree, and `reserve` made room past it.
            let n = self.len();
            self.reserve(1);
            self.h[0].buf[n] = x;
            self.h[0].len = n + 1;
        }
    }

    pub const fn pop(self) -> T | none {
        unsafe {
            let n = self.len();
            if n == 0 {
                return none;
            }
            let store = self.h[0].buf;
            let x = store[n - 1];
            self.vacate(store, n - 1);
            self.h[0].len = n - 1;
            x
        }
    }

    /// Overwrite slot `i` of `store` (this list's buffer) with the zero
    /// slot past the capacity.
    const unsafe fn vacate(self, store: GcBuf<T>, i: usize) {
        store[i] = store[self.capacity()];
    }

    /// Element `idx`, or `none` out of bounds.
    pub const fn get(self, idx: usize) -> T | none {
        unsafe {
            if idx >= self.len() {
                return none;
            }
            self.h[0].buf[idx]
        }
    }

    /// Overwrite element `idx`; throws out of bounds (`xs[idx] = x`
    /// panics instead).
    pub const fn set(self, idx: usize, x: T) throws (IndexError) {
        unsafe {
            if idx >= self.len() {
                throw IndexError { index: idx as i64, len: self.len() };
            }
            self.h[0].buf[idx] = x;
        }
    }

    pub const fn first(self) -> T | none {
        self.get(0)
    }

    pub const fn last(self) -> T | none {
        let n = self.len();
        if n == 0 {
            return none;
        }
        self.get(n - 1)
    }

    #[track_caller]
    pub const fn insert(self, idx: usize, x: T) {
        unsafe {
            let n = self.len();
            if idx > n {
                panic("List::insert: index out of bounds");
            }
            self.reserve(1);
            let store = self.h[0].buf;
            let i = n;
            while i > idx {
                store[i] = store[i - 1];
                i -= 1;
            }
            store[idx] = x;
            self.h[0].len = n + 1;
        }
    }

    #[track_caller]
    pub const fn remove(self, idx: usize) -> T {
        unsafe {
            let n = self.len();
            if idx >= n {
                return panic("List::remove: index out of bounds");
            }
            let store = self.h[0].buf;
            let x = store[idx];
            for i in idx + 1..n {
                store[i - 1] = store[i];
            }
            self.vacate(store, n - 1);
            self.h[0].len = n - 1;
            x
        }
    }

    pub const fn clear(self) {
        unsafe {
            let store = self.h[0].buf;
            for i in 0..self.len() {
                self.vacate(store, i);
            }
            self.h[0].len = 0;
        }
    }

    /// Keep the first `len` elements (no change if there are fewer).
    pub const fn truncate(self, len: usize) {
        unsafe {
            let n = self.len();
            if len >= n {
                return;
            }
            let store = self.h[0].buf;
            for i in len..n {
                self.vacate(store, i);
            }
            self.h[0].len = len;
        }
    }

    /// Remove the elements in `r` and return them, in order; the rest
    /// close up. Panics if `r` is reversed or ends past the length.
    #[track_caller]
    pub const fn drain(self, r: Range<usize>) -> List<T> {
        unsafe {
            let n = self.len();
            if r.start > r.end || r.end > n {
                panic("List::drain: range out of bounds");
            }
            let k = r.end - r.start;
            let out: List<T> = List::with_capacity(k);
            let store = self.h[0].buf;
            for i in r.start..r.end {
                out.push(store[i]);
            }
            for i in r.end..n {
                store[i - k] = store[i];
            }
            for i in n - k..n {
                self.vacate(store, i);
            }
            self.h[0].len = n - k;
            out
        }
    }

    /// Set the length to `n` (at most the capacity) without writing
    /// elements, for a buffer filled in place: elements past the old
    /// length hold whatever the storage held (zero: vacated slots are
    /// zeroed). Shrinking this way leaves the cut elements in place.
    #[track_caller]
    pub const unsafe fn set_len(self, n: usize) {
        if n > self.capacity() {
            panic("List::set_len: past the capacity");
        }
        self.h[0].len = n;
    }

    pub const fn iter(self) -> ListIter<T> {
        ListIter { list: self, front: 0, back: 0 }
    }
}

/// Runs this short are insertion-sorted before merging.
const SORT_RUN: usize = 16;

impl<T: Ord> List<T> {
    /// Ascending, stable.
    pub const fn sort(self) {
        self.sort_by(|a: T, b: T| a.cmp(b));
    }
}

impl<T> List<T> {
    /// Stable bottom-up merge sort by `cmp`: O(n log n), n extra slots.
    pub const fn sort_by(self, cmp: fn(T, T) -> rok::core::cmp::Ordering) {
        unsafe {
            let n = self.len();
            if n < 2 {
                return;
            }
            let src = self.h[0].buf;
            let lo: usize = 0;
            while lo < n {
                let hi = (lo + SORT_RUN).min(n);
                for i in lo + 1..hi {
                    let x = src[i];
                    let j = i;
                    while j > lo && cmp(src[j - 1], x).is_gt() {
                        src[j] = src[j - 1];
                        j -= 1;
                    }
                    src[j] = x;
                }
                lo = hi;
            }
            if n <= SORT_RUN {
                return;
            }
            let a = src;
            let b: GcBuf<T> = buf_new(n);
            let width = SORT_RUN;
            while width < n {
                let start: usize = 0;
                while start < n {
                    let mid = (start + width).min(n);
                    let end = (start + 2 * width).min(n);
                    let i = start;
                    let j = mid;
                    let k = start;
                    while i < mid && j < end {
                        // Ties take the left run: stable.
                        if cmp(a[j], a[i]).is_lt() {
                            b[k] = a[j];
                            j += 1;
                        } else {
                            b[k] = a[i];
                            i += 1;
                        }
                        k += 1;
                    }
                    while i < mid {
                        b[k] = a[i];
                        i += 1;
                        k += 1;
                    }
                    while j < end {
                        b[k] = a[j];
                        j += 1;
                        k += 1;
                    }
                    start = end;
                }
                let t = a;
                a = b;
                b = t;
                width *= 2;
            }
            if !buf_same(a, src) {
                for i in 0..n {
                    src[i] = a[i];
                }
            }
        }
    }
}

/// `xs.iter()` / `for x in xs`: walks a list front to back. Its state
/// is its own (`next(ref self)`, 2.7.1): a copy walks on its own.
pub struct ListIter<T> {
    list: List<T>;
    /// The next index from the front.
    front: usize;
    /// Items taken from the back.
    back: usize;
}

impl<T> Iterator for ListIter<T> {
    type Item = T;
    const fn next(ref self) -> T | none {
        let i = self.front;
        if i + self.back >= self.list.len() {
            return none;
        }
        self.front = i + 1;
        self.list.get(i)
    }

    const fn exact_len(self) -> usize | none { self.len() }

    /// `ExactSizeIterator`: O(1) (2.7.10).
    const fn count(self) -> usize { self.len() }
}

impl<T> DoubleEndedIterator for ListIter<T> {
    const fn next_back(ref self) -> T | none {
        let back = self.back;
        if self.front + back >= self.list.len() {
            return none;
        }
        self.back = back + 1;
        self.list.get(self.list.len() - back - 1)
    }
}

impl<T> ExactSizeIterator for ListIter<T> {
    const fn len(self) -> usize {
        self.list.len().saturating_sub(self.front + self.back)
    }
}

/// What `xs.into_iter()` returns (2.9.2): the same walk as `iter`.
pub type ListIntoIter<T> = ListIter<T>;

impl<T> IntoIterator for List<T> {
    type IntoIter = ListIntoIter<T>;
    type Item = T;
    const fn into_iter(self) -> ListIntoIter<T> {
        self.iter()
    }
}

impl<T> Default for List<T> {
    const fn default() -> List<T> { List::new() }
}

/// A new list with every element cloned (stdlib 2.13.2).
impl<T: Clone> Clone for List<T> {
    const fn clone(self) -> List<T> {
        let r: List<T> = List::new();
        for x in self {
            r.push(x.clone());
        }
        r
    }
}

/// `xs[i]`; panics out of bounds.
impl<T> Index<usize> for List<T> {
    type Output = T;
    #[track_caller]
    const fn index(self, idx: usize) -> T {
        unsafe {
            if idx >= self.len() {
                return panic("List index out of bounds");
            }
            self.h[0].buf[idx]
        }
    }
}

/// `xs[i] = v`; panics out of bounds.
impl<T> IndexSet<usize> for List<T> {
    type Value = T;
    #[track_caller]
    const fn index_set(self, idx: usize, value: T) {
        unsafe {
            if idx >= self.len() {
                panic("List index out of bounds");
            }
            self.h[0].buf[idx] = value;
        }
    }
}

/// `it.collect()` into a list (2.9.9).
impl<T> FromIterator<T> for List<T> {
    const fn from_iter<I: IntoIterator<Item = T>>(it: I) -> List<T> {
        let out: List<T> = List::new();
        for x in it {
            out.push(x);
        }
        out
    }
}

/// Element-wise, in order.
impl<T: PartialEq> PartialEq for List<T> {
    const fn eq(self, rhs: List<T>) -> bool {
        let n = self.len();
        if n != rhs.len() { return false; }
        for i in 0..n {
            if self[i] != rhs[i] { return false; }
        }
        true
    }
    const fn ne(self, rhs: List<T>) -> bool { !self.eq(rhs) }
}

impl<T: Eq> Eq for List<T> {}

/// Lexicographic (stdlib 2.5.7): the first differing element decides,
/// else the shorter list comes first.
impl<T: PartialEq + PartialOrd> PartialOrd for List<T> {
    const fn lt(self, rhs: List<T>) -> bool {
        let n = self.len().min(rhs.len());
        for i in 0..n {
            if self[i] != rhs[i] { return self[i] < rhs[i]; }
        }
        self.len() < rhs.len()
    }
    const fn le(self, rhs: List<T>) -> bool {
        let n = self.len().min(rhs.len());
        for i in 0..n {
            if self[i] != rhs[i] { return self[i] < rhs[i]; }
        }
        self.len() <= rhs.len()
    }
    const fn gt(self, rhs: List<T>) -> bool { rhs.lt(self) }
    const fn ge(self, rhs: List<T>) -> bool { rhs.le(self) }
}

impl<T: Ord> Ord for List<T> {
    const fn cmp(self, rhs: List<T>) -> rok::core::cmp::Ordering {
        let n = self.len().min(rhs.len());
        for i in 0..n {
            let c = self[i].cmp(rhs[i]);
            if !c.is_eq() { return c; }
        }
        self.len().cmp(rhs.len())
    }
}

/// Order-dependent mix of the element hashes.
impl<T: Hash> Hash for List<T> {
    const fn hash(self) -> u64 {
        let h = 0xcbf29ce484222325u64 ^ (self.len() as u64);
        for x in self {
            h = ((h << 5u64) | (h >> 59u64)) ^ x.hash();
        }
        h
    }
}

/// `[a, b, c]` with each element's `Debug`.
impl<T: Debug> Debug for List<T> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("[");
        let first = true;
        for x in self {
            if !first { try f.write_str(", "); }
            try Debug::fmt(x, ref f);
            first = false;
        }
        try f.write_str("]")
    }
}

/// `[a, b, c]` (refs-lang 6.5.1): a `List` - a fixed array only in a
/// `[T; N]` slot, which the compiler builds itself.
#[literal("[" {expr} % "," * "]")]
pub const fn list_literal<T>(items: ...T) -> List<T> {
    let l: List<T> = List::new();
    for x in items {
        l.push(x);
    }
    return l;
}

/// `xs += x`: push (stdlib 2.4.6).
impl<T> AddAssign<T> for List<T> {
    const fn add_assign(ref self, rhs: T) {
        self.push(rhs);
    }
}

/// `xs += ys`: append every element of `ys`, in place.
impl<T> AddAssign<List<T>> for List<T> {
    const fn add_assign(ref self, rhs: List<T>) {
        for x in rhs {
            self.push(x);
        }
    }
}

/// A hand-off's copy (stdlib 2.13.9): a new head and buffer; the
/// elements go through `transfer` from the memo's queue.
impl<T> Transfer for List<T> {
    const fn transfer_copy(self, m: Memo) -> List<T> {
        if buf_is_null(self.h) {
            return self;
        }
        if let got: GcBuf<ListHead<T>> = m.find(self.h) {
            return List { h: got };
        }
        unsafe {
            let s = self.h[0];
            let h: GcBuf<ListHead<T>> = buf_new(1);
            m.note(self.h, h);
            let buf = copy_shared(s.buf, s.len, cap_add(s.cap, 1), m);
            h[0] = ListHead { len: s.len, cap: s.cap, buf };
            List { h }
        }
    }

    const fn transfer_keep(self, m: Memo) -> List<T> {
        if !buf_is_null(self.h) {
            m.keep(self.h);
            unsafe { m.keep(self.h[0].buf) };
        }
        self
    }

    /// The buffer stands for the list (and every view of it); an empty
    /// list without one, by its head.
    const fn transfer_visit(self, m: Memo) -> List<T> {
        if buf_is_null(self.h) {
            return self;
        }
        unsafe {
            let s = self.h[0];
            if s.cap == 0 || buf_is_null(s.buf) {
                let _ = m.visit(self.h);
            } else if m.visit(s.buf) {
                m.later_visit(s.buf, s.len);
            }
        }
        self
    }
}

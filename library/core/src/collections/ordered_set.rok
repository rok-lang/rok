// rok::core::collections::ordered_set - `OrderedSet<T>`, a hash set that
// iterates in insertion order (stdlib spec 2.9.5), over
// `OrderedDict<T, bool>`.

pub struct OrderedSet<T> {
    d: OrderedDict<T, bool>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<T> !Sync for OrderedSet<T> {}

impl<T: Hash> OrderedSet<T> {
    /// An empty set.
    pub const fn new() -> OrderedSet<T> {
        OrderedSet { d: OrderedDict::new() }
    }

    /// The items inserted in order (later duplicates dropped).
    pub const fn from(items: List<T>) -> OrderedSet<T> {
        let s: OrderedSet<T> = OrderedSet { d: OrderedDict::with_capacity(items.len()) };
        for x in items {
            s.insert(x);
        }
        s
    }

    /// The number of members.
    pub const fn len(self) -> usize {
        self.d.len()
    }

    /// `true` when the set has no member.
    pub const fn is_empty(self) -> bool {
        self.d.is_empty()
    }

    /// `true` when `x` was not there yet.
    pub const fn insert(self, x: T) -> bool {
        self.d.insert(x, true) is none
    }

    /// `true` when `x` was there.
    pub const fn remove(self, x: T) -> bool {
        !(self.d.remove(x) is none)
    }

    /// `true` when `x` is a member.
    pub const fn contains(self, x: T) -> bool {
        self.d.contains_key(x)
    }

    /// Drop every member.
    pub const fn clear(self) {
        self.d.clear();
    }

    /// The members in insertion order, lazily.
    pub const fn iter(self) -> KeysIter<T, bool> {
        self.d.keys()
    }

    /// The members in a new list, in insertion order.
    pub const fn to_list(self) -> List<T> {
        self.iter().collect()
    }

    /// `self`'s members, then `other`'s new ones.
    pub const fn union(self, other: OrderedSet<T>) -> OrderedSet<T> {
        let out = OrderedSet::from(self.to_list());
        for x in other {
            out.insert(x);
        }
        out
    }

    /// The members of both sets, in `self`'s order.
    pub const fn intersection(self, other: OrderedSet<T>) -> OrderedSet<T> {
        self.iter().filter(|x: T| other.contains(x)).collect()
    }

    /// The members of `self` not in `other`, in `self`'s order.
    pub const fn difference(self, other: OrderedSet<T>) -> OrderedSet<T> {
        self.iter().filter(|x: T| !other.contains(x)).collect()
    }

    /// The members of exactly one set, `self`'s first.
    pub const fn symmetric_difference(self, other: OrderedSet<T>) -> OrderedSet<T> {
        self.difference(other).union(other.difference(self))
    }

    /// `true` when every member of `self` is in `other`.
    pub const fn is_subset(self, other: OrderedSet<T>) -> bool {
        self.iter().all(|x: T| other.contains(x))
    }

    /// `true` when every member of `other` is in `self`.
    pub const fn is_superset(self, other: OrderedSet<T>) -> bool {
        other.is_subset(self)
    }

    /// `true` when no member is in both sets.
    pub const fn is_disjoint(self, other: OrderedSet<T>) -> bool {
        !self.iter().any(|x: T| other.contains(x))
    }
}

impl<T: Hash> Default for OrderedSet<T> {
    fn default() -> OrderedSet<T> { OrderedSet::new() }
}

/// A new set with every member cloned, in the same order.
impl<T: Hash + Clone> Clone for OrderedSet<T> {
    const fn clone(self) -> OrderedSet<T> {
        let r: OrderedSet<T> = OrderedSet::new();
        for x in self {
            r.insert(x.clone());
        }
        r
    }
}

/// `for x in s`, in insertion order (2.9.9).
impl<T: Hash> IntoIterator for OrderedSet<T> {
    type IntoIter = KeysIter<T, bool>;
    type Item = T;
    const fn into_iter(self) -> KeysIter<T, bool> {
        self.iter()
    }
}

/// `it.collect()` into a set, in first-seen order.
impl<T: Hash> FromIterator<T> for OrderedSet<T> {
    const fn from_iter<I: IntoIterator<Item = T>>(it: I) -> OrderedSet<T> {
        let out: OrderedSet<T> = OrderedSet::new();
        for x in it {
            out.insert(x);
        }
        out
    }
}

/// `s += x`: insert `x` at the end when new (stdlib 2.4.6).
impl<T: Hash> AddAssign<T> for OrderedSet<T> {
    const fn add_assign(ref self, rhs: T) {
        self.insert(rhs);
    }
}

/// Same members (order does not matter, as for `Set`).
impl<T: Hash> PartialEq for OrderedSet<T> {
    const fn eq(self, rhs: OrderedSet<T>) -> bool {
        self.len() == rhs.len() && self.is_subset(rhs)
    }
    fn ne(self, rhs: OrderedSet<T>) -> bool { !self.eq(rhs) }
}

impl<T: Hash> Eq for OrderedSet<T> {}

/// Order-independent, matching `eq`: member hashes combine by xor.
impl<T: Hash> Hash for OrderedSet<T> {
    const fn hash(self) -> u64 {
        let h = self.len() as u64;
        for x in self { h ^= x.hash(); }
        h
    }
}

/// `{a, b, ..}` in insertion order.
impl<T: Hash + Debug> Debug for OrderedSet<T> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for x in self {
            if !first { try f.write_str(", "); }
            try Debug::fmt(x, ref f);
            first = false;
        }
        try f.write_str("}")
    }
}

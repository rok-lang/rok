// rok::core::print - `print` / `println` / `eprint` / `eprintln`
// (stdlib 2.23.8: the prelude names them, so they need no `use`). Each
// takes one value and renders it with `Display`; the argument defaults to
// the empty string, so `println()` writes a blank line.
// Format or combine several values with an f-string:
// `println(f"total = {total}")`.
//
// They share the runtime's stream writers with `io::stdout()` /
// `io::stderr()`; one call writes its line whole, so lines from
// different threads never interleave. Write errors are dropped.

pub fn print<T: Display>(v: T = "")    { unsafe { rok_stdio_write(1, f"{v}", 0) }; }
pub fn println<T: Display>(v: T = "")  { unsafe { rok_stdio_write(1, f"{v}", 1) }; }
pub fn eprint<T: Display>(v: T = "")   { unsafe { rok_stdio_write(2, f"{v}", 0) }; }
pub fn eprintln<T: Display>(v: T = "") { unsafe { rok_stdio_write(2, f"{v}", 1) }; }

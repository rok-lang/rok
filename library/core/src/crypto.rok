pub use ecdsa::{EcCurve, Ecdsa};
pub use rsa::{RsaPublicKey, RsaPrivateKey};

use rok::core::sync::{Atomic, AtomicOrdering};

/// Always 0, but loaded at run time: a mask built through `ct_mask*`
/// is a value the optimizer cannot prove is 0 or all ones, so the
/// and/or selects it drives are not rewritten into branches (LLVM does
/// that at -O2 to masks it can see are 0 or -1).
static CT_ZERO: Atomic<u32> = Atomic::new(0u32);

/// All ones when `bit` is 1, zero when it is 0.
pub(pkg) fn ct_mask(bit: u32) -> u32 {
    0u32.wrapping_sub(bit) ^ CT_ZERO.load(AtomicOrdering::Relaxed)
}

pub(pkg) fn ct_mask64(bit: u64) -> u64 {
    0u64.wrapping_sub(bit) ^ (CT_ZERO.load(AtomicOrdering::Relaxed) as u64)
}

pub(pkg) fn ct_mask_i64(bit: i64) -> i64 {
    -bit ^ (CT_ZERO.load(AtomicOrdering::Relaxed) as i64)
}

/// Byte input: a list, a view, a string's UTF-8 bytes or a secret.
pub type ByteInput = List<u8> | Slice<u8> | str | Secret;

/// The old name of `ByteInput`; `rok::std::io::Bytes` is another type.
#[deprecated(since = "0.1.6", note = "use `crypto::ByteInput`")]
pub type Bytes = ByteInput;

/// `b` as a view.
pub(pkg) fn view(b: ByteInput) -> Slice<u8> {
    match b {
        l: List<u8> => l[0:l.len()],
        s: Slice<u8> => s,
        t: str => t.as_bytes(),
        k: Secret => k.as_bytes(),
    }
}

/// Whether `a` and `b` are equal, in time that depends only on their
/// lengths.
pub fn constant_time_eq(a: ByteInput, b: ByteInput) -> bool {
    let x = view(a);
    let y = view(b);
    if x.len() != y.len() { return false; }
    let d = 0u8;
    for i in 0..x.len() {
        d = d | (x[i] ^ y[i]);
    }
    d == 0u8
}

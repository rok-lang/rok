// Cryptographic algorithms: pure computation, no OS (randomness is
// `rok::std::crypto::random`). Secret data is handled in constant time:
// no branch or memory index depends on it.

pub mod secret;
pub mod sha2;
pub mod hmac;
pub mod sha3;
pub(pkg) mod aes;
pub(pkg) mod chacha;
pub mod aead;
pub(pkg) mod bignum;
pub(pkg) mod ecfield;
pub(pkg) mod curve25519;
pub mod x25519;
pub mod ed25519;
pub mod ecdsa;
pub mod rsa;
pub mod mlkem;

pub use secret::Secret;
pub use sha2::{HashAlgorithm, Digest};
pub use sha3::{Sha3Algorithm, Sha3_256, Sha3_512, Shake128, Shake256};
pub use hmac::{Hmac, Hkdf};
pub use aead::{AeadAlgorithm, Aead};
pub use x25519::X25519;

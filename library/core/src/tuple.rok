}
impl<A: Eq, B: Eq, C: Eq> Eq for (A, B, C) {}
impl<A: Hash, B: Hash, C: Hash> Hash for (A, B, C) {
    fn hash<Hx: Hasher>(self, ref h: Hx) {
        self.0.hash(ref h);
        self.1.hash(ref h);
        self.2.hash(ref h);
    }
}


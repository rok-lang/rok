// rok::core::tuple - Clone / Copy / Default / Debug / PartialEq / Eq /
// Hash for tuples of 1 to 12 elements, component-wise, and PartialOrd /
// Ord, lexicographic (stdlib 2.5.7, 2.10.9, 2.13.6). One block per (arity, trait), all the same shape;
// keep every arity in step.

// 1-tuples
impl<A: Clone> Clone for (A,) {
    fn clone(self) -> (A,) { (self.0.clone(),) }
}
impl<A: Copy> Copy for (A,) {}
impl<A: Default> Default for (A,) {
    fn default() -> (A,) { (rok::core::marker::default_of(),) }
}
impl<A: Debug> Debug for (A,) {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("(");
        try f.debug_entry("", self.0, true, false);
        if !f.alternate() { try f.write_str(","); }
        try f.debug_close(")", false, false)
    }
}
impl<A: PartialEq> PartialEq for (A,) {
    fn eq(self, rhs: (A,)) -> bool { self.0.eq(rhs.0) }
    fn ne(self, rhs: (A,)) -> bool { !self.eq(rhs) }
}
impl<A: Eq> Eq for (A,) {}
impl<A: Hash> Hash for (A,) {
    fn hash<Hx: Hasher>(self, ref h: Hx) {
        self.0.hash(ref h);
    }
}

// 2-tuples
impl<A: Clone, B: Clone> Clone for (A, B) {
    const fn clone(self) -> (A, B) { (self.0.clone(), self.1.clone()) }
}
impl<A: Copy, B: Copy> Copy for (A, B) {}
impl<A: Default, B: Default> Default for (A, B) {
    const fn default() -> (A, B) { (rok::core::marker::default_of(), rok::core::marker::default_of()) }
}
impl<A: Debug, B: Debug> Debug for (A, B) {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("(");
        try f.debug_entry("", self.0, true, false);
        try f.debug_entry("", self.1, false, false);
        try f.debug_close(")", false, false)
    }
}
impl<A: PartialEq, B: PartialEq> PartialEq for (A, B) {
    const fn eq(self, rhs: (A, B)) -> bool { self.0.eq(rhs.0) && self.1.eq(rhs.1) }
    const fn ne(self, rhs: (A, B)) -> bool { !self.eq(rhs) }
}
impl<A: Eq, B: Eq> Eq for (A, B) {}
impl<A: Hash, B: Hash> Hash for (A, B) {
    const fn hash<Hx: Hasher>(self, ref h: Hx) {
        self.0.hash(ref h);
        self.1.hash(ref h);
    }
}


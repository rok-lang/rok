    const fn saturating_from(value: usize) -> i32 {
        if value > i32::MAX as usize { return i32::MAX; }
        value as i32
    }
}

impl SaturatingFrom<usize> for i64 {
    const fn saturating_from(value: usize) -> i64 {
        if value > i64::MAX as usize { return i64::MAX; }
        value as i64
    }
}

impl SaturatingFrom<usize> for isize {
    const fn saturating_from(value: usize) -> isize {
        if value > isize::MAX as usize { return isize::MAX; }
        value as isize
    }
}

impl SaturatingFrom<usize> for u8 {
    const fn saturating_from(value: usize) -> u8 {
        if value > u8::MAX as usize { return u8::MAX; }
        value as u8
    }
}

impl SaturatingFrom<usize> for u16 {
    const fn saturating_from(value: usize) -> u16 {
        if value > u16::MAX as usize { return u16::MAX; }
        value as u16
    }
}

impl SaturatingFrom<usize> for u32 {
    const fn saturating_from(value: usize) -> u32 {

// rok::core::convert: conversion traits and primitive
// impls. Four policies, each named at the call: lossless `into`,
// fallible `try_into` (throws `TryFrom::Error`, `OverflowError` for
// numbers), `saturating_into`, and `wrapping_into` (= `as`).
//
// The spec writes `trait Into<T> { fn into(self) -> T; }`, but a blanket
// `impl<T, U: From<T>> Into<U> for T` cannot fix `U` from the receiver,
// so each `*Into` trait has one generic method (`T` from the expected
// type, like `parse`) and one blanket impl; the conversions are the
// `*From` impls. `SaturatingFrom` / `WrappingFrom` back the last two
// policies. The lossless impls are also `rok.cast.*` intrinsics;
// their bodies are the same `as`.

/// A lossless conversion from `U`.
pub trait From<U> {
    /// Converts `value` without loss.
    fn from(value: U) -> Self;
}

/// `x.into()` = `T::from(x)`; `T` from the expected type.
pub trait Into {
    /// Converts `self` to `T` through `T::from`.
    fn into<T: From<Self>>(self) -> T;
}

impl<S> Into for S {
    const fn into<T: From<S>>(self) -> T { T::from(self) }
}

/// A conversion that can fail. `Error` is what it throws:
/// `ConversionError` unless the impl names another (the numeric impls
/// say `OverflowError`).
pub trait TryFrom<U> {
    type Error = ConversionError;
    /// `value` converted; throws when it cannot be.
    fn try_from(value: U) throws (Self::Error) -> Self;
}

/// `x.try_into()` = `T::try_from(x)`; throws `T`'s `Error`.
pub trait TryInto {
    /// Converts `self` to `T` through `T::try_from`; throws `T::Error` when
    /// the value does not fit.
    fn try_into<T: TryFrom<Self>>(self) throws (T::Error) -> T;
}

impl<S> TryInto for S {
    const fn try_into<T: TryFrom<S>>(self) throws (T::Error) -> T { try T::try_from(self) }
}

/// Out-of-range values clamp to the nearest end.
pub trait SaturatingFrom<U> {
    /// Converts `value`, clamping it to the nearest end of `Self`'s range.
    fn saturating_from(value: U) -> Self;
}

/// `x.saturating_into()` = `T::saturating_from(x)`; `T` from the
/// expected type.
pub trait SaturatingInto {
    /// Converts `self` to `T` through `T::saturating_from`.
    fn saturating_into<T: SaturatingFrom<Self>>(self) -> T;
}

impl<S> SaturatingInto for S {
    const fn saturating_into<T: SaturatingFrom<S>>(self) -> T { T::saturating_from(self) }
}

/// Keep the low bits - `as` spelled as a method.
pub trait WrappingFrom<U> {
    /// Converts `value`, keeping the low bits that fit in `Self`.
    fn wrapping_from(value: U) -> Self;
}

/// `x.wrapping_into()` = `T::wrapping_from(x)`; `T` from the
/// expected type.
pub trait WrappingInto {
    /// Converts `self` to `T` through `T::wrapping_from`.
    fn wrapping_into<T: WrappingFrom<Self>>(self) -> T;
}

impl<S> WrappingInto for S {
    const fn wrapping_into<T: WrappingFrom<S>>(self) -> T { T::wrapping_from(self) }
}

/// Bytes as a view: a `str` (its UTF-8), a `List<u8>`, a `Slice<u8>`,
/// a `[u8; N]` or a `crypto::Secret`. Every byte parameter in the
/// library takes `<B: AsBytes>`.
pub trait AsBytes {
    /// The bytes as a view (no copy).
    fn byte_slice(self) -> Slice<u8>;
}

const fn overflow(ty: str) -> OverflowError { OverflowError::new("try_from", ty) }

// From (lossless)

impl From<i8> for i16 {
    #[intrinsic("rok.cast.i8.i16")]
    const fn from(value: i8) -> i16 { value as i16 }
}

impl From<i8> for i32 {
    #[intrinsic("rok.cast.i8.i32")]
    const fn from(value: i8) -> i32 { value as i32 }
}

impl From<i8> for i64 {
    #[intrinsic("rok.cast.i8.i64")]
    const fn from(value: i8) -> i64 { value as i64 }
}

impl From<i8> for isize {
    #[intrinsic("rok.cast.i8.isize")]
    const fn from(value: i8) -> isize { value as isize }
}

impl From<i8> for f32 {
    #[intrinsic("rok.cast.i8.f32")]
    const fn from(value: i8) -> f32 { value as f32 }
}

impl From<i8> for f64 {

    const fn saturating_from(value: u64) -> u8 {
        if value > u8::MAX as u64 { return u8::MAX; }
        value as u8
    }
}

impl SaturatingFrom<u64> for u16 {
    const fn saturating_from(value: u64) -> u16 {
        if value > u16::MAX as u64 { return u16::MAX; }
        value as u16
    }
}

impl SaturatingFrom<u64> for u32 {
    const fn saturating_from(value: u64) -> u32 {
        if value > u32::MAX as u64 { return u32::MAX; }
        value as u32
    }
}

impl SaturatingFrom<u64> for usize {
    const fn saturating_from(value: u64) -> usize { value as usize }
}

impl SaturatingFrom<usize> for i8 {
    const fn saturating_from(value: usize) -> i8 {
        if value > i8::MAX as usize { return i8::MAX; }
        value as i8
    }
}


    (i64, isize), (i64, u8), (i64, u16), (i64, u32), (i64, u64), (i64, usize),
    (isize, i8), (isize, i16), (isize, i32), (isize, i64), (isize, u8), (isize, u16),
    (isize, u32), (isize, u64), (isize, usize), (u8, i8), (u8, i16), (u8, i32),
    (u8, i64), (u8, isize), (u8, u16), (u8, u32), (u8, u64), (u8, usize),
    (u16, i8), (u16, i16), (u16, i32), (u16, i64), (u16, isize), (u16, u8),
    (u16, u32), (u16, u64), (u16, usize), (u32, i8), (u32, i16), (u32, i32),
    (u32, i64), (u32, isize), (u32, u8), (u32, u16), (u32, u64), (u32, usize),
    (u64, i8), (u64, i16), (u64, i32), (u64, i64), (u64, isize), (u64, u8),

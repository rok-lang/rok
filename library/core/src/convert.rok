}

// No `From`: `isize` is narrower than `i64` on 32-bit targets, and the
// same code builds on every target (on 64 bits it never throws).
impl TryFrom<i64> for isize {
    type Error = OverflowError;
    fn try_from(value: i64) throws (OverflowError) -> isize {
        if value < isize::MIN as i64 || value > isize::MAX as i64 { throw overflow("isize"); }
        value as isize
    }
}

impl From<isize> for i64 {
    #[intrinsic("rok.cast.isize.i64")]
    const fn from(value: isize) -> i64 { value as i64 }
}

impl From<u8> for u16 {
    #[intrinsic("rok.cast.u8.u16")]
    const fn from(value: u8) -> u16 { value as u16 }
}


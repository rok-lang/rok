        value as u32
    }
}

impl SaturatingFrom<usize> for u64 {
    const fn saturating_from(value: usize) -> u64 { value as u64 }
}

impl SaturatingFrom<f64> for f32 {
    const fn saturating_from(value: f64) -> f32 {
        if value > f32::MAX as f64 { return f32::MAX; }
        if value < f32::MIN as f64 { return f32::MIN; }
        value as f32
    }
}

// WrappingFrom (low bits, like `as`)

#[impl_macro(wrapping_casts)] @macro {
    (@rep[sep = ","] { (@u: ty, @t: ty) }) => {
        @for @u {
            impl WrappingFrom<@u> for @t {
                const fn wrapping_from(value: @u) -> @t { value as @t }
            }
        }
    }
}
wrapping_casts!(
    (i8, i16), (i8, i32), (i8, i64), (i8, isize), (i8, u8), (i8, u16),
    (i8, u32), (i8, u64), (i8, usize), (i16, i8), (i16, i32), (i16, i64),
    (i16, isize), (i16, u8), (i16, u16), (i16, u32), (i16, u64), (i16, usize),

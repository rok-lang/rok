// TryFrom (floating-point → integer): truncates toward zero;
// NaN, infinities and values outside the target's range throw.

impl TryFrom<f32> for i8 {
    type Error = OverflowError;
    const fn try_from(value: f32) throws (OverflowError) -> i8 {
        let x = (value as f64).trunc();
        if !(x >= i8::MIN as f64 && x < i8::MAX as f64 + 1.0) { throw overflow("i8"); }
        x as i8
    }
}

impl TryFrom<f32> for i16 {
    type Error = OverflowError;
    const fn try_from(value: f32) throws (OverflowError) -> i16 {
        let x = (value as f64).trunc();
        if !(x >= i16::MIN as f64 && x < i16::MAX as f64 + 1.0) { throw overflow("i16"); }
        x as i16
    }
}


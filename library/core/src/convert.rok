impl TryFrom<f64> for f32 {
    type Error = OverflowError;
    /// Throws when a finite `value` is beyond `f32`'s range.
    const fn try_from(value: f64) throws (OverflowError) -> f32 {
        if value.is_finite() && value.abs() > f32::MAX as f64 { throw overflow("f32"); }
        value as f32
    }
}

// TryFrom<str>: `FromStr`'s parse; any failure (empty, a bad
// digit, out of range) throws its `ParseError`.

impl TryFrom<str> for i8 {
    type Error = ParseError;
    const fn try_from(s: str) throws (ParseError) -> i8 { try i8::from_str(s) }
}


/// By scalar value, skipping the surrogates `0xD800..=0xDFFF` (2.7.3).
impl Step for char {
    const fn forward_checked(self, count: usize) -> char | none {
        let n = self as u32 as usize;
        let t = n.checked_add(count)?;
        let u = if n < 0xD800 && t >= 0xD800 { t.checked_add(0x800)? } else { t };
        if u > 0x10FFFF {
            return none;
        }
        char::from_u32(u as u32)
    }
    const fn backward_checked(self, count: usize) -> char | none {
        let n = self as u32 as usize;
        let t = n.checked_sub(count)?;
        let u = if n >= 0xE000 && t < 0xE000 { t.checked_sub(0x800)? } else { t };
        char::from_u32(u as u32)
    }
    const fn steps_between(start: char, end: char) -> usize | none {
        let (s, e) = (start as u32, end as u32);
        if s > e {
            return none;
        }
        let d = e - s;
        (if s < 0xD800 && e >= 0xE000 { d - 0x800 } else { d }) as usize
    }
}

// Range literals (refs-lang 6.5.1).

#[literal(expr ".." expr)]
pub const fn range_literal<T>(start: T, end: T) -> Range<T> {
    return Range { start: start, end: end };
}

#[literal(expr "..=" expr)]
pub const fn range_inclusive_literal<T>(start: T, end: T) -> RangeInclusive<T> {
    return RangeInclusive { start: start, end: end };
}

#[literal(expr "..")]
pub const fn range_from_literal<T>(start: T) -> RangeFrom<T> {
    return RangeFrom { start: start };
}

#[literal(".." expr)]
pub const fn range_to_literal<T>(end: T) -> RangeTo<T> {
    return RangeTo { end: end };
}

#[literal("..=" expr)]
pub const fn range_to_inclusive_literal<T>(end: T) -> RangeToInclusive<T> {
    return RangeToInclusive { end: end };
}

#[literal("..")]
pub const fn range_full_literal() -> RangeFull {
    return RangeFull;
}

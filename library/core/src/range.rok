impl Step for isize {
    const fn forward_checked(self, count: usize) -> isize | none {
        if count > isize::MAX as usize {
            return none;
        }
        let k = count as isize;
        if self > isize::MAX - k {
            return none;
        }
        self + k
    }
    const fn backward_checked(self, count: usize) -> isize | none {
        if count > isize::MAX as usize {
            return none;
        }
        let k = count as isize;
        if self < isize::MIN + k {
            return none;
        }
        self - k
    }
    const fn steps_between(start: isize, end: isize) -> usize | none {
        if start > end {
            return none;
        }
        if start >= 0 || end < 0 {
            return (end - start) as usize;
        }
        end as usize + (-(start + 1)) as usize + 1
    }
}

impl Step for u8 {
    const fn forward_checked(self, count: usize) -> u8 | none {
        if count > 255u8 as usize {
            return none;
        }
        let k = count as u8;
        if self > 255u8 - k {
            return none;
        }
        self + k
    }
    const fn backward_checked(self, count: usize) -> u8 | none {
        if count > 255u8 as usize {
            return none;
        }
        let k = count as u8;
        if self < (0u8) + k {
            return none;
        }
        self - k
    }
    const fn steps_between(start: u8, end: u8) -> usize | none {
        if start > end {
            return none;
        }
        (end - start) as usize
    }
}


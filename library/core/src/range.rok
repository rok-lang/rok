// Range / RangeInclusive / RangeFrom / RangeTo / RangeToInclusive /
// RangeFull (stdlib 2.7.4, refs-lang 3.7).
//
// A range expression is a value of these types (`let r = 0..5;`),
// built by the `#[literal]` handlers at the end of this file. `for i in
// a..b` with the range written in the loop header keeps a direct
// counting loop.

/// One step forward / back (2.7.3). Integers implement it; floats don't,
/// so `Range<f64>` is no iterator.
pub trait Step: PartialOrd + Clone {
    fn forward_checked(self, count: usize) -> Self | none;
    fn backward_checked(self, count: usize) -> Self | none;
    fn steps_between(start: Self, end: Self) -> usize | none;
}

#[lang("range_type")]
pub struct Range<T> {
    pub start: T;
    pub end: T;
}

#[derive(Clone, PartialEq, Eq, Hash)]
pub struct RangeInclusive<T> {
    pub start: T;
    pub end: T;
    /// Set once the last item (`end`) is taken (from either side).
    exhausted: bool = false;
}

#[derive(Clone, PartialEq, Eq, Hash)]
pub struct RangeFrom<T> {
    pub start: T;
}

#[derive(Clone, PartialEq, Eq, Hash)]
pub struct RangeTo<T> {
    pub end: T;
}

/// `..=b`: up to and including `end` (the spec's range grammar has no
/// `..=b` form; this mirrors `RangeTo`).
#[derive(Clone, PartialEq, Eq, Hash)]
pub struct RangeToInclusive<T> {
    pub end: T;
}

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct RangeFull;

// Clone / Copy / PartialEq / Eq from the bounds (stdlib 2.13, 2.5.7).
impl<T: Clone> Clone for Range<T> {
    const fn clone(self) -> Range<T> { Range { start: self.start.clone(), end: self.end.clone() } }
}

impl<T: Copy> Copy for Range<T> {}

impl<T: PartialEq> PartialEq for Range<T> {
    const fn eq(self, rhs: Range<T>) -> bool { self.start == rhs.start && self.end == rhs.end }
}

impl<T: Eq> Eq for Range<T> {}

impl<T: Hash> Hash for Range<T> {
    const fn hash(self) -> u64 {
        let h = self.start.hash();
        ((h << 5) | (h >> 59)) ^ self.end.hash()
    }
}

// Debug as the range is written: `0..3`, `0..=3`, `0..`, `..3`, `..=3`, `..`.
impl<T: Debug> Debug for Range<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try Debug::fmt(self.start, ref f);
        try f.write_str("..");
        try Debug::fmt(self.end, ref f);
    }
}

impl<T: Debug> Debug for RangeInclusive<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try Debug::fmt(self.start, ref f);
        try f.write_str("..=");
        try Debug::fmt(self.end, ref f);
        if self.exhausted { try f.write_str(" (exhausted)"); }
    }
}

impl<T: Debug> Debug for RangeFrom<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try Debug::fmt(self.start, ref f);
        try f.write_str("..");
    }
}

impl<T: Debug> Debug for RangeTo<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("..");
        try Debug::fmt(self.end, ref f);
    }
}

impl<T: Debug> Debug for RangeToInclusive<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("..=");
        try Debug::fmt(self.end, ref f);
    }
}

impl Debug for RangeFull {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("..") }
}

impl<T: Step> Iterator for Range<T> {
    type Item = T;
    const fn next(ref self) -> T | none {
        if self.start < self.end {
            let cur = self.start;
            self.start = self.start.forward_checked(1) ?? self.end;
            return cur;
        }
        none
    }

    const fn exact_len(self) -> usize | none {
        if !(self.start < self.end) {
            return 0;
        }
        T::steps_between(self.start, self.end)
    }

    /// `ExactSizeIterator`: O(1) (2.7.10).
    const fn count(self) -> usize { self.len() }
}

impl<T: Step> DoubleEndedIterator for Range<T> {
    const fn next_back(ref self) -> T | none {
        if self.start < self.end {
            let p = self.end.backward_checked(1)?;
            self.end = p;
            return p;
        }
        none
    }
}

impl<T: Step> ExactSizeIterator for Range<T> {
    const fn len(self) -> usize {
        if !(self.start < self.end) {
            return 0;
        }
        T::steps_between(self.start, self.end) ?? panic("range length overflows usize")
    }
}

impl<T: Step> Iterator for RangeInclusive<T> {
    type Item = T;
    const fn next(ref self) -> T | none {
        if self.exhausted || self.start > self.end {
            return none;
        }
        let cur = self.start;
        if self.start == self.end {
            self.exhausted = true;
        } else {
            if let n: T = self.start.forward_checked(1) {
                self.start = n;
            } else {
                self.exhausted = true;
            }
        }
        cur
    }

    const fn exact_len(self) -> usize | none {
        if self.exhausted || self.start > self.end {
            return 0;
        }
        T::steps_between(self.start, self.end)?.checked_add(1)
    }

    /// `ExactSizeIterator`: O(1) (2.7.10).
    const fn count(self) -> usize { self.len() }
}

impl<T: Step> DoubleEndedIterator for RangeInclusive<T> {
    const fn next_back(ref self) -> T | none {
        if self.exhausted || self.start > self.end {
            return none;
        }
        let cur = self.end;
        if self.start == self.end {
            self.exhausted = true;
        } else {
            if let p: T = self.end.backward_checked(1) {
                self.end = p;
            } else {
                self.exhausted = true;
            }
        }
        cur
    }
}

impl<T: Step> ExactSizeIterator for RangeInclusive<T> {
    const fn len(self) -> usize {
        if self.exhausted || self.start > self.end {
            return 0;
        }
        let n = T::steps_between(self.start, self.end) ?? panic("range length overflows usize");
        n.checked_add(1) ?? panic("range length overflows usize")
    }
}

impl<T: Step> Iterator for RangeFrom<T> {
    type Item = T;
    /// Stops (without yielding it) at the type's maximum (2.7.4).
    const fn next(ref self) -> T | none {
        let cur = self.start;
        self.start = self.start.forward_checked(1)?;
        cur
    }
}

// Step for the integer primitives (generated: one impl per type).
// A `count` above the type's maximum is `none` even where the
// step would fit (signed types walking up from below zero).

impl Step for i8 {
    const fn forward_checked(self, count: usize) -> i8 | none {
        if count > 127i8 as usize {
            return none;
        }
        let k = count as i8;
        if self > 127i8 - k {
            return none;
        }
        self + k
    }
    const fn backward_checked(self, count: usize) -> i8 | none {
        if count > 127i8 as usize {
            return none;
        }
        let k = count as i8;
        if self < (-127i8 - 1) + k {
            return none;
        }
        self - k
    }
    const fn steps_between(start: i8, end: i8) -> usize | none {
        if start > end {
            return none;
        }
        if start >= 0 || end < 0 {
            return (end - start) as usize;
        }
        end as usize + (-(start + 1)) as usize + 1
    }
}


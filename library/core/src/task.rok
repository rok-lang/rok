// rok::core::task: tasks on the work-stealing executor (stdlib 2.18,
// refs-lang 7.6) and `block_on` (2.20.6); `Duration` / `Instant` are
// `rok::core::time`.
//
// One executor per process, started on first use: N workers on threads
// that live as long as the process (N = online CPUs or `ROKR_WORKERS`),
// the blocking lane and the I/O driver. `block_on` and `par::*` attach
// the calling thread as a guest until their future and its
// `spawn_local` tasks are done. Without threads (wasm32-wasip2, the
// browser) the guest runs everything itself, waiting in `rok_io_wait`.
//
// A worker has a local queue (`spawn_local`, never stolen) and a
// Chase-Lev deque; guests have neither and push to the shared injector.
// A worker takes from its local queue, its deque, the injector, then
// steals; the owner takes FIFO too, since LIFO lets a self-waking task
// (`yield_now`) starve the rest of its deque.
//
// A task's state goes IDLE -> SCHEDULED -> RUNNING -> IDLE / DONE; a wake
// while RUNNING marks it NOTIFIED and it is queued again after the poll.
//
// Idle workers sleep on a flag; a push wakes one flagged worker, which
// searches until it finds work, and the last searcher to find a task
// wakes the next (tokio's scheme). No worker spins before sleeping.
//
// I/O (707): a driver thread blocks in kqueue / epoll / IOCP and unparks the
// tasks waiting on a ready fd.
//
// Blocking calls (706 §7.6.7): each pool thread has a runtime lane that
// is marked blocked for the length of a blocking call. A monitor scans
// the lanes every millisecond; a worker blocked across a whole scan is
// handed to a spare or new thread, and the blocked thread finishes its
// poll as an orphan guest, then waits as a spare (10 s, then exits).
// At most 512 extra threads. A worker with live `spawn_local` tasks is
// never handed on.
//
// Cancellation (2.18.4, 707 §7.7.9): `Task::cancel` sets a flag and
// wakes the task; each `await` checks it on entry and after each resume
// and leaves the body like a `return`, running `finally` / `using`. A
// task cancelled before its first poll is never polled.
//
// Timers: one binary heap behind a `Mutex` (707 §7.7.4).
//
// `ROKR_THREAD_PER_CORE=1` (706 §7.6.8) keeps every task on one worker's
// local queue, so nothing is stolen. `ROKR_DYNAMIC_WORKERS=1` (707
// §7.7.8) wakes only active workers and activates one more when all are
// busy.
//
// REPL sessions are saved between cells (`rok_session_hold`): every
// executor thread is busy from `rok_session_enter` to
// `rok_session_leave` except while asleep, and parks at
// `rok_session_pass` (between tasks, holding no lock) while a hold is
// requested, so no task is mid-poll in a saved session.

use rok::core::time::{Duration, Instant};
use rok::core::future::{Context, Future, Poll, TryAsyncFuture, Waker};
use rok::core::collections::raw::{GcBuf, buf_new, buf_same};
use rok::core::marker::{Memo, Transfer, hand_over};
use rok::core::sync::{Atomic, Mutex, Once};
use rok::core::rt::{atomic_add, atomic_cas, atomic_load, atomic_xchg, key};

fn now_ns() -> i64 {
    unsafe { rok_time_now_ns() }
}

const IDLE: i32 = 0;
const SCHEDULED: i32 = 1;
const RUNNING: i32 = 2;
const NOTIFIED: i32 = 3;
const DONE: i32 = 4;

// `TaskRef::state[8]`: who cancelled the task.
const BY_CANCEL: i32 = 0;
const BY_RACE: i32 = 1;
const BY_TIMEOUT: i32 = 2;

/// A task as the executor sees it (what a `Waker` holds).
pub(pkg) struct TaskRef {
    /// `[state, cancelled, timed, proxy, unwinding, local, handed,
    /// cleaning, cause, started]` (`timed`: it has added a timer; `proxy`:
    /// a `select` stand-in, see `up`; `unwinding`: a cancellation point
    /// saw the cancel; `local`: a `spawn_local` task, counted in its
    /// home's `locals`; `handed`: its `Task` went through a hand-off or a
    /// `par` item, so it may have joiners on other threads; `cleaning`: in
    /// this poll a frame left by the cancel runs its cleanups, which no
    /// cancellation point cuts short; `cause`: who cancelled it, for the
    /// panic of an `await` on it (`BY_*`); `started`: it was polled).
    state: GcBuf<i32>;
    /// One poll of the task's future; `true` once it is done.
    poll: GcBuf<fn(Context) -> bool>;
    /// Wakers to wake when it is done (and the lock for `DONE`).
    joiners: Mutex<List<Waker>>;
    /// Parking keys it may still be parked on (under the parking lock):
    /// dropped from the table when it finishes (a cancelled task's).
    parked: List<usize>;
    /// `spawn_local`, or any task under thread-per-core: the only worker
    /// that runs it. Boxed: a `TaskRef` travels by value in every
    /// `Context`, through every poll level.
    home: GcBuf<Worker | none>;
    /// Its `TaskId`.
    id: u64;
    /// A `select`'s stand-in for its children (`state[3]` set): wakes
    /// go to `up[0]` (while not done) and its cancel flag is that one's
    /// too. Other tasks share the executor's empty `no_up`.
    up: GcBuf<Waker>;
}

unsafe impl Send for TaskRef {}
unsafe impl Sync for TaskRef {}

fn is_done(t: TaskRef) -> bool {
    atomic_load(t.state, 0, SeqCst) == DONE
}

fn is_cancelled(t: TaskRef) -> bool {
    atomic_load(t.state, 1, SeqCst) != 0
}

/// A finished task that left by its cancel (no result). One cancelled
/// after its last cancellation point finished normally: its result
/// stands (a value it received is not lost).
fn no_result(t: TaskRef) -> bool {
    is_cancelled(t) && atomic_load(t.state, 4, SeqCst) != 0
}

/// Schedule `t` to be polled (`Waker::wake`); safe from any thread.
pub(pkg) fn wake_task(t: TaskRef) {
    unsafe {
        if t.state[3] != 0 {
            if atomic_load(t.state, 0, SeqCst) != DONE {
                t.up[0].wake();
            }
            return;
        }
        loop {
            let s = atomic_load(t.state, 0, SeqCst);
            if s == IDLE {
                if atomic_cas(t.state, 0, IDLE, SCHEDULED, SeqCst, SeqCst) == IDLE {
                    schedule(t);
                    return;
                }
            } else if s == RUNNING {
                if atomic_cas(t.state, 0, RUNNING, NOTIFIED, SeqCst, SeqCst) == RUNNING {
                    return;
                }
            } else {
                return;
            }
        }
    }
}

/// Wake `waiter` once `t` is done (at once if it is).
fn join_later(t: TaskRef, waiter: Waker) -> bool {
    let done = false;
    using g = t.joiners.lock() {
        if is_done(t) {
            done = true;
        } else {
            g.get().push(waiter);
        }
    }
    done
}

fn finish(t: TaskRef) {
    unsafe {
        // Its parking entries go first (a cancelled task left its `await`
        // without the wake it waited for): a joiner that sees it done sees
        // none of them.
        unpark_task(t);
        let ws: List<Waker> = List::new();
        using g = t.joiners.lock() {
            atomic_xchg(t.state, 0, DONE, SeqCst);
            ws = g.get();
            g.set_unshared(List::new());
        }
        // The finished future (its frame) is no longer reachable from here.
        t.poll[0] = |ctx: Context| -> bool { true };
        // A cancelled task's timers (a done task's no longer count).
        if is_cancelled(t) && atomic_load(t.state, 2, SeqCst) != 0 {
            remove_timers(t);
        }
        for w in ws {
            w.wake();
        }
        // `help_until` or the task's home worker may be waiting on it.
        let pool = executor();
        pool.wake_helpers();
        if let h: Worker = t.home[0] {
            if t.state[5] != 0 {
                atomic_add(h.locals, 0, -1, SeqCst);
            }
            _ = wake_worker(h);
        }
    }
}

/// A FIFO of tasks behind a lock; `len` is readable without it.
struct Queue {
    items: Mutex<Deque<TaskRef>>;
    len: Atomic<usize>;
}

const fn queue_new() -> Queue {
    Queue { items: unsafe { Mutex::new_unshared(Deque::new()) }, len: Atomic::new(0usize) }
}

fn push(q: Queue, t: TaskRef) {
    using g = q.items.lock() {
        g.get().push_back(t);
        q.len.fetch_add(1usize);
    }
}

#[discardable]
fn pop_front(q: Queue) -> TaskRef | none {
    if q.len.load() == 0 {
        return none;
    }
    let t: TaskRef | none = none;
    using g = q.items.lock() {
        t = g.get().pop_front();
        if t is TaskRef {
            q.len.fetch_sub(1usize);
        }
    }
    t
}

struct Timer {
    at: i64;
    who: Waker;
}

// `signal` words.
/// Bumped by every push and finished task; `help_until` waits on it.
const EPOCH: usize = 0;
/// Threads in `help_until`.
const HELPERS: usize = 1;
/// Workers a wake left searching (`WOKEN`): a push need not wake one.
const SEARCHING: usize = 2;
/// Dynamic worker count: the workers a push may wake (`workers[..n]`).
const ACTIVE: usize = 3;
/// Thread-per-core: the next home for a task spawned off the pool.
const HOMES: usize = 4;

// `Worker.sleep` values (0: running).
/// Sleeping, or about to.
const ASLEEP: i32 = 1;
/// Woken by a push, searching until it finds a task or sleeps again.
const WOKEN: i32 = 2;

/// The process's work-stealing executor.
pub(pkg) struct Pool {
    workers: List<Worker>;
    injector: Queue;
    /// Earliest deadline on top.
    timers: Mutex<BinaryHeap<Timer>>;
    /// Cancelled tasks with timers since the last sweep (under `timers`).
    dead: GcBuf<usize>;
    signal: GcBuf<i32>;
    /// Every non-proxy task's `up`.
    no_up: GcBuf<Waker>;
    /// Every non-local task's `home`.
    no_home: GcBuf<Worker | none>;
    /// Starts the I/O driver thread once.
    driver: Once;
    blocking: BlockingPool;
    /// Threads left from handoffs, waiting for the next one.
    spares: Spares;
    /// The monitor's and the I/O driver's thread ids (0: none yet).
    monitor_id: GcBuf<u64>;
    driver_id: GcBuf<u64>;
    /// No threads: the guest is the whole executor.
    solo: bool;
    /// Thread-per-core (706 §7.6.8): every task has a home worker.
    pinned: bool;
    /// Dynamic worker count (707 §7.7.8).
    dynamic: bool;
}

unsafe impl Send for Pool {}
unsafe impl Sync for Pool {}

/// A thread running tasks: a pool thread, or a guest (`block_on`).
pub(pkg) struct Worker {
    pool: Pool;
    /// Its position in `pool.workers`; 0 for a guest.
    index: usize;
    /// A guest's deque is never used: its spawns go to the injector.
    guest: bool;
    local: Queue;
    deque: GcBuf<GcBuf<TaskRef>>;
    /// Where a steal lands.
    stolen: GcBuf<GcBuf<TaskRef>>;
    /// `ASLEEP` while it sleeps (or is about to); the push that wakes it
    /// sets `WOKEN`, which it clears once it finds a task or sleeps again.
    sleep: GcBuf<i32>;
    /// The task it is polling (`task::id`).
    running: GcBuf<TaskRef | none>;
    /// xorshift state: where its steals start (spec 7.6.4).
    seed: GcBuf<u64>;
    /// A pool thread's runtime lane (`rok_lane_new`), replaced when the
    /// worker moves to a new thread.
    lane: GcBuf<usize>;
    /// The lane tick the monitor saw blocked at its last scan (-1: none).
    seen: GcBuf<i64>;
    /// Its live `spawn_local` tasks (atomic).
    locals: GcBuf<i32>;
    /// A guest left to a thread whose worker was handed on: it exits once
    /// it has no local tasks.
    orphan: bool;
    /// A pool worker's thread id (`rok_thread_new_id`).
    tid: GcBuf<u64>;
    /// A guest polling a task it does not own: the one pool worker that
    /// task's `spawn_local`s go to (its index + 1; 0: none yet), and those
    /// locals, held until the poll ends so they never run beside it
    /// (`local_home`).
    lend: GcBuf<usize>;
    lent: Queue;
}

fn new_worker(pool: Pool, index: usize, guest: bool, orphan: bool) -> Worker {
    unsafe {
        let lane: GcBuf<usize> = buf_new(1);
        if !guest {
            lane[0] = rok_lane_new();
        }
        let seen: GcBuf<i64> = buf_new(1);
        seen[0] = -1;
        Worker {
            pool,
            index,
            guest,
            local: queue_new(),
            deque: rok_deque_new(),
            stolen: buf_new(1),
            sleep: buf_new(1),
            running: buf_new(1),
            seed: seed_new(index),
            lane,
            seen,
            locals: buf_new(1),
            orphan,
            tid: buf_new(1),
            lend: buf_new(1),
            lent: queue_new(),
        }
    }
}

const fn seed_new(index: usize) -> GcBuf<u64> {
    unsafe {
        let s: GcBuf<u64> = buf_new(1);
        s[0] = (index as u64 + 1).wrapping_mul(0x9E3779B97F4A7C15u64);
        s
    }
}

/// The next pseudo-random number of `w`'s xorshift.
const fn next_rand(w: Worker) -> u64 {
    unsafe {
        let x = w.seed[0];
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        w.seed[0] = x;
        x
    }
}

// Started by the first `executor()`, not by a static initializer:
// every static is compiled into every program, the executor only into
// those that reach it.
static EXEC: GcBuf<Pool> = unsafe { buf_new(1) };
static EXEC_STARTED: Once = Once::new();

/// The executor, started on first use.
fn executor() -> Pool {
    unsafe {
        if !EXEC_STARTED.is_completed() {
            EXEC_STARTED.call_once(|| { EXEC[0] = Pool::start(); });
        }
        EXEC[0]
    }
}

impl Pool {
    fn start() -> Pool {
        unsafe {
            let mode = rok_sched_mode();
            let pool = Pool {
                workers: List::new(),
                injector: queue_new(),
                timers: Mutex::new(BinaryHeap::by_ordering(|a: Timer, b: Timer| b.at.cmp(a.at))),
                dead: buf_new(1),
                signal: buf_new(5),
                no_up: buf_new(0),
                no_home: buf_new(1),
                driver: Once::new(),
                blocking: BlockingPool::new(),
                spares: Spares::new(),
                monitor_id: buf_new(1),
                driver_id: buf_new(1),
                solo: rok_cpu_count() == 0,
                pinned: (mode & 1u32) != 0u32,
                dynamic: (mode & 2u32) != 0u32,
            };
            let n = rok_sched_workers();
            pool.signal[ACTIVE] = n as i32;
            for i in 0..n {
                pool.workers.push(new_worker(pool, i, false, false));
            }
            rok_task_hooks_install(hook_io, hook_timer, hook_park, hook_unpark, hook_restart);
            for w in pool.workers {
                start_worker(w);
            }
            if pool.solo {
                return pool;
            }
            start_monitor(pool);
            pool
        }
    }

    /// Number of pool threads.
    pub const fn workers(self) -> usize {
        self.workers.len()
    }

    /// Bump the epoch and wake one sleeping worker (if any); with a
    /// dynamic worker count, an active one, else one more becomes active.
    fn notify(self) {
        self.wake_helpers();
        if atomic_load(self.signal, SEARCHING, SeqCst) > 0 {
            return;
        }
        let n = self.workers();
        let active = if self.dynamic { atomic_load(self.signal, ACTIVE, SeqCst) as usize } else { n };
        for i in 0..active {
            if wake_worker(self.workers[i]) {
                return;
            }
        }
        if active < n {
            let a = active as i32;
            if atomic_cas(self.signal, ACTIVE, a, a + 1, SeqCst, SeqCst) == a {
                _ = wake_worker(self.workers[active]);
            }
        }
    }

    /// Dynamic worker count: pool worker `w` is going idle; the last
    /// active one parks (pushes wake the others first).
    fn idle(self, w: Worker) {
        if !self.dynamic || w.guest {
            return;
        }
        let a = atomic_load(self.signal, ACTIVE, SeqCst);
        if a > 1 && w.index + 1 == a as usize {
            atomic_cas(self.signal, ACTIVE, a, a - 1, SeqCst, SeqCst);
        }
    }

    /// Thread-per-core: the home of a task spawned now, the spawning
    /// pool worker or else the next one in turn.
    fn home_for(self) -> Worker {
        if let w: Worker = current() {
            if !w.guest {
                return w;
            }
        }
        let k = atomic_add(self.signal, HOMES, 1, SeqCst);
        self.workers[(k as u32 as usize) % self.workers()]
    }

    fn wake_helpers(self) {
        atomic_add(self.signal, EPOCH, 1, SeqCst);
        if atomic_load(self.signal, HELPERS, SeqCst) > 0 {
            unsafe { rok_sync_wake(self.signal, EPOCH) };
        }
    }
}

fn start_monitor(pool: Pool) {
    unsafe {
        let watch: fn() + Send = || { monitor(pool); };
        let id = rok_thread_new_id();
        pool.monitor_id[0] = id;
        let h = rok_thread_spawn(watch, 0, id);
        if h == 0 {
            panic("task executor: cannot start the monitor thread");
        }
        _ = rok_thread_detach(h);
    }
}

/// Run pool worker `w` on a new thread, on its current lane.
fn start_worker(w: Worker) {
    unsafe {
        let id = rok_thread_new_id();
        w.tid[0] = id;
        let h = rok_thread_spawn(|| { pool_thread(w, id); }, 0, id);
        if h == 0 {
            panic("task executor: cannot start a worker thread");
        }
        _ = rok_thread_detach(h);
    }
}

/// A pool thread (`id`): runs worker `w`; once it was handed on and has
/// finished as the orphan, it waits as a spare for the next handoff.
fn pool_thread(w: Worker, id: u64) {
    let next: Worker | none = w;
    while let k: Worker = next {
        unsafe { rok_lane_attach(k.lane[0]) };
        set_current(k);
        work(k, none);
        next = k.pool.spares.wait(id);
    }
}

/// Most threads beyond the workers at once (handed-on blocked threads
/// and spares); past it a blocked worker waits for its call.
const HANDOFF_MAX_THREADS: i32 = 512;
/// A spare idle this long exits.
const SPARE_KEEP_ALIVE_NS: i64 = 10_000_000_000;

/// One waiting spare: `word` goes 1 once `take` holds its worker.
struct Spare {
    word: GcBuf<i32>;
    take: GcBuf<Worker | none>;
    id: u64;
}

/// Pool threads beyond the workers: each handoff to a new thread adds
/// one (the blocked thread finishes as an orphan, then waits here); an
/// expired spare removes one.
struct Spares {
    lock: Mutex<i32>;
    /// Waiting spares, the latest last (under `lock`).
    idle: List<Spare>;
    /// Threads beyond the workers (under `lock`).
    extra: GcBuf<i32>;
}

unsafe impl Send for Spares {}
unsafe impl Sync for Spares {}

impl Spares {
    const fn new() -> Spares {
        unsafe { Spares { lock: Mutex::new(0), idle: List::new(), extra: buf_new(1) } }
    }

    /// Run `w` on a spare, else on a new thread (the monitor, after
    /// `room`; only it takes spares).
    fn give(self, w: Worker) {
        unsafe {
            let spare: Spare | none = none;
            // Handed under the lock: an expiring spare sees it there.
            using g = self.lock.lock() {
                spare = self.idle.pop();
                if let s: Spare = spare {
                    w.tid[0] = s.id;
                    s.take[0] = w;
                    atomic_xchg(s.word, 0, 1, SeqCst);
                } else {
                    self.extra[0] += 1;
                }
            }
            if let s: Spare = spare {
                rok_sync_wake(s.word, 0);
            } else {
                start_worker(w);
            }
        }
    }

    /// Whether a handoff can find a thread: a spare, or room under the
    /// cap.
    fn room(self) -> bool {
        using g = self.lock.lock() {
            return self.idle.len() > 0 || unsafe { self.extra[0] } < HANDOFF_MAX_THREADS;
        }
    }

    /// Wait as spare `id` for a worker; `none` after the keep-alive.
    fn wait(self, id: u64) -> Worker | none {
        unsafe {
            let me = Spare { word: buf_new(1), take: buf_new(1), id };
            using g = self.lock.lock() { self.idle.push(me); }
            let until = now_ns() + SPARE_KEEP_ALIVE_NS;
            loop {
                let left = until - now_ns();
                if left > 0 {
                    rok_sync_wait(me.word, 0, 0, left);
                }
                using g = self.lock.lock() {
                    if atomic_load(me.word, 0, SeqCst) == 1 {
                        return me.take[0];
                    }
                    if now_ns() >= until {
                        self.drop_idle(me.word);
                        self.extra[0] -= 1;
                        return none;
                    }
                }
            }
        }
    }

    /// Remove the idle spare waiting on `word` (under `lock`).
    const fn drop_idle(self, word: GcBuf<i32>) {
        for i in 0..self.idle.len() {
            if buf_same(self.idle[i].word, word) {
                self.idle.remove(i);
                return;
            }
        }
    }

    /// After a failed REPL cell (`hook_restart`): spares that are gone
    /// no longer count.
    fn forget_lost(self) {
        unsafe {
            using g = self.lock.lock() {
                let i = self.idle.len();
                while i > 0 {
                    i -= 1;
                    if rok_thread_lost(self.idle[i].id) != 0 {
                        self.idle.remove(i);
                        self.extra[0] -= 1;
                    }
                }
            }
        }
    }
}

/// The monitor (706 §7.6.7): a worker whose lane stays blocked across a
/// scan goes to a new thread. Scans every tick while some lane blocks;
/// after 20 quiet ones it sleeps until a lane blocks.
fn monitor(pool: Pool) {
    unsafe {
        let quiet = 0;
        rok_session_enter();
        loop {
            rok_session_pass();
            let any = false;
            for w in pool.workers {
                let tick = rok_lane_blocked(w.lane[0]);
                if tick >= 0 {
                    any = true;
                    if tick == w.seen[0] && atomic_load(w.locals, 0, SeqCst) == 0 {
                        hand_on(w, tick);
                        w.seen[0] = -1;
                        continue;
                    }
                }
                w.seen[0] = tick;
            }
            quiet = if any { 0 } else { quiet + 1 };
            rok_session_leave();
            rok_lane_pause(if quiet >= 20 { 1 } else { 0 });
            rok_session_enter();
        }
    }
}

/// Move pool worker `w`, blocked in the call of `tick`, to a spare or a
/// new thread; its old thread gets an orphan guest polling the same
/// task. At the thread cap it stays blocked.
fn hand_on(w: Worker, tick: i64) {
    unsafe {
        if !w.pool.spares.room() {
            return;
        }
        let heir = new_worker(w.pool, 0, true, true);
        // Stable: the blocked thread is inside that task's poll.
        heir.running[0] = w.running[0];
        let cell: GcBuf<Worker> = buf_new(1);
        cell[0] = heir;
        if rok_lane_take(w.lane[0], tick, cell) == 0 {
            return;
        }
        w.lane[0] = rok_lane_new();
        w.running[0] = none;
        w.pool.spares.give(w);
    }
}

/// Wake `w` if it sleeps, as a searcher; whether it did.
fn wake_worker(w: Worker) -> bool {
    if atomic_load(w.sleep, 0, SeqCst) == ASLEEP && atomic_cas(w.sleep, 0, ASLEEP, WOKEN, SeqCst, SeqCst) == ASLEEP {
        atomic_add(w.pool.signal, SEARCHING, 1, SeqCst);
        unsafe { rok_sync_wake(w.sleep, 0) };
        return true;
    }
    false
}

fn current() -> Worker | none {
    unsafe {
        if rok_task_worker_present() == 0 {
            return none;
        }
        (rok_task_worker_get())[0]
    }
}

fn current_worker() -> Worker {
    current() ?? panic("no task executor is running: await inside `async fn main` or `task::block_on`")
}

fn set_current(w: Worker) {
    unsafe {
        let cell: GcBuf<Worker> = buf_new(1);
        cell[0] = w;
        rok_task_worker_set(cell);
    }
}

fn schedule(t: TaskRef) {
    unsafe {
        let pool = executor();
        if let h: Worker = t.home[0] {
            push(h.local, t);
            _ = wake_worker(h);
            pool.wake_helpers();
            return;
        }
        match current() {
            // Only the owner pushes to its deque.
            w: Worker => if w.guest {
                push(pool.injector, t);
            } else {
                let boxed: GcBuf<TaskRef> = buf_new(1);
                boxed[0] = t;
                rok_deque_push(w.deque, boxed);
            },
            none => push(pool.injector, t),
        }
        pool.notify();
    }
}

/// The oldest task of deque `d`, for `w`.
fn steal(w: Worker, d: GcBuf<GcBuf<TaskRef>>) -> TaskRef | none {
    unsafe {
        if rok_deque_steal(d, w.stolen, 0) == 0 {
            return none;
        }
        w.stolen[0][0]
    }
}

/// The next task for `w`: its local queue, its deque, the injector,
/// then the pool threads' deques.
fn find_task(w: Worker) -> TaskRef | none {
    // Solo: the guest is the only worker; half the time the injector goes
    // first, so tasks looping on `yield_now` in one queue do not starve
    // the other.
    if w.pool.solo && next_rand(w) % 2u64 == 0u64 {
        if let t: TaskRef = pop_front(w.pool.injector) {
            return t;
        }
    }
    if let t: TaskRef = pop_front(w.local) {
        return t;
    }
    if !w.guest {
        if let t: TaskRef = steal(w, w.deque) {
            return t;
        }
    }
    let pool = w.pool;
    if let t: TaskRef = pop_front(pool.injector) {
        return t;
    }
    // Victims round-robin from a random one (spec 7.6.4), so idle
    // workers do not all hit the same deque first.
    let n = pool.workers();
    if n == 0 {
        return none;
    }
    let start = (next_rand(w) % n as u64) as usize;
    for k in 0..n {
        let other = pool.workers[(start + k) % n];
        if !buf_same(other.deque, w.deque) {
            if let t: TaskRef = steal(w, other.deque) {
                return t;
            }
        }
    }
    none
}

/// Poll `t` on this thread's worker.
fn run(t: TaskRef) {
    unsafe {
        if atomic_cas(t.state, 0, SCHEDULED, RUNNING, SeqCst, SeqCst) != SCHEDULED {
            return;
        }
        // A cancelled task is polled once more: its `await` sees the flag
        // and leaves the body through its cleanups. Only a poll that began
        // after the cancel saw the flag; one cancelled while it ran (`cancel`
        // then marks it NOTIFIED) is polled again below, else the task would
        // finish without running its `finally` / `using` cleanups. A cleanup
        // that awaits keeps it polled until the cleanup ends.
        let cancelled = is_cancelled(t);
        if cancelled && t.state[9] == 0 {
            // Cancelled before its first poll: it never runs (no result).
            atomic_xchg(t.state, 4, 1, SeqCst);
            finish(t);
            return;
        }
        t.state[9] = 1;
        t.state[7] = 0;
        let poll = t.poll[0];
        let ctx = Context::from_waker(Waker { task: t });
        // `help_until` runs tasks inside a task's poll: restore the outer
        // one, on the orphan if the worker was handed on meanwhile.
        let w = current_worker();
        let outer = w.running[0];
        w.running[0] = t;
        // Blocking calls of the poll may hand the worker on (706 §7.6.7).
        let armed = rok_lane_arm(1);
        let ready = poll(ctx);
        _ = rok_lane_arm(armed);
        // The worker may have been handed on: this thread's guest held
        // what the poll's `spawn_local`s made since.
        let now = current_worker();
        now.running[0] = outer;
        if outer is none {
            if w.guest { release_lent(w); }
            if now.guest && !buf_same(now.locals, w.locals) { release_lent(now); }
        }
        if ready || (cancelled && t.state[7] == 0) {
            if !ready {
                // Ended without a result (no cancellation point reached).
                atomic_xchg(t.state, 4, 1, SeqCst);
            }
            finish(t);
        } else if atomic_cas(t.state, 0, RUNNING, IDLE, SeqCst, SeqCst) != RUNNING {
            // Woken while it ran.
            atomic_xchg(t.state, 0, SCHEDULED, SeqCst);
            schedule(t);
        }
    }
}

/// Is the task polling with `ctx` cancelled? (2.18.4 cancellation
/// points.) A true answer means the caller leaves: the cancelled task (or
/// `select` proxy) is marked `unwinding`. False while the task runs the
/// cleanups of its cancel: an `await` there completes.
pub(pkg) fn cancel_requested(ctx: Context) -> bool {
    match cancel_source(ctx.waker.task) {
        t: TaskRef => unsafe {
            if t.state[7] != 0 {
                return false;
            }
            atomic_xchg(t.state, 4, 1, SeqCst);
            true
        },
        none => false,
    }
}

/// The compiler's cancellation point in an `await` (2.18.4): like
/// `cancel_requested`, but none fires while a frame of the task runs the
/// cleanups of its own cancel, so awaits inside `finally` / `using`
/// complete. A true answer starts those cleanups.
#[lang("cancel_point_fn")]
pub(pkg) fn cancel_point(ctx: Context) -> bool {
    match cancel_source(ctx.waker.task) {
        t: TaskRef => unsafe {
            if t.state[7] != 0 {
                return false;
            }
            atomic_xchg(t.state, 4, 1, SeqCst);
            t.state[7] = 1;
            true
        },
        none => false,
    }
}

/// `unwinding` for the `await` after a ready poll: false while a frame of
/// the task runs its cleanups (a helper it awaits keeps its values). A
/// true answer starts the caller's cleanups.
#[lang("cancel_left_fn")]
pub(pkg) fn cancel_left(ctx: Context) -> bool {
    unsafe {
        let t = cleanup_task(ctx);
        if t.state[7] != 0 || !unwinding(ctx) {
            return false;
        }
        t.state[7] = 1;
        true
    }
}

/// A frame left by the cancel is about to poll inside its cleanups.
#[lang("cleanup_running_fn")]
pub(pkg) fn cleanup_running(ctx: Context) {
    unsafe { cleanup_task(ctx).state[7] = 1; }
}

/// A frame left by the cancel finished its cleanups.
#[lang("cleanup_done_fn")]
pub(pkg) fn cleanup_done(ctx: Context) {
    unsafe { cleanup_task(ctx).state[7] = 0; }
}

/// The task whose `cleaning` flag covers `ctx`: the cancelled one.
fn cleanup_task(ctx: Context) -> TaskRef {
    match cancel_source(ctx.waker.task) {
        t: TaskRef => t,
        none => ctx.waker.task,
    }
}

/// Whether a future that just returned `Ready` with `ctx` may have left
/// because of a cancel (its value is then a placeholder): the `await`
/// after a ready poll checks this, not the bare flag, so a value a
/// hand-written future handed over (a message, a guard) is kept when the
/// cancel lands meanwhile - the next cancellation point leaves.
pub(pkg) fn unwinding(ctx: Context) -> bool {
    unsafe {
        let t = ctx.waker.task;
        if atomic_load(t.state, 4, SeqCst) != 0 {
            return true;
        }
        t.state[3] != 0 && unwinding(Context::from_waker(t.up[0]))
    }
}

/// The cancelled task `t` answers to: itself, or (a `select` proxy) its
/// parent's chain.
fn cancel_source(t: TaskRef) -> TaskRef | none {
    unsafe {
        if atomic_load(t.state, 1, SeqCst) != 0 {
            return t;
        }
        if t.state[3] == 0 {
            return none;
        }
        cancel_source(t.up[0].task)
    }
}

/// Wake every due timer; the nanoseconds to the next one (-1: none).
/// The wakes happen under the lock, so two threads firing at once queue
/// their tasks in deadline order too (707 §7.7.4): one that popped an
/// earlier deadline cannot be overtaken between its pop and its wake.
fn fire_timers(pool: Pool) -> i64 {
    let fired = false;
    let next: i64 = -1;
    using g = pool.timers.lock() {
        let heap = g.get();
        let now = now_ns();
        while let tm: Timer = heap.peek() {
            if tm.at > now {
                next = tm.at - now;
                break;
            }
            heap.pop();
            tm.who.wake();
            fired = true;
        }
    }
    if fired {
        return 0;
    }
    next
}

/// After `ran + 1` task runs in a row: every 32nd fires the due timers.
/// Without it a worker that always finds a task (tasks looping on
/// `yield_now`) never fires one, and every `sleep` waits forever.
fn timers_while_busy(pool: Pool, ran: i64) -> i64 {
    if ran < 31 {
        return ran + 1;
    }
    _ = fire_timers(pool);
    0
}

fn add_timer(deadline: i64, w: Waker) {
    let pool = executor();
    atomic_xchg(w.task.state, 2, 1, SeqCst);
    using g = pool.timers.lock() {
        g.get().push(Timer { at: deadline, who: w });
    }
    // A sleeping worker recomputes how long to sleep.
    pool.wake_helpers();
    for k in pool.workers {
        if wake_worker(k) {
            return;
        }
    }
}

/// Drop cancelled task `t`'s timers, lazily: a finished task's timer
/// wakes nobody, and once the cancelled tasks since the last sweep reach
/// half the heap, one O(heap) sweep drops every finished task's timers
/// (amortized O(1) per cancel).
fn remove_timers(t: TaskRef) {
    unsafe {
        let pool = executor();
        using g = pool.timers.lock() {
            let heap = g.get();
            pool.dead[0] += 1;
            if pool.dead[0] * 2 >= heap.len() {
                heap.retain(|tm: Timer| !is_done(tm.who.task));
                pool.dead[0] = 0;
            }
        }
    }
}

/// Run tasks on `w` until `main` and its other local tasks are done
/// (`none`: forever, or for an orphan until its local tasks are).
fn work(w: Worker, main: TaskRef | none) {
    let pool = w.pool;
    let ran: i64 = 0;
    unsafe { rok_session_enter() };
    loop {
        unsafe { rok_session_pass() };
        // Handed on during a poll: go on as the orphan.
        w = current_worker();
        if (w.orphan && atomic_load(w.locals, 0, SeqCst) == 0) || (main is TaskRef && guest_done(w)) {
            awake(w, false);
            unsafe { rok_session_leave() };
            return;
        }
        if let t: TaskRef = find_task(w) {
            awake(w, true);
            run(t);
            ran = timers_while_busy(pool, ran);
            continue;
        }
        let next = fire_timers(pool);
        if next == 0 {
            continue;
        }
        awake(w, false);
        // Raise the sleep flag, look once more (a push after this sees
        // the flag), then sleep until woken or the next timer.
        atomic_xchg(w.sleep, 0, ASLEEP, SeqCst);
        if let t: TaskRef = find_task(w) {
            awake(w, true);
            run(t);
            continue;
        }
        let done = main is TaskRef && guest_done(w);
        // The timers again: one added after the flag went up wakes us,
        // one added before is seen here.
        next = fire_timers(pool);
        if next == 0 || done {
            awake(w, false);
            continue;
        }
        pool.idle(w);
        unsafe { rok_session_leave() };
        if pool.solo {
            solo_wait(next);
        } else {
            unsafe { rok_sync_wait(w.sleep, 0, ASLEEP, next) };
        }
        unsafe { rok_session_enter() };
        // Timed out (or a spurious wake); a wake leaves it `WOKEN`, searching.
        atomic_cas(w.sleep, 0, ASLEEP, 0, SeqCst, SeqCst);
    }
}

/// `w` stops sleeping or searching. A worker a push woke (`WOKEN`)
/// searches until this: pushes meanwhile wake nobody more, and the last
/// searcher to find a task (`found`) wakes the next one, for the rest.
fn awake(w: Worker, found: bool) {
    if atomic_load(w.sleep, 0, SeqCst) != 0 && atomic_xchg(w.sleep, 0, 0, SeqCst) == WOKEN {
        if atomic_add(w.pool.signal, SEARCHING, -1, SeqCst) == 1 && found {
            w.pool.notify();
        }
    }
}

fn new_task(poll: fn(Context) -> bool, local: Worker | none) -> TaskRef {
    let t = make_task(poll, local);
    schedule(t);
    t
}

/// `new_task` without scheduling it.
fn make_task(poll: fn(Context) -> bool, local: Worker | none) -> TaskRef {
    unsafe {
        let pool = executor();
        let home = pool.no_home;
        let state: GcBuf<i32> = buf_new(10);
        state[0] = SCHEDULED;
        if let w: Worker = local {
            home = buf_new(1);
            home[0] = w;
            state[5] = 1;
            atomic_add(w.locals, 0, 1, SeqCst);
        } else if pool.pinned && !pool.solo {
            home = buf_new(1);
            home[0] = pool.home_for();
        }
        let p: GcBuf<fn(Context) -> bool> = buf_new(1);
        p[0] = poll;
        let t = TaskRef {
            state: state,
            poll: p,
            joiners: unsafe { Mutex::new_unshared(List::<Waker>::new()) },
            parked: List::new(),
            home: home,
            id: NEXT_TASK_ID.fetch_add(1),
            up: pool.no_up,
        };
        t
    }
}

/// The poll function of a task running `fut`, storing its output in
/// `slot`.
const fn poll_fn<F: Future>(fut: F, slot: GcBuf<F::Output>) -> fn(Context) -> bool {
    unsafe {
        let cell: GcBuf<F> = buf_new(1);
        cell[0] = fut;
        |ctx: Context| -> bool {
            let f = cell[0];
            let c = ctx;
            let r = f.poll(ref c);
            cell[0] = f;
            if let Poll::Ready(v) = r {
                slot[0] = hand_over::<F::Output>(v);
                return true;
            }
            false
        }
    }
}

/// A guest's `main` and the `spawn_local` tasks pinned to it are done
/// (`main` is one of its local tasks).
fn guest_done(w: Worker) -> bool {
    atomic_load(w.locals, 0, SeqCst) == 0
}

/// Run `main` as a task local to this thread, which works as a guest of
/// the executor until it is done, and so are the `spawn_local` tasks
/// pinned to it: they may hold values that are not `Send`, so no other
/// thread can take them over. Tasks it spawned keep running.
fn run_guest(main: fn(Context) -> bool) {
    if current() is Worker {
        panic("task::block_on inside a running task (it would deadlock); use `await`");
    }
    let w = new_worker(executor(), 0, true, false);
    set_current(w);
    work(w, new_task(main, w));
    unsafe { rok_task_worker_clear() };
}

/// Run `fut` to completion from synchronous code (2.20.6). It returns
/// once the `spawn_local` tasks pinned to this thread are done too.
pub fn block_on<F: Future>(fut: F) -> F::Output {
    unsafe {
        let slot: GcBuf<F::Output> = buf_new(1);
        run_guest(poll_fn(fut, slot));
        slot[0]
    }
}

/// `block_on` for a throwing `async` body: its error is thrown here.
pub fn try_block_on<T, E>(fut: TryAsyncFuture<T, E>) throws (E) -> T {
    unsafe {
        let cell: GcBuf<TryAsyncFuture<T, E>> = buf_new(1);
        cell[0] = fut;
        let out: GcBuf<T> = buf_new(1);
        let err: GcBuf<E> = buf_new(1);
        let failed: GcBuf<bool> = buf_new(1);
        run_guest(|ctx: Context| -> bool {
            let f = cell[0];
            let c = ctx;
            let r = try f.poll(ref c) catch e {
                err[0] = hand_over::<E>(e);
                failed[0] = true;
                return true;
            };
            cell[0] = f;
            if let Poll::Ready(v) = r {
                out[0] = hand_over::<T>(v);
                return true;
            }
            false
        });
        if failed[0] {
            throw err[0];
        }
        out[0]
    }
}

// A WebAssembly component's async exports (stdlib 1.8) run on the host's
// event loop: each export call and event enters, runs what is runnable
// and returns to the host, which calls back with the next event. The
// thread works as one guest worker for all of them, kept between turns.

static HOST: GcBuf<Worker | none> = unsafe { buf_new(1) };
/// Between `host_enter` and `host_leave`.
static HOSTED: GcBuf<bool> = unsafe { buf_new(1) };

/// This thread works as the host loop's guest worker (`host_leave`
/// ends it): tasks spawned with `spawn_local` belong to that worker.
#[internal]
pub fn host_enter() {
    unsafe {
        let pool = executor();
        if !pool.solo {
            panic("task::host_enter: only a solo executor (no threads) runs on a host's loop");
        }
        let w = match HOST[0] {
            w: Worker => w,
            none => {
                let w = new_worker(pool, 0, true, false);
                HOST[0] = w;
                w
            }
        };
        set_current(w);
        HOSTED[0] = true;
    }
}

/// Ends `host_enter`; anywhere else (in `block_on`, a task) it panics.
#[internal]
#[track_caller]
pub fn host_leave() {
    unsafe {
        if !HOSTED[0] {
            panic("task::host_leave without task::host_enter: only a WebAssembly component's export loop enters and leaves the host's executor");
        }
        HOSTED[0] = false;
        rok_task_worker_clear();
    }
}

/// One turn of the host's loop (inside `host_enter`): every runnable
/// task and due timer, until none is left; then the wait for sockets and
/// timers, at most `slice()` ns (< 0: until nothing is left to wait for;
/// 0: none), and what it woke. Whether a socket or timer still waits.
#[internal]
pub fn host_run(slice: fn() -> i64) -> bool {
    let w = current_worker();
    let pool = w.pool;
    let waited = false;
    loop {
        if let t: TaskRef = find_task(w) {
            run(t);
            continue;
        }
        // Ready sockets, without waiting.
        solo_wait(0);
        if let t: TaskRef = find_task(w) {
            run(t);
            continue;
        }
        let next = fire_timers(pool);
        if next == 0 {
            continue;
        }
        let armed = io_armed();
        if next < 0 && !armed {
            return false;
        }
        let s = if waited { 0 } else { slice() };
        if s == 0 {
            return true;
        }
        if s > 0 {
            waited = true;
            next = if next < 0 { s } else { next.min(s) };
        }
        solo_wait(next);
    }
}

/// Workers of the executor this thread runs tasks on (1 outside one,
/// and without threads, where the one thread runs every task).
pub fn worker_count() -> usize {
    if current() is none || executor().solo {
        return 1;
    }
    executor().workers()
}

/// Online CPUs (the default pool size).
pub fn cpu_count() -> usize {
    unsafe { rok_cpu_count() }.max(1)
}

// sync jobs on the executor (`par`)

struct RunOnce {
    f: fn() -> bool;
}

unsafe impl Send for RunOnce {}

impl Future for RunOnce {
    type Output = bool;
    const fn poll(ref self, ref ctx: Context) -> Poll<bool> {
        Poll::Ready((self.f)())
    }
}

/// Run `f()` on a worker: this thread if it is one, else this thread as
/// a guest.
pub(pkg) fn in_pool(f: fn() -> bool) -> bool {
    if current() is Worker {
        return f();
    }
    block_on(RunOnce { f: f })
}

/// `f` as a task (`par`'s fork).
pub(pkg) fn fork_job(f: fn() + Send) -> Task<bool> {
    spawn(RunOnce { f: || { f(); true } })
}

/// Block this worker until `t` is done, running other tasks meanwhile
/// (so a fork-join on a busy executor cannot deadlock).
pub(pkg) fn help_until(t: Task<bool>) {
    let pool = current_worker().pool;
    // Its own waits are no blocking calls of the poll it runs in.
    let armed = unsafe { rok_lane_arm(0) };
    atomic_add(pool.signal, HELPERS, 1, SeqCst);
    let ran: i64 = 0;
    while !is_done(t.task) {
        // Re-read: the worker may be handed on during a run.
        let w = current_worker();
        let epoch = atomic_load(pool.signal, EPOCH, SeqCst);
        if let other: TaskRef = find_task(w) {
            run(other);
            ran = timers_while_busy(pool, ran);
            continue;
        }
        let next = fire_timers(pool);
        if next == 0 {
            continue;
        }
        // Woken by the next push or finished task (`wake_helpers`).
        if !is_done(t.task) {
            unsafe { rok_sync_wait(pool.signal, EPOCH, epoch, next) };
        }
    }
    atomic_add(pool.signal, HELPERS, -1, SeqCst);
    unsafe { rok_lane_arm(armed) };
}

/// A spawned task; `await` it for its result (2.18.2).
pub struct Task<T> {
    task: TaskRef;
    slot: GcBuf<T>;
}

impl<T> Debug for Task<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Task") }
}

unsafe impl<T: Send> Send for Task<T> {}

impl<T> Task<T> {
    /// Whether the task has finished, with a result or cancelled.
    pub fn is_finished(self) -> bool { is_done(self.task) }

    /// This task's id (what `task::id()` returns inside it).
    pub const fn id(self) -> TaskId { TaskId { id: self.task.id } }

    /// Ask the task to stop (2.18.4): it is woken, its current `await`
    /// leaves the body (running the `finally` / `using` cleanups on the
    /// way out) and it finishes without a result; one not yet polled
    /// never runs. Awaiting it then panics; use `try await t.join()` to
    /// see `CancellationError`. A task that reaches no cancellation point
    /// after the cancel finishes normally, with its result.
    pub fn cancel(self) {
        cancel_by(self.task, BY_CANCEL);
    }

    /// Whether `cancel` was called on the task.
    pub fn is_cancelled(self) -> bool { is_cancelled(self.task) }

    /// Await the result, throwing `CancellationError` for a cancelled
    /// task.
    pub const fn join(self) -> Join<T> {
        Join { task: self }
    }
}

impl<T> Future for Task<T> {
    type Output = T;
    fn poll(ref self, ref ctx: Context) -> Poll<T> {
        unsafe {
            if !join_later(self.task, ctx.waker) {
                return Poll::Pending;
            }
            if no_result(self.task) {
                panic(cancelled_message(self.task));
            }
            Poll::Ready(task_result(self))
        }
    }
}

/// Cancel `t`, noting who did (the first cancel's cause stands).
fn cancel_by(t: TaskRef, cause: i32) {
    unsafe {
        if atomic_load(t.state, 1, SeqCst) == 0 {
            t.state[8] = cause;
        }
    }
    atomic_xchg(t.state, 1, 1, SeqCst);
    wake_task(t);
}

/// The panic of an `await` on a task that left by its cancel.
fn cancelled_message(t: TaskRef) -> str {
    let cause = unsafe { t.state[8] };
    if cause == BY_RACE {
        return "awaited a task cancelled by `task::race`; use `try await t.join()`";
    }
    if cause == BY_TIMEOUT {
        return "awaited a task cancelled by `task::timeout`; use `try await t.join()`";
    }
    "awaited a cancelled task (use `try await t.join()`)"
}

/// A finished task's result for one joiner: a copy of its own once the
/// `Task` was handed on, as copies of it may each await it on other
/// threads; else the result itself (one thread's copies share it).
fn task_result<T>(t: Task<T>) -> T {
    unsafe {
        if atomic_load(t.task.state, 6, SeqCst) != 0 {
            return hand_over::<T>(t.slot[0]);
        }
        t.slot[0]
    }
}

// A hand-off of a `Task` (`Frozen::get`, a channel, a lock) or a `par`
// item holding one marks it: its joiners then copy the result.
impl<T> Transfer for Task<T> {
    const fn transfer_copy(self, m: Memo) -> Task<T> {
        handed(self)
    }

    const fn transfer_keep(self, m: Memo) -> Task<T> {
        handed(self)
    }

    const fn transfer_visit(self, m: Memo) -> Task<T> {
        handed(self)
    }
}

const fn handed<T>(t: Task<T>) -> Task<T> {
    unsafe { atomic_xchg(t.task.state, 6, 1, SeqCst) };
    t
}

/// `Task::join`.
#[must_use("future is never awaited, so its body never runs: write `await {}`")]
pub struct Join<T> {
    task: Task<T>;
}

impl<T> Debug for Join<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Join") }
}

impl<T> Join<T> {
    /// One step of `join`: `Ready` with the result once the task finished,
    /// `Pending` before. Throws `CancellationError` for a cancelled task.
    pub fn poll(ref self, ref ctx: Context) throws (CancellationError) -> Poll<T> {
        unsafe {
            if !join_later(self.task.task, ctx.waker) {
                return Poll::Pending;
            }
            if no_result(self.task.task) {
                throw CancellationError;
            }
            Poll::Ready(task_result(self.task))
        }
    }
}

/// Identifies a task for as long as the process runs (ids are never
/// reused): `Task::id`, `task::id()`. Not in spec 2.18 (tokio's
/// `task::Id`).
pub struct TaskId {
    id: u64;
}

static NEXT_TASK_ID: Atomic<u64> = Atomic::new(1);

impl TaskId {
    /// The id as a number, unique for the process's run.
    pub const fn as_u64(self) -> u64 { self.id }
}

impl PartialEq for TaskId {
    const fn eq(self, rhs: TaskId) -> bool { self.id == rhs.id }
    const fn ne(self, rhs: TaskId) -> bool { self.id != rhs.id }
}

impl Eq for TaskId {}

impl Hash for TaskId {
    const fn hash<H: Hasher>(self, ref h: H) { self.id.hash(ref h) }
}

impl Display for TaskId {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self.id, ref f) }
}

impl Debug for TaskId {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"TaskId({self.id})") }
}

/// The running task's id; panics outside a task (`current_id`).
#[track_caller]
pub fn id() -> TaskId {
    current_id() ?? panic("task::id: called outside a task; use `task::current_id()`, which is `none` there")
}

/// The running task's id, or `none` outside a task (sync code, a
/// `spawn_blocking` thread).
pub fn current_id() -> TaskId | none {
    unsafe {
        let w = current()?;
        let t = w.running[0]?;
        TaskId { id: t.id }
    }
}

/// A task was cancelled (2.18.4).
#[derive(Clone, PartialEq, Eq)]
pub struct CancellationError;

impl CancellationError {
    /// What went wrong, for display.
    pub const fn message(self) -> str { "task cancelled" }
}

impl Display for CancellationError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}

impl Debug for CancellationError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("CancellationError") }
}

impl Error for CancellationError {}

/// Run `fut` as a new task on any worker, concurrently with the
/// spawner (2.18.1). Needs a running executor (inside `async fn main` /
/// `block_on`). The task gets its own copy of every collection `fut`
/// holds, what its coroutine captured included (2.13.9): the spawner
/// keeps the originals.
#[track_caller]
pub fn spawn<F: Future + Send>(fut: F) -> Task<F::Output> where F::Output: Send {
    unsafe {
        _ = current_worker();
        let slot: GcBuf<F::Output> = buf_new(1);
        let t = new_task(poll_fn(hand_over::<F>(fut), slot), none);
        Task { task: t, slot: slot }
    }
}

/// `spawn` of a future made right at the call that captures nothing a
/// hand-off copies (no collection, future or `[ref x]` cell): no other
/// handle has its frame and there is nothing to copy (`rokc_hir` picks
/// it for `task::spawn(async { .. })` and `task::spawn(f(..))`).
#[track_caller]
pub(pkg) fn spawn_plain<F: Future + Send>(fut: F) -> Task<F::Output> where F::Output: Send {
    unsafe {
        _ = current_worker();
        let slot: GcBuf<F::Output> = buf_new(1);
        let t = new_task(poll_fn(fut, slot), none);
        Task { task: t, slot: slot }
    }
}

/// Where a `spawn_local` from `w` lives: `w`, unless `w` is a guest
/// polling a task that is not its own. A guest leaves once its own tasks
/// are done, so `block_on` would wait for that task's locals too (a
/// connection's reader and writer: forever); they go to a pool worker,
/// the same one for every local of that poll (they share its values).
fn local_home(w: Worker) -> Worker {
    if !w.guest || w.pool.solo || w.pool.workers() == 0 {
        return w;
    }
    unsafe {
        if let t: TaskRef = w.running[0] {
            if let h: Worker = t.home[0] {
                if buf_same(h.locals, w.locals) { return w; }
            }
            if w.lend[0] > 0 && w.lend[0] <= w.pool.workers() {
                return w.pool.workers[w.lend[0] - 1];
            }
            let l = w.pool.home_for();
            w.lend[0] = l.index + 1;
            return l;
        }
    }
    w
}

/// Start the locals `w` held while it polled a task it does not own.
fn release_lent(w: Worker) {
    unsafe {
        w.lend[0] = 0;
        while let t: TaskRef = pop_front(w.lent) {
            schedule(t);
        }
    }
}

/// Run `fut` as a new task on this worker only (it need not be `Send`).
/// From a task a `block_on` thread happens to poll, that is one pool
/// worker, and the task starts once that poll ends.
pub fn spawn_local<F: Future>(fut: F) -> Task<F::Output> {
    unsafe {
        let w = current_worker();
        let h = local_home(w);
        let slot: GcBuf<F::Output> = buf_new(1);
        let t = make_task(poll_fn(fut, slot), h);
        if buf_same(h.locals, w.locals) {
            schedule(t);
        } else {
            push(w.lent, t);
        }
        Task { task: t, slot: slot }
    }
}

/// Every task's result, in order (2.18.1).
pub async fn join<I: IntoIterator<Item = Task<T>>, T>(tasks: I) -> List<T> {
    let out: List<T> = List::new();
    for t in tasks {
        out.push(await t);
    }
    out
}

/// The result of whichever task finishes first (2.18.1); ties go to the
/// earlier one. The others are cancelled (by the time `race` returns
/// they may still run their cleanups), and so are all of them when the
/// awaiting task is. Panics on no tasks.
pub async fn race<I: IntoIterator<Item = Task<T>>, T>(tasks: I) -> T {
    let list: List<Task<T>> = List::new();
    for t in tasks {
        list.push(t);
    }
    if list.len() == 0 {
        panic("task::race of no tasks");
    }
    let won: usize = list.len();
    // The losers are cancelled however this ends, the awaiting task's
    // cancellation included.
    let _ = { won = await FirstDone { tasks: list }; } finally {
        for i in 0..list.len() {
            if i != won && !is_done(list[i].task) {
                cancel_by(list[i].task, BY_RACE);
            }
        }
    };
    task_result(list[won])
}

/// The first of `futs` to complete, with its index: `let (i, v) = await
/// task::select([a, b])` (refs-lang 4.12.9 names `select`; 2.18 gives no
/// signature). Unlike `race` the futures are not spawned: they run inside
/// the awaiting task, polled in list order (ties go to the lower index).
/// The futures share one type: `async { .. }` blocks with the same
/// output do (wrap differing outputs, `async { Msg::A(await a) }`).
/// Once one completes, every other one that has started is polled once
/// more as cancelled (its `await` leaves through `finally` / `using`, as
/// for `Task::cancel`) and dropped; one whose cleanups await goes on as a
/// task of its own until they end, and `select` does not wait for it.
/// Panics on no futures.
#[track_caller]
pub const fn select<I: IntoIterator<Item = F>, F: Future>(iter: I) -> SelectFuture<F> {
    unsafe {
        let futs: List<F> = List::new();
        for f in iter {
            futs.push(f);
        }
        if futs.len() == 0 {
            panic("task::select of no futures");
        }
        let started: GcBuf<bool> = buf_new(futs.len());
        let proxy: GcBuf<TaskRef | none> = buf_new(1);
        SelectFuture { futs: futs, started: started, proxy: proxy }
    }
}

/// The future `select` returns: `(index, output)` of the first future to
/// complete.
#[must_use("future is never awaited, so its body never runs: write `await {}`")]
pub struct SelectFuture<F> {
    futs: List<F>;
    started: GcBuf<bool>;
    /// The children's waker (`proxy_task`), made at the first poll: what
    /// they register (parking, timers) is dropped when `select` ends.
    proxy: GcBuf<TaskRef | none>;
}

impl<F> Debug for SelectFuture<F> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("SelectFuture") }
}

impl<F: Future> Future for SelectFuture<F> {
    type Output = (usize, F::Output);
    fn poll(ref self, ref ctx: Context) -> Poll<(usize, F::Output)> {
        unsafe {
            let p = match self.proxy[0] {
                t: TaskRef => t,
                none => {
                    let t = proxy_task(ctx.waker);
                    self.proxy[0] = t;
                    t
                }
            };
            let c = Context::from_waker(Waker { task: p });
            let n = self.futs.len();
            for i in 0..n {
                let f = self.futs[i];
                self.started[i] = true;
                let r = f.poll(ref c);
                self.futs[i] = f;
                if let Poll::Ready(v) = r {
                    self.cancel_others(i, p);
                    return Poll::Ready((i, v));
                }
            }
            Poll::Pending
        }
    }
}

impl<F: Future> SelectFuture<F> {
    /// Finish the proxy (its wakes stop) as cancelled, poll the started
    /// losers once with it (their cancellation path), then drop all it
    /// registered. A loser still in its cleanups runs them to the end as
    /// a cancelled local task.
    fn cancel_others(self, winner: usize, p: TaskRef) {
        unsafe {
            atomic_xchg(p.state, 0, DONE, SeqCst);
            atomic_xchg(p.state, 1, 1, SeqCst);
            let c = Context::from_waker(Waker { task: p });
            for i in 0..self.futs.len() {
                if i != winner && self.started[i] {
                    let f = self.futs[i];
                    p.state[7] = 0;
                    if let Poll::Pending = f.poll(ref c) {
                        if p.state[7] != 0 {
                            spawn_cleanup(f);
                        }
                    }
                }
            }
            finish_cancelled(p);
        }
    }
}

/// Run `fut`, a frame inside the cleanups of its cancel, to the end as a
/// cancelled local task nobody joins.
fn spawn_cleanup<F: Future>(fut: F) {
    unsafe {
        let w = current_worker();
        let h = local_home(w);
        let slot: GcBuf<F::Output> = buf_new(1);
        let t = make_task(poll_fn(fut, slot), h);
        t.state[1] = 1;
        t.state[4] = 1;
        t.state[9] = 1;
        if buf_same(h.locals, w.locals) {
            schedule(t);
        } else {
            push(w.lent, t);
        }
    }
}

/// A stand-in task for `select`'s children: never scheduled; its wakes
/// go to `parent` until it is done.
const fn proxy_task(parent: Waker) -> TaskRef {
    unsafe {
        let state: GcBuf<i32> = buf_new(10);
        state[3] = 1;
        state[5] = parent.task.state[5];
        let p: GcBuf<fn(Context) -> bool> = buf_new(1);
        p[0] = |ctx: Context| -> bool { true };
        let up: GcBuf<Waker> = buf_new(1);
        up[0] = parent;
        TaskRef {
            state: state,
            poll: p,
            joiners: unsafe { Mutex::new_unshared(List::<Waker>::new()) },
            parked: List::new(),
            home: parent.task.home,
            id: 0,
            up: up,
        }
    }
}

/// Drop a finished cancelled task's parking entries and timers.
fn finish_cancelled(t: TaskRef) {
    unpark_task(t);
    if atomic_load(t.state, 2, SeqCst) != 0 {
        remove_timers(t);
    }
}

/// Index of the first task to finish (`buffer_unordered`).
pub(pkg) const fn first_done<T>(tasks: List<Task<T>>) -> FirstDone<T> {
    FirstDone { tasks: tasks }
}

pub(pkg) struct FirstDone<T> {
    tasks: List<Task<T>>;
}

impl<T> Future for FirstDone<T> {
    type Output = usize;
    fn poll(ref self, ref ctx: Context) -> Poll<usize> {
        for i in 0..self.tasks.len() {
            if join_later(self.tasks[i].task, ctx.waker) {
                return Poll::Ready(i);
            }
        }
        Poll::Pending
    }
}

/// Completes once `dur` has passed since its first poll (2.18.1).
pub async fn sleep(dur: Duration) {
    await Sleep { deadline: now_ns() + dur.as_ns() };
}

/// Completes at `when`.
pub async fn sleep_until(when: Instant) {
    await Sleep { deadline: when.ns };
}

struct Sleep {
    deadline: i64;
}

impl Future for Sleep {
    type Output = ();
    fn poll(ref self, ref ctx: Context) -> Poll<()> {
        if now_ns() >= self.deadline {
            return Poll::Ready(());
        }
        add_timer(self.deadline, ctx.waker);
        Poll::Pending
    }
}

/// Let the other ready tasks run once (2.18.1).
pub async fn yield_now() {
    await YieldNow { yielded: false };
}

struct YieldNow {
    yielded: bool;
}

impl Future for YieldNow {
    type Output = ();
    fn poll(ref self, ref ctx: Context) -> Poll<()> {
        if self.yielded {
            return Poll::Ready(());
        }
        self.yielded = true;
        ctx.waker.wake();
        Poll::Pending
    }
}

/// `task`'s result, or `TimeoutError` once `dur` has passed since the
/// first poll (2.18.1): `try await task::timeout(d, t)`. On expiry the
/// task is cancelled (it may still run its cleanups when `timeout`
/// throws), and so it is when the awaiting task is.
pub async fn timeout<T>(dur: Duration, task: Task<T>) throws (TimeoutError) -> T {
    try {
        try await Timeout { task: task, deadline: now_ns() + dur.as_ns() }
    } finally {
        if !is_done(task.task) {
            cancel_by(task.task, BY_TIMEOUT);
        }
    }
}

struct Timeout<T> {
    task: Task<T>;
    deadline: i64;
}

impl<T> Timeout<T> {
    /// One step of `timeout`: `Ready` with the result once the task finished,
    /// `Pending` before the deadline. Throws `TimeoutError` once it passed.
    pub fn poll(ref self, ref ctx: Context) throws (TimeoutError) -> Poll<T> {
        unsafe {
            if join_later(self.task.task, ctx.waker) {
                return Poll::Ready(task_result(self.task));
            }
            if now_ns() >= self.deadline {
                throw TimeoutError;
            }
            add_timer(self.deadline, ctx.waker);
            Poll::Pending
        }
    }
}

/// `task::timeout` ran out.
#[derive(Clone, PartialEq, Eq)]
pub struct TimeoutError;

impl TimeoutError {
    /// What went wrong, for display.
    pub const fn message(self) -> str { "timed out" }
}

impl Display for TimeoutError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}

impl Debug for TimeoutError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TimeoutError") }
}

impl Error for TimeoutError {}

// parking: async waits on sync primitives and fds

/// Tasks waiting on a key (a primitive's GC address, or an fd's
/// `io_key`): `Mutex::lock_async`, `Receiver::recv_async`, socket I/O
/// park here; whoever may have made the key ready unparks it (708's
/// park / unpark at the task level). One process-wide table behind one
/// lock.
struct Parking {
    lock: Mutex<i32>;
    waiting: Dict<usize, List<Waker>>;
    /// Set by the first `park`: until then `unpark` takes no lock.
    used: Atomic<bool>;
}

// `waiting` is reached only under `lock`.
unsafe impl Sync for Parking {}

static PARKING: Parking = Parking {
    lock: Mutex::new(0),
    waiting: Dict::<usize, List<Waker>>::new(),
    used: Atomic::new(false),
};

/// Wake `waker` at the next `unpark(key)`. The entry goes at that
/// `unpark` or when the waker's task finishes (a cancelled task's wait).
pub(pkg) fn park(key: usize, waker: Waker) {
    let p = PARKING;
    p.used.store(true);
    using g = p.lock.lock() {
        match p.waiting.get(key) {
            l: List<Waker> => l.push(waker),
            none => {
                let l: List<Waker> = List::new();
                l.push(waker);
                p.waiting.insert(key, l);
            }
        }
        let ks = waker.task.parked;
        let known = false;
        for k in ks {
            if k == key { known = true; }
        }
        if !known {
            // Keys it was since unparked from, once in a while (a
            // long-lived task parking on many keys).
            if ks.len() >= 16 && ks.len() % 16 == 0 {
                let live: List<usize> = List::new();
                for k in ks {
                    if parked_on(p, k, waker.task) { live.push(k); }
                }
                ks.clear();
                for k in live { ks.push(k); }
            }
            ks.push(key);
        }
    }
}

/// Is `t` in `key`'s list? (Under `p.lock`.)
const fn parked_on(p: Parking, key: usize, t: TaskRef) -> bool {
    if let l: List<Waker> = p.waiting.get(key) {
        for w in l {
            if buf_same(w.task.state, t.state) { return true; }
        }
    }
    false
}

/// Drop finished task `t`'s parking entries.
fn unpark_task(t: TaskRef) {
    let p = PARKING;
    if t.parked.len() == 0 || !p.used.load() {
        return;
    }
    using g = p.lock.lock() {
        for k in t.parked {
            if let l: List<Waker> = p.waiting.get(k) {
                let rest: List<Waker> = List::new();
                for w in l {
                    if !buf_same(w.task.state, t.state) { rest.push(w); }
                }
                if rest.len() == 0 {
                    p.waiting.remove(k);
                } else {
                    p.waiting.insert(k, rest);
                }
            }
        }
        t.parked.clear();
    }
}

/// Parked wakers (all keys) plus pending timers of unfinished tasks: a
/// diagnostic (a cancelled task leaves none behind).
pub fn registrations() -> usize {
    let n: usize = 0;
    let p = PARKING;
    using g = p.lock.lock() {
        for l in p.waiting.values() {
            n += l.len();
        }
    }
    using g = executor().timers.lock() {
        for tm in g.get().iter() {
            if !is_done(tm.who.task) { n += 1; }
        }
    }
    n
}

/// Wake every task parked on `key` (cheap when no task ever parked).
pub(pkg) fn unpark(key: usize) {
    let p = PARKING;
    if !p.used.load() {
        return;
    }
    let woken: List<Waker> | none = none;
    using g = p.lock.lock() {
        woken = p.waiting.remove(key);
    }
    if let l: List<Waker> = woken {
        for w in l {
            w.wake();
        }
    }
}

// the I/O driver (707)

/// The parking key of `fd`'s read (`write == 0`) or write readiness:
/// odd, so never a GC address (8-aligned) at any pointer width.
const fn io_key(fd: i32, write: i32) -> usize {
    (fd as usize) * 4 + (write as usize) * 2 + 1
}

/// Wake every task waiting on `fd`'s readiness: after a `shutdown` or
/// a close, which may raise no poller event (stdlib 2.18.1).
#[internal]
pub fn wake_io(fd: i32) {
    unpark(io_key(fd, 0));
    unpark(io_key(fd, 1));
}

/// Start the driver thread once: it blocks in kqueue / epoll and
/// unparks the tasks waiting on each fd that became ready.
fn start_driver() {
    // Solo: the guest polls (`solo_wait`).
    if executor().solo {
        return;
    }
    let pool = executor();
    pool.driver.call_once(|| { spawn_driver(pool); });
}

fn spawn_driver(pool: Pool) {
    unsafe {
        let body: fn() + Send = || {
            let evs: GcBuf<i64> = buf_new(128);
            loop {
                let n = unsafe { rok_io_poll(evs, 128) };
                unsafe { rok_session_enter() };
                for i in 0..n {
                    let k = evs[i as usize];
                    unpark(io_key((k / 2) as i32, (k % 2) as i32));
                }
                unsafe { rok_session_leave() };
            }
        };
        let id = rok_thread_new_id();
        pool.driver_id[0] = id;
        let h = rok_thread_spawn(body, 0, id);
        if h == 0 {
            panic("task executor: cannot start the I/O driver thread");
        }
        _ = rok_thread_detach(h);
    }
}

/// After a failed REPL cell put the session back as it was before it
/// (`rok_session_restored`): pool threads that are gone start again on
/// their workers (none was polling a task then), and parked tasks look
/// again: one waiting on a socket watches it again (the runtime dropped
/// its poller's state), one waiting on a lock a gone thread held finds
/// it released.
extern "C" fn hook_restart() {
    unsafe {
        let pool = EXEC[0];
        // No threads to lose.
        if pool.solo {
            return;
        }
        for w in pool.workers {
            if rok_thread_lost(w.tid[0]) != 0 {
                w.running[0] = none;
                // A searcher that is gone searches no more.
                if atomic_xchg(w.sleep, 0, 0, SeqCst) == WOKEN {
                    atomic_add(pool.signal, SEARCHING, -1, SeqCst);
                }
                w.lane[0] = rok_lane_new();
                w.seen[0] = -1;
                start_worker(w);
            }
        }
        if rok_thread_lost(pool.monitor_id[0]) != 0 {
            start_monitor(pool);
        }
        if pool.driver_id[0] != 0 && rok_thread_lost(pool.driver_id[0]) != 0 {
            spawn_driver(pool);
        }
        pool.blocking.forget_lost();
        pool.spares.forget_lost();
        let p = PARKING;
        if p.used.load() {
            let keys: List<usize> = List::new();
            using g = p.lock.lock() {
                for k in p.waiting.keys() {
                    keys.push(k);
                }
            }
            for k in keys { unpark(k); }
        }
    }
}

/// Solo (WASI: `rok_cpu_count() == 0`): wait for the watched fds or `next`
/// ns (< 0: no limit) and unpark the ready ones.
#[cfg(target_os = "wasi")]
fn solo_wait(next: i64) {
    unsafe {
        let evs: GcBuf<i64> = buf_new(128);
        let n = rok_io_wait(evs, 128, next);
        for i in 0..n {
            let k = evs[i as usize];
            unpark(io_key((k / 2) as i32, (k % 2) as i32));
        }
    }
}

/// Only WASI targets run solo.
#[cfg(not(target_os = "wasi"))]
fn solo_wait(next: i64) {
    unsafe { rok_thread_sleep_ns(next) };
}

/// A socket is watched (only the solo executor watches them itself).
#[cfg(target_os = "wasi")]
fn io_armed() -> bool { unsafe { rok_io_armed() } != 0 }

#[cfg(not(target_os = "wasi"))]
const fn io_armed() -> bool { false }

/// Completes once `fd` may be readable (`await task::readable(fd)`
/// after a read hit `WouldBlock`); it may also complete spuriously, so
/// retry the operation in a loop.
#[internal]
pub const fn readable(fd: i32) -> IoReady {
    IoReady { fd: fd, write: 0, armed: false }
}

/// `readable` for writes.
#[internal]
pub const fn writable(fd: i32) -> IoReady {
    IoReady { fd: fd, write: 1, armed: false }
}

/// The future `readable` / `writable` return: completes once the fd may
/// be ready (possibly spuriously).
#[must_use("future is never awaited, so its body never runs: write `await {}`")]
pub(pkg) struct IoReady {
    fd: i32;
    write: i32;
    armed: bool;
}

impl Future for IoReady {
    type Output = ();
    fn poll(ref self, ref ctx: Context) -> Poll<()> {
        if self.armed {
            return Poll::Ready(());
        }
        start_driver();
        if unsafe { rok_io_watch(self.fd, 1u32 << (self.write as u32)) } < 0 {
            // Not pollable: let the operation report the error.
            return Poll::Ready(());
        }
        // Park first, then look: an edge after the look unparks us.
        park(io_key(self.fd, self.write), ctx.waker);
        if unsafe { rok_net_wait(self.fd, self.write, 0) } != 0 {
            return Poll::Ready(());
        }
        self.armed = true;
        Poll::Pending
    }
}

// runtime ABI hooks (805 §8.5.3, §8.5.5)
//
// `rok_io_register` / `rok_timer_register` / `rok_coro_park` /
// `rok_coro_unpark` call these, for hand-written futures and foreign
// code. A `waker` is a one-element `GcBuf<Waker>`; a coroutine `frame`
// is any GC object, whose address is the parking key. Each registration
// wakes once: register again for the next wait.

/// Wake `w[0]` once `fd` may be readable (`interest & 1`) or writable
/// (`interest & 2`) - at once if it already is, or if the fd cannot be
/// watched (the retried operation reports the error).
extern "C" fn hook_io(fd: i32, interest: u32, w: GcBuf<Waker>) {
    unsafe {
        let waker = w[0];
        start_driver();
        if rok_io_watch(fd, interest) < 0 {
            waker.wake();
            return;
        }
        for dir in 0..2 {
            if (interest >> (dir as u32)) & 1u32 != 0u32 {
                // Park first, then look (as `readable`).
                park(io_key(fd, dir), waker);
                if rok_net_wait(fd, dir, 0) != 0 {
                    waker.wake();
                }
            }
        }
    }
}

extern "C" fn hook_timer(deadline: u64, w: GcBuf<Waker>) {
    unsafe {
        add_timer(deadline as i64, w[0]);
    }
}

extern "C" fn hook_park(frame: GcBuf<u8>, w: GcBuf<Waker>) {
    unsafe {
        park(key(frame), w[0]);
    }
}

extern "C" fn hook_unpark(frame: GcBuf<u8>) {
    unpark(key(frame));
}

// the blocking lane (regular files)

/// Run `f` on the executor's blocking lane as a task (tokio's
/// `spawn_blocking`). For syscalls with no readiness to wait on, like
/// regular files under kqueue / epoll. `f` is queued at once. A cancel
/// before the lane takes it means it never runs (`join` throws
/// `CancellationError`); once it runs it finishes with its result, as it
/// has no cancellation point.
pub fn spawn_blocking<T: Send>(f: fn() -> T + Send) -> Task<T> {
    unsafe {
        let slot: GcBuf<T> = buf_new(1);
        // Never scheduled: the lane runs it and finishes it.
        let t = make_task(|ctx: Context| -> bool { true }, none);
        t.state[0] = RUNNING;
        // Its result comes from the lane thread: every joiner copies it.
        t.state[6] = 1;
        // Written once on the lane, read by joiners once it is done.
        let cell = Handoff::new(slot);
        // The job returns its completion, which the lane runs once it is
        // idle again or holds its next job: a joiner that sees it done
        // before any wake still finds the thread there.
        let job: fn() -> (fn() + Send) + Send = || -> (fn() + Send) {
            if is_cancelled(t) {
                atomic_xchg(t.state, 4, 1, SeqCst);
            } else {
                t.state[9] = 1;
                let slot = cell.get();
                slot[0] = hand_over::<T>(f());
            }
            || { finish(t); }
        };
        executor().blocking.submit(job);
        Task { task: t, slot: cell.get() }
    }
}

/// Most lane threads at once (tokio's default); past it jobs queue.
const BLOCKING_MAX_THREADS: usize = 512;
/// A lane thread idle this long exits (tokio's default).
const BLOCKING_KEEP_ALIVE_NS: i64 = 10_000_000_000;

/// Threads start lazily when a job finds no idle one (up to
/// `BLOCKING_MAX_THREADS`), take jobs FIFO, and exit after
/// `BLOCKING_KEEP_ALIVE_NS` without one.
///
/// A thread on its way to the queue (woken or just started) counts as
/// `coming`; a submit wakes or starts one only while the queue holds more
/// jobs than are coming. So a job taken meanwhile by a thread finishing
/// its last one costs no extra thread, however slow the woken one is to
/// run (a loaded machine, a collection).
struct BlockingPool {
    lock: Mutex<i32>;
    /// Queued jobs (under `lock`).
    jobs: Deque<fn() -> (fn() + Send) + Send>;
    /// `[threads, coming]` (under `lock`).
    threads: GcBuf<usize>;
    /// The sleeping threads' wake words (under `lock`): a submit pops one,
    /// sets it to 1 and wakes that thread only.
    idle: List<GcBuf<i32>>;
    /// The threads' ids (under `lock`), and the sleeping ones' (beside
    /// `idle`).
    ids: List<u64>;
    idle_ids: List<u64>;
}

unsafe impl Send for BlockingPool {}
unsafe impl Sync for BlockingPool {}

impl BlockingPool {
    const fn new() -> BlockingPool {
        unsafe {
            BlockingPool {
                lock: Mutex::new(0),
                jobs: Deque::new(),
                threads: buf_new(2),
                idle: List::new(),
                ids: List::new(),
                idle_ids: List::new(),
            }
        }
    }

    fn submit(self, job: fn() -> (fn() + Send) + Send) {
        unsafe {
            let spawn = false;
            let wake: GcBuf<i32> | none = none;
            let id = rok_thread_new_id();
            using g = self.lock.lock() {
                self.jobs.push_back(job);
                // One more thread for the queue: a sleeping one, else a new one.
                if self.jobs.len() > self.threads[1] {
                    if let w: GcBuf<i32> = self.idle.pop() {
                        self.idle_ids.pop();
                        w[0] = 1;
                        wake = w;
                        self.threads[1] += 1;
                    } else if self.threads[0] < BLOCKING_MAX_THREADS {
                        self.threads[0] += 1;
                        self.threads[1] += 1;
                        self.ids.push(id);
                        spawn = true;
                    }
                }
            }
            if let w: GcBuf<i32> = wake {
                rok_sync_wake(w, 0);
            }
            if spawn {
                let lane = self;
                let h = rok_thread_spawn(|| lane.work(BLOCKING_KEEP_ALIVE_NS, id), 0, id);
                if h == 0 {
                    using g = self.lock.lock() {
                        self.threads[0] -= 1;
                        self.arrived();
                        self.forget(id);
                    }
                    // No thread to be had (always without threads): drain
                    // the queue here, outside any task.
                    let w = current();
                    rok_task_worker_clear();
                    self.work(0, 0);
                    if let k: Worker = w {
                        set_current(k);
                    }
                } else {
                    _ = rok_thread_detach(h);
                }
            }
        }
    }

    /// A coming thread reached the queue (under `lock`). Saturating: after
    /// `forget_lost` the count may be low, which costs a spare wake only.
    const fn arrived(self) {
        unsafe {
            if self.threads[1] > 0 {
                self.threads[1] -= 1;
            }
        }
    }

    /// Drop thread `id` from `ids` (under `lock`).
    const fn forget(self, id: u64) {
        for i in 0..self.ids.len() {
            if self.ids[i] == id {
                self.ids.remove(i);
                return;
            }
        }
    }

    /// After a failed REPL cell (`hook_restart`): threads that are gone
    /// no longer count (none was running a job then: their jobs are still
    /// queued), nor do the coming ones (a gone one never comes).
    fn forget_lost(self) {
        unsafe {
            using g = self.lock.lock() {
                let i = self.idle.len();
                while i > 0 {
                    i -= 1;
                    if rok_thread_lost(self.idle_ids[i]) != 0 {
                        self.idle.remove(i);
                        self.idle_ids.remove(i);
                    }
                }
                let j = self.ids.len();
                while j > 0 {
                    j -= 1;
                    if rok_thread_lost(self.ids[j]) != 0 {
                        self.ids.remove(j);
                        self.threads[0] -= 1;
                    }
                }
                self.threads[1] = 0;
            }
        }
    }

    /// A lane thread (`id`; 0: the caller, drained in place inside a
    /// poll, which is busy already): run queued jobs until idle for
    /// `keep_alive` ns.
    fn work(self, keep_alive: i64, id: u64) {
        unsafe {
            // 1 while it is coming: a new thread is, until it takes the lock.
            let me: GcBuf<i32> = buf_new(1);
            me[0] = 1;
            let coming = id != 0;
            let idle_since = now_ns();
            let gated = id != 0;
            if gated {
                rok_session_enter();
            }
            // The last job's completion, run only once this thread is back on
            // the idle list or holds its next job: the job its awaiter
            // submits next finds this thread instead of starting one.
            let finish: (fn() + Send) | none = none;
            loop {
                // Not with a completion pending: a session saved here would
                // keep it only on this thread's stack, and a failed cell's
                // restore loses the thread (its awaiter would never finish).
                if gated && finish is none {
                    rok_session_pass();
                }
                let job: (fn() -> (fn() + Send) + Send) | none = none;
                let quit = false;
                using g = self.lock.lock() {
                    if coming {
                        if me[0] == 1 {
                            self.arrived();
                        } else {
                            // Not handed a job (a timeout or a spurious
                            // wake): leave the idle list.
                            for i in 0..self.idle.len() {
                                if buf_same(self.idle[i], me) {
                                    self.idle.remove(i);
                                    self.idle_ids.remove(i);
                                    break;
                                }
                            }
                        }
                        coming = false;
                    }
                    job = self.jobs.pop_front();
                    if job is none {
                        if now_ns() - idle_since >= keep_alive {
                            // The in-place drain (`id == 0`, no thread to be
                            // had) already gave back its count and was
                            // forgotten before it ran: it just returns.
                            if id != 0 {
                                self.threads[0] -= 1;
                                self.forget(id);
                            }
                            quit = true;
                        } else {
                            me[0] = 0;
                            self.idle.push(me);
                            self.idle_ids.push(id);
                        }
                    }
                }
                if let c: fn() + Send = finish {
                    c();
                    finish = none;
                }
                if quit {
                    if gated {
                        rok_session_leave();
                    }
                    return;
                }
                if let f: fn() -> (fn() + Send) + Send = job {
                    finish = f();
                    idle_since = now_ns();
                    continue;
                }
                let left = idle_since + keep_alive - now_ns();
                if gated {
                    rok_session_leave();
                }
                unsafe { rok_sync_wait(me, 0, 0, left) };
                if gated {
                    rok_session_enter();
                }
                coming = true;
            }
        }
    }
}

// rok::core::sync - concurrency primitives (stdlib spec 2.16).
//
// Every type is a handle over GC buffers: copying it (into a closure,
// another thread) shares the one primitive. Blocking goes through the
// runtime's address-keyed wait queue (`rok_sync_wait` / `rok_sync_wake`,
// futex semantics; `Atomic<i32>::wait` / `wake` expose it); a blocked
// thread counts as stopped for the GC.
//
// Not in 2.16 but provided because the blocking APIs need them: `Once`,
// `Condvar` (Rust-shaped).

use rok::core::marker::{hand_over, hand_over_into};
use rok::core::rt::{atomic_add, atomic_and, atomic_cas, atomic_load, atomic_or, atomic_sub, atomic_xchg, atomic_xor, key};

/// Whether guards note their locks (`rok_lock_note`): this is a REPL
/// session host. Asked before a lock is taken, so nothing runs between
/// taking it and the note but the note.
fn lock_notes() -> bool {
    let n = LOCK_NOTES.load();
    if n < 0 {
        n = unsafe { rok_lock_notes() };
        LOCK_NOTES.store(n);
    }
    n != 0
}

/// `lock_notes`, once asked (-1: not yet; the runtime call is not in a
/// static initializer: those are in every program).
static LOCK_NOTES: Atomic<i32> = Atomic::new(-1);

fn wait(word: GcBuf<i32>, expected: i32) {
    unsafe { rok_sync_wait(word, 0, expected, -1) };
}

fn wake(word: GcBuf<i32>) {
    unsafe { rok_sync_wake(word, 0) };
}

const fn word(v: i32) -> GcBuf<i32> {
    unsafe {
        let w: GcBuf<i32> = buf_new(1);
        w[0] = v;
        w
    }
}

// The async waits of `RwLock` / `Condvar` (which have no "waiters" state
// like `Mutex`'s 2): `w[1]` is set by a task that parked on `w`'s key,
// and whoever may have made `w` ready unparks only when it is set (an
// unpark takes the process-wide parking lock).

/// Park the task on `w`'s key and flag it; re-check after this.
fn park_on(w: GcBuf<i32>, ctx: rok::core::future::Context) {
    rok::core::task::park(key(w), ctx.waker());
    atomic_xchg(w, 1, 1, SeqCst);
}

fn unpark_parked(w: GcBuf<i32>) {
    if atomic_xchg(w, 1, 0, SeqCst) != 0 {
        rok::core::task::unpark(key(w));
    }
}

const fn two_words() -> GcBuf<i32> {
    unsafe {
        buf_new(2)
    }
}

/// Memory ordering of an atomic operation (2.16.2). Spec name: `Ordering`,
/// which would collide with `cmp::Ordering` under `use rok::core::**`.
pub enum AtomicOrdering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

/// The element types `Atomic<T>` supports.
#[sealed]
pub trait AtomicPrimitive {}
// Every integer and bool is an atomic primitive (spec 6.8.12).
#[impl_macro(atomic_prims)] @macro {
    (@rep[sep = ","] { @t: ty }) => { @for @t { impl AtomicPrimitive for @t {} } }
}
atomic_prims!(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool);
/// One address word: load / store / swap / compare_exchange.
impl<T> AtomicPrimitive for rok::bare::ptr::Ptr<T> {}

/// Pointers compare by address.
impl<T> PartialEq for rok::bare::ptr::Ptr<T> {
    const fn eq(self, rhs: rok::bare::ptr::Ptr<T>) -> bool { self.addr() == rhs.addr() }
}

/// A lock-free cell (2.16.2). Send + Sync.
pub struct Atomic<T> {
    cell: GcBuf<T>;
}

// The cell holds an address, not what it points at: an `Atomic<Ptr<T>>`
// is shared as any other.
unsafe impl<T> Send for Atomic<rok::bare::ptr::Ptr<T>> {}
unsafe impl<T> Sync for Atomic<rok::bare::ptr::Ptr<T>> {}

// Each method maps its ordering argument onto the intrinsic's literal
// ordering; with a constant argument the `match` folds away once the
// method is inlined (`-O1` and up).
impl<T: AtomicPrimitive + PartialEq> Atomic<T> {
    pub const fn new(value: T) -> Atomic<T> {
        unsafe {
            let cell: GcBuf<T> = buf_new(1);
            cell[0] = value;
            Atomic { cell }
        }
    }

    /// Panics on `Release` / `AcqRel` (not load orderings).
    #[track_caller]
    pub fn load(self, ordering: AtomicOrdering = SeqCst) -> T {
        let c = self.cell;
        match ordering {
            AtomicOrdering::Relaxed => atomic_load(c, 0, Relaxed),
            AtomicOrdering::Acquire => atomic_load(c, 0, Acquire),
            AtomicOrdering::SeqCst => atomic_load(c, 0, SeqCst),
            _ => panic("Atomic::load: `Release` / `AcqRel` is not a load ordering"),
        }
    }

    pub fn store(self, value: T, ordering: AtomicOrdering = SeqCst) {
        self.swap(value, ordering);
    }

    #[discardable]
    pub fn swap(self, value: T, ordering: AtomicOrdering = SeqCst) -> T {
        let c = self.cell;
        match ordering {
            AtomicOrdering::Relaxed => atomic_xchg(c, 0, value, Relaxed),
            AtomicOrdering::Acquire => atomic_xchg(c, 0, value, Acquire),
            AtomicOrdering::Release => atomic_xchg(c, 0, value, Release),
            AtomicOrdering::AcqRel => atomic_xchg(c, 0, value, AcqRel),
            AtomicOrdering::SeqCst => atomic_xchg(c, 0, value, SeqCst),
        }
    }

    /// `Ok(previous)` if it held `current` (now `new`), else
    /// `Err(actual)`. `failure` is a load ordering (panics on `Release`
    /// / `AcqRel`).
    #[track_caller]
    pub fn compare_exchange(
        self, current: T, new: T, success: AtomicOrdering, failure: AtomicOrdering,
    ) -> Result<T, T> {
        let old = match failure {
            AtomicOrdering::Relaxed => cas_relaxed_fail(self.cell, current, new, success),
            AtomicOrdering::Acquire => cas_acquire_fail(self.cell, current, new, success),
            AtomicOrdering::SeqCst => cas_seqcst_fail(self.cell, current, new, success),
            _ => panic("Atomic::compare_exchange: `Release` / `AcqRel` is not a failure ordering"),
        };
        if old == current {
            return Result::Ok(old);
        }
        Result::Err(old)
    }

    /// Never fails spuriously here (same as `compare_exchange`).
    pub fn compare_exchange_weak(
        self, current: T, new: T, success: AtomicOrdering, failure: AtomicOrdering,
    ) -> Result<T, T> {
        self.compare_exchange(current, new, success, failure)
    }

    // Integer-only (`bool` is rejected by the intrinsic for add / sub).
    #[discardable]
    pub fn fetch_add(self, value: T, ordering: AtomicOrdering = SeqCst) -> T {
        let c = self.cell;
        match ordering {
            AtomicOrdering::Relaxed => atomic_add(c, 0, value, Relaxed),
            AtomicOrdering::Acquire => atomic_add(c, 0, value, Acquire),
            AtomicOrdering::Release => atomic_add(c, 0, value, Release),
            AtomicOrdering::AcqRel => atomic_add(c, 0, value, AcqRel),
            AtomicOrdering::SeqCst => atomic_add(c, 0, value, SeqCst),
        }
    }
    #[discardable]
    pub fn fetch_sub(self, value: T, ordering: AtomicOrdering = SeqCst) -> T {
        let c = self.cell;
        match ordering {
            AtomicOrdering::Relaxed => atomic_sub(c, 0, value, Relaxed),
            AtomicOrdering::Acquire => atomic_sub(c, 0, value, Acquire),
            AtomicOrdering::Release => atomic_sub(c, 0, value, Release),
            AtomicOrdering::AcqRel => atomic_sub(c, 0, value, AcqRel),
            AtomicOrdering::SeqCst => atomic_sub(c, 0, value, SeqCst),
        }
    }
    #[discardable]
    pub fn fetch_and(self, value: T, ordering: AtomicOrdering = SeqCst) -> T {
        let c = self.cell;
        match ordering {
            AtomicOrdering::Relaxed => atomic_and(c, 0, value, Relaxed),
            AtomicOrdering::Acquire => atomic_and(c, 0, value, Acquire),
            AtomicOrdering::Release => atomic_and(c, 0, value, Release),
            AtomicOrdering::AcqRel => atomic_and(c, 0, value, AcqRel),
            AtomicOrdering::SeqCst => atomic_and(c, 0, value, SeqCst),
        }
    }
    #[discardable]
    pub fn fetch_or(self, value: T, ordering: AtomicOrdering = SeqCst) -> T {
        let c = self.cell;
        match ordering {
            AtomicOrdering::Relaxed => atomic_or(c, 0, value, Relaxed),
            AtomicOrdering::Acquire => atomic_or(c, 0, value, Acquire),
            AtomicOrdering::Release => atomic_or(c, 0, value, Release),
            AtomicOrdering::AcqRel => atomic_or(c, 0, value, AcqRel),
            AtomicOrdering::SeqCst => atomic_or(c, 0, value, SeqCst),
        }
    }
    #[discardable]
    pub fn fetch_xor(self, value: T, ordering: AtomicOrdering = SeqCst) -> T {
        let c = self.cell;
        match ordering {
            AtomicOrdering::Relaxed => atomic_xor(c, 0, value, Relaxed),
            AtomicOrdering::Acquire => atomic_xor(c, 0, value, Acquire),
            AtomicOrdering::Release => atomic_xor(c, 0, value, Release),
            AtomicOrdering::AcqRel => atomic_xor(c, 0, value, AcqRel),
            AtomicOrdering::SeqCst => atomic_xor(c, 0, value, SeqCst),
        }
    }
}

impl Atomic<i32> {
    /// Block while the value is `expected`, at most `timeout` ns (< 0:
    /// no limit), or until `wake`; may return spuriously, so re-check.
    pub fn wait(self, expected: i32, timeout_ns: i64 = -1) {
        unsafe { rok_sync_wait(self.cell, 0, expected, timeout_ns) };
    }

    /// `wait` for at most `timeout` (a negative one: no limit).
    pub fn wait_timeout(self, expected: i32, timeout: rok::core::task::time::Duration) {
        self.wait(expected, timeout.as_ns());
    }

    /// Wake every thread in `wait` on this cell.
    pub fn wake(self) {
        wake(self.cell);
    }
}

// `compare_exchange` per failure ordering, each choosing the success one.
fn cas_relaxed_fail<T>(c: GcBuf<T>, cur: T, new: T, success: AtomicOrdering) -> T {
    match success {
        AtomicOrdering::Relaxed => atomic_cas(c, 0, cur, new, Relaxed, Relaxed),
        AtomicOrdering::Acquire => atomic_cas(c, 0, cur, new, Acquire, Relaxed),
        AtomicOrdering::Release => atomic_cas(c, 0, cur, new, Release, Relaxed),
        AtomicOrdering::AcqRel => atomic_cas(c, 0, cur, new, AcqRel, Relaxed),
        AtomicOrdering::SeqCst => atomic_cas(c, 0, cur, new, SeqCst, Relaxed),
    }
}
fn cas_acquire_fail<T>(c: GcBuf<T>, cur: T, new: T, success: AtomicOrdering) -> T {
    match success {
        AtomicOrdering::Relaxed => atomic_cas(c, 0, cur, new, Relaxed, Acquire),
        AtomicOrdering::Acquire => atomic_cas(c, 0, cur, new, Acquire, Acquire),
        AtomicOrdering::Release => atomic_cas(c, 0, cur, new, Release, Acquire),
        AtomicOrdering::AcqRel => atomic_cas(c, 0, cur, new, AcqRel, Acquire),
        AtomicOrdering::SeqCst => atomic_cas(c, 0, cur, new, SeqCst, Acquire),
    }
}
fn cas_seqcst_fail<T>(c: GcBuf<T>, cur: T, new: T, success: AtomicOrdering) -> T {
    match success {
        AtomicOrdering::Relaxed => atomic_cas(c, 0, cur, new, Relaxed, SeqCst),
        AtomicOrdering::Acquire => atomic_cas(c, 0, cur, new, Acquire, SeqCst),
        AtomicOrdering::Release => atomic_cas(c, 0, cur, new, Release, SeqCst),
        AtomicOrdering::AcqRel => atomic_cas(c, 0, cur, new, AcqRel, SeqCst),
        AtomicOrdering::SeqCst => atomic_cas(c, 0, cur, new, SeqCst, SeqCst),
    }
}

/// Exclusive lock around a `T` (2.16.3). No poisoning (spec): a panic
/// ends the process, and an error leaving `using` drops the guard.
// `state[0]`: 0 unlocked, 1 locked, 2 locked with (possible) waiters;
// `state[1]`: entries in `OWED` (a cancelled `Condvar::wait_async`).
pub struct Mutex<T> {
    state: GcBuf<i32>;
    value: GcBuf<T>;
}

unsafe impl<T: Send> Sync for Mutex<T> {}

impl<T> Mutex<T> {
    pub const fn new(value: T) -> Mutex<T> {
        unsafe {
            let v: GcBuf<T> = buf_new(1);
            v[0] = hand_over::<T>(value);
            Mutex { state: two_words(), value: v }
        }
    }

    /// `new` without the hand-off copy (2.13.9): the caller guarantees
    /// that nothing else reaches `value`'s collections (a value just made).
    pub const unsafe fn new_unshared(value: T) -> Mutex<T> {
        unsafe {
            let v: GcBuf<T> = buf_new(1);
            v[0] = value;
            Mutex { state: two_words(), value: v }
        }
    }

    /// Block until the lock is ours. Bind the guard with `using`.
    pub fn lock(self) -> MutexGuard<T> {
        let notes = lock_notes();
        if atomic_cas(self.state, 0, 0, 1, SeqCst, SeqCst) != 0 {
            while atomic_xchg(self.state, 0, 2, SeqCst) != 0 {
                wait(self.state, 2);
            }
        }
        MutexGuard { mutex: self, noted: notes && unsafe { rok_lock_note(self.state, 0) } != 0 }
    }

    pub fn try_lock(self) -> MutexGuard<T> | none {
        let notes = lock_notes();
        if atomic_cas(self.state, 0, 0, 1, SeqCst, SeqCst) == 0 {
            return MutexGuard { mutex: self, noted: notes && unsafe { rok_lock_note(self.state, 0) } != 0 };
        }
        none
    }

    /// `noted`: the guard's lock note goes too, right before the lock
    /// (no safepoint between: a thread that holds a lock unnoted, or a
    /// note of a lock it no longer holds, never stops there).
    fn unlock(self, noted: bool) {
        if noted {
            unsafe { rok_lock_drop(self.state) };
        }
        if atomic_load(self.state, 1, SeqCst) != 0 && self.forgive() {
            return;
        }
        if atomic_xchg(self.state, 0, 0, SeqCst) == 2 {
            wake(self.state);
            rok::core::task::unpark(key(self.state));
        }
    }

    /// Owe the next `unlock` by the running task: it holds a guard of a
    /// lock it does not have (a `Condvar::wait_async` between its unlock
    /// and taking the lock back), and that guard's drop must not unlock
    /// another holder's lock.
    fn owe(self, task: u64) {
        using g = OWED.lock() {
            g.get().push((key(self.state), task));
            atomic_add(self.state, 1, 1, SeqCst);
        }
    }

    /// Whether an `unlock` by the running task was owed: then it is
    /// settled (and that `unlock` does nothing).
    fn forgive(self) -> bool {
        let me = match rok::core::task::current_id() {
            id: rok::core::task::TaskId => id.as_u64(),
            none => return false,
        };
        let k = key(self.state);
        let found = false;
        using g = OWED.lock() {
            let l = g.get();
            for i in 0..l.len() {
                if l[i] == (k, me) {
                    l.remove(i);
                    atomic_sub(self.state, 1, 1, SeqCst);
                    found = true;
                    break;
                }
            }
        }
        found
    }

    /// `await m.lock_async()` inside async code: suspends the task (not
    /// the thread) until the lock is ours.
    pub const fn lock_async(self) -> LockFuture<T> {
        LockFuture { mutex: self }
    }
}

/// `Mutex::lock_async`.
pub struct LockFuture<T> {
    mutex: Mutex<T>;
}

impl<T> rok::core::future::Future for LockFuture<T> {
    type Output = MutexGuard<T>;
    fn poll(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<MutexGuard<T>> {
        let m = self.mutex;
        // A cancelled task leaves at this `await`: taking the lock now
        // would hand it a guard nobody drops.
        if rok::core::task::cancel_requested(ctx) {
            return rok::core::future::Poll::Pending;
        }
        // A task's locks are not noted: it outlives the thread it runs on.
        if atomic_cas(m.state, 0, 0, 1, SeqCst, SeqCst) == 0 {
            return rok::core::future::Poll::Ready(MutexGuard { mutex: m, noted: false });
        }
        // Park first, then mark "waiters" (2): an unlock after this sees
        // the 2 and unparks us.
        rok::core::task::park(key(m.state), ctx.waker());
        if atomic_xchg(m.state, 0, 2, SeqCst) == 0 {
            return rok::core::future::Poll::Ready(MutexGuard { mutex: m, noted: false });
        }
        rok::core::future::Poll::Pending
    }
}

/// `(mutex key, task id)`: unlocks owed (`Mutex::owe`).
// One global list: it only holds cancelled `wait_async`s whose guard
// has not dropped yet.
static OWED: Mutex<List<(usize, u64)>> = unsafe { Mutex::new_unshared(List::new()) };

/// Holds a `Mutex` locked until dropped (`using`).
pub struct MutexGuard<T> {
    mutex: Mutex<T>;
    /// Taken outside a task while a REPL session host keeps lock notes
    /// (`rok_lock_note`): released if its thread is gone after a failed
    /// cell.
    noted: bool;
}

// A copy of a guard outlives its `using` block unprotected: the hand-off
// check follows guards like the collections they hand out (2.13.9).
impl<T> !Sync for MutexGuard<T> {}

impl<T> MutexGuard<T> {
    /// The protected value (a copy of the handle for GC types).
    pub const fn get(self) -> T {
        unsafe {
            self.mutex.value[0]
        }
    }
    /// Replace the protected value (instead of spec `deref_mut`: rok has
    /// no `ref` returns).
    pub const fn set(self, value: T) {
        unsafe {
            self.mutex.value[0] = hand_over::<T>(value);
        }
    }
    /// `set` without the hand-off copy: `value` was just made.
    pub(pkg) const fn set_unshared(self, value: T) {
        unsafe {
            self.mutex.value[0] = value;
        }
    }
    /// Replace the protected value with `f(value)`.
    pub const fn update(self, f: fn(T) -> T) {
        unsafe {
            let old = self.mutex.value[0];
            self.mutex.value[0] = hand_over_into::<T>(old, f(old));
        }
    }
}

impl<T> Drop for MutexGuard<T> {
    fn drop(ref self) {
        self.mutex.unlock(self.noted);
    }
}

/// Many readers or one writer (2.16.4).
// `state[0]`: 0 free, -1 writer, n > 0 readers; `state[1]`: a task is
// parked on it (`read_async` / `write_async`).
pub struct RwLock<T> {
    state: GcBuf<i32>;
    value: GcBuf<T>;
}

// Readers share the value: it must be `Sync` too.
unsafe impl<T: Send + Sync> Sync for RwLock<T> {}

impl<T> RwLock<T> {
    pub const fn new(value: T) -> RwLock<T> {
        unsafe {
            let v: GcBuf<T> = buf_new(1);
            v[0] = hand_over::<T>(value);
            RwLock { state: two_words(), value: v }
        }
    }

    pub fn read(self) -> RwLockReadGuard<T> {
        let notes = lock_notes();
        loop {
            let s = atomic_load(self.state, 0, SeqCst);
            if s >= 0 {
                if atomic_cas(self.state, 0, s, s + 1, SeqCst, SeqCst) == s {
                    return RwLockReadGuard { lock: self, noted: notes && unsafe { rok_lock_note(self.state, 1) } != 0 };
                }
            } else {
                wait(self.state, s);
            }
        }
    }

    pub fn write(self) -> RwLockWriteGuard<T> {
        let notes = lock_notes();
        loop {
            let s = atomic_cas(self.state, 0, 0, -1, SeqCst, SeqCst);
            if s == 0 {
                return RwLockWriteGuard { lock: self, noted: notes && unsafe { rok_lock_note(self.state, 2) } != 0 };
            }
            wait(self.state, s);
        }
    }

    pub fn try_read(self) -> RwLockReadGuard<T> | none {
        let notes = lock_notes();
        // Retry a CAS lost to another reader: only a writer makes it fail.
        let s = atomic_load(self.state, 0, SeqCst);
        while s >= 0 {
            let seen = atomic_cas(self.state, 0, s, s + 1, SeqCst, SeqCst);
            if seen == s {
                return RwLockReadGuard { lock: self, noted: notes && unsafe { rok_lock_note(self.state, 1) } != 0 };
            }
            s = seen;
        }
        none
    }

    pub fn try_write(self) -> RwLockWriteGuard<T> | none {
        let notes = lock_notes();
        if atomic_cas(self.state, 0, 0, -1, SeqCst, SeqCst) == 0 {
            return RwLockWriteGuard { lock: self, noted: notes && unsafe { rok_lock_note(self.state, 2) } != 0 };
        }
        none
    }

    /// `await l.read_async()`: suspends the task (not the thread) while
    /// a writer holds the lock.
    pub const fn read_async(self) -> ReadFuture<T> {
        ReadFuture { lock: self }
    }

    /// `await l.write_async()`: suspends the task until no reader or
    /// writer holds the lock.
    pub const fn write_async(self) -> WriteFuture<T> {
        WriteFuture { lock: self }
    }
}

/// `RwLock::read_async`.
pub struct ReadFuture<T> {
    lock: RwLock<T>;
}

impl<T> rok::core::future::Future for ReadFuture<T> {
    type Output = RwLockReadGuard<T>;
    fn poll(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<RwLockReadGuard<T>> {
        if rok::core::task::cancel_requested(ctx) {
            return rok::core::future::Poll::Pending;
        }
        if let g: RwLockReadGuard<T> = self.lock.try_read() {
            return rok::core::future::Poll::Ready(g);
        }
        park_on(self.lock.state, ctx);
        if let g: RwLockReadGuard<T> = self.lock.try_read() {
            return rok::core::future::Poll::Ready(g);
        }
        rok::core::future::Poll::Pending
    }
}

/// `RwLock::write_async`.
pub struct WriteFuture<T> {
    lock: RwLock<T>;
}

impl<T> rok::core::future::Future for WriteFuture<T> {
    type Output = RwLockWriteGuard<T>;
    fn poll(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<RwLockWriteGuard<T>> {
        if rok::core::task::cancel_requested(ctx) {
            return rok::core::future::Poll::Pending;
        }
        if let g: RwLockWriteGuard<T> = self.lock.try_write() {
            return rok::core::future::Poll::Ready(g);
        }
        park_on(self.lock.state, ctx);
        if let g: RwLockWriteGuard<T> = self.lock.try_write() {
            return rok::core::future::Poll::Ready(g);
        }
        rok::core::future::Poll::Pending
    }
}

pub struct RwLockReadGuard<T> {
    lock: RwLock<T>;
    /// As `MutexGuard::noted`.
    noted: bool;
}

impl<T> !Sync for RwLockReadGuard<T> {}

impl<T> RwLockReadGuard<T> {
    pub const fn get(self) -> T {
        unsafe {
            self.lock.value[0]
        }
    }
}

impl<T> Drop for RwLockReadGuard<T> {
    fn drop(ref self) {
        if self.noted {
            unsafe { rok_lock_drop(self.lock.state) };
        }
        if atomic_sub(self.lock.state, 0, 1, SeqCst) == 1 {
            wake(self.lock.state);
            unpark_parked(self.lock.state);
        }
    }
}

pub struct RwLockWriteGuard<T> {
    lock: RwLock<T>;
    /// As `MutexGuard::noted`.
    noted: bool;
}

impl<T> !Sync for RwLockWriteGuard<T> {}

impl<T> RwLockWriteGuard<T> {
    pub const fn get(self) -> T {
        unsafe {
            self.lock.value[0]
        }
    }
    pub const fn set(self, value: T) {
        unsafe {
            self.lock.value[0] = hand_over::<T>(value);
        }
    }
    pub fn update(self, f: fn(T) -> T) {
        unsafe {
            let old = self.lock.value[0];
            self.lock.value[0] = hand_over_into::<T>(old, f(old));
        }
    }
}

impl<T> Drop for RwLockWriteGuard<T> {
    fn drop(ref self) {
        if self.noted {
            unsafe { rok_lock_drop(self.lock.state) };
        }
        atomic_xchg(self.lock.state, 0, 0, SeqCst);
        wake(self.lock.state);
        unpark_parked(self.lock.state);
    }
}

/// A value made once and only read after (2.16.4b): any thread may read it
/// without a lock. `new` keeps a copy of the value's collections that
/// nothing else reaches, and `get` gives each reader its own copy, so no
/// one can change what the others read. `Sync` parts (a `Mutex`, a cache
/// that locks itself) stay shared.
pub struct Frozen<T> {
    value: GcBuf<T>;
}

unsafe impl<T: Send> Sync for Frozen<T> {}

impl<T> Frozen<T> {
    #[track_caller]
    pub const fn new(value: T) -> Frozen<T> {
        unsafe {
            let v: GcBuf<T> = buf_new(1);
            v[0] = hand_over::<T>(value);
            Frozen { value: v }
        }
    }

    /// A copy of the value: the reader's own to change.
    #[track_caller]
    pub fn get(self) -> T {
        unsafe { hand_over::<T>(self.value[0]) }
    }
}

/// Run an initializer exactly once across threads.
// `state`: 0 new, 1 running, 2 done.
pub struct Once {
    state: GcBuf<i32>;
}

impl Once {
    pub const fn new() -> Once {
        Once { state: word(0) }
    }

    /// Run `f` if no call has; every caller returns after it finished.
    pub fn call_once(self, f: fn()) {
        let notes = lock_notes();
        loop {
            let s = atomic_cas(self.state, 0, 0, 1, SeqCst, SeqCst);
            if s == 0 {
                // A thread gone mid-`f` leaves it to the next caller.
                let noted = notes && unsafe { rok_lock_note(self.state, 3) } != 0;
                f();
                if noted {
                    unsafe { rok_lock_drop(self.state) };
                }
                atomic_xchg(self.state, 0, 2, SeqCst);
                wake(self.state);
                return;
            }
            if s == 2 {
                return;
            }
            wait(self.state, 1);
        }
    }

    pub fn is_completed(self) -> bool {
        atomic_load(self.state, 0, SeqCst) == 2
    }
}

/// Wait for a condition under a `Mutex`.
// `seq[0]` counts notifications; a waiter sleeps until it changes.
// `seq[1]`: a task is parked on it (`wait_async`).
pub struct Condvar {
    seq: GcBuf<i32>;
}

impl Condvar {
    pub const fn new() -> Condvar {
        Condvar { seq: two_words() }
    }

    /// `g = await cv.wait_async(g)`: `wait` that suspends the task (not
    /// the thread), both for the notification and to lock again.
    /// Spurious wakeups as for `wait`. A task cancelled while it waits
    /// takes the lock back if it is free (its `using` guard unlocks it);
    /// if another task holds it, the guard's unlock is owed instead and
    /// does nothing (the worker never blocks).
    pub const fn wait_async<T>(self, guard: MutexGuard<T>) -> CondvarWait<T> {
        unsafe {
            let st: GcBuf<i32> = buf_new(2);
            CondvarWait { cv: self, mutex: guard.mutex, noted: guard.noted, st: st }
        }
    }

    /// Unlock `guard`'s mutex, block until notified (or spuriously),
    /// lock it again. Re-check the condition in a loop.
    pub fn wait<T>(self, guard: MutexGuard<T>) -> MutexGuard<T> {
        let s = atomic_load(self.seq, 0, SeqCst);
        guard.mutex.unlock(guard.noted);
        wait(self.seq, s);
        guard.mutex.lock()
    }

    /// Wakes the longest-waiting blocked thread. Tasks in `wait_async`
    /// are all woken (a spurious wakeup for all but one): a parked task's
    /// entry may be stale, and waking only it could lose the notify.
    pub fn notify_one(self) {
        atomic_add(self.seq, 0, 1, SeqCst);
        unsafe { rok_sync_wake_one(self.seq, 0) };
        unpark_parked(self.seq);
    }

    pub fn notify_all(self) {
        atomic_add(self.seq, 0, 1, SeqCst);
        wake(self.seq);
        unpark_parked(self.seq);
    }
}

/// `Condvar::wait_async`.
pub struct CondvarWait<T> {
    cv: Condvar;
    mutex: Mutex<T>;
    /// The guard's (`MutexGuard::noted`).
    noted: bool;
    /// `[phase, seen]`: phase 0 not started, 1 waiting for a notify after
    /// `seen`, 2 locking again.
    st: GcBuf<i32>;
}

impl<T> rok::core::future::Future for CondvarWait<T> {
    type Output = MutexGuard<T>;
    fn poll(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<MutexGuard<T>> {
        unsafe {
            let st = self.st;
            let m = self.mutex;
            // From the unlock until the lock is ours again the task's guard
            // holds nothing: its drop is owed. The `await` may leave on a
            // cancel after any `Pending` without polling again.
            if st[0] == 0 {
                st[1] = atomic_load(self.cv.seq, 0, SeqCst);
                st[0] = 1;
                m.unlock(self.noted);
                m.owe(rok::core::task::id().as_u64());
            }
            if rok::core::task::cancel_requested(ctx) {
                // The task leaves this `await` and its `using` guard drops:
                // take the lock back if it is free (the drop unlocks it),
                // else the drop stays owed. Never blocks.
                if m.try_lock() is MutexGuard<T> {
                    m.forgive();
                }
                return rok::core::future::Poll::Ready(MutexGuard { mutex: m, noted: false });
            }
            if st[0] == 1 {
                park_on(self.cv.seq, ctx);
                if atomic_load(self.cv.seq, 0, SeqCst) == st[1] {
                    return rok::core::future::Poll::Pending;
                }
                st[0] = 2;
            }
            let lf = m.lock_async();
            match lf.poll(ref ctx) {
                rok::core::future::Poll::Ready(g) => {
                    m.forgive();
                    rok::core::future::Poll::Ready(g)
                }
                rok::core::future::Poll::Pending => rok::core::future::Poll::Pending,
            }
        }
    }
}

/// Single-task interior mutability (2.16.5): neither Send nor Sync.
pub struct Cell<T> {
    value: GcBuf<T>;
}

impl<T> !Send for Cell<T> {}
impl<T> !Sync for Cell<T> {}

impl<T> Cell<T> {
    pub const fn new(value: T) -> Cell<T> {
        unsafe {
            let v: GcBuf<T> = buf_new(1);
            v[0] = value;
            Cell { value: v }
        }
    }
    pub const fn get(self) -> T where T: Copy {
        unsafe {
            self.value[0]
        }
    }
    // Copies share the one buffer, so a copy sees the update too.
    pub const fn set(ref self, value: T) {
        unsafe {
            self.value[0] = value;
        }
    }
    #[discardable]
    pub const fn replace(ref self, value: T) -> T {
        unsafe {
            let old = self.value[0];
            self.value[0] = value;
            old
        }
    }
}

impl<T: Default> Cell<T> {
    /// The value, leaving `T::default()` in its place.
    #[discardable]
    pub const fn take(ref self) -> T {
        self.replace(T::default())
    }
}

// The module paths of stdlib 2.16.6.
pub mod atomic {
    pub use rok::core::sync::{Atomic, AtomicOrdering, AtomicPrimitive};
}
pub mod mutex {
    pub use rok::core::sync::{Mutex, MutexGuard, LockFuture};
}
pub mod rwlock {
    pub use rok::core::sync::{RwLock, RwLockReadGuard, RwLockWriteGuard, ReadFuture, WriteFuture};
}
pub mod cell {
    pub use rok::core::sync::Cell;
}

// rok::core::num - the primitive types' operator / comparison trait
// impls. They make `T: Add` / `T: Ord`
// bounds accept primitives. Each method is `#[intrinsic("rok.OP.TYPE")]`:
// a primitive `a + b` and a by-name call (`x.add(y)`,
// `T::add(a, b)`) both lower to the machine op. The body is the
// fallback and what a `fn` value of the method runs.
// One block per (type, trait); keep it regular. The inherent methods
// (`checked_add`, `count_ones`, `floor`, ..) live in `ints` / `floats`.

pub mod ints;
pub mod floats;
pub mod bigint;
pub mod bigfloat;
pub mod niche;
pub mod complex;
pub mod assign;
mod pow;

pub use rok::core::num::complex::Complex;

/// The additive identity - where `Iterator::sum` starts (an empty sum is
/// `0`).
pub trait Zero {
    /// `0` of `Self`.
    fn zero() -> Self;
}

/// The multiplicative identity - where `Iterator::product` starts.
pub trait One {
    /// `1` of `Self`.
    fn one() -> Self;
}

/// Arithmetic every primitive number type has: `+ - * /`, `0`, `1` and
/// comparison. The integer and float primitives implement it; write
/// `T: Num` for code over any of them.
pub trait Num: Copy + Zero + One + Add<Output = Self> + Sub<Output = Self> + Mul<Output = Self> + Div<Output = Self> + PartialEq + PartialOrd {}

/// The binary floating-point types `f32` and `f64` (not the unbounded
/// `float`): their constants and math as one bound, `T: FloatingPoint`.
/// Each method is the type's own of the same name. Swift's name;
/// Rust's `num::Float`.
pub trait FloatingPoint: Num + Neg<Output = Self> {
    /// Not a number.
    const NAN: Self;
    /// Positive infinity.
    const INFINITY: Self;
    /// Negative infinity.
    const NEG_INFINITY: Self;
    /// The gap between `1` and the next larger value.
    const EPSILON: Self;
    /// π.
    const PI: Self;
    /// Euler's number e.
    const E: Self;

    /// The absolute value.
    fn abs(self) -> Self;

    /// The square root; NaN for a negative value.
    fn sqrt(self) -> Self;

    /// The cube root.
    fn cbrt(self) -> Self;

    /// `e^self`.
    fn exp(self) -> Self;

    /// The natural logarithm.
    fn ln(self) -> Self;

    /// The base-2 logarithm.
    fn log2(self) -> Self;

    /// The base-10 logarithm.
    fn log10(self) -> Self;

    /// `self^n`.
    fn powi(self, n: i32) -> Self;

    /// `self^exp`.
    fn pow(self, exp: Self) -> Self;

    /// The sine (radians).
    fn sin(self) -> Self;

    /// The cosine (radians).
    fn cos(self) -> Self;

    /// The tangent (radians).
    fn tan(self) -> Self;

    /// The arcsine.
    fn asin(self) -> Self;

    /// The arccosine.
    fn acos(self) -> Self;

    /// The arctangent.
    fn atan(self) -> Self;

    /// The angle of the point `(other, self)`.
    fn atan2(self, other: Self) -> Self;

    /// The hyperbolic sine.
    fn sinh(self) -> Self;

    /// The hyperbolic cosine.
    fn cosh(self) -> Self;

    /// The hyperbolic tangent.
    fn tanh(self) -> Self;

    /// `√(self² + other²)` without overflow on the way.
    fn hypot(self, other: Self) -> Self;

    /// Rounded down.
    fn floor(self) -> Self;

    /// Rounded up.
    fn ceil(self) -> Self;

    /// Rounded to the nearest, half away from zero.
    fn round(self) -> Self;

    /// Rounded toward zero.
    fn trunc(self) -> Self;

    /// `1` / `-1` by the sign; NaN for NaN.
    fn signum(self) -> Self;

    /// `self * a + b` with one rounding.
    fn mul_add(self, a: Self, b: Self) -> Self;

    /// The smaller of the two; a NaN loses to a number.
    fn min(self, other: Self) -> Self;

    /// The larger of the two; a NaN loses to a number.
    fn max(self, other: Self) -> Self;

    /// `true` for NaN.
    fn is_nan(self) -> bool;

    /// `true` for either infinity.
    fn is_infinite(self) -> bool;

    /// `true` for neither NaN nor an infinity.
    fn is_finite(self) -> bool;

    /// The IEEE 754 total order (`-NaN < -inf < .. < -0 < +0 < .. < inf < NaN`).
    fn total_cmp(self, other: Self) -> rok::core::cmp::Ordering;

    /// `self` widened or kept as an `f64`.
    fn to_f64(self) -> f64;
    /// `x` rounded to `Self` (to nearest).
    fn from_f64(x: f64) -> Self;
    /// `n` as `Self`, rounded to nearest past 2^24 (`f32`) / 2^53 (`f64`).
    fn from_usize(n: usize) -> Self;
}

// Integer operator impls, one block per type. The bodies
// are the primitive `rok.OP.<type>` intrinsics; signed types add Neg.
#[impl_macro(signed_int_ops)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Zero for @t {
                const fn zero() -> @t { 0 }
            }

            impl One for @t {
                const fn one() -> @t { 1 }
            }

            impl Add for @t {
                type Output = @t;
                #[intrinsic("rok.add.@t")]
                const fn add(self, rhs: @t) -> @t { self + rhs }
            }

            impl Sub for @t {
                type Output = @t;
                #[intrinsic("rok.sub.@t")]
                const fn sub(self, rhs: @t) -> @t { self - rhs }
            }

            impl Mul for @t {
                type Output = @t;
                #[intrinsic("rok.mul.@t")]
                const fn mul(self, rhs: @t) -> @t { self * rhs }
            }

            impl Div for @t {
                type Output = @t;
                #[intrinsic("rok.div.@t")]
                const fn div(self, rhs: @t) -> @t { self / rhs }
            }

            impl Rem for @t {
                type Output = @t;
                #[intrinsic("rok.rem.@t")]
                const fn rem(self, rhs: @t) -> @t { self % rhs }
            }

            impl Neg for @t {
                type Output = @t;
                #[intrinsic("rok.neg.@t")]
                const fn neg(self) -> @t { -self }
            }

            impl BitAnd for @t {
                type Output = @t;
                #[intrinsic("rok.and.@t")]
                const fn bitand(self, rhs: @t) -> @t { self & rhs }
            }

            impl BitOr for @t {
                type Output = @t;
                #[intrinsic("rok.or.@t")]
                const fn bitor(self, rhs: @t) -> @t { self | rhs }
            }

            impl BitXor for @t {
                type Output = @t;
                #[intrinsic("rok.xor.@t")]
                const fn bitxor(self, rhs: @t) -> @t { self ^ rhs }
            }

            impl Shl for @t {
                type Output = @t;
                #[intrinsic("rok.shl.@t")]
                const fn shl(self, rhs: @t) -> @t { self << rhs }
            }

            impl Shr for @t {
                type Output = @t;
                #[intrinsic("rok.shr.@t")]
                const fn shr(self, rhs: @t) -> @t { self >> rhs }
            }

            impl BitNot for @t {
                type Output = @t;
                #[intrinsic("rok.not.@t")]
                const fn bitnot(self) -> @t { ~self }
            }

            impl PartialEq for @t {
                #[intrinsic("rok.eq.@t")]
                const fn eq(self, rhs: @t) -> bool { self == rhs }
                #[intrinsic("rok.ne.@t")]
                const fn ne(self, rhs: @t) -> bool { self != rhs }
            }

            impl PartialOrd for @t {
                #[intrinsic("rok.lt.@t")]
                const fn lt(self, rhs: @t) -> bool { self < rhs }
                #[intrinsic("rok.gt.@t")]
                const fn gt(self, rhs: @t) -> bool { self > rhs }
                #[intrinsic("rok.le.@t")]
                const fn le(self, rhs: @t) -> bool { self <= rhs }
                #[intrinsic("rok.ge.@t")]
                const fn ge(self, rhs: @t) -> bool { self >= rhs }
            }

            impl Eq for @t {}

            impl Ord for @t {
                const fn cmp(self, other: @t) -> Ordering {
                    if self < other { return Ordering::Less; }
                    if self > other { return Ordering::Greater; }
                    Ordering::Equal
                }
            }
        }
    }
}
signed_int_ops!(i8, i16, i32, i64, isize);

#[impl_macro(unsigned_int_ops)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Zero for @t {
                const fn zero() -> @t { 0 }
            }

            impl One for @t {
                const fn one() -> @t { 1 }
            }

            impl Add for @t {
                type Output = @t;
                #[intrinsic("rok.add.@t")]
                const fn add(self, rhs: @t) -> @t { self + rhs }
            }

            impl Sub for @t {
                type Output = @t;
                #[intrinsic("rok.sub.@t")]
                const fn sub(self, rhs: @t) -> @t { self - rhs }
            }

            impl Mul for @t {
                type Output = @t;
                #[intrinsic("rok.mul.@t")]
                const fn mul(self, rhs: @t) -> @t { self * rhs }
            }

            impl Div for @t {
                type Output = @t;
                #[intrinsic("rok.div.@t")]
                const fn div(self, rhs: @t) -> @t { self / rhs }
            }

            impl Rem for @t {
                type Output = @t;
                #[intrinsic("rok.rem.@t")]
                const fn rem(self, rhs: @t) -> @t { self % rhs }
            }

            impl BitAnd for @t {
                type Output = @t;
                #[intrinsic("rok.and.@t")]
                const fn bitand(self, rhs: @t) -> @t { self & rhs }
            }

            impl BitOr for @t {
                type Output = @t;
                #[intrinsic("rok.or.@t")]
                const fn bitor(self, rhs: @t) -> @t { self | rhs }
            }

            impl BitXor for @t {
                type Output = @t;
                #[intrinsic("rok.xor.@t")]
                const fn bitxor(self, rhs: @t) -> @t { self ^ rhs }
            }

            impl Shl for @t {
                type Output = @t;
                #[intrinsic("rok.shl.@t")]
                const fn shl(self, rhs: @t) -> @t { self << rhs }
            }

            impl Shr for @t {
                type Output = @t;
                #[intrinsic("rok.shr.@t")]
                const fn shr(self, rhs: @t) -> @t { self >> rhs }
            }

            impl BitNot for @t {
                type Output = @t;
                #[intrinsic("rok.not.@t")]
                const fn bitnot(self) -> @t { ~self }
            }

            impl PartialEq for @t {
                #[intrinsic("rok.eq.@t")]
                const fn eq(self, rhs: @t) -> bool { self == rhs }
                #[intrinsic("rok.ne.@t")]
                const fn ne(self, rhs: @t) -> bool { self != rhs }
            }

            impl PartialOrd for @t {
                #[intrinsic("rok.lt.@t")]
                const fn lt(self, rhs: @t) -> bool { self < rhs }
                #[intrinsic("rok.gt.@t")]
                const fn gt(self, rhs: @t) -> bool { self > rhs }
                #[intrinsic("rok.le.@t")]
                const fn le(self, rhs: @t) -> bool { self <= rhs }
                #[intrinsic("rok.ge.@t")]
                const fn ge(self, rhs: @t) -> bool { self >= rhs }
            }

            impl Eq for @t {}

            impl Ord for @t {
                const fn cmp(self, other: @t) -> Ordering {
                    if self < other { return Ordering::Less; }
                    if self > other { return Ordering::Greater; }
                    Ordering::Equal
                }
            }
        }
    }
}
unsigned_int_ops!(u8, u16, u32, u64, usize);

// `Hash`: each integer writes itself at its own width.
impl Hash for i8 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i8(self) }
}

impl Hash for i16 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i16(self) }
}

impl Hash for i32 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i32(self) }
}

impl Hash for i64 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i64(self) }
}

impl Hash for isize {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_isize(self) }
}

impl Hash for u8 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u8(self) }
}

impl Hash for u16 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u16(self) }
}

impl Hash for u32 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u32(self) }
}

impl Hash for u64 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u64(self) }
}

impl Hash for usize {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_usize(self) }
}

// f32

impl Zero for f32 {
    const fn zero() -> f32 { 0.0f32 }
}

impl One for f32 {
    const fn one() -> f32 { 1.0f32 }
}

impl Add for f32 {
    type Output = f32;
    #[intrinsic("rok.add.f32")]
    const fn add(self, rhs: f32) -> f32 { self + rhs }
}

impl Sub for f32 {
    type Output = f32;
    #[intrinsic("rok.sub.f32")]
    const fn sub(self, rhs: f32) -> f32 { self - rhs }
}

impl Mul for f32 {
    type Output = f32;
    #[intrinsic("rok.mul.f32")]
    const fn mul(self, rhs: f32) -> f32 { self * rhs }
}

impl Div for f32 {
    type Output = f32;
    #[intrinsic("rok.div.f32")]
    const fn div(self, rhs: f32) -> f32 { self / rhs }
}

impl Rem for f32 {
    type Output = f32;
    #[intrinsic("rok.rem.f32")]
    const fn rem(self, rhs: f32) -> f32 { self % rhs }
}

impl Neg for f32 {
    type Output = f32;
    #[intrinsic("rok.neg.f32")]
    const fn neg(self) -> f32 { -self }
}

impl PartialEq for f32 {
    #[intrinsic("rok.eq.f32")]
    const fn eq(self, rhs: f32) -> bool { self == rhs }
    #[intrinsic("rok.ne.f32")]
    const fn ne(self, rhs: f32) -> bool { self != rhs }
}

impl PartialOrd for f32 {
    #[intrinsic("rok.lt.f32")]
    const fn lt(self, rhs: f32) -> bool { self < rhs }
    #[intrinsic("rok.gt.f32")]
    const fn gt(self, rhs: f32) -> bool { self > rhs }
    #[intrinsic("rok.le.f32")]
    const fn le(self, rhs: f32) -> bool { self <= rhs }
    #[intrinsic("rok.ge.f32")]
    const fn ge(self, rhs: f32) -> bool { self >= rhs }
}


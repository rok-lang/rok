}

impl Div for f64 {
    type Output = f64;
    #[intrinsic("rok.div.f64")]
    const fn div(self, rhs: f64) -> f64 { self / rhs }
}

impl Rem for f64 {
    type Output = f64;
    #[intrinsic("rok.rem.f64")]
    const fn rem(self, rhs: f64) -> f64 { self % rhs }
}

impl Neg for f64 {
    type Output = f64;
    #[intrinsic("rok.neg.f64")]
    const fn neg(self) -> f64 { -self }
}

impl PartialEq for f64 {
    #[intrinsic("rok.eq.f64")]
    const fn eq(self, rhs: f64) -> bool { self == rhs }
    #[intrinsic("rok.ne.f64")]
    const fn ne(self, rhs: f64) -> bool { self != rhs }
}

impl PartialOrd for f64 {
    #[intrinsic("rok.lt.f64")]
    const fn lt(self, rhs: f64) -> bool { self < rhs }
    #[intrinsic("rok.gt.f64")]
    const fn gt(self, rhs: f64) -> bool { self > rhs }
    #[intrinsic("rok.le.f64")]

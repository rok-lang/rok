    #[intrinsic("rok.ge.f64")]
    const fn ge(self, rhs: f64) -> bool { self >= rhs }
}

// `!x` on an integer is its bitwise complement, as `~x`.
impl Not for i8 {
    type Output = i8;
    #[intrinsic("rok.not.i8")]
    const fn not(self) -> i8 { ~self }
}
impl Not for i16 {
    type Output = i16;
    #[intrinsic("rok.not.i16")]
    const fn not(self) -> i16 { ~self }
}
impl Not for i32 {
    type Output = i32;
    #[intrinsic("rok.not.i32")]
    const fn not(self) -> i32 { ~self }
}
impl Not for i64 {
    type Output = i64;
    #[intrinsic("rok.not.i64")]
    const fn not(self) -> i64 { ~self }
}
impl Not for isize {
    type Output = isize;
    #[intrinsic("rok.not.isize")]
    const fn not(self) -> isize { ~self }
}
impl Not for u8 {
    type Output = u8;
    #[intrinsic("rok.not.u8")]
    const fn not(self) -> u8 { ~self }
}
impl Not for u16 {
    type Output = u16;
    #[intrinsic("rok.not.u16")]
    const fn not(self) -> u16 { ~self }
}
impl Not for u32 {
    type Output = u32;
    #[intrinsic("rok.not.u32")]
    const fn not(self) -> u32 { ~self }
}
impl Not for u64 {
    type Output = u64;
    #[intrinsic("rok.not.u64")]
    const fn not(self) -> u64 { ~self }
}
impl Not for usize {
    type Output = usize;
    #[intrinsic("rok.not.usize")]
    const fn not(self) -> usize { ~self }
}

// bool

impl BitAnd for bool {
    type Output = bool;
    #[intrinsic("rok.and.bool")]
    const fn bitand(self, rhs: bool) -> bool { self & rhs }
}

impl BitOr for bool {
    type Output = bool;
    #[intrinsic("rok.or.bool")]
    const fn bitor(self, rhs: bool) -> bool { self | rhs }
}

impl BitXor for bool {
    type Output = bool;
    #[intrinsic("rok.xor.bool")]
    const fn bitxor(self, rhs: bool) -> bool { self ^ rhs }
}

impl Not for bool {
    type Output = bool;
    #[intrinsic("rok.not.bool")]
    const fn not(self) -> bool { !self }
}

impl PartialEq for bool {
    #[intrinsic("rok.eq.bool")]
    const fn eq(self, rhs: bool) -> bool { self == rhs }
    #[intrinsic("rok.ne.bool")]
    const fn ne(self, rhs: bool) -> bool { self != rhs }
}

impl Eq for bool {}

/// `false < true`.
impl PartialOrd for bool {
    const fn lt(self, rhs: bool) -> bool { !self && rhs }
    const fn gt(self, rhs: bool) -> bool { self && !rhs }
    const fn le(self, rhs: bool) -> bool { !self || rhs }
    const fn ge(self, rhs: bool) -> bool { self || !rhs }
}

impl Ord for bool {
    const fn cmp(self, other: bool) -> Ordering {
        if self == other { return Ordering::Equal; }
        if other { Ordering::Less } else { Ordering::Greater }
    }
}

impl Hash for bool {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u8(if self { 1u8 } else { 0u8 }) }
}

// char

impl PartialEq for char {
    #[intrinsic("rok.eq.char")]
    const fn eq(self, rhs: char) -> bool { self == rhs }
    #[intrinsic("rok.ne.char")]
    const fn ne(self, rhs: char) -> bool { self != rhs }
}

impl Eq for char {}

impl Hash for char {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u32(self as u32) }
}

// c_char: compared and hashed as its byte.

impl PartialEq for c_char {
    #[intrinsic("rok.eq.c_char")]
    const fn eq(self, rhs: c_char) -> bool { (self as u8) == (rhs as u8) }
    #[intrinsic("rok.ne.c_char")]
    const fn ne(self, rhs: c_char) -> bool { (self as u8) != (rhs as u8) }
}

impl Eq for c_char {}

impl PartialOrd for c_char {
    #[intrinsic("rok.lt.c_char")]
    const fn lt(self, rhs: c_char) -> bool { (self as u8) < (rhs as u8) }
    #[intrinsic("rok.gt.c_char")]
    const fn gt(self, rhs: c_char) -> bool { (self as u8) > (rhs as u8) }
    #[intrinsic("rok.le.c_char")]
    const fn le(self, rhs: c_char) -> bool { (self as u8) <= (rhs as u8) }
    #[intrinsic("rok.ge.c_char")]
    const fn ge(self, rhs: c_char) -> bool { (self as u8) >= (rhs as u8) }
}

impl Ord for c_char {
    const fn cmp(self, other: c_char) -> Ordering { (self as u8).cmp(other as u8) }
}

impl Hash for c_char {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u8(self as u8) }
}

/// The byte as a number (`65`).
impl Debug for c_char {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Debug::fmt(self as u8, ref f) }
}

// `&&` / `||`: on two `bool`s the compiler short-circuits
// without calling these.

impl LogicalAnd for bool {
    const fn logical_and(self, rhs: bool) -> bool { self && rhs }
}

impl LogicalOr for bool {
    const fn logical_or(self, rhs: bool) -> bool { self || rhs }
}

// `Num` for every primitive number type.
impl Num for i8 {}
impl Num for i16 {}
impl Num for i32 {}
impl Num for i64 {}
impl Num for isize {}
impl Num for u8 {}
impl Num for u16 {}
impl Num for u32 {}
impl Num for u64 {}
impl Num for usize {}
impl Num for f32 {}
impl Num for f64 {}

impl FloatingPoint for f32 {
    const NAN: f32 = f32::NAN;
    const INFINITY: f32 = f32::INFINITY;
    const NEG_INFINITY: f32 = f32::NEG_INFINITY;
    const EPSILON: f32 = f32::EPSILON;
    const PI: f32 = f32::PI;
    const E: f32 = f32::E;
    fn abs(self) -> f32 { f32::abs(self) }
    fn sqrt(self) -> f32 { f32::sqrt(self) }
    fn cbrt(self) -> f32 { f32::cbrt(self) }
    fn exp(self) -> f32 { f32::exp(self) }
    fn ln(self) -> f32 { f32::ln(self) }
    fn log2(self) -> f32 { f32::log2(self) }
    fn log10(self) -> f32 { f32::log10(self) }
    fn powi(self, n: i32) -> f32 { f32::powi(self, n) }
    fn pow(self, exp: f32) -> f32 { f32::pow(self, exp) }
    fn sin(self) -> f32 { f32::sin(self) }
    fn cos(self) -> f32 { f32::cos(self) }
    fn tan(self) -> f32 { f32::tan(self) }
    fn asin(self) -> f32 { f32::asin(self) }
    fn acos(self) -> f32 { f32::acos(self) }
    fn atan(self) -> f32 { f32::atan(self) }
    fn atan2(self, other: f32) -> f32 { f32::atan2(self, other) }
    fn sinh(self) -> f32 { f32::sinh(self) }
    fn cosh(self) -> f32 { f32::cosh(self) }
    fn tanh(self) -> f32 { f32::tanh(self) }
    fn hypot(self, other: f32) -> f32 { f32::hypot(self, other) }
    fn floor(self) -> f32 { f32::floor(self) }
    fn ceil(self) -> f32 { f32::ceil(self) }
    fn round(self) -> f32 { f32::round(self) }
    fn trunc(self) -> f32 { f32::trunc(self) }
    fn signum(self) -> f32 { f32::signum(self) }
    fn mul_add(self, a: f32, b: f32) -> f32 { f32::mul_add(self, a, b) }
    fn min(self, other: f32) -> f32 { f32::min(self, other) }
    fn max(self, other: f32) -> f32 { f32::max(self, other) }
    fn is_nan(self) -> bool { f32::is_nan(self) }
    fn is_infinite(self) -> bool { f32::is_infinite(self) }
    fn is_finite(self) -> bool { f32::is_finite(self) }
    fn total_cmp(self, other: f32) -> rok::core::cmp::Ordering { f32::total_cmp(self, other) }
    fn to_f64(self) -> f64 { self as f64 }
    fn from_f64(x: f64) -> f32 { x as f32 }
    fn from_usize(n: usize) -> f32 { n as f32 }
}


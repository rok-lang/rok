}

/// `n` evenly spaced values from `start` to `stop`, both included (one
/// value, `start`, when `n` is 1; none when 0). Value `i` is
/// `start + i * step` with `step = (stop - start) / (n - 1)`, and the
/// last is `stop` exactly. NumPy / Julia: `linspace(start, stop, n)`.
pub fn linspace<T: FloatingPoint>(start: T, stop: T, n: usize) -> List<T> {
    let out: List<T> = List::with_capacity(n);
    if n == 0 {
        return out;
    }
    if n == 1 {
        out.push(start);
        return out;
    }
    let step = (stop - start) / T::from_usize(n - 1);
    for i in 0..n - 1 {
        out.push(start + T::from_usize(i) * step);
    }
    out.push(stop);
    out
}

/// The values `start + i * step` for `i` from 0 while they stay before
/// `stop` (`ceil((stop - start) / step)` of them); each is computed from
/// `i`, so no error builds up. A zero or NaN `step` panics. NumPy:
/// `arange(start, stop, step)`.
#[track_caller]
pub fn arange<T: FloatingPoint>(start: T, stop: T, step: T) -> List<T> {
    if step == T::zero() || step.is_nan() {
        panic("num::arange: step is zero or NaN; pass a step that moves toward `stop`");
    }
    let span = ((stop - start) / step).ceil();
    let out: List<T> = List::new();
    if !(span > T::zero()) {
        return out;
    }
    let n = span.to_f64() as usize;
    for i in 0..n {
        out.push(start + T::from_usize(i) * step);
    }
    out
}

// √: `llvm.intr.sqrt`. The body's `self.sqrt()`
// is itself the intrinsic (a call of an intrinsic method is the op).

impl Sqrt for f64 {
    type Output = f64;
    #[intrinsic("rok.sqrt.f64")]
    const fn sqrt(self) -> f64 { self.sqrt() }
}

impl Sqrt for f32 {
    type Output = f32;
    #[intrinsic("rok.sqrt.f32")]
    const fn sqrt(self) -> f32 { self.sqrt() }
}

// `%%` (`Modulo`): floored - the result takes the divisor's sign;
// unsigned it is `%`.

impl Modulo for i8 {
    type Output = i8;
    #[intrinsic("rok.mod.i8")]
    const fn modulo(self, rhs: i8) -> i8 { self %% rhs }
}

impl Modulo for i16 {
    type Output = i16;
    #[intrinsic("rok.mod.i16")]
    const fn modulo(self, rhs: i16) -> i16 { self %% rhs }
}


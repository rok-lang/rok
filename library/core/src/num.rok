// rok::core::num - the primitive types' operator / comparison trait
// impls (stdlib spec 2.1, 2.3.5, 2.5). They make `T: Add` / `T: Ord`
// bounds accept primitives. Each method is `#[intrinsic("rok.OP.TYPE")]`
// (stdlib spec 0.3): a primitive `a + b` and a by-name call (`x.add(y)`,
// `T::add(a, b)`) both lower to the machine op. The body is the
// fallback (0.3.4) and what a `fn` value of the method runs.
// One block per (type, trait); keep it regular. The inherent methods
// (`checked_add`, `count_ones`, `floor`, ..) live in `ints` / `floats`.

pub mod ints;
pub mod floats;
pub mod bigint;
pub mod bigfloat;
pub mod niche;
pub mod assign;

/// The additive identity - where `Iterator::sum` starts (an empty sum is
/// `0`).
pub trait Zero {
    /// `0` of `Self`.
    fn zero() -> Self;
}

/// The multiplicative identity - where `Iterator::product` starts.
pub trait One {
    /// `1` of `Self`.
    fn one() -> Self;
}

// Integer operator impls, one block per type (spec 6.8.12). The bodies
// are the primitive `rok.OP.<type>` intrinsics; signed types add Neg.
#[impl_macro(signed_int_ops)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Zero for @t {
                const fn zero() -> @t { 0 }
            }

            impl One for @t {
                const fn one() -> @t { 1 }
            }

            impl Add for @t {
                type Output = @t;
                #[intrinsic("rok.add.@t")]
                const fn add(self, rhs: @t) -> @t { self + rhs }
            }

            impl Sub for @t {
                type Output = @t;
                #[intrinsic("rok.sub.@t")]
                const fn sub(self, rhs: @t) -> @t { self - rhs }
            }

            impl Mul for @t {
                type Output = @t;
                #[intrinsic("rok.mul.@t")]
                const fn mul(self, rhs: @t) -> @t { self * rhs }
            }

            impl Div for @t {
                type Output = @t;
                #[intrinsic("rok.div.@t")]
                const fn div(self, rhs: @t) -> @t { self / rhs }
            }

            impl Rem for @t {
                type Output = @t;
                #[intrinsic("rok.rem.@t")]
                const fn rem(self, rhs: @t) -> @t { self % rhs }
            }

            impl Neg for @t {
                type Output = @t;
                #[intrinsic("rok.neg.@t")]
                const fn neg(self) -> @t { -self }
            }

            impl BitAnd for @t {
                type Output = @t;
                #[intrinsic("rok.and.@t")]
                const fn bitand(self, rhs: @t) -> @t { self & rhs }
            }

            impl BitOr for @t {
                type Output = @t;
                #[intrinsic("rok.or.@t")]
                const fn bitor(self, rhs: @t) -> @t { self | rhs }
            }

            impl BitXor for @t {
                type Output = @t;
                #[intrinsic("rok.xor.@t")]
                const fn bitxor(self, rhs: @t) -> @t { self ^ rhs }
            }

            impl Shl for @t {
                type Output = @t;
                #[intrinsic("rok.shl.@t")]
                const fn shl(self, rhs: @t) -> @t { self << rhs }
            }

            impl Shr for @t {
                type Output = @t;
                #[intrinsic("rok.shr.@t")]
                const fn shr(self, rhs: @t) -> @t { self >> rhs }
            }

            impl BitNot for @t {
                type Output = @t;
                #[intrinsic("rok.not.@t")]
                const fn bitnot(self) -> @t { ~self }
            }

            impl PartialEq for @t {
                #[intrinsic("rok.eq.@t")]
                const fn eq(self, rhs: @t) -> bool { self == rhs }
                #[intrinsic("rok.ne.@t")]
                const fn ne(self, rhs: @t) -> bool { self != rhs }
            }

            impl PartialOrd for @t {
                #[intrinsic("rok.lt.@t")]
                const fn lt(self, rhs: @t) -> bool { self < rhs }
                #[intrinsic("rok.gt.@t")]
                const fn gt(self, rhs: @t) -> bool { self > rhs }
                #[intrinsic("rok.le.@t")]
                const fn le(self, rhs: @t) -> bool { self <= rhs }
                #[intrinsic("rok.ge.@t")]
                const fn ge(self, rhs: @t) -> bool { self >= rhs }
            }

            impl Eq for @t {}

            impl Ord for @t {
                const fn cmp(self, other: @t) -> Ordering {
                    if self < other { return Ordering::Less; }
                    if self > other { return Ordering::Greater; }
                    Ordering::Equal
                }
            }
        }
    }
}
signed_int_ops!(i8, i16, i32, i64, isize);

#[impl_macro(unsigned_int_ops)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Zero for @t {
                const fn zero() -> @t { 0 }
            }

            impl One for @t {
                const fn one() -> @t { 1 }
            }

            impl Add for @t {
                type Output = @t;
                #[intrinsic("rok.add.@t")]
                const fn add(self, rhs: @t) -> @t { self + rhs }
            }

            impl Sub for @t {
                type Output = @t;
                #[intrinsic("rok.sub.@t")]
                const fn sub(self, rhs: @t) -> @t { self - rhs }
            }

            impl Mul for @t {
                type Output = @t;
                #[intrinsic("rok.mul.@t")]
                const fn mul(self, rhs: @t) -> @t { self * rhs }
            }

            impl Div for @t {
                type Output = @t;
                #[intrinsic("rok.div.@t")]
                const fn div(self, rhs: @t) -> @t { self / rhs }
            }

            impl Rem for @t {
                type Output = @t;
                #[intrinsic("rok.rem.@t")]
                const fn rem(self, rhs: @t) -> @t { self % rhs }
            }

            impl BitAnd for @t {
                type Output = @t;
                #[intrinsic("rok.and.@t")]
                const fn bitand(self, rhs: @t) -> @t { self & rhs }
            }

            impl BitOr for @t {
                type Output = @t;
                #[intrinsic("rok.or.@t")]
                const fn bitor(self, rhs: @t) -> @t { self | rhs }
            }

            impl BitXor for @t {
                type Output = @t;
                #[intrinsic("rok.xor.@t")]
                const fn bitxor(self, rhs: @t) -> @t { self ^ rhs }
            }

            impl Shl for @t {
                type Output = @t;
                #[intrinsic("rok.shl.@t")]
                const fn shl(self, rhs: @t) -> @t { self << rhs }
            }

            impl Shr for @t {
                type Output = @t;
                #[intrinsic("rok.shr.@t")]
                const fn shr(self, rhs: @t) -> @t { self >> rhs }
            }

            impl BitNot for @t {
                type Output = @t;
                #[intrinsic("rok.not.@t")]
                const fn bitnot(self) -> @t { ~self }
            }

            impl PartialEq for @t {
                #[intrinsic("rok.eq.@t")]
                const fn eq(self, rhs: @t) -> bool { self == rhs }
                #[intrinsic("rok.ne.@t")]
                const fn ne(self, rhs: @t) -> bool { self != rhs }
            }

            impl PartialOrd for @t {
                #[intrinsic("rok.lt.@t")]
                const fn lt(self, rhs: @t) -> bool { self < rhs }
                #[intrinsic("rok.gt.@t")]
                const fn gt(self, rhs: @t) -> bool { self > rhs }
                #[intrinsic("rok.le.@t")]
                const fn le(self, rhs: @t) -> bool { self <= rhs }
                #[intrinsic("rok.ge.@t")]
                const fn ge(self, rhs: @t) -> bool { self >= rhs }
            }

            impl Eq for @t {}

            impl Ord for @t {
                const fn cmp(self, other: @t) -> Ordering {
                    if self < other { return Ordering::Less; }
                    if self > other { return Ordering::Greater; }
                    Ordering::Equal
                }
            }
        }
    }
}
unsigned_int_ops!(u8, u16, u32, u64, usize);

// `Hash`: each integer writes itself at its own width (2.5.6).
impl Hash for i8 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i8(self) }
}

impl Hash for i16 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i16(self) }
}

impl Hash for i32 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i32(self) }
}

impl Hash for i64 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_i64(self) }
}

impl Hash for isize {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_isize(self) }
}

impl Hash for u8 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u8(self) }
}

impl Hash for u16 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u16(self) }
}

impl Hash for u32 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u32(self) }
}

impl Hash for u64 {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_u64(self) }
}

impl Hash for usize {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_usize(self) }
}

// f32

impl Zero for f32 {
    const fn zero() -> f32 { 0.0f32 }
}

impl One for f32 {
    const fn one() -> f32 { 1.0f32 }
}

impl Add for f32 {
    type Output = f32;
    #[intrinsic("rok.add.f32")]
    const fn add(self, rhs: f32) -> f32 { self + rhs }
}

impl Sub for f32 {
    type Output = f32;
    #[intrinsic("rok.sub.f32")]
    const fn sub(self, rhs: f32) -> f32 { self - rhs }
}

impl Mul for f32 {
    type Output = f32;
    #[intrinsic("rok.mul.f32")]
    const fn mul(self, rhs: f32) -> f32 { self * rhs }
}

impl Div for f32 {
    type Output = f32;
    #[intrinsic("rok.div.f32")]
    const fn div(self, rhs: f32) -> f32 { self / rhs }
}

impl Rem for f32 {
    type Output = f32;
    #[intrinsic("rok.rem.f32")]
    const fn rem(self, rhs: f32) -> f32 { self % rhs }
}

impl Neg for f32 {
    type Output = f32;
    #[intrinsic("rok.neg.f32")]
    const fn neg(self) -> f32 { -self }
}

impl PartialEq for f32 {
    #[intrinsic("rok.eq.f32")]
    const fn eq(self, rhs: f32) -> bool { self == rhs }
    #[intrinsic("rok.ne.f32")]
    const fn ne(self, rhs: f32) -> bool { self != rhs }
}

impl PartialOrd for f32 {
    #[intrinsic("rok.lt.f32")]
    const fn lt(self, rhs: f32) -> bool { self < rhs }
    #[intrinsic("rok.gt.f32")]
    const fn gt(self, rhs: f32) -> bool { self > rhs }
    #[intrinsic("rok.le.f32")]
    const fn le(self, rhs: f32) -> bool { self <= rhs }
    #[intrinsic("rok.ge.f32")]
    const fn ge(self, rhs: f32) -> bool { self >= rhs }
}


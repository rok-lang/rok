// rok::core::str - `str` methods and trait impls (stdlib 2.15).
//
// `str` is an immutable `(ptr, len)` value (2.15.1): literals are static
// bytes, run-time strings GC objects, and a slice shares its source's
// bytes, so slicing, `lines`, `split*`, `match_indices`, `trim*` and
// `strip_*` copy nothing. `StrBuf` is the growable buffer.

use rok::core::marker::{Memo, Transfer, buf_is_null};

impl str {
    pub const fn new() -> str { "" }

    /// `bytes` as a `str`; throws if they are not UTF-8 (2.15.6).
    pub const fn from_utf8(bytes: List<u8> | Slice<u8>) throws (Utf8Error) -> str {
        let view = match bytes {
            l: List<u8> => l[0:l.len()],
            v: Slice<u8> => v,
        };
        let (buf, at, n) = unsafe { view.raw_parts() };
        let bad = unsafe { rok_buf_utf8_error(buf, at, n) };
        if bad >= 0 { throw Utf8Error { valid_up_to: bad as usize }; }
        unsafe { rok_str_from_buf(buf, at, n) }
    }

    /// `bytes` as a `str` with each ill-formed run replaced by U+FFFD,
    /// one per maximal subpart (Unicode 3.9 "U+FFFD Substitution of
    /// Maximal Subparts", as WHATWG UTF-8 decode does).
    pub const fn from_utf8_lossy(bytes: List<u8> | Slice<u8>) -> str {
        let view = match bytes {
            l: List<u8> => l[0:l.len()],
            v: Slice<u8> => v,
        };
        let (buf, at, n) = unsafe { view.raw_parts() };
        let first = unsafe { rok_buf_utf8_error(buf, at, n) };
        if first < 0 {
            return unsafe { rok_str_from_buf(buf, at, n) };
        }
        let out = StrBuf::with_capacity(n + 2);
        let i: usize = 0;
        let bad = first;
        while i < n {
            if bad < 0 {
                out.push_str(unsafe { rok_str_from_buf(buf, at + i, n - i) });
                break;
            }
            let b = bad as usize;
            out.push_str(unsafe { rok_str_from_buf(buf, at + i, b) });
            out.push('\u{FFFD}');
            i += b + bad_run(buf, at + i + b, at + n);
            if i < n {
                bad = unsafe { rok_buf_utf8_error(buf, at + i, n - i) };
            }
        }
        out.to_str()
    }

    /// The UTF-8 bytes as a read-only view of the string itself (no
    /// copy, O(1)).
    pub fn as_bytes(self) -> Slice<u8> {
        Slice { buf: unsafe { rok_str_bytes_buf(self) }, start: 0, len: self.len(), stride: 1, whole: false }
    }

    /// The first byte's address, for FFI (`len()` bytes, no NUL
    /// promised; an empty `str` gives a dangling pointer). Valid while a
    /// variable holding the string is in scope in a function where a
    /// pointer type appears (2.15.2); pin it to keep it longer.
    pub fn as_ptr(self) -> rok::bare::ptr::ConstPtr<u8> {
        let p = rok::bare::ptr::ConstPtr::<u8>::dangling();
        if self.is_empty() { p } else { p.with_addr(unsafe { rok_str_addr(self) }) }
    }

    /// Byte `i`, O(1); panics if `i >= len()`.
    #[track_caller]
    pub const fn byte(self, i: usize) -> u8 {
        if i >= self.len() { index_oob("str::byte: index", i, self.len()); }
        unsafe { rok_str_byte(self, i) }
    }

    /// Byte length (not the char count).
    pub const fn len(self) -> usize { unsafe { rok_str_len(self) } }
    pub const fn is_empty(self) -> bool { unsafe { rok_str_len(self) } == 0 }
    /// Number of chars (`s.chars().count()` in the spec).
    pub const fn char_count(self) -> usize { unsafe { rok_str_char_count(self) } }

    pub const fn contains(self, pat: str) -> bool { unsafe { rok_str_find(self, pat) } >= 0 }
    pub const fn starts_with(self, pat: str) -> bool { unsafe { rok_str_eq_at(self, 0, pat) } != 0 }
    pub const fn ends_with(self, pat: str) -> bool {
        let n = self.len();
        let m = pat.len();
        m <= n && unsafe { rok_str_eq_at(self, n - m, pat) } != 0
    }
    pub const fn find(self, pat: str) -> usize | none {
        let i = unsafe { rok_str_find(self, pat) };
        if i < 0 { return none; }
        i as usize
    }
    pub const fn rfind(self, pat: str) -> usize | none {
        let i = unsafe { rok_str_rfind(self, pat) };
        if i < 0 { return none; }
        i as usize
    }

    /// `self` without a leading `prefix`, or `none` if it does not start
    /// with it.
    pub const fn strip_prefix(self, prefix: str) -> str | none {
        if !self.starts_with(prefix) { return none; }
        self[prefix.len():]
    }
    /// `self` without a trailing `suffix`, or `none`.
    pub const fn strip_suffix(self, suffix: str) -> str | none {
        if !self.ends_with(suffix) { return none; }
        self[:self.len() - suffix.len()]
    }
    /// The pieces before and after the first `sep`, or `none`.
    pub const fn split_once(self, sep: str) -> (str, str) | none {
        let i = self.find(sep)?;
        (self[:i], self[i + sep.len():])
    }
    /// `n` copies back to back.
    #[track_caller]
    pub const fn repeat(self, n: usize) -> str {
        let b = StrBuf::with_capacity(cap_mul(self.len(), n));
        for _ in 0..n { b.push_str(self); }
        b.to_str()
    }

    pub const fn trim(self) -> str { unsafe { rok_str_trim(self, 0) } }
    pub const fn trim_start(self) -> str { unsafe { rok_str_trim(self, 1) } }
    pub const fn trim_end(self) -> str { unsafe { rok_str_trim(self, 2) } }
    /// `self` without every leading and trailing repeat of `pat`.
    pub const fn trim_matches(self, pat: str) -> str { self.trim_start_matches(pat).trim_end_matches(pat) }
    pub const fn trim_start_matches(self, pat: str) -> str {
        let m = pat.len();
        if m == 0 { return self; }
        let i = 0usize;
        while i + m <= self.len() && unsafe { rok_str_eq_at(self, i, pat) } != 0 { i += m; }
        self[i:]
    }
    pub const fn trim_end_matches(self, pat: str) -> str {
        let m = pat.len();
        if m == 0 { return self; }
        let j = self.len();
        while j >= m && unsafe { rok_str_eq_at(self, j - m, pat) } != 0 { j -= m; }
        self[:j]
    }

    /// Full Unicode case mapping (`"ß"` → `"SS"`, final `σ` → `ς`); no
    /// locale rules.
    pub const fn to_lowercase(self) -> str { unsafe { rok_str_case(self, 0) } }
    pub const fn to_uppercase(self) -> str { unsafe { rok_str_case(self, 1) } }
    pub const fn replace(self, from: str, to: str) -> str { unsafe { rok_str_replace(self, from, to) } }

    /// Unicode scalar values, in order.
    pub const fn chars(self) -> CharsIter { CharsIter { s: self, pos: 0 } }
    /// UTF-8 bytes, in order.
    pub fn bytes(self) -> BytesIter { self.as_bytes().iter() }
    /// The pieces between occurrences of `sep` (all of them, empty ones
    /// included).
    pub const fn split(self, sep: str) -> SplitIter { SplitIter { rest: self, sep: sep, done: false } }
    /// At most `n` pieces split on `sep` from the start; the last one is
    /// the unsplit rest (`n == 0` yields nothing).
    pub const fn splitn(self, n: usize, sep: str) -> SplitNIter { SplitNIter { rest: self, sep: sep, left: n } }
    /// The pieces `split` yields, last first.
    pub const fn rsplit(self, sep: str) -> RSplitIter { RSplitIter { rest: self, sep: sep, done: false } }
    /// At most `n` pieces split on `sep` from the end, last first; the
    /// final one is the unsplit start.
    pub const fn rsplitn(self, n: usize, sep: str) -> RSplitNIter { RSplitNIter { rest: self, sep: sep, left: n } }
    /// `(byte offset, match)` for each non-overlapping `pat`, left to
    /// right; an empty `pat` matches nothing.
    pub const fn match_indices(self, pat: str) -> MatchIndicesIter {
        MatchIndicesIter { s: self, pat: pat, pos: 0 }
    }
    /// Lines without their `\n` / `\r\n`; a final line ending adds no
    /// empty line.
    pub const fn lines(self) -> LinesIter { LinesIter { rest: self } }
    /// `(byte offset, char)` pairs.
    pub const fn char_indices(self) -> CharIndicesIter {
        CharIndicesIter { chars: CharsIter { s: self, pos: 0 } }
    }
    /// The non-empty pieces between runs of Unicode `White_Space` (the
    /// set `trim` strips).
    pub const fn split_whitespace(self) -> SplitWhitespaceIter {
        SplitWhitespaceIter { s: self, pos: 0 }
    }

    /// `T`'s value spelled by this string (stdlib 2.15.7).
    pub const fn parse<T: FromStr>(self) throws (T::Err) -> T { try T::from_str(self) }
}

/// `s[a:b]` by byte offsets (2.15.3): O(1), sharing `s`'s bytes. The
/// bounds clamp to the length (like Python); a clamped bound off a char
/// boundary panics.
impl Sliceable<Range<usize>> for str {
    type Output = str;
    #[track_caller]
    const fn slice(self, r: Range<usize>) -> str {
        let r = clamp_range(r, self.len());
        unsafe { rok_str_slice(self, r.start, r.end) }
    }
}

impl Add for str {
    type Output = str;
    const fn add(self, rhs: str) -> str { unsafe { rok_str_concat(self, rhs) } }
}

impl PartialEq for str {
    const fn eq(self, rhs: str) -> bool { unsafe { rok_str_eq(self, rhs) } != 0 }
    const fn ne(self, rhs: str) -> bool { unsafe { rok_str_eq(self, rhs) } == 0 }
}

impl PartialOrd for str {
    const fn lt(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } < 0 }
    const fn gt(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } > 0 }
    const fn le(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } <= 0 }
    const fn ge(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } >= 0 }
}

impl Eq for str {}

impl Ord for str {
    const fn cmp(self, other: str) -> Ordering {
        let c = unsafe { rok_str_cmp(self, other) };
        if c < 0 { return Ordering::Less; }
        if c > 0 { return Ordering::Greater; }
        Ordering::Equal
    }
}

/// Byte-wise FNV-1a, so `str` keys work in `Dict` / `Set`.
impl Hash for str {
    const fn hash(self) -> u64 { unsafe { rok_str_hash(self) } }
}

// Iterators (stdlib 2.15.3).

/// What `s.bytes()` returns (2.15.1): the bytes of the `as_bytes` view.
pub type BytesIter = SliceIter<u8>;

pub struct CharsIter {
    s: str;
    pos: usize;
}

impl Iterator for CharsIter {
    type Item = char;
    const fn next(ref self) -> char | none {
        if self.pos >= self.s.len() { return none; }
        let b = unsafe { rok_str_byte(self.s, self.pos) } as u32;
        let n = 1usize;
        let c = b;
        if b >= 0xF0u32 {
            n = 4usize;
            c = b & 0x07u32;
        } else if b >= 0xE0u32 {
            n = 3usize;
            c = b & 0x0Fu32;
        } else if b >= 0xC0u32 {
            n = 2usize;
            c = b & 0x1Fu32;
        }
        for i in 1..n {
            let cont = unsafe { rok_str_byte(self.s, self.pos + i) } as u32;
            c = (c << 6u32) | (cont & 0x3Fu32);
        }
        self.pos += n;
        unsafe { char::from_u32_unchecked(c) }
    }
}

pub struct SplitIter {
    rest: str;
    sep: str;
    done: bool;
}

impl Iterator for SplitIter {
    type Item = str;
    const fn next(ref self) -> str | none {
        if self.done { return none; }
        let at = unsafe { rok_str_find(self.rest, self.sep) };
        if at < 0 || self.sep.len() == 0 {
            self.done = true;
            return self.rest;
        }
        let i = at as usize;
        let piece = self.rest[:i];
        self.rest = self.rest[i + self.sep.len():];
        piece
    }
}

pub struct SplitNIter {
    rest: str;
    sep: str;
    left: usize;
}

impl Iterator for SplitNIter {
    type Item = str;
    const fn next(ref self) -> str | none {
        if self.left == 0 { return none; }
        self.left -= 1;
        let at = unsafe { rok_str_find(self.rest, self.sep) };
        if self.left == 0 || at < 0 || self.sep.len() == 0 {
            self.left = 0;
            return self.rest;
        }
        let i = at as usize;
        let piece = self.rest[:i];
        self.rest = self.rest[i + self.sep.len():];
        piece
    }
}

pub struct RSplitIter {
    rest: str;
    sep: str;
    done: bool;
}

impl Iterator for RSplitIter {
    type Item = str;
    const fn next(ref self) -> str | none {
        if self.done { return none; }
        if self.sep.len() == 0 {
            self.done = true;
            return self.rest;
        }
        let at = unsafe { rok_str_rfind(self.rest, self.sep) };
        if at < 0 {
            self.done = true;
            return self.rest;
        }
        let i = at as usize;
        let piece = self.rest[i + self.sep.len():];
        self.rest = self.rest[:i];
        piece
    }
}

pub struct RSplitNIter {
    rest: str;
    sep: str;
    left: usize;
}

impl Iterator for RSplitNIter {
    type Item = str;
    const fn next(ref self) -> str | none {
        if self.left == 0 { return none; }
        self.left -= 1;
        if self.left == 0 || self.sep.len() == 0 {
            self.left = 0;
            return self.rest;
        }
        let at = unsafe { rok_str_rfind(self.rest, self.sep) };
        if at < 0 {
            self.left = 0;
            return self.rest;
        }
        let i = at as usize;
        let piece = self.rest[i + self.sep.len():];
        self.rest = self.rest[:i];
        piece
    }
}

pub struct MatchIndicesIter {
    s: str;
    pat: str;
    pos: usize;
}

impl Iterator for MatchIndicesIter {
    type Item = (usize, str);
    const fn next(ref self) -> (usize, str) | none {
        let m = self.pat.len();
        if m == 0 { return none; }
        let at = unsafe { rok_str_find(self.s[self.pos:], self.pat) };
        if at < 0 { return none; }
        let i = self.pos + at as usize;
        self.pos = i + m;
        (i, self.s[i:i + m])
    }
}

pub struct LinesIter {
    rest: str;
}

impl Iterator for LinesIter {
    type Item = str;
    const fn next(ref self) -> str | none {
        if self.rest.len() == 0 { return none; }
        let at = unsafe { rok_str_find(self.rest, "\n") };
        let line = self.rest;
        if at < 0 {
            self.rest = "";
        } else {
            let i = at as usize;
            line = self.rest[:i];
            self.rest = self.rest[i + 1:];
        }
        if line.ends_with("\r") { return line[:line.len() - 1]; }
        line
    }
}

pub struct CharIndicesIter {
    chars: CharsIter;
}

impl Iterator for CharIndicesIter {
    type Item = (usize, char);
    const fn next(ref self) -> (usize, char) | none {
        let at = self.chars.pos;
        let c = self.chars.next()?;
        (at, c)
    }
}

/// Length of the maximal subpart at `buf[i]`, an ill-formed sequence
/// ending before `end`: the lead byte and the continuation bytes that
/// still fit a well-formed sequence (Unicode Table 3-7), at least 1.
const fn bad_run(buf: GcBuf<u8>, i: usize, end: usize) -> usize {
    unsafe {
        let b = buf[i];
        let (lo, hi, more) = if b >= 0xC2u8 && b <= 0xDFu8 {
            (0x80u8, 0xBFu8, 1usize)
        } else if b == 0xE0u8 {
            (0xA0u8, 0xBFu8, 2usize)
        } else if b == 0xEDu8 {
            (0x80u8, 0x9Fu8, 2usize)
        } else if b >= 0xE1u8 && b <= 0xEFu8 {
            (0x80u8, 0xBFu8, 2usize)
        } else if b == 0xF0u8 {
            (0x90u8, 0xBFu8, 3usize)
        } else if b >= 0xF1u8 && b <= 0xF3u8 {
            (0x80u8, 0xBFu8, 3usize)
        } else if b == 0xF4u8 {
            (0x80u8, 0x8Fu8, 3usize)
        } else {
            return 1;
        };
        if i + 1 >= end || buf[i + 1] < lo || buf[i + 1] > hi {
            return 1;
        }
        let k: usize = 2;
        while k <= more && i + k < end && buf[i + k] >= 0x80u8 && buf[i + k] <= 0xBFu8 {
            k += 1;
        }
        k
    }
}

/// Byte length of the `White_Space` char starting at byte `pos`, 0 when
/// it is not one (a continuation byte is not).
const fn space_at(s: str, pos: usize) -> usize {
    let b = unsafe { rok_str_byte(s, pos) };
    if b < 0x80u8 {
        return if b == 32u8 || (b >= 9u8 && b <= 13u8) { 1usize } else { 0usize };
    }
    space_at_wide(s, pos, b)
}

// Out of line: inlined, it makes `space_at` too big to inline into the
// iterators' loops.
#[inline(never)]
const fn space_at_wide(s: str, pos: usize, b: u8) -> usize {
    if b < 0xC0u8 { return 0usize; }
    let it = CharsIter { s: s, pos: pos };
    let c: char = it.next() else { return 0usize; };
    if c.is_whitespace() { it.pos - pos } else { 0usize }
}

pub struct SplitWhitespaceIter {
    s: str;
    pos: usize;
}

impl Iterator for SplitWhitespaceIter {
    type Item = str;
    const fn next(ref self) -> str | none {
        let s = self.s;
        let n = s.len();
        let pos = self.pos;
        loop {
            if pos >= n {
                self.pos = pos;
                return none;
            }
            let w = space_at(s, pos);
            if w == 0usize { break; }
            pos += w;
        }
        let start = pos;
        pos += 1usize;
        while pos < n && space_at(s, pos) == 0usize {
            pos += 1usize;
        }
        self.pos = pos;
        s[start:pos]
    }
}

// `char` (stdlib 2.15.4).
//
// The Unicode properties and case maps are runtime tables generated
// from the UCD (`runtime/rokr/gen_unicode.py`).

const fn char_props(c: char) -> u32 { unsafe { rok_char_props(c as u32) } }

/// The bits of a `char` (`char::from_u32_unchecked`).
union CharBits {
    n: u32;
    c: char;
}

impl char {
    /// `n` as a char; `none` for a surrogate or a value past U+10FFFF.
    /// (`as char` takes only a `u8`.)
    pub const fn from_u32(n: u32) -> char | none {
        if (n >= 0xD800u32 && n <= 0xDFFFu32) || n > 0x10FFFFu32 {
            return none;
        }
        unsafe { char::from_u32_unchecked(n) }
    }

    /// `n` as a char, unchecked: `n` must be a Unicode scalar value.
    pub const unsafe fn from_u32_unchecked(n: u32) -> char {
        let b = CharBits { n: n };
        unsafe { b.c }
    }

    /// Digit `d` in base `radix` (lowercase letters past `9`); `none`
    /// if `d` is not a digit of that base. Panics unless `radix` is in
    /// 2..=36.
    #[track_caller]
    pub const fn from_digit(d: u32, radix: u32) -> char | none {
        if radix < 2u32 || radix > 36u32 { panic(f"char::from_digit: radix {radix} is not in 2..=36"); }
        if d >= radix { return none; }
        if d < 10u32 { return (0x30u8 + d as u8) as char; }
        (0x61u8 + d as u8 - 10u8) as char
    }

    /// The value of this digit in base `radix` (either letter case);
    /// `none` if it is not one. Panics unless `radix` is in 2..=36.
    #[track_caller]
    pub const fn to_digit(self, radix: u32) -> u32 | none {
        if radix < 2u32 || radix > 36u32 { panic(f"char::to_digit: radix {radix} is not in 2..=36"); }
        let c = self as u32;
        let d = 99u32;
        if c >= 0x30u32 && c <= 0x39u32 {
            d = c - 0x30u32;
        } else if c >= 0x61u32 && c <= 0x7Au32 {
            d = c - 0x61u32 + 10u32;
        } else if c >= 0x41u32 && c <= 0x5Au32 {
            d = c - 0x41u32 + 10u32;
        }
        if d >= radix { return none; }
        d
    }

    /// Panics unless `radix` is in 2..=36.
    #[track_caller]
    pub const fn is_digit(self, radix: u32) -> bool { !(self.to_digit(radix) is none) }

    /// Bytes in UTF-8.
    pub const fn len_utf8(self) -> usize {
        let c = self as u32;
        if c < 0x80u32 { return 1; }
        if c < 0x800u32 { return 2; }
        if c < 0x10000u32 { return 3; }
        4
    }

    /// 16-bit units in UTF-16.
    pub const fn len_utf16(self) -> usize {
        if (self as u32) < 0x10000u32 { return 1; }
        2
    }

    pub const fn is_alphabetic(self) -> bool { char_props(self) & 1u32 != 0u32 }
    pub const fn is_lowercase(self) -> bool { char_props(self) & 2u32 != 0u32 }
    pub const fn is_uppercase(self) -> bool { char_props(self) & 4u32 != 0u32 }
    /// Unicode `White_Space`.
    pub const fn is_whitespace(self) -> bool { char_props(self) & 8u32 != 0u32 }
    /// General category `Nd`, `Nl` or `No`.
    pub const fn is_numeric(self) -> bool { char_props(self) & 16u32 != 0u32 }
    pub const fn is_alphanumeric(self) -> bool { char_props(self) & 17u32 != 0u32 }
    /// General category `Cc`.
    pub const fn is_control(self) -> bool {
        let c = self as u32;
        c < 0x20u32 || (c >= 0x7Fu32 && c < 0xA0u32)
    }

    /// The full lowercase mapping, which may be several chars
    /// (`'\u{130}'` → `"i\u{307}"`); locale-independent.
    pub const fn to_lowercase(self) -> str { unsafe { rok_str_case(rok_str_from_char(self as u32), 0) } }
    /// The full uppercase mapping, which may be several chars (`'ß'` →
    /// `"SS"`).
    pub const fn to_uppercase(self) -> str { unsafe { rok_str_case(rok_str_from_char(self as u32), 1) } }
    /// The full titlecase mapping, which may be several chars (`'ß'` →
    /// `"Ss"`, `'ǆ'` → `"ǅ"`). Capitalize a word with
    /// `c.to_titlecase() + rest.to_lowercase()`.
    pub const fn to_titlecase(self) -> str { unsafe { rok_str_case(rok_str_from_char(self as u32), 2) } }
    /// The simple (one-char) lowercase mapping (UCD `slc`); `self` if
    /// none.
    pub const fn to_simple_lowercase(self) -> char {
        unsafe { char::from_u32_unchecked(rok_char_to_case(self as u32, 0)) }
    }
    /// The simple (one-char) uppercase mapping (UCD `suc`; `'ß'` stays
    /// `'ß'`); `self` if none.
    pub const fn to_simple_uppercase(self) -> char {
        unsafe { char::from_u32_unchecked(rok_char_to_case(self as u32, 1)) }
    }
    /// The simple (one-char) titlecase mapping (UCD `stc`; `'ǆ'` →
    /// `'ǅ'`); `self` if none.
    pub const fn to_simple_titlecase(self) -> char {
        unsafe { char::from_u32_unchecked(rok_char_to_case(self as u32, 2)) }
    }

    pub const fn is_ascii(self) -> bool { (self as u32) < 0x80u32 }
    pub const fn is_ascii_uppercase(self) -> bool { self >= 'A' && self <= 'Z' }
    pub const fn is_ascii_lowercase(self) -> bool { self >= 'a' && self <= 'z' }
    pub const fn is_ascii_alphabetic(self) -> bool { self.is_ascii_uppercase() || self.is_ascii_lowercase() }
    pub const fn is_ascii_digit(self) -> bool { self >= '0' && self <= '9' }
    pub const fn is_ascii_alphanumeric(self) -> bool { self.is_ascii_alphabetic() || self.is_ascii_digit() }
    pub const fn is_ascii_hexdigit(self) -> bool {
        self.is_ascii_digit() || (self >= 'a' && self <= 'f') || (self >= 'A' && self <= 'F')
    }
    /// Space, `\t`, `\n`, form feed, `\r`.
    pub const fn is_ascii_whitespace(self) -> bool {
        self == ' ' || self == '\t' || self == '\n' || self == '\x0C' || self == '\r'
    }
    pub const fn is_ascii_control(self) -> bool { (self as u32) < 0x20u32 || self == '\x7F' }
    /// `!` ..= `~` (printable, not space).
    pub const fn is_ascii_graphic(self) -> bool { self >= '!' && self <= '~' }
    pub const fn is_ascii_punctuation(self) -> bool { self.is_ascii_graphic() && !self.is_ascii_alphanumeric() }

    pub const fn to_ascii_uppercase(self) -> char {
        if self.is_ascii_lowercase() { return ((self as u8) - 32u8) as char; }
        self
    }
    pub const fn to_ascii_lowercase(self) -> char {
        if self.is_ascii_uppercase() { return ((self as u8) + 32u8) as char; }
        self
    }
    pub const fn eq_ignore_ascii_case(self, other: char) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }
}

/// Code point order.
impl PartialOrd for char {
    const fn lt(self, rhs: char) -> bool { (self as u32) < (rhs as u32) }
    const fn le(self, rhs: char) -> bool { (self as u32) <= (rhs as u32) }
    const fn gt(self, rhs: char) -> bool { (self as u32) > (rhs as u32) }
    const fn ge(self, rhs: char) -> bool { (self as u32) >= (rhs as u32) }
}

impl Ord for char {
    const fn cmp(self, other: char) -> Ordering { (self as u32).cmp(other as u32) }
}

/// `char::try_from(n)` (2.15.4): throws for a surrogate or a value past
/// U+10FFFF (`OverflowError`, as spec 2.15.4 says).
impl TryFrom<u32> for char {
    type Error = OverflowError;
    const fn try_from(value: u32) throws (OverflowError) -> char {
        let c = char::from_u32(value);
        if c is char { return c; }
        throw OverflowError::new("try_from", "char");
    }
}

// `StrBuf` (stdlib 2.15.2).

/// A growable UTF-8 buffer. A handle like the collections: copies
/// share the buffer, one object holding the length, the capacity and
/// the bytes.
pub struct StrBuf {
    h: GcBuf<StrBufHead>;
}

struct StrBufHead {
    len: usize;
    cap: usize;
    bytes: GcBuf<u8>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl !Sync for StrBuf {}

impl StrBuf {
    pub const fn new() -> StrBuf { StrBuf::with_capacity(16) }

    #[track_caller]
    pub const fn with_capacity(cap: usize) -> StrBuf {
        unsafe {
            let h: GcBuf<StrBufHead> = buf_new(1);
            h[0] = StrBufHead { len: 0, cap, bytes: buf_new(buf_len(cap, 1)) };
            StrBuf { h }
        }
    }

    /// Byte length.
    pub const fn len(self) -> usize {
        unsafe {
            self.h[0].len
        }
    }
    pub const fn is_empty(self) -> bool { self.len() == 0 }
    pub const fn capacity(self) -> usize {
        unsafe {
            self.h[0].cap
        }
    }
    pub const fn clear(self) {
        unsafe {
            self.h[0].len = 0;
        }
    }

    /// Room for `additional` more bytes (doubling).
    #[track_caller]
    pub const fn reserve(self, additional: usize) {
        unsafe {
            let n = self.len();
            let cap = self.capacity();
            let need = cap_add(n, additional);
            if need <= cap { return; }
            let new_cap = cap.saturating_mul(2).max(need);
            let store: GcBuf<u8> = buf_new(buf_len(new_cap, 1));
            rok_buf_copy(store, 0, self.h[0].bytes, 0, n);
            self.h[0].bytes = store;
            self.h[0].cap = new_cap;
        }
    }

    // The appends grow the buffer out of line (`*_grown`): an append
    // that fits reaches no safepoint, so it keeps no frame.

    /// Append `c`, UTF-8 encoded.
    pub const fn push(self, c: char) {
        unsafe {
            let n = self.len();
            if self.capacity() - n < 4 {
                return self.push_grown(c);
            }
            self.h[0].len = n + rok_buf_put_char(self.h[0].bytes, n, c as u32);
        }
    }

    #[cold]
    const fn push_grown(self, c: char) {
        unsafe {
            self.reserve(4);
            let n = self.len();
            self.h[0].len = n + rok_buf_put_char(self.h[0].bytes, n, c as u32);
        }
    }

    pub const fn push_str(self, s: str) {
        unsafe {
            let m = s.len();
            let n = self.len();
            if self.capacity() - n < m {
                return self.push_str_grown(s);
            }
            rok_buf_put_str(self.h[0].bytes, n, s);
            self.h[0].len = n + m;
        }
    }

    #[cold]
    const fn push_str_grown(self, s: str) {
        unsafe {
            let m = s.len();
            self.reserve(m);
            let n = self.len();
            rok_buf_put_str(self.h[0].bytes, n, s);
            self.h[0].len = n + m;
        }
    }

    /// Append one byte. `unsafe`: `to_str` hands out the bytes as a
    /// `str`, which must be UTF-8 (2.15.1); the caller keeps them so by
    /// the time it is called. Bytes of unknown encoding go through
    /// `str::from_utf8`.
    pub const unsafe fn push_byte(self, b: u8) {
        let n = self.len();
        if n == self.capacity() {
            return self.push_byte_grown(b);
        }
        self.h[0].bytes[n] = b;
        self.h[0].len = n + 1;
    }

    const unsafe fn push_byte_grown(self, b: u8) {
        let n = self.len();
        self.reserve(1);
        self.h[0].bytes[n] = b;
        self.h[0].len = n + 1;
    }

    /// The current contents as an immutable `str` (a copy).
    pub const fn to_str(self) -> str {
        unsafe { rok_str_from_buf(self.h[0].bytes, 0, self.len()) }
    }
}

/// `b[a:b]`: the bytes `a..b` of the current contents as a new `str`,
/// checked like `str` slicing (clamped). O(b - a): only the range is
/// copied, so later edits of the buffer never show through (2.15.1).
impl Sliceable<Range<usize>> for StrBuf {
    type Output = str;
    #[track_caller]
    const fn slice(self, r: Range<usize>) -> str {
        let n = self.len();
        let r = clamp_range(r, n);
        unsafe { rok_buf_slice_str(self.h[0].bytes, n, r.start, r.end) }
    }
}

/// `chars.collect::<str>()` (2.15.7).
impl FromIterator<char> for str {
    const fn from_iter<I: IntoIterator<Item = char>>(it: I) -> str {
        let b = StrBuf::new();
        for c in it { b.push(c); }
        b.to_str()
    }
}

/// `parts.collect::<str>()`: the pieces concatenated (2.15.7).
impl FromIterator<str> for str {
    const fn from_iter<I: IntoIterator<Item = str>>(it: I) -> str {
        let b = StrBuf::new();
        for s in it { b.push_str(s); }
        b.to_str()
    }
}

impl Display for StrBuf {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.to_str()) }
}

/// Bytes that are not UTF-8 (`str::from_utf8`).
#[derive(Clone, PartialEq, Eq)]
pub struct Utf8Error {
    valid_up_to: usize;
}

impl Utf8Error {
    /// Length of the valid prefix, in bytes (a Windows path's: UTF-16
    /// units).
    pub const fn valid_up_to(self) -> usize { self.valid_up_to }
    pub const fn message(self) -> str { f"invalid UTF-8 at byte {self.valid_up_to}" }
}

impl Display for Utf8Error {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}

impl Debug for Utf8Error {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"Utf8Error({self})") }
}

impl Error for Utf8Error {}

// `FromStr` (stdlib 2.15.7).

/// `str.parse::<T>()` dispatch.
pub trait FromStr {
    type Err;
    fn from_str(s: str) throws (Err) -> Self;
}

/// `s` as a decimal integer of `bits` bits (its bits as `i64`).
const fn int_of(s: str, signed: i32, bits: u32) throws (ParseError) -> i64 {
    unsafe {
        let out: GcBuf<i64> = buf_new(1);
        let st = rok_str_parse_int(s, 10u32, signed, bits, out);
        if st == 1 { throw ParseError::new(s, 0, "empty string"); }
        if st == 2 { throw ParseError::new(s, 0, "invalid digit"); }
        if st == 3 { throw ParseError::new(s, 0, "number out of range"); }
        out[0]
    }
}

const fn signed_of(s: str, bits: u32) throws (ParseError) -> i64 { try int_of(s, 1, bits) }

const fn unsigned_of(s: str, bits: u32) throws (ParseError) -> u64 { (try int_of(s, 0, bits)) as u64 }

const fn float_of(s: str) throws (ParseError) -> f64 {
    unsafe {
        let out: GcBuf<f64> = buf_new(1);
        let st = rok_str_parse_float(s, out);
        if st == 2 { throw ParseError::new(s, 0, "invalid float literal"); }
        if st == 3 { throw ParseError::new(s, 0, "number out of range"); }
        out[0]
    }
}

impl FromStr for i8 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> i8 { (try signed_of(s, 8)) as i8 }
}
impl FromStr for i16 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> i16 { (try signed_of(s, 16)) as i16 }
}
impl FromStr for i32 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> i32 { (try signed_of(s, 32)) as i32 }
}
impl FromStr for i64 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> i64 { try signed_of(s, 64) }
}
impl FromStr for isize {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> isize { (try signed_of(s, isize::BITS)) as isize }
}
impl FromStr for u8 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> u8 { (try unsigned_of(s, 8)) as u8 }
}
impl FromStr for u16 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> u16 { (try unsigned_of(s, 16)) as u16 }
}
impl FromStr for u32 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> u32 { (try unsigned_of(s, 32)) as u32 }
}
impl FromStr for u64 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> u64 { try unsigned_of(s, 64) }
}
impl FromStr for usize {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> usize { (try unsigned_of(s, usize::BITS)) as usize }
}
impl FromStr for f64 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> f64 { try float_of(s) }
}
impl FromStr for f32 {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> f32 {
        let v = try float_of(s);
        let r = v as f32;
        if v.is_finite() && !r.is_finite() {
            throw ParseError::new(s, 0, "number out of range");
        }
        r
    }
}
impl FromStr for bool {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> bool {
        if s == "true" { return true; }
        if s == "false" { return false; }
        throw ParseError::new(s, 0, "expected `true` or `false`");
    }
}
impl FromStr for char {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> char {
        let it = s.chars();
        let first = it.next();
        if s.len() == 0 { throw ParseError::new(s, 0, "empty string"); }
        if it.next() is char { throw ParseError::new(s, 0, "too many characters"); }
        first ?? ' '
    }
}
impl FromStr for str {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> str { s }
}

/// A hand-off's copy (stdlib 2.13.9): a new head and byte buffer.
impl Transfer for StrBuf {
    const fn transfer_copy(self, m: Memo) -> StrBuf {
        if buf_is_null(self.h) {
            return self;
        }
        if let got: GcBuf<StrBufHead> = m.find(self.h) {
            return StrBuf { h: got };
        }
        unsafe {
            let s = self.h[0];
            let h: GcBuf<StrBufHead> = buf_new(1);
            m.note(self.h, h);
            let bytes: GcBuf<u8> = buf_new(buf_len(s.cap, 1));
            rok_buf_copy(bytes, 0, s.bytes, 0, s.len);
            h[0] = StrBufHead { len: s.len, cap: s.cap, bytes };
            StrBuf { h }
        }
    }

    const fn transfer_keep(self, m: Memo) -> StrBuf {
        if !buf_is_null(self.h) {
            m.keep(self.h);
        }
        self
    }

    const fn transfer_visit(self, m: Memo) -> StrBuf {
        if !buf_is_null(self.h) {
            let _ = m.visit(self.h);
        }
        self
    }
}

// rok::core::par - data-parallel helpers (stdlib spec 2.19), on the
// process's task executor (`rok::core::task`): from async code on the
// worker it runs on, from sync code with the caller as a guest worker.
// Chunks are claimed from a shared counter by one job per worker.

use rok::core::marker::{distinct, hand_over};
use rok::core::sync::{LoadOrdering, UpdateOrdering};

/// Run `job(c)` for every `c` in `0..chunks` across the workers (this
/// thread included); returns once all have finished.
fn run_chunks(chunks: usize, job: fn(usize) + Send) {
    _ = task::in_pool(|| {
        let workers = task::worker_count();
        if workers > chunks {
            workers = chunks;
        }
        let next = Atomic::new(0usize);
        let work = || {
            loop {
                let c = next.fetch_add(1);
                if c >= chunks {
                    break;
                }
                job(c);
            }
        };
        let helpers: List<Task<bool>> = [];
        for _ in 1..workers {
            helpers.push(task::fork_job(work));
        }
        work();
        for h in helpers {
            task::help_until(h);
        }
        true
    });
}

/// `(chunk count, chunk length)` for `n` items: every chunk non-empty.
fn chunking(n: usize) -> (usize, usize) {
    let chunks = task::cpu_count() * 4;
    if chunks > n {
        chunks = n;
    }
    if chunks == 0 {
        return (0usize, 0usize);
    }
    let size = (n + chunks - 1) / chunks;
    ((n + size - 1) / size, size)
}

const fn collect_items<I: IntoIterator>(iter: I) -> List<I::Item> {
    let items: List<I::Item> = [];
    for x in iter {
        items.push(x);
    }
    items
}

/// Call `f` on every item, in parallel (order unspecified).
#[track_caller]
pub fn for_each<I: IntoIterator<Item = T>, T: Send>(iter: I, f: fn(T) + Send + Sync) {
    let items: List<T> = collect_items(iter);
    // Two items reaching one collection would race in two workers: they
    // run one at a time instead.
    if !distinct(items) {
        unsafe { rok_par_sequential("par::for_each") };
        for x in items {
            f(x);
        }
        return;
    }
    let n = items.len();
    let (chunks, size) = chunking(n);
    // Workers only read `items`, and only until `run_chunks` returns.
    let shared = unsafe { Handoff::new(items) };
    run_chunks(chunks, |c| {
        let items = shared.get();
        for i in c * size..n.min((c + 1) * size) {
            f(items[i]);
        }
    });
}

/// `f` of every item, in the items' order.
#[track_caller]
pub fn map<I: IntoIterator<Item = T>, T: Send, U: Send>(iter: I, f: fn(T) -> U + Send + Sync) -> List<U> {
    unsafe {
        let items: List<T> = collect_items(iter);
        let n = items.len();
        if !distinct(items) {
            rok_par_sequential("par::map");
            let one: List<U> = List::with_capacity(n);
            for x in items {
                one.push(f(x));
            }
            return one;
        }
        let out: GcBuf<U> = buf_new(n);
        let (chunks, size) = chunking(n);
        // Each chunk writes its own slots of `out`; all done before the read.
        let shared = Handoff::new((items, out));
        run_chunks(chunks, |c| {
            let (items, out) = shared.get();
            for i in c * size..n.min((c + 1) * size) {
                out[i] = f(items[i]);
            }
        });
        let result: List<U> = List::with_capacity(n);
        for i in 0..n {
            result.push(out[i]);
        }
        result
    }
}

/// Fold with an associative `f` (2.19.4): chunks fold in parallel, then
/// `init` and the chunk results fold in order.
#[track_caller]
pub fn fold<I: IntoIterator<Item = T>, T: Send>(iter: I, init: T, f: fn(T, T) -> T + Send + Sync) -> T {
    let acc = init;
    for x in chunk_folds(iter, f, "par::fold") {
        acc = f(acc, x);
    }
    acc
}

/// Combine the items with an associative `f` (2.19.4), as
/// `Iterator::reduce`: chunks reduce in parallel, then the chunk
/// results in order; `none` for no items.
#[track_caller]
pub fn reduce<I: IntoIterator<Item = T>, T: Send>(iter: I, f: fn(T, T) -> T + Send + Sync) -> T | none {
    let parts = chunk_folds(iter, f, "par::reduce");
    if parts.len() == 0 {
        return none;
    }
    let acc = parts[0];
    for i in 1..parts.len() {
        acc = f(acc, parts[i]);
    }
    acc
}

/// Each chunk's items combined with `f`, in chunk order.
#[track_caller]
fn chunk_folds<I: IntoIterator<Item = T>, T: Send>(iter: I, f: fn(T, T) -> T + Send + Sync, what: str) -> List<T> {
    unsafe {
        let items: List<T> = collect_items(iter);
        let n = items.len();
        // Two items reaching one collection would race in two workers:
        // one chunk, folded here.
        if !distinct(items) {
            rok_par_sequential(what);
            let one: List<T> = [];
            if n > 0 {
                let acc = items[0];
                for i in 1..n {
                    acc = f(acc, items[i]);
                }
                one.push(acc);
            }
            return one;
        }
        let (chunks, size) = chunking(n);
        let partial: GcBuf<T> = buf_new(chunks);
        let shared = Handoff::new((items, partial));
        run_chunks(chunks, |c| {
            let (iter, partial) = shared.get();
            let start = c * size;
            let acc = iter[start];
            for i in start + 1..n.min((c + 1) * size) {
                acc = f(acc, iter[i]);
            }
            partial[c] = acc;
        });
        let out: List<T> = List::with_capacity(chunks);
        for c in 0..chunks {
            out.push(partial[c]);
        }
        out
    }
}

/// The items `pred` accepts, in order.
#[track_caller]
pub fn filter<I: IntoIterator<Item = T>, T: Send>(iter: I, pred: fn(T) -> bool + Send + Sync) -> List<T> {
    unsafe {
        let items: List<T> = collect_items(iter);
        let n = items.len();
        if !distinct(items) {
            rok_par_sequential("par::filter");
            let one: List<T> = [];
            for x in items {
                if pred(x) {
                    one.push(x);
                }
            }
            return one;
        }
        let keep: GcBuf<bool> = buf_new(n);
        let (chunks, size) = chunking(n);
        let shared = Handoff::new(items);
        run_chunks(chunks, |c| {
            let iter = shared.get();
            for i in c * size..n.min((c + 1) * size) {
                keep[i] = pred(iter[i]);
            }
        });
        // The chunks are done: the list is this thread's again.
        let iter = shared.get();
        let out: List<T> = [];
        for i in 0..n {
            if keep[i] {
                out.push(iter[i]);
            }
        }
        out
    }
}

/// Run both at once; both results.
pub fn join<T1: Send, T2: Send>(f1: fn() -> T1 + Send, f2: fn() -> T2 + Send) -> (T1, T2) {
    unsafe {
        let first: GcBuf<T1> = buf_new(1);
        let second: GcBuf<T2> = buf_new(1);
        // Each result cell is written once, then read after both joined.
        let cells = Handoff::new((first, second));
        task::in_pool(|| {
            let h = task::fork_job(|| {
                let (_, second) = cells.get();
                second[0] = f2();
            });
            let (first, _) = cells.get();
            first[0] = f1();
            task::help_until(h);
            true
        });
        (first[0], second[0])
    }
}

/// Structured spawning (2.19.3): every task `s.spawn`s has finished
/// when `scope` returns.
pub fn scope(f: fn(Scope)) {
    _ = task::in_pool(|| {
        run_scope(f);
        true
    });
}

fn run_scope(f: fn(Scope)) {
    let tasks: List<ScopeTask> = [];
    let s = Scope { tasks: unsafe { Mutex::new_unshared(tasks) }, cancelled: Atomic::new(false), closed: Atomic::new(false) };
    f(s);
    drain(s);
    s.closed.store(true);
}

/// Wait for every task of `s` (they may spawn more: until none is left).
fn drain(s: Scope) {
    loop {
        let next: ScopeTask | none = none;
        using g = s.tasks.lock() {
            next = g.get().pop();
        }
        match next {
            t: ScopeTask => t.finish(),
            none => break,
        }
    }
}

struct ScopeTask {
    handle: Task<bool>;
    joined: Once;
}

impl ScopeTask {
    fn finish(self) {
        let h = self.handle;
        // Every caller returns only after the one join has finished.
        self.joined.call_once(|| { task::help_until(h); });
    }
}

/// Spawns tasks that `scope` waits for.
pub struct Scope {
    tasks: Mutex<List<ScopeTask>>;
    /// Set once a `try_scope` child or body threw: tasks that have not
    /// started yet never run.
    cancelled: Atomic<bool>;
    /// Set once its `scope` has returned: a later `spawn` panics.
    closed: Atomic<bool>;
}

impl Debug for Scope {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Scope") }
}

impl Scope {
    /// Run `f` on the parallel pool and return a handle to join its result.
    /// Under `try_scope` the task is cancelled when the scope is; every task
    /// is joined before the scope returns. Panics if called after the scope
    /// ended.
    #[track_caller]
    pub fn spawn<T: Send>(self, f: fn() -> T + Send) -> ScopeHandle<T> {
        if self.closed.load() {
            panic("Scope::spawn: the scope has ended; call `spawn` inside the closure passed to `par::scope`");
        }
        unsafe {
            let result: GcBuf<T> = buf_new(1);
            let cancelled = self.cancelled;
            // Written once by the task, read by `join` after it.
            let cell = Handoff::new(result);
            let task = ScopeTask {
                handle: task::fork_job(|| {
                    if !cancelled.load() {
                        let result = cell.get();
                        result[0] = hand_over::<T>(f());
                    }
                }),
                joined: Once::new(),
            };
            using g = self.tasks.lock() {
                g.get().push(task);
            }
            ScopeHandle { task, result }
        }
    }
}

/// One `Scope::spawn`ed task.
pub struct ScopeHandle<T> {
    task: ScopeTask;
    result: GcBuf<T>;
}

impl<T> Debug for ScopeHandle<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("ScopeHandle") }
}

impl<T> ScopeHandle<T> {
    /// Wait for the task; its result.
    pub fn join(self) -> T {
        unsafe {
            self.task.finish();
            self.result[0]
        }
    }
}

/// `scope` whose body and tasks may throw (2.19.3: "an exception cancels
/// the children"). The first error cancels the scope: tasks that have
/// not started never run (a running one finishes: a sync closure has no
/// cancellation point), `try_scope` waits for the rest and throws that
/// error.
pub fn try_scope<E: Send>(f: fn(TryScope<E>) throws (E)) throws (E) {
    unsafe {
        let err: GcBuf<E> = buf_new(1);
        let failed = Atomic::new(false);
        task::in_pool(|| {
            let tasks: List<ScopeTask> = [];
            let s = TryScope {
                scope: Scope { tasks: unsafe { Mutex::new_unshared(tasks) }, cancelled: Atomic::new(false), closed: Atomic::new(false) },
                err: Handoff::new(err),
                failed: failed,
            };
            try f(s) catch e { s.fail(e); };
            drain(s.scope);
            s.scope.closed.store(true);
            true
        });
        if failed.load() {
            throw err[0];
        }
    }
}

/// The `Scope` of `try_scope`.
pub struct TryScope<E> {
    scope: Scope;
    /// The first error (`failed` set once it is written).
    err: Handoff<GcBuf<E>>;
    failed: Atomic<bool>;
}

impl<E> Debug for TryScope<E> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryScope") }
}

impl<E: Send> TryScope<E> {
    /// Keep the first error and cancel the scope.
    fn fail(self, e: E) {
        unsafe {
            // Only the first: a skipped task's `join` reads `err` once it sees
            // the scope cancelled.
            if self.failed.compare_exchange(false, true, UpdateOrdering::SeqCst, LoadOrdering::SeqCst).is_ok() {
                let err = self.err.get();
                err[0] = e;
                self.scope.cancelled.store(true);
            }
        }
    }

    /// `Scope::spawn` for a throwing `f`: its error cancels the scope.
    pub fn spawn<T: Send>(self, f: fn() throws (E) -> T + Send) -> TryScopeHandle<T, E> {
        unsafe {
            let out: GcBuf<T> = buf_new(1);
            let own: GcBuf<E> = buf_new(1);
            // 0: ran, 1: threw (`own`), 2: cancelled before it started.
            let status = Atomic::new(2);
            let me = self;
            let cells = Handoff::new((out, own));
            let h = self.scope.spawn(|| {
                status.store(0);
                let (out, own) = cells.get();
                let v = try f() catch e {
                    own[0] = hand_over::<E>(e);
                    status.store(1);
                    me.fail(e);
                    return;
                };
                out[0] = hand_over::<T>(v);
            });
            TryScopeHandle { inner: h, out: out, own: own, status: status, scope: self }
        }
    }

    /// Whether the scope was cancelled: a long task may poll this.
    pub fn is_cancelled(self) -> bool {
        self.scope.cancelled.load()
    }
}

/// One `TryScope::spawn`ed task.
pub struct TryScopeHandle<T, E> {
    inner: ScopeHandle<()>;
    out: GcBuf<T>;
    own: GcBuf<E>;
    status: Atomic<i32>;
    scope: TryScope<E>;
}

impl<T, E> Debug for TryScopeHandle<T, E> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryScopeHandle") }
}

impl<T, E: Send> TryScopeHandle<T, E> {
    /// Wait for the task: its result, its error, or (cancelled before it
    /// ran) the scope's first error.
    pub fn join(self) throws (E) -> T {
        unsafe {
            self.inner.join();
            let st = self.status.load();
            if st == 1 {
                throw self.own[0];
            }
            if st == 2 {
                let err = self.scope.err.get();
                throw err[0];
            }
            self.out[0]
        }
    }
}

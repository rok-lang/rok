// Iterator + IntoIterator + FromIterator (stdlib spec 2.7).
//
// `for pat in xs` desugars to
//   let it = xs.into_iter();
//   loop { match it.next() { v: T => { let pat = v; body } none => break } }
// (integer ranges and arrays keep a direct counting loop).
//
// `next` takes `ref self` (2.7.1): an iterator's state lives in its
// fields, written back into the caller's binding after each call.

/// A source of items, one per `next` call; `none` ends it. The adapters
/// below are lazy: nothing runs until the iterator is consumed.
#[lang("iterator_trait")]
pub trait Iterator {
    type Item;
    fn next(ref self) -> Item | none;

    /// Apply `f` to each item.
    const fn map<U>(self, f: fn(Item) -> U) -> Map<Self, U> {
        Map { it: self, f: f }
    }

    /// Keep the items `pred` accepts.
    const fn filter(self, pred: fn(Item) -> bool) -> Filter<Self> {
        Filter { it: self, pred: pred }
    }

    /// `(index, item)` pairs.
    const fn enumerate(self) -> Enumerate<Self> {
        Enumerate { it: self, i: 0 }
    }

    /// Pairs of this iterator's and `other`'s items, until either ends.
    const fn zip<J: Iterator>(self, other: J) -> Zip<Self, J> {
        Zip { a: self, b: other }
    }

    /// This iterator's items, then `other`'s (with the same item type).
    const fn chain<J: Iterator<Item = Item>>(self, other: J) -> Chain<Self, J> {
        Chain { a: self, b: other, first: true }
    }

    /// At most the first `n` items.
    const fn take(self, n: usize) -> Take<Self> {
        Take { it: self, left: n }
    }

    /// All but the first `n` items.
    const fn skip(self, n: usize) -> Skip<Self> {
        Skip { it: self, n: n }
    }

    /// Every `step`th item, starting with the first. Panics when `step`
    /// is 0.
    #[track_caller]
    const fn step_by(self, step: usize) -> StepBy<Self> {
        if step == 0 {
            panic("Iterator::step_by: step is 0; pass a positive step, e.g. `step_by(2)`");
        }
        StepBy { it: self, step: step, first: true }
    }

    /// The items back to front (`DoubleEndedIterator` only, 2.7.9).
    const fn rev(self) -> Rev<Self> {
        Rev { it: self }
    }

    /// The items of each item (each item is `IntoIterator`).
    const fn flatten(self) -> Flatten<Self> where Item: IntoIterator {
        Flatten { it: self, cur: none }
    }

    /// The items of each `f(item)` (an `IntoIterator`).
    const fn flat_map<U: IntoIterator>(self, f: fn(Item) -> U) -> FlatMap<Self, U> {
        FlatMap { it: self, f: f, cur: none }
    }

    /// An iterator that can look at its next item without taking it.
    const fn peekable(self) -> Peekable<Self> {
        Peekable { it: self, peeked: none, has: false }
    }

    /// The items before the first one `pred` rejects; that one is used
    /// up and nothing after it is taken.
    const fn take_while(self, pred: fn(Item) -> bool) -> TakeWhile<Self> {
        TakeWhile { it: self, pred: pred, done: false }
    }

    /// The items from the first one `pred` rejects on.
    const fn skip_while(self, pred: fn(Item) -> bool) -> SkipWhile<Self> {
        SkipWhile { it: self, pred: pred, done: false }
    }

    /// The running state: `f(init, x0)`, then `f` of that and `x1`, and
    /// so on (`fold` that yields each step).
    const fn scan<S>(self, init: S, f: fn(S, Item) -> S) -> Scan<Self, S> {
        Scan { it: self, state: init, f: f }
    }

    /// The same items, each passed to `f` first (for side effects).
    const fn inspect(self, f: fn(Item)) -> InspectIter<Self> {
        InspectIter { it: self, f: f }
    }

    /// The items over and over, restarting from a copy of this
    /// iterator; empty if it is empty.
    const fn cycle(self) -> Cycle<Self> {
        Cycle { orig: self, it: self }
    }

    /// Lists of `size` items in order, the last one shorter when the
    /// items run out (`size` > 0).
    #[track_caller]
    const fn chunks(self, size: usize) -> Chunks<Self> {
        if size == 0 {
            panic("Iterator::chunks: size is 0; pass a positive size, e.g. `chunks(2)`");
        }
        Chunks { it: self, size: size }
    }

    /// Lists of `size` consecutive items, sliding by one (`size` > 0);
    /// nothing when there are fewer than `size` items.
    #[track_caller]
    const fn windows(self, size: usize) -> Windows<Self> {
        if size == 0 {
            panic("Iterator::windows: size is 0; pass a positive size, e.g. `windows(2)`");
        }
        Windows { it: self, size: size, win: List::new(), started: false }
    }

    /// The number of items left when that is known without stepping
    /// (no item is computed), else `none`. `count` uses it.
    const fn exact_len(self) -> usize | none { none }

    /// The number of items left: `exact_len` when known, else stepped.
    const fn count(self) -> usize {
        if let k: usize = self.exact_len() {
            return k;
        }
        let n: usize = 0;
        for _ in self {
            n += 1;
        }
        n
    }

    /// The items added up; `0` for none.
    const fn sum(self) -> Item where Item: Add<Output = Item> + Zero {
        let acc = Item::zero();
        for x in self {
            acc += x;
        }
        acc
    }

    /// The items multiplied; `1` for none.
    const fn product(self) -> Item where Item: Mul<Output = Item> + One {
        let acc = Item::one();
        for x in self {
            acc *= x;
        }
        acc
    }

    const fn fold<B>(self, init: B, f: fn(B, Item) -> B) -> B {
        let acc = init;
        for x in self {
            acc = f(acc, x);
        }
        acc
    }

    /// `fold` with a throwing `f`: the first error stops the loop and is
    /// thrown.
    const fn try_fold<B, E>(self, init: B, f: fn(B, Item) throws (E) -> B) throws (E) -> B {
        let acc = init;
        for x in self {
            acc = try f(acc, x);
        }
        acc
    }

    /// `for_each` with a throwing `f`: the first error stops the loop and
    /// is thrown.
    const fn try_for_each<E>(self, f: fn(Item) throws (E)) throws (E) {
        for x in self {
            try f(x);
        }
    }

    /// The items `pred` accepts, then the rest, each in order.
    const fn partition(self, pred: fn(Item) -> bool) -> (List<Item>, List<Item>) {
        let yes: List<Item> = List::new();
        let no: List<Item> = List::new();
        for x in self {
            if pred(x) {
                yes.push(x);
            } else {
                no.push(x);
            }
        }
        (yes, no)
    }

    /// The pairs split into a list of firsts and a list of seconds.
    const fn unzip<A, B>(self) -> (List<A>, List<B>) where Self: Iterator<Item = (A, B)> {
        let left: List<A> = List::new();
        let right: List<B> = List::new();
        for (a, b) in self {
            left.push(a);
            right.push(b);
        }
        (left, right)
    }

    /// The items combined left to right with `f`; `none` for none.
    const fn reduce(self, f: fn(Item, Item) -> Item) -> Item | none {
        let acc: Item | none = none;
        for x in self {
            acc = if let a: Item = acc { f(a, x) } else { x };
        }
        acc
    }

    const fn any(self, pred: fn(Item) -> bool) -> bool {
        for x in self {
            if pred(x) {
                return true;
            }
        }
        false
    }

    const fn all(self, pred: fn(Item) -> bool) -> bool {
        for x in self {
            if !pred(x) {
                return false;
            }
        }
        true
    }

    #[must_use]
    const fn find(self, pred: fn(Item) -> bool) -> Item | none {
        for x in self {
            if pred(x) {
                return x;
            }
        }
        none
    }

    const fn position(self, pred: fn(Item) -> bool) -> usize | none {
        let i: usize = 0;
        for x in self {
            if pred(x) {
                return i;
            }
            i += 1;
        }
        none
    }

    /// The smallest item (the first of equals).
    #[must_use]
    const fn min(self) -> Item | none where Item: Ord {
        let best: Item | none = none;
        for x in self {
            match best {
                b: Item => {
                    if x.cmp(b).is_lt() {
                        best = x;
                    }
                }
                none => {
                    best = x;
                }
            }
        }
        best
    }

    /// The largest item (the last of equals).
    #[must_use]
    const fn max(self) -> Item | none where Item: Ord {
        let best: Item | none = none;
        for x in self {
            match best {
                b: Item => {
                    if !x.cmp(b).is_lt() {
                        best = x;
                    }
                }
                none => {
                    best = x;
                }
            }
        }
        best
    }

    /// The item with the smallest `key` (the first of equals).
    const fn min_by_key<K: Ord>(self, key: fn(Item) -> K) -> Item | none {
        let best: Item | none = none;
        let best_key: K | none = none;
        for x in self {
            let k = key(x);
            match best_key {
                b: K => {
                    if k.cmp(b).is_lt() {
                        best = x;
                        best_key = k;
                    }
                }
                none => {
                    best = x;
                    best_key = k;
                }
            }
        }
        best
    }

    /// The item with the largest `key` (the last of equals).
    const fn max_by_key<K: Ord>(self, key: fn(Item) -> K) -> Item | none {
        let best: Item | none = none;
        let best_key: K | none = none;
        for x in self {
            let k = key(x);
            match best_key {
                b: K => {
                    if !k.cmp(b).is_lt() {
                        best = x;
                        best_key = k;
                    }
                }
                none => {
                    best = x;
                    best_key = k;
                }
            }
        }
        best
    }

    const fn last(self) -> Item | none {
        let last: Item | none = none;
        for x in self {
            last = x;
        }
        last
    }

    /// The `n`th remaining item (0-based), consuming the ones before it.
    const fn nth(ref self, n: usize) -> Item | none {
        for i in 0..n {
            self.next()?;
        }
        self.next()
    }

    const fn for_each(self, f: fn(Item)) {
        for x in self {
            f(x);
        }
    }

    /// Gather the items into a `FromIterator` collection (the slot's
    /// type picks it: `let v: List<i32> = it.collect();`).
    const fn collect<C: FromIterator<Item>>(self) -> C {
        C::from_iter(self)
    }
}

/// An iterator that can also step from the back (2.7.9).
pub trait DoubleEndedIterator: Iterator {
    /// The next item from the back, or `none` when the two ends meet.
    fn next_back(ref self) -> Item | none;

    /// `fold` from the back.
    const fn rfold<B>(self, init: B, f: fn(B, Self::Item) -> B) -> B {
        Rev { it: self }.fold(init, f)
    }

    /// The last item `pred` accepts, searching from the back.
    #[must_use]
    const fn rfind(self, pred: fn(Self::Item) -> bool) -> Self::Item | none {
        Rev { it: self }.find(pred)
    }
}

/// An iterator that knows how many items remain (2.7.10).
pub trait ExactSizeIterator: Iterator {
    /// The number of items left.
    fn len(self) -> usize;
}

/// A value `for` can walk (2.7.2): `into_iter` turns it into an
/// iterator.
#[lang("into_iterator_trait")]
pub trait IntoIterator {
    type IntoIter: Iterator<Item = Item>;
    type Item;
    fn into_iter(self) -> IntoIter;
}

/// Every iterator is iterable as itself (2.7.2).
impl<I: Iterator> IntoIterator for I {
    type IntoIter = I;
    type Item = I::Item;
    const fn into_iter(self) -> I {
        self
    }
}

/// A collection buildable from an iterator (`collect`, 2.9.9).
pub trait FromIterator<A> {
    /// A collection holding the items of `it`, in iteration order.
    fn from_iter<I: IntoIterator<Item = A>>(it: I) -> Self;
}

/// The iterator `map` returns: `f` of each item.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Map<I, U> {
    it: I;
    f: fn(I::Item) -> U;
}

impl<I: Iterator, U> Debug for Map<I, U> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Map") }
}

impl<I: Iterator, U> Iterator for Map<I, U> {
    type Item = U;
    const fn next(ref self) -> U | none {
        (self.f)(self.it.next()?)
    }

    const fn exact_len(self) -> usize | none { self.it.exact_len() }

    /// As many as the inner iterator: O(1) over an `ExactSizeIterator` (2.7.10).
    const fn count(self) -> usize { self.it.count() }
}

impl<I: DoubleEndedIterator, U> DoubleEndedIterator for Map<I, U> {
    const fn next_back(ref self) -> U | none {
        (self.f)(self.it.next_back()?)
    }
}

impl<I: ExactSizeIterator, U> ExactSizeIterator for Map<I, U> {
    const fn len(self) -> usize { self.it.len() }
}

/// The iterator `filter` returns: the items `pred` accepts, in order.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Filter<I> {
    it: I;
    pred: fn(I::Item) -> bool;
}

impl<I: Iterator> Debug for Filter<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Filter") }
}

impl<I: Iterator> Iterator for Filter<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        while let x: I::Item = self.it.next() {
            if (self.pred)(x) {
                return x;
            }
        }
        none
    }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Filter<I> {
    const fn next_back(ref self) -> I::Item | none {
        while let x: I::Item = self.it.next_back() {
            if (self.pred)(x) {
                return x;
            }
        }
        none
    }
}

/// The iterator `enumerate` returns: `(index, item)` pairs from 0.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Enumerate<I> {
    it: I;
    i: usize;
}

impl<I> Debug for Enumerate<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Enumerate") }
}

impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (usize, I::Item);
    const fn next(ref self) -> (usize, I::Item) | none {
        let x = self.it.next()?;
        let at = self.i;
        self.i = at + 1;
        (at, x)
    }

    const fn exact_len(self) -> usize | none { self.it.exact_len() }

    /// As many as the inner iterator: O(1) over an `ExactSizeIterator` (2.7.10).
    const fn count(self) -> usize { self.it.count() }
}

impl<I: ExactSizeIterator> ExactSizeIterator for Enumerate<I> {
    fn len(self) -> usize { self.it.len() }
}

impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Enumerate<I> {
    const fn next_back(ref self) -> (usize, I::Item) | none {
        let n = self.it.len();
        let x = self.it.next_back()?;
        (self.i + n - 1, x)
    }
}

/// The iterator `zip` returns: pairs of items; ends with the shorter
/// side.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Zip<I, J> {
    a: I;
    b: J;
}

impl<I, J> Debug for Zip<I, J> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Zip") }
}

impl<I: Iterator, J: Iterator> Iterator for Zip<I, J> {
    type Item = (I::Item, J::Item);
    const fn next(ref self) -> (I::Item, J::Item) | none {
        let x = self.a.next()?;
        (x, self.b.next()?)
    }

    const fn exact_len(self) -> usize | none {
        let n = self.a.exact_len()?;
        n.min(self.b.exact_len()?)
    }
}

impl<I: ExactSizeIterator, J: ExactSizeIterator> ExactSizeIterator for Zip<I, J> {
    const fn len(self) -> usize { self.a.len().min(self.b.len()) }
}

/// From the back, the longer side's extra tail is dropped first.
impl<I: DoubleEndedIterator + ExactSizeIterator, J: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Zip<I, J> {
    const fn next_back(ref self) -> (I::Item, J::Item) | none {
        let (n, m) = (self.a.len(), self.b.len());
        for _ in m..n {
            self.a.next_back();
        }
        for _ in n..m {
            self.b.next_back();
        }
        let x = self.a.next_back()?;
        (x, self.b.next_back()?)
    }
}

/// The iterator `chain` returns: every item of the first, then of the
/// second.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Chain<I, J> {
    a: I;
    b: J;
    first: bool;
}

impl<I, J> Debug for Chain<I, J> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Chain") }
}

impl<I: Iterator, J: Iterator<Item = I::Item>> Iterator for Chain<I, J> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if self.first {
            if let x: I::Item = self.a.next() {
                return x;
            }
            self.first = false;
        }
        self.b.next()
    }
}

impl<I: DoubleEndedIterator, J: DoubleEndedIterator> DoubleEndedIterator for Chain<I, J> {
    const fn next_back(ref self) -> I::Item | none {
        self.b.next_back() ?? self.a.next_back()
    }
}

/// The iterator `step_by` returns: the first item, then every `step`th.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct StepBy<I> {
    it: I;
    step: usize;
    first: bool;
}

impl<I> Debug for StepBy<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("StepBy") }
}

impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if self.first {
            self.first = false;
            return self.it.next();
        }
        self.it.nth(self.step - 1)
    }

    const fn exact_len(self) -> usize | none {
        let n = self.it.exact_len()?;
        if !self.first {
            return n / self.step;
        }
        if n == 0 { 0 } else { 1 + (n - 1) / self.step }
    }
}

impl<I: ExactSizeIterator> ExactSizeIterator for StepBy<I> {
    const fn len(self) -> usize {
        let n = self.it.len();
        if !self.first {
            return n / self.step;
        }
        if n == 0 { 0 } else { 1 + (n - 1) / self.step }
    }
}

/// The back item is the last one the front would reach: the tail past
/// it is dropped first.
impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for StepBy<I> {
    const fn next_back(ref self) -> I::Item | none {
        let n = self.it.len();
        if n == 0 {
            return none;
        }
        let extra = if self.first { (n - 1) % self.step } else { n % self.step };
        if !self.first && n < self.step {
            return none;
        }
        for _ in 0..extra {
            self.it.next_back();
        }
        self.it.next_back()
    }
}

/// The iterator `rev` returns: the items from the back.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Rev<I> {
    it: I;
}

impl<I> Debug for Rev<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Rev") }
}

impl<I: DoubleEndedIterator> Iterator for Rev<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        self.it.next_back()
    }

    const fn exact_len(self) -> usize | none { self.it.exact_len() }

    /// As many as the inner iterator: O(1) over an `ExactSizeIterator` (2.7.10).
    const fn count(self) -> usize { self.it.count() }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {
    fn next_back(ref self) -> I::Item | none {
        self.it.next()
    }
}

impl<I: DoubleEndedIterator + ExactSizeIterator> ExactSizeIterator for Rev<I> {
    const fn len(self) -> usize { self.it.len() }
}

/// `flatten`: `cur` is the inner iterator being drained.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Flatten<I> {
    it: I;
    cur: <I::Item as IntoIterator>::IntoIter | none;
}

impl<I: Iterator> Debug for Flatten<I>
where
    I::Item: IntoIterator,
{
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Flatten") }
}

impl<I: Iterator> Iterator for Flatten<I>
where
    I::Item: IntoIterator,
{
    type Item = <I::Item as IntoIterator>::Item;
    const fn next(ref self) -> <I::Item as IntoIterator>::Item | none {
        while true {
            if let inner: <I::Item as IntoIterator>::IntoIter = self.cur {
                if let x: <I::Item as IntoIterator>::Item = inner.next() {
                    self.cur = inner;
                    return x;
                }
                self.cur = none;
            } else {
                let nx = self.it.next()?;
                self.cur = nx.into_iter();
            }
        }
        none
    }
}

/// `flat_map`: `cur` is the inner iterator being drained.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct FlatMap<I, U> {
    it: I;
    f: fn(I::Item) -> U;
    cur: <U as IntoIterator>::IntoIter | none;
}

impl<I: Iterator, U: IntoIterator> Debug for FlatMap<I, U> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("FlatMap") }
}

impl<I: Iterator, U: IntoIterator> Iterator for FlatMap<I, U> {
    type Item = U::Item;
    const fn next(ref self) -> U::Item | none {
        while true {
            if let inner: U::IntoIter = self.cur {
                if let x: U::Item = inner.next() {
                    self.cur = inner;
                    return x;
                }
                self.cur = none;
            } else {
                self.cur = (self.f)(self.it.next()?).into_iter();
            }
        }
        none
    }
}

/// The iterator `peekable` returns: `peek` looks at the next item
/// without taking it.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Peekable<I> {
    it: I;
    peeked: I::Item | none;
    has: bool;
}

impl<I: Iterator> Debug for Peekable<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Peekable") }
}

impl<I: Iterator> Peekable<I> {
    /// The next item, left in place for the following `next`.
    pub const fn peek(ref self) -> I::Item | none {
        if !self.has {
            self.peeked = self.it.next();
            self.has = true;
        }
        self.peeked
    }
}

impl<I: Iterator> Iterator for Peekable<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if self.has {
            self.has = false;
            return self.peeked;
        }
        self.it.next()
    }
}

/// The iterator `take` returns: at most the first `n` items.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Take<I> {
    it: I;
    left: usize;
}

impl<I> Debug for Take<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Take") }
}

impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if self.left == 0 {
            return none;
        }
        self.left -= 1;
        self.it.next()
    }

    const fn exact_len(self) -> usize | none {
        if self.left == 0 {
            return 0;
        }
        self.it.exact_len()?.min(self.left)
    }
}

impl<I: ExactSizeIterator> ExactSizeIterator for Take<I> {
    const fn len(self) -> usize { self.it.len().min(self.left) }
}

impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Take<I> {
    const fn next_back(ref self) -> I::Item | none {
        if self.left == 0 {
            return none;
        }
        for _ in self.left..self.it.len() {
            self.it.next_back();
        }
        self.left -= 1;
        self.it.next_back()
    }
}

/// The iterator `skip` returns: all but the first `n` items.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Skip<I> {
    it: I;
    n: usize;
}

impl<I> Debug for Skip<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Skip") }
}

impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        while self.n > 0 {
            self.n -= 1;
            self.it.next()?;
        }
        self.it.next()
    }

    const fn exact_len(self) -> usize | none { self.it.exact_len()?.saturating_sub(self.n) }
}

impl<I: ExactSizeIterator> ExactSizeIterator for Skip<I> {
    const fn len(self) -> usize { self.it.len().saturating_sub(self.n) }
}

impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Skip<I> {
    const fn next_back(ref self) -> I::Item | none {
        if self.it.len() <= self.n {
            return none;
        }
        self.it.next_back()
    }
}

/// The iterator `take_while` returns: items up to the first that `pred`
/// rejects.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct TakeWhile<I> {
    it: I;
    pred: fn(I::Item) -> bool;
    /// `pred` rejected an item: no more are taken.
    done: bool;
}

impl<I: Iterator> Debug for TakeWhile<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TakeWhile") }
}

impl<I: Iterator> Iterator for TakeWhile<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if self.done {
            return none;
        }
        let x = self.it.next()?;
        if (self.pred)(x) {
            return x;
        }
        self.done = true;
        none
    }
}

/// The iterator `skip_while` returns: items from the first that `pred`
/// rejects on.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct SkipWhile<I> {
    it: I;
    pred: fn(I::Item) -> bool;
    /// An item passed `pred`'s test: the rest go through unchecked.
    done: bool;
}

impl<I: Iterator> Debug for SkipWhile<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("SkipWhile") }
}

impl<I: Iterator> Iterator for SkipWhile<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if self.done {
            return self.it.next();
        }
        while let x: I::Item = self.it.next() {
            if !(self.pred)(x) {
                self.done = true;
                return x;
            }
        }
        none
    }
}

/// The iterator `scan` returns: each running state of `f`.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Scan<I, S> {
    it: I;
    state: S;
    f: fn(S, I::Item) -> S;
}

impl<I: Iterator, S> Debug for Scan<I, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Scan") }
}

impl<I: Iterator, S> Iterator for Scan<I, S> {
    type Item = S;
    const fn next(ref self) -> S | none {
        let s = (self.f)(self.state, self.it.next()?);
        self.state = s;
        s
    }

    const fn exact_len(self) -> usize | none { self.it.exact_len() }

    /// As many as the inner iterator: O(1) over an `ExactSizeIterator` (2.7.10).
    const fn count(self) -> usize { self.it.count() }
}

impl<I: ExactSizeIterator, S> ExactSizeIterator for Scan<I, S> {
    const fn len(self) -> usize { self.it.len() }
}

/// `inspect`'s adapter (`Inspect` is the reflection trait).
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct InspectIter<I> {
    it: I;
    f: fn(I::Item);
}

impl<I: Iterator> Debug for InspectIter<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("InspectIter") }
}

// No `count` override: counting a stepped inner iterator runs `f`.
impl<I: Iterator> Iterator for InspectIter<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        let x = self.it.next()?;
        (self.f)(x);
        x
    }

    const fn exact_len(self) -> usize | none { self.it.exact_len() }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for InspectIter<I> {
    const fn next_back(ref self) -> I::Item | none {
        let x = self.it.next_back()?;
        (self.f)(x);
        x
    }
}

impl<I: ExactSizeIterator> ExactSizeIterator for InspectIter<I> {
    const fn len(self) -> usize { self.it.len() }
}

/// The iterator `cycle` returns: the items over and over; empty if the
/// source is.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Cycle<I> {
    /// The iterator as `cycle` got it: each round restarts from a copy.
    orig: I;
    it: I;
}

impl<I> Debug for Cycle<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Cycle") }
}

impl<I: Iterator> Iterator for Cycle<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if let x: I::Item = self.it.next() {
            return x;
        }
        // One restart per call: an empty iterator ends the cycle.
        self.it = self.orig;
        self.it.next()
    }

    /// 0 for an empty iterator; else endless.
    const fn exact_len(self) -> usize | none {
        if let n: usize = self.orig.exact_len() {
            if n == 0 {
                return 0;
            }
        }
        none
    }
}

/// The iterator `chunks` returns: lists of `size` items, the last one
/// shorter when the items run out.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Chunks<I> {
    it: I;
    size: usize;
}

impl<I> Debug for Chunks<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Chunks") }
}

impl<I: Iterator> Iterator for Chunks<I> {
    type Item = List<I::Item>;
    const fn next(ref self) -> List<I::Item> | none {
        let first = self.it.next()?;
        let out: List<I::Item> = List::with_capacity(self.size);
        out.push(first);
        while out.len() < self.size {
            if let x: I::Item = self.it.next() {
                out.push(x);
            } else {
                break;
            }
        }
        out
    }

    const fn exact_len(self) -> usize | none {
        let n = self.it.exact_len()?;
        n / self.size + if n % self.size == 0 { 0 } else { 1 }
    }
}

impl<I: ExactSizeIterator> ExactSizeIterator for Chunks<I> {
    const fn len(self) -> usize {
        let n = self.it.len();
        n / self.size + if n % self.size == 0 { 0 } else { 1 }
    }
}

/// The iterator `windows` returns: every run of `size` consecutive items,
/// overlapping, as lists.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Windows<I> {
    it: I;
    size: usize;
    /// The last window yielded; each step builds a new list, so a
    /// yielded window never changes.
    win: List<I::Item>;
    started: bool;
}

impl<I: Iterator> Debug for Windows<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Windows") }
}

impl<I: Iterator> Iterator for Windows<I> {
    type Item = List<I::Item>;
    const fn next(ref self) -> List<I::Item> | none {
        if !self.started {
            self.started = true;
            let w: List<I::Item> = List::with_capacity(self.size);
            while w.len() < self.size {
                w.push(self.it.next()?);
            }
            self.win = w;
            return w;
        }
        if self.win.len() < self.size {
            return none;
        }
        let x = self.it.next()?;
        let w: List<I::Item> = List::with_capacity(self.size);
        for i in 1..self.size {
            w.push(self.win[i]);
        }
        w.push(x);
        self.win = w;
        w
    }

    const fn exact_len(self) -> usize | none {
        if self.started {
            if self.win.len() < self.size {
                return 0;
            }
            return self.it.exact_len();
        }
        let n = self.it.exact_len()?;
        if n < self.size { 0 } else { n - self.size + 1 }
    }
}

// generators (refs-lang 4.11)

/// The value of a `yield fn` call / `yield { .. }` block: an iterator
/// over what the body yields. `resume` runs the body to its next `yield`
/// (its env is the coroutine frame, a GC object the body's state lives
/// in, so copies of a `GenIter` share one position); `resume(true)`
/// leaves the body at that `yield` through its `using` / `finally`
/// cleanups instead.
// One library type per coroutine kind, not a fresh anonymous type per
// coroutine (spec 4.1.11); it only shows in type names and identity.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct GenIter<T> {
    resume: fn(bool) -> (T | none);
}

impl<T> Debug for GenIter<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("GenIter") }
}

impl<T> Iterator for GenIter<T> {
    type Item = T;
    const fn next(ref self) -> T | none {
        (self.resume)(false)
    }
}

impl<T> GenIter<T> {
    /// End the generator where it waits: its cleanups run, then `next`
    /// gives `none`. What `for` calls when it leaves the loop early.
    pub(pkg) const fn close(ref self) {
        (self.resume)(true);
    }
}

/// A throwing generator (`yield fn f() throws (E) -> T`): a
/// `TryIterator` whose `next` throws what the body throws (refs-lang
/// 4.14.10), stepped with `try for x in g { .. }`.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryGenIter<T, E> {
    resume: fn(bool) throws (E) -> (T | none);
}

impl<T, E> Debug for TryGenIter<T, E> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryGenIter") }
}

impl<T, E> TryIterator for TryGenIter<T, E> {
    type Item = T;
    type Error = E;
    /// Resume the generator: the next item, or `none` when it is done; throws
    /// what the body throws.
    const fn next(ref self) throws (E) -> T | none {
        try (self.resume)(false)
    }
}

impl<T, E> TryGenIter<T, E> {
    /// `GenIter::close`; an error its cleanups throw is dropped (the loop
    /// is already leaving).
    pub(pkg) const fn close(ref self) {
        try (self.resume)(true) catch _ { none };
    }
}

// fallible iteration (stdlib 2.7.13)

/// An iterator whose `next` can fail: an item, `none` at the end, or a
/// thrown `Error`. What a `next` after a throw does is the type's
/// documented choice: it may go on (`fs::Walk`) or end (`fs::ReadDir`).
///
/// `try for x in it { .. }` steps it: the `try` covers the iterable and
/// each `next`, not the body. The adapters' functions may throw `Error`
/// (a non-throwing function fits too); `map_err` changes it.
#[lang("try_iterator_trait")]
pub trait TryIterator {
    type Item;
    type Error;
    fn next(ref self) throws (Error) -> Item | none;

    /// Apply `f` to each item.
    const fn map<U>(self, f: fn(Item) throws (Error) -> U) -> TryMap<Self, U> {
        TryMap { it: self, f: f }
    }

    /// Keep the items `pred` accepts.
    const fn filter(self, pred: fn(Item) throws (Error) -> bool) -> TryFilter<Self> {
        TryFilter { it: self, pred: pred }
    }

    /// The same items, each error passed through `f`: the only way to
    /// change `Error` (`.map_err(|e| -> any Error { e })` erases it).
    const fn map_err<E2>(self, f: fn(Error) -> E2) -> MapErr<Self, E2> {
        MapErr { it: self, f: f }
    }

    /// `(index, item)` pairs.
    const fn enumerate(self) -> TryEnumerate<Self> {
        TryEnumerate { it: self, i: 0 }
    }

    /// Pairs of this iterator's items and a plain iterator's, until
    /// either ends.
    const fn zip<J: IntoIterator>(self, other: J) -> TryZip<Self, J::IntoIter> {
        TryZip { a: self, b: other.into_iter() }
    }

    /// This iterator's items, then `other`'s.
    const fn chain<J: TryIterator<Item = Item, Error = Error>>(self, other: J) -> TryChain<Self, J> {
        TryChain { a: self, b: other, first: true }
    }

    /// At most the first `n` items.
    const fn take(self, n: usize) -> TryTake<Self> {
        TryTake { it: self, left: n }
    }

    /// All but the first `n` items.
    const fn skip(self, n: usize) -> TrySkip<Self> {
        TrySkip { it: self, n: n }
    }

    /// Every `step`th item, starting with the first (`step` > 0).
    #[track_caller]
    const fn step_by(self, step: usize) -> TryStepBy<Self> {
        if step == 0 {
            panic("TryIterator::step_by: step is 0; pass a positive step, e.g. `step_by(2)`");
        }
        TryStepBy { it: self, step: step, first: true }
    }

    /// The items before the first one `pred` rejects.
    const fn take_while(self, pred: fn(Item) throws (Error) -> bool) -> TryTakeWhile<Self> {
        TryTakeWhile { it: self, pred: pred, done: false }
    }

    /// The items from the first one `pred` rejects on.
    const fn skip_while(self, pred: fn(Item) throws (Error) -> bool) -> TrySkipWhile<Self> {
        TrySkipWhile { it: self, pred: pred, done: false }
    }

    /// The items of each `f(item)` (a plain `IntoIterator`).
    const fn flat_map<U: IntoIterator>(self, f: fn(Item) throws (Error) -> U) -> TryFlatMap<Self, U> {
        TryFlatMap { it: self, f: f, cur: none }
    }

    /// The running state: `f(init, x0)`, then `f` of that and `x1`, ...
    const fn scan<S>(self, init: S, f: fn(S, Item) throws (Error) -> S) -> TryScan<Self, S> {
        TryScan { it: self, state: init, f: f }
    }

    /// The same items, each passed to `f` first.
    const fn inspect(self, f: fn(Item) throws (Error)) -> TryInspect<Self> {
        TryInspect { it: self, f: f }
    }

    /// An iterator that can look at its next item without taking it.
    const fn peekable(self) -> TryPeekable<Self> {
        TryPeekable { it: self, peeked: none, has: false }
    }

    /// Lists of `size` items in order, the last one shorter (`size` > 0).
    #[track_caller]
    const fn chunks(self, size: usize) -> TryChunks<Self> {
        if size == 0 {
            panic("TryIterator::chunks: size is 0; pass a positive size, e.g. `chunks(2)`");
        }
        TryChunks { it: self, size: size }
    }

    /// A plain iterator of `Result`s: each error becomes a
    /// `Result::Err` item and stepping goes on, so a source that ends
    /// after an error gives that `Err` last.
    const fn results(self) -> Results<Self> {
        Results { it: self }
    }

    /// Gather the items into a `FromIterator` collection; the first
    /// error stops it and is thrown.
    const fn collect<C: FromIterator<Item>>(self) throws (Error) -> C {
        let err: List<Error> = List::new();
        let c: C = C::from_iter(Shunt { it: self, err: err });
        if err.len() > 0 {
            throw err[0];
        }
        c
    }

    const fn count(self) throws (Error) -> usize {
        let n: usize = 0;
        try for _ in self {
            n += 1;
        }
        n
    }

    const fn last(self) throws (Error) -> Item | none {
        let last: Item | none = none;
        try for x in self {
            last = x;
        }
        last
    }

    /// The `n`th remaining item (0-based), consuming the ones before it.
    const fn nth(ref self, n: usize) throws (Error) -> Item | none {
        for _ in 0..n {
            if (try self.next()) is none {
                return none;
            }
        }
        try self.next()
    }

    const fn fold<B>(self, init: B, f: fn(B, Item) throws (Error) -> B) throws (Error) -> B {
        let acc = init;
        try for x in self {
            acc = try f(acc, x);
        }
        acc
    }

    const fn for_each(self, f: fn(Item) throws (Error)) throws (Error) {
        try for x in self {
            try f(x);
        }
    }

    /// The items combined left to right with `f`; `none` for none.
    const fn reduce(self, f: fn(Item, Item) throws (Error) -> Item) throws (Error) -> Item | none {
        let acc: Item | none = none;
        try for x in self {
            acc = if let a: Item = acc { try f(a, x) } else { x };
        }
        acc
    }

    const fn any(self, pred: fn(Item) throws (Error) -> bool) throws (Error) -> bool {
        try for x in self {
            if try pred(x) {
                return true;
            }
        }
        false
    }

    const fn all(self, pred: fn(Item) throws (Error) -> bool) throws (Error) -> bool {
        try for x in self {
            if !(try pred(x)) {
                return false;
            }
        }
        true
    }

    const fn find(self, pred: fn(Item) throws (Error) -> bool) throws (Error) -> Item | none {
        try for x in self {
            if try pred(x) {
                return x;
            }
        }
        none
    }

    const fn position(self, pred: fn(Item) throws (Error) -> bool) throws (Error) -> usize | none {
        let i: usize = 0;
        try for x in self {
            if try pred(x) {
                return i;
            }
            i += 1;
        }
        none
    }

    /// The items `pred` accepts, then the rest, each in order.
    const fn partition(self, pred: fn(Item) throws (Error) -> bool) throws (Error) -> (List<Item>, List<Item>) {
        let yes: List<Item> = List::new();
        let no: List<Item> = List::new();
        try for x in self {
            if try pred(x) {
                yes.push(x);
            } else {
                no.push(x);
            }
        }
        (yes, no)
    }

    /// The items added up; `0` for none.
    const fn sum(self) throws (Error) -> Item where Item: Add<Output = Item> + Zero {
        let acc = Item::zero();
        try for x in self {
            acc += x;
        }
        acc
    }

    /// The items multiplied; `1` for none.
    const fn product(self) throws (Error) -> Item where Item: Mul<Output = Item> + One {
        let acc = Item::one();
        try for x in self {
            acc *= x;
        }
        acc
    }

    /// The smallest item (the first of equals).
    const fn min(self) throws (Error) -> Item | none where Item: Ord {
        let best: Item | none = none;
        try for x in self {
            if let b: Item = best {
                if x.cmp(b).is_lt() {
                    best = x;
                }
            } else {
                best = x;
            }
        }
        best
    }

    /// The largest item (the last of equals).
    const fn max(self) throws (Error) -> Item | none where Item: Ord {
        let best: Item | none = none;
        try for x in self {
            if let b: Item = best {
                if !x.cmp(b).is_lt() {
                    best = x;
                }
            } else {
                best = x;
            }
        }
        best
    }

    /// The item with the smallest `key` (the first of equals).
    const fn min_by_key<K: Ord>(self, key: fn(Item) throws (Error) -> K) throws (Error) -> Item | none {
        let best: Item | none = none;
        let best_key: K | none = none;
        try for x in self {
            let k = try key(x);
            if let b: K = best_key {
                if k.cmp(b).is_lt() {
                    best = x;
                    best_key = k;
                }
            } else {
                best = x;
                best_key = k;
            }
        }
        best
    }

    /// The item with the largest `key` (the last of equals).
    const fn max_by_key<K: Ord>(self, key: fn(Item) throws (Error) -> K) throws (Error) -> Item | none {
        let best: Item | none = none;
        let best_key: K | none = none;
        try for x in self {
            let k = try key(x);
            if let b: K = best_key {
                if !k.cmp(b).is_lt() {
                    best = x;
                    best_key = k;
                }
            } else {
                best = x;
                best_key = k;
            }
        }
        best
    }
}

/// A plain iterator of `Result`s as a `TryIterator`: an `Err` item is
/// thrown, then stepping goes on.
pub const fn from_results<T, E, I: IntoIterator<Item = Result<T, E>>>(it: I) -> FromResults<I::IntoIter, T, E> {
    FromResults { it: it.into_iter() }
}

/// A plain iterator as a `TryIterator` that never throws, for an API
/// that takes one: `iter::infallible::<IoError>(names)`.
pub const fn infallible<E, I: IntoIterator>(it: I) -> Infallible<I::IntoIter, E> {
    Infallible { it: it.into_iter(), err: none }
}

/// A `TryIterator` whose `next` calls `f`.
pub const fn try_from_fn<T, E>(f: fn() throws (E) -> (T | none)) -> TryFromFn<T, E> {
    TryFromFn { f: f }
}

/// The iterator `TryIterator::map` returns: `f` of each item.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryMap<I, U> {
    it: I;
    f: fn(I::Item) throws (I::Error) -> U;
}

impl<I: TryIterator, U> Debug for TryMap<I, U> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryMap") }
}

impl<I: TryIterator, U> TryIterator for TryMap<I, U> {
    type Item = U;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> U | none {
        if let x: I::Item = try self.it.next() {
            return try (self.f)(x);
        }
        none
    }
}

/// The iterator `TryIterator::filter` returns: the items `pred` accepts.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryFilter<I> {
    it: I;
    pred: fn(I::Item) throws (I::Error) -> bool;
}

impl<I: TryIterator> Debug for TryFilter<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryFilter") }
}

impl<I: TryIterator> TryIterator for TryFilter<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        while let x: I::Item = try self.it.next() {
            if try (self.pred)(x) {
                return x;
            }
        }
        none
    }
}

/// The iterator `map_err` returns: each error passed through `f`.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct MapErr<I, E2> {
    it: I;
    f: fn(I::Error) -> E2;
}

impl<I: TryIterator, E2> Debug for MapErr<I, E2> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("MapErr") }
}

impl<I: TryIterator, E2> TryIterator for MapErr<I, E2> {
    type Item = I::Item;
    type Error = E2;
    const fn next(ref self) throws (E2) -> I::Item | none {
        try self.it.next() catch e {
            throw (self.f)(e);
        }
    }
}

/// The iterator `TryIterator::enumerate` returns: `(index, item)` pairs from 0.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryEnumerate<I> {
    it: I;
    i: usize;
}

impl<I: TryIterator> Debug for TryEnumerate<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryEnumerate") }
}

impl<I: TryIterator> TryIterator for TryEnumerate<I> {
    type Item = (usize, I::Item);
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> (usize, I::Item) | none {
        if let x: I::Item = try self.it.next() {
            let at = self.i;
            self.i = at + 1;
            return (at, x);
        }
        none
    }
}

/// The iterator `TryIterator::zip` returns: pairs of items; ends with the
/// shorter side.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryZip<I, J> {
    a: I;
    b: J;
}

impl<I: TryIterator, J: Iterator> Debug for TryZip<I, J> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryZip") }
}

impl<I: TryIterator, J: Iterator> TryIterator for TryZip<I, J> {
    type Item = (I::Item, J::Item);
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> (I::Item, J::Item) | none {
        if let x: I::Item = try self.a.next() {
            if let y: J::Item = self.b.next() {
                return (x, y);
            }
        }
        none
    }
}

/// The iterator `TryIterator::chain` returns: every item of the first, then of
/// the second.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryChain<I, J> {
    a: I;
    b: J;
    first: bool;
}

impl<I: TryIterator, J: TryIterator<Item = I::Item, Error = I::Error>> Debug for TryChain<I, J> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryChain") }
}

impl<I: TryIterator, J: TryIterator<Item = I::Item, Error = I::Error>> TryIterator for TryChain<I, J> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        if self.first {
            if let x: I::Item = try self.a.next() {
                return x;
            }
            self.first = false;
        }
        try self.b.next()
    }
}

/// The iterator `TryIterator::take` returns: at most the first `n` items.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryTake<I> {
    it: I;
    left: usize;
}

impl<I: TryIterator> Debug for TryTake<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryTake") }
}

impl<I: TryIterator> TryIterator for TryTake<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        if self.left == 0 {
            return none;
        }
        self.left -= 1;
        try self.it.next()
    }
}

/// The iterator `TryIterator::skip` returns: all but the first `n` items.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TrySkip<I> {
    it: I;
    n: usize;
}

impl<I: TryIterator> Debug for TrySkip<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TrySkip") }
}

impl<I: TryIterator> TryIterator for TrySkip<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        while self.n > 0 {
            self.n -= 1;
            if (try self.it.next()) is none {
                return none;
            }
        }
        try self.it.next()
    }
}

/// The iterator `TryIterator::step_by` returns: the first item, then every
/// `step`th.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryStepBy<I> {
    it: I;
    step: usize;
    first: bool;
}

impl<I: TryIterator> Debug for TryStepBy<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryStepBy") }
}

impl<I: TryIterator> TryIterator for TryStepBy<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        if self.first {
            self.first = false;
            return try self.it.next();
        }
        try self.it.nth(self.step - 1)
    }
}

/// The iterator `TryIterator::take_while` returns: items while `pred` accepts
/// them.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryTakeWhile<I> {
    it: I;
    pred: fn(I::Item) throws (I::Error) -> bool;
    /// `pred` rejected an item: no more are taken.
    done: bool;
}

impl<I: TryIterator> Debug for TryTakeWhile<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryTakeWhile") }
}

impl<I: TryIterator> TryIterator for TryTakeWhile<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        if self.done {
            return none;
        }
        if let x: I::Item = try self.it.next() {
            if try (self.pred)(x) {
                return x;
            }
            self.done = true;
        }
        none
    }
}

/// The iterator `TryIterator::skip_while` returns: items from the first `pred`
/// rejects.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TrySkipWhile<I> {
    it: I;
    pred: fn(I::Item) throws (I::Error) -> bool;
    /// An item passed `pred`'s test: the rest go through unchecked.
    done: bool;
}

impl<I: TryIterator> Debug for TrySkipWhile<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TrySkipWhile") }
}

impl<I: TryIterator> TryIterator for TrySkipWhile<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        if self.done {
            return try self.it.next();
        }
        while let x: I::Item = try self.it.next() {
            if !(try (self.pred)(x)) {
                self.done = true;
                return x;
            }
        }
        none
    }
}

/// `flat_map`: `cur` is the inner iterator being drained.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryFlatMap<I, U> {
    it: I;
    f: fn(I::Item) throws (I::Error) -> U;
    cur: <U as IntoIterator>::IntoIter | none;
}

impl<I: TryIterator, U: IntoIterator> Debug for TryFlatMap<I, U> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryFlatMap") }
}

impl<I: TryIterator, U: IntoIterator> TryIterator for TryFlatMap<I, U> {
    type Item = U::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> U::Item | none {
        while true {
            if let inner: U::IntoIter = self.cur {
                if let x: U::Item = inner.next() {
                    self.cur = inner;
                    return x;
                }
                self.cur = none;
            } else if let x: I::Item = try self.it.next() {
                self.cur = (try (self.f)(x)).into_iter();
            } else {
                return none;
            }
        }
        none
    }
}

/// The iterator `TryIterator::scan` returns: `f` of a running state and each
/// item.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryScan<I, S> {
    it: I;
    state: S;
    f: fn(S, I::Item) throws (I::Error) -> S;
}

impl<I: TryIterator, S> Debug for TryScan<I, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryScan") }
}

impl<I: TryIterator, S> TryIterator for TryScan<I, S> {
    type Item = S;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> S | none {
        if let x: I::Item = try self.it.next() {
            let s = try (self.f)(self.state, x);
            self.state = s;
            return s;
        }
        none
    }
}

/// The iterator `TryIterator::inspect` returns: the items, each shown to `f`
/// first.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryInspect<I> {
    it: I;
    f: fn(I::Item) throws (I::Error);
}

impl<I: TryIterator> Debug for TryInspect<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryInspect") }
}

impl<I: TryIterator> TryIterator for TryInspect<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        if let x: I::Item = try self.it.next() {
            try (self.f)(x);
            return x;
        }
        none
    }
}

/// The iterator `TryIterator::peekable` returns: the items, with a look at the
/// next.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryPeekable<I> {
    it: I;
    peeked: I::Item | none;
    has: bool;
}

impl<I: TryIterator> Debug for TryPeekable<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryPeekable") }
}

impl<I: TryIterator> TryPeekable<I> {
    /// The next item, left in place for the following `next`; a throw
    /// leaves nothing peeked.
    pub const fn peek(ref self) throws (I::Error) -> I::Item | none {
        if !self.has {
            self.peeked = try self.it.next();
            self.has = true;
        }
        self.peeked
    }
}

impl<I: TryIterator> TryIterator for TryPeekable<I> {
    type Item = I::Item;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> I::Item | none {
        if self.has {
            self.has = false;
            return self.peeked;
        }
        try self.it.next()
    }
}

/// A throw drops the chunk being built.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryChunks<I> {
    it: I;
    size: usize;
}

impl<I: TryIterator> Debug for TryChunks<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryChunks") }
}

impl<I: TryIterator> TryIterator for TryChunks<I> {
    type Item = List<I::Item>;
    type Error = I::Error;
    const fn next(ref self) throws (I::Error) -> List<I::Item> | none {
        let out: List<I::Item> = List::with_capacity(self.size);
        while out.len() < self.size {
            if let x: I::Item = try self.it.next() {
                out.push(x);
            } else {
                break;
            }
        }
        if out.len() == 0 {
            return none;
        }
        out
    }
}

/// `results`'s adapter.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Results<I> {
    it: I;
}

impl<I: TryIterator> Debug for Results<I> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Results") }
}

impl<I: TryIterator> Iterator for Results<I> {
    type Item = Result<I::Item, I::Error>;
    const fn next(ref self) -> Result<I::Item, I::Error> | none {
        let r = try self.it.next() catch e {
            return Result::Err(e);
        };
        if let x: I::Item = r {
            return Result::Ok(x);
        }
        none
    }
}

/// The `TryIterator` `iter::from_results` returns: an `Err` item is
/// thrown.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct FromResults<I, T, E> {
    it: I;
}

impl<I: Iterator<Item = Result<T, E>>, T, E> Debug for FromResults<I, T, E> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("FromResults") }
}

impl<I: Iterator<Item = Result<T, E>>, T, E> TryIterator for FromResults<I, T, E> {
    type Item = T;
    type Error = E;
    const fn next(ref self) throws (E) -> T | none {
        if let r: Result<T, E> = self.it.next() {
            return try r.get();
        }
        none
    }
}

/// The `TryIterator` `iter::infallible` returns: the items, never an
/// error.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct Infallible<I, E> {
    it: I;
    /// Never set: it only carries `E`.
    err: E | none;
}

impl<I: Iterator, E> Debug for Infallible<I, E> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Infallible") }
}

impl<I: Iterator, E> TryIterator for Infallible<I, E> {
    type Item = I::Item;
    type Error = E;
    const fn next(ref self) throws (E) -> I::Item | none {
        if let e: E = self.err {
            throw e;
        }
        self.it.next()
    }
}

/// The `TryIterator` `iter::try_from_fn` returns: each item is `f()`.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct TryFromFn<T, E> {
    f: fn() throws (E) -> (T | none);
}

impl<T, E> Debug for TryFromFn<T, E> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TryFromFn") }
}

impl<T, E> TryIterator for TryFromFn<T, E> {
    type Item = T;
    type Error = E;
    const fn next(ref self) throws (E) -> T | none {
        try (self.f)()
    }
}

/// `collect`'s plain view of a `TryIterator`: ends at the first error,
/// which it keeps in `err` (shared with the caller).
struct Shunt<I> {
    it: I;
    err: List<I::Error>;
}

impl<I: TryIterator> Iterator for Shunt<I> {
    type Item = I::Item;
    const fn next(ref self) -> I::Item | none {
        if self.err.len() > 0 {
            return none;
        }
        try self.it.next() catch e {
            self.err.push(e);
            none
        }
    }
}

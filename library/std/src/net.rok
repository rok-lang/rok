// zero-copy hooks (Linux)

#[cfg(target_os = "linux")]
impl TcpStreamExt for TcpStream {
    fn sendfile(self, ref file: File, offset: u64, count: u64) throws (IoError) -> u64 {
        let done = 0u64;
        while done < count {
            let fd = try self.sock.enter();
            let r = unsafe { rok_net_sendfile(fd, file.fd(), (offset + done) as i64, (count - done) as usize) } as i64;
            self.sock.done();
            if would_block(r) {
                try self.sock.block(1, "sendfile");
                continue;
            }
            let k = try check(r, "sendfile");
            if k == 0 { break; }
            done += k as u64;
        }
        done
    }

    fn splice(self, ref src: File, count: u64) throws (IoError) -> u64 {
        let done = 0u64;
        while done < count {
            let fd = try self.sock.enter();
            let r = unsafe { rok_net_splice(fd, src.fd(), (count - done) as usize) } as i64;
            self.sock.done();
            let k = try check(r, "splice");
            if k == 0 { break; }
            done += k as u64;
        }
        done
    }

    fn write_zerocopy(self, buf: List<u8>) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        loop {
            let fd = try self.sock.enter();
            let r = unsafe { rok_net_send_zerocopy(fd, b, at, n) } as i64;
            self.sock.done();
            if would_block(r) {
                try self.sock.block(1, "write_zerocopy");
                continue;
            }
            return (try check(r, "write_zerocopy")) as usize;
        }
    }
}

// conveniences

/// `TcpStream::connect(addr)`.
pub fn tcp_connect<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpStream {
    try TcpStream::connect(addr)
}

/// `TcpStream::connect_async(addr)`.
pub async fn tcp_connect_async<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpStream {
    try await TcpStream::connect_async(addr)
}

/// `TcpListener::bind(addr)`.
pub fn tcp_listen<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpListener {
    try TcpListener::bind(addr)
}

/// `UdpSocket::bind(addr)`.
pub fn udp_bind<A: ToSocketAddrs>(addr: A) throws (IoError) -> UdpSocket {
    try UdpSocket::bind(addr)
}

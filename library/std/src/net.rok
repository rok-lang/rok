// rok::std::net: TCP / UDP sockets, addresses, DNS. Unix
// sockets are `os::unix::net`, the Linux kernel copies
// `os::linux::net::TcpStreamExt`.
//
// Three layers: `Socket` (domain, type, protocol and options, each call
// one system call), the typed `TcpStream::connect` / `TcpListener::bind` /
// `UdpSocket::bind` over `ToSocketAddrs`, and the free `tcp_connect` /
// `tcp_listen` / `udp_bind` beside them.
//
// Sockets are non-blocking underneath. Blocking calls wait in `poll`, so
// `set_*_timeout` bounds that wait (async uses `task::timeout`), and
// `set_nonblocking(true)` makes them throw `WouldBlock`. `*_async` calls
// suspend until the I/O driver sees the fd ready.
//
// A plain call never suspends: inside a task it blocks the
// worker, because a sync fn cannot suspend a stackless coroutine.
//
// `read(buf)` fills `buf[0..n]` of a `SliceMut<u8>`; writes take
// any `AsBytes`. No IPv6 multicast. TLS 1.3 is `tls`.

use rok::core::convert::AsBytes;
use rok::core::io::{Close, IoError, IoErrorKind, Read, Write, AsyncRead, AsyncWrite, AsyncClose};
use rok::std::fs::off;
use rok::std::sys::{check, would_block, region, mut_region, take_handle, use_begin, use_end, use_close};
use rok::core::time::Duration;
use rok::bare::mem::{GcBuf, buf_new};
#[cfg(target_family = "unix")]
use rok::std::os::unix::io::{AsRawFd, FromRawFd, RawFd};
#[cfg(target_os = "linux")]
use rok::std::os::linux::net::TcpStreamExt;
#[cfg(target_os = "linux")]
use rok::std::fs::File;
#[cfg(target_os = "windows")]
use rok::std::os::windows::io::{AsRawSocket, FromRawSocket, RawSocket, raw_socket, socket_fd};

pub mod tls;

// addresses

/// An IPv4 address.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct Ipv4Addr {
    octets: [u8; 4];
}

/// An IPv6 address.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct Ipv6Addr {
    segments: [u16; 8];
}

impl Ipv4Addr {
    /// The loopback address.
    pub const LOCALHOST: Ipv4Addr = Ipv4Addr { octets: [127u8, 0u8, 0u8, 1u8] };
    /// The unspecified (any) address.
    pub const UNSPECIFIED: Ipv4Addr = Ipv4Addr { octets: [0u8, 0u8, 0u8, 0u8] };

    /// The address `a.b.c.d`.
    pub const fn new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
        Ipv4Addr { octets: [a, b, c, d] }
    }

    /// The four bytes, most significant first.
    pub const fn octets(self) -> [u8; 4] { self.octets }

    /// The address as a big-endian number (`a.b.c.d` = `a << 24 | ..`).
    #[must_use]
    pub const fn to_bits(self) -> u32 {
        ((self.octets[0] as u32) << 24) | ((self.octets[1] as u32) << 16)
            | ((self.octets[2] as u32) << 8) | (self.octets[3] as u32)
    }

    /// `true` for `127.0.0.0/8`.
    pub const fn is_loopback(self) -> bool { self.octets[0] == 127u8 }
    /// `true` for `0.0.0.0`.
    pub const fn is_unspecified(self) -> bool { self.to_bits() == 0u32 }
    /// `true` for `224.0.0.0/4`.
    pub const fn is_multicast(self) -> bool { self.octets[0] >= 224u8 && self.octets[0] <= 239u8 }
}

impl Ipv6Addr {
    /// The loopback address.
    pub const LOCALHOST: Ipv6Addr = Ipv6Addr { segments: [0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 1u16] };
    /// The unspecified (any) address.
    pub const UNSPECIFIED: Ipv6Addr = Ipv6Addr { segments: [0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16] };

    /// The address `a:b:c:d:e:f:g:h`, one 16-bit segment each.
    pub const fn new(a: u16, b: u16, c: u16, d: u16, e: u16, f: u16, g: u16, h: u16) -> Ipv6Addr {
        Ipv6Addr { segments: [a, b, c, d, e, f, g, h] }
    }

    /// The eight 16-bit groups, most significant first.
    pub const fn segments(self) -> [u16; 8] { self.segments }

    /// `true` for `::1`.
    pub const fn is_loopback(self) -> bool {
        for i in 0..7 {
            if self.segments[i] != 0u16 { return false; }
        }
        self.segments[7] == 1u16
    }
}

/// The address a big-endian number spells.
impl From<u32> for Ipv4Addr {
    const fn from(bits: u32) -> Ipv4Addr {
        Ipv4Addr::new((bits >> 24) as u8, (bits >> 16) as u8, (bits >> 8) as u8, bits as u8)
    }
}

impl Display for Ipv4Addr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"{self.octets[0]}.{self.octets[1]}.{self.octets[2]}.{self.octets[3]}")
    }
}

impl Debug for Ipv4Addr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

impl Display for Ipv6Addr {
    /// RFC 5952: lowercase hex, the longest run (2+) of zero groups as `::`.
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        let best = -1;
        let best_len = 1;
        let i = 0;
        while i < 8 {
            let j = i;
            while j < 8 && self.segments[j] == 0u16 { j += 1; }
            if j - i > best_len {
                best = i;
                best_len = j - i;
            }
            i = if j > i { j } else { i + 1 };
        }
        let out = "";
        let k = 0;
        while k < 8 {
            if k == best {
                out += "::";
                k += best_len;
                continue;
            }
            if out.len() > 0 && !out.ends_with(":") { out += ":"; }
            out += hex(self.segments[k] as u64);
            k += 1;
        }
        try f.write_str(out)
    }
}

impl Debug for Ipv6Addr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

/// Lowercase hex digits of `n`.
const fn hex(n: u64) -> str {
    if n == 0u64 { return "0"; }
    let digits = "0123456789abcdef";
    let out = "";
    while n > 0u64 {
        let d = (n % 16u64) as usize;
        out = digits[d:d + 1] + out;
        n /= 16u64;
    }
    out
}

/// An IPv4 or IPv6 address.
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub enum IpAddr {
    V4(Ipv4Addr),
    V6(Ipv6Addr),
}

impl IpAddr {
    /// `true` for an IPv4 address.
    pub const fn is_ipv4(self) -> bool {
        match self {
            IpAddr::V4(_) => true,
            IpAddr::V6(_) => false,
        }
    }

    /// `true` for an IPv6 address.
    pub const fn is_ipv6(self) -> bool { !self.is_ipv4() }

    /// `true` for a loopback address (`127.0.0.0/8`, `::1`).
    pub const fn is_loopback(self) -> bool {
        match self {
            IpAddr::V4(a) => a.is_loopback(),
            IpAddr::V6(a) => a.is_loopback(),
        }
    }
}

impl From<Ipv4Addr> for IpAddr {
    const fn from(ip: Ipv4Addr) -> IpAddr { IpAddr::V4(ip) }
}

impl From<Ipv6Addr> for IpAddr {
    const fn from(ip: Ipv6Addr) -> IpAddr { IpAddr::V6(ip) }
}

impl Display for IpAddr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            IpAddr::V4(a) => try Display::fmt(a, ref f),
            IpAddr::V6(a) => try Display::fmt(a, ref f),
        }
    }
}

impl Debug for IpAddr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

/// `"127.0.0.1"` / `"::1"`.
impl FromStr for IpAddr {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> IpAddr {
        if let a: Ipv4Addr = parse_v4(s) { return IpAddr::V4(a); }
        if let a: Ipv6Addr = parse_v6(s) { return IpAddr::V6(a); }
        throw bad_addr(s);
    }
}

/// An IPv4 address and a port.
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct SocketAddrV4 {
    ip: Ipv4Addr;
    port: u16;
}

impl SocketAddrV4 {
    /// `ip:port`.
    pub const fn new(ip: Ipv4Addr, port: u16) -> SocketAddrV4 { SocketAddrV4 { ip, port } }
    /// The IP address.
    pub const fn ip(self) -> Ipv4Addr { self.ip }
    /// The port.
    pub const fn port(self) -> u16 { self.port }
    /// Replace the IP address.
    pub const fn set_ip(ref self, ip: Ipv4Addr) { self.ip = ip; }
    /// Replace the port.
    pub const fn set_port(ref self, port: u16) { self.port = port; }
}

/// An IPv6 address, a port, the flow label and the scope (interface)
/// id.
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct SocketAddrV6 {
    ip: Ipv6Addr;
    port: u16;
    flow_info: u32;
    scope_id: u32;
}

impl SocketAddrV6 {
    /// `[ip]:port`, with an optional flow label and scope id.
    pub const fn new(ip: Ipv6Addr, port: u16, flow_info: u32 = 0u32, scope_id: u32 = 0u32) -> SocketAddrV6 {
        SocketAddrV6 { ip, port, flow_info, scope_id }
    }
    /// The IP address.
    pub const fn ip(self) -> Ipv6Addr { self.ip }
    /// The port.
    pub const fn port(self) -> u16 { self.port }
    /// The flow label (`sin6_flowinfo`).
    pub const fn flow_info(self) -> u32 { self.flow_info }
    /// The scope id (`sin6_scope_id`), an interface index.
    pub const fn scope_id(self) -> u32 { self.scope_id }
    /// Replace the IP address.
    pub const fn set_ip(ref self, ip: Ipv6Addr) { self.ip = ip; }
    /// Replace the port.
    pub const fn set_port(ref self, port: u16) { self.port = port; }
    /// Replace the flow label.
    pub const fn set_flow_info(ref self, flow_info: u32) { self.flow_info = flow_info; }
    /// Replace the scope id.
    pub const fn set_scope_id(ref self, scope_id: u32) { self.scope_id = scope_id; }
}

impl Display for SocketAddrV4 {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"{self.ip}:{self.port}") }
}

impl Debug for SocketAddrV4 {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

impl Display for SocketAddrV6 {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"[{self.ip}]:{self.port}") }
}

impl Debug for SocketAddrV6 {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

/// An IPv4 or IPv6 socket address.
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub enum SocketAddr {
    V4(SocketAddrV4),
    V6(SocketAddrV6),
}

impl SocketAddr {
    /// `ip` and `port`; an IPv6 one has flow info and scope id 0.
    pub const fn new(ip: IpAddr, port: u16) -> SocketAddr {
        match ip {
            IpAddr::V4(a) => SocketAddr::V4(SocketAddrV4::new(a, port)),
            IpAddr::V6(a) => SocketAddr::V6(SocketAddrV6::new(a, port)),
        }
    }

    /// The IP address.
    pub const fn ip(self) -> IpAddr {
        match self {
            SocketAddr::V4(a) => IpAddr::V4(a.ip),
            SocketAddr::V6(a) => IpAddr::V6(a.ip),
        }
    }

    /// The port.
    pub const fn port(self) -> u16 {
        match self {
            SocketAddr::V4(a) => a.port,
            SocketAddr::V6(a) => a.port,
        }
    }

    /// An address of the other family replaces the whole address (flow
    /// info and scope id 0).
    pub const fn set_ip(ref self, ip: IpAddr) {
        self = SocketAddr::new(ip, self.port());
    }

    /// Replace the port.
    pub const fn set_port(ref self, port: u16) {
        self = match self {
            SocketAddr::V4(a) => SocketAddr::V4(SocketAddrV4::new(a.ip, port)),
            SocketAddr::V6(a) => SocketAddr::V6(SocketAddrV6::new(a.ip, port, a.flow_info, a.scope_id)),
        };
    }

    /// `true` for an IPv4 address.
    pub const fn is_ipv4(self) -> bool {
        match self {
            SocketAddr::V4(_) => true,
            SocketAddr::V6(_) => false,
        }
    }

    /// `true` for an IPv6 address.
    pub const fn is_ipv6(self) -> bool { !self.is_ipv4() }

    const fn family(self) -> i32 { if self.is_ipv4() { 4 } else { 6 } }
}

impl From<SocketAddrV4> for SocketAddr {
    const fn from(a: SocketAddrV4) -> SocketAddr { SocketAddr::V4(a) }
}

impl From<SocketAddrV6> for SocketAddr {
    const fn from(a: SocketAddrV6) -> SocketAddr { SocketAddr::V6(a) }
}

impl Display for SocketAddr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            SocketAddr::V4(a) => try Display::fmt(a, ref f),
            SocketAddr::V6(a) => try Display::fmt(a, ref f),
        }
    }
}

impl Debug for SocketAddr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

const fn bad_addr(s: str) -> ParseError {
    ParseError::new(s, 0, "invalid IP address syntax")
}

/// Digits of `s` in `radix` (at most `max_len` of them) as a number.
const fn number(s: str, radix: u64, max_len: usize) -> u64 | none {
    if s.len() == 0 || s.len() > max_len { return none; }
    let n = 0u64;
    for c in s.chars() {
        let d: u32 = c.to_digit(radix as u32) else { return none; };
        n = n * radix + d as u64;
    }
    n
}

const fn parse_v4(s: str) -> Ipv4Addr | none {
    let parts: List<u8> = List::new();
    for p in s.split(".") {
        let n = number(p, 10u64, 3)?;
        if n > 255u64 { return none; }
        parts.push(n as u8);
    }
    if parts.len() != 4 { return none; }
    Ipv4Addr::new(parts[0], parts[1], parts[2], parts[3])
}

/// Hex groups of one side of `::` (empty side: no groups).
const fn groups(s: str) -> List<u16> | none {
    let out: List<u16> = List::new();
    if s.len() == 0 { return out; }
    for p in s.split(":") {
        out.push(number(p, 16u64, 4)? as u16);
    }
    out
}

const fn parse_v6(s: str) -> Ipv6Addr | none {
    let seg: List<u16> = List::new();
    if let at: usize = s.find("::") {
        let h = groups(s[:at])?;
        let t = groups(s[at + 2:])?;
        if h.len() + t.len() > 7 { return none; }
        for g in h { seg.push(g); }
        for _ in h.len() + t.len()..8 { seg.push(0u16); }
        for g in t { seg.push(g); }
    } else {
        seg = groups(s)?;
    }
    if seg.len() != 8 { return none; }
    Ipv6Addr::new(seg[0], seg[1], seg[2], seg[3], seg[4], seg[5], seg[6], seg[7])
}

impl FromStr for Ipv4Addr {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> Ipv4Addr {
        if let a: Ipv4Addr = parse_v4(s) { return a; }
        throw bad_addr(s);
    }
}

impl FromStr for Ipv6Addr {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> Ipv6Addr {
        if let a: Ipv6Addr = parse_v6(s) { return a; }
        throw bad_addr(s);
    }
}

/// A port number (`0..=65535`).
const fn port_of(s: str) -> u16 | none {
    let p = number(s, 10u64, 5)?;
    if p > 65535u64 { return none; }
    p as u16
}

const fn parse_socket_addr(s: str) -> SocketAddr | none {
    if s.starts_with("[") {
        let at = s.find("]:")?;
        return SocketAddr::V6(SocketAddrV6::new(parse_v6(s[1:at])?, port_of(s[at + 2:])?));
    }
    let at = s.rfind(":")?;
    SocketAddr::V4(SocketAddrV4::new(parse_v4(s[:at])?, port_of(s[at + 1:])?))
}

/// `"127.0.0.1:8080"` / `"[::1]:8080"`.
impl FromStr for SocketAddr {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> SocketAddr {
        if let a: SocketAddr = parse_socket_addr(s) { return a; }
        throw ParseError::new(s, 0, "invalid socket address syntax");
    }
}

// runtime marshalling: `[family, port, flow, scope, bytes..16]`

pub(pkg) const ADDR_WORDS: usize = 20;

const fn words_of(a: SocketAddr) -> GcBuf<i64> {
    unsafe {
        let w: GcBuf<i64> = buf_new(ADDR_WORDS);
        match a {
            SocketAddr::V4(v) => {
                w[0] = 4i64;
                w[1] = v.port as i64;
                for i in 0..4usize { w[4 + i] = v.ip.octets[i] as i64; }
            }
            SocketAddr::V6(v) => {
                w[0] = 6i64;
                w[1] = v.port as i64;
                w[2] = v.flow_info as i64;
                w[3] = v.scope_id as i64;
                for i in 0..8usize {
                    let g = v.ip.segments[i] as i64;
                    w[4 + 2 * i] = g / 256i64;
                    w[5 + 2 * i] = g % 256i64;
                }
            }
        }
        w
    }
}

const fn addr_at(w: GcBuf<i64>, at: usize) -> SocketAddr {
    unsafe {
        let b = |i: usize| -> i64 { w[at + 4 + i] };
        let port = w[at + 1] as u16;
        if w[at] == 6i64 {
            let s: List<u16> = List::new();
            for i in 0..8usize { s.push((b(2 * i) * 256i64 + b(2 * i + 1)) as u16); }
            let ip = Ipv6Addr::new(s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7]);
            return SocketAddr::V6(SocketAddrV6::new(ip, port, w[at + 2] as u32, w[at + 3] as u32));
        }
        SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::new(b(0) as u8, b(1) as u8, b(2) as u8, b(3) as u8), port))
    }
}

// DNS

const MAX_ADDRS: usize = 32;

fn resolve_raw(host: str, port: u16) throws (IoError) -> List<SocketAddr> {
    unsafe {
        let out: GcBuf<i64> = buf_new(ADDR_WORDS * MAX_ADDRS);
        let n = rok_net_resolve(host, port, out, MAX_ADDRS);
        if n < 0 { throw IoError::resolver(0 - n, host); }
        if n == 0 { throw IoError::new(IoErrorKind::NotFound, host + ": no addresses"); }
        let addrs: List<SocketAddr> = List::new();
        for i in 0..n as usize { addrs.push(addr_at(out, i * ADDR_WORDS)); }
        addrs
    }
}

/// Addresses of `host`: `"name:port"`, `"[v6]:port"`, a socket address,
/// or a bare name / IP (port 0). The addresses come in the system
/// resolver's order (its preferred address first), at most 32; a name
/// with none throws `NotFound`.
pub fn resolve(host: str) throws (IoError) -> List<SocketAddr> {
    if let a: SocketAddr = parse_socket_addr(host) { return [a]; }
    let name = host;
    let port = 0u16;
    if let at: usize = host.rfind(":") {
        let rest = host[:at];
        if !rest.contains(":") {
            if let p: u16 = port_of(host[at + 1:]) {
                name = rest;
                port = p;
            }
        }
    }
    if name.starts_with("[") && name.ends_with("]") {
        name = name[1:name.len() - 1];
    }
    try resolve_raw(name, port)
}

/// What names the socket addresses to try, in order: a `SocketAddr`,
/// `"host:port"` text (resolved, `net::resolve`), an `(IpAddr, u16)`
/// pair or a list of addresses.
pub trait ToSocketAddrs {
    /// The addresses, in the order to try them.
    fn to_socket_addrs(self) throws (IoError) -> List<SocketAddr>;
}

impl ToSocketAddrs for SocketAddr {
    fn to_socket_addrs(self) throws (IoError) -> List<SocketAddr> { [self] }
}

impl ToSocketAddrs for SocketAddrV4 {
    fn to_socket_addrs(self) throws (IoError) -> List<SocketAddr> { [SocketAddr::V4(self)] }
}

impl ToSocketAddrs for SocketAddrV6 {
    fn to_socket_addrs(self) throws (IoError) -> List<SocketAddr> { [SocketAddr::V6(self)] }
}

impl ToSocketAddrs for str {
    fn to_socket_addrs(self) throws (IoError) -> List<SocketAddr> { try resolve(self) }
}

impl ToSocketAddrs for (IpAddr, u16) {
    fn to_socket_addrs(self) throws (IoError) -> List<SocketAddr> {
        let (ip, port) = self;
        [SocketAddr::new(ip, port)]
    }
}

impl ToSocketAddrs for List<SocketAddr> {
    fn to_socket_addrs(self) throws (IoError) -> List<SocketAddr> { self.clone() }
}

/// `f` on each address of `addr` until one succeeds: its result, or
/// the last error.
fn each_addr<A: ToSocketAddrs, T>(addr: A, f: fn(SocketAddr) throws (IoError) -> T) throws (IoError) -> T {
    let last = IoError::new(IoErrorKind::InvalidInput, "no address to use");
    for a in try addr.to_socket_addrs() {
        let r = try f(a) catch e {
            last = e;
            continue;
        };
        return r;
    }
    throw last;
}

/// The first address of `addr`.
fn first_addr<A: ToSocketAddrs>(addr: A) throws (IoError) -> SocketAddr {
    let all = try addr.to_socket_addrs();
    if all.len() == 0 { throw IoError::new(IoErrorKind::InvalidInput, "no address to use"); }
    all[0]
}

/// `[fd, calls in flight]` (`io::use_begin`) shared by copies of a
/// handle, plus `[nonblocking, read timeout ns, write timeout ns]`
/// (timeouts -1: none).
pub(pkg) struct Sock {
    pub(pkg) fd: GcBuf<i32>;
    pub(pkg) opts: GcBuf<i64>;
}

pub(pkg) const fn sock_of(fd: i32) -> Sock {
    unsafe {
        let cell: GcBuf<i32> = buf_new(2);
        cell[0] = fd;
        let opts: GcBuf<i64> = buf_new(3);
        opts[1] = -1i64;
        opts[2] = -1i64;
        Sock { fd: cell, opts: opts }
    }
}

fn new_sock(family: i32, kind: i32, proto: i32) throws (IoError) -> Sock {
    let fd = try check(unsafe { rok_net_socket(family, kind, proto) } as i64, "socket");
    sock_of(fd as i32)
}

const fn timed_out(what: str) -> IoError {
    IoError::new(IoErrorKind::TimedOut, what + ": timed out")
}

/// The chunk `read_to_end` grows its list by.
const CHUNK: usize = 16384;

impl Sock {
    /// The fd for `io::copy`'s kernel path: only without timeouts or
    /// non-blocking mode, which the kernel copy would not keep (`-1`;
    /// also on Windows, where a socket is no file handle).
    pub(pkg) const fn copy_fd(self) -> i32 {
        unsafe {
            if cfg!(target_os = "windows") || self.opts[0] != 0i64 || self.opts[1] >= 0i64 || self.opts[2] >= 0i64 { return -1; }
            self.fd()
        }
    }

    /// The fd (`-1` once closed).
    pub(pkg) const fn fd(self) -> i32 {
        unsafe {
            if (self.fd[1] & 1) != 0 { return -1; }
            self.fd[0]
        }
    }

    /// The fd to wait on for readiness (no call on it), or of a sock not
    /// shared yet.
    pub(pkg) const fn live(self) throws (IoError) -> i32 {
        let fd = self.fd();
        if fd < 0 { throw IoError::new(IoErrorKind::InvalidInput, "socket is closed"); }
        fd
    }

    /// The fd for one call, which `done` ends. A `close` meanwhile
    /// leaves the fd open until then.
    pub(pkg) fn enter(self) throws (IoError) -> i32 {
        let fd = unsafe { self.fd[0] };
        if fd < 0 || !use_begin(self.fd, 1) {
            throw IoError::new(IoErrorKind::InvalidInput, "socket is closed");
        }
        fd
    }

    pub(pkg) fn done(self) {
        if use_end(self.fd, 1) { self.release(); }
    }

    pub(pkg) fn release(self) {
        unsafe {
            let fd = take_handle(self.fd, 0, -1);
            if fd >= 0 {
                _ = rok_os_close(fd);
                task::wake_io(fd);
            }
        }
    }

    /// Close the fd, dropping the OS's error (`Drop`, error paths); a
    /// task waiting on its readiness wakes and finds it closed (the
    /// kernel sends no event for a closed fd). With calls in flight
    /// through other copies, the last of them releases the fd.
    pub(pkg) fn discard(self) {
        let fd = unsafe { self.fd[0] };
        if use_close(self.fd, 1) == 0 {
            self.release();
        } else if fd >= 0 {
            task::wake_io(fd);
        }
    }

    /// `discard`, throwing the OS's error. Released by a call in
    /// flight, or closed already: nothing to report.
    pub(pkg) fn close(self) throws (IoError) {
        let fd = unsafe { self.fd[0] };
        if use_close(self.fd, 1) != 0 {
            if fd >= 0 { task::wake_io(fd); }
            return;
        }
        let h = take_handle(self.fd, 0, -1);
        if h < 0 { return; }
        let r = unsafe { rok_os_close(h) };
        task::wake_io(h);
        try check(r as i64, "close");
    }

    /// `close` that suspends the task: on a blocking thread when
    /// `SO_LINGER` makes it wait for unsent data, else at once.
    pub(pkg) async fn close_async(self) throws (IoError) {
        if (try self.getopt(13) catch _ { -1i64 }) <= 0i64 {
            try self.close();
            return;
        }
        try await off(|| try self.close());
    }

    /// `shutdown(2)`; waiting tasks wake to see the end of stream or the
    /// write error.
    pub(pkg) fn shutdown(self, how: Shutdown) throws (IoError) {
        let h = match how { Shutdown::Read => 0, Shutdown::Write => 1, Shutdown::Both => 2 };
        let fd = try self.enter();
        let r = unsafe { rok_net_shutdown(fd, h) };
        self.done();
        try check(r as i64, "shutdown");
        task::wake_io(fd);
    }

    /// After a `WouldBlock`: throw it (non-blocking mode) or wait for
    /// readiness within the timeout.
    pub(pkg) fn block(self, write: i32, what: str) throws (IoError) {
        unsafe {
            if self.opts[0] != 0i64 {
                throw IoError::new(IoErrorKind::WouldBlock, what + ": operation would block");
            }
            let fd = try self.enter();
            let r = rok_net_wait(fd, write, self.opts[1 + write as usize]);
            self.done();
            if r == 0 { throw timed_out(what); }
            try check(r as i64, what);
        }
    }

    pub(pkg) const fn set_timeout(self, write: usize, dur: Duration | none) {
        unsafe {
            self.opts[1 + write] = match dur {
                d: Duration => d.as_ns(),
                none => -1i64,
            };
        }
    }

    pub(pkg) const fn timeout(self, write: usize) -> Duration | none {
        unsafe {
            let ns = self.opts[1 + write];
            if ns < 0i64 { return none; }
            Duration::ns(ns)
        }
    }

    pub(pkg) fn addr(self, peer: i32) throws (IoError) -> SocketAddr {
        unsafe {
            let out: GcBuf<i64> = buf_new(ADDR_WORDS);
            let fd = try self.enter();
            let r = rok_net_addr(fd, out, peer);
            self.done();
            try check(r as i64, "getsockname");
            addr_at(out, 0)
        }
    }

    pub(pkg) fn setopt(self, opt: i32, val: i64) throws (IoError) {
        let fd = try self.enter();
        let r = unsafe { rok_net_setopt(fd, opt, val) };
        self.done();
        try check(r as i64, "setsockopt");
    }

    pub(pkg) fn getopt(self, opt: i32) throws (IoError) -> i64 {
        unsafe {
            let out: GcBuf<i64> = buf_new(1);
            let fd = try self.enter();
            let r = rok_net_getopt(fd, opt, out);
            self.done();
            try check(r as i64, "getsockopt");
            out[0]
        }
    }

    pub(pkg) const fn set_nonblocking(self, nb: bool) {
        unsafe {
            self.opts[0] = if nb { 1i64 } else { 0i64 };
        }
    }

    /// Bind `addr`, then listen when `backlog >= 0`; the sock is closed
    /// on failure.
    pub(pkg) fn bind_listen(self, addr: SocketAddr, backlog: i32) throws (IoError) {
        let r = unsafe { rok_net_bind(try self.live(), words_of(addr)) };
        if r >= 0 && backlog >= 0 { r = unsafe { rok_net_listen(try self.live(), backlog) }; }
        if r < 0 {
            self.discard();
            throw IoError::from_os_code(-r, f"bind {addr}");
        }
    }

    /// One accepted connection and its peer, or `none` on `WouldBlock`.
    pub(pkg) fn accept_once(self) throws (IoError) -> (Sock, SocketAddr) | none {
        unsafe {
            let out: GcBuf<i64> = buf_new(ADDR_WORDS);
            let l = try self.enter();
            let fd = rok_net_accept(l, out) as i64;
            self.done();
            if would_block(fd) { return none; }
            try check(fd, "accept");
            (sock_of(fd as i32), addr_at(out, 0))
        }
    }

    pub(pkg) fn accept(self) throws (IoError) -> (Sock, SocketAddr) {
        loop {
            if let c: (Sock, SocketAddr) = try self.accept_once() { return c; }
            try self.block(0, "accept");
        }
    }

    pub(pkg) async fn accept_async(self) throws (IoError) -> (Sock, SocketAddr) {
        loop {
            if let c: (Sock, SocketAddr) = try self.accept_once() { return c; }
            await task::readable(try self.live());
        }
    }

    /// One datagram from `buf[at..at + n]` to `addr`: the count, or
    /// `none` on `WouldBlock`.
    pub(pkg) fn send_to_once(self, buf: GcBuf<u8>, at: usize, n: usize, addr: SocketAddr) throws (IoError) -> usize | none {
        let fd = try self.enter();
        let r = unsafe { rok_net_send_to(fd, buf, at, n, words_of(addr)) } as i64;
        self.done();
        if would_block(r) { return none; }
        (try check(r, f"send_to {addr}")) as usize
    }

    /// One datagram into `buf`: its length and sender, or `none` on
    /// `WouldBlock`.
    pub(pkg) fn recv_from_once(self, buf: SliceMut<u8>) throws (IoError) -> (usize, SocketAddr) | none {
        unsafe {
            let out: GcBuf<i64> = buf_new(ADDR_WORDS);
            let (b, at, n) = mut_region(buf);
            let fd = try self.enter();
            let r = rok_net_recv_from(fd, b, at, n, out) as i64;
            self.done();
            if would_block(r) { return none; }
            ((try check(r, "recv_from")) as usize, addr_at(out, 0))
        }
    }

    pub(pkg) fn send_to(self, data: Slice<u8>, addr: SocketAddr) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.send_to_once(b, at, n, addr) { return k; }
            try self.block(1, "send_to");
        }
    }

    pub(pkg) async fn send_to_async(self, data: Slice<u8>, addr: SocketAddr) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.send_to_once(b, at, n, addr) { return k; }
            await task::writable(try self.live());
        }
    }

    pub(pkg) fn recv_from(self, buf: SliceMut<u8>) throws (IoError) -> (usize, SocketAddr) {
        loop {
            if let r: (usize, SocketAddr) = try self.recv_from_once(buf) { return r; }
            try self.block(0, "recv_from");
        }
    }

    pub(pkg) async fn recv_from_async(self, buf: SliceMut<u8>) throws (IoError) -> (usize, SocketAddr) {
        loop {
            if let r: (usize, SocketAddr) = try self.recv_from_once(buf) { return r; }
            await task::readable(try self.live());
        }
    }

    /// The handle in a new cell: `self` and its copies see it closed.
    pub(pkg) const fn moved(self) -> Sock {
        unsafe {
            let s = sock_of(take_handle(self.fd, 0, -1));
            for i in 0..3usize { s.opts[i] = self.opts[i]; }
            s
        }
    }

    pub(pkg) fn try_clone(self) throws (IoError) -> Sock {
        unsafe {
            let old = try self.enter();
            let r = rok_os_dup(old);
            self.done();
            let fd = try check(r as i64, "dup");
            let s = sock_of(fd as i32);
            for i in 0..3usize { s.opts[i] = self.opts[i]; }
            s
        }
    }

    /// One read into `buf[at..at + n]`: the count, or `none` on `WouldBlock`.
    pub(pkg) fn read_once(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize | none {
        let fd = try self.enter();
        let r = unsafe { rok_net_recv(fd, buf, at, n) } as i64;
        self.done();
        if would_block(r) { return none; }
        (try check(r, "read")) as usize
    }

    /// One write of `buf[at..at + n]`: the count, or `none` on `WouldBlock`.
    pub(pkg) fn write_once(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize | none {
        let fd = try self.enter();
        let r = unsafe { rok_net_send(fd, buf, at, n) } as i64;
        self.done();
        if would_block(r) { return none; }
        (try check(r, "write")) as usize
    }

    pub(pkg) fn read_into(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize {
        loop {
            if let k: usize = try self.read_once(buf, at, n) { return k; }
            try self.block(0, "read");
        }
    }

    pub(pkg) async fn read_into_async(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize {
        loop {
            if let k: usize = try self.read_once(buf, at, n) { return k; }
            await task::readable(try self.live());
        }
    }

    pub(pkg) fn read(self, buf: SliceMut<u8>) throws (IoError) -> usize {
        let (b, at, n) = mut_region(buf);
        try self.read_into(b, at, n)
    }

    pub(pkg) async fn read_async(self, buf: SliceMut<u8>) throws (IoError) -> usize {
        let (b, at, n) = mut_region(buf);
        try await self.read_into_async(b, at, n)
    }

    pub(pkg) fn read_to_end(self) throws (IoError) -> List<u8> {
        let out: List<u8> = List::new();
        loop {
            let m = out.len();
            out.reserve(CHUNK);
            unsafe { out.set_len(m + CHUNK) };
            let (b, at, _) = region(out);
            let k = try self.read_into(b, at + m, CHUNK) catch e { unsafe { out.set_len(m) }; throw e; };
            unsafe { out.set_len(m + k) };
            if k == 0 { return out; }
        }
    }

    pub(pkg) async fn read_to_end_async(self) throws (IoError) -> List<u8> {
        let out: List<u8> = List::new();
        loop {
            let m = out.len();
            out.reserve(CHUNK);
            unsafe { out.set_len(m + CHUNK) };
            let (b, at, _) = region(out);
            let k = try await self.read_into_async(b, at + m, CHUNK) catch e { unsafe { out.set_len(m) }; throw e; };
            unsafe { out.set_len(m + k) };
            if k == 0 { return out; }
        }
    }

    pub(pkg) fn write(self, data: Slice<u8>) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.write_once(b, at, n) { return k; }
            try self.block(1, "write");
        }
    }

    pub(pkg) async fn write_async(self, data: Slice<u8>) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.write_once(b, at, n) { return k; }
            await task::writable(try self.live());
        }
    }

    pub(pkg) fn write_all(self, data: Slice<u8>) throws (IoError) {
        let (b, at, n) = unsafe { data.raw_parts() };
        let done = 0usize;
        while done < n {
            match try self.write_once(b, at + done, n - done) {
                k: usize => {
                    if k == 0 { throw IoError::new(IoErrorKind::Other, "failed to write whole buffer"); }
                    done += k;
                }
                none => try self.block(1, "write"),
            }
        }
    }

    pub(pkg) async fn write_all_async(self, data: Slice<u8>) throws (IoError) {
        let (b, at, n) = unsafe { data.raw_parts() };
        let done = 0usize;
        while done < n {
            match try self.write_once(b, at + done, n - done) {
                k: usize => {
                    if k == 0 { throw IoError::new(IoErrorKind::Other, "failed to write whole buffer"); }
                    done += k;
                }
                none => await task::writable(try self.live()),
            }
        }
    }
}

// sockets

/// An address family.
#[non_exhaustive]
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub enum Domain {
    /// `AF_INET`.
    Ipv4,
    /// `AF_INET6`.
    Ipv6,
}

impl Domain {
    /// The family of `addr`.
    pub const fn for_address(addr: SocketAddr) -> Domain {
        if addr.is_ipv4() { Domain::Ipv4 } else { Domain::Ipv6 }
    }

    const fn code(self) -> i32 {
        match self {
            Domain::Ipv4 => 4,
            Domain::Ipv6 => 6,
        }
    }
}

/// A socket type.
#[non_exhaustive]
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub enum SocketType {
    /// `SOCK_STREAM`: TCP over IP.
    Stream,
    /// `SOCK_DGRAM`: UDP over IP.
    Datagram,
    /// `SOCK_RAW`: IP packets of one protocol (privileged; not on WASI).
    Raw,
}

impl SocketType {
    const fn code(self) -> i32 {
        match self {
            SocketType::Stream => 1,
            SocketType::Datagram => 2,
            SocketType::Raw => 3,
        }
    }
}

/// An IP protocol number (the IANA registry).
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub struct Protocol {
    number: i32;
}

impl Protocol {
    /// ICMP for IPv4.
    pub const ICMPV4: Protocol = Protocol { number: 1 };
    /// TCP.
    pub const TCP: Protocol = Protocol { number: 6 };
    /// UDP.
    pub const UDP: Protocol = Protocol { number: 17 };
    /// ICMP for IPv6.
    pub const ICMPV6: Protocol = Protocol { number: 58 };

    /// The protocol numbered `number` (IANA).
    pub const fn new(number: i32) -> Protocol { Protocol { number } }
    /// The IANA protocol number.
    pub const fn number(self) -> i32 { self.number }
}

/// A socket as the OS has it: any domain, type and protocol, its
/// options, and each call one system call (`bind` does not set
/// `SO_REUSEADDR`, `connect` does not resolve). `TcpStream::from(s)`,
/// `TcpListener::from(s)` and `UdpSocket::from(s)` take it over once it
/// is set up, and `Socket::from` goes back. It has one owner: `let b = a`
/// moves it.
pub struct Socket {
    sock: Sock;
}

impl Debug for Socket {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Socket") }
}

impl Socket {
    /// A new socket (non-blocking underneath, not inherited by child
    /// processes); `protocol` none is the default for `ty`.
    pub fn new(domain: Domain, ty: SocketType, protocol: Protocol | none = none) throws (IoError) -> Socket {
        let p = match protocol {
            p: Protocol => p.number,
            none => 0,
        };
        Socket { sock: try new_sock(domain.code(), ty.code(), p) }
    }

    /// Bind to `addr`.
    pub fn bind(self, addr: SocketAddr) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_bind(fd, words_of(addr)) };
        self.sock.done();
        if r < 0 { throw IoError::from_os_code(-r, f"bind {addr}"); }
    }

    /// Listen for connections, queueing at most `backlog` pending ones.
    pub fn listen(self, backlog: i32) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_listen(fd, backlog) };
        self.sock.done();
        try check(r as i64, "listen");
    }

    /// Connect, blocking until the handshake is done (in non-blocking
    /// mode, `WouldBlock` while it is in progress).
    pub fn connect(self, addr: SocketAddr) throws (IoError) {
        try self.connect_within(addr, -1i64);
    }

    /// `connect` that throws `TimedOut` after `dur`.
    pub fn connect_timeout(self, addr: SocketAddr, dur: Duration) throws (IoError) {
        try self.connect_within(addr, dur.as_ns());
    }

    fn connect_within(self, addr: SocketAddr, limit: i64) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_connect(fd, words_of(addr)) };
        self.sock.done();
        if r < 0 { throw IoError::from_os_code(-r, f"connect {addr}"); }
        if r == 0 { return; }
        if unsafe { self.sock.opts[0] } != 0i64 {
            throw IoError::new(IoErrorKind::WouldBlock, f"connect {addr}: in progress");
        }
        let w = unsafe { rok_net_wait(try self.sock.live(), 1, limit) };
        if w == 0 { throw timed_out(f"connect {addr}"); }
        if w < 0 { throw IoError::from_os_code(-w, f"connect {addr}"); }
        let e = unsafe { rok_net_sock_error(try self.sock.live()) };
        if e < 0 { throw IoError::from_os_code(-e, f"connect {addr}"); }
    }

    /// `connect` that suspends the task during the handshake.
    pub async fn connect_async(ref self, addr: SocketAddr) throws (IoError) {
        let r = unsafe { rok_net_connect(try self.sock.live(), words_of(addr)) };
        if r < 0 { throw IoError::from_os_code(-r, f"connect {addr}"); }
        if r == 0 { return; }
        await task::writable(try self.sock.live());
        while unsafe { rok_net_wait(try self.sock.live(), 1, 0i64) } == 0 {
            await task::writable(try self.sock.live());
        }
        let e = unsafe { rok_net_sock_error(try self.sock.live()) };
        if e < 0 { throw IoError::from_os_code(-e, f"connect {addr}"); }
    }

    /// The next connection and its peer, blocking until one arrives.
    pub fn accept(self) throws (IoError) -> (Socket, SocketAddr) {
        let (s, a) = try self.sock.accept();
        (Socket { sock: s }, a)
    }

    /// `accept` that suspends the task until a connection arrives.
    pub async fn accept_async(ref self) throws (IoError) -> (Socket, SocketAddr) {
        let (s, a) = try await self.sock.accept_async();
        (Socket { sock: s }, a)
    }

    /// The address this socket is bound to.
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }
    /// The address of the connected peer.
    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }

    /// Shut down reading, writing or both.
    pub fn shutdown(self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    /// As `shutdown`, which never waits.
    pub async fn shutdown_async(ref self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    /// Send the datagram `buf` to `addr`; bytes sent.
    pub fn send_to<B: AsBytes>(self, buf: B, addr: SocketAddr) throws (IoError) -> usize {
        try self.sock.send_to(buf.byte_slice(), addr)
    }

    /// `send_to` that suspends the task while the socket is full.
    pub async fn send_to_async<B: AsBytes>(ref self, buf: B, addr: SocketAddr) throws (IoError) -> usize {
        try await self.sock.send_to_async(buf.byte_slice(), addr)
    }

    /// The next datagram into `buf[0..n]` (truncated to `buf.len()`)
    /// and its sender.
    pub fn recv_from(self, buf: SliceMut<u8>) throws (IoError) -> (usize, SocketAddr) { try self.sock.recv_from(buf) }

    /// `recv_from` that suspends the task until a datagram arrives.
    pub async fn recv_from_async(ref self, buf: SliceMut<u8>) throws (IoError) -> (usize, SocketAddr) {
        try await self.sock.recv_from_async(buf)
    }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub const fn set_nonblocking(self, nb: bool) { self.sock.set_nonblocking(nb); }
    /// Limit blocking reads to `dur`, then `TimedOut`; `none` waits
    /// forever.
    pub const fn set_read_timeout(self, dur: Duration | none) { self.sock.set_timeout(0, dur); }
    /// Limit blocking writes to `dur`, then `TimedOut`; `none` waits
    /// forever.
    pub const fn set_write_timeout(self, dur: Duration | none) { self.sock.set_timeout(1, dur); }
    /// The read timeout; `none` for none.
    pub const fn read_timeout(self) -> Duration | none { self.sock.timeout(0) }
    /// The write timeout; `none` for none.
    pub const fn write_timeout(self) -> Duration | none { self.sock.timeout(1) }

    /// `SO_REUSEADDR`.
    pub fn set_reuse_address(self, on: bool) throws (IoError) { try self.sock.setopt(7, flag(on)); }
    /// `SO_REUSEADDR`.
    pub fn reuse_address(self) throws (IoError) -> bool { (try self.sock.getopt(7)) != 0i64 }

    /// `SO_REUSEPORT`; `Unsupported` off Unix.
    pub fn set_reuse_port(self, on: bool) throws (IoError) { try self.sock.setopt(8, flag(on)); }
    /// `SO_REUSEPORT`.
    pub fn reuse_port(self) throws (IoError) -> bool { (try self.sock.getopt(8)) != 0i64 }

    /// `TCP_NODELAY`.
    pub fn set_nodelay(self, on: bool) throws (IoError) { try self.sock.setopt(1, flag(on)); }
    /// `TCP_NODELAY`.
    pub fn nodelay(self) throws (IoError) -> bool { (try self.sock.getopt(1)) != 0i64 }

    /// Keepalive probes after `alive` idle (whole seconds); `none` = off.
    pub fn set_keepalive(self, alive: Duration | none) throws (IoError) {
        match alive {
            d: Duration => try self.sock.setopt(2, d.as_secs()),
            none => try self.sock.setopt(2, -1i64),
        }
    }

    /// `SO_BROADCAST`.
    pub fn set_broadcast(self, on: bool) throws (IoError) { try self.sock.setopt(3, flag(on)); }
    /// `SO_BROADCAST`.
    pub fn broadcast(self) throws (IoError) -> bool { (try self.sock.getopt(3)) != 0i64 }

    /// `SO_RCVBUF` (the OS may round it, and Linux doubles it).
    pub fn set_recv_buffer_size(self, size: usize) throws (IoError) { try self.sock.setopt(9, size as i64); }
    /// `SO_RCVBUF`, as the OS reports it.
    pub fn recv_buffer_size(self) throws (IoError) -> usize { (try self.sock.getopt(9)) as usize }

    /// `SO_SNDBUF`.
    pub fn set_send_buffer_size(self, size: usize) throws (IoError) { try self.sock.setopt(10, size as i64); }
    /// `SO_SNDBUF`, as the OS reports it.
    pub fn send_buffer_size(self) throws (IoError) -> usize { (try self.sock.getopt(10)) as usize }

    /// `IP_TTL` of an IPv4 socket.
    pub fn set_ttl(self, ttl: u32) throws (IoError) { try self.sock.setopt(11, ttl as i64); }
    /// `IP_TTL`.
    pub fn ttl(self) throws (IoError) -> u32 { (try self.sock.getopt(11)) as u32 }

    /// `IPV6_V6ONLY`: an IPv6 socket that takes no IPv4 traffic.
    pub fn set_only_v6(self, on: bool) throws (IoError) { try self.sock.setopt(12, flag(on)); }
    /// `IPV6_V6ONLY`.
    pub fn only_v6(self) throws (IoError) -> bool { (try self.sock.getopt(12)) != 0i64 }

    /// `SO_LINGER` (whole seconds): `close` waits that long for unsent
    /// data; `none` = off.
    pub fn set_linger(self, dur: Duration | none) throws (IoError) {
        match dur {
            d: Duration => try self.sock.setopt(13, d.as_secs()),
            none => try self.sock.setopt(13, -1i64),
        }
    }

    /// `SO_LINGER` in whole seconds; `none` when off.
    pub fn linger(self) throws (IoError) -> Duration | none {
        let s = try self.sock.getopt(13);
        if s < 0i64 { return none; }
        Duration::secs(s)
    }

    /// A second handle to the same socket.
    pub fn try_clone(self) throws (IoError) -> Socket { Socket { sock: try self.sock.try_clone() } }

    /// Close now, throwing the OS's error; later calls fail with
    /// `InvalidInput`.
    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

const fn flag(on: bool) -> i64 { if on { 1i64 } else { 0i64 } }

impl Read for Socket {
    fn read(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try self.sock.read(buf) }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }
}

impl Write for Socket {
    fn write<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }
    /// Nothing to flush: writes go straight to the socket.
    const fn flush(ref self) throws (IoError) {}
    fn write_all<B: AsBytes>(ref self, buf: B) throws (IoError) { try self.sock.write_all(buf.byte_slice()); }
}

impl AsyncRead for Socket {
    async fn read_async(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try await self.sock.read_async(buf) }
    async fn read_to_end_async(ref self) throws (IoError) -> List<u8> { try await self.sock.read_to_end_async() }
}

impl AsyncWrite for Socket {
    async fn write_async<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }
    async fn flush_async(ref self) throws (IoError) {}
    async fn write_all_async<B: AsBytes>(ref self, buf: B) throws (IoError) {
        try await self.sock.write_all_async(buf.byte_slice());
    }
}

impl Close for Socket {
    fn close(self) throws (IoError) { try self.sock.close(); }
}

impl AsyncClose for Socket {
    async fn close_async(self) throws (IoError) { try await self.sock.close_async(); }
}

impl Drop for Socket {
    fn drop(ref self) { self.sock.discard(); }
}

// TCP

/// Which half of a connection `shutdown` closes.
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub enum Shutdown {
    Read,
    Write,
    Both,
}

/// A TCP connection. It has one owner (`let b = a` moves it); close it
/// with `try s.close()` or `using`.
pub struct TcpStream {
    sock: Sock;
}

impl Debug for TcpStream {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TcpStream") }
}

/// A listening TCP socket.
pub struct TcpListener {
    sock: Sock;
}

impl Debug for TcpListener {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TcpListener") }
}

/// Start connecting `addr`: the socket and whether it is still pending.
fn connect_start(addr: SocketAddr) throws (IoError) -> (Sock, bool) {
    let s = try new_sock(addr.family(), 1, 0);
    let r = unsafe { rok_net_connect(try s.live(), words_of(addr)) };
    if r < 0 {
        s.discard();
        throw IoError::from_os_code(-r, f"connect {addr}");
    }
    (s, r == 1)
}

fn connect_finish(s: Sock, addr: SocketAddr) throws (IoError) -> TcpStream {
    let e = unsafe { rok_net_sock_error(try s.live()) };
    if e < 0 {
        s.discard();
        throw IoError::from_os_code(-e, f"connect {addr}");
    }
    TcpStream { sock: s }
}

fn connect_wait(addr: SocketAddr, limit: i64) throws (IoError) -> TcpStream {
    let (s, pending) = try connect_start(addr);
    if pending {
        let r = unsafe { rok_net_wait(try s.live(), 1, limit) };
        if r <= 0 {
            s.discard();
            if r == 0 { throw timed_out(f"connect {addr}"); }
            throw IoError::from_os_code(-r, f"connect {addr}");
        }
    }
    try connect_finish(s, addr)
}

async fn connect_one_async(addr: SocketAddr) throws (IoError) -> TcpStream {
    let (s, pending) = try connect_start(addr);
    if pending {
        await task::writable(try s.live());
        // A spurious wake: wait until the connect resolved.
        while unsafe { rok_net_wait(try s.live(), 1, 0i64) } == 0 {
            await task::writable(try s.live());
        }
    }
    try connect_finish(s, addr)
}

impl TcpStream {
    /// Connect to the first address of `addr` that accepts, blocking
    /// until the handshake is done.
    pub fn connect<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpStream {
        try each_addr(addr, |a| try connect_wait(a, -1i64))
    }

    /// Connect to `addr`, giving up after `dur`.
    pub fn connect_timeout(addr: SocketAddr, dur: Duration) throws (IoError) -> TcpStream {
        try connect_wait(addr, dur.as_ns())
    }

    /// `connect` that suspends the task during each handshake.
    pub async fn connect_async<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpStream {
        let last = IoError::new(IoErrorKind::InvalidInput, "no address to use");
        for a in try addr.to_socket_addrs() {
            let s = try await connect_one_async(a) catch e {
                last = e;
                continue;
            };
            return s;
        }
        throw last;
    }

    /// The remote end's address.
    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }
    /// This end's address.
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    /// Shut down the read half, the write half or both; the peer reads end
    /// of stream after `Write`.
    pub fn shutdown(self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    /// As `shutdown`, which never waits.
    pub async fn shutdown_async(ref self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    /// Turn Nagle's algorithm off (`TCP_NODELAY`) or back on.
    pub fn set_nodelay(self, nodelay: bool) throws (IoError) { try self.sock.setopt(1, flag(nodelay)); }
    /// `TCP_NODELAY`.
    pub fn nodelay(self) throws (IoError) -> bool { (try self.sock.getopt(1)) != 0i64 }

    /// Keepalive probes after `alive` idle (whole seconds); `none` = off.
    pub fn set_keepalive(self, alive: Duration | none) throws (IoError) {
        match alive {
            d: Duration => try self.sock.setopt(2, d.as_secs()),
            none => try self.sock.setopt(2, -1i64),
        }
    }

    /// Set `IP_TTL`.
    pub fn set_ttl(self, ttl: u32) throws (IoError) { try self.sock.setopt(11, ttl as i64); }
    /// `IP_TTL`.
    pub fn ttl(self) throws (IoError) -> u32 { (try self.sock.getopt(11)) as u32 }

    /// Make a blocking read throw `TimedOut` after `dur`; `none` waits forever.
    pub const fn set_read_timeout(self, dur: Duration | none) { self.sock.set_timeout(0, dur); }
    /// Make a blocking write throw `TimedOut` after `dur`; `none` waits forever.
    pub const fn set_write_timeout(self, dur: Duration | none) { self.sock.set_timeout(1, dur); }
    /// The read timeout; `none` when reads wait forever.
    pub const fn read_timeout(self) -> Duration | none { self.sock.timeout(0) }
    /// The write timeout; `none` when writes wait forever.
    pub const fn write_timeout(self) -> Duration | none { self.sock.timeout(1) }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub const fn set_nonblocking(self, nb: bool) { self.sock.set_nonblocking(nb); }

    /// A second descriptor on the same socket (`dup`), with this one's
    /// timeouts and blocking mode.
    pub fn try_clone(self) throws (IoError) -> TcpStream {
        TcpStream { sock: try self.sock.try_clone() }
    }

    /// Close now, throwing the OS's error; later calls fail with
    /// `InvalidInput`.
    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

impl From<Socket> for TcpStream {
    /// A connected stream socket.
    fn from(s: Socket) -> TcpStream {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        TcpStream { sock }
    }
}

impl From<TcpStream> for Socket {
    fn from(s: TcpStream) -> Socket {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        Socket { sock }
    }
}

impl Read for TcpStream {
    fn read(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try self.sock.read(buf) }
    #[internal]
    const fn copy_handle(self) -> i32 { self.sock.copy_fd() }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }
}

impl Write for TcpStream {
    fn write<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }
    /// Nothing to flush: writes go straight to the socket.
    const fn flush(ref self) throws (IoError) {}
    #[internal]
    const fn copy_handle(self) -> i32 { self.sock.copy_fd() }
    fn write_all<B: AsBytes>(ref self, buf: B) throws (IoError) { try self.sock.write_all(buf.byte_slice()); }
}

/// Cancel-safe: a cancelled read or write moved no bytes.
impl AsyncRead for TcpStream {
    async fn read_async(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try await self.sock.read_async(buf) }
    async fn read_to_end_async(ref self) throws (IoError) -> List<u8> { try await self.sock.read_to_end_async() }
}

impl AsyncWrite for TcpStream {
    async fn write_async<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }
    async fn flush_async(ref self) throws (IoError) {}
    async fn write_all_async<B: AsBytes>(ref self, buf: B) throws (IoError) {
        try await self.sock.write_all_async(buf.byte_slice());
    }
}

impl Close for TcpStream {
    fn close(self) throws (IoError) { try self.sock.close(); }
}

impl AsyncClose for TcpStream {
    async fn close_async(self) throws (IoError) { try await self.sock.close_async(); }
}

impl Drop for TcpStream {
    fn drop(ref self) { self.sock.discard(); }
}

/// A listening TCP socket on `addr`: `SO_REUSEADDR` (not on Windows,
/// where it would let another socket take the port), backlog 128.
fn listen_on(addr: SocketAddr) throws (IoError) -> TcpListener {
    let s = try new_sock(addr.family(), 1, 0);
    if !cfg!(target_os = "windows") {
        try s.setopt(7, 1i64) catch e {
            s.discard();
            throw e;
        };
    }
    try s.bind_listen(addr, 128);
    TcpListener { sock: s }
}

impl TcpListener {
    /// Bind and listen on the first address of `addr` that works
    /// (`SO_REUSEADDR` off Windows, backlog 128). Port 0 picks one: see
    /// `local_addr`.
    pub fn bind<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpListener {
        try each_addr(addr, |a| try listen_on(a))
    }

    /// The listening sockets the host handed this program, in order:
    /// WASI's pre-opened sockets (wasmtime `-S tcplisten=ADDR`, preview 1:
    /// `wasm32-wasip1-threads`), systemd socket activation (`LISTEN_FDS`) on
    /// Unix; none on Windows. Where a program cannot bind sockets
    /// itself, these are how it serves.
    pub fn inherited() -> List<TcpListener> {
        unsafe {
            let fds: GcBuf<i32> = buf_new(64);
            let n = rok_net_listeners(fds, 64);
            let out: List<TcpListener> = List::new();
            for i in 0..n as usize {
                out.push(TcpListener { sock: sock_of(fds[i]) });
            }
            out
        }
    }

    /// The next connection and its peer, blocking until one arrives.
    pub fn accept(self) throws (IoError) -> (TcpStream, SocketAddr) {
        let (s, a) = try self.sock.accept();
        (TcpStream { sock: s }, a)
    }

    /// `accept` that suspends the task until a connection arrives.
    pub async fn accept_async(ref self) throws (IoError) -> (TcpStream, SocketAddr) {
        let (s, a) = try await self.sock.accept_async();
        (TcpStream { sock: s }, a)
    }

    /// The bound address (the port picked when bound to port 0).
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    /// Set `IP_TTL`.
    pub fn set_ttl(self, ttl: u32) throws (IoError) { try self.sock.setopt(11, ttl as i64); }
    /// `IP_TTL`.
    pub fn ttl(self) throws (IoError) -> u32 { (try self.sock.getopt(11)) as u32 }

    /// A second descriptor on the same socket (`dup`).
    pub fn try_clone(self) throws (IoError) -> TcpListener {
        TcpListener { sock: try self.sock.try_clone() }
    }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub const fn set_nonblocking(self, nb: bool) { self.sock.set_nonblocking(nb); }

    /// `try for s in l.incoming() { .. }`: connections forever; a failed
    /// `accept` ends the loop with its error. The listener stays its
    /// owner's to close.
    pub const fn incoming(self) -> Incoming { Incoming { sock: self.sock } }

    /// Close now, throwing the OS's error.
    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

impl From<Socket> for TcpListener {
    /// A bound, listening stream socket.
    fn from(s: Socket) -> TcpListener {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        TcpListener { sock }
    }
}

impl From<TcpListener> for Socket {
    fn from(s: TcpListener) -> Socket {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        Socket { sock }
    }
}

impl Close for TcpListener {
    /// Stop listening now; later calls fail with `InvalidInput`.
    fn close(self) throws (IoError) { try self.sock.close(); }
}

impl AsyncClose for TcpListener {
    async fn close_async(self) throws (IoError) { try await self.sock.close_async(); }
}

impl Drop for TcpListener {
    fn drop(ref self) { self.sock.discard(); }
}

/// `TcpListener::incoming`: a view of the listener.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `try for`, or call `try {}.collect()`")]
pub struct Incoming {
    sock: Sock;
}

impl Debug for Incoming {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Incoming") }
}

impl TryIterator for Incoming {
    type Item = TcpStream;
    type Error = IoError;
    fn next(ref self) throws (IoError) -> TcpStream | none {
        let (s, _) = try self.sock.accept();
        TcpStream { sock: s }
    }
}

// UDP

/// A UDP socket. It has one owner: `let b = a` moves it.
pub struct UdpSocket {
    sock: Sock;
}

fn udp_on(addr: SocketAddr) throws (IoError) -> UdpSocket {
    let s = try new_sock(addr.family(), 2, 0);
    try s.bind_listen(addr, -1);
    UdpSocket { sock: s }
}

impl Debug for UdpSocket {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("UdpSocket") }
}

impl UdpSocket {
    /// Bind the first address of `addr` that works.
    pub fn bind<A: ToSocketAddrs>(addr: A) throws (IoError) -> UdpSocket {
        try each_addr(addr, |a| try udp_on(a))
    }

    /// Send the datagram `buf` to the first address of `addr`; bytes
    /// sent.
    pub fn send_to<B: AsBytes, A: ToSocketAddrs>(self, buf: B, addr: A) throws (IoError) -> usize {
        try self.sock.send_to(buf.byte_slice(), try first_addr(addr))
    }

    /// `send_to`, suspending the task instead of blocking.
    pub async fn send_to_async<B: AsBytes, A: ToSocketAddrs>(ref self, buf: B, addr: A) throws (IoError) -> usize {
        try await self.sock.send_to_async(buf.byte_slice(), try first_addr(addr))
    }

    /// The next datagram into `buf[0..n]` (truncated to `buf.len()`)
    /// and its sender.
    pub fn recv_from(self, buf: SliceMut<u8>) throws (IoError) -> (usize, SocketAddr) { try self.sock.recv_from(buf) }

    /// `recv_from` that suspends the task until a datagram arrives.
    pub async fn recv_from_async(ref self, buf: SliceMut<u8>) throws (IoError) -> (usize, SocketAddr) {
        try await self.sock.recv_from_async(buf)
    }

    /// Fix the peer to the first address of `addr` that takes it: `send`
    /// / `recv` then talk to it only.
    pub fn connect<A: ToSocketAddrs>(self, addr: A) throws (IoError) {
        let fd = try self.sock.live();
        try each_addr(addr, |a| {
            let r = unsafe { rok_net_connect(fd, words_of(a)) };
            try check(r as i64, f"connect {a}");
        });
    }

    /// As `connect`: a UDP connect only records the peer, so it never
    /// waits (a name in `addr` is resolved as `connect` does).
    pub async fn connect_async<A: ToSocketAddrs>(ref self, addr: A) throws (IoError) { try self.connect(addr); }

    /// Send `buf` as one datagram to the peer set by `connect`.
    pub fn send<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try self.sock.write(buf.byte_slice())
    }

    /// `send`, suspending the task instead of blocking.
    pub async fn send_async<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }

    /// The next datagram from the `connect` peer into `buf` (truncated to
    /// `buf.len()`); its length.
    pub fn recv(self, buf: SliceMut<u8>) throws (IoError) -> usize { try self.sock.read(buf) }

    /// `recv`, suspending the task instead of blocking.
    pub async fn recv_async(ref self, buf: SliceMut<u8>) throws (IoError) -> usize {
        try await self.sock.read_async(buf)
    }

    /// The bound address.
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }
    /// The peer set by `connect`; throws without one.
    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }

    /// Allow sending to broadcast addresses (`SO_BROADCAST`).
    pub fn set_broadcast(self, on: bool) throws (IoError) { try self.sock.setopt(3, flag(on)); }
    /// `SO_BROADCAST`.
    pub fn broadcast(self) throws (IoError) -> bool { (try self.sock.getopt(3)) != 0i64 }

    /// Set `IP_TTL`.
    pub fn set_ttl(self, ttl: u32) throws (IoError) { try self.sock.setopt(11, ttl as i64); }
    /// `IP_TTL`.
    pub fn ttl(self) throws (IoError) -> u32 { (try self.sock.getopt(11)) as u32 }

    /// Join the multicast group `addr` on the interface whose address is
    /// `interface` (`0.0.0.0`: the default).
    pub fn join_multicast_v4(self, addr: Ipv4Addr, interface: Ipv4Addr) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_multicast_v4(fd, addr.to_bits(), interface.to_bits(), 1) };
        self.sock.done();
        try check(r as i64, "join_multicast_v4");
    }

    /// Leave the multicast group `addr` on `interface`.
    pub fn leave_multicast_v4(self, addr: Ipv4Addr, interface: Ipv4Addr) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_multicast_v4(fd, addr.to_bits(), interface.to_bits(), 0) };
        self.sock.done();
        try check(r as i64, "leave_multicast_v4");
    }

    /// Whether this host receives its own multicast datagrams.
    pub fn set_multicast_loop_v4(self, on: bool) throws (IoError) { try self.sock.setopt(4, flag(on)); }

    /// Hops a multicast datagram may take (`IP_MULTICAST_TTL`).
    pub fn set_multicast_ttl_v4(self, ttl: u32) throws (IoError) {
        try self.sock.setopt(5, ttl as i64);
    }

    /// `UDP_SEGMENT` (GSO); `Unsupported` off Linux.
    pub fn set_segment_size(self, size: u16) throws (IoError) {
        try self.sock.setopt(6, size as i64);
    }

    /// Make a blocking read throw `TimedOut` after `dur`; `none` waits forever.
    pub const fn set_read_timeout(self, dur: Duration | none) { self.sock.set_timeout(0, dur); }
    /// Make a blocking write throw `TimedOut` after `dur`; `none` waits forever.
    pub const fn set_write_timeout(self, dur: Duration | none) { self.sock.set_timeout(1, dur); }
    /// The read timeout; `none` waits forever.
    pub const fn read_timeout(self) -> Duration | none { self.sock.timeout(0) }
    /// The write timeout; `none` waits forever.
    pub const fn write_timeout(self) -> Duration | none { self.sock.timeout(1) }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub const fn set_nonblocking(self, nb: bool) { self.sock.set_nonblocking(nb); }

    /// A second descriptor on the same socket (`dup`).
    pub fn try_clone(self) throws (IoError) -> UdpSocket {
        UdpSocket { sock: try self.sock.try_clone() }
    }

    /// Close now, throwing the OS's error.
    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

impl From<Socket> for UdpSocket {
    /// A datagram socket.
    fn from(s: Socket) -> UdpSocket {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        UdpSocket { sock }
    }
}

impl From<UdpSocket> for Socket {
    fn from(s: UdpSocket) -> Socket {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        Socket { sock }
    }
}

impl Close for UdpSocket {
    fn close(self) throws (IoError) { try self.sock.close(); }
}

impl AsyncClose for UdpSocket {
    async fn close_async(self) throws (IoError) { try await self.sock.close_async(); }
}

impl Drop for UdpSocket {
    fn drop(ref self) { self.sock.discard(); }
}


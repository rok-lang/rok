// rok::std::net (stdlib 302): TCP / UDP / Unix sockets, addresses, DNS.
//
// Sockets are non-blocking underneath. Blocking calls wait in `poll`, so
// `set_*_timeout` bounds that wait (async uses `task::timeout`), and
// `set_nonblocking(true)` makes them throw `WouldBlock`. `*_async` calls
// suspend until the I/O driver sees the fd ready (refs-lang 7.7).
//
// Spec 302 lets the plain calls suspend inside a task; here they block
// the worker, because a sync fn cannot suspend a stackless coroutine.
//
// `read(buf)` fills `buf[0..n]` of a pre-sized `List<u8>`; writes take
// any `AsBytes`. A Unix listener's `accept` gives the peer's bound path
// (`none`: unnamed). `sendfile` / `splice` are Linux only; no IPv6
// multicast or `MSG_ZEROCOPY` (302.7). TLS 1.3 is `tls` (302.5).

use rok::std::io::{IoError, IoErrorKind, RawFd, Reader, Writer, AsBytes, check, would_block, region, take_handle, use_begin, use_end, use_close};
use rok::std::time::Duration;
use rok::std::fs::File;
use rok::std::path::{AsPath, Path};

pub mod tls;

// addresses (302.4)

pub struct Ipv4Addr {
    octets: [u8; 4];
}

pub struct Ipv6Addr {
    segments: [u16; 8];
}

impl Ipv4Addr {
    pub const LOCALHOST: Ipv4Addr = Ipv4Addr { octets: [127u8, 0u8, 0u8, 1u8] };
    pub const UNSPECIFIED: Ipv4Addr = Ipv4Addr { octets: [0u8, 0u8, 0u8, 0u8] };

    pub const fn new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
        Ipv4Addr { octets: [a, b, c, d] }
    }

    /// The four bytes, most significant first.
    pub const fn octets(self) -> [u8; 4] { self.octets }

    /// The address as a big-endian number (`a.b.c.d` = `a << 24 | ..`).
    pub const fn to_bits(self) -> u32 {
        ((self.octets[0] as u32) << 24) | ((self.octets[1] as u32) << 16)
            | ((self.octets[2] as u32) << 8) | (self.octets[3] as u32)
    }

    pub const fn is_loopback(self) -> bool { self.octets[0] == 127u8 }
    pub const fn is_unspecified(self) -> bool { self.to_bits() == 0u32 }
    pub const fn is_multicast(self) -> bool { self.octets[0] >= 224u8 && self.octets[0] <= 239u8 }
}

impl Ipv6Addr {
    pub const LOCALHOST: Ipv6Addr = Ipv6Addr { segments: [0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 1u16] };
    pub const UNSPECIFIED: Ipv6Addr = Ipv6Addr { segments: [0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16] };

    pub const fn new(a: u16, b: u16, c: u16, d: u16, e: u16, f: u16, g: u16, h: u16) -> Ipv6Addr {
        Ipv6Addr { segments: [a, b, c, d, e, f, g, h] }
    }

    /// The eight 16-bit groups, most significant first.
    pub const fn segments(self) -> [u16; 8] { self.segments }

    pub const fn is_loopback(self) -> bool {
        for i in 0..7 {
            if self.segments[i] != 0u16 { return false; }
        }
        self.segments[7] == 1u16
    }
}

impl PartialEq for Ipv4Addr {
    const fn eq(self, rhs: Ipv4Addr) -> bool { self.to_bits() == rhs.to_bits() }
    const fn ne(self, rhs: Ipv4Addr) -> bool { !self.eq(rhs) }
}

impl PartialEq for Ipv6Addr {
    const fn eq(self, rhs: Ipv6Addr) -> bool {
        for i in 0..8 {
            if self.segments[i] != rhs.segments[i] { return false; }
        }
        true
    }
    const fn ne(self, rhs: Ipv6Addr) -> bool { !self.eq(rhs) }
}

impl Display for Ipv4Addr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"{self.octets[0]}.{self.octets[1]}.{self.octets[2]}.{self.octets[3]}")
    }
}

impl Debug for Ipv4Addr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

impl Display for Ipv6Addr {
    /// RFC 5952: lowercase hex, the longest run (2+) of zero groups as `::`.
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        let best = -1;
        let best_len = 1;
        let i = 0;
        while i < 8 {
            let j = i;
            while j < 8 && self.segments[j] == 0u16 { j += 1; }
            if j - i > best_len {
                best = i;
                best_len = j - i;
            }
            i = if j > i { j } else { i + 1 };
        }
        let out = "";
        let k = 0;
        while k < 8 {
            if k == best {
                out += "::";
                k += best_len;
                continue;
            }
            if out.len() > 0 && !out.ends_with(":") { out += ":"; }
            out += hex(self.segments[k] as u64);
            k += 1;
        }
        try f.write_str(out)
    }
}

impl Debug for Ipv6Addr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

/// Lowercase hex digits of `n`.
const fn hex(n: u64) -> str {
    if n == 0u64 { return "0"; }
    let digits = "0123456789abcdef";
    let out = "";
    while n > 0u64 {
        let d = (n % 16u64) as usize;
        out = digits[d:d + 1] + out;
        n /= 16u64;
    }
    out
}

pub struct SocketAddrV4 {
    pub ip: Ipv4Addr;
    pub port: u16;
}

pub struct SocketAddrV6 {
    pub ip: Ipv6Addr;
    pub port: u16;
    pub flow_info: u32;
    pub scope_id: u32;
}

pub enum SocketAddr {
    V4(SocketAddrV4),
    V6(SocketAddrV6),
}

impl SocketAddr {
    pub const fn v4(ip: Ipv4Addr, port: u16) -> SocketAddr {
        SocketAddr::V4(SocketAddrV4 { ip: ip, port: port })
    }

    pub const fn v6(ip: Ipv6Addr, port: u16) -> SocketAddr {
        SocketAddr::V6(SocketAddrV6 { ip: ip, port: port, flow_info: 0u32, scope_id: 0u32 })
    }

    pub const fn port(self) -> u16 {
        match self {
            SocketAddr::V4(a) => a.port,
            SocketAddr::V6(a) => a.port,
        }
    }

    pub const fn with_port(self, port: u16) -> SocketAddr {
        match self {
            SocketAddr::V4(a) => SocketAddr::v4(a.ip, port),
            SocketAddr::V6(a) => SocketAddr::V6(SocketAddrV6 { ip: a.ip, port: port, flow_info: a.flow_info, scope_id: a.scope_id }),
        }
    }

    pub const fn is_ipv4(self) -> bool {
        match self {
            SocketAddr::V4(a) => true,
            SocketAddr::V6(a) => false,
        }
    }

    pub const fn is_ipv6(self) -> bool { !self.is_ipv4() }

    const fn family(self) -> i32 { if self.is_ipv4() { 4 } else { 6 } }
}

impl PartialEq for SocketAddr {
    const fn eq(self, rhs: SocketAddr) -> bool { f"{self}" == f"{rhs}" }
    const fn ne(self, rhs: SocketAddr) -> bool { !self.eq(rhs) }
}

impl Display for SocketAddr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(match self {
            SocketAddr::V4(a) => f"{a.ip}:{a.port}",
            SocketAddr::V6(a) => f"[{a.ip}]:{a.port}",
        })
    }
}

impl Debug for SocketAddr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

const fn bad_addr(s: str) -> ParseError {
    ParseError::new(s, 0, "invalid IP address syntax")
}

/// Digits of `s` in `radix` (at most `max_len` of them) as a number.
const fn number(s: str, radix: u64, max_len: usize) -> u64 | none {
    if s.len() == 0 || s.len() > max_len { return none; }
    let n = 0u64;
    for c in s.chars() {
        let d = (try c.to_digit(radix as u32) catch _ { return none; }) as u64;
        n = n * radix + d;
    }
    n
}

const fn parse_v4(s: str) -> Ipv4Addr | none {
    let parts: List<u8> = List::new();
    for p in s.split(".") {
        let n = number(p, 10u64, 3)?;
        if n > 255u64 { return none; }
        parts.push(n as u8);
    }
    if parts.len() != 4 { return none; }
    Ipv4Addr::new(parts[0], parts[1], parts[2], parts[3])
}

/// Hex groups of one side of `::` (empty side: no groups).
const fn groups(s: str) -> List<u16> | none {
    let out: List<u16> = List::new();
    if s.len() == 0 { return out; }
    for p in s.split(":") {
        out.push(number(p, 16u64, 4)? as u16);
    }
    out
}

const fn parse_v6(s: str) -> Ipv6Addr | none {
    let seg: List<u16> = List::new();
    if let at: usize = s.find("::") {
        let h = groups(s[:at])?;
        let t = groups(s[at + 2:])?;
        if h.len() + t.len() > 7 { return none; }
        for g in h { seg.push(g); }
        for _ in h.len() + t.len()..8 { seg.push(0u16); }
        for g in t { seg.push(g); }
    } else {
        seg = groups(s)?;
    }
    if seg.len() != 8 { return none; }
    Ipv6Addr::new(seg[0], seg[1], seg[2], seg[3], seg[4], seg[5], seg[6], seg[7])
}

impl FromStr for Ipv4Addr {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> Ipv4Addr {
        if let a: Ipv4Addr = parse_v4(s) { return a; }
        throw bad_addr(s);
    }
}

impl FromStr for Ipv6Addr {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> Ipv6Addr {
        if let a: Ipv6Addr = parse_v6(s) { return a; }
        throw bad_addr(s);
    }
}

/// A port number (`0..=65535`).
const fn port_of(s: str) -> u16 | none {
    let p = number(s, 10u64, 5)?;
    if p > 65535u64 { return none; }
    p as u16
}

const fn parse_socket_addr(s: str) -> SocketAddr | none {
    if s.starts_with("[") {
        let at = s.find("]:")?;
        return SocketAddr::v6(parse_v6(s[1:at])?, port_of(s[at + 2:])?);
    }
    let at = s.rfind(":")?;
    SocketAddr::v4(parse_v4(s[:at])?, port_of(s[at + 1:])?)
}

/// `"127.0.0.1:8080"` / `"[::1]:8080"`.
impl FromStr for SocketAddr {
    type Err = ParseError;
    const fn from_str(s: str) throws (ParseError) -> SocketAddr {
        if let a: SocketAddr = parse_socket_addr(s) { return a; }
        throw ParseError::new(s, 0, "invalid socket address syntax");
    }
}

// runtime marshalling: `[family, port, flow, scope, bytes..16]`

const ADDR_WORDS: usize = 20;

const fn words_of(a: SocketAddr) -> GcBuf<i64> {
    unsafe {
        let w: GcBuf<i64> = buf_new(ADDR_WORDS);
        match a {
            SocketAddr::V4(v) => {
                w[0] = 4i64;
                w[1] = v.port as i64;
                for i in 0..4usize { w[4 + i] = v.ip.octets[i] as i64; }
            }
            SocketAddr::V6(v) => {
                w[0] = 6i64;
                w[1] = v.port as i64;
                w[2] = v.flow_info as i64;
                w[3] = v.scope_id as i64;
                for i in 0..8usize {
                    let g = v.ip.segments[i] as i64;
                    w[4 + 2 * i] = g / 256i64;
                    w[5 + 2 * i] = g % 256i64;
                }
            }
        }
        w
    }
}

const fn addr_at(w: GcBuf<i64>, at: usize) -> SocketAddr {
    unsafe {
        let b = |i: usize| -> i64 { w[at + 4 + i] };
        let port = w[at + 1] as u16;
        if w[at] == 6i64 {
            let s: List<u16> = List::new();
            for i in 0..8usize { s.push((b(2 * i) * 256i64 + b(2 * i + 1)) as u16); }
            let ip = Ipv6Addr::new(s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7]);
            return SocketAddr::V6(SocketAddrV6 {
                ip: ip,
                port: port,
                flow_info: w[at + 2] as u32,
                scope_id: w[at + 3] as u32,
            });
        }
        SocketAddr::v4(Ipv4Addr::new(b(0) as u8, b(1) as u8, b(2) as u8, b(3) as u8), port)
    }
}

// DNS (302.4)

const MAX_ADDRS: usize = 32;

fn resolve_raw(host: str, port: u16) throws (IoError) -> List<SocketAddr> {
    unsafe {
        let out: GcBuf<i64> = buf_new(ADDR_WORDS * MAX_ADDRS);
        let n = rok_net_resolve(host, port, out, MAX_ADDRS);
        if n < 0 { throw IoError::resolver(0 - n, host); }
        if n == 0 { throw IoError::new(IoErrorKind::NotFound, host + ": no addresses"); }
        let addrs: List<SocketAddr> = List::new();
        for i in 0..n as usize { addrs.push(addr_at(out, i * ADDR_WORDS)); }
        addrs
    }
}

/// Addresses of `host`: `"name:port"`, `"[v6]:port"`, a socket address,
/// or a bare name / IP (port 0).
pub fn resolve(host: str) throws (IoError) -> List<SocketAddr> {
    if let a: SocketAddr = parse_socket_addr(host) { return [a]; }
    let name = host;
    let port = 0u16;
    if let at: usize = host.rfind(":") {
        let rest = host[:at];
        if !rest.contains(":") {
            if let p: u16 = port_of(host[at + 1:]) {
                name = rest;
                port = p;
            }
        }
    }
    if name.starts_with("[") && name.ends_with("]") {
        name = name[1:name.len() - 1];
    }
    try resolve_raw(name, port)
}

fn addrs_of(addr: str | SocketAddr) throws (IoError) -> List<SocketAddr> {
    match addr {
        a: SocketAddr => [a],
        s: str => try resolve(s),
    }
}

/// `[fd, calls in flight]` (`io::use_begin`) shared by copies of a
/// handle, plus `[nonblocking, read timeout ns, write timeout ns]`
/// (timeouts -1: none).
struct Sock {
    fd: GcBuf<i32>;
    opts: GcBuf<i64>;
}

const fn sock_of(fd: i32) -> Sock {
    unsafe {
        let cell: GcBuf<i32> = buf_new(2);
        cell[0] = fd;
        let opts: GcBuf<i64> = buf_new(3);
        opts[1] = -1i64;
        opts[2] = -1i64;
        Sock { fd: cell, opts: opts }
    }
}

fn new_sock(family: i32, kind: i32) throws (IoError) -> Sock {
    let fd = try check(unsafe { rok_net_socket(family, kind) } as i64, "socket");
    sock_of(fd as i32)
}

const fn timed_out(what: str) -> IoError {
    IoError::new(IoErrorKind::TimedOut, what + ": timed out")
}

/// The chunk `read_to_end` grows its list by.
const CHUNK: usize = 16384;

impl Sock {
    /// The fd for `io::copy`'s kernel path: only without timeouts or
    /// non-blocking mode, which the kernel copy would not keep (`-1`;
    /// also on Windows, where a socket is no file handle).
    const fn copy_fd(self) -> i32 {
        unsafe {
            if cfg!(target_os = "windows") || self.opts[0] != 0i64 || self.opts[1] >= 0i64 || self.opts[2] >= 0i64 { return -1; }
            self.fd()
        }
    }

    /// The fd (`-1` once closed).
    const fn fd(self) -> i32 {
        unsafe {
            if (self.fd[1] & 1) != 0 { return -1; }
            self.fd[0]
        }
    }

    /// The fd to wait on for readiness (no call on it), or of a sock not
    /// shared yet.
    const fn live(self) throws (IoError) -> i32 {
        let fd = self.fd();
        if fd < 0 { throw IoError::new(IoErrorKind::InvalidInput, "socket is closed"); }
        fd
    }

    /// The fd for one call, which `done` ends. A `close` meanwhile
    /// leaves the fd open until then.
    fn enter(self) throws (IoError) -> i32 {
        let fd = unsafe { self.fd[0] };
        if fd < 0 || !use_begin(self.fd, 1) {
            throw IoError::new(IoErrorKind::InvalidInput, "socket is closed");
        }
        fd
    }

    fn done(self) {
        if use_end(self.fd, 1) { self.release(); }
    }

    fn release(self) {
        unsafe {
            let fd = take_handle(self.fd, 0, -1);
            if fd >= 0 {
                _ = rok_os_close(fd);
                task::wake_io(fd);
            }
        }
    }

    /// Close the fd, dropping the OS's error (`Drop`, error paths); a
    /// task waiting on its readiness wakes and finds it closed (the
    /// kernel sends no event for a closed fd). With calls in flight
    /// through other copies, the last of them releases the fd.
    fn discard(self) {
        let fd = unsafe { self.fd[0] };
        if use_close(self.fd, 1) == 0 {
            self.release();
        } else if fd >= 0 {
            task::wake_io(fd);
        }
    }

    /// `discard`, throwing the OS's error. Released by a call in
    /// flight, or closed already: nothing to report.
    fn close(self) throws (IoError) {
        let fd = unsafe { self.fd[0] };
        if use_close(self.fd, 1) != 0 {
            if fd >= 0 { task::wake_io(fd); }
            return;
        }
        let h = take_handle(self.fd, 0, -1);
        if h < 0 { return; }
        let r = unsafe { rok_os_close(h) };
        task::wake_io(h);
        try check(r as i64, "close");
    }

    /// `shutdown(2)`; waiting tasks wake to see the end of stream or the
    /// write error.
    fn shutdown(self, how: Shutdown) throws (IoError) {
        let h = match how { Shutdown::Read => 0, Shutdown::Write => 1, Shutdown::Both => 2 };
        let fd = try self.enter();
        let r = unsafe { rok_net_shutdown(fd, h) };
        self.done();
        try check(r as i64, "shutdown");
        task::wake_io(fd);
    }

    /// After a `WouldBlock`: throw it (non-blocking mode) or wait for
    /// readiness within the timeout.
    fn block(self, write: i32, what: str) throws (IoError) {
        unsafe {
            if self.opts[0] != 0i64 {
                throw IoError::new(IoErrorKind::WouldBlock, what + ": operation would block");
            }
            let fd = try self.enter();
            let r = rok_net_wait(fd, write, self.opts[1 + write as usize]);
            self.done();
            if r == 0 { throw timed_out(what); }
            try check(r as i64, what);
        }
    }

    const fn set_timeout(self, write: usize, dur: Duration | none) {
        unsafe {
            self.opts[1 + write] = match dur {
                d: Duration => d.as_ns(),
                none => -1i64,
            };
        }
    }

    const fn timeout(self, write: usize) -> Duration | none {
        unsafe {
            let ns = self.opts[1 + write];
            if ns < 0i64 { return none; }
            Duration::ns(ns)
        }
    }

    fn addr(self, peer: i32) throws (IoError) -> SocketAddr {
        unsafe {
            let out: GcBuf<i64> = buf_new(ADDR_WORDS);
            let fd = try self.enter();
            let r = rok_net_addr(fd, out, peer);
            self.done();
            try check(r as i64, "getsockname");
            addr_at(out, 0)
        }
    }

    fn setopt(self, opt: i32, val: i64) throws (IoError) {
        let fd = try self.enter();
        let r = unsafe { rok_net_setopt(fd, opt, val) };
        self.done();
        try check(r as i64, "setsockopt");
    }

    fn try_clone(self) throws (IoError) -> Sock {
        unsafe {
            let old = try self.enter();
            let r = rok_os_dup(old);
            self.done();
            let fd = try check(r as i64, "dup");
            let s = sock_of(fd as i32);
            for i in 0..3usize { s.opts[i] = self.opts[i]; }
            s
        }
    }

    /// One read into `buf[at..at + n]`: the count, or `none` on `WouldBlock`.
    fn read_once(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize | none {
        let fd = try self.enter();
        let r = unsafe { rok_net_recv(fd, buf, at, n) } as i64;
        self.done();
        if would_block(r) { return none; }
        (try check(r, "read")) as usize
    }

    /// One write of `buf[at..at + n]`: the count, or `none` on `WouldBlock`.
    fn write_once(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize | none {
        let fd = try self.enter();
        let r = unsafe { rok_net_send(fd, buf, at, n) } as i64;
        self.done();
        if would_block(r) { return none; }
        (try check(r, "write")) as usize
    }

    fn read_into(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize {
        loop {
            if let k: usize = try self.read_once(buf, at, n) { return k; }
            try self.block(0, "read");
        }
    }

    async fn read_into_async(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize {
        loop {
            if let k: usize = try self.read_once(buf, at, n) { return k; }
            await task::readable(try self.live());
        }
    }

    fn read(self, buf: List<u8>) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        try self.read_into(b, at, n)
    }

    async fn read_async(self, buf: List<u8>) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        try await self.read_into_async(b, at, n)
    }

    fn read_to_end(self) throws (IoError) -> List<u8> {
        let out: List<u8> = List::new();
        loop {
            let m = out.len();
            out.reserve(CHUNK);
            unsafe { out.set_len(m + CHUNK) };
            let (b, at, _) = region(out);
            let k = try self.read_into(b, at + m, CHUNK) catch e { unsafe { out.set_len(m) }; throw e; };
            unsafe { out.set_len(m + k) };
            if k == 0 { return out; }
        }
    }

    async fn read_to_end_async(self) throws (IoError) -> List<u8> {
        let out: List<u8> = List::new();
        loop {
            let m = out.len();
            out.reserve(CHUNK);
            unsafe { out.set_len(m + CHUNK) };
            let (b, at, _) = region(out);
            let k = try await self.read_into_async(b, at + m, CHUNK) catch e { unsafe { out.set_len(m) }; throw e; };
            unsafe { out.set_len(m + k) };
            if k == 0 { return out; }
        }
    }

    fn write(self, data: Slice<u8>) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.write_once(b, at, n) { return k; }
            try self.block(1, "write");
        }
    }

    async fn write_async(self, data: Slice<u8>) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.write_once(b, at, n) { return k; }
            await task::writable(try self.live());
        }
    }

    fn write_all(self, data: Slice<u8>) throws (IoError) {
        let (b, at, n) = unsafe { data.raw_parts() };
        let done = 0usize;
        while done < n {
            match try self.write_once(b, at + done, n - done) {
                k: usize => {
                    if k == 0 { throw IoError::new(IoErrorKind::Other, "failed to write whole buffer"); }
                    done += k;
                }
                none => try self.block(1, "write"),
            }
        }
    }

    async fn write_all_async(self, data: Slice<u8>) throws (IoError) {
        let (b, at, n) = unsafe { data.raw_parts() };
        let done = 0usize;
        while done < n {
            match try self.write_once(b, at + done, n - done) {
                k: usize => {
                    if k == 0 { throw IoError::new(IoErrorKind::Other, "failed to write whole buffer"); }
                    done += k;
                }
                none => await task::writable(try self.live()),
            }
        }
    }
}

// TCP (302.1)

pub enum Shutdown {
    Read,
    Write,
    Both,
}

/// A TCP connection. Copies share the socket; `close()` (or leaving a
/// `using` block) closes it for all.
pub struct TcpStream {
    sock: Sock;
}

/// A listening TCP socket.
pub struct TcpListener {
    sock: Sock;
}

/// Start connecting `addr`: the socket and whether it is still pending.
fn connect_start(addr: SocketAddr) throws (IoError) -> (Sock, bool) {
    let s = try new_sock(addr.family(), 1);
    let r = unsafe { rok_net_connect(try s.live(), words_of(addr)) };
    if r < 0 {
        s.discard();
        throw IoError::from_os_code(-r, f"connect {addr}");
    }
    (s, r == 1)
}

fn connect_finish(s: Sock, addr: SocketAddr) throws (IoError) -> TcpStream {
    let e = unsafe { rok_net_sock_error(try s.live()) };
    if e < 0 {
        s.discard();
        throw IoError::from_os_code(-e, f"connect {addr}");
    }
    TcpStream { sock: s }
}

fn connect_wait(addr: SocketAddr, limit: i64) throws (IoError) -> TcpStream {
    let (s, pending) = try connect_start(addr);
    if pending {
        let r = unsafe { rok_net_wait(try s.live(), 1, limit) };
        if r <= 0 {
            s.discard();
            if r == 0 { throw timed_out(f"connect {addr}"); }
            throw IoError::from_os_code(-r, f"connect {addr}");
        }
    }
    try connect_finish(s, addr)
}

impl TcpStream {
    /// Connect, blocking until the handshake is done.
    pub fn connect(addr: SocketAddr) throws (IoError) -> TcpStream {
        try connect_wait(addr, -1i64)
    }

    pub fn connect_timeout(addr: SocketAddr, dur: Duration) throws (IoError) -> TcpStream {
        try connect_wait(addr, dur.as_ns())
    }

    /// `connect` that suspends the task during the handshake.
    pub async fn connect_async(addr: SocketAddr) throws (IoError) -> TcpStream {
        let (s, pending) = try connect_start(addr);
        if pending {
            await task::writable(try s.live());
            // A spurious wake: wait until the connect resolved.
            while unsafe { rok_net_wait(try s.live(), 1, 0i64) } == 0 {
                await task::writable(try s.live());
            }
        }
        try connect_finish(s, addr)
    }

    /// The OS socket descriptor (`-1` once closed).
    pub const fn fd(self) -> i32 { self.sock.fd() }

    /// Read up to `buf.len()` bytes into `buf[0..n]`; 0 at end of stream.
    pub fn read(self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }

    /// `read` that suspends the task until data arrives.
    pub async fn read_async(self, buf: List<u8>) throws (IoError) -> usize {
        try await self.sock.read_async(buf)
    }

    /// Everything until the peer closes its side.
    pub fn read_to_end(self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }

    pub async fn read_to_end_async(self) throws (IoError) -> List<u8> {
        try await self.sock.read_to_end_async()
    }

    /// Write some prefix of `buf`; its length.
    pub fn write<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try self.sock.write(buf.byte_slice())
    }

    pub async fn write_async<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }

    pub fn write_all<B: AsBytes>(self, buf: B) throws (IoError) {
        try self.sock.write_all(buf.byte_slice());
    }

    pub async fn write_all_async<B: AsBytes>(self, buf: B) throws (IoError) {
        try await self.sock.write_all_async(buf.byte_slice());
    }

    pub fn write_str(self, s: str) throws (IoError) { try self.sock.write_all(s.as_bytes()); }

    pub async fn write_str_async(self, s: str) throws (IoError) {
        try await self.sock.write_all_async(s.as_bytes());
    }

    /// Nothing to flush: writes go straight to the socket.
    pub const fn flush(self) throws (IoError) {}

    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    pub fn shutdown(self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    pub fn set_nodelay(self, nodelay: bool) throws (IoError) {
        try self.sock.setopt(1, if nodelay { 1i64 } else { 0i64 });
    }

    /// Keepalive probes after `alive` idle (whole seconds); `none` = off.
    pub fn set_keepalive(self, alive: Duration | none) throws (IoError) {
        match alive {
            d: Duration => try self.sock.setopt(2, d.as_secs()),
            none => try self.sock.setopt(2, -1i64),
        }
    }

    pub const fn set_read_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(0, dur); }
    pub const fn set_write_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(1, dur); }
    pub const fn read_timeout(self) -> Duration | none { self.sock.timeout(0) }
    pub const fn write_timeout(self) -> Duration | none { self.sock.timeout(1) }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub const fn set_nonblocking(self, nb: bool) throws (IoError) {
        unsafe {
            self.sock.opts[0] = if nb { 1i64 } else { 0i64 };
        }
    }

    pub fn try_clone(self) throws (IoError) -> TcpStream {
        TcpStream { sock: try self.sock.try_clone() }
    }

    /// Close now, throwing the OS's error; later calls fail with
    /// `InvalidInput`.
    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

impl Reader for TcpStream {
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }
    const fn raw_fd(self) -> RawFd { self.sock.copy_fd() }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }
}

impl Writer for TcpStream {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }
    const fn raw_fd(self) -> RawFd { self.sock.copy_fd() }
    fn write_all(ref self, buf: List<u8>) throws (IoError) { try self.sock.write_all(buf.byte_slice()); }
    fn write_str(ref self, s: str) throws (IoError) { try self.sock.write_all(s.as_bytes()); }
    const fn flush(ref self) throws (IoError) {}
}

impl Drop for TcpStream {
    fn drop(ref self) { self.sock.discard(); }
}

impl TcpListener {
    /// Bind and listen (`SO_REUSEADDR`, backlog 128). Port 0 picks one:
    /// see `local_addr`.
    pub fn bind(addr: SocketAddr) throws (IoError) -> TcpListener {
        let s = try new_sock(addr.family(), 1);
        let r = unsafe { rok_net_bind(try s.live(), words_of(addr)) };
        if r >= 0 { r = unsafe { rok_net_listen(try s.live(), 128) }; }
        if r < 0 {
            s.discard();
            throw IoError::from_os_code(-r, f"bind {addr}");
        }
        TcpListener { sock: s }
    }

    /// The listening sockets the host handed this program, in order:
    /// WASI's pre-opened sockets (wasmtime `-S tcplisten=ADDR`, preview 1:
    /// `wasm32-wasip1-threads`), systemd socket activation (`LISTEN_FDS`) on
    /// Unix; none on Windows. Where a program cannot bind sockets
    /// itself, these are how it serves.
    pub fn inherited() -> List<TcpListener> {
        unsafe {
            let fds: GcBuf<i32> = buf_new(64);
            let n = rok_net_listeners(fds, 64);
            let out: List<TcpListener> = List::new();
            for i in 0..n as usize {
                out.push(TcpListener { sock: sock_of(fds[i]) });
            }
            out
        }
    }

    fn accept_once(self) throws (IoError) -> (TcpStream, SocketAddr) | none {
        unsafe {
            let out: GcBuf<i64> = buf_new(ADDR_WORDS);
            let l = try self.sock.enter();
            let fd = rok_net_accept(l, out) as i64;
            self.sock.done();
            if would_block(fd) { return none; }
            try check(fd, "accept");
            (TcpStream { sock: sock_of(fd as i32) }, addr_at(out, 0))
        }
    }

    /// The next connection and its peer, blocking until one arrives.
    pub fn accept(self) throws (IoError) -> (TcpStream, SocketAddr) {
        loop {
            if let c: (TcpStream, SocketAddr) = try self.accept_once() { return c; }
            try self.sock.block(0, "accept");
        }
    }

    /// `accept` that suspends the task until a connection arrives.
    pub async fn accept_async(self) throws (IoError) -> (TcpStream, SocketAddr) {
        loop {
            if let c: (TcpStream, SocketAddr) = try self.accept_once() { return c; }
            await task::readable(try self.sock.live());
        }
    }

    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    pub fn try_clone(self) throws (IoError) -> TcpListener {
        TcpListener { sock: try self.sock.try_clone() }
    }

    pub const fn set_nonblocking(self, nb: bool) throws (IoError) {
        unsafe {
            self.sock.opts[0] = if nb { 1i64 } else { 0i64 };
        }
    }

    /// `for c in l.incoming() { let s = try c.get(); .. }`: connections
    /// forever (each item is the stream or the error `accept` threw).
    pub const fn incoming(self) -> Incoming { Incoming { listener: self } }

    pub const fn fd(self) -> i32 { self.sock.fd() }

    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

impl Drop for TcpListener {
    fn drop(ref self) { self.sock.discard(); }
}

/// `TcpListener::incoming`.
pub struct Incoming {
    listener: TcpListener;
}

impl Iterator for Incoming {
    type Item = Result<TcpStream, IoError>;
    fn next(ref self) -> Result<TcpStream, IoError> | none {
        let (s, _) = try self.listener.accept() catch e { return Result::Err(e); };
        Result::Ok(s)
    }
}

// UDP (302.2)

/// A UDP socket. Copies share the socket.
pub struct UdpSocket {
    sock: Sock;
}

impl UdpSocket {
    pub fn bind(addr: SocketAddr) throws (IoError) -> UdpSocket {
        let s = try new_sock(addr.family(), 2);
        let r = unsafe { rok_net_bind(try s.live(), words_of(addr)) };
        if r < 0 {
            s.discard();
            throw IoError::from_os_code(-r, f"bind {addr}");
        }
        UdpSocket { sock: s }
    }

    /// One datagram from `buf[at..at + n]` to `addr`: the count, or
    /// `none` on `WouldBlock`.
    fn send_to_once(self, buf: GcBuf<u8>, at: usize, n: usize, addr: SocketAddr) throws (IoError) -> usize | none {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_send_to(fd, buf, at, n, words_of(addr)) } as i64;
        self.sock.done();
        if would_block(r) { return none; }
        (try check(r, f"send_to {addr}")) as usize
    }

    /// One datagram into `buf`: its length and sender, or `none` on
    /// `WouldBlock`.
    fn recv_from_once(self, buf: List<u8>) throws (IoError) -> (usize, SocketAddr) | none {
        unsafe {
            let out: GcBuf<i64> = buf_new(ADDR_WORDS);
            let (b, at, n) = region(buf);
            let fd = try self.sock.enter();
            let r = rok_net_recv_from(fd, b, at, n, out) as i64;
            self.sock.done();
            if would_block(r) { return none; }
            ((try check(r, "recv_from")) as usize, addr_at(out, 0))
        }
    }

    /// Send the datagram `buf` to `addr`; bytes sent.
    pub fn send_to<B: AsBytes>(self, buf: B, addr: SocketAddr) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        loop {
            if let k: usize = try self.send_to_once(b, at, n, addr) { return k; }
            try self.sock.block(1, "send_to");
        }
    }

    pub async fn send_to_async<B: AsBytes>(self, buf: B, addr: SocketAddr) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        loop {
            if let k: usize = try self.send_to_once(b, at, n, addr) { return k; }
            await task::writable(try self.sock.live());
        }
    }

    /// The next datagram into `buf[0..n]` (truncated to `buf.len()`)
    /// and its sender.
    pub fn recv_from(self, buf: List<u8>) throws (IoError) -> (usize, SocketAddr) {
        loop {
            if let r: (usize, SocketAddr) = try self.recv_from_once(buf) { return r; }
            try self.sock.block(0, "recv_from");
        }
    }

    pub async fn recv_from_async(self, buf: List<u8>) throws (IoError) -> (usize, SocketAddr) {
        loop {
            if let r: (usize, SocketAddr) = try self.recv_from_once(buf) { return r; }
            await task::readable(try self.sock.live());
        }
    }

    /// Fix the peer: `send` / `recv` then talk to it only.
    pub fn connect(self, addr: SocketAddr) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_connect(fd, words_of(addr)) };
        self.sock.done();
        try check(r as i64, f"connect {addr}");
    }

    pub fn send<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try self.sock.write(buf.byte_slice())
    }

    pub async fn send_async<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }

    pub fn recv(self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }

    pub async fn recv_async(self, buf: List<u8>) throws (IoError) -> usize {
        try await self.sock.read_async(buf)
    }

    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }
    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }

    pub fn set_broadcast(self, on: bool) throws (IoError) {
        try self.sock.setopt(3, if on { 1i64 } else { 0i64 });
    }

    pub fn join_multicast_v4(self, addr: Ipv4Addr, iface: Ipv4Addr) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_multicast_v4(fd, addr.to_bits(), iface.to_bits(), 1) };
        self.sock.done();
        try check(r as i64, "join_multicast_v4");
    }

    pub fn leave_multicast_v4(self, addr: Ipv4Addr, iface: Ipv4Addr) throws (IoError) {
        let fd = try self.sock.enter();
        let r = unsafe { rok_net_multicast_v4(fd, addr.to_bits(), iface.to_bits(), 0) };
        self.sock.done();
        try check(r as i64, "leave_multicast_v4");
    }

    pub fn set_multicast_loop_v4(self, on: bool) throws (IoError) {
        try self.sock.setopt(4, if on { 1i64 } else { 0i64 });
    }

    pub fn set_multicast_ttl_v4(self, ttl: u32) throws (IoError) {
        try self.sock.setopt(5, ttl as i64);
    }

    /// `UDP_SEGMENT` (GSO); `Unsupported` off Linux.
    pub fn set_segment_size(self, size: u16) throws (IoError) {
        try self.sock.setopt(6, size as i64);
    }

    pub const fn set_read_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(0, dur); }
    pub const fn set_write_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(1, dur); }

    pub const fn set_nonblocking(self, nb: bool) throws (IoError) {
        unsafe {
            self.sock.opts[0] = if nb { 1i64 } else { 0i64 };
        }
    }

    pub fn try_clone(self) throws (IoError) -> UdpSocket {
        UdpSocket { sock: try self.sock.try_clone() }
    }

    pub const fn fd(self) -> i32 { self.sock.fd() }

    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

impl Drop for UdpSocket {
    fn drop(ref self) { self.sock.discard(); }
}

// Unix domain sockets (302.3)

/// A Unix stream socket. Copies share the socket; `close()` (or leaving
/// a `using` block) closes it for all.
#[cfg(target_family = "unix")]
pub struct UnixStream {
    sock: Sock;
}

/// A listening Unix stream socket bound to a path.
#[cfg(target_family = "unix")]
pub struct UnixListener {
    sock: Sock;
}

/// A Unix datagram socket.
#[cfg(target_family = "unix")]
pub struct UnixDatagram {
    sock: Sock;
}

/// A Unix socket of `kind` (1 stream / 2 datagram) at `path` (`op` 0
/// unbound, 1 bind, 2 connect).
#[cfg(target_family = "unix")]
fn unix_sock<P: AsPath>(kind: i32, path: P, op: i32, what: str) throws (IoError) -> Sock {
    let p = path.as_path().as_str();
    let fd = try check(unsafe { rok_net_unix(kind, p, op) } as i64, f"{what} {p}");
    sock_of(fd as i32)
}

/// Both ends of a `socketpair`.
#[cfg(target_family = "unix")]
fn unix_pair(kind: i32) throws (IoError) -> (Sock, Sock) {
    unsafe {
        let fds: GcBuf<i32> = buf_new(2);
        try check(rok_net_unix_pair(kind, fds) as i64, "socketpair");
        (sock_of(fds[0]), sock_of(fds[1]))
    }
}

/// The bound path of the socket (`peer` 1: the other end's); `none` when
/// unnamed.
#[cfg(target_family = "unix")]
fn unix_path(s: Sock, peer: i32) throws (IoError) -> Path | none {
    let buf: List<u8> = List::new();
    buf.reserve(256);
    unsafe { buf.set_len(256) };
    let (b, at, n) = region(buf);
    let fd = try s.enter();
    let r = unsafe { rok_net_unix_path(fd, peer, b, at, n) };
    s.done();
    let k = try check(r as i64, "getsockname");
    if k == 0 { return none; }
    unsafe { buf.set_len(k as usize) };
    Path::new(try str::from_utf8(buf) catch _ { return none; })
}

#[cfg(target_family = "unix")]
impl UnixListener {
    /// Bind `path` (it must not exist yet) and listen (backlog 128).
    pub fn bind<P: AsPath>(path: P) throws (IoError) -> UnixListener {
        UnixListener { sock: try unix_sock(1, path, 1, "bind") }
    }

    fn accept_once(self) throws (IoError) -> UnixStream | none {
        // The peer is read with `peer_addr` (`out` holds no Unix address).
        let out: GcBuf<i64> = unsafe { buf_new(ADDR_WORDS) };
        let l = try self.sock.enter();
        let fd = unsafe { rok_net_accept(l, out) } as i64;
        self.sock.done();
        if would_block(fd) { return none; }
        try check(fd, "accept");
        UnixStream { sock: sock_of(fd as i32) }
    }

    /// The next connection and the path its peer is bound to (`none`:
    /// unnamed, the usual case), blocking until one arrives.
    pub fn accept(self) throws (IoError) -> (UnixStream, Path | none) {
        loop {
            if let c: UnixStream = try self.accept_once() {
                let peer = try c.peer_addr();
                return (c, peer);
            }
            try self.sock.block(0, "accept");
        }
    }

    pub async fn accept_async(self) throws (IoError) -> (UnixStream, Path | none) {
        loop {
            if let c: UnixStream = try self.accept_once() {
                let peer = try c.peer_addr();
                return (c, peer);
            }
            await task::readable(try self.sock.live());
        }
    }

    pub fn local_addr(self) throws (IoError) -> Path | none { try unix_path(self.sock, 0) }

    pub const fn set_nonblocking(self, nb: bool) throws (IoError) {
        unsafe { self.sock.opts[0] = if nb { 1i64 } else { 0i64 }; }
    }

    pub fn try_clone(self) throws (IoError) -> UnixListener { UnixListener { sock: try self.sock.try_clone() } }

    pub const fn fd(self) -> i32 { self.sock.fd() }

    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

#[cfg(target_family = "unix")]
impl Drop for UnixListener {
    fn drop(ref self) { self.sock.discard(); }
}

#[cfg(target_family = "unix")]
impl UnixStream {
    pub fn connect<P: AsPath>(path: P) throws (IoError) -> UnixStream {
        UnixStream { sock: try unix_sock(1, path, 2, "connect") }
    }

    /// Two connected ends (`socketpair`).
    pub fn pair() throws (IoError) -> (UnixStream, UnixStream) {
        let (a, b) = try unix_pair(1);
        (UnixStream { sock: a }, UnixStream { sock: b })
    }

    pub fn read(self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }

    pub async fn read_async(self, buf: List<u8>) throws (IoError) -> usize { try await self.sock.read_async(buf) }

    pub fn read_to_end(self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }

    pub fn write<B: AsBytes>(self, buf: B) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }

    pub async fn write_async<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }

    pub fn write_all<B: AsBytes>(self, buf: B) throws (IoError) { try self.sock.write_all(buf.byte_slice()); }

    pub fn write_str(self, s: str) throws (IoError) { try self.sock.write_all(s.as_bytes()); }

    pub const fn flush(self) throws (IoError) {}

    /// `buf` with fd `fd` alongside (`SCM_RIGHTS`): the bytes sent.
    pub fn send_with_fd<B: AsBytes>(self, buf: B, fd: RawFd) throws (IoError) -> usize {
        let (b, at, n) = unsafe { buf.byte_slice().raw_parts() };
        loop {
            let s = try self.sock.enter();
            let r = unsafe { rok_net_send_fd(s, b, at, n, fd) } as i64;
            self.sock.done();
            if !would_block(r) { return (try check(r, "sendmsg")) as usize; }
            try self.sock.block(1, "sendmsg");
        }
    }

    /// One read into `buf` and the fd passed with it, if any (the caller
    /// owns it; it is close-on-exec).
    pub fn recv_with_fd(self, buf: List<u8>) throws (IoError) -> (usize, RawFd | none) {
        let (b, at, n) = region(buf);
        unsafe {
            let got: GcBuf<i32> = buf_new(1);
            loop {
                let fd = try self.sock.enter();
                let r = rok_net_recv_fd(fd, b, at, n, got) as i64;
                self.sock.done();
                if !would_block(r) {
                    let k = (try check(r, "recvmsg")) as usize;
                    if got[0] < 0 { return (k, none); }
                    return (k, got[0]);
                }
                try self.sock.block(0, "recvmsg");
            }
        }
    }

    pub fn peer_addr(self) throws (IoError) -> Path | none { try unix_path(self.sock, 1) }

    pub fn local_addr(self) throws (IoError) -> Path | none { try unix_path(self.sock, 0) }

    pub fn shutdown(self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    pub const fn set_read_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(0, dur); }

    pub const fn set_write_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(1, dur); }

    pub const fn set_nonblocking(self, nb: bool) throws (IoError) {
        unsafe { self.sock.opts[0] = if nb { 1i64 } else { 0i64 }; }
    }

    pub fn try_clone(self) throws (IoError) -> UnixStream { UnixStream { sock: try self.sock.try_clone() } }

    pub const fn fd(self) -> i32 { self.sock.fd() }

    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

#[cfg(target_family = "unix")]
impl Reader for UnixStream {
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }
    const fn raw_fd(self) -> RawFd { self.sock.copy_fd() }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }
}

#[cfg(target_family = "unix")]
impl Writer for UnixStream {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }
    const fn raw_fd(self) -> RawFd { self.sock.copy_fd() }
    fn write_all(ref self, buf: List<u8>) throws (IoError) { try self.sock.write_all(buf.byte_slice()); }
    fn write_str(ref self, s: str) throws (IoError) { try self.sock.write_all(s.as_bytes()); }
    const fn flush(ref self) throws (IoError) {}
}

#[cfg(target_family = "unix")]
impl Drop for UnixStream {
    fn drop(ref self) { self.sock.discard(); }
}

#[cfg(target_family = "unix")]
impl UnixDatagram {
    /// A datagram socket bound to `path`.
    pub fn bind<P: AsPath>(path: P) throws (IoError) -> UnixDatagram {
        UnixDatagram { sock: try unix_sock(2, path, 1, "bind") }
    }

    /// A datagram socket connected to `path` (unbound itself).
    pub fn connect<P: AsPath>(path: P) throws (IoError) -> UnixDatagram {
        UnixDatagram { sock: try unix_sock(2, path, 2, "connect") }
    }

    /// Two connected datagram ends (`socketpair`).
    pub fn pair() throws (IoError) -> (UnixDatagram, UnixDatagram) {
        let (a, b) = try unix_pair(2);
        (UnixDatagram { sock: a }, UnixDatagram { sock: b })
    }

    pub fn send<B: AsBytes>(self, buf: B) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }

    pub fn recv(self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }

    pub fn send_with_fd<B: AsBytes>(self, buf: B, fd: RawFd) throws (IoError) -> usize {
        try UnixStream { sock: self.sock }.send_with_fd(buf, fd)
    }

    pub fn recv_with_fd(self, buf: List<u8>) throws (IoError) -> (usize, RawFd | none) {
        try UnixStream { sock: self.sock }.recv_with_fd(buf)
    }

    pub fn local_addr(self) throws (IoError) -> Path | none { try unix_path(self.sock, 0) }

    pub const fn set_read_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(0, dur); }

    pub const fn set_write_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(1, dur); }

    pub const fn set_nonblocking(self, nb: bool) throws (IoError) {
        unsafe { self.sock.opts[0] = if nb { 1i64 } else { 0i64 }; }
    }

    pub const fn fd(self) -> i32 { self.sock.fd() }

    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

#[cfg(target_family = "unix")]
impl Drop for UnixDatagram {
    fn drop(ref self) { self.sock.discard(); }
}

// zero-copy hooks (302.7, Linux)

#[cfg(target_os = "linux")]
impl TcpStream {
    /// `file[offset..offset + count]` to the socket in the kernel
    /// (`sendfile(2)`): the bytes sent, fewer if the file ends first.
    pub fn sendfile(self, ref file: File, offset: u64, count: u64) throws (IoError) -> u64 {
        let done = 0u64;
        while done < count {
            let fd = try self.sock.enter();
            let r = unsafe { rok_net_sendfile(fd, file.fd(), (offset + done) as i64, (count - done) as usize) } as i64;
            self.sock.done();
            if would_block(r) {
                try self.sock.block(1, "sendfile");
                continue;
            }
            let k = try check(r, "sendfile");
            if k == 0 { break; }
            done += k as u64;
        }
        done
    }

    /// Up to `count` bytes from `src`'s offset to the socket through a
    /// kernel pipe (`splice(2)`): the bytes moved, fewer if `src` ends.
    pub fn splice(self, ref src: File, count: u64) throws (IoError) -> u64 {
        let done = 0u64;
        while done < count {
            let fd = try self.sock.enter();
            let r = unsafe { rok_net_splice(fd, src.fd(), (count - done) as usize) } as i64;
            self.sock.done();
            let k = try check(r, "splice");
            if k == 0 { break; }
            done += k as u64;
        }
        done
    }

    /// Some prefix of `buf` sent with `MSG_ZEROCOPY` (Linux 4.14+): the
    /// kernel reads `buf` in place; returns once it no longer needs it.
    pub fn write_zerocopy(self, buf: List<u8>) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        loop {
            let fd = try self.sock.enter();
            let r = unsafe { rok_net_send_zerocopy(fd, b, at, n) } as i64;
            self.sock.done();
            if would_block(r) {
                try self.sock.block(1, "write_zerocopy");
                continue;
            }
            return (try check(r, "write_zerocopy")) as usize;
        }
    }
}

// conveniences (302.6)

/// Connect to the first address of `addr` that accepts (names are
/// resolved).
pub fn tcp_connect(addr: str | SocketAddr) throws (IoError) -> TcpStream {
    let addrs = try addrs_of(addr);
    let last = IoError::new(IoErrorKind::Other, "no address to connect to");
    for a in addrs {
        let s = try TcpStream::connect(a) catch e {
            last = e;
            continue;
        };
        return s;
    }
    throw last;
}

/// `tcp_connect` that suspends the task while connecting.
pub async fn tcp_connect_async(addr: str | SocketAddr) throws (IoError) -> TcpStream {
    let addrs = try addrs_of(addr);
    let last = IoError::new(IoErrorKind::Other, "no address to connect to");
    for a in addrs {
        let s = try await TcpStream::connect_async(a) catch e {
            last = e;
            continue;
        };
        return s;
    }
    throw last;
}

pub fn tcp_listen(addr: str | SocketAddr) throws (IoError) -> TcpListener {
    try TcpListener::bind((try addrs_of(addr))[0])
}

pub fn udp_bind(addr: str | SocketAddr) throws (IoError) -> UdpSocket {
    try UdpSocket::bind((try addrs_of(addr))[0])
}

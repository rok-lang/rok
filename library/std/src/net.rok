    const fn as_raw_fd(self) -> RawFd { self.sock.fd() }
}

#[cfg(target_family = "unix")]
impl FromRawFd for TcpStream {
    unsafe fn from_raw_fd(fd: RawFd) -> TcpStream { TcpStream { sock: sock_of(fd) } }
}

#[cfg(target_family = "unix")]
impl FromRawFd for TcpListener {
    unsafe fn from_raw_fd(fd: RawFd) -> TcpListener { TcpListener { sock: sock_of(fd) } }
}

#[cfg(target_family = "unix")]
impl FromRawFd for UdpSocket {
    unsafe fn from_raw_fd(fd: RawFd) -> UdpSocket { UdpSocket { sock: sock_of(fd) } }
}


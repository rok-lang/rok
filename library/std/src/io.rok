// rok::std::io (stdlib spec 305): `IoError`, the `Reader` / `Writer` /
// `Seek` traits and the standard streams.
//
// Byte buffers are `List<u8>` (305): `read(buf)` fills `buf[0..n]` of a
// pre-sized list. Bytes cross to the runtime as `GcBuf<u8>` regions
// `(buf, off, len)`: reads fill the caller's list in place, every other
// move is one bulk copy, and bytes become a `str` only through the UTF-8
// check of `str::from_utf8`.
//
// `write_fmt` takes the formatted `str` (an f-string), not `FmtArgs`
// (f-strings desugar to `str`); `write_display` writes a value through
// `Display` straight into the writer, in chunks, with no `str` of the
// whole built first.

// The runtime's numbering of the kinds (`rok_os_errno_kind`).
use rok::bare::mem::GcBuf;

const KIND_OTHER: i32 = 0;
const KIND_NOT_FOUND: i32 = 1;
const KIND_PERMISSION_DENIED: i32 = 2;
const KIND_ALREADY_EXISTS: i32 = 3;
const KIND_NOT_A_DIRECTORY: i32 = 4;
const KIND_IS_A_DIRECTORY: i32 = 5;
const KIND_DIRECTORY_NOT_EMPTY: i32 = 6;
const KIND_INVALID_INPUT: i32 = 7;
const KIND_BROKEN_PIPE: i32 = 8;
const KIND_INTERRUPTED: i32 = 9;
const KIND_WOULD_BLOCK: i32 = 10;
const KIND_TIMED_OUT: i32 = 11;
const KIND_STORAGE_FULL: i32 = 12;
const KIND_CROSSES_DEVICES: i32 = 13;
const KIND_UNSUPPORTED: i32 = 14;
const KIND_UNEXPECTED_EOF: i32 = 15;
const KIND_INVALID_DATA: i32 = 16;

/// What went wrong, from the OS error (`os_code`) or the library itself.
#[derive(Clone, Copy)]
#[non_exhaustive]
pub enum IoErrorKind {
    Other,
    NotFound,
    PermissionDenied,
    AlreadyExists,
    NotADirectory,
    IsADirectory,
    DirectoryNotEmpty,
    InvalidInput,
    BrokenPipe,
    Interrupted,
    WouldBlock,
    TimedOut,
    StorageFull,
    CrossesDevices,
    Unsupported,
    UnexpectedEof,
    InvalidData,
}

impl IoErrorKind {
    /// The kind's number.
    pub(pkg) const fn index(self) -> i32 {
        match self {
            IoErrorKind::Other => KIND_OTHER,
            IoErrorKind::NotFound => KIND_NOT_FOUND,
            IoErrorKind::PermissionDenied => KIND_PERMISSION_DENIED,
            IoErrorKind::AlreadyExists => KIND_ALREADY_EXISTS,
            IoErrorKind::NotADirectory => KIND_NOT_A_DIRECTORY,
            IoErrorKind::IsADirectory => KIND_IS_A_DIRECTORY,
            IoErrorKind::DirectoryNotEmpty => KIND_DIRECTORY_NOT_EMPTY,
            IoErrorKind::InvalidInput => KIND_INVALID_INPUT,
            IoErrorKind::BrokenPipe => KIND_BROKEN_PIPE,
            IoErrorKind::Interrupted => KIND_INTERRUPTED,
            IoErrorKind::WouldBlock => KIND_WOULD_BLOCK,
            IoErrorKind::TimedOut => KIND_TIMED_OUT,
            IoErrorKind::StorageFull => KIND_STORAGE_FULL,
            IoErrorKind::CrossesDevices => KIND_CROSSES_DEVICES,
            IoErrorKind::Unsupported => KIND_UNSUPPORTED,
            IoErrorKind::UnexpectedEof => KIND_UNEXPECTED_EOF,
            IoErrorKind::InvalidData => KIND_INVALID_DATA,
        }
    }

    /// The kind of OS error `code`, as the runtime classifies it.
    fn of_os(code: i32) -> IoErrorKind {
        let k = unsafe { rok_os_errno_kind(code) };
        // Constants are not patterns: compare one by one.
        if k == KIND_NOT_FOUND { return IoErrorKind::NotFound; }
        if k == KIND_PERMISSION_DENIED { return IoErrorKind::PermissionDenied; }
        if k == KIND_ALREADY_EXISTS { return IoErrorKind::AlreadyExists; }
        if k == KIND_NOT_A_DIRECTORY { return IoErrorKind::NotADirectory; }
        if k == KIND_IS_A_DIRECTORY { return IoErrorKind::IsADirectory; }
        if k == KIND_DIRECTORY_NOT_EMPTY { return IoErrorKind::DirectoryNotEmpty; }
        if k == KIND_INVALID_INPUT { return IoErrorKind::InvalidInput; }
        if k == KIND_BROKEN_PIPE { return IoErrorKind::BrokenPipe; }
        if k == KIND_INTERRUPTED { return IoErrorKind::Interrupted; }
        if k == KIND_WOULD_BLOCK { return IoErrorKind::WouldBlock; }
        if k == KIND_TIMED_OUT { return IoErrorKind::TimedOut; }
        if k == KIND_STORAGE_FULL { return IoErrorKind::StorageFull; }
        if k == KIND_CROSSES_DEVICES { return IoErrorKind::CrossesDevices; }
        if k == KIND_UNSUPPORTED { return IoErrorKind::Unsupported; }
        IoErrorKind::Other
    }
}

impl PartialEq for IoErrorKind {
    const fn eq(self, rhs: IoErrorKind) -> bool { self.index() == rhs.index() }
    const fn ne(self, rhs: IoErrorKind) -> bool { self.index() != rhs.index() }
}

impl Eq for IoErrorKind {}

impl Debug for IoErrorKind {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(match self {
            IoErrorKind::Other => "Other",
            IoErrorKind::NotFound => "NotFound",
            IoErrorKind::PermissionDenied => "PermissionDenied",
            IoErrorKind::AlreadyExists => "AlreadyExists",
            IoErrorKind::NotADirectory => "NotADirectory",
            IoErrorKind::IsADirectory => "IsADirectory",
            IoErrorKind::DirectoryNotEmpty => "DirectoryNotEmpty",
            IoErrorKind::InvalidInput => "InvalidInput",
            IoErrorKind::BrokenPipe => "BrokenPipe",
            IoErrorKind::Interrupted => "Interrupted",
            IoErrorKind::WouldBlock => "WouldBlock",
            IoErrorKind::TimedOut => "TimedOut",
            IoErrorKind::StorageFull => "StorageFull",
            IoErrorKind::CrossesDevices => "CrossesDevices",
            IoErrorKind::Unsupported => "Unsupported",
            IoErrorKind::UnexpectedEof => "UnexpectedEof",
            IoErrorKind::InvalidData => "InvalidData",
        })
    }
}

/// An I/O failure (std 3.5.0): its kind, the OS error code (`none`
/// when the library raised it or a name did not resolve) and a readable
/// message.
#[derive(Clone, PartialEq, Eq)]
pub struct IoError {
    kind: IoErrorKind;
    os_code: i32 | none;
    message: str;
}

impl IoError {
    /// A library-raised error: no OS code.
    pub const fn new(kind: IoErrorKind, message: str) -> IoError {
        IoError { kind, os_code: none, message }
    }

    /// The error for OS error `code` (errno; Windows: a Win32 or
    /// Winsock code), its kind and message as the OS gives them;
    /// `context` (a path, a call) prefixes the message unless empty.
    pub fn from_os_code(code: i32, context: str = "") -> IoError {
        IoError { kind: IoErrorKind::of_os(code), os_code: code, message: os_message(code, context) }
    }

    /// A failed name lookup with runtime code `code`: a resolver (EAI)
    /// code is no OS error code.
    pub(pkg) fn resolver(code: i32, context: str) -> IoError {
        if !is_eai(code) { return IoError::from_os_code(code, context); }
        IoError { kind: IoErrorKind::of_os(code), os_code: none, message: os_message(code, context) }
    }

    /// `self` with its message told again for `context`.
    pub(pkg) fn retold(self, context: str) -> IoError {
        match self.os_code {
            c: i32 => IoError::from_os_code(c, context),
            none => self,
        }
    }

    pub const fn kind(self) -> IoErrorKind { self.kind }
    /// The platform's code (errno; Windows: `GetLastError` / WSA), or
    /// `none` when the library raised the error or a name did not
    /// resolve.
    pub const fn os_code(self) -> i32 | none { self.os_code }
    pub const fn message(self) -> str { self.message }
}

/// Whether runtime code `code` is a resolver failure (`getaddrinfo`'s
/// EAI codes, numbered from the runtime's `EAI_BASE`).
#[cfg(not(target_os = "windows"))]
fn is_eai(code: i32) -> bool { code >= 100000 }

/// Windows resolver failures are Winsock codes.
#[cfg(target_os = "windows")]
fn is_eai(code: i32) -> bool { false }

/// The OS text of error `code`, after `context: ` unless that is empty.
fn os_message(code: i32, context: str) -> str {
    let msg = unsafe { rok_os_strerror(code) };
    if context.len() > 0 { f"{context}: {msg}" } else { msg }
}

impl Display for IoError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message) }
}

impl Debug for IoError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        let code = match self.os_code {
            c: i32 => f"{c}",
            none => "none",
        };
        try f.write_str(f"IoError({self.kind:?}, {code}, {self.message})")
    }
}

impl Error for IoError {}

/// `r`, or its OS error thrown when `r < 0` (the runtime's `-errno`).
#[discardable]
pub(pkg) fn check(r: i64, context: str) throws (IoError) -> i64 {
    if r < 0 { throw IoError::from_os_code((0 - r) as i32, context); }
    r
}

/// Whether runtime result `r` failed with `WouldBlock`.
pub(pkg) fn would_block(r: i64) -> bool {
    r < 0 && IoErrorKind::of_os((0 - r) as i32) == IoErrorKind::WouldBlock
}

/// An OS file descriptor (Windows: a handle value).
pub type RawFd = i32;

/// A zeroed list of `n` bytes (a read buffer).
pub const fn byte_buf(n: usize) -> List<u8> {
    let out: List<u8> = List::with_capacity(n);
    unsafe { out.set_len(n) };
    out
}

#[intrinsic("rok.atomic.xchg")]
#[discardable]
fn atomic_xchg<T>(buf: GcBuf<T>, i: usize, v: T, o: rok::core::sync::UpdateOrdering) -> T;

/// The OS handle in `cell[i]`, leaving `empty` there. Copies of a handle
/// share its cell, so of any that release it, even at once from several
/// threads, exactly one gets the handle; the rest get `empty`.
#[discardable]
pub(pkg) fn take_handle<T>(cell: GcBuf<T>, i: usize, empty: T) -> T {
    unsafe { atomic_xchg(cell, i, empty, SeqCst) }
}

#[intrinsic("rok.atomic.cas")]
#[discardable]
fn atomic_cas<T>(buf: GcBuf<T>, i: usize, current: T, new: T, success: rok::core::sync::UpdateOrdering, failure: rok::core::sync::LoadOrdering) -> T;
#[intrinsic("rok.atomic.sub")]
#[discardable]
fn atomic_sub<T>(buf: GcBuf<T>, i: usize, v: T, o: rok::core::sync::UpdateOrdering) -> T;
#[intrinsic("rok.atomic.or")]
#[discardable]
fn atomic_or<T>(buf: GcBuf<T>, i: usize, v: T, o: rok::core::sync::UpdateOrdering) -> T;
#[intrinsic("rok.atomic.load")]
fn atomic_load<T>(buf: GcBuf<T>, i: usize, o: rok::core::sync::LoadOrdering) -> T;

// Calls in flight on a handle that copies share. `cell[u]` counts them
// by 2, and bit 0 is set once the handle is closed. A close while calls
// are in flight leaves the release to the last of them, so no call runs
// on a handle that was closed (and its number maybe reused) under it.

/// Start a call: `false` (and nothing to end) if the handle is closed.
pub(pkg) fn use_begin(cell: GcBuf<i32>, u: usize) -> bool {
    // A compare-and-swap, not an add: once closed the count only goes
    // down, so the last call to end is one that ran.
    let n = unsafe { cell[u] };
    loop {
        if (n & 1) != 0 { return false; }
        let seen = unsafe { atomic_cas(cell, u, n, n + 2, SeqCst, SeqCst) };
        if seen == n { return true; }
        n = seen;
    }
}

/// End a call: `true` if it was the last after a close, and the caller
/// releases the handle now.
pub(pkg) fn use_end(cell: GcBuf<i32>, u: usize) -> bool {
    unsafe { atomic_sub(cell, u, 2, SeqCst) } == 3
}

/// Close: the word before. 0: the caller releases the handle now; bit 0
/// set: it was closed already; else a call in flight releases it.
pub(pkg) fn use_close(cell: GcBuf<i32>, u: usize) -> i32 {
    unsafe { atomic_or(cell, u, 1, SeqCst) }
}

/// `cell[i]`, read atomically (a word another thread may change).
pub(pkg) fn word_at(cell: GcBuf<i32>, i: usize) -> i32 {
    unsafe { atomic_load(cell, i, SeqCst) }
}

/// The region `(buf, off, len)` holding `b`'s bytes.
pub(pkg) const fn region<B: AsBytes>(b: B) -> (GcBuf<u8>, usize, usize) {
    unsafe { b.byte_slice().raw_parts() }
}

/// A new list of `b`'s bytes.
pub(pkg) const fn list_of<B: AsBytes>(b: B) -> List<u8> {
    let (src, at, n) = region(b);
    let out = byte_buf(n);
    let (dst, to, _) = region(out);
    unsafe { rok_buf_copy(dst, to, src, at, n) };
    out
}

/// A new list of `s`'s UTF-8 bytes.
pub(pkg) const fn list_of_str(s: str) -> List<u8> {
    let out = byte_buf(s.len());
    let (dst, to, _) = region(out);
    unsafe { rok_buf_put_str(dst, to, s) };
    out
}

/// A runtime call on the region `(buf, off, len)`: a count or `-errno`.
pub(pkg) type RegionIo = fn(GcBuf<u8>, usize, usize) -> isize;

/// Grow `out` by `n` bytes to fill in place: their region's buffer and
/// offset.
const fn spare(out: List<u8>, n: usize) -> (GcBuf<u8>, usize) {
    out.reserve(n);
    let m = out.len();
    unsafe { out.set_len(m + n) };
    let (buf, at, _) = region(out);
    (buf, at + m)
}

/// Append `src[at..at + n]` to `out`.
pub(pkg) const fn append(out: List<u8>, src: GcBuf<u8>, at: usize, n: usize) {
    let (dst, to) = spare(out, n);
    unsafe { rok_buf_copy(dst, to, src, at, n) };
}

/// Grow `out` by what one runtime read `read(buf, off, len)` (a count or
/// `-errno`) puts in up to `want` new bytes; the count.
pub(pkg) fn read_more(out: List<u8>, want: usize, read: RegionIo, context: str) throws (IoError) -> usize {
    let m = out.len();
    let (buf, at) = spare(out, want);
    let r = read(buf, at, want);
    unsafe { out.set_len(m) };
    let n = (try check(r as i64, context)) as usize;
    unsafe { out.set_len(m + n) };
    n
}

/// Everything `read` (as in `read_more`) yields until it reports 0, read
/// into the spare room before growing. `hint`: the bytes expected (0:
/// unknown); with one byte more of room, the read that sees the end
/// needs no growth.
pub(pkg) fn read_all(read: RegionIo, context: str, hint: usize) throws (IoError) -> List<u8> {
    let out: List<u8> = List::with_capacity(if hint > 0 { hint + 1 } else { 0 });
    loop {
        let room = out.capacity() - out.len();
        if (try read_more(out, if room > 0 { room } else { 16384 }, read, context)) == 0 {
            return out;
        }
    }
}

/// The bytes a runtime call `get(buf, off, len)` copies into a region:
/// it returns their full length (or `-errno`), so a short region is
/// retried with room for all of them.
pub(pkg) fn fetch(get: RegionIo, context: str) throws (IoError) -> List<u8> {
    let cap = 256usize;
    loop {
        let out = byte_buf(cap);
        let (buf, at, _) = region(out);
        let n = (try check(get(buf, at, cap) as i64, context)) as usize;
        if n <= cap {
            unsafe { out.set_len(n) };
            return out;
        }
        cap = n;
    }
}

/// Write all of `buf[at..at + n]` with `write(buf, off, len)` (a count
/// or `-errno` per call).
pub(pkg) fn write_region(buf: GcBuf<u8>, at: usize, n: usize, write: RegionIo, context: str) throws (IoError) {
    let done = 0usize;
    while done < n {
        let k = try check(write(buf, at + done, n - done) as i64, context);
        if k == 0 { throw IoError::new(IoErrorKind::Other, "failed to write whole buffer"); }
        done += k as usize;
    }
}

/// Bytes as text, or `InvalidData`.
pub(pkg) const fn text_of(bytes: List<u8>) throws (IoError) -> str {
    try str::from_utf8(bytes) catch _ {
        throw IoError::new(IoErrorKind::InvalidData, "stream did not contain valid UTF-8");
    }
}

// traits (305.1)

pub trait Reader {
    /// Read up to `buf.len()` bytes into `buf[0..n]`; `0` = end of stream.
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize;

    /// The OS descriptor `copy` may hand to the kernel: one with no
    /// buffer, timeout or non-blocking mode of the stream's own. `-1`
    /// (the default): none.
    const fn raw_fd(self) -> RawFd { -1 }

    /// Read up to `r.end - r.start` bytes into `buf[r.start..r.end]`; the
    /// count, `0` at the end of the stream. Panics if `r` is not within
    /// `buf`.
    #[track_caller]
    fn read_into(ref self, buf: List<u8>, r: Range<usize>) throws (IoError) -> usize {
        if r.start > r.end || r.end > buf.len() {
            panic(f"read_into: range {r.start}..{r.end} is not within a buffer of {buf.len()} bytes");
        }
        let chunk = byte_buf(r.end - r.start);
        let n = try self.read(chunk);
        let (dst, to, _) = region(buf);
        let (src, from, _) = region(chunk);
        unsafe { rok_buf_copy(dst, to + r.start, src, from, n) };
        n
    }

    /// Fill all of `buf`, or `UnexpectedEof`.
    fn read_exact(ref self, buf: List<u8>) throws (IoError) {
        let at = try self.read(buf);
        if at == buf.len() { return; }
        let (dst, to, _) = region(buf);
        while at < buf.len() {
            if at == 0 { throw IoError::new(IoErrorKind::UnexpectedEof, "failed to fill whole buffer"); }
            let chunk = byte_buf(buf.len() - at);
            let n = try self.read(chunk);
            if n == 0 { throw IoError::new(IoErrorKind::UnexpectedEof, "failed to fill whole buffer"); }
            let (src, from, _) = region(chunk);
            unsafe { rok_buf_copy(dst, to + at, src, from, n) };
            at += n;
        }
    }

    /// Every remaining byte.
    fn read_to_end(ref self) throws (IoError) -> List<u8> {
        let out: List<u8> = List::new();
        let chunk = byte_buf(4096);
        let (src, from, _) = region(chunk);
        loop {
            let n = try self.read(chunk);
            if n == 0 { break; }
            append(out, src, from, n);
        }
        out
    }

    /// Every remaining byte as text (`InvalidData` if not UTF-8).
    fn read_to_str(ref self) throws (IoError) -> str {
        try text_of(try self.read_to_end())
    }

    /// The next line, `\n` included; `""` at the end of the stream.
    fn read_line(ref self) throws (IoError) -> str {
        let line: List<u8> = List::new();
        let one = byte_buf(1);
        loop {
            if (try self.read(one)) == 0 { break; }
            line.push(one[0]);
            if one[0] == 10u8 { break; }
        }
        try text_of(line)
    }

    /// The remaining lines (without `\n` / `\r\n`).
    const fn lines(ref self) -> Lines<Self> {
        Lines { reader: self }
    }

    /// The remaining bytes one at a time (wrap in `BufReader` first:
    /// each item is one `read`).
    const fn bytes(ref self) -> Bytes<Self> {
        Bytes { reader: self, one: byte_buf(1) }
    }
}

/// A resource whose close can fail: a file, a pipe, a buffered writer.
/// Its owner closes it, `try x.close()` or `using`; leaving its scope
/// open is an error, since a close error would be lost (stdlib 2.13.4).
#[lang("close_trait")]
pub trait Close {
    fn close(self) throws (IoError);
}

pub trait Writer {
    /// Write some prefix of `buf`; returns its length.
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize;
    fn flush(ref self) throws (IoError);

    /// As `Reader::raw_fd`.
    const fn raw_fd(self) -> RawFd { -1 }

    fn write_all(ref self, buf: List<u8>) throws (IoError) {
        let rest = buf;
        while rest.len() > 0 {
            let n = try self.write(rest);
            if n == 0 { throw IoError::new(IoErrorKind::Other, "failed to write whole buffer"); }
            if n < rest.len() { rest = list_of(rest[n:rest.len()]); } else { return; }
        }
    }

    fn write_str(ref self, s: str) throws (IoError) {
        try self.write_all(list_of_str(s));
    }

    /// `write_all` of anything `AsBytes`: a `str`, a `List<u8>`, a
    /// `Slice<u8>`.
    fn write_bytes<B: AsBytes>(ref self, data: B) throws (IoError) {
        try self.write_all(list_of(data));
    }

    /// Write formatted text: `try w.write_fmt(f"{x}\n")`.
    fn write_fmt(ref self, s: str) throws (IoError) {
        try self.write_str(s);
    }

    /// Write `x` as `print` would show it (`Display`): `try w.write_display(p)`.
    /// The text goes to `write_str` in chunks as it is made, so a large
    /// value is never held whole as a `str`. For several values, write
    /// an f-string (`try w.write_display(f"total = {n}\n")`) or call once
    /// per value. A failed write is thrown as it is; a `Display` that
    /// fails on its own is `IoErrorKind::Other`.
    fn write_display<T: Display>(ref self, x: T) throws (IoError) {
        let failed: IoError | none = none;
        let out = Formatter::to_sink([ref self, ref failed] |s: str| -> bool {
            try self.write_str(s) catch err {
                failed = err;
                return false;
            };
            true
        });
        let ok = true;
        try Display::fmt(x, ref out) catch _ { ok = false; };
        if ok { try out.flush() catch _ { ok = false; }; }
        if let err: IoError = failed { throw err; }
        if !ok { throw IoError::new(IoErrorKind::Other, "a `Display` implementation failed (FmtError)"); }
    }
}

/// A position for `Seek::seek` (spec puts it in 301 fs; `fs` re-exports it).
pub enum SeekFrom {
    Start(u64),
    End(i64),
    Current(i64),
}

pub trait Seek {
    /// Move the cursor; returns the new offset from the start.
    fn seek(ref self, pos: SeekFrom) throws (IoError) -> u64;

    fn rewind(ref self) throws (IoError) {
        _ = try self.seek(SeekFrom::Start(0u64));
    }

    fn stream_position(ref self) throws (IoError) -> u64 {
        try self.seek(SeekFrom::Current(0i64))
    }
}

/// `reader.lines()`: each item is a line or the error that ended it.
pub struct Lines<R> {
    reader: R;
}

impl<R: Reader> Iterator for Lines<R> {
    type Item = Result<str, IoError>;
    fn next(ref self) -> Result<str, IoError> | none {
        let line = try self.reader.read_line() catch e { return Result::Err(e); };
        if line.len() == 0 { return none; }
        if line.ends_with("\n") { line = line[:line.len() - 1]; }
        if line.ends_with("\r") { line = line[:line.len() - 1]; }
        Result::Ok(line)
    }
}

/// `reader.bytes()`: each item is a byte or the error that ended the stream.
pub struct Bytes<R> {
    reader: R;
    one: List<u8>;
}

impl<R: Reader> Iterator for Bytes<R> {
    type Item = Result<u8, IoError>;
    fn next(ref self) -> Result<u8, IoError> | none {
        let n = try self.reader.read(self.one) catch e { return Result::Err(e); };
        if n == 0 { return none; }
        Result::Ok(self.one[0])
    }
}

// buffering (305.3)

/// Reads `inner` in `cap`-byte chunks, so small reads (`read_line`,
/// `bytes`) do not each cost a system call.
pub struct BufReader<R> {
    inner: R;
    /// Bytes read but not yet handed out: `chunk[pos..end]`.
    chunk: List<u8>;
    pos: usize;
    end: usize;
}

impl<R: Reader> BufReader<R> {
    pub const fn new(inner: R) -> BufReader<R> { BufReader::with_capacity(8192, inner) }

    pub const fn with_capacity(cap: usize, inner: R) -> BufReader<R> {
        let c = if cap == 0 { 1 } else { cap };
        BufReader { inner: inner, chunk: byte_buf(c), pos: 0, end: 0 }
    }

    pub fn into_inner(self) -> R { self.inner }

    /// Bytes buffered and not yet read.
    pub fn buffered(self) -> usize { self.end - self.pos }
}

/// Refill `b` when it is drained; false at the end of the stream.
fn buf_fill<R: Reader>(ref b: BufReader<R>) throws (IoError) -> bool {
    if b.pos < b.end { return true; }
    b.end = try b.inner.read(b.chunk);
    b.pos = 0;
    b.end > 0
}

impl<R: Reader> Reader for BufReader<R> {
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize {
        if buf.len() == 0 { return 0; }
        // A read at least as big as the buffer skips it when it is empty.
        if self.pos >= self.end && buf.len() >= self.chunk.len() {
            return try self.inner.read(buf);
        }
        if !(try buf_fill(ref self)) { return 0; }
        let n = self.end - self.pos;
        if n > buf.len() { n = buf.len(); }
        let (dst, to, _) = region(buf);
        let (src, from, _) = region(self.chunk);
        unsafe { rok_buf_copy(dst, to, src, from + self.pos, n) };
        self.pos += n;
        n
    }

    fn read_line(ref self) throws (IoError) -> str {
        let line: List<u8> = List::new();
        loop {
            if !(try buf_fill(ref self)) { break; }
            let i = self.pos;
            while i < self.end && self.chunk[i] != 10u8 { i += 1; }
            let found = i < self.end;
            let take = if found { i + 1 - self.pos } else { i - self.pos };
            let (src, from, _) = region(self.chunk);
            append(line, src, from + self.pos, take);
            self.pos += take;
            if found { break; }
        }
        try text_of(line)
    }
}

/// Collects writes and passes them to `inner` in `cap`-byte batches.
/// Call `flush()` when done: an error there is reported; leaving a
/// `using` block flushes too, but ignores the error.
pub struct BufWriter<W> {
    inner: W;
    cap: usize;
    pending: List<u8>;
    /// Inside a `LineWriter`: flush at each `\n`.
    by_line: bool;
}

impl<W: Writer> BufWriter<W> {
    pub const fn new(inner: W) -> BufWriter<W> { BufWriter::with_capacity(8192, inner) }

    pub const fn with_capacity(cap: usize, inner: W) -> BufWriter<W> {
        BufWriter { inner: inner, cap: cap, pending: List::with_capacity(cap), by_line: false }
    }

    /// Flushes, then hands back the inner writer.
    pub fn into_inner(self) throws (IoError) -> W {
        try buf_flush(ref self);
        self.inner
    }

    pub fn buffer_len(self) -> usize { self.pending.len() }
}

impl<W: Writer + Close> BufWriter<W> {
    /// Flush, then close the inner writer.
    pub fn close(self) throws (IoError) {
        let inner = try self.into_inner();
        try inner.close();
    }
}

impl<W: Writer + Close> Close for BufWriter<W> {
    fn close(self) throws (IoError) { try self.close(); }
}

/// Write out what `w` holds (not flushing `inner`). The batch is handed
/// over whole, so `inner` may keep the list.
fn buf_flush<W: Writer>(ref w: BufWriter<W>) throws (IoError) {
    if w.pending.len() == 0 { return; }
    let data = w.pending;
    w.pending = List::with_capacity(w.cap);
    try w.inner.write_all(data);
}

/// After appending: flush when full, or at a newline by line.
fn buf_after<W: Writer>(ref w: BufWriter<W>, newline: bool) throws (IoError) {
    if w.pending.len() >= w.cap || (w.by_line && newline) {
        try buf_flush(ref w);
    }
}

impl<W: Writer> Writer for BufWriter<W> {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize {
        let (src, from, n) = region(buf);
        append(self.pending, src, from, n);
        let newline = false;
        if self.by_line {
            for b in buf { if b == 10u8 { newline = true; } }
        }
        try buf_after(ref self, newline);
        n
    }

    fn write_str(ref self, s: str) throws (IoError) {
        let (dst, to) = spare(self.pending, s.len());
        unsafe { rok_buf_put_str(dst, to, s) };
        let newline = self.by_line && s.contains("\n");
        try buf_after(ref self, newline);
    }

    fn flush(ref self) throws (IoError) {
        try buf_flush(ref self);
        try self.inner.flush();
    }
}

impl<W: Writer> Drop for BufWriter<W> {
    fn drop(ref self) {
        try buf_flush(ref self) catch _ {};
    }
}

/// Buffers like `BufWriter`, and writes out through the last `\n`
/// whenever a write contains one (305.3).
pub struct LineWriter<W> {
    buf: BufWriter<W>;
}

impl<W: Writer> LineWriter<W> {
    pub const fn new(inner: W) -> LineWriter<W> {
        LineWriter {
            buf: BufWriter { inner: inner, cap: 8192, pending: List::with_capacity(8192), by_line: true },
        }
    }

    /// Flushes, then hands back the inner writer.
    pub fn into_inner(self) throws (IoError) -> W { try self.buf.into_inner() }
}

impl<W: Writer + Close> LineWriter<W> {
    /// Flush, then close the inner writer.
    pub fn close(self) throws (IoError) { try self.buf.close(); }
}

impl<W: Writer + Close> Close for LineWriter<W> {
    fn close(self) throws (IoError) { try self.close(); }
}

impl<W: Writer> Writer for LineWriter<W> {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize { try self.buf.write(buf) }
    fn write_str(ref self, s: str) throws (IoError) { try self.buf.write_str(s); }
    fn flush(ref self) throws (IoError) { try self.buf.flush(); }
}

impl<W: Writer> Drop for LineWriter<W> {
    fn drop(ref self) {
        try buf_flush(ref self.buf) catch _ {};
    }
}

/// Copy `reader` to its end into `writer`; returns the byte count. Two
/// OS descriptors (`raw_fd`) go to the runtime, which lets the kernel
/// move the bytes where their kinds allow (`copy_file_range` /
/// `sendfile` / `splice`); other streams copy through `read` / `write`.
#[discardable]
pub fn copy<R: Reader, W: Writer>(ref reader: R, ref writer: W) throws (IoError) -> u64 {
    let (from, to) = (Reader::raw_fd(reader), Writer::raw_fd(writer));
    if from >= 0 && to >= 0 {
        return (try check(unsafe { rok_os_copy_fd(from, to) }, "copy")) as u64;
    }
    let total = 0u64;
    loop {
        let chunk = byte_buf(8192);
        let n = try reader.read(chunk);
        if n == 0 { return total; }
        unsafe { chunk.set_len(n) };
        try writer.write_all(chunk);
        total += n as u64;
    }
}

// standard streams (305.2)

/// The process's standard input, through the runtime's shared buffer.
pub struct Stdin {}
/// Standard output, through the runtime's buffer shared with `print`:
/// flushed at a newline on a terminal, when full, and at exit.
pub struct Stdout {}
/// Standard error, unbuffered, shared with `eprint`.
pub struct Stderr {}

/// `stdin().lock()`: the same handle (the runtime locks each read).
pub type StdinLock = Stdin;

pub const fn stdin() -> Stdin { Stdin {} }
pub const fn stdout() -> Stdout { Stdout {} }
pub const fn stderr() -> Stderr { Stderr {} }

impl Stdin {
    pub const fn lock(self) -> StdinLock { self }
}

/// One stdin read into a region, stopping after `delim` (`-1`: none).
fn stdin_read(buf: GcBuf<u8>, at: usize, n: usize, delim: i32) -> isize {
    unsafe { rok_stdin_read(buf, at, n, delim) }
}

impl Reader for Stdin {
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize {
        let (dst, to, n) = region(buf);
        (try check(stdin_read(dst, to, n, -1) as i64, "stdin")) as usize
    }

    fn read_to_end(ref self) throws (IoError) -> List<u8> {
        try read_all(|b: GcBuf<u8>, at: usize, n: usize| stdin_read(b, at, n, -1), "stdin", 0)
    }

    fn read_line(ref self) throws (IoError) -> str {
        let line: List<u8> = List::new();
        loop {
            let n = try read_more(line, 256, |b: GcBuf<u8>, at: usize, k: usize| stdin_read(b, at, k, 10), "stdin");
            if n == 0 || line[line.len() - 1] == 10u8 { break; }
        }
        try text_of(line)
    }
}

impl Writer for Stdout {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize {
        let (src, from, n) = region(buf);
        try check(unsafe { rok_stdio_write_buf(1, src, from, n) } as i64, "stdout");
        n
    }

    fn write_str(ref self, s: str) throws (IoError) {
        try check(unsafe { rok_stdio_write(1, s, 0) } as i64, "stdout");
    }

    fn flush(ref self) throws (IoError) {
        try check(unsafe { rok_stdio_flush() } as i64, "stdout");
    }
}

impl Writer for Stderr {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize {
        let (src, from, n) = region(buf);
        try check(unsafe { rok_stdio_write_buf(2, src, from, n) } as i64, "stderr");
        n
    }

    fn write_str(ref self, s: str) throws (IoError) {
        try check(unsafe { rok_stdio_write(2, s, 0) } as i64, "stderr");
    }

    const fn flush(ref self) throws (IoError) {}
}

// rok::std::net::tls - TLS 1.3 (stdlib spec 3.2.5), implemented here in
// rok on `rok::core::crypto`: no OS or external TLS library.
//
// `Client` / `Server` wrap a `TcpStream`; after the handshake they read
// and write application data like the stream itself, blocking or, with
// the `*_async` methods, suspending only the task. Server certificates
// are validated against `ClientConfig::root_certs` (by default the OS
// trust store: the macOS keychain anchors, the Windows ROOT store, the
// Linux CA bundle files; none on wasm). Key exchange is X25519, or the
// X25519MLKEM768 hybrid when `enable_pq` is on. Either side signs with
// Ed25519, ECDSA P-256 / P-384 or RSA-PSS; the server may ask for a
// client certificate. Sessions resume from single-use tickets
// (psk_dhe_ke), optionally with 0-RTT data. A connection is used by one
// thread, and one operation, at a time.

pub(pkg) mod der;
pub(pkg) mod pem;
pub(pkg) mod x509;
pub(pkg) mod ocsp;
pub(pkg) mod conn;

use rok::bare::mem::{GcBuf, buf_new};
use rok::std::net::{TcpStream, Shutdown};
use rok::core::task;
use rok::core::convert::AsBytes;
use rok::core::io::{Close, IoError, IoErrorKind, Read, Write, AsyncRead, AsyncWrite};
use rok::std::sys::{byte_buf, mut_region};
use rok::std::fs;
use rok::std::env;
use rok::core::time::{Duration, Instant};
use rok::std::time::SystemTime;
use rok::std::net::tls::x509::{CertInfo, PubKey};
use rok::std::net::tls::conn::{Conn, new_conn, io_tls, OP_HANDSHAKE, OP_READ, OP_WRITE, OP_CLOSE_NOTIFY, OP_KEY_UPDATE};
use rok::std::net::tls::der::{Der, SEQUENCE, INTEGER, OCTET_STRING, OID};
use rok::core::crypto::{ecdsa, ed25519, rsa};
use rok::core::crypto::ecdsa::EcCurve;
use rok::core::crypto::Secret;

/// What failed.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
#[non_exhaustive]
pub enum TlsErrorKind {
    /// The underlying stream failed or closed.
    Io,
    /// The peer's certificate is malformed or not trusted for the name.
    Certificate,
    /// The peer broke the protocol (or offered nothing in common).
    Protocol,
    /// The peer sent a fatal alert.
    PeerAlert,
}

/// A failed handshake or connection. `alert` is the TLS alert sent to
/// the peer (or received, for `PeerAlert`).
#[derive(Clone, PartialEq, Eq)]
pub struct TlsError {
    pub(sub) kind: TlsErrorKind;
    pub(sub) msg: str;
    pub(sub) alert: u8;
}

impl TlsError {
    pub(pkg) const fn certificate(msg: str) -> TlsError {
        TlsError { kind: TlsErrorKind::Certificate, msg, alert: 42u8 }
    }

    pub const fn kind(self) -> TlsErrorKind { self.kind }
    /// What went wrong, without the `tls: ` that `Display` adds.
    pub const fn message(self) -> str { self.msg }
    /// The TLS alert sent to the peer (or received, for `PeerAlert`).
    pub const fn alert(self) -> u8 { self.alert }
}

impl Display for TlsError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"tls: {self.msg}") }
}

impl Debug for TlsError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"TlsError({self.kind:?}, {self.msg:?}, alert {self.alert})") }
}

impl Error for TlsError {}

/// A TLS 1.3 cipher suite.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum CipherSuite {
    Aes128GcmSha256,
    Aes256GcmSha384,
    ChaCha20Poly1305Sha256,
}

impl CipherSuite {
    /// All three, in the default preference order.
    pub const fn all() -> List<CipherSuite> {
        [CipherSuite::Aes128GcmSha256, CipherSuite::Aes256GcmSha384, CipherSuite::ChaCha20Poly1305Sha256]
    }
}

/// An X.509 certificate (DER), parsed.
pub struct Certificate {
    pub(pkg) der: List<u8>;
    pub(pkg) info: CertInfo;
}

// Never changed once parsed, and its accessors give copies: threads may
// share one, and a hand-off or `Frozen::get` of a config does not copy
// its certificates.
unsafe impl Sync for Certificate {}

impl Certificate {
    pub fn from_der<B: AsBytes>(der: B) throws (TlsError) -> Certificate {
        // Own the bytes: `info` views them, and a caller's list may change.
        let d: List<u8> = der.byte_slice().to_list();
        Certificate { der: d, info: try x509::parse(d[0:d.len()]) }
    }

    /// Every `CERTIFICATE` block of PEM text.
    pub fn from_pem(text: str) throws (TlsError) -> List<Certificate> {
        let out: List<Certificate> = [];
        for b in try pem::blocks(text, "CERTIFICATE") { out.push(try Certificate::from_der(b)); }
        out
    }

    /// The DER encoding.
    pub const fn to_der(self) -> List<u8> { self.der.clone() }

    /// The subjectAltName DNS names.
    pub const fn dns_names(self) -> List<str> { self.info.dns_names.clone() }

    /// The validity period.
    pub const fn not_before(self) -> SystemTime { SystemTime::from_unix(self.info.not_before, 0u32) }
    pub const fn not_after(self) -> SystemTime { SystemTime::from_unix(self.info.not_after, 0u32) }
}

/// A server's private key: Ed25519, ECDSA P-256 / P-384 or RSA.
pub struct PrivateKey {
    pub(pkg) key: KeyKind;
}

pub(pkg) enum KeyKind {
    Ed25519(ed25519::SigningKey),
    Ec(ecdsa::SigningKey),
    Rsa(rsa::PrivateKey),
}

const fn curve_of_oid(oid: str) throws (TlsError) -> EcCurve {
    if oid == "1.2.840.10045.3.1.7" { return EcCurve::P256; }
    if oid == "1.3.132.0.34" { return EcCurve::P384; }
    throw TlsError::certificate(f"unsupported EC private key curve {oid} (P-256 and P-384 only)");
}

/// An `ECPrivateKey` (RFC 5915); its curve from `curve` or, if none,
/// from its own parameters.
fn ec_key(b: Slice<u8>, curve: EcCurve | none) throws (TlsError) -> PrivateKey {
    let top = Der::new(b);
    let k = try top.enter(SEQUENCE);
    try top.finish();
    if (try der::small_int(try k.expect(INTEGER))) != 1 { throw TlsError::certificate("unsupported ECPrivateKey version"); }
    let d = try k.expect(OCTET_STRING);
    let c: EcCurve | none = curve;
    match try k.optional(0xa0u8) {
        p: Slice<u8> => { c = try curve_of_oid(try der::oid_text(try Der::new(p).expect(OID))); },
        none => {},
    }
    if c is none { throw TlsError::certificate("ECPrivateKey without a curve"); }
    let cv = c ?? EcCurve::P256;
    let sk = try ecdsa::SigningKey::from_bytes(cv, d) catch _ { throw TlsError::certificate("bad EC private key"); };
    PrivateKey { key: KeyKind::Ec(sk) }
}

fn rsa_key(b: Slice<u8>) throws (TlsError) -> PrivateKey {
    let k = try rsa::PrivateKey::from_pkcs1_der(b) catch e { throw TlsError::certificate(f"bad RSA private key: {e.message()}"); };
    PrivateKey { key: KeyKind::Rsa(k) }
}

impl PrivateKey {
    /// A PKCS #8 `PrivateKeyInfo` / `OneAsymmetricKey`: Ed25519 (RFC
    /// 8410), EC (RFC 5915) or rsaEncryption (RFC 8017).
    pub fn from_der<B: AsBytes>(der: B) throws (TlsError) -> PrivateKey {
        let s = der.byte_slice();
        let top = Der::new(s);
        let k = try top.enter(SEQUENCE);
        try top.finish();
        let version = try der::small_int(try k.expect(INTEGER));
        if version > 1 { throw TlsError::certificate("unsupported PKCS #8 version"); }
        let alg = try k.enter(SEQUENCE);
        let oid = try der::oid_text(try alg.expect(OID));
        let inner = try k.expect(OCTET_STRING);
        if oid == "1.3.101.112" {
            try alg.finish();
            let seed = try Der::new(inner).expect(OCTET_STRING);
            let k = try ed25519::SigningKey::from_seed(seed) catch _ { throw TlsError::certificate("bad Ed25519 private key"); };
            return PrivateKey { key: KeyKind::Ed25519(k) };
        }
        if oid == "1.2.840.10045.2.1" {
            let curve = try curve_of_oid(try der::oid_text(try alg.expect(OID)));
            try alg.finish();
            return try ec_key(inner, curve);
        }
        if oid == "1.2.840.113549.1.1.1" {
            let _ = try alg.optional(der::NULL);
            try alg.finish();
            return try rsa_key(inner);
        }
        if oid == "1.2.840.113549.1.1.10" {
            // id-RSASSA-PSS: the certificate's parameters decide the
            // schemes, these are only checked.
            let p = try alg.optional(SEQUENCE);
            try alg.finish();
            match p {
                b: Slice<u8> => match try x509::pss_params(b) {
                    x509::SigAlg::RsaPss(_, _) => {},
                    _ => throw TlsError::certificate("unsupported RSASSA-PSS key parameters"),
                },
                none => {},
            }
            return try rsa_key(inner);
        }
        throw TlsError::certificate(f"unsupported private key algorithm {oid} (Ed25519, EC, rsaEncryption, RSASSA-PSS)");
    }

    /// Whether this is the private key of `cert`'s public key.
    pub(pkg) fn matches(self, cert: Certificate) -> bool {
        match self.key {
            KeyKind::Ed25519(k) => match cert.info.key {
                PubKey::EdDsa(pk) => k.verifying_key().to_bytes()[0:32] == pk[0:pk.len()],
                _ => false,
            },
            KeyKind::Ec(k) => match cert.info.key {
                PubKey::Ec(c, pt) => c == k.curve() && k.verifying_key().to_sec1() == pt,
                _ => false,
            },
            KeyKind::Rsa(k) => {
                let der: List<u8> = match cert.info.key {
                    PubKey::Rsa(b) => b,
                    PubKey::RsaPss(b, _, _) => b,
                    _ => return false,
                };
                let p: rsa::PublicKey = try rsa::PublicKey::from_pkcs1_der(der) catch _ { return false; };
                let mine = k.public_key();
                p.modulus() == mine.modulus() && p.exponent() == mine.exponent()
            },
        }
    }

    /// The first private key of PEM text: `PRIVATE KEY` (PKCS #8),
    /// `EC PRIVATE KEY` (RFC 5915) or `RSA PRIVATE KEY` (PKCS #1).
    pub fn from_pem(text: str) throws (TlsError) -> PrivateKey {
        let p8 = try pem::blocks(text, "PRIVATE KEY");
        if p8.len() > 0 { return try PrivateKey::from_der(p8[0]); }
        let ec = try pem::blocks(text, "EC PRIVATE KEY");
        if ec.len() > 0 { return try ec_key(ec[0][0:ec[0].len()], none); }
        let rsa = try pem::blocks(text, "RSA PRIVATE KEY");
        if rsa.len() > 0 { return try rsa_key(rsa[0][0:rsa[0].len()]); }
        throw TlsError::certificate("no PRIVATE KEY, EC PRIVATE KEY or RSA PRIVATE KEY block");
    }
}

/// A client's settings: a record whose fields all have defaults except
/// `root_certs`, which `new()` fills from the OS trust store:
/// `ClientConfig { alpn_protocols: [b"h2"], ..try ClientConfig::new() }`.
/// Fields added later have defaults too.
#[non_exhaustive]
pub struct ClientConfig {
    /// Trust anchors for the server's certificate.
    pub root_certs: List<Certificate>;
    /// In preference order; TLS 1.3 suites only.
    pub cipher_suites: List<CipherSuite> = CipherSuite::all();
    /// ALPN protocols offered, in preference order (`"h2"`, ...).
    pub alpn_protocols: List<List<u8>> = [];
    /// Offer the X25519MLKEM768 hybrid key exchange first.
    pub enable_pq: bool = true;
    /// Sent when the server asks for a certificate: leaf first (empty:
    /// none), with the leaf's key.
    pub client_cert_chain: List<Certificate> = [];
    pub client_key: PrivateKey | none = none;
    /// Tickets from earlier connections, to resume from (none: never
    /// resume).
    pub session_cache: SessionCache | none = SessionCache::new();
    /// Sent as 0-RTT data when a resumed session allows that much, else
    /// as the first application data after the handshake.
    pub early_data: List<u8> = [];
}

impl ClientConfig {
    /// The OS trust store and every default: all suites, no ALPN,
    /// post-quantum on, no client certificate, a new session cache, no
    /// early data. Throws the `system_roots` error when no trust store is
    /// found or readable.
    pub fn new() throws (TlsError) -> ClientConfig {
        ClientConfig { root_certs: try system_roots() }
    }
}

/// A server's settings: a record whose fields all have defaults except
/// the certificate chain and its key:
/// `ServerConfig { max_early_data: 16384u32, ..try ServerConfig::new(chain, key) }`,
/// or a literal naming both; `Server::new` checks the key is the leaf's.
#[non_exhaustive]
pub struct ServerConfig {
    /// The server's certificate first, then intermediates.
    pub cert_chain: List<Certificate>;
    pub private_key: PrivateKey;
    pub cipher_suites: List<CipherSuite> = CipherSuite::all();
    pub alpn_protocols: List<List<u8>> = [];
    /// Non-empty: ask for a client certificate and validate it against
    /// these roots (clientAuth).
    pub client_roots: List<Certificate> = [];
    /// With `client_roots`: refuse a client that sends no certificate.
    pub require_client_cert: bool = true;
    /// A DER OCSPResponse for the leaf, stapled when the client asks
    /// (empty: none).
    pub ocsp_response: List<u8> = [];
    /// Issues and redeems session tickets (none: no resumption).
    pub ticket_store: TicketStore | none = TicketStore::new();
    /// 0-RTT data accepted per resumed connection, in bytes (0: none).
    pub max_early_data: u32 = 0u32;
}

impl ServerConfig {
    /// `chain` and `key` with every default, checked now rather than at
    /// the first handshake.
    pub fn new(cert_chain: List<Certificate>, private_key: PrivateKey) throws (TlsError) -> ServerConfig {
        let cfg = ServerConfig { cert_chain, private_key };
        try check_server_config(cfg);
        cfg
    }
}

/// The chain must have a leaf, and the key must be the leaf's.
fn check_server_config(cfg: ServerConfig) throws (TlsError) {
    if cfg.cert_chain.len() == 0 { throw TlsError::certificate("ServerConfig without a certificate"); }
    if !cfg.private_key.matches(cfg.cert_chain[0]) { throw TlsError::certificate("private key does not match the certificate"); }
}

/// A ticket the client holds (RFC 8446 4.6.1).
pub(pkg) struct Ticket {
    pub(pkg) host: str;
    pub(pkg) suite: CipherSuite;
    pub(pkg) ticket: List<u8>;
    pub(pkg) psk: Secret;
    pub(pkg) age_add: u32;
    pub(pkg) lifetime: u32;
    pub(pkg) received: Instant;
    pub(pkg) max_early: u32;
    pub(pkg) alpn: List<u8> | none;
    pub(pkg) peer: List<Certificate>;
}

/// Tickets per cache.
const CACHE_MAX: usize = 64;

/// The client's tickets by server name; copies share them. Each ticket
/// is used once (RFC 8446 C.4).
pub struct SessionCache {
    m: Mutex<List<Ticket>>;
}

impl SessionCache {
    pub const fn new() -> SessionCache { SessionCache { m: unsafe { Mutex::new_unshared([]) } } }

    /// Tickets held.
    pub fn len(self) -> usize {
        let n = 0usize;
        using g = self.m.lock() { n = g.get().len(); }
        n
    }

    pub fn clear(self) {
        using g = self.m.lock() { g.set([]); }
    }

    pub(pkg) fn put(self, t: Ticket) {
        // The cache's own copy: the connection keeps its lists.
        let own = Ticket { ticket: t.ticket.clone(), alpn: bytes_copy(t.alpn), peer: certs_copy(t.peer), ..t };
        using g = self.m.lock() {
            let l = g.get();
            if l.len() >= CACHE_MAX { let _ = l.remove(0); }
            l.push(own);
        }
    }

    /// The newest live ticket for `host` whose suite's hash one of
    /// `suites` has, removed (expired tickets are dropped).
    pub(pkg) fn take(self, host: str, suites: List<CipherSuite>) -> Ticket | none {
        let found: Ticket | none = none;
        using g = self.m.lock() {
            let live: List<Ticket> = [];
            for t in g.get() {
                if t.received.elapsed().as_secs() < t.lifetime as i64 { live.push(t); }
            }
            let j = live.len();
            while j > 0 && found is none {
                j -= 1;
                if live[j].host == host && hash_offered(live[j].suite, suites) { found = live.remove(j); }
            }
            g.set(live);
        }
        found
    }
}

fn bytes_copy(b: List<u8> | none) -> List<u8> | none {
    match b {
        l: List<u8> => l.clone(),
        none => none,
    }
}

/// Copies parsed again: a certificate's views point into its bytes.
fn certs_copy(cs: List<Certificate>) -> List<Certificate> {
    let out: List<Certificate> = [];
    for c in cs {
        out.push(try! Certificate::from_der(c.der));
    }
    out
}

fn hash_offered(s: CipherSuite, suites: List<CipherSuite>) -> bool {
    for x in suites {
        if conn::suite_hash(x) == conn::suite_hash(s) { return true; }
    }
    false
}

/// A session the server can resume.
pub(pkg) struct Session {
    pub(pkg) id: List<u8>;
    pub(pkg) psk: Secret;
    pub(pkg) suite: CipherSuite;
    pub(pkg) alpn: List<u8> | none;
    pub(pkg) sni: str | none;
    pub(pkg) peer: List<Certificate>;
    pub(pkg) issued: Instant;
    pub(pkg) age_add: u32;
    pub(pkg) max_early: u32;
}

/// Sessions per store.
const STORE_MAX: usize = 4096;

/// Ticket lifetime, seconds.
pub(pkg) const TICKET_LIFETIME: u32 = 7200u32;

/// The server's resumable sessions; copies share them. A ticket is
/// redeemed at most once, which also stops 0-RTT replays (RFC 8446
/// 8.1) for every server sharing the store; the oldest session goes
/// when the store is full.
pub struct TicketStore {
    m: Mutex<List<Session>>;
}

impl TicketStore {
    pub const fn new() -> TicketStore { TicketStore { m: unsafe { Mutex::new_unshared([]) } } }

    /// Sessions held.
    pub fn len(self) -> usize {
        let n = 0usize;
        using g = self.m.lock() { n = g.get().len(); }
        n
    }

    pub(pkg) fn put(self, s: Session) {
        // The store's own copy: the connection keeps its lists.
        let own = Session { id: s.id.clone(), alpn: bytes_copy(s.alpn), peer: certs_copy(s.peer), ..s };
        using g = self.m.lock() {
            let l = g.get();
            if l.len() >= STORE_MAX { let _ = l.remove(0); }
            l.push(own);
        }
    }

    /// The live session with ticket `id`, left in the store.
    pub(pkg) fn find(self, id: Slice<u8>) -> Session | none {
        let found: Session | none = none;
        using g = self.m.lock() {
            for s in g.get() {
                if found is none && s.id[0:s.id.len()] == id && s.issued.elapsed().as_secs() < TICKET_LIFETIME as i64 { found = s; }
            }
        }
        // A stored session is never changed, so readers may share it
        // outside the lock.
        unsafe { found }
    }

    /// Remove the session with ticket `id`: whether it was there (so
    /// only one connection redeems it).
    pub(pkg) fn redeem(self, id: List<u8>) -> bool {
        let hit = false;
        using g = self.m.lock() {
            let l = g.get();
            let i = 0usize;
            while i < l.len() && !hit {
                if l[i].id == id {
                    let _ = l.remove(i);
                    hit = true;
                }
                i += 1;
            }
        }
        hit
    }
}

/// CA bundle files, first found wins (Debian / Ubuntu / Arch, Fedora /
/// RHEL, openSUSE, RHEL's extracted bundle, Alpine / BSDs).
const BUNDLES: [str; 5] = [
    "/etc/ssl/certs/ca-certificates.crt",
    "/etc/pki/tls/certs/ca-bundle.crt",
    "/etc/ssl/ca-bundle.pem",
    "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
    "/etc/ssl/cert.pem",
];

/// Parse the certificates a store holds, skipping ones this parser
/// rejects (stores carry odd legacy roots).
fn parse_all(ders: List<List<u8>>) -> List<Certificate> {
    let out: List<Certificate> = [];
    for d in ders {
        let c = try Certificate::from_der(d) catch _ { continue; };
        out.push(c);
    }
    out
}

fn load_roots() throws (TlsError) -> List<Certificate> {
    // `SSL_CERT_FILE` overrides the OS store (as OpenSSL and Go do).
    let path = try env::var("SSL_CERT_FILE") catch _ { "" };
    if path != "" {
        let text = try fs::read_to_str(path) catch e { throw TlsError::certificate(f"SSL_CERT_FILE: {e}"); };
        return parse_all(try pem::blocks(text, "CERTIFICATE"));
    }
    let n = unsafe { rok_os_trust_roots(buf_new(1), 0, 0) };
    if n >= 0 {
        let buf = byte_buf(n as usize);
        let (b, off, len) = unsafe { buf[0:buf.len()].raw_parts() };
        let m = unsafe { rok_os_trust_roots(b, off, len) };
        if m < 0 || m as usize > buf.len() { throw TlsError::certificate("cannot read the OS trust store"); }
        let ders: List<List<u8>> = [];
        let at = 0usize;
        while at + 4 <= m as usize {
            let l = ((buf[at] as usize) << 24) | ((buf[at + 1] as usize) << 16) | ((buf[at + 2] as usize) << 8) | (buf[at + 3] as usize);
            if at + 4 + l > m as usize { break; }
            ders.push(buf[at + 4:at + 4 + l].to_list());
            at += 4 + l;
        }
        return parse_all(ders);
    }
    for f in BUNDLES {
        let text = try fs::read_to_str(f) catch _ { continue; };
        return parse_all(try pem::blocks(text, "CERTIFICATE"));
    }
    throw TlsError::certificate("no OS trust store found (pass ClientConfig::root_certs)");
}

/// The OS's trusted root certificates, read on each call (reuse a
/// `ClientConfig` to read them once).
pub fn system_roots() throws (TlsError) -> List<Certificate> { try load_roots() }

/// `s` as an IP address's bytes, if it is one.
const fn ip_bytes(s: str) -> List<u8> | none {
    let h = if s.starts_with("[") && s.ends_with("]") { s[1:s.len() - 1] } else { s };
    let v4: rok::std::net::Ipv4Addr | none = try h.parse::<rok::std::net::Ipv4Addr>() catch _ { none };
    match v4 {
        a: rok::std::net::Ipv4Addr => return [a.octets()[0], a.octets()[1], a.octets()[2], a.octets()[3]],
        none => {},
    }
    let v6: rok::std::net::Ipv6Addr | none = try h.parse::<rok::std::net::Ipv6Addr>() catch _ { none };
    match v6 {
        a: rok::std::net::Ipv6Addr => {
            let out: List<u8> = [];
            for x in a.segments() {
                out.push((x >> 8) as u8);
                out.push(x as u8);
            }
            out
        },
        none => none,
    }
}

fn io_err(e: TlsError) -> IoError {
    let kind = if e.kind == TlsErrorKind::Io { IoErrorKind::UnexpectedEof } else { IoErrorKind::InvalidData };
    IoError::new(kind, f"tls: {e.msg}")
}

/// One side of a connection; `Client` and `Server` are views of it.
struct Shared {
    c: GcBuf<Conn>;
    /// Held by an async operation from its step until its records are
    /// written: a reader answering a KeyUpdate while a write waits on
    /// the socket would otherwise put its records inside that write's.
    wl: Mutex<i32>;
}

impl Shared {
    const fn new(c: Conn) -> Shared {
        unsafe {
            let b: GcBuf<Conn> = buf_new(1);
            b[0] = c;
            Shared { c: b, wl: Mutex::new_unshared(0) }
        }
    }

    const fn check(self) throws (IoError) {
        unsafe {
            match self.c[0].failed {
                m: str => throw IoError::new(IoErrorKind::InvalidData, f"tls: connection failed: {m}"),
                none => {},
            }
        }
    }

    fn read(self, buf: SliceMut<u8>) throws (IoError) -> usize {
        try self.check();
        unsafe {
            let c = self.c[0];
            let r = try c.read_app(buf) catch e {
                c.fail(e);
                self.c[0] = c;
                throw io_err(e);
            };
            self.c[0] = c;
            r
        }
    }

    fn read_to_end(self) throws (IoError) -> List<u8> {
        let out: List<u8> = [];
        let buf = byte_buf(16384);
        loop {
            let n = try self.read(buf);
            if n == 0 { return out; }
            for i in 0..n { out.push(buf[i]); }
        }
    }

    fn write(self, data: Slice<u8>) throws (IoError) {
        try self.check();
        unsafe {
            let c = self.c[0];
            try c.write_app(data) catch e {
                c.fail(e);
                self.c[0] = c;
                throw io_err(e);
            };
            self.c[0] = c;
        }
    }

    fn close_notify(self) throws (IoError) {
        try self.check();
        unsafe {
            let c = self.c[0];
            try c.close_notify() catch e {
                self.c[0] = c;
                throw io_err(e);
            };
            self.c[0] = c;
        }
    }

    fn key_update(self) throws (IoError) {
        try self.check();
        unsafe {
            let c = self.c[0];
            try c.key_update(true) catch e {
                c.fail(e);
                self.c[0] = c;
                throw io_err(e);
            };
            self.c[0] = c;
        }
    }

    /// close_notify (if the connection is healthy; its failure is not
    /// reported), then close the socket, throwing the OS's error. The
    /// keys are wiped either way.
    fn close(self) throws (IoError) {
        unsafe {
            let c = self.c[0];
            if c.failed is none && c.done { try c.close_notify() catch _ {}; }
            let err: IoError | none = none;
            try c.sock().close() catch e { err = e; };
            c.wipe();
            self.c[0] = c;
            if let e: IoError = err { throw e; }
        }
    }

    const fn conn(self) -> Conn { unsafe { self.c[0] } }

    /// Run `op` (`Conn::step`) without blocking: the connection's
    /// records are written and more input read asynchronously until the
    /// operation completes. A failure sends its alert first.
    async fn pump(self, op: u8, buf: SliceMut<u8>, data: Slice<u8>) throws (TlsError) -> usize {
        loop {
            let c = unsafe { self.c[0] };
            let failure: TlsError | none = none;
            let r: usize | none = none;
            using g = await self.wl.lock_async() {
                c = unsafe { self.c[0] };
                match c.failed {
                    m: str => failure = TlsError { kind: TlsErrorKind::Protocol, msg: f"connection failed: {m}", alert: 0u8 },
                    none => {
                        c.nb = true;
                        c.need = false;
                        r = try c.step(op, buf, data) catch e {
                            if !c.need {
                                c.fail(e);
                                failure = e;
                            }
                            none
                        };
                        c.nb = false;
                        let out = c.out;
                        c.out = [];
                        unsafe { self.c[0] = c; }
                        if out.len() > 0 {
                            let werr: TlsError | none = none;
                            try await c.sock().write_all_async(out) catch e { werr = io_tls(e); };
                            if let e: TlsError = werr {
                                if failure is none {
                                    unsafe {
                                        let cur = self.c[0];
                                        cur.fail(e);
                                        self.c[0] = cur;
                                    }
                                    failure = e;
                                }
                            }
                        }
                    },
                }
            }
            match failure {
                e: TlsError => throw e,
                none => {},
            }
            match r {
                n: usize => return n,
                none => {},
            }
            // More input.
            let b = byte_buf(16384 + 2048);
            let n = try await c.sock().read_async(b) catch e {
                let t = io_tls(e);
                unsafe {
                    let cur = self.c[0];
                    cur.fail(t);
                    self.c[0] = cur;
                }
                throw t;
            };
            unsafe {
                let cur = self.c[0];
                cur.feed(b[0:n]);
                self.c[0] = cur;
            }
        }
    }

    async fn op_async(self, op: u8, buf: SliceMut<u8>, data: Slice<u8>) throws (IoError) -> usize {
        try self.check();
        try await self.pump(op, buf, data) catch e { throw io_err(e); }
    }

    async fn read_async(self, buf: SliceMut<u8>) throws (IoError) -> usize { try await self.op_async(OP_READ, buf, nothing()) }

    async fn read_to_end_async(self) throws (IoError) -> List<u8> {
        let out: List<u8> = [];
        let buf = byte_buf(16384);
        loop {
            let n = try await self.read_async(buf);
            if n == 0 { return out; }
            for i in 0..n { out.push(buf[i]); }
        }
    }
}

/// The read buffer of an operation that reads nothing.
const fn no_buf() -> SliceMut<u8> {
    let e: List<u8> = [];
    e
}

/// A configured client key must belong to the client certificate.
/// How long a failed handshake waits for the peer's remaining input.
const LINGER: Duration = Duration::secs(1);

/// Close after a fatal alert: half-close, read what the peer still
/// sends (for at most `LINGER`), then close. Closing with unread input
/// would reset the connection and could destroy the alert in flight.
fn linger_close(s: TcpStream) {
    try s.shutdown(Shutdown::Write) catch _ {};
    let start = Instant::now();
    let buf = byte_buf(16384);
    loop {
        let left = LINGER.as_ns() - start.elapsed().as_ns();
        if left <= 0 { break; }
        try s.set_read_timeout(Duration::ns(left)) catch _ { break; };
        let n = try s.read(buf) catch _ { break; };
        if n == 0 { break; }
    }
    try s.close() catch _ {};
}

async fn drain_async(s: TcpStream) -> i32 {
    let buf = byte_buf(16384);
    loop {
        let n = try await s.read_async(buf) catch _ { return 0; };
        if n == 0 { return 0; }
    }
}

/// `linger_close` without blocking the worker.
async fn linger_close_async(s: TcpStream) {
    try s.shutdown(Shutdown::Write) catch _ {};
    let _ = try await task::timeout(LINGER, task::spawn(drain_async(s))) catch _ { 0 };
    try s.close() catch _ {};
}

fn check_client_key(cfg: ClientConfig) throws (TlsError) {
    if let k: PrivateKey = cfg.client_key {
        if cfg.client_cert_chain.len() == 0 || !k.matches(cfg.client_cert_chain[0]) {
            throw TlsError::certificate("client key does not match the client certificate");
        }
    }
}

/// An empty view, for operations without data.
const fn nothing() -> Slice<u8> {
    let e: List<u8> = [];
    e[0:0]
}

/// A TLS client connection. Copies share the connection.
pub struct Client {
    s: Shared;
}

impl !Sync for Client {}

impl Client {
    /// Handshake as `server_name` trusting the OS store; throws when the
    /// store cannot be read (`ClientConfig::new`).
    pub fn new(stream: TcpStream, server_name: str) throws (TlsError) -> Client {
        let cfg = try ClientConfig::new() catch e {
            try stream.close() catch _ {};
            throw e;
        };
        try Client::with_config(stream, server_name, cfg)
    }

    /// Handshake as `server_name` (a DNS name, or an IP address checked
    /// against the certificate's IP addresses; no SNI is sent for one).
    pub fn with_config(stream: TcpStream, server_name: str, cfg: ClientConfig) throws (TlsError) -> Client {
        try check_client_key(cfg) catch e {
            try stream.close() catch _ {};
            throw e;
        };
        let c = new_conn(stream, true);
        try c.client_start(server_name, ip_bytes(server_name), cfg) catch e {
            c.fail(e);
            linger_close(c.sock());
            throw e;
        };
        try c.handshake() catch e {
            c.fail(e);
            linger_close(c.sock());
            throw e;
        };
        Client { s: Shared::new(c) }
    }

    /// `new` without blocking the worker.
    pub async fn new_async(stream: TcpStream, server_name: str) throws (TlsError) -> Client {
        let cfg = try ClientConfig::new() catch e {
            try stream.close() catch _ {};
            throw e;
        };
        try await Client::with_config_async(stream, server_name, cfg)
    }

    /// `with_config` without blocking the worker.
    pub async fn with_config_async(stream: TcpStream, server_name: str, cfg: ClientConfig) throws (TlsError) -> Client {
        try check_client_key(cfg) catch e {
            try stream.close() catch _ {};
            throw e;
        };
        let c = new_conn(stream, true);
        c.nb = true;
        try c.client_start(server_name, ip_bytes(server_name), cfg) catch e {
            c.fail(e);
            linger_close(c.sock());
            throw e;
        };
        let s = Shared::new(c);
        let failed: TlsError | none = none;
        try await s.pump(OP_HANDSHAKE, no_buf(), nothing()) catch e {
            failed = e;
            0
        };
        if let e: TlsError = failed {
            await linger_close_async(s.conn().sock());
            throw e;
        }
        Client { s }
    }

    /// Tell the server no more data follows (the read side stays open).
    pub fn close_notify(self) throws (IoError) { try self.s.close_notify(); }

    /// Switch to the next write key and ask the peer to do the same.
    pub fn key_update(self) throws (IoError) { try self.s.key_update(); }

    pub async fn close_notify_async(self) throws (IoError) { _ = try await self.s.op_async(OP_CLOSE_NOTIFY, no_buf(), nothing()); }
    pub async fn key_update_async(self) throws (IoError) { _ = try await self.s.op_async(OP_KEY_UPDATE, no_buf(), nothing()); }

    /// close_notify (if the connection is healthy), then close the
    /// socket, throwing the OS's error.
    pub fn close(self) throws (IoError) { try self.s.close(); }

    pub const fn negotiated_alpn(self) -> List<u8> | none { self.s.conn().alpn }

    /// The server's certificate chain as sent, leaf first (on a resumed
    /// connection, the original connection's).
    pub const fn peer_certificates(self) -> List<Certificate> { self.s.conn().peer }

    /// Whether the handshake resumed a session.
    pub const fn is_resumed(self) -> bool { self.s.conn().resumed }

    /// Whether the server took `ClientConfig::early_data` as 0-RTT data
    /// (else it was sent after the handshake).
    pub const fn is_early_data_accepted(self) -> bool { self.s.conn().early_accepted }
}

impl Read for Client {
    /// Up to `buf.len()` bytes of application data; 0 once the peer sent
    /// close_notify.
    fn read(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try self.s.read(buf) }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.s.read_to_end() }
}

impl Write for Client {
    /// Writes all of `buf`: TLS records are written whole.
    fn write<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        let b = buf.byte_slice();
        try self.s.write(b);
        b.len()
    }
    /// Nothing to flush: records go straight to the socket.
    const fn flush(ref self) throws (IoError) {}
    fn write_all<B: AsBytes>(ref self, buf: B) throws (IoError) { try self.s.write(buf.byte_slice()); }
}

impl AsyncRead for Client {
    async fn read_async(self, buf: SliceMut<u8>) throws (IoError) -> usize { try await self.s.read_async(buf) }
    async fn read_to_end_async(self) throws (IoError) -> List<u8> { try await self.s.read_to_end_async() }
}

impl AsyncWrite for Client {
    async fn write_async<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        let b = buf.byte_slice();
        _ = try await self.s.op_async(OP_WRITE, no_buf(), b);
        b.len()
    }
    async fn flush_async(self) throws (IoError) {}
    async fn write_all_async<B: AsBytes>(self, buf: B) throws (IoError) {
        _ = try await self.s.op_async(OP_WRITE, no_buf(), buf.byte_slice());
    }
}

impl Close for Client {
    fn close(self) throws (IoError) { try self.s.close(); }
}

impl Drop for Client {
    fn drop(ref self) { try self.s.close() catch _ {}; }
}

/// A TLS server connection. Copies share the connection.
pub struct Server {
    s: Shared;
}

impl !Sync for Server {}

impl Server {
    /// Handshake with the client on `stream`.
    pub fn new(stream: TcpStream, cfg: ServerConfig) throws (TlsError) -> Server {
        try check_server_config(cfg) catch e {
            try stream.close() catch _ {};
            throw e;
        };
        let c = new_conn(stream, false);
        c.server_start(cfg);
        try c.handshake() catch e {
            c.fail(e);
            linger_close(c.sock());
            throw e;
        };
        Server { s: Shared::new(c) }
    }

    /// `new` without blocking the worker.
    pub async fn new_async(stream: TcpStream, cfg: ServerConfig) throws (TlsError) -> Server {
        try check_server_config(cfg) catch e {
            try stream.close() catch _ {};
            throw e;
        };
        let c = new_conn(stream, false);
        c.server_start(cfg);
        let s = Shared::new(c);
        let failed: TlsError | none = none;
        try await s.pump(OP_HANDSHAKE, no_buf(), nothing()) catch e {
            failed = e;
            0
        };
        if let e: TlsError = failed {
            await linger_close_async(s.conn().sock());
            throw e;
        }
        Server { s }
    }

    pub fn close_notify(self) throws (IoError) { try self.s.close_notify(); }
    pub fn key_update(self) throws (IoError) { try self.s.key_update(); }

    pub async fn close_notify_async(self) throws (IoError) { _ = try await self.s.op_async(OP_CLOSE_NOTIFY, no_buf(), nothing()); }
    pub async fn key_update_async(self) throws (IoError) { _ = try await self.s.op_async(OP_KEY_UPDATE, no_buf(), nothing()); }
    /// close_notify (if the connection is healthy), then close the
    /// socket, throwing the OS's error.
    pub fn close(self) throws (IoError) { try self.s.close(); }
    pub const fn negotiated_alpn(self) -> List<u8> | none { self.s.conn().alpn }

    /// The client's validated certificate chain, leaf first (empty: it
    /// sent none; on a resumed connection, the original connection's).
    pub const fn peer_certificates(self) -> List<Certificate> { self.s.conn().peer }

    /// Whether the handshake resumed a session.
    pub const fn is_resumed(self) -> bool { self.s.conn().resumed }

    /// The 0-RTT data accepted from the client (empty: none); `read`
    /// returns what follows it.
    pub const fn early_data(self) -> List<u8> { self.s.conn().early }

    /// The server name the client asked for (SNI).
    pub const fn server_name(self) -> str | none { self.s.conn().sni }
}

impl Read for Server {
    /// Up to `buf.len()` bytes of application data; 0 once the peer sent
    /// close_notify.
    fn read(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try self.s.read(buf) }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.s.read_to_end() }
}

impl Write for Server {
    /// Writes all of `buf`: TLS records are written whole.
    fn write<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        let b = buf.byte_slice();
        try self.s.write(b);
        b.len()
    }
    /// Nothing to flush: records go straight to the socket.
    const fn flush(ref self) throws (IoError) {}
    fn write_all<B: AsBytes>(ref self, buf: B) throws (IoError) { try self.s.write(buf.byte_slice()); }
}

impl AsyncRead for Server {
    async fn read_async(self, buf: SliceMut<u8>) throws (IoError) -> usize { try await self.s.read_async(buf) }
    async fn read_to_end_async(self) throws (IoError) -> List<u8> { try await self.s.read_to_end_async() }
}

impl AsyncWrite for Server {
    async fn write_async<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        let b = buf.byte_slice();
        _ = try await self.s.op_async(OP_WRITE, no_buf(), b);
        b.len()
    }
    async fn flush_async(self) throws (IoError) {}
    async fn write_all_async<B: AsBytes>(self, buf: B) throws (IoError) {
        _ = try await self.s.op_async(OP_WRITE, no_buf(), buf.byte_slice());
    }
}

impl Close for Server {
    fn close(self) throws (IoError) { try self.s.close(); }
}

impl Drop for Server {
    fn drop(ref self) { try self.s.close() catch _ {}; }
}

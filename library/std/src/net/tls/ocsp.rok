// OCSP responses (RFC 6960) stapled to a server's certificate (RFC 6066
// status_request): the response must be a successful basic response,
// signed by the leaf's issuer or by a responder certificate the issuer
// issued for OCSPSigning, current, and say "good" for the leaf.

use sup::{TlsError, TlsErrorKind};
use sup::der::{Der, SEQUENCE, INTEGER, BIT_STRING, OCTET_STRING, NULL, OID, GENERALIZED_TIME};
use sup::der;
use sup::x509;
use sup::x509::CertInfo;
use rok::core::crypto::HashAlgorithm;
use rok::core::crypto::constant_time_eq;

const OID_BASIC: str = "1.3.6.1.5.5.7.48.1.1";
const OID_SHA1: str = "1.3.14.3.2.26";
const EKU_OCSP_SIGNING: str = "1.3.6.1.5.5.7.3.9";

const ALERT_CERTIFICATE_REVOKED: u8 = 44u8;
pub(pkg) const ALERT_BAD_CERTIFICATE_STATUS: u8 = 113u8;

/// Clock skew allowed on thisUpdate, seconds.
const SKEW: i64 = 300i64;

const fn bad(msg: str) -> TlsError {
    TlsError { kind: TlsErrorKind::Certificate, msg: f"OCSP response: {msg}", alert: ALERT_BAD_CERTIFICATE_STATUS }
}

/// Check the DER OCSPResponse `resp` for `leaf`, issued by `issuer`, at
/// Unix time `now`.
pub(pkg) fn check(resp: Slice<u8>, leaf: CertInfo, issuer: CertInfo, now: i64) throws (TlsError) {
    try check_der(resp, leaf, issuer, now) catch e {
        if e.alert == ALERT_BAD_CERTIFICATE_STATUS || e.alert == ALERT_CERTIFICATE_REVOKED { throw e; }
        throw bad(e.msg);
    };
}

fn check_der(resp: Slice<u8>, leaf: CertInfo, issuer: CertInfo, now: i64) throws (TlsError) {
    let top = Der::new(resp);
    let r = try top.enter(SEQUENCE);
    try top.finish();
    let status = try r.expect(0x0au8);
    if status.len() != 1 || status[0] != 0u8 { throw bad("not successful"); }
    let rb = try Der::new(try r.expect(0xa0u8)).enter(SEQUENCE);
    try r.finish();
    if (try der::oid_text(try rb.expect(OID))) != OID_BASIC { throw bad("not a basic response"); }
    let basic = try Der::new(try rb.expect(OCTET_STRING)).enter(SEQUENCE);
    try rb.finish();
    let (ttag, tbody, tall) = try basic.next();
    if ttag != SEQUENCE { throw bad("malformed"); }
    let alg = try x509::sig_alg(try basic.expect(SEQUENCE));
    let sig = try der::bit_string_bytes(try basic.expect(BIT_STRING));
    let certs: List<CertInfo> = [];
    if let c0: Slice<u8> = try basic.optional(0xa0u8) {
        let l = try Der::new(c0).enter(SEQUENCE);
        while !l.done() {
            let (_, _, whole) = try l.next();
            certs.push(try x509::parse(whole));
        }
    }
    try basic.finish();

    // The signer: the issuer, or a responder it delegated to.
    let signed = x509::verify_sig(issuer.key, alg, tall, sig);
    for c in certs {
        if !signed && c.issuer == issuer.subject && delegated(c, issuer, now) && x509::verify_sig(c.key, alg, tall, sig) { signed = true; }
    }
    if !signed { throw bad("bad signature"); }

    let d = Der::new(tbody);
    if let v: Slice<u8> = try d.optional(0xa0u8) {
        if (try der::small_int(try Der::new(v).expect(INTEGER))) != 0 { throw bad("unsupported version"); }
    }
    let (rid, _, _) = try d.next();
    if rid != 0xa1u8 && rid != 0xa2u8 { throw bad("malformed responderID"); }
    let _ = try d.expect(GENERALIZED_TIME);
    let list = try d.enter(SEQUENCE);
    let _ = try d.optional(0xa1u8);
    try d.finish();
    while !list.done() {
        let sr = try list.enter(SEQUENCE);
        if !(try matches(try sr.expect(SEQUENCE), leaf, issuer)) { continue; }
        let (st, _, _) = try sr.next();
        let this_update = try der::time(GENERALIZED_TIME, try sr.expect(GENERALIZED_TIME));
        let next_update: i64 | none = none;
        if let nu: Slice<u8> = try sr.optional(0xa0u8) { next_update = try der::time(GENERALIZED_TIME, try Der::new(nu).expect(GENERALIZED_TIME)); }
        let _ = try sr.optional(0xa1u8);
        try sr.finish();
        if this_update > now + SKEW { throw bad("not yet valid"); }
        // Without nextUpdate a response has no end: refused.
        match next_update {
            n: i64 => {
                if now > n { throw bad("expired"); }
            },
            none => throw bad("no nextUpdate"),
        }
        if st == 0xa1u8 { throw TlsError { kind: TlsErrorKind::Certificate, msg: "certificate revoked", alert: ALERT_CERTIFICATE_REVOKED }; }
        if st != 0x80u8 { throw bad("certificate status unknown"); }
        return;
    }
    throw bad("no status for the certificate");
}

/// Whether responder certificate `c` was issued by `issuer` for OCSP
/// signing and is valid now.
fn delegated(c: CertInfo, issuer: CertInfo, now: i64) -> bool {
    let eku_ok = match c.eku {
        l: List<str> => l.contains(EKU_OCSP_SIGNING),
        none => false,
    };
    eku_ok && now >= c.not_before && now <= c.not_after && x509::verify_sig(issuer.key, c.sig_alg, c.tbs, c.signature)
}

/// Whether CertID `b` names `leaf` from `issuer`.
fn matches(b: Slice<u8>, leaf: CertInfo, issuer: CertInfo) throws (TlsError) -> bool {
    let d = Der::new(b);
    let a = try d.enter(SEQUENCE);
    let oid = try der::oid_text(try a.expect(OID));
    let _ = try a.optional(NULL);
    try a.finish();
    let name_hash = try d.expect(OCTET_STRING);
    let key_hash = try d.expect(OCTET_STRING);
    let serial = try d.expect(INTEGER);
    try d.finish();
    if !(serial == leaf.serial) { return false; }
    let h = if oid == OID_SHA1 {
        (sha1(issuer.subject), sha1(issuer.spk))
    } else if oid == "2.16.840.1.101.3.4.2.1" {
        (HashAlgorithm::Sha256.digest(issuer.subject), HashAlgorithm::Sha256.digest(issuer.spk))
    } else if oid == "2.16.840.1.101.3.4.2.2" {
        (HashAlgorithm::Sha384.digest(issuer.subject), HashAlgorithm::Sha384.digest(issuer.spk))
    } else if oid == "2.16.840.1.101.3.4.2.3" {
        (HashAlgorithm::Sha512.digest(issuer.subject), HashAlgorithm::Sha512.digest(issuer.spk))
    } else {
        return false;
    };
    let (nh, kh) = h;
    constant_time_eq(nh, name_hash) && constant_time_eq(kh, key_hash)
}

/// SHA-1 (FIPS 180-4), only to match CertIDs, which commonly use it.
const fn sha1(data: Slice<u8>) -> List<u8> {
    let m = data.to_list();
    let bits = (data.len() as u64) * 8u64;
    m.push(0x80u8);
    while m.len() % 64 != 56 { m.push(0u8); }
    for i in 0..8 { m.push((bits >> (56 - 8 * i) as u64) as u8); }
    let hs: [u32; 5] = [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32, 0xc3d2e1f0u32];
    let w: [u32; 80] = [0u32; 80];
    let at = 0usize;
    while at < m.len() {
        for i in 0usize..16 {
            w[i] = ((m[at + 4 * i] as u32) << 24) | ((m[at + 4 * i + 1] as u32) << 16) | ((m[at + 4 * i + 2] as u32) << 8) | (m[at + 4 * i + 3] as u32);
        }
        for i in 16..80 { w[i] = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotate_left(1); }
        let a = hs[0];
        let b = hs[1];
        let c = hs[2];
        let d = hs[3];
        let e = hs[4];
        for i in 0..80 {
            let f = 0u32;
            let k = 0u32;
            if i < 20 {
                f = (b & c) | (~b & d);
                k = 0x5a827999u32;
            } else if i < 40 {
                f = b ^ c ^ d;
                k = 0x6ed9eba1u32;
            } else if i < 60 {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8f1bbcdcu32;
            } else {
                f = b ^ c ^ d;
                k = 0xca62c1d6u32;
            }
            let t = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[i]);
            e = d;
            d = c;
            c = b.rotate_left(30);
            b = a;
            a = t;
        }
        hs[0] = hs[0].wrapping_add(a);
        hs[1] = hs[1].wrapping_add(b);
        hs[2] = hs[2].wrapping_add(c);
        hs[3] = hs[3].wrapping_add(d);
        hs[4] = hs[4].wrapping_add(e);
        at += 64;
    }
    let out: List<u8> = [];
    for x in hs {
        out.push((x >> 24) as u8);
        out.push((x >> 16) as u8);
        out.push((x >> 8) as u8);
        out.push(x as u8);
    }
    out
}

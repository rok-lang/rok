// The TLS 1.3 engine (RFC 8446): record layer, key schedule and the
// client and server handshakes over a `TcpStream`. The handshake is a
// state machine fed one peer message at a time, so a caller that does
// not block (`nb`, the `*_async` methods) can stop when input runs out
// and resume when more arrived.
//
// Supported: the three TLS 1.3 cipher suites, X25519 and the
// X25519MLKEM768 hybrid, HelloRetryRequest (both sides), ALPN, SNI,
// KeyUpdate, close_notify, certificate authentication of the server and
// optionally the client with the signature schemes `x509` verifies
// (signing with Ed25519, ECDSA P-256 / P-384 or RSA-PSS), stapled OCSP,
// resumption from tickets with psk_dhe_ke and 0-RTT data. Not
// supported: psk_ke, external PSKs, post-handshake client
// authentication, TLS 1.2 and below.

use sup::{TlsError, TlsErrorKind, Certificate, CipherSuite, PrivateKey, KeyKind};
use sup::{ClientConfig, ServerConfig, SessionCache, TicketStore, Ticket, Session, TICKET_LIFETIME};
use sup::x509;
use sup::ocsp;
use sup::x509::{CertInfo, PubKey, SigAlg};
use rok::std::net::TcpStream;
use rok::std::io::{IoError, IoErrorKind, byte_buf};
use rok::std::crypto::random;
use rok::std::time::{SystemTime, Instant};
use rok::core::crypto::sha2::{HashAlgorithm, Digest};
use rok::core::crypto::hmac::Hmac;
use rok::core::crypto::hkdf;
use rok::core::crypto::aead::{Aead, AeadAlgorithm};
use rok::core::crypto::{x25519, mlkem};
use rok::core::crypto::mlkem::EncapsulationKey768;
use rok::core::crypto::ecdsa::EcCurve;
use rok::core::crypto::{constant_time_eq, Secret};

// Content types.
const CHANGE_CIPHER_SPEC: u8 = 20u8;
const ALERT: u8 = 21u8;
const HANDSHAKE: u8 = 22u8;
const APPLICATION_DATA: u8 = 23u8;

// Handshake message types.
const CLIENT_HELLO: u8 = 1u8;
const SERVER_HELLO: u8 = 2u8;
const NEW_SESSION_TICKET: u8 = 4u8;
const END_OF_EARLY_DATA: u8 = 5u8;
const ENCRYPTED_EXTENSIONS: u8 = 8u8;
const CERTIFICATE: u8 = 11u8;
const CERTIFICATE_REQUEST: u8 = 13u8;
const CERTIFICATE_VERIFY: u8 = 15u8;
const FINISHED: u8 = 20u8;
const KEY_UPDATE: u8 = 24u8;
const MESSAGE_HASH: u8 = 254u8;

// Extensions.
const EXT_SERVER_NAME: u16 = 0u16;
const EXT_STATUS_REQUEST: u16 = 5u16;
const EXT_SUPPORTED_GROUPS: u16 = 10u16;
const EXT_SIGNATURE_ALGORITHMS: u16 = 13u16;
const EXT_ALPN: u16 = 16u16;
const EXT_PRE_SHARED_KEY: u16 = 41u16;
const EXT_EARLY_DATA: u16 = 42u16;
const EXT_SUPPORTED_VERSIONS: u16 = 43u16;
const EXT_COOKIE: u16 = 44u16;
const EXT_PSK_MODES: u16 = 45u16;
const EXT_KEY_SHARE: u16 = 51u16;

// Named groups.
const X25519_GROUP: u16 = 0x001du16;
const HYBRID_GROUP: u16 = 0x11ecu16;

// Signature schemes.
const ECDSA_P256_SHA256: u16 = 0x0403u16;
const ECDSA_P384_SHA384: u16 = 0x0503u16;
const RSA_PSS_SHA256: u16 = 0x0804u16;
const RSA_PSS_SHA384: u16 = 0x0805u16;
const RSA_PSS_SHA512: u16 = 0x0806u16;
const ED25519_SCHEME: u16 = 0x0807u16;
const RSA_PSS_PSS_SHA256: u16 = 0x0809u16;
const RSA_PSS_PSS_SHA384: u16 = 0x080au16;
const RSA_PSS_PSS_SHA512: u16 = 0x080bu16;
const RSA_PKCS1_SHA256: u16 = 0x0401u16;
const RSA_PKCS1_SHA384: u16 = 0x0501u16;
const RSA_PKCS1_SHA512: u16 = 0x0601u16;

// Alerts.
pub(pkg) const ALERT_CLOSE_NOTIFY: u8 = 0u8;
pub(pkg) const ALERT_UNEXPECTED_MESSAGE: u8 = 10u8;
pub(pkg) const ALERT_BAD_RECORD_MAC: u8 = 20u8;
pub(pkg) const ALERT_RECORD_OVERFLOW: u8 = 22u8;
pub(pkg) const ALERT_HANDSHAKE_FAILURE: u8 = 40u8;
pub(pkg) const ALERT_BAD_CERTIFICATE: u8 = 42u8;
pub(pkg) const ALERT_CERTIFICATE_UNKNOWN: u8 = 46u8;
pub(pkg) const ALERT_ILLEGAL_PARAMETER: u8 = 47u8;
pub(pkg) const ALERT_DECODE_ERROR: u8 = 50u8;
pub(pkg) const ALERT_DECRYPT_ERROR: u8 = 51u8;
pub(pkg) const ALERT_PROTOCOL_VERSION: u8 = 70u8;
pub(pkg) const ALERT_INTERNAL_ERROR: u8 = 80u8;
pub(pkg) const ALERT_MISSING_EXTENSION: u8 = 109u8;
pub(pkg) const ALERT_UNSUPPORTED_EXTENSION: u8 = 110u8;
pub(pkg) const ALERT_CERTIFICATE_REQUIRED: u8 = 116u8;
pub(pkg) const ALERT_NO_APPLICATION_PROTOCOL: u8 = 120u8;

/// SHA-256("HelloRetryRequest"): a ServerHello random marking an HRR.
const HRR_RANDOM: [u8; 32] = [
    0xcfu8, 0x21u8, 0xadu8, 0x74u8, 0xe5u8, 0x9au8, 0x61u8, 0x11u8, 0xbeu8, 0x1du8, 0x8cu8, 0x02u8, 0x1eu8, 0x65u8, 0xb8u8, 0x91u8,
    0xc2u8, 0xa2u8, 0x11u8, 0x16u8, 0x7au8, 0xbbu8, 0x8cu8, 0x5eu8, 0x07u8, 0x9eu8, 0x09u8, 0xe2u8, 0xc8u8, 0xa8u8, 0x33u8, 0x9cu8,
];

const MAX_PLAINTEXT: usize = 16384;

// `Conn::step` operations.
pub(pkg) const OP_HANDSHAKE: u8 = 1u8;
pub(pkg) const OP_READ: u8 = 2u8;
pub(pkg) const OP_WRITE: u8 = 3u8;
pub(pkg) const OP_CLOSE_NOTIFY: u8 = 4u8;
pub(pkg) const OP_KEY_UPDATE: u8 = 5u8;
/// The signature schemes accepted from a peer (PKCS #1 only in
/// certificates).
const fn sig_schemes() -> List<u16> {
    [ED25519_SCHEME, ECDSA_P256_SHA256, ECDSA_P384_SHA384, RSA_PSS_SHA256, RSA_PSS_SHA384, RSA_PSS_SHA512,
        RSA_PSS_PSS_SHA256, RSA_PSS_PSS_SHA384, RSA_PSS_PSS_SHA512, RSA_PKCS1_SHA256, RSA_PKCS1_SHA384, RSA_PKCS1_SHA512]
}

/// Ticket age disagreement tolerated for 0-RTT, ms (RFC 8446 8.3).
const AGE_TOLERANCE_MS: i64 = 10000i64;

/// Records written under one key before a KeyUpdate (AES-GCM's limit
/// is 2^24.5 full records).
const UPDATE_AFTER: u64 = 0x100_0000u64;

const fn proto(msg: str, alert: u8) -> TlsError {
    TlsError { kind: TlsErrorKind::Protocol, msg, alert }
}

const fn decode_err(what: str) -> TlsError { proto(f"malformed {what}", ALERT_DECODE_ERROR) }

const fn put_u16(out: List<u8>, v: usize) {
    out.push((v >> 8) as u8);
    out.push(v as u8);
}

const fn put_u32(out: List<u8>, v: u32) {
    out.push((v >> 24) as u8);
    out.push((v >> 16) as u8);
    out.push((v >> 8) as u8);
    out.push(v as u8);
}

const fn put_u24(out: List<u8>, v: usize) {
    out.push((v >> 16) as u8);
    out.push((v >> 8) as u8);
    out.push(v as u8);
}

const fn put(out: List<u8>, b: Slice<u8>) {
    for x in b { out.push(x); }
}

const fn put_list(out: List<u8>, b: List<u8>) {
    for x in b { out.push(x); }
}

const fn vec8(out: List<u8>, b: List<u8>) {
    out.push(b.len() as u8);
    put_list(out, b);
}

const fn vec16(out: List<u8>, b: List<u8>) {
    put_u16(out, b.len());
    put_list(out, b);
}

const fn ext(out: List<u8>, kind: u16, body: List<u8>) {
    put_u16(out, kind as usize);
    vec16(out, body);
}

/// A handshake message: type, 24-bit length, body.
const fn message(kind: u8, body: List<u8>) -> List<u8> {
    let m: List<u8> = List::with_capacity(body.len() + 4);
    m.push(kind);
    put_u24(m, body.len());
    put_list(m, body);
    m
}

/// A cursor over a received message.
struct Rd {
    s: Slice<u8>;
    pos: usize;
    what: str;
}

impl Rd {
    const fn new(s: Slice<u8>, what: str) -> Rd { Rd { s, pos: 0, what } }

    const fn left(self) -> usize { self.s.len() - self.pos }

    const fn bytes(ref self, n: usize) throws (TlsError) -> Slice<u8> {
        if self.left() < n { throw decode_err(self.what); }
        let b = self.s[self.pos:self.pos + n];
        self.pos += n;
        b
    }

    const fn u8(ref self) throws (TlsError) -> u8 { (try self.bytes(1))[0] }

    const fn u16(ref self) throws (TlsError) -> usize {
        let b = try self.bytes(2);
        ((b[0] as usize) << 8) | (b[1] as usize)
    }

    const fn u32(ref self) throws (TlsError) -> u32 {
        let b = try self.bytes(4);
        ((b[0] as u32) << 24) | ((b[1] as u32) << 16) | ((b[2] as u32) << 8) | (b[3] as u32)
    }

    const fn u24(ref self) throws (TlsError) -> usize {
        let b = try self.bytes(3);
        ((b[0] as usize) << 16) | ((b[1] as usize) << 8) | (b[2] as usize)
    }

    const fn vec8(ref self) throws (TlsError) -> Slice<u8> {
        let n = try self.u8();
        try self.bytes(n as usize)
    }

    const fn vec16(ref self) throws (TlsError) -> Slice<u8> {
        let n = try self.u16();
        try self.bytes(n)
    }

    const fn vec24(ref self) throws (TlsError) -> Slice<u8> {
        let n = try self.u24();
        try self.bytes(n)
    }

    const fn end(self) throws (TlsError) {
        if self.left() != 0 { throw decode_err(self.what); }
    }
}

/// `(type, body)` pairs of an extension block; a repeated type is an
/// error (RFC 8446 4.2).
const fn extensions(b: Slice<u8>, what: str) throws (TlsError) -> List<(usize, Slice<u8>)> {
    let r = Rd::new(b, what);
    let out: List<(usize, Slice<u8>)> = [];
    while r.left() > 0 {
        let t = try r.u16();
        let body = try r.vec16();
        for (u, _) in out {
            if u == t { throw proto(f"duplicate extension {t} in {what}", ALERT_ILLEGAL_PARAMETER); }
        }
        out.push((t, body));
    }
    out
}

/// An extension the peer may not send in `what` (RFC 8446 4.2: not
/// requested, or not allowed in that message).
const fn only_exts(exts: List<(usize, Slice<u8>)>, allowed: List<u16>, what: str) throws (TlsError) {
    for (t, _) in exts {
        if !allowed.contains(t as u16) { throw proto(f"unexpected extension {t} in {what}", ALERT_UNSUPPORTED_EXTENSION); }
    }
}

const fn find_ext(exts: List<(usize, Slice<u8>)>, t: u16) -> Slice<u8> | none {
    for (u, body) in exts {
        if u == t as usize { return body; }
    }
    none
}

// key schedule (RFC 8446 7.1)

pub(pkg) const fn suite_hash(s: CipherSuite) -> HashAlgorithm {
    match s {
        CipherSuite::Aes256GcmSha384 => HashAlgorithm::Sha384,
        _ => HashAlgorithm::Sha256,
    }
}

const fn suite_aead(s: CipherSuite) -> AeadAlgorithm {
    match s {
        CipherSuite::Aes128GcmSha256 => AeadAlgorithm::Aes128Gcm,
        CipherSuite::Aes256GcmSha384 => AeadAlgorithm::Aes256Gcm,
        CipherSuite::ChaCha20Poly1305Sha256 => AeadAlgorithm::ChaCha20Poly1305,
    }
}

fn expand_label(h: HashAlgorithm, secret: Secret, label: str, ctx: List<u8>, len: usize) -> Secret {
    let info: List<u8> = [];
    put_u16(info, len);
    let full = "tls13 " + label;
    info.push(full.len() as u8);
    put(info, full.as_bytes());
    vec8(info, ctx);
    // `len` is at most a hash length: within HKDF's limit.
    try hkdf::expand(h, secret, info, len) catch _ { Secret::zeroed(0) }
}

fn derive_secret(h: HashAlgorithm, secret: Secret, label: str, transcript: Digest) -> Secret {
    expand_label(h, secret, label, transcript.finish(), h.output_len())
}

const fn zeros(n: usize) -> List<u8> {
    let z: List<u8> = List::with_capacity(n);
    for _ in 0..n { z.push(0u8); }
    z
}

/// One direction of the record layer. It owns its traffic secret and
/// key; the IV is not secret (every record nonce derives from it).
struct Dir {
    aead: Aead | none;
    iv: List<u8>;
    seq: u64;
    secret: Secret;
}

fn plain_dir() -> Dir { Dir { aead: none, iv: [], seq: 0u64, secret: Secret::zeroed(0) } }

fn dir_of(suite: CipherSuite, secret: Secret) -> Dir {
    let h = suite_hash(suite);
    let alg = suite_aead(suite);
    let key = expand_label(h, secret, "key", [], alg.key_len());
    let iv = expand_label(h, secret, "iv", [], 12).as_bytes().to_list();
    // The key has the suite's length.
    let aead = try Aead::new(alg, key) catch _ { panic("AEAD key length") };
    key.wipe();
    Dir { aead, iv, seq: 0u64, secret: Secret::new(secret) }
}

impl Dir {
    fn wipe(self) {
        if let a: Aead = self.aead { a.wipe(); }
        self.secret.wipe();
    }
}

/// `a || b` as one secret.
fn joined(a: Secret, b: Secret) -> Secret {
    let s = Secret::zeroed(a.len() + b.len());
    for i in 0..a.len() { s[i] = a[i]; }
    for i in 0..b.len() { s[a.len() + i] = b[i]; }
    s
}

const fn nonce(d: Dir) -> List<u8> {
    let n: List<u8> = List::with_capacity(12);
    for i in 0..12 {
        let b = d.iv[i];
        if i >= 4 { b = b ^ ((d.seq >> (8 * (11 - i)) as u64) as u8); }
        n.push(b);
    }
    n
}

/// Connection state; `Client` / `Server` share one through a GC cell.
pub(pkg) struct Conn {
    pub(pkg) sock: TcpStream;
    pub(pkg) is_client: bool;
    rd: Dir;
    wr: Dir;
    /// Received bytes not yet made into records.
    inbuf: List<u8>;
    /// Handshake bytes not yet made into messages.
    hs: List<u8>;
    /// Decrypted application data not yet returned, from `plain_at`.
    plain: List<u8>;
    plain_at: usize;
    suite: CipherSuite;
    pub(pkg) alpn: List<u8> | none;
    pub(pkg) peer: List<Certificate>;
    pub(pkg) sni: str | none;
    pub(pkg) done: bool;
    /// close_notify received.
    eof: bool;
    /// close_notify sent.
    closed: bool;
    /// A fatal error ended the connection.
    pub(pkg) failed: str | none;
    /// The handshake in progress.
    x: Hs;
    /// Records not yet written: `send_record` writes them at once, or,
    /// without blocking (`nb`), leaves them to the caller.
    pub(pkg) out: List<u8>;
    /// Non-blocking: `fill` sets `need` and throws instead of reading.
    pub(pkg) nb: bool;
    pub(pkg) need: bool;
    /// The peer closed the socket (seen by a non-blocking caller).
    pub(pkg) rx_eof: bool;
    /// The handshake resumed a session.
    pub(pkg) resumed: bool;
    /// Client: the server accepted the 0-RTT data.
    pub(pkg) early_accepted: bool;
    /// Server: the 0-RTT data received.
    pub(pkg) early: List<u8>;
    /// Server: bytes of rejected 0-RTT records still to skip.
    skip_early: usize;
    /// Client: the server name, the ticket cache, the resumption
    /// master secret.
    host: str;
    cache: SessionCache | none;
    res_master: Secret;
}

pub(pkg) fn new_conn(sock: TcpStream, is_client: bool) -> Conn {
    Conn {
        sock,
        is_client,
        rd: plain_dir(),
        wr: plain_dir(),
        inbuf: [],
        hs: [],
        plain: [],
        plain_at: 0,
        suite: CipherSuite::Aes128GcmSha256,
        alpn: none,
        peer: [],
        sni: none,
        done: false,
        eof: false,
        closed: false,
        failed: none,
        x: new_hs(0u8),
        out: [],
        nb: false,
        need: false,
        rx_eof: false,
        resumed: false,
        early_accepted: false,
        early: [],
        skip_early: 0,
        host: "",
        cache: none,
        res_master: Secret::zeroed(0),
    }
}

const fn closed_early() -> TlsError {
    TlsError { kind: TlsErrorKind::Io, msg: "connection closed without close_notify", alert: ALERT_CLOSE_NOTIFY }
}

pub(pkg) const fn io_tls(e: IoError) -> TlsError {
    TlsError { kind: TlsErrorKind::Io, msg: e.message(), alert: ALERT_INTERNAL_ERROR }
}

impl Conn {

    /// Read more bytes from the socket into `inbuf`.
    fn fill(ref self) throws (TlsError) {
        if self.rx_eof { throw closed_early(); }
        if self.nb {
            self.need = true;
            throw TlsError { kind: TlsErrorKind::Io, msg: "would block", alert: ALERT_INTERNAL_ERROR };
        }
        let buf = byte_buf(MAX_PLAINTEXT + 2048);
        let s = self.sock;
        let n = try s.read(buf) catch e { throw io_tls(e); };
        if n == 0 { throw closed_early(); }
        let inb = self.inbuf;
        put(inb, buf[0:n]);
    }

    /// The next record: `(content type, plaintext)`. Plaintext-era
    /// ChangeCipherSpec records are dropped.
    fn record(ref self) throws (TlsError) -> (u8, List<u8>) {
        loop {
            while self.inbuf.len() < 5 { try self.fill(); }
            let typ = self.inbuf[0];
            let len = ((self.inbuf[3] as usize) << 8) | (self.inbuf[4] as usize);
            if self.inbuf[1] != 3u8 { throw proto("not a TLS record", ALERT_DECODE_ERROR); }
            if len > MAX_PLAINTEXT + 256 { throw proto("record too long", ALERT_RECORD_OVERFLOW); }
            while self.inbuf.len() < 5 + len { try self.fill(); }
            let header = self.inbuf[0:5].to_list();
            let body = self.inbuf[5:5 + len].to_list();
            self.inbuf = self.inbuf[5 + len:self.inbuf.len()].to_list();
            if typ == CHANGE_CIPHER_SPEC {
                // Middlebox compatibility (RFC 8446 5): one byte 0x01,
                // only before the handshake completes.
                if self.done || body.len() != 1 || body[0] != 1u8 {
                    throw proto("unexpected change_cipher_spec", ALERT_UNEXPECTED_MESSAGE);
                }
                continue;
            }
            match self.rd.aead {
                a: Aead => {
                    if typ != APPLICATION_DATA { throw proto("unencrypted record", ALERT_UNEXPECTED_MESSAGE); }
                    let d = self.rd;
                    let n = nonce(d);
                    let opened = try a.open(n, header, body) catch _ { none };
                    if opened is none && self.skip_early >= body.len() {
                        // Rejected 0-RTT data (RFC 8446 4.2.10).
                        self.skip_early -= body.len();
                        continue;
                    }
                    self.skip_early = 0;
                    self.rd.seq = self.rd.seq.wrapping_add(1u64);
                    match opened {
                        p: List<u8> => {
                            // TLSInnerPlaintext: content, type, zero padding.
                            let i = p.len();
                            while i > 0 && p[i - 1] == 0u8 { i -= 1; }
                            if i == 0 { throw proto("record without content type", ALERT_UNEXPECTED_MESSAGE); }
                            if i - 1 > MAX_PLAINTEXT { throw proto("record too long", ALERT_RECORD_OVERFLOW); }
                            let inner = p[i - 1];
                            let data = p[0:i - 1].to_list();
                            return (inner, data);
                        },
                        none => throw proto("bad record MAC", ALERT_BAD_RECORD_MAC),
                    }
                },
                none => {
                    if len > MAX_PLAINTEXT { throw proto("record too long", ALERT_RECORD_OVERFLOW); }
                    if typ == APPLICATION_DATA && self.skip_early >= body.len() {
                        // 0-RTT data before a second ClientHello.
                        self.skip_early -= body.len();
                        continue;
                    }
                    return (typ, body);
                },
            }
        }
    }

    /// Write one record of `typ` (encrypted once keys are set).
    fn send_record(ref self, typ: u8, data: Slice<u8>) throws (TlsError) {
        let out: List<u8> = [];
        // ChangeCipherSpec stays plaintext (RFC 8446 5).
        let enc: Aead | none = if typ == CHANGE_CIPHER_SPEC { none } else { self.wr.aead };
        match enc {
            a: Aead => {
                let inner = data.to_list();
                inner.push(typ);
                out.push(APPLICATION_DATA);
                out.push(3u8);
                out.push(3u8);
                put_u16(out, inner.len() + 16);
                let d = self.wr;
                let n = nonce(d);
                let ct = try a.seal(n, out, inner) catch _ { throw proto("AEAD failure", ALERT_INTERNAL_ERROR); };
                put_list(out, ct);
                self.wr.seq = self.wr.seq.wrapping_add(1u64);
            },
            none => {
                out.push(typ);
                out.push(3u8);
                // ClientHello's record version is 0x0301 for old middleboxes.
                out.push(if typ == HANDSHAKE && self.is_client { 1u8 } else { 3u8 });
                put_u16(out, data.len());
                put(out, data);
            },
        }
        put_list(self.out, out);
        if !self.nb { try self.flush_out(); }
    }

    /// Received bytes `b` (none: the peer closed the socket), for a
    /// caller that reads the socket itself.
    pub(pkg) const fn feed(ref self, b: Slice<u8>) {
        if b.len() == 0 {
            self.rx_eof = true;
        } else {
            let inb = self.inbuf;
            put(inb, b);
        }
    }

    /// Write `out` to the socket.
    fn flush_out(ref self) throws (TlsError) {
        let out = self.out;
        self.out = [];
        let s = self.sock;
        try s.write_all(out) catch e { throw io_tls(e); };
    }

    /// Write `data` as records of at most 16 KiB.
    fn send(ref self, typ: u8, data: List<u8>) throws (TlsError) {
        let at = 0usize;
        loop {
            let end = if data.len() - at > MAX_PLAINTEXT { at + MAX_PLAINTEXT } else { data.len() };
            try self.send_record(typ, data[at:end]);
            at = end;
            if at >= data.len() { return; }
        }
    }

    /// Send a fatal alert for `e` (best effort) and remember the failure.
    pub(pkg) fn fail(ref self, e: TlsError) {
        if self.failed is none {
            self.failed = e.msg;
            if e.kind != TlsErrorKind::PeerAlert && e.kind != TlsErrorKind::Io {
                try self.send_record(ALERT, [2u8, e.alert][0:2]) catch _ {};
            }
        }
    }

    /// An alert record: close_notify sets `eof`; anything else is fatal.
    const fn alert(ref self, data: List<u8>) throws (TlsError) {
        if data.len() != 2 { throw decode_err("alert"); }
        if data[1] == ALERT_CLOSE_NOTIFY {
            self.eof = true;
            return;
        }
        throw TlsError { kind: TlsErrorKind::PeerAlert, msg: f"peer sent alert {data[1]}", alert: data[1] };
    }

    /// The next handshake message `(type, body, whole message)`.
    fn message(ref self) throws (TlsError) -> (u8, List<u8>, List<u8>) {
        loop {
            if self.hs.len() >= 4 {
                let n = ((self.hs[1] as usize) << 16) | ((self.hs[2] as usize) << 8) | (self.hs[3] as usize);
                if n > 65536 { throw proto("handshake message too long", ALERT_DECODE_ERROR); }
                if self.hs.len() >= 4 + n {
                    let whole = self.hs[0:4 + n].to_list();
                    self.hs = self.hs[4 + n:self.hs.len()].to_list();
                    return (whole[0], whole[4:whole.len()].to_list(), whole);
                }
            }
            let (typ, data) = try self.record();
            if typ == ALERT {
                try self.alert(data);
                throw proto("connection closed during the handshake", ALERT_UNEXPECTED_MESSAGE);
            }
            if typ == APPLICATION_DATA && self.x.state == S_EARLY {
                if self.early.len() + data.len() > self.x.max_early as usize { throw proto("too much early data", ALERT_UNEXPECTED_MESSAGE); }
                let e = self.early;
                put_list(e, data);
                continue;
            }
            if typ != HANDSHAKE { throw proto("unexpected record during the handshake", ALERT_UNEXPECTED_MESSAGE); }
            if data.len() == 0 { throw decode_err("handshake record"); }
            let h = self.hs;
            put_list(h, data);
        }
    }

    /// The next message, which must be of type `want`.
    fn expect(ref self, want: u8, what: str) throws (TlsError) -> (List<u8>, List<u8>) {
        let (t, body, whole) = try self.message();
        if t != want { throw proto(f"expected {what}, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
        (body, whole)
    }

    /// Keys change only on a message boundary (RFC 8446 5.1).
    const fn boundary(self) throws (TlsError) {
        if self.hs.len() != 0 { throw proto("handshake message spans a key change", ALERT_UNEXPECTED_MESSAGE); }
    }

    /// Up to `buf.len()` bytes of application data into `buf`; 0 after
    /// close_notify.
    pub(pkg) fn read_app(ref self, buf: List<u8>) throws (TlsError) -> usize {
        while self.plain_at >= self.plain.len() {
            if self.eof { return 0; }
            let (typ, data) = try self.record();
            if typ == APPLICATION_DATA {
                self.plain = data;
                self.plain_at = 0;
            } else if typ == ALERT {
                try self.alert(data);
            } else if typ == HANDSHAKE {
                let h = self.hs;
                put_list(h, data);
                try self.post_handshake();
            } else {
                throw proto("unexpected record", ALERT_UNEXPECTED_MESSAGE);
            }
        }
        let n = buf.len();
        let left = self.plain.len() - self.plain_at;
        if left < n { n = left; }
        for i in 0..n { buf[i] = self.plain[self.plain_at + i]; }
        self.plain_at += n;
        n
    }

    /// Handle the complete post-handshake messages in `hs`.
    fn post_handshake(ref self) throws (TlsError) {
        while self.hs.len() >= 4 {
            let n = ((self.hs[1] as usize) << 16) | ((self.hs[2] as usize) << 8) | (self.hs[3] as usize);
            if n > 65536 { throw proto("handshake message too long", ALERT_DECODE_ERROR); }
            if self.hs.len() < 4 + n { return; }
            let (t, body, _) = try self.message();
            if t == KEY_UPDATE {
                if body.len() != 1 || body[0] > 1u8 { throw decode_err("KeyUpdate"); }
                try self.boundary();
                let next = self.next_secret(self.rd.secret);
                self.rd.wipe();
                self.rd = dir_of(self.suite, next);
                next.wipe();
                if body[0] == 1u8 { try self.key_update(false); }
            } else if t == NEW_SESSION_TICKET && self.is_client {
                try self.ticket(body);
            } else {
                throw proto(f"unexpected post-handshake message {t}", ALERT_UNEXPECTED_MESSAGE);
            }
        }
    }

    /// Keep a NewSessionTicket (RFC 8446 4.6.1) in the session cache.
    fn ticket(ref self, body: List<u8>) throws (TlsError) {
        let r = Rd::new(body[0:body.len()], "NewSessionTicket");
        let lifetime = try r.u32();
        let age_add = try r.u32();
        let nonce = (try r.vec8()).to_list();
        let id = (try r.vec16()).to_list();
        let exts = try extensions(try r.vec16(), "NewSessionTicket");
        try r.end();
        if id.len() == 0 { throw decode_err("NewSessionTicket"); }
        if lifetime > 604800u32 { throw proto("ticket lifetime over 7 days", ALERT_ILLEGAL_PARAMETER); }
        let max_early = 0u32;
        if let b: Slice<u8> = find_ext(exts, EXT_EARLY_DATA) {
            let er = Rd::new(b, "early_data");
            max_early = try er.u32();
            try er.end();
        }
        if lifetime == 0u32 { return; }
        if let c: SessionCache = self.cache {
            let h = suite_hash(self.suite);
            let psk = expand_label(h, self.res_master, "resumption", nonce, h.output_len());
            c.put(Ticket { host: self.host, suite: self.suite, ticket: id, psk, age_add, lifetime, received: Instant::now(), max_early, alpn: self.alpn, peer: self.peer });
        }
    }

    fn next_secret(self, secret: Secret) -> Secret {
        let h = suite_hash(self.suite);
        expand_label(h, secret, "traffic upd", [], h.output_len())
    }

    /// Send a KeyUpdate and switch to the next write key.
    pub(pkg) fn key_update(ref self, request: bool) throws (TlsError) {
        try self.send(HANDSHAKE, message(KEY_UPDATE, [if request { 1u8 } else { 0u8 }]));
        let next = self.next_secret(self.wr.secret);
        self.wr.wipe();
        self.wr = dir_of(self.suite, next);
        next.wipe();
    }

    /// Overwrite every secret the connection holds with zeros (at close).
    pub(pkg) fn wipe(ref self) {
        self.rd.wipe();
        self.wr.wipe();
        self.res_master.wipe();
        self.x.wipe();
    }

    pub(pkg) fn write_app(ref self, data: Slice<u8>) throws (TlsError) {
        if self.closed { throw proto("write after close_notify", ALERT_INTERNAL_ERROR); }
        let at = 0usize;
        while at < data.len() {
            if self.wr.seq >= UPDATE_AFTER { try self.key_update(false); }
            let end = if data.len() - at > MAX_PLAINTEXT { at + MAX_PLAINTEXT } else { data.len() };
            try self.send_record(APPLICATION_DATA, data[at:end]);
            at = end;
        }
    }

    /// `op` for a caller that does not block (`nb`): `need` set and an
    /// error thrown means more input is wanted, and the call is repeated
    /// once it arrived; records to send are left in `out`.
    pub(pkg) fn step(ref self, op: u8, buf: List<u8>, data: Slice<u8>) throws (TlsError) -> usize {
        if op == OP_HANDSHAKE {
            try self.handshake();
            return 0;
        }
        if op == OP_READ { return try self.read_app(buf); }
        if op == OP_WRITE {
            try self.write_app(data);
            return data.len();
        }
        if op == OP_CLOSE_NOTIFY {
            try self.close_notify();
            return 0;
        }
        try self.key_update(true);
        0
    }

    pub(pkg) fn close_notify(ref self) throws (TlsError) {
        if self.closed { return; }
        self.closed = true;
        try self.send_record(ALERT, [1u8, ALERT_CLOSE_NOTIFY][0:2]);
    }

    /// Run the handshake to completion, one peer message at a time
    /// (`client_on` / `server_on`). Without blocking (`nb`), it stops
    /// with `need` set when input runs out and resumes on the next call.
    pub(pkg) fn handshake(ref self) throws (TlsError) {
        while !self.done {
            let (t, body, all) = try self.message();
            if self.is_client { try self.client_on(t, body, all); } else { try self.server_on(t, body, all); }
        }
    }

    /// Send the ClientHello (and any 0-RTT data); `handshake` does the
    /// rest.
    pub(pkg) fn client_start(ref self, host: str, ip: List<u8> | none, cfg: ClientConfig) throws (TlsError) {
        if cfg.cipher_suites.len() == 0 { throw proto("no cipher suites configured", ALERT_INTERNAL_ERROR); }
        let x = new_hs(C_HELLO);
        x.host = host;
        x.ip = ip;
        x.roots = cfg.root_certs;
        x.suites = cfg.cipher_suites;
        x.alpn = cfg.alpn_protocols;
        x.chain = cfg.client_cert_chain;
        x.key = cfg.client_key;
        x.early_data = cfg.early_data;
        x.random32 = random::bytes(32);
        x.session_id = random::bytes(32);
        x.groups = if cfg.enable_pq { [HYBRID_GROUP, X25519_GROUP] } else { [X25519_GROUP] };
        // Key shares: the first group's (and X25519's, so a server
        // without the hybrid needs no HelloRetryRequest).
        x.shares = Shares::new(x.groups);
        self.host = host;
        self.cache = cfg.session_cache;
        if let c: SessionCache = cfg.session_cache { x.ticket = c.take(host, cfg.cipher_suites); }
        if let t: Ticket = x.ticket {
            let n = x.early_data.len();
            x.early_offered = n > 0 && n <= t.max_early as usize && cfg.cipher_suites.contains(t.suite);
        }
        x.ch = client_hello(x, none);
        if let t: Ticket = x.ticket { bind(x.ch, t, Digest::new(suite_hash(t.suite))); }
        self.x = x;
        try self.send(HANDSHAKE, x.ch);
        if x.early_offered {
            // 0-RTT under the ticket's suite (RFC 8446 4.2.10).
            let t: Ticket = x.ticket else { return; };
            try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]);
            x.ccs_sent = true;
            let h = suite_hash(t.suite);
            let tr = Digest::new(h);
            tr.update(x.ch);
            self.wr = dir_of(t.suite, derive_secret(h, hkdf::extract(h, "", t.psk), "c e traffic", tr));
            self.x = x;
            try self.write_app(x.early_data[0:x.early_data.len()]);
            self.x.early_dir = self.wr;
        }
    }

    /// The client's handling of the server message `(t, body, all)`.
    fn client_on(ref self, t: u8, body: List<u8>, all: List<u8>) throws (TlsError) {
        let x = self.x;
        let tr = x.transcript;
        if x.state == C_HELLO || x.state == C_HELLO2 {
            if t != SERVER_HELLO { throw proto(f"expected ServerHello, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            let hello = try parse_server_hello(body, x.session_id);
            let suite = try pick_offered(hello.suite, x.suites);
            let h = suite_hash(suite);
            let shares: Shares = x.shares else { throw proto("no key shares", ALERT_INTERNAL_ERROR); };
            if x.state == C_HELLO && hello.hrr {
                // HelloRetryRequest (RFC 8446 4.1.4): one retry with the
                // group the server asked for and / or its cookie, without
                // 0-RTT, and with the ticket only if its hash fits.
                let g = hello.group;
                if g != 0u16 {
                    if !x.groups.contains(g) || shares.has(g) { throw proto("HelloRetryRequest for an unusable group", ALERT_ILLEGAL_PARAMETER); }
                    shares.wipe();
                    shares = Shares::new([g]);
                    x.shares = shares;
                } else if hello.cookie is none {
                    throw proto("HelloRetryRequest that changes nothing", ALERT_ILLEGAL_PARAMETER);
                }
                if let tk: Ticket = x.ticket {
                    if suite_hash(tk.suite) != h { x.ticket = none; }
                }
                x.early_offered = false;
                self.wr = plain_dir();
                tr = Digest::new(h);
                tr.update(message(MESSAGE_HASH, h.digest(x.ch)));
                tr.update(all);
                x.ch = client_hello(x, hello.cookie);
                if let tk: Ticket = x.ticket { bind(x.ch, tk, tr); }
                tr.update(x.ch);
                x.transcript = tr;
                x.retried = true;
                x.state = C_HELLO2;
                self.suite = suite;
                let ccs = !x.ccs_sent;
                x.ccs_sent = true;
                self.x = x;
                if ccs { try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]); }
                try self.send(HANDSHAKE, x.ch);
                return;
            }
            if hello.hrr { throw proto("second HelloRetryRequest", ALERT_UNEXPECTED_MESSAGE); }
            if x.retried {
                if suite != self.suite { throw proto("cipher suite changed after HelloRetryRequest", ALERT_ILLEGAL_PARAMETER); }
            } else {
                tr = Digest::new(h);
                tr.update(x.ch);
            }
            tr.update(all);
            self.suite = suite;
            let psk = Secret::zeroed(h.output_len());
            if let i: usize = hello.psk {
                let tk: Ticket = x.ticket else { throw proto("pre_shared_key not offered", ALERT_ILLEGAL_PARAMETER); };
                if i != 0 || suite_hash(tk.suite) != h { throw proto("server chose an unusable PSK", ALERT_ILLEGAL_PARAMETER); }
                psk = tk.psk;
                self.resumed = true;
                self.peer = tk.peer;
            }
            let shared = try shares.finish(hello.group, hello.share);
            let early = hkdf::extract(h, "", psk);
            x.hs_secret = hkdf::extract(h, derive_secret(h, early, "derived", Digest::new(h)), shared);
            x.c_hs = derive_secret(h, x.hs_secret, "c hs traffic", tr);
            x.s_hs = derive_secret(h, x.hs_secret, "s hs traffic", tr);
            early.wipe();
            shared.wipe();
            try self.boundary();
            self.rd = dir_of(suite, x.s_hs);
            // Write keys now too, so that an alert is encrypted.
            self.wr = dir_of(suite, x.c_hs);
            x.state = C_EE;
        } else if x.state == C_EE {
            if t != ENCRYPTED_EXTENSIONS { throw proto(f"expected EncryptedExtensions, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            tr.update(all);
            let er = Rd::new(body[0:body.len()], "EncryptedExtensions");
            let eexts = try extensions(try er.vec16(), "EncryptedExtensions");
            try er.end();
            try only_exts(eexts, [EXT_SERVER_NAME, EXT_SUPPORTED_GROUPS, EXT_ALPN, EXT_EARLY_DATA], "EncryptedExtensions");
            if let b: Slice<u8> = find_ext(eexts, EXT_SERVER_NAME) {
                if b.len() != 0 || !(x.ip is none) { throw proto("server_name acknowledged wrongly", ALERT_ILLEGAL_PARAMETER); }
            }
            if let b: Slice<u8> = find_ext(eexts, EXT_ALPN) {
                let r = Rd::new(b, "ALPN");
                let list = Rd::new(try r.vec16(), "ALPN");
                let p = (try list.vec8()).to_list();
                try list.end();
                try r.end();
                let offered = false;
                for a in x.alpn {
                    if a == p { offered = true; }
                }
                if !offered || p.len() == 0 { throw proto("server chose an ALPN protocol not offered", ALERT_ILLEGAL_PARAMETER); }
                self.alpn = p;
            }
            if let b: Slice<u8> = find_ext(eexts, EXT_EARLY_DATA) {
                // Accepted 0-RTT: same suite and ALPN as the ticket's.
                let tk: Ticket = x.ticket else { throw proto("early_data not offered", ALERT_ILLEGAL_PARAMETER); };
                if b.len() != 0 || !x.early_offered || !self.resumed || tk.suite != self.suite || tk.alpn != self.alpn {
                    throw proto("early_data accepted wrongly", ALERT_ILLEGAL_PARAMETER);
                }
                self.early_accepted = true;
            }
            x.state = if self.resumed { C_FIN } else { C_CERT };
        } else if x.state == C_CERT && t == CERTIFICATE_REQUEST {
            tr.update(all);
            let cr = Rd::new(body[0:body.len()], "CertificateRequest");
            let ctx = (try cr.vec8()).to_list();
            let exts = try extensions(try cr.vec16(), "CertificateRequest");
            try cr.end();
            if ctx.len() != 0 { throw proto("CertificateRequest with a context during the handshake", ALERT_ILLEGAL_PARAMETER); }
            let sa: Slice<u8> = find_ext(exts, EXT_SIGNATURE_ALGORITHMS) else { throw proto("CertificateRequest without signature_algorithms", ALERT_MISSING_EXTENSION); };
            x.peer_schemes = try u16_list(sa, "signature_algorithms");
            x.cert_requested = ctx;
            x.state = C_CERT2;
        } else if x.state == C_CERT || x.state == C_CERT2 {
            if t != CERTIFICATE { throw proto(f"expected Certificate, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            tr.update(all);
            let (certs, status) = try parse_certificate_msg(body, true);
            if certs.len() == 0 { throw proto("empty server Certificate", ALERT_DECODE_ERROR); }
            self.peer = certs;
            let infos: List<CertInfo> = [];
            for c in certs { infos.push(c.info); }
            let anchors: List<CertInfo> = [];
            for r in x.roots { anchors.push(r.info); }
            let now = (try SystemTime::now().unix_seconds() catch _ { 0i64 });
            let path = try x509::verify_server(infos, anchors, now, x.host, x.ip);
            match status {
                r: List<u8> => try ocsp::check(r[0:r.len()], path[0], path[1], now),
                none => {
                    if infos[0].must_staple { throw TlsError { kind: TlsErrorKind::Certificate, msg: "certificate requires a stapled OCSP response", alert: ocsp::ALERT_BAD_CERTIFICATE_STATUS }; }
                },
            }
            x.infos = infos;
            x.state = C_CV;
        } else if x.state == C_CV {
            if t != CERTIFICATE_VERIFY { throw proto(f"expected CertificateVerify, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            let signed = verify_input("TLS 1.3, server CertificateVerify", tr.finish());
            try check_cert_verify(body, x.infos[0].key, signed);
            tr.update(all);
            x.state = C_FIN;
        } else {
            if t != FINISHED { throw proto(f"expected Finished, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            let suite = self.suite;
            let h = suite_hash(suite);
            let fk = expand_label(h, x.s_hs, "finished", [], h.output_len());
            if !constant_time_eq(Hmac::mac(h, fk, tr.finish()), body) {
                throw proto("bad server Finished", ALERT_DECRYPT_ERROR);
            }
            tr.update(all);
            let master = hkdf::extract(h, derive_secret(h, x.hs_secret, "derived", Digest::new(h)), zeros(h.output_len()));
            let c_ap = derive_secret(h, master, "c ap traffic", tr);
            let s_ap = derive_secret(h, master, "s ap traffic", tr);
            // Client flight.
            try self.boundary();
            if !x.ccs_sent { try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]); }
            if self.early_accepted {
                self.wr.wipe();
                self.wr = x.early_dir;
                let eoed = message(END_OF_EARLY_DATA, []);
                try self.send(HANDSHAKE, eoed);
                tr.update(eoed);
                self.wr = dir_of(suite, x.c_hs);
            }
            if let ctx: List<u8> = x.cert_requested {
                // Our certificate if we have one for a scheme the server
                // takes, else an empty one.
                let scheme = 0u16;
                let chain: List<Certificate> = [];
                if let k: PrivateKey = x.key {
                    scheme = try pick_scheme(k, x.chain[0].info.key, x.peer_schemes) catch _ { 0u16 };
                    if scheme != 0u16 { chain = x.chain; }
                }
                let cm: List<u8> = [];
                vec8(cm, ctx);
                put_list(cm, cert_entries(chain, []));
                let m = message(CERTIFICATE, cm);
                try self.send(HANDSHAKE, m);
                tr.update(m);
                if let k: PrivateKey = x.key {
                    if scheme != 0u16 {
                        let cv = cert_verify(k, scheme, verify_input("TLS 1.3, client CertificateVerify", tr.finish()));
                        try self.send(HANDSHAKE, cv);
                        tr.update(cv);
                    }
                }
            }
            let cfk = expand_label(h, x.c_hs, "finished", [], h.output_len());
            let fin = message(FINISHED, Hmac::mac(h, cfk, tr.finish()));
            try self.send(HANDSHAKE, fin);
            tr.update(fin);
            self.res_master = derive_secret(h, master, "res master", tr);
            self.wr.wipe();
            self.wr = dir_of(suite, c_ap);
            self.rd.wipe();
            self.rd = dir_of(suite, s_ap);
            for k in [master, c_ap, s_ap] { k.wipe(); }
            self.done = true;
            let late: List<u8> = if self.early_accepted { [] } else { x.early_data };
            x.wipe();
            self.x = new_hs(DONE);
            if late.len() > 0 { try self.write_app(late[0:late.len()]); }
            return;
        }
        x.transcript = tr;
        self.x = x;
    }

    /// Wait for the ClientHello; `handshake` does the rest.
    pub(pkg) fn server_start(ref self, cfg: ServerConfig) {
        let x = new_hs(S_HELLO);
        x.chain = cfg.cert_chain;
        x.key = cfg.private_key;
        x.suites = cfg.cipher_suites;
        x.alpn = cfg.alpn_protocols;
        x.roots = cfg.client_roots;
        x.require_cert = cfg.require_client_cert;
        x.ocsp = cfg.ocsp_response;
        x.store = cfg.ticket_store;
        x.max_early = cfg.max_early_data;
        self.x = x;
    }

    /// The server's handling of the client message `(t, body, all)`.
    fn server_on(ref self, t: u8, body: List<u8>, all: List<u8>) throws (TlsError) {
        let x = self.x;
        if x.state == S_EARLY {
            if t != END_OF_EARLY_DATA { throw proto(f"expected EndOfEarlyData, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            if body.len() != 0 { throw decode_err("EndOfEarlyData"); }
            x.transcript.update(all);
            try self.boundary();
            self.rd.wipe();
            self.rd = dir_of(self.suite, x.c_hs);
            x.state = S_FIN;
            self.x = x;
            return;
        }
        if x.state == S_CCERT {
            if t != CERTIFICATE { throw proto(f"expected Certificate, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            x.transcript.update(all);
            let (certs, _) = try parse_certificate_msg(body, false);
            if certs.len() == 0 {
                if x.require_cert { throw TlsError { kind: TlsErrorKind::Certificate, msg: "client sent no certificate", alert: ALERT_CERTIFICATE_REQUIRED }; }
                x.state = S_FIN;
            } else {
                let infos: List<CertInfo> = [];
                for c in certs { infos.push(c.info); }
                let anchors: List<CertInfo> = [];
                for r in x.roots { anchors.push(r.info); }
                let now = (try SystemTime::now().unix_seconds() catch _ { 0i64 });
                _ = try x509::verify_client(infos, anchors, now);
                self.peer = certs;
                x.infos = infos;
                x.state = S_CCV;
            }
            self.x = x;
            return;
        }
        if x.state == S_CCV {
            if t != CERTIFICATE_VERIFY { throw proto(f"expected CertificateVerify, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            let signed = verify_input("TLS 1.3, client CertificateVerify", x.transcript.finish());
            try check_cert_verify(body, x.infos[0].key, signed);
            x.transcript.update(all);
            x.state = S_FIN;
            self.x = x;
            return;
        }
        if x.state == S_FIN {
            if t != FINISHED { throw proto(f"expected Finished, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
            let h = suite_hash(self.suite);
            let cfk = expand_label(h, x.c_hs, "finished", [], h.output_len());
            if !constant_time_eq(Hmac::mac(h, cfk, x.transcript.finish()), body) {
                throw proto("bad client Finished", ALERT_DECRYPT_ERROR);
            }
            try self.boundary();
            self.rd.wipe();
            self.rd = dir_of(self.suite, x.c_ap);
            self.done = true;
            self.x = new_hs(DONE);
            if let st: TicketStore = x.store {
                x.transcript.update(all);
                let rm = derive_secret(h, x.master, "res master", x.transcript);
                try self.issue_ticket(st, rm, x.max_early);
                rm.wipe();
            }
            x.wipe();
            return;
        }
        if t != CLIENT_HELLO { throw proto(f"expected ClientHello, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
        let hello = try parse_client_hello(body);
        let tr = x.transcript;
        if x.state == S_HELLO {
            let suite = try pick_suite(x.suites, hello.suites);
            let h = suite_hash(suite);
            self.suite = suite;
            self.sni = hello.sni;
            x.group = choose_group(hello);
            if x.group == 0u16 { throw proto("no common key exchange group", ALERT_HANDSHAKE_FAILURE); }
            tr = Digest::new(h);
            if hello.share_for(x.group) is none {
                // HelloRetryRequest for a group the client supports; any
                // 0-RTT data is skipped.
                if hello.early { self.skip_early = early_skip(x.max_early); }
                tr.update(message(MESSAGE_HASH, h.digest(all)));
                let hrr = server_hello(HRR_RANDOM[0:32].to_list(), hello.session_id, suite, x.group, none, none);
                tr.update(hrr);
                x.transcript = tr;
                x.first = hello;
                x.retried = true;
                x.state = S_HELLO2;
                self.x = x;
                try self.send(HANDSHAKE, hrr);
                try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]);
                return;
            }
        } else {
            let first = x.first ?? hello;
            if hello.session_id != first.session_id || !hello.suites.contains(suite_code(self.suite)) {
                throw proto("second ClientHello does not match", ALERT_ILLEGAL_PARAMETER);
            }
            if hello.early { throw proto("early_data after HelloRetryRequest", ALERT_ILLEGAL_PARAMETER); }
            if hello.share_for(x.group) is none { throw proto("second ClientHello without the requested key share", ALERT_ILLEGAL_PARAMETER); }
        }
        let suite = self.suite;
        let h = suite_hash(suite);
        let hl = h.output_len();
        let alpn = try choose_alpn(x.alpn, hello.alpn);
        self.alpn = alpn;

        // Resumption: the first offered ticket the store holds for this
        // name and hash, its binder checked, redeemed once.
        let session: Session | none = none;
        let psk_index = 0usize;
        if let st: TicketStore = x.store {
            if hello.psk_modes.contains(1u8) {
                let i = 0usize;
                while i < hello.psk_ids.len() && session is none {
                    let (id, _) = hello.psk_ids[i];
                    if let s: Session = st.find(id) {
                        if s.sni == self.sni && suite_hash(s.suite) == h {
                            let bt = tr;
                            bt.update(all[0:all.len() - hello.binders_len]);
                            let bk = derive_secret(h, hkdf::extract(h, "", s.psk), "res binder", Digest::new(h));
                            let want = Hmac::mac(h, expand_label(h, bk, "finished", [], hl), bt.finish());
                            if !constant_time_eq(want, hello.binders[i]) { throw proto("bad PSK binder", ALERT_DECRYPT_ERROR); }
                            if st.redeem(s.id) {
                                session = s;
                                psk_index = i;
                            }
                        }
                    }
                    i += 1;
                }
            }
        }
        tr.update(all);
        let psk = Secret::zeroed(hl);
        let accept_early = false;
        if let s: Session = session {
            psk = s.psk;
            self.resumed = true;
            self.peer = s.peer;
            let (_, obfuscated) = hello.psk_ids[psk_index];
            let client_age = (obfuscated.wrapping_sub(s.age_add)) as i64;
            let skew = client_age - s.issued.elapsed().as_ms();
            accept_early = hello.early && psk_index == 0 && !x.retried && x.max_early > 0u32 && s.max_early > 0u32
                && s.suite == suite && s.alpn == alpn && skew <= AGE_TOLERANCE_MS && skew >= -AGE_TOLERANCE_MS;
        }
        if hello.early && !accept_early { self.skip_early = early_skip(x.max_early); }
        let early = hkdf::extract(h, "", psk);
        if accept_early { x.c_early = derive_secret(h, early, "c e traffic", tr); }

        let (reply, shared) = try server_share(x.group, hello.share_for(x.group) ?? body[0:0]);
        let sh = server_hello(random::bytes(32), hello.session_id, suite, x.group, reply, if session is Session { psk_index } else { none });
        tr.update(sh);
        try self.send(HANDSHAKE, sh);
        if !x.retried { try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]); }

        let hs_secret = hkdf::extract(h, derive_secret(h, early, "derived", Digest::new(h)), shared);
        let c_hs = derive_secret(h, hs_secret, "c hs traffic", tr);
        let s_hs = derive_secret(h, hs_secret, "s hs traffic", tr);
        self.wr = dir_of(suite, s_hs);

        let ee_exts: List<u8> = [];
        if let p: List<u8> = alpn {
            let l: List<u8> = [];
            vec8(l, p);
            let b: List<u8> = [];
            vec16(b, l);
            ext(ee_exts, EXT_ALPN, b);
        }
        if accept_early { ext(ee_exts, EXT_EARLY_DATA, []); }
        let ee_body: List<u8> = [];
        vec16(ee_body, ee_exts);
        let flight: List<u8> = [];
        let ee = message(ENCRYPTED_EXTENSIONS, ee_body);
        tr.update(ee);
        put_list(flight, ee);

        let ask = !self.resumed && x.roots.len() > 0;
        if ask {
            let sa: List<u8> = [];
            for s in sig_schemes() { put_u16(sa, s as usize); }
            let sal: List<u8> = [];
            vec16(sal, sa);
            let cr_exts: List<u8> = [];
            ext(cr_exts, EXT_SIGNATURE_ALGORITHMS, sal);
            let crb: List<u8> = [0u8];
            vec16(crb, cr_exts);
            let cr = message(CERTIFICATE_REQUEST, crb);
            tr.update(cr);
            put_list(flight, cr);
        }

        if !self.resumed {
            let key: PrivateKey = x.key else { throw proto("no server key", ALERT_INTERNAL_ERROR); };
            let scheme = try pick_scheme(key, x.chain[0].info.key, hello.sig_algs);
            // The leaf's OCSP response if the client asked (RFC 8446 4.4.2.1).
            let status: List<u8> = [];
            if hello.status_request && x.ocsp.len() > 0 {
                let cs: List<u8> = [1u8];
                put_u24(cs, x.ocsp.len());
                put_list(cs, x.ocsp);
                ext(status, EXT_STATUS_REQUEST, cs);
            }
            let cb: List<u8> = [0u8];
            put_list(cb, cert_entries(x.chain, status));
            let cm = message(CERTIFICATE, cb);
            tr.update(cm);
            put_list(flight, cm);
            let cv = cert_verify(key, scheme, verify_input("TLS 1.3, server CertificateVerify", tr.finish()));
            tr.update(cv);
            put_list(flight, cv);
        }

        let sfk = expand_label(h, s_hs, "finished", [], hl);
        let fin = message(FINISHED, Hmac::mac(h, sfk, tr.finish()));
        tr.update(fin);
        put_list(flight, fin);
        try self.send(HANDSHAKE, flight);

        x.master = hkdf::extract(h, derive_secret(h, hs_secret, "derived", Digest::new(h)), zeros(hl));
        x.c_ap = derive_secret(h, x.master, "c ap traffic", tr);
        let s_ap = derive_secret(h, x.master, "s ap traffic", tr);
        self.wr.wipe();
        self.wr = dir_of(suite, s_ap);
        for k in [early, shared, hs_secret, s_hs, s_ap] { k.wipe(); }

        // The client's flight comes under its early, then handshake key.
        try self.boundary();
        self.rd = dir_of(suite, if accept_early { x.c_early } else { c_hs });
        x.c_hs = c_hs;
        x.transcript = tr;
        x.state = if accept_early { S_EARLY } else if ask { S_CCERT } else { S_FIN };
        self.x = x;
    }

    /// Store a session and send its NewSessionTicket.
    fn issue_ticket(ref self, st: TicketStore, res_master: Secret, max_early: u32) throws (TlsError) {
        let h = suite_hash(self.suite);
        let nonce: List<u8> = [0u8];
        let id = random::bytes(32);
        let r = random::bytes(4);
        let age_add = ((r[0] as u32) << 24) | ((r[1] as u32) << 16) | ((r[2] as u32) << 8) | (r[3] as u32);
        st.put(Session {
            id,
            psk: expand_label(h, res_master, "resumption", nonce, h.output_len()),
            suite: self.suite,
            alpn: self.alpn,
            sni: self.sni,
            peer: self.peer,
            issued: Instant::now(),
            age_add,
            max_early,
        });
        let b: List<u8> = [];
        put_u32(b, TICKET_LIFETIME);
        put_u32(b, age_add);
        vec8(b, nonce);
        vec16(b, id);
        let exts: List<u8> = [];
        if max_early > 0u32 {
            let e: List<u8> = [];
            put_u32(e, max_early);
            ext(exts, EXT_EARLY_DATA, e);
        }
        vec16(b, exts);
        try self.send(HANDSHAKE, message(NEW_SESSION_TICKET, b));
    }
}

/// Bytes of rejected 0-RTT records a server skips: the most it offers
/// (or one full record) plus record overhead.
const fn early_skip(max_early: u32) -> usize {
    let m = max_early as usize;
    (if m > MAX_PLAINTEXT { m } else { MAX_PLAINTEXT }) + 4096
}

/// The server's ALPN choice (its preference) or none if the client
/// offers none; no overlap is fatal.
const fn choose_alpn(mine: List<List<u8>>, theirs: List<List<u8>>) throws (TlsError) -> List<u8> | none {
    if theirs.len() == 0 || mine.len() == 0 { return none; }
    for m in mine {
        if theirs.contains(m) { return m; }
    }
    throw proto("no common ALPN protocol", ALERT_NO_APPLICATION_PROTOCOL);
}

const C_HELLO: u8 = 1u8;
const C_HELLO2: u8 = 2u8;
const C_EE: u8 = 3u8;
const C_CERT: u8 = 4u8;
const C_CERT2: u8 = 5u8;
const C_CV: u8 = 6u8;
const C_FIN: u8 = 7u8;
const S_HELLO: u8 = 11u8;
const S_HELLO2: u8 = 12u8;
const S_EARLY: u8 = 13u8;
const S_CCERT: u8 = 14u8;
const S_CCV: u8 = 15u8;
const S_FIN: u8 = 16u8;
const DONE: u8 = 20u8;

/// What the handshake carries from one peer message to the next.
struct Hs {
    state: u8;
    transcript: Digest;
    retried: bool;
    suites: List<CipherSuite>;
    alpn: List<List<u8>>;
    hs_secret: Secret;
    c_hs: Secret;
    s_hs: Secret;
    c_ap: Secret;
    /// Our certificate chain and key (the client's, if any).
    chain: List<Certificate>;
    key: PrivateKey | none;
    /// Trust anchors for the peer's certificate.
    roots: List<Certificate>;
    infos: List<CertInfo>;
    ccs_sent: bool;
    // Client.
    host: str;
    ip: List<u8> | none;
    random32: List<u8>;
    session_id: List<u8>;
    groups: List<u16>;
    shares: Shares | none;
    ch: List<u8>;
    cert_requested: List<u8> | none;
    peer_schemes: List<u16>;
    ticket: Ticket | none;
    early_data: List<u8>;
    early_offered: bool;
    early_dir: Dir;
    // Server.
    first: ClientHelloInfo | none;
    group: u16;
    require_cert: bool;
    ocsp: List<u8>;
    store: TicketStore | none;
    max_early: u32;
    c_early: Secret;
    master: Secret;
}

fn new_hs(state: u8) -> Hs {
    Hs {
        state,
        transcript: Digest::new(HashAlgorithm::Sha256),
        retried: false,
        suites: [],
        alpn: [],
        hs_secret: Secret::zeroed(0),
        c_hs: Secret::zeroed(0),
        s_hs: Secret::zeroed(0),
        c_ap: Secret::zeroed(0),
        chain: [],
        key: none,
        roots: [],
        infos: [],
        ccs_sent: false,
        host: "",
        ip: none,
        random32: [],
        session_id: [],
        groups: [],
        shares: none,
        ch: [],
        cert_requested: none,
        peer_schemes: [],
        ticket: none,
        early_data: [],
        early_offered: false,
        early_dir: plain_dir(),
        first: none,
        group: 0u16,
        require_cert: false,
        ocsp: [],
        store: none,
        max_early: 0u32,
        c_early: Secret::zeroed(0),
        master: Secret::zeroed(0),
    }
}

impl Hs {
    fn wipe(self) {
        for k in [self.hs_secret, self.c_hs, self.s_hs, self.c_ap, self.c_early, self.master] { k.wipe(); }
        if let s: Shares = self.shares { s.wipe(); }
        self.early_dir.wipe();
    }
}

const fn suite_code(s: CipherSuite) -> u16 {
    match s {
        CipherSuite::Aes128GcmSha256 => 0x1301u16,
        CipherSuite::Aes256GcmSha384 => 0x1302u16,
        CipherSuite::ChaCha20Poly1305Sha256 => 0x1303u16,
    }
}

/// The configured suite with code `code` (one the client offered).
const fn pick_offered(code: u16, suites: List<CipherSuite>) throws (TlsError) -> CipherSuite {
    for s in suites {
        if suite_code(s) == code { return s; }
    }
    throw proto("server chose a cipher suite not offered", ALERT_ILLEGAL_PARAMETER);
}

/// The first configured suite the client offers (server preference).
const fn pick_suite(suites: List<CipherSuite>, offered: List<u16>) throws (TlsError) -> CipherSuite {
    for s in suites {
        if offered.contains(suite_code(s)) { return s; }
    }
    throw proto("no common cipher suite", ALERT_HANDSHAKE_FAILURE);
}

/// The client's key-exchange secrets for the groups it offers shares of.
struct Shares {
    x: x25519::PrivateKey;
    mlkem_dk: mlkem::DecapsulationKey768 | none;
    mlkem_ek: List<u8>;
    groups: List<u16>;
}

impl Shares {
    /// Shares for `groups` (the hybrid's X25519 half reuses the X25519
    /// secret).
    fn new(groups: List<u16>) -> Shares {
        let xs = random::secret(32);
        let x = try x25519::PrivateKey::from_bytes(xs) catch _ { panic("X25519 key length") };
        xs.wipe();
        let s = Shares { x, mlkem_dk: none, mlkem_ek: [], groups: [] };
        for g in groups {
            if g == HYBRID_GROUP {
                let seed = random::secret(64);
                let dk = try mlkem::DecapsulationKey768::from_seed(seed[0:32], seed[32:64]) catch _ { panic("ML-KEM seed length") };
                seed.wipe();
                s.mlkem_dk = dk;
                s.mlkem_ek = dk.encapsulation_key().to_bytes();
                s.groups.push(HYBRID_GROUP);
            }
        }
        if groups.contains(X25519_GROUP) { s.groups.push(X25519_GROUP); }
        s
    }

    const fn has(self, g: u16) -> bool { self.groups.contains(g) }

    fn wipe(self) {
        self.x.wipe();
        if let k: mlkem::DecapsulationKey768 = self.mlkem_dk { k.wipe(); }
    }

    /// The key_share extension body.
    fn entries(self) -> List<u8> {
        let all: List<u8> = [];
        for g in self.groups {
            let k: List<u8> = [];
            if g == HYBRID_GROUP { put_list(k, self.mlkem_ek); }
            put(k, self.x.public_key().to_bytes()[0:32]);
            put_u16(all, g as usize);
            vec16(all, k);
        }
        let out: List<u8> = [];
        vec16(out, all);
        out
    }

    /// The shared secret from the server's share for `group`.
    fn finish(self, group: u16, share: List<u8>) throws (TlsError) -> Secret {
        if !self.has(group) { throw proto("server chose a key share not offered", ALERT_ILLEGAL_PARAMETER); }
        let bad = proto("bad key share", ALERT_ILLEGAL_PARAMETER);
        if group == HYBRID_GROUP {
            let ct = EncapsulationKey768::CIPHERTEXT_LEN;
            if share.len() != ct + 32 { throw bad; }
            let dk: mlkem::DecapsulationKey768 = self.mlkem_dk else { throw bad; };
            let ss = try dk.decapsulate(share[0:ct]) catch _ { throw bad; };
            let peer = try x25519::PublicKey::from_bytes(share[ct:share.len()]) catch _ { throw bad; };
            match self.x.diffie_hellman(peer) {
                v: Secret => {
                    let j = joined(ss, v);
                    ss.wipe();
                    v.wipe();
                    return j;
                },
                none => throw bad,
            }
        }
        let peer = try x25519::PublicKey::from_bytes(share) catch _ { throw bad; };
        match self.x.diffie_hellman(peer) {
            v: Secret => v,
            none => throw bad,
        }
    }
}

const fn host_is_name(ip: List<u8> | none) -> bool { ip is none }

/// The ClientHello for handshake state `x`; with a ticket, the PSK
/// binder is left zero for `bind`.
fn client_hello(x: Hs, cookie: List<u8> | none) -> List<u8> {
    let b: List<u8> = [3u8, 3u8];
    put_list(b, x.random32);
    vec8(b, x.session_id);
    let cs: List<u8> = [];
    for s in x.suites { put_u16(cs, suite_code(s) as usize); }
    vec16(b, cs);
    b.push(1u8);
    b.push(0u8);
    let exts: List<u8> = [];
    if host_is_name(x.ip) {
        let name: List<u8> = [0u8];
        vec16(name, x.host.as_bytes().to_list());
        let sn: List<u8> = [];
        vec16(sn, name);
        ext(exts, EXT_SERVER_NAME, sn);
    }
    // OCSP, no responder ids or extensions.
    ext(exts, EXT_STATUS_REQUEST, [1u8, 0u8, 0u8, 0u8, 0u8]);
    let g: List<u8> = [];
    for v in x.groups { put_u16(g, v as usize); }
    let gl: List<u8> = [];
    vec16(gl, g);
    ext(exts, EXT_SUPPORTED_GROUPS, gl);
    let sa: List<u8> = [];
    for v in sig_schemes() { put_u16(sa, v as usize); }
    let sal: List<u8> = [];
    vec16(sal, sa);
    ext(exts, EXT_SIGNATURE_ALGORITHMS, sal);
    if x.alpn.len() > 0 {
        let al: List<u8> = [];
        for p in x.alpn { vec8(al, p); }
        let a: List<u8> = [];
        vec16(a, al);
        ext(exts, EXT_ALPN, a);
    }
    ext(exts, EXT_SUPPORTED_VERSIONS, [2u8, 3u8, 4u8]);
    if let c: List<u8> = cookie {
        let cb: List<u8> = [];
        vec16(cb, c);
        ext(exts, EXT_COOKIE, cb);
    }
    let shares: Shares = x.shares else { panic("ClientHello without key shares") };
    ext(exts, EXT_KEY_SHARE, shares.entries());
    if let t: Ticket = x.ticket {
        // psk_dhe_ke only; pre_shared_key goes last (RFC 8446 4.2.11).
        ext(exts, EXT_PSK_MODES, [1u8, 1u8]);
        if x.early_offered { ext(exts, EXT_EARLY_DATA, []); }
        let hl = suite_hash(t.suite).output_len();
        let id: List<u8> = [];
        vec16(id, t.ticket);
        put_u32(id, (t.received.elapsed().as_ms() as u32).wrapping_add(t.age_add));
        let p: List<u8> = [];
        vec16(p, id);
        let binder: List<u8> = [];
        vec8(binder, zeros(hl));
        vec16(p, binder);
        ext(exts, EXT_PRE_SHARED_KEY, p);
    }
    vec16(b, exts);
    message(CLIENT_HELLO, b)
}

/// Fill in the PSK binder of ClientHello `ch` (RFC 8446 4.2.11.2): an
/// HMAC over `tr` (the transcript before it) and `ch` up to the binders.
fn bind(ch: List<u8>, t: Ticket, tr: Digest) {
    let h = suite_hash(t.suite);
    let hl = h.output_len();
    let cut = ch.len() - (3 + hl);
    tr.update(ch[0:cut]);
    let bk = derive_secret(h, hkdf::extract(h, "", t.psk), "res binder", Digest::new(h));
    let b = Hmac::mac(h, expand_label(h, bk, "finished", [], hl), tr.finish());
    for i in 0..hl { ch[cut + 3 + i] = b[i]; }
}

/// A parsed ServerHello or HelloRetryRequest.
struct Hello {
    hrr: bool;
    suite: u16;
    group: u16;
    share: List<u8>;
    cookie: List<u8> | none;
    /// The selected PSK identity.
    psk: usize | none;
}

const fn parse_server_hello(body: List<u8>, session_id: List<u8>) throws (TlsError) -> Hello {
    let r = Rd::new(body[0:body.len()], "ServerHello");
    let version = try r.u16();
    let random32 = try r.bytes(32);
    let sid = try r.vec8();
    let suite = (try r.u16()) as u16;
    let comp = try r.u8();
    let exts = try extensions(try r.vec16(), "ServerHello");
    try r.end();
    let hrr = random32 == HRR_RANDOM[0:32];
    try only_exts(exts, if hrr { [EXT_SUPPORTED_VERSIONS, EXT_KEY_SHARE, EXT_COOKIE] } else { [EXT_SUPPORTED_VERSIONS, EXT_KEY_SHARE, EXT_PRE_SHARED_KEY] }, "ServerHello");
    match find_ext(exts, EXT_SUPPORTED_VERSIONS) {
        v: Slice<u8> => {
            if v.len() != 2 || v[0] != 3u8 || v[1] != 4u8 { throw proto("server chose a version other than TLS 1.3", ALERT_ILLEGAL_PARAMETER); }
        },
        none => throw proto("server does not support TLS 1.3", ALERT_PROTOCOL_VERSION),
    }
    if version != 0x0303 || comp != 0u8 { throw proto("bad ServerHello", ALERT_ILLEGAL_PARAMETER); }
    if sid.to_list() != session_id { throw proto("ServerHello session id mismatch", ALERT_ILLEGAL_PARAMETER); }
    let h = Hello { hrr, suite, group: 0u16, share: [], cookie: none, psk: none };
    if let p: Slice<u8> = find_ext(exts, EXT_PRE_SHARED_KEY) {
        if hrr { throw proto("pre_shared_key in a HelloRetryRequest", ALERT_ILLEGAL_PARAMETER); }
        let pr = Rd::new(p, "pre_shared_key");
        h.psk = try pr.u16();
        try pr.end();
    }
    match find_ext(exts, EXT_KEY_SHARE) {
        k: Slice<u8> => {
            let kr = Rd::new(k, "key_share");
            h.group = (try kr.u16()) as u16;
            if !hrr { h.share = (try kr.vec16()).to_list(); }
            try kr.end();
        },
        none => {
            // An HRR may carry only a cookie; psk_ke is not offered.
            if !hrr { throw proto("ServerHello without key_share", ALERT_MISSING_EXTENSION); }
        },
    }
    if hrr {
        if let c: Slice<u8> = find_ext(exts, EXT_COOKIE) {
            let cr = Rd::new(c, "cookie");
            h.cookie = (try cr.vec16()).to_list();
            try cr.end();
        }
    }
    h
}

/// The certificates of a Certificate message without a request context
/// (possibly none) and the leaf's stapled OCSP response (`status`: the
/// peer may send one).
fn parse_certificate_msg(body: List<u8>, status_ok: bool) throws (TlsError) -> (List<Certificate>, List<u8> | none) {
    let r = Rd::new(body[0:body.len()], "Certificate");
    let ctx = try r.vec8();
    if ctx.len() != 0 { throw proto("Certificate with a request context", ALERT_ILLEGAL_PARAMETER); }
    let list = Rd::new(try r.vec24(), "Certificate");
    try r.end();
    let out: List<Certificate> = [];
    let status: List<u8> | none = none;
    while list.left() > 0 {
        let der = try list.vec24();
        let exts = try extensions(try list.vec16(), "Certificate");
        try only_exts(exts, if status_ok { [EXT_STATUS_REQUEST] } else { [] }, "Certificate");
        if out.len() == 0 {
            if let s: Slice<u8> = find_ext(exts, EXT_STATUS_REQUEST) {
                let sr = Rd::new(s, "status_request");
                if (try sr.u8()) != 1u8 { throw proto("unknown certificate status type", ALERT_ILLEGAL_PARAMETER); }
                status = (try sr.vec24()).to_list();
                try sr.end();
            }
        }
        let c = try Certificate::from_der(der) catch e {
            throw TlsError { kind: TlsErrorKind::Certificate, msg: e.msg, alert: ALERT_BAD_CERTIFICATE };
        };
        out.push(c);
    }
    (out, status)
}

/// A CertificateEntry list for `chain`, `leaf_ext` (an extension block)
/// on the leaf.
const fn cert_entries(chain: List<Certificate>, leaf_ext: List<u8>) -> List<u8> {
    let cl: List<u8> = [];
    for i in 0..chain.len() {
        let c = chain[i];
        put_u24(cl, c.der.len());
        put_list(cl, c.der);
        vec16(cl, if i == 0 { leaf_ext } else { [] });
    }
    let out: List<u8> = [];
    put_u24(out, cl.len());
    put_list(out, cl);
    out
}

/// The CertificateVerify signing input (RFC 8446 4.4.3).
fn verify_input(context: str, hash: List<u8>) -> List<u8> {
    let m: List<u8> = [];
    for _ in 0..64 { m.push(0x20u8); }
    put(m, context.as_bytes());
    m.push(0u8);
    put_list(m, hash);
    m
}

/// The hash of an RSA-PSS scheme.
const fn pss_hash(scheme: u16) -> HashAlgorithm {
    if scheme == RSA_PSS_SHA256 || scheme == RSA_PSS_PSS_SHA256 { return HashAlgorithm::Sha256; }
    if scheme == RSA_PSS_SHA384 || scheme == RSA_PSS_PSS_SHA384 { return HashAlgorithm::Sha384; }
    HashAlgorithm::Sha512
}

/// Check a peer's CertificateVerify against its key.
fn check_cert_verify(body: List<u8>, key: PubKey, signed: List<u8>) throws (TlsError) {
    let r = Rd::new(body[0:body.len()], "CertificateVerify");
    let scheme = (try r.u16()) as u16;
    let sig = try r.vec16();
    try r.end();
    let alg = SigAlg::Other("");
    // The scheme must fit the key: the curve for ECDSA, rsaEncryption
    // for rsa_pss_rsae_*, id-RSASSA-PSS for rsa_pss_pss_*.
    let key_ok = true;
    if scheme == ED25519_SCHEME {
        alg = SigAlg::EdDsa;
    } else if scheme == ECDSA_P256_SHA256 || scheme == ECDSA_P384_SHA384 {
        let want = if scheme == ECDSA_P256_SHA256 { EcCurve::P256 } else { EcCurve::P384 };
        key_ok = match key {
            PubKey::Ec(c, _) => c == want,
            _ => false,
        };
        alg = SigAlg::Ecdsa(if scheme == ECDSA_P256_SHA256 { HashAlgorithm::Sha256 } else { HashAlgorithm::Sha384 });
    } else if scheme == RSA_PSS_SHA256 || scheme == RSA_PSS_SHA384 || scheme == RSA_PSS_SHA512 {
        key_ok = key is PubKey::Rsa;
        alg = SigAlg::RsaPss(pss_hash(scheme), pss_hash(scheme).output_len());
    } else if scheme == RSA_PSS_PSS_SHA256 || scheme == RSA_PSS_PSS_SHA384 || scheme == RSA_PSS_PSS_SHA512 {
        key_ok = key is PubKey::RsaPss;
        alg = SigAlg::RsaPss(pss_hash(scheme), pss_hash(scheme).output_len());
    } else {
        throw proto(f"unsupported CertificateVerify scheme {scheme:#06x}", ALERT_ILLEGAL_PARAMETER);
    }
    if !key_ok || !x509::verify_sig(key, alg, signed[0:signed.len()], sig) {
        throw proto("bad CertificateVerify signature", ALERT_DECRYPT_ERROR);
    }
}

/// The CertificateVerify scheme for `key` (of a certificate with public
/// key `cert_key`) that the peer offers.
fn pick_scheme(key: PrivateKey, cert_key: PubKey, offered: List<u16>) throws (TlsError) -> u16 {
    let want: List<u16> = match key.key {
        KeyKind::Ed25519(_) => [ED25519_SCHEME],
        KeyKind::Ec(k) => [if k.curve() == EcCurve::P256 { ECDSA_P256_SHA256 } else { ECDSA_P384_SHA384 }],
        KeyKind::Rsa(_) => match cert_key {
            PubKey::RsaPss(_, only, min_salt) => {
                let l: List<u16> = [];
                for s in [RSA_PSS_PSS_SHA256, RSA_PSS_PSS_SHA384, RSA_PSS_PSS_SHA512] {
                    let h = pss_hash(s);
                    if (only is none || only == h) && min_salt <= h.output_len() { l.push(s); }
                }
                l
            },
            _ => [RSA_PSS_SHA256, RSA_PSS_SHA384, RSA_PSS_SHA512],
        },
    };
    for w in want {
        if offered.contains(w) { return w; }
    }
    throw proto("peer accepts no signature scheme for our key", ALERT_HANDSHAKE_FAILURE);
}

/// A CertificateVerify message: `msg` signed with `key` under `scheme`
/// (from `pick_scheme`). Every key was checked when it was loaded.
fn cert_verify(key: PrivateKey, scheme: u16, msg: List<u8>) -> List<u8> {
    let sig: List<u8> = match key.key {
        KeyKind::Ed25519(k) => k.sign(msg),
        KeyKind::Ec(k) => k.sign(if k.curve() == EcCurve::P256 { HashAlgorithm::Sha256 } else { HashAlgorithm::Sha384 }, msg),
        KeyKind::Rsa(k) => {
            let h = pss_hash(scheme);
            try k.sign_pss(h, msg, random::bytes(h.output_len())) catch _ { panic("RSA key") }
        },
    };
    let b: List<u8> = [];
    put_u16(b, scheme as usize);
    vec16(b, sig);
    message(CERTIFICATE_VERIFY, b)
}

/// A parsed ClientHello.
struct ClientHelloInfo {
    session_id: List<u8>;
    suites: List<u16>;
    groups: List<u16>;
    shares: List<(u16, Slice<u8>)>;
    sig_algs: List<u16>;
    alpn: List<List<u8>>;
    sni: str | none;
    status_request: bool;
    early: bool;
    psk_modes: List<u8>;
    /// pre_shared_key: `(identity, obfuscated age)` and binders, and the
    /// bytes the binder list takes at the end of the message.
    psk_ids: List<(Slice<u8>, u32)>;
    binders: List<Slice<u8>>;
    binders_len: usize;
}

impl ClientHelloInfo {
    const fn share_for(self, g: u16) -> Slice<u8> | none {
        for (x, k) in self.shares {
            if x == g { return k; }
        }
        none
    }
}

const fn u16_list(b: Slice<u8>, what: str) throws (TlsError) -> List<u16> {
    let r = Rd::new(b, what);
    let l = Rd::new(try r.vec16(), what);
    try r.end();
    let out: List<u16> = [];
    if l.left() % 2 != 0 { throw decode_err(what); }
    while l.left() > 0 { out.push((try l.u16()) as u16); }
    out
}

const fn parse_client_hello(body: List<u8>) throws (TlsError) -> ClientHelloInfo {
    let r = Rd::new(body[0:body.len()], "ClientHello");
    let _version = try r.u16();
    let _random = try r.bytes(32);
    let sid = (try r.vec8()).to_list();
    if sid.len() > 32 { throw decode_err("ClientHello"); }
    let cs = Rd::new(try r.vec16(), "ClientHello");
    let suites: List<u16> = [];
    if cs.left() % 2 != 0 { throw decode_err("ClientHello"); }
    while cs.left() > 0 { suites.push((try cs.u16()) as u16); }
    let comp = try r.vec8();
    if comp.len() != 1 || comp[0] != 0u8 { throw proto("compression offered", ALERT_ILLEGAL_PARAMETER); }
    let exts = try extensions(try r.vec16(), "ClientHello");
    try r.end();
    let info = ClientHelloInfo {
        session_id: sid, suites, groups: [], shares: [], sig_algs: [], alpn: [], sni: none,
        status_request: false, early: false, psk_modes: [], psk_ids: [], binders: [], binders_len: 0,
    };
    match find_ext(exts, EXT_SUPPORTED_VERSIONS) {
        v: Slice<u8> => {
            let vr = Rd::new(v, "supported_versions");
            let vl = Rd::new(try vr.vec8(), "supported_versions");
            let ok = false;
            while vl.left() >= 2 {
                if (try vl.u16()) == 0x0304 { ok = true; }
            }
            if !ok { throw proto("client does not offer TLS 1.3", ALERT_PROTOCOL_VERSION); }
        },
        none => throw proto("client does not offer TLS 1.3", ALERT_PROTOCOL_VERSION),
    }
    if let g: Slice<u8> = find_ext(exts, EXT_SUPPORTED_GROUPS) { info.groups = try u16_list(g, "supported_groups"); }
    match find_ext(exts, EXT_SIGNATURE_ALGORITHMS) {
        s: Slice<u8> => { info.sig_algs = try u16_list(s, "signature_algorithms"); },
        none => throw proto("ClientHello without signature_algorithms", ALERT_MISSING_EXTENSION),
    }
    match find_ext(exts, EXT_KEY_SHARE) {
        k: Slice<u8> => {
            let kr = Rd::new(k, "key_share");
            let kl = Rd::new(try kr.vec16(), "key_share");
            try kr.end();
            while kl.left() > 0 {
                let g = (try kl.u16()) as u16;
                let key = try kl.vec16();
                info.shares.push((g, key));
            }
        },
        none => throw proto("ClientHello without key_share", ALERT_MISSING_EXTENSION),
    }
    if let a: Slice<u8> = find_ext(exts, EXT_ALPN) {
        let ar = Rd::new(a, "ALPN");
        let al = Rd::new(try ar.vec16(), "ALPN");
        try ar.end();
        while al.left() > 0 {
            let p = try al.vec8();
            if p.len() == 0 { throw decode_err("ALPN"); }
            info.alpn.push(p.to_list());
        }
    }
    if let s: Slice<u8> = find_ext(exts, EXT_SERVER_NAME) {
        let sr = Rd::new(s, "server_name");
        let sl = Rd::new(try sr.vec16(), "server_name");
        try sr.end();
        while sl.left() > 0 {
            let t = try sl.u8();
            let n = try sl.vec16();
            if t == 0u8 { info.sni = try str::from_utf8(n) catch _ { throw decode_err("server_name"); }; }
        }
    }
    if let s: Slice<u8> = find_ext(exts, EXT_STATUS_REQUEST) { info.status_request = s.len() > 0 && s[0] == 1u8; }
    if let e: Slice<u8> = find_ext(exts, EXT_EARLY_DATA) {
        if e.len() != 0 { throw decode_err("early_data"); }
        info.early = true;
    }
    if let m: Slice<u8> = find_ext(exts, EXT_PSK_MODES) {
        let mr = Rd::new(m, "psk_key_exchange_modes");
        info.psk_modes = (try mr.vec8()).to_list();
        try mr.end();
    }
    if let p: Slice<u8> = find_ext(exts, EXT_PRE_SHARED_KEY) {
        let (last, _) = exts[exts.len() - 1];
        if last != EXT_PRE_SHARED_KEY as usize { throw proto("pre_shared_key is not the last extension", ALERT_ILLEGAL_PARAMETER); }
        if info.psk_modes.len() == 0 { throw proto("pre_shared_key without psk_key_exchange_modes", ALERT_MISSING_EXTENSION); }
        let pr = Rd::new(p, "pre_shared_key");
        let ids = Rd::new(try pr.vec16(), "pre_shared_key");
        info.binders_len = pr.left();
        let bs = Rd::new(try pr.vec16(), "pre_shared_key");
        try pr.end();
        while ids.left() > 0 {
            let id = try ids.vec16();
            let age = try ids.u32();
            info.psk_ids.push((id, age));
        }
        while bs.left() > 0 { info.binders.push(try bs.vec8()); }
        if info.psk_ids.len() == 0 || info.psk_ids.len() != info.binders.len() { throw proto("PSK identities and binders differ", ALERT_ILLEGAL_PARAMETER); }
    }
    info
}

/// The group to use: the hybrid if the client supports it, else X25519;
/// 0 if neither.
const fn choose_group(c: ClientHelloInfo) -> u16 {
    if c.groups.contains(HYBRID_GROUP) { return HYBRID_GROUP; }
    if c.groups.contains(X25519_GROUP) { return X25519_GROUP; }
    0u16
}

/// The server's share for `group` given the client's: `(reply, shared)`.
fn server_share(group: u16, client: Slice<u8>) throws (TlsError) -> (List<u8>, Secret) {
    let bad = proto("bad client key share", ALERT_ILLEGAL_PARAMETER);
    let xs = random::secret(32);
    using secret = try x25519::PrivateKey::from_bytes(xs) catch _ { panic("X25519 key length") } {
        xs.wipe();
        let public_key = secret.public_key().to_bytes();
        if group == HYBRID_GROUP {
            let ek_len = EncapsulationKey768::LEN;
            if client.len() != ek_len + 32 { throw bad; }
            let ek = try EncapsulationKey768::from_bytes(client[0:ek_len]) catch _ { throw bad; };
            let m = random::secret(32);
            let (ss, ct) = try ek.encapsulate(m) catch _ { throw bad; };
            m.wipe();
            let peer = try x25519::PublicKey::from_bytes(client[ek_len:client.len()]) catch _ { throw bad; };
            match secret.diffie_hellman(peer) {
                v: Secret => {
                    let j = joined(ss, v);
                    ss.wipe();
                    v.wipe();
                    put(ct, public_key[0:32]);
                    return (ct, j);
                },
                none => throw bad,
            }
        }
        let peer = try x25519::PublicKey::from_bytes(client) catch _ { throw bad; };
        match secret.diffie_hellman(peer) {
            v: Secret => (public_key[0:32].to_list(), v),
            none => throw bad,
        }
    }
}

/// A ServerHello (`share` none: a HelloRetryRequest naming `group`),
/// accepting PSK identity `psk` if any.
const fn server_hello(random32: List<u8>, session_id: List<u8>, suite: CipherSuite, group: u16, share: List<u8> | none, psk: usize | none) -> List<u8> {
    let b: List<u8> = [3u8, 3u8];
    put_list(b, random32);
    vec8(b, session_id);
    put_u16(b, suite_code(suite) as usize);
    b.push(0u8);
    let exts: List<u8> = [];
    ext(exts, EXT_SUPPORTED_VERSIONS, [3u8, 4u8]);
    let ks: List<u8> = [];
    put_u16(ks, group as usize);
    if let s: List<u8> = share { vec16(ks, s); }
    ext(exts, EXT_KEY_SHARE, ks);
    if let i: usize = psk {
        let p: List<u8> = [];
        put_u16(p, i);
        ext(exts, EXT_PRE_SHARED_KEY, p);
    }
    vec16(b, exts);
    message(SERVER_HELLO, b)
}

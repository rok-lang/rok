// rok::std::rokon - ROKON (Rok Object Notation, `.rokon`): one value
// written in rok literal syntax (stdlib spec 3.9).
//
// `parse` reads a document into a `Value`, `to_str` writes the
// canonical form, and `ToRokon` / `FromRokon` (with `#[derive(Rokon)]`)
// map rok types to and from `Value`. The reader is a small lexer plus a
// recursive descent over the literal subset (the compiler's parser is not
// reachable at run time).
//
// Decode errors carry a `path` (`.limits["cpu"]`, `.tags[1]`); `from_str`
// turns it into `line:col` by re-reading the document and stopping at
// that path, so the happy path keeps no positions.

// The reader and writer are not API: the functions below wrap them.
pub(pkg) mod read;
pub(pkg) mod write;

/// A ROKON value. `{ k: v }` with identifier keys is a `Struct` without
/// a name; `{ "k": v }` (any value keys) and `{}` are a `Dict`. A path
/// with `::` is a `Variant` (`E::V`, `E::V(a, k: b)`, `E::V { f: v }`);
/// `Name(a, b)` (a tuple struct) is a `Variant` with a one-segment path.
#[non_exhaustive]
pub enum Value {
    None,
    Bool(bool),
    Int(int),
    Float(float),
    Char(char),
    Str(str),
    List(List<Value>),
    Dict(Dict<Value, Value>),
    Tuple(List<Value>),
    Struct { name: str | none; fields: Dict<str, Value>; },
    Variant { path: str; args: List<Value>; named: Dict<str, Value>; },
}

impl Value {
    /// The canonical text (spec 3.9.4): 4-space indent, one line when it
    /// fits in 100 columns, otherwise one element per line with a
    /// trailing comma. A float with no ROKON form (NaN, infinity, past
    /// the `f64` range) is thrown, with its path.
    pub fn to_str(self) throws (RokonError) -> str {
        try writable(self);
        write::pretty(self, 0, 0, 0)
    }

    /// What kind of value this is, for messages (`integer`, `struct`, ..).
    pub const fn kind_name(self) -> str {
        match self {
            Value::None => "none",
            Value::Bool(_) => "bool",
            Value::Int(_) => "integer",
            Value::Float(_) => "float",
            Value::Char(_) => "char",
            Value::Str(_) => "string",
            Value::List(_) => "list",
            Value::Dict(_) => "dict",
            Value::Tuple(_) => "tuple",
            Value::Struct { name, fields } => "struct",
            Value::Variant { path, args, named } => f"variant `{path}`",
        }
    }
}

/// The canonical text, unchecked: a NaN / infinite float shows as `nan` /
/// `inf` (`to_str` throws there).
impl Display for Value {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(write::pretty(self, 0, 0, 0)) }
}

impl Debug for Value {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(write::flat(self)) }
}

/// Structural. Dict entries and fields compare as `Dict` does
/// (order ignored); `{}` as a struct equals `{}` as a dict. Floats compare by identity (NaN equals NaN, -0.0
/// differs from 0.0) so `==` stays reflexive for keys.
impl PartialEq for Value {
    const fn eq(self, rhs: Value) -> bool {
        match (norm(self), norm(rhs)) {
            (Value::None, Value::None) => true,
            (Value::Bool(a), Value::Bool(b)) => a == b,
            (Value::Int(a), Value::Int(b)) => a == b,
            (Value::Float(a), Value::Float(b)) => {
                if a.is_nan() || b.is_nan() { return a.is_nan() && b.is_nan(); }
                a == b && a.is_sign_negative() == b.is_sign_negative()
            },
            (Value::Char(a), Value::Char(b)) => a == b,
            (Value::Str(a), Value::Str(b)) => a == b,
            (Value::List(a), Value::List(b)) => a == b,
            (Value::Tuple(a), Value::Tuple(b)) => a == b,
            (Value::Dict(a), Value::Dict(b)) => a == b,
            (Value::Struct { name: n, fields: f }, Value::Struct { name: m, fields: g }) => {
                let same = match n {
                    a: str => match m {
                        b: str => a == b,
                        none => false,
                    },
                    none => m is none,
                };
                same && f == g
            },
            (Value::Variant { path: p, args: a, named: n }, Value::Variant { path: q, args: b, named: m }) => {
                p == q && a == b && n == m
            },
            _ => false,
        }
    }
    const fn ne(self, rhs: Value) -> bool { !self.eq(rhs) }
}

impl Eq for Value {}

impl Hash for Value {
    const fn hash<H: Hasher>(self, ref h: H) {
        match norm(self) {
            Value::None => h.write_u8(0u8),
            Value::Bool(b) => { h.write_u8(1u8); b.hash(ref h); },
            Value::Int(n) => { h.write_u8(2u8); n.hash(ref h); },
            // Equal floats share an `f64`; every NaN hashes alike.
            Value::Float(x) => { h.write_u8(3u8); h.write_u64(if x.is_nan() { 0u64 } else { x.to_f64().to_bits() }); },
            Value::Char(c) => { h.write_u8(4u8); c.hash(ref h); },
            Value::Str(s) => { h.write_u8(5u8); s.hash(ref h); },
            Value::List(xs) => { h.write_u8(6u8); xs.hash(ref h); },
            Value::Tuple(xs) => { h.write_u8(7u8); xs.hash(ref h); },
            Value::Dict(d) => { h.write_u8(8u8); d.hash(ref h); },
            Value::Struct { name, fields } => {
                h.write_u8(9u8);
                (name ?? "").hash(ref h);
                fields.hash(ref h);
            },
            Value::Variant { path, args, named } => {
                h.write_u8(10u8);
                path.hash(ref h);
                args.hash(ref h);
                named.hash(ref h);
            },
        }
    }
}

/// `{}` reads back as an empty `Dict`, so an empty unnamed `Struct` is one.
const fn norm(v: Value) -> Value {
    if let Value::Struct { name, fields } = v {
        if name is none && fields.is_empty() { return Value::Dict(Dict::new()); }
    }
    v
}

/// A read or decode error. `line` / `col` (1-based, code points) are 0
/// when the value did not come from text (`T::from_rokon(v)` directly);
/// `path` names the failing part (`.servers[2].port`, empty at the root).
#[derive(Clone, PartialEq, Eq)]
pub struct RokonError {
    pub(sub) msg: str;
    pub(sub) line: u32;
    pub(sub) col: u32;
    pub(sub) path: str;
    /// The error is about a field name / dict key, not its value
    /// (`from_str` points at the key).
    pub(sub) on_key: bool;
}

impl RokonError {
    /// An error with message `msg`, at no position yet.
    pub const fn new(msg: str) -> RokonError {
        RokonError { msg: msg, line: 0u32, col: 0u32, path: "", on_key: false }
    }

    /// `self` one level down: `seg` (`.name`, `[3]`) goes in front of the path.
    pub const fn within(self, seg: str) -> RokonError {
        RokonError { msg: self.msg, line: self.line, col: self.col, path: seg + self.path, on_key: self.on_key }
    }

    const fn at_key(self) -> RokonError {
        RokonError { msg: self.msg, line: self.line, col: self.col, path: self.path, on_key: true }
    }

    /// What went wrong, without the position `Display` adds.
    pub const fn message(self) -> str { self.msg }
    /// 1-based line in the document; 0 when the value did not come from
    /// text.
    pub const fn line(self) -> u32 { self.line }
    /// 1-based column (code points); 0 as for `line`.
    pub const fn column(self) -> u32 { self.col }
    /// The failing part (`.servers[2].port`); empty at the root.
    pub const fn path(self) -> str { self.path }
}

impl Display for RokonError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        let s = if self.line > 0u32 {
            f"{self.line}:{self.col}: {self.msg}"
        } else if self.path != "" {
            f"at {self.path}: {self.msg}"
        } else {
            self.msg
        };
        try f.write_str(s)
    }
}

impl Debug for RokonError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"RokonError({self})") }
}

impl Error for RokonError {}

/// A rok value as ROKON.
pub trait ToRokon {
    /// `self` as a ROKON value.
    fn to_rokon(self) -> Value;
}

/// A rok value from ROKON; the target type decides how `v` reads.
pub trait FromRokon {
    /// Read `v` as this type; throws `RokonError` when its shape does not
    /// match.
    fn from_rokon(v: Value) throws (RokonError) -> Self;

    /// A struct field of this type that the document leaves out: an error,
    /// except `T | none` (`none`).
    const fn from_missing() throws (RokonError) -> Self {
        throw RokonError::new("missing");
    }
}

/// Read one ROKON document.
#[must_use]
pub fn parse(s: str) throws (RokonError) -> Value {
    try read::parse(s)
}

/// `v` in canonical ROKON (spec 3.9.4). A float with no ROKON form (NaN,
/// infinity, past the `f64` range) is thrown, with its path.
pub fn to_str<T: ToRokon>(v: T) throws (RokonError) -> str {
    try v.to_rokon().to_str()
}

/// `to_str` on one line, whatever its width.
pub fn to_str_flat<T: ToRokon>(v: T) throws (RokonError) -> str {
    let x = v.to_rokon();
    try writable(x);
    write::flat(x)
}

/// Throw at the first float in `v` that has no ROKON form.
fn writable(v: Value) throws (RokonError) {
    match v {
        Value::Float(x) => {
            if !x.is_finite() { throw RokonError::new("NaN/infinity has no ROKON form"); }
            if !x.to_f64().is_finite() {
                throw RokonError::new(f"float {x:e} is out of range (ROKON floats are f64, up to about 1.8e308)");
            }
        },
        Value::List(xs) => try writable_all(xs),
        Value::Tuple(xs) => try writable_all(xs),
        Value::Dict(d) => {
            for (k, x) in d.iter() {
                try writable(k) catch e { throw e.at_key(); };
                try writable(x) catch e { throw e.within("[" + write::flat(k) + "]"); };
            }
        },
        Value::Struct { name, fields } => try writable_fields(fields),
        Value::Variant { path, args, named } => {
            try writable_all(args);
            try writable_fields(named);
        },
        _ => {},
    }
}

fn writable_all(xs: List<Value>) throws (RokonError) {
    let i = 0usize;
    for x in xs {
        try writable(x) catch e { throw e.within(f"[{i}]"); };
        i += 1;
    }
}

fn writable_fields(fs: Dict<str, Value>) throws (RokonError) {
    for (k, x) in fs.iter() {
        try writable(x) catch e { throw e.within("." + k); };
    }
}

/// Read a document as a `T`; errors carry the `line:col` of the part that
/// did not fit.
pub fn from_str<T: FromRokon>(s: str) throws (RokonError) -> T {
    let v = try read::parse(s);
    try T::from_rokon(v) catch e { throw read::locate(s, e); }
}

/// `x` as a `Value` (`to_value::<T>(x)` keeps a `T | none` field whole).
pub const fn to_value<T: ToRokon>(x: T) -> Value { x.to_rokon() }

/// `v` as a `T`.
pub const fn from_value<T: FromRokon>(v: Value) throws (RokonError) -> T {
    try T::from_rokon(v)
}

/// `from_value`, errors placed under `seg` (`.name`, `[3]`).
pub(pkg) const fn from_value_at<T: FromRokon>(v: Value, seg: str) throws (RokonError) -> T {
    try T::from_rokon(v) catch e { throw e.within(seg); }
}

const fn mismatch<T>(v: Value) -> RokonError {
    RokonError::new(f"expected {T::type_name()}, found {v.kind_name()}")
}

/// The last `::` segment of a path (`a::b::Point` → `Point`).
const fn last_seg(path: str) -> str {
    match path.rfind("::") {
        at: usize => path[at + 2:],
        none => path,
    }
}

// derive support (used by `#[derive(Rokon)]`): the template's names
// are checked here, so these are `pub(pkg)`.

/// The named fields read into a struct or a named variant.
pub(pkg) struct Fields {
    vals: Dict<str, Value>;
    /// Each field's path segment (`.f`, or `[i]` when given by position).
    segs: Dict<str, str>;
    ctx: str;
}

impl Fields {
    /// `v` as the fields of struct `name` (`Name { .. }`, `{ .. }`,
    /// `m::Name { .. }`, or `{}`); a field not in `names` is skipped, or
    /// an error when `deny` (`#[rokon(deny_unknown_fields)]`).
    pub(pkg) const fn of_struct(v: Value, name: str, names: List<str>, deny: bool) throws (RokonError) -> Fields {
        let given: Dict<str, Value> = match v {
            Value::Struct { name: n, fields } => {
                if let w: str = n {
                    if last_seg(w) != name { throw RokonError::new(f"expected {name}, found `{w} {{ .. }}`"); }
                }
                fields
            },
            Value::Variant { path, args, named } => {
                if last_seg(path) != name || !args.is_empty() {
                    throw RokonError::new(f"expected {name}, found {v.kind_name()}");
                }
                named
            },
            Value::Dict(d) => {
                if !d.is_empty() { throw RokonError::new(f"expected {name}, found dict"); }
                Dict::new()
            },
            _ => throw RokonError::new(f"expected {name}, found {v.kind_name()}"),
        };
        try Fields::make(List::new(), given, name, names, deny)
    }

    /// A named variant's values: positional ones fill the fields in
    /// order, then the named ones (`E::V(1, b: 2)`, `E::V { a: 1, b: 2 }`).
    pub(pkg) const fn of_variant(args: List<Value>, named: Dict<str, Value>, ctx: str, names: List<str>, deny: bool) throws (RokonError) -> Fields {
        try Fields::make(args, named, ctx, names, deny)
    }

    const fn make(args: List<Value>, named: Dict<str, Value>, ctx: str, names: List<str>, deny: bool) throws (RokonError) -> Fields {
        let f = Fields { vals: Dict::new(), segs: Dict::new(), ctx: ctx };
        let i = 0usize;
        for a in args {
            if i >= names.len() {
                throw RokonError::new(f"{ctx} takes {names.len()} values, found {args.len()}").within(f"[{i}]");
            }
            f.vals.insert(names[i], a);
            f.segs.insert(names[i], f"[{i}]");
            i += 1;
        }
        for (k, v) in named.iter() {
            if !names.iter().any(|n| n == k) {
                if !deny { continue; }
                throw RokonError::new(f"unknown field `{k}` in {ctx}").within("." + k).at_key();
            }
            if f.vals.contains_key(k) {
                throw RokonError::new(f"field `{k}` of {ctx} is given twice").within("." + k).at_key();
            }
            f.vals.insert(k, v);
            f.segs.insert(k, "." + k);
        }
        f
    }

    /// `true` when field `name` is present.
    pub(pkg) const fn has(self, name: str) -> bool { self.vals.contains_key(name) }

    /// Field `name` as a `T`: its value, or `T::from_missing()` when absent.
    pub(pkg) const fn get<T: FromRokon>(self, name: str) throws (RokonError) -> T {
        if let v: Value = self.vals.get(name) {
            let seg = self.segs.get(name) ?? "";
            return try from_value_at::<T>(v, seg);
        }
        try T::from_missing() catch _ { throw RokonError::new(f"missing field `{name}` in {self.ctx}"); }
    }
}

/// `v` as the values of tuple struct `name` (`Name(a, b)`), `n` of them.
pub(pkg) const fn struct_args(v: Value, name: str, n: usize) throws (RokonError) -> List<Value> {
    match v {
        Value::Variant { path, args, named } => {
            if last_seg(path) == name && named.is_empty() {
                return try count_args(args, name, n);
            }
        },
        _ => {},
    }
    throw RokonError::new(f"expected {name}(..), found {v.kind_name()}");
}

/// `v` as a variant of enum `name`: (variant name, positional values,
/// named values).
pub(pkg) const fn variant_of(v: Value, name: str) throws (RokonError) -> (str, List<Value>, Dict<str, Value>) {
    match v {
        Value::Variant { path, args, named } => {
            let head = match path.rfind("::") {
                at: usize => path[:at],
                none => throw RokonError::new(f"expected a {name} variant (`{name}::..`), found `{path}`"),
            };
            if last_seg(head) != name {
                throw RokonError::new(f"expected a {name} variant, found `{path}`");
            }
            (last_seg(path), args, named)
        },
        _ => throw RokonError::new(f"expected a {name} variant, found {v.kind_name()}"),
    }
}

/// A tuple variant's (or unit variant's, `n` = 0) values.
pub(pkg) const fn variant_args(args: List<Value>, named: Dict<str, Value>, ctx: str, n: usize) throws (RokonError) -> List<Value> {
    for (k, _) in named.iter() {
        throw RokonError::new(f"{ctx} has no named fields (found `{k}`)").within("." + k).at_key();
    }
    try count_args(args, ctx, n)
}

const fn count_args(args: List<Value>, ctx: str, n: usize) throws (RokonError) -> List<Value> {
    if args.len() != n {
        let s = if n == 1 { "" } else { "s" };
        throw RokonError::new(f"{ctx} takes {n} value{s}, found {args.len()}");
    }
    args
}

pub(pkg) const fn unknown_variant(v: str, ctx: str) -> RokonError {
    RokonError::new(f"`{ctx}::{v}` is not a variant of {ctx}")
}

/// `#[derive(Rokon)]`: `ToRokon` + `FromRokon` for a struct (named →
/// `Name { f: v }`, tuple → `Name(a, b)`, unit → `Name {}`) or an enum
/// (`E::V`, `E::V(a)`, `E::V { f: v }`). A missing field takes its
/// default (`f: T = expr`), else `none` for `T | none`, else is an error.
/// A field the type does not have is skipped, so a format can grow;
/// `#[rokon(deny_unknown_fields)]` on the type makes it an error.
#[impl_derive_attribute(Rokon, rokon(deny_unknown_fields))]
pub @derive {
    @where_all(rok::std::rokon::ToRokon)
    impl rok::std::rokon::ToRokon for @Self {
        fn to_rokon(self) -> rok::std::rokon::Value {
            @if_struct {
                @apply_if(@Self.is_tuple) {
                    return rok::std::rokon::Value::Variant {
                        path: @Self.as_str(),
                        args: [@for_fields { rok::std::rokon::to_value::<@field.type>(self.@field), }],
                        named: Dict::new(),
                    };
                }
                @apply_if(!@Self.is_tuple) {
                    let fs: Dict<str, rok::std::rokon::Value> = Dict::new();
                    @for_fields {
                        _ = fs.insert(@field.name.as_str(), rok::std::rokon::to_value::<@field.type>(self.@field));
                    }
                    return rok::std::rokon::Value::Struct { name: @Self.as_str(), fields: fs };
                }
            }
            @if_enum {
                return match self {
                    @for_variants {
                        @variant.pattern => {
                            let args: List<rok::std::rokon::Value> = List::new();
                            let named: Dict<str, rok::std::rokon::Value> = Dict::new();
                            @apply_if(@variant.is_tuple) {
                                @for_variant_fields {
                                    args.push(rok::std::rokon::to_value::<@field.type>(@field));
                                }
                            }
                            @apply_if(@variant.is_named) {
                                @for_variant_fields {
                                    _ = named.insert(@field.name.as_str(), rok::std::rokon::to_value::<@field.type>(@field));
                                }
                            }
                            rok::std::rokon::Value::Variant {
                                path: @Self.as_str() + "::" + @variant.name.as_str(),
                                args: args,
                                named: named,
                            }
                        },
                    }
                };
            }
        }
    }

    @where_all(rok::std::rokon::FromRokon)
    impl rok::std::rokon::FromRokon for @Self {
        fn from_rokon(v: rok::std::rokon::Value) throws (rok::std::rokon::RokonError) -> Self {
            @if_struct {
                @apply_if(@Self.is_tuple) {
                    let args = try rok::std::rokon::struct_args(v, @Self.as_str(), [@for_fields { 0, }].len());
                    return @Self(@for_fields {
                        try rok::std::rokon::from_value_at::<@field.type>(args[@field.name], "[" + @field.name.as_str() + "]"),
                    });
                }
                @apply_if(!@Self.is_tuple) {
                    let fs = try rok::std::rokon::Fields::of_struct(
                        v, @Self.as_str(), [@for_fields { @field.name.as_str(), }],
                        @Self.has_derive_key(deny_unknown_fields));
                    @apply_if(@Self.is_unit) {
                        return @Self;
                    }
                    @apply_if(@Self.is_named) {
                        return @Self {
                            @for_fields {
                                @apply_if(@field.has_default) {
                                    @field: if fs.has(@field.name.as_str()) {
                                        try fs.get::<@field.type>(@field.name.as_str())
                                    } else {
                                        @field.default
                                    },
                                }
                                @apply_if(!@field.has_default) {
                                    @field: try fs.get::<@field.type>(@field.name.as_str()),
                                }
                            }
                        };
                    }
                }
            }
            @if_enum {
                let (name, args, named) = try rok::std::rokon::variant_of(v, @Self.as_str());
                @for_variants {
                    if name == @variant.name.as_str() {
                        @apply_if(@variant.is_unit) {
                            _ = try rok::std::rokon::variant_args(args, named, @Self.as_str() + "::" + name, 0);
                            return @Self.name::@variant.name;
                        }
                        @apply_if(@variant.is_tuple) {
                            let xs = try rok::std::rokon::variant_args(
                                args, named, @Self.as_str() + "::" + name, [@for_variant_fields { 0, }].len());
                            return @Self.name::@variant.name(@for_variant_fields {
                                try rok::std::rokon::from_value_at::<@field.type>(xs[@field.name], "[" + @field.name.as_str() + "]"),
                            });
                        }
                        @apply_if(@variant.is_named) {
                            let fs = try rok::std::rokon::Fields::of_variant(
                                args, named, @Self.as_str() + "::" + name,
                                [@for_variant_fields { @field.name.as_str(), }],
                                @Self.has_derive_key(deny_unknown_fields));
                            return @Self.name::@variant.name {
                                @for_variant_fields {
                                    @field.name: try fs.get::<@field.type>(@field.name.as_str()),
                                }
                            };
                        }
                    }
                }
                throw rok::std::rokon::unknown_variant(name, @Self.as_str());
            }
        }
    }
}

impl ToRokon for Value {
    const fn to_rokon(self) -> Value { self }
}

impl FromRokon for Value {
    const fn from_rokon(v: Value) throws (RokonError) -> Value { v }
}

impl ToRokon for bool {
    const fn to_rokon(self) -> Value { Value::Bool(self) }
}

impl FromRokon for bool {
    const fn from_rokon(v: Value) throws (RokonError) -> bool {
        match v {
            Value::Bool(b) => b,
            _ => throw mismatch::<bool>(v),
        }
    }
}

impl ToRokon for char {
    const fn to_rokon(self) -> Value { Value::Char(self) }
}

impl FromRokon for char {
    const fn from_rokon(v: Value) throws (RokonError) -> char {
        match v {
            Value::Char(c) => c,
            _ => throw mismatch::<char>(v),
        }
    }
}

impl ToRokon for str {
    const fn to_rokon(self) -> Value { Value::Str(self) }
}

impl FromRokon for str {
    const fn from_rokon(v: Value) throws (RokonError) -> str {
        match v {
            Value::Str(s) => s,
            _ => throw mismatch::<str>(v),
        }
    }
}

impl ToRokon for Int {
    const fn to_rokon(self) -> Value { Value::Int(self) }
}

impl FromRokon for Int {
    const fn from_rokon(v: Value) throws (RokonError) -> int { try int_of::<int>(v) }
}

const fn int_of<T>(v: Value) throws (RokonError) -> int {
    match v {
        Value::Int(n) => n,
        _ => throw mismatch::<T>(v),
    }
}

fn out_of_range<T>(n: int) -> RokonError {
    RokonError::new(f"integer {n} is out of range for {T::type_name()}")
}

// ToRokon / FromRokon for every integer type (spec 6.8.12).
#[impl_macro(rokon_int)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl ToRokon for @t { const fn to_rokon(self) -> Value { Value::Int(Int::from(self)) } }
            impl FromRokon for @t {
                fn from_rokon(v: Value) throws (RokonError) -> @t {
                    let n = try int_of::<@t>(v);
                    try @t::try_from(n) catch _ { throw out_of_range::<@t>(n); }
                }
            }
        }
    }
}
rokon_int!(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize);

impl ToRokon for Float {
    const fn to_rokon(self) -> Value { Value::Float(self) }
}

impl FromRokon for Float {
    fn from_rokon(v: Value) throws (RokonError) -> float { try float_of::<float>(v) }
}

/// A float target takes an integer too (spec 3.9.2).
fn float_of<T>(v: Value) throws (RokonError) -> float {
    match v {
        Value::Float(x) => x,
        Value::Int(n) => Float::from_int(n),
        _ => throw mismatch::<T>(v),
    }
}

impl ToRokon for f64 {
    const fn to_rokon(self) -> Value { Value::Float(Float::from_f64(self)) }
}

impl FromRokon for f64 {
    fn from_rokon(v: Value) throws (RokonError) -> f64 { (try float_of::<f64>(v)).to_f64() }
}

impl ToRokon for f32 {
    // The shortest `f32` digits (`0.1`, not `0.10000000149011612`).
    fn to_rokon(self) -> Value {
        if !self.is_finite() { return Value::Float(Float::from_f32(self)); }
        Value::Float(Float::from_literal(f"{self:e}"))
    }
}

impl FromRokon for f32 {
    fn from_rokon(v: Value) throws (RokonError) -> f32 { (try float_of::<f32>(v)).to_f64() as f32 }
}

impl<T: ToRokon> ToRokon for T | none {
    const fn to_rokon(self) -> Value {
        match self {
            none => Value::None,
            x: T => x.to_rokon(),
        }
    }
}

impl<T: FromRokon> FromRokon for T | none {
    const fn from_rokon(v: Value) throws (RokonError) -> T | none {
        match v {
            Value::None => none,
            _ => try T::from_rokon(v),
        }
    }

    const fn from_missing() throws (RokonError) -> T | none { none }
}

/// The items of a list (or a tuple) value.
const fn items_of<T>(v: Value) throws (RokonError) -> List<Value> {
    match v {
        Value::List(xs) => xs,
        Value::Tuple(xs) => xs,
        _ => throw mismatch::<T>(v),
    }
}

impl<T: ToRokon> ToRokon for List<T> {
    const fn to_rokon(self) -> Value {
        let out: List<Value> = List::with_capacity(self.len());
        for x in self { out.push(x.to_rokon()); }
        Value::List(out)
    }
}

impl<T: FromRokon> FromRokon for List<T> {
    const fn from_rokon(v: Value) throws (RokonError) -> List<T> {
        let xs = try items_of::<List<T>>(v);
        let out: List<T> = List::with_capacity(xs.len());
        let i = 0usize;
        for x in xs {
            out.push(try from_value_at::<T>(x, f"[{i}]"));
            i += 1;
        }
        out
    }
}

impl<T: ToRokon + Hash> ToRokon for Set<T> {
    const fn to_rokon(self) -> Value {
        let out: List<Value> = List::with_capacity(self.len());
        for x in self { out.push(x.to_rokon()); }
        Value::List(out)
    }
}

impl<T: FromRokon + Hash> FromRokon for Set<T> {
    const fn from_rokon(v: Value) throws (RokonError) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in try List::<T>::from_rokon(v) { out.insert(x); }
        out
    }
}

impl<T: ToRokon, const N: usize> ToRokon for [T; N] {
    const fn to_rokon(self) -> Value {
        let out: List<Value> = List::with_capacity(N);
        for i in 0..N { out.push(self[i].to_rokon()); }
        Value::List(out)
    }
}

impl<T: FromRokon, const N: usize> FromRokon for [T; N] {
    const fn from_rokon(v: Value) throws (RokonError) -> [T; N] {
        let xs = try List::<T>::from_rokon(v);
        if xs.len() != N {
            throw RokonError::new(f"expected {N} items, found {xs.len()}");
        }
        // The array is seeded with its first item: `[T; 0]` cannot be read.
        if N == 0 { throw RokonError::new("cannot read a zero-length array"); }
        let out: [T; N] = [xs[0]; N];
        for i in 1..N { out[i] = xs[i]; }
        out
    }

    const fn from_missing() throws (RokonError) -> [T; N] {
        throw RokonError::new("missing");
    }
}

/// The entries of a dict value.
const fn entries_of<T>(v: Value) throws (RokonError) -> Dict<Value, Value> {
    match v {
        Value::Dict(d) => d,
        _ => throw mismatch::<T>(v),
    }
}

/// A dict entry's key and value as `K` / `V`.
fn entry_of<K: FromRokon, V: FromRokon>(k: Value, v: Value) throws (RokonError) -> (K, V) {
    let seg = "[" + write::flat(k) + "]";
    let key = try K::from_rokon(k) catch e { throw e.within(seg).at_key(); };
    (key, try from_value_at::<V>(v, seg))
}

impl<K: ToRokon + Hash, V: ToRokon> ToRokon for Dict<K, V> {
    const fn to_rokon(self) -> Value {
        let out: Dict<Value, Value> = Dict::new();
        for (k, v) in self.iter() { out.insert(k.to_rokon(), v.to_rokon()); }
        Value::Dict(out)
    }
}

impl<K: FromRokon + Hash, V: FromRokon> FromRokon for Dict<K, V> {
    fn from_rokon(v: Value) throws (RokonError) -> Dict<K, V> {
        let out: Dict<K, V> = Dict::new();
        for (k, x) in (try entries_of::<Dict<K, V>>(v)).iter() {
            let (key, val) = try entry_of::<K, V>(k, x);
            out.insert(key, val);
        }
        out
    }
}

/// A tuple value with `n` items (a list is taken too).
const fn tuple_of<T>(v: Value, n: usize) throws (RokonError) -> List<Value> {
    let xs = try items_of::<T>(v);
    if xs.len() != n { throw RokonError::new(f"expected a {n}-tuple, found {xs.len()} items"); }
    xs
}

// Tuples up to 6 elements (spec 3.9.5).
impl<A: ToRokon> ToRokon for (A,) {
    fn to_rokon(self) -> Value { Value::Tuple([self.0.to_rokon()]) }
}
impl<A: FromRokon> FromRokon for (A,) {
    fn from_rokon(v: Value) throws (RokonError) -> (A,) {
        let xs = try tuple_of::<(A,)>(v, 1);
        (try from_value_at::<A>(xs[0], "[0]"),)
    }
}
impl<A: ToRokon, B: ToRokon> ToRokon for (A, B) {
    fn to_rokon(self) -> Value { Value::Tuple([self.0.to_rokon(), self.1.to_rokon()]) }
}
impl<A: FromRokon, B: FromRokon> FromRokon for (A, B) {
    const fn from_rokon(v: Value) throws (RokonError) -> (A, B) {
        let xs = try tuple_of::<(A, B)>(v, 2);
        (try from_value_at::<A>(xs[0], "[0]"), try from_value_at::<B>(xs[1], "[1]"))
    }
}
impl<A: ToRokon, B: ToRokon, C: ToRokon> ToRokon for (A, B, C) {
    const fn to_rokon(self) -> Value { Value::Tuple([self.0.to_rokon(), self.1.to_rokon(), self.2.to_rokon()]) }
}
impl<A: FromRokon, B: FromRokon, C: FromRokon> FromRokon for (A, B, C) {
    const fn from_rokon(v: Value) throws (RokonError) -> (A, B, C) {
        let xs = try tuple_of::<(A, B, C)>(v, 3);
        (try from_value_at::<A>(xs[0], "[0]"), try from_value_at::<B>(xs[1], "[1]"), try from_value_at::<C>(xs[2], "[2]"))
    }
}
impl<A: ToRokon, B: ToRokon, C: ToRokon, D: ToRokon> ToRokon for (A, B, C, D) {
    fn to_rokon(self) -> Value {
        Value::Tuple([self.0.to_rokon(), self.1.to_rokon(), self.2.to_rokon(), self.3.to_rokon()])
    }
}
impl<A: FromRokon, B: FromRokon, C: FromRokon, D: FromRokon> FromRokon for (A, B, C, D) {
    fn from_rokon(v: Value) throws (RokonError) -> (A, B, C, D) {
        let xs = try tuple_of::<(A, B, C, D)>(v, 4);
        (
            try from_value_at::<A>(xs[0], "[0]"),
            try from_value_at::<B>(xs[1], "[1]"),
            try from_value_at::<C>(xs[2], "[2]"),
            try from_value_at::<D>(xs[3], "[3]"),
        )
    }
}
impl<A: ToRokon, B: ToRokon, C: ToRokon, D: ToRokon, E: ToRokon> ToRokon for (A, B, C, D, E) {
    fn to_rokon(self) -> Value {
        Value::Tuple([self.0.to_rokon(), self.1.to_rokon(), self.2.to_rokon(), self.3.to_rokon(), self.4.to_rokon()])
    }
}
impl<A: FromRokon, B: FromRokon, C: FromRokon, D: FromRokon, E: FromRokon> FromRokon for (A, B, C, D, E) {
    fn from_rokon(v: Value) throws (RokonError) -> (A, B, C, D, E) {
        let xs = try tuple_of::<(A, B, C, D, E)>(v, 5);
        (
            try from_value_at::<A>(xs[0], "[0]"),
            try from_value_at::<B>(xs[1], "[1]"),
            try from_value_at::<C>(xs[2], "[2]"),
            try from_value_at::<D>(xs[3], "[3]"),
            try from_value_at::<E>(xs[4], "[4]"),
        )
    }
}
impl<A: ToRokon, B: ToRokon, C: ToRokon, D: ToRokon, E: ToRokon, F: ToRokon> ToRokon for (A, B, C, D, E, F) {
    fn to_rokon(self) -> Value {
        Value::Tuple([
            self.0.to_rokon(), self.1.to_rokon(), self.2.to_rokon(),
            self.3.to_rokon(), self.4.to_rokon(), self.5.to_rokon(),
        ])
    }
}
impl<A: FromRokon, B: FromRokon, C: FromRokon, D: FromRokon, E: FromRokon, F: FromRokon> FromRokon for (A, B, C, D, E, F) {
    fn from_rokon(v: Value) throws (RokonError) -> (A, B, C, D, E, F) {
        let xs = try tuple_of::<(A, B, C, D, E, F)>(v, 6);
        (
            try from_value_at::<A>(xs[0], "[0]"),
            try from_value_at::<B>(xs[1], "[1]"),
            try from_value_at::<C>(xs[2], "[2]"),
            try from_value_at::<D>(xs[3], "[3]"),
            try from_value_at::<E>(xs[4], "[4]"),
            try from_value_at::<F>(xs[5], "[5]"),
        )
    }
}

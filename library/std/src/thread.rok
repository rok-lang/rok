// rok::std::thread: OS threads, 1:1 (stdlib 304, refs-lang 7.6.6). Each
// thread is a GC mutator; blocking calls let a collection run without it.
//
// A panic in any thread ends the process (exit 101), so `join` never
// sees one; `JoinError` is an OS join failure. A handle neither joined
// nor `detach`ed keeps its OS thread record (there is no implicit drop).
//
// `THREADS` maps a thread id to its `Rec` (name, park token, thread-local
// values): made before a spawned thread starts and dropped when its
// closure returns, or on another thread's first `current()` / `park` /
// thread-local use.

use rok::std::io::{IoError, IoErrorKind};
use rok::std::time::Duration;
use rok::core::future::IntoFuture;
use rok::core::marker::hand_over;
use rok::core::task::Blocking;

/// Identifies a thread for its lifetime (its runtime worker id).
pub struct ThreadId {
    id: u64;
}

impl ThreadId {
    pub const fn as_u64(self) -> u64 { self.id }
}

impl PartialEq for ThreadId {
    const fn eq(self, rhs: ThreadId) -> bool { self.id == rhs.id }
    const fn ne(self, rhs: ThreadId) -> bool { self.id != rhs.id }
}

/// What the library keeps per thread.
struct Rec {
    id: u64;
    name: str | none;
    /// 1 = an `unpark` is pending.
    park: Atomic<i32>;
    /// `ThreadLocal` key → that local's one-slot `List<T>` on this thread.
    locals: Dict<u64, any>;
}

// Every handle of a thread shares its `Rec`; `locals` is only touched by
// that thread.
unsafe impl Send for Rec {}
unsafe impl Sync for Rec {}

const fn new_rec(id: u64, name: str | none) -> Rec {
    Rec { id: id, name: name, park: Atomic::new(0), locals: Dict::new() }
}

static THREADS: Mutex<Dict<u64, Rec>> = unsafe { Mutex::new_unshared(Dict::new()) };

/// The calling thread's record, made on first use.
fn this_rec() -> Rec {
    let id = unsafe { rok_thread_id() };
    let found: Rec | none = none;
    using g = THREADS.lock() { found = g.get().get(id); }
    if let r: Rec = found {
        return r;
    }
    // Only the thread itself makes its record: no race to insert.
    let fresh = new_rec(id, none);
    using g = THREADS.lock() { g.get().insert(id, fresh); }
    fresh
}

/// A thread's identity (non-generic, 304.1).
pub struct Thread {
    rec: Rec;
}

impl Thread {
    pub const fn id(self) -> ThreadId { ThreadId { id: self.rec.id } }
    pub const fn name(self) -> str | none { self.rec.name }
    /// Wake the thread from `park` (or make its next `park` return at
    /// once). No-op once the thread has ended.
    pub fn unpark(self) {
        self.rec.park.store(1);
        self.rec.park.wake();
    }
}

/// The thread could not be joined (`JoinError::kind`).
#[derive(Debug)]
pub struct JoinError {
    #[deprecated(since = "0.1.6", note = "use `JoinError::kind()`")]
    pub code: i32;
}

/// Why a join failed.
#[non_exhaustive]
pub enum JoinErrorKind {
    /// The OS refused: `pthread_join`'s error number (Windows: the
    /// error code).
    Os(i32),
    /// A failed REPL cell's rollback ended the thread (the session went
    /// back to before the cell; the thread is gone).
    Lost,
    /// The handle was already joined or detached, through it or a copy
    /// of it: the OS thread handle is released once.
    Taken,
}

impl PartialEq for JoinErrorKind {
    const fn eq(self, rhs: JoinErrorKind) -> bool { code_of(self) == code_of(rhs) }
    const fn ne(self, rhs: JoinErrorKind) -> bool { code_of(self) != code_of(rhs) }
}

impl Debug for JoinErrorKind {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            JoinErrorKind::Os(n) => try f.write_str(f"Os({n})"),
            JoinErrorKind::Lost => try f.write_str("Lost"),
            JoinErrorKind::Taken => try f.write_str("Taken"),
        }
    }
}

const fn code_of(k: JoinErrorKind) -> i32 {
    match k {
        JoinErrorKind::Os(n) => n,
        JoinErrorKind::Lost => JOIN_LOST,
        JoinErrorKind::Taken => JOIN_TAKEN,
    }
}

/// `JoinError::code` of a thread a failed REPL cell's rollback ended
/// (the session went back to before the cell; the thread is gone).
#[deprecated(since = "0.1.6", note = "use `JoinErrorKind::Lost`")]
pub const JOIN_LOST: i32 = -1;

/// `JoinError::code` of a handle already joined or detached, through it
/// or a copy of it: the OS thread handle is released once.
#[deprecated(since = "0.1.6", note = "use `JoinErrorKind::Taken`")]
pub const JOIN_TAKEN: i32 = -2;

impl JoinError {
    pub const fn kind(self) -> JoinErrorKind {
        if self.code == JOIN_LOST { return JoinErrorKind::Lost; }
        if self.code == JOIN_TAKEN { return JoinErrorKind::Taken; }
        JoinErrorKind::Os(self.code)
    }

    pub const fn message(self) -> str {
        match self.kind() {
            JoinErrorKind::Lost => "thread join failed: the thread ended with a failed REPL cell",
            JoinErrorKind::Taken => "thread join failed: the handle was already joined or detached",
            JoinErrorKind::Os(n) => f"thread join failed (error {n})",
        }
    }
}

impl Display for JoinError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}

impl Error for JoinError {}

/// The running thread's result, once joined.
#[must_use("thread is never joined, so the program may end before it finishes: join it with `try {}.join()`, or write `{}.detach()` to let it run on its own")]
pub struct JoinHandle<T> {
    handle: usize;
    result: GcBuf<T>;
    thread: Thread;
    /// Set by the first `join` / `detach`; copies share it.
    taken: Atomic<bool>;
}

impl<T> JoinHandle<T> {
    /// Wait for the thread and take its result.
    pub fn join(self) throws (JoinError) -> T {
        unsafe {
            if rok_thread_lost(self.thread.rec.id) != 0 {
                throw JoinError { code: JOIN_LOST };
            }
            if self.taken.swap(true) {
                throw JoinError { code: JOIN_TAKEN };
            }
            let code = rok_thread_join(self.handle);
            if code != 0 { throw JoinError { code }; }
            self.result[0]
        }
    }

    pub const fn thread(self) -> Thread { self.thread }

    /// Let the thread run on its own; its OS resources are released when
    /// it ends. A later `join` throws `JoinError` (`JOIN_TAKEN`); a
    /// handle already joined or detached is left alone.
    pub fn detach(self) {
        if !self.taken.swap(true) {
            unsafe { rok_thread_detach(self.handle) };
        }
    }
}

/// `await handle` (2.20.5): the join runs on the executor's blocking
/// lane, so only the task waits; a failed OS join panics.
impl<T: Send> IntoFuture for JoinHandle<T> {
    type Output = T;
    type IntoFuture = Blocking<T>;
    fn into_future(self) -> Blocking<T> {
        // Handed to the lane, not shared: only `T: Send` is needed.
        let h = unsafe { rok::core::marker::Handoff::new(self) };
        rok::core::task::spawn_blocking(|| try! h.get().join())
    }
}

/// Spawn configuration.
pub struct Builder {
    name: str | none;
    stack_size: usize | none;
}

impl Builder {
    pub const fn new() -> Builder { Builder { name: none, stack_size: none } }

    pub const fn name(self, name: str) -> Builder {
        Builder { name: name, stack_size: self.stack_size }
    }

    /// Stack bytes for the new thread (default 8 MiB).
    pub const fn stack_size(self, size: usize) -> Builder {
        Builder { name: self.name, stack_size: size }
    }

    pub fn spawn<T: Send>(self, f: fn() -> T + Send) throws (IoError) -> JoinHandle<T> {
        unsafe {
            let result: GcBuf<T> = buf_new(1);
            let id = rok_thread_new_id();
            let rec = new_rec(id, self.name);
            using g = THREADS.lock() { g.get().insert(id, rec); }
            // Written once by the thread, read by `join` after it.
            let cell = Handoff::new(result);
            let name = self.name;
            let run: fn() + Send = || {
                if let n: str = name {
                    unsafe { rok_thread_set_name(n) };
                }
                let result = cell.get();
                result[0] = hand_over::<T>(f());
                using g = THREADS.lock() { g.get().remove(id); }
            };
            let h = unsafe { rok_thread_spawn(run, self.stack_size ?? 0usize, id) };
            if h == 0usize {
                using g = THREADS.lock() { g.get().remove(id); }
                // No threads on this target (wasm32-wasip2, the browser).
                if unsafe { rok_cpu_count() } == 0 {
                    throw IoError::with_kind(IoErrorKind::Unsupported, "threads are not supported on this target");
                }
                throw IoError::new("could not create an OS thread");
            }
            JoinHandle { handle: h, result: cell.get(), thread: Thread { rec: rec }, taken: Atomic::new(false) }
        }
    }
}

/// Run `f` on a new OS thread.
pub fn spawn<T: Send>(f: fn() -> T + Send) -> JoinHandle<T> {
    try! Builder::new().spawn(f)
}

/// The calling thread.
pub fn current() -> Thread {
    Thread { rec: this_rec() }
}

/// Let the OS run another thread.
pub fn yield_now() {
    unsafe { rok_thread_yield_now() };
}

/// Block the calling thread for `dur`.
pub fn sleep(dur: Duration) {
    unsafe { rok_thread_sleep_ns(dur.as_ns()) };
}

extern "rok" {
    fn rok_thread_panicking() -> i32;
}

/// Whether this thread panicked. A panic ends the process, so only code
/// that runs while it ends (an embedder's exit hook) sees `true`.
pub const fn panicking() -> bool { unsafe { rok_thread_panicking() } != 0 }

/// Block until this thread is `unpark`ed (an earlier `unpark` makes it
/// return at once). May also return spuriously: re-check the condition.
pub fn park() {
    park_ns(-1);
}

/// `park`, for at most `dur`.
pub fn park_timeout(dur: Duration) {
    park_ns(dur.as_ns());
}

fn park_ns(timeout_ns: i64) {
    let token = this_rec().park;
    if token.swap(0) == 1 {
        return;
    }
    token.wait(0, timeout_ns);
    token.store(0);
}

/// A value per thread, made by `init` on each thread's first use (304.4).
/// It lives in the thread's record and goes with it.
pub struct ThreadLocal<T> {
    init: fn() -> T + Sync;
    key: u64;
}

static NEXT_LOCAL: Atomic<u64> = Atomic::new(1);

// Each `Cell` is only reached from its own thread.
unsafe impl<T> Send for ThreadLocal<T> {}
unsafe impl<T> Sync for ThreadLocal<T> {}

impl<T> ThreadLocal<T> {
    /// This thread's slot; only this thread touches its `locals`.
    fn cell(self) -> List<T> {
        let locals = this_rec().locals;
        if let v: any = locals.get(self.key) {
            if let c: List<T> = rok::core::reflect::cast::<List<T>>(v) {
                return c;
            }
        }
        let init = self.init;
        let c: List<T> = List::new();
        c.push(init());
        locals.insert(self.key, c);
        c
    }

    /// `f` of this thread's value.
    pub fn with<R>(self, f: fn(T) -> R) -> R {
        f(self.get())
    }

    pub fn get(self) -> T {
        self.cell()[0]
    }

    pub fn set(self, value: T) {
        self.cell()[0] = value;
    }
}

/// A `ThreadLocal` whose per-thread value starts as `init()`.
pub fn local<T>(init: fn() -> T + Sync) -> ThreadLocal<T> {
    ThreadLocal { init: init, key: NEXT_LOCAL.fetch_add(1) }
}

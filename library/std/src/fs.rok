// rok::std::fs (stdlib 301): files and directories over the `openat`
// family, so a `Dir` handle is a capability.
//
// `Dir::root()` resolves relative paths against the working directory;
// a `Dir` opened from it refuses absolute paths and `..`.
//
// `copy` reflinks where the OS can (`clonefileat`, `CopyFileExW`,
// `copy_file_range`), else copies bytes. Windows: a `Dir` is a directory
// handle and permissions are the read-only attribute.
//
// Opening: one function per way of opening (`open`, `create`,
// `create_new`, `open_or_create`, `append`), so no invalid combination
// can be written; each passes its fixed choice to the runtime as an
// `OpenHow`. The raw open(2) / `CreateFile2` live in `os::unix::fs` /
// `os::windows::fs` (`DirExt`).
//
// `*_async`: kqueue / epoll cannot wait on regular files, so each call
// runs its sync twin on the blocking lane (`task::spawn_blocking`). A
// cancelled task leaves the call to finish in the background (a
// `read_async` still fills its buffer). `read_dir_async` streams entries
// in batches.

use rok::core::convert::AsBytes;
use rok::core::io::{Close, IoError, IoErrorKind, Read, Write, Seek, SeekFrom, AsyncRead, AsyncWrite, AsyncSeek, AsyncClose};
use rok::std::sys::{check, region, mut_region, read_all, take_handle, write_region, text_of, byte_buf, list_of, use_begin, use_end, use_close};
use rok::bare::mem::{GcBuf, buf_new, transmute_unchecked};
use rok::std::path::{Path, AsPath, Component};
use rok::std::env;
use rok::std::time::SystemTime;
use rok::core::future::{Context, Poll};
use rok::core::stream::TryStream;
use rok::core::task::Task;
#[cfg(target_family = "unix")]
use rok::std::os::unix::fs::{OsOpenFlags, OsCreateFlags, check_custom};
#[cfg(target_family = "unix")]
use rok::std::os::unix::io::{AsRawFd, FromRawFd, RawFd};
#[cfg(target_os = "windows")]
use rok::std::os::windows::fs::{OsOpenFlags, OsCreateFlags};
#[cfg(target_os = "windows")]
use rok::std::os::windows::io::{AsRawHandle, FromRawHandle, RawHandle, raw_handle, handle_fd};

// `OpenHow.access` / `.disposition` (the runtime's `rok_os_open`).
const ACCESS_READ: u32 = 0u32;
const ACCESS_WRITE: u32 = 1u32;
const ACCESS_READ_WRITE: u32 = 2u32;
const ACCESS_APPEND: u32 = 3u32;
const ACCESS_READ_APPEND: u32 = 4u32;
const DISP_OPEN: u32 = 0u32;
const DISP_CREATE: u32 = 1u32;
const DISP_CREATE_NEW: u32 = 2u32;
const DISP_OPEN_OR_CREATE: u32 = 3u32;
const HOW_LEN: usize = 9;
const SHARE_ALL: u32 = 7u32;

/// What `open` opens an existing file for (301.1.1a).
#[non_exhaustive]
pub enum Access {
    ReadOnly,
    WriteOnly,
    ReadWrite,
    /// Write, every write at the end.
    Append,
    /// Read, and every write at the end.
    ReadAppend,
}

impl Access {
    const fn index(self) -> u32 {
        match self {
            Access::ReadOnly => ACCESS_READ,
            Access::WriteOnly => ACCESS_WRITE,
            Access::ReadWrite => ACCESS_READ_WRITE,
            Access::Append => ACCESS_APPEND,
            Access::ReadAppend => ACCESS_READ_APPEND,
        }
    }
}

impl PartialEq for Access {
    const fn eq(self, rhs: Access) -> bool { self.index() == rhs.index() }
    const fn ne(self, rhs: Access) -> bool { self.index() != rhs.index() }
}

impl Debug for Access {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(match self {
            Access::ReadOnly => "ReadOnly",
            Access::WriteOnly => "WriteOnly",
            Access::ReadWrite => "ReadWrite",
            Access::Append => "Append",
            Access::ReadAppend => "ReadAppend",
        })
    }
}

/// Knobs of `open` (301.1.1a).
#[non_exhaustive]
pub struct OpenFlags {
    /// `false`: a final symbolic link is `FilesystemLoop`, not followed.
    pub follow_symlinks: bool = true;
    /// The target's own knobs (`os::unix::fs::OsOpenFlags`,
    /// `os::windows::fs::OsOpenFlags`; empty elsewhere).
    pub os: OsOpenFlags = OsOpenFlags {};
}

/// Knobs of the functions that may create the file (301.1.1a).
#[non_exhaustive]
pub struct CreateFlags {
    /// Open for reading too.
    pub read: bool = false;
    /// A created file's permissions, before the umask; an existing file
    /// keeps its own. Windows: only the read-only attribute.
    pub permissions: Permissions = Permissions::default();
    /// `false`: a final symbolic link is `FilesystemLoop`, not followed.
    pub follow_symlinks: bool = true;
    /// The target's own knobs (`os::unix::fs::OsCreateFlags`,
    /// `os::windows::fs::OsCreateFlags`; empty elsewhere).
    pub os: OsCreateFlags = OsCreateFlags {};
}

/// No target knobs here.
#[cfg(not(any(target_family = "unix", target_os = "windows")))]
#[non_exhaustive]
pub struct OsOpenFlags {}

/// No target knobs here.
#[cfg(not(any(target_family = "unix", target_os = "windows")))]
#[non_exhaustive]
pub struct OsCreateFlags {}

/// The `os` record's part of an `OpenHow`.
struct Knobs {
    custom: u32;
    share: u32;
    attrs: u32;
    sqos: u32;
}

#[cfg(target_family = "unix")]
const fn open_knobs(o: OsOpenFlags) -> Knobs {
    Knobs { custom: o.custom_flags as u32, share: SHARE_ALL, attrs: 0u32, sqos: 0u32 }
}
#[cfg(target_family = "unix")]
const fn create_knobs(o: OsCreateFlags) -> Knobs {
    Knobs { custom: o.custom_flags as u32, share: SHARE_ALL, attrs: 0u32, sqos: 0u32 }
}
#[cfg(target_os = "windows")]
const fn open_knobs(o: OsOpenFlags) -> Knobs {
    Knobs { custom: o.custom_flags, share: o.share_mode, attrs: 0u32, sqos: o.security_qos_flags }
}
#[cfg(target_os = "windows")]
const fn create_knobs(o: OsCreateFlags) -> Knobs {
    Knobs { custom: o.custom_flags, share: o.share_mode, attrs: o.attributes, sqos: o.security_qos_flags }
}
#[cfg(not(any(target_family = "unix", target_os = "windows")))]
const fn open_knobs(_o: OsOpenFlags) -> Knobs {
    Knobs { custom: 0u32, share: SHARE_ALL, attrs: 0u32, sqos: 0u32 }
}
#[cfg(not(any(target_family = "unix", target_os = "windows")))]
const fn create_knobs(_o: OsCreateFlags) -> Knobs {
    Knobs { custom: 0u32, share: SHARE_ALL, attrs: 0u32, sqos: 0u32 }
}

/// `InvalidInput` when `os.custom_flags` sets a bit the open function
/// `name` decides (Unix; Windows flags only add).
#[cfg(target_family = "unix")]
fn check_knobs(custom: u32, path: str, name: str) throws (IoError) {
    try check_custom(custom as i32, path, f"File::{name}");
}
#[cfg(not(target_family = "unix"))]
const fn check_knobs(_custom: u32, _path: str, _name: str) throws (IoError) {}

/// A file's permissions: Unix permission bits (Windows: the read-only
/// attribute; `PermissionsExt` in `rok::std::os::unix::fs` reads and sets
/// the bits).
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct Permissions {
    pub(pkg) mode: u32;
}

impl Permissions {
    /// No write bit for anyone.
    pub const fn readonly(self) -> bool { (self.mode & 0o222u32) == 0u32 }
    /// `true` clears every write bit; `false` adds the owner's write bit
    /// only (group and others stay as they are).
    pub const fn set_readonly(ref self, readonly: bool) {
        if readonly {
            self.mode = self.mode & 0o7555u32;
        } else {
            self.mode = self.mode | 0o200u32;
        }
    }
}

impl Debug for Permissions {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"Permissions {{ mode: {self.mode:#o}, readonly: {self.readonly()} }}")
    }
}

/// `0o666` before the umask (Windows: not read-only): what a created
/// file gets.
impl Default for Permissions {
    const fn default() -> Permissions { Permissions { mode: 0o666u32 } }
}

/// What a directory entry is (301.1).
#[non_exhaustive]
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub enum FileType {
    File,
    Dir,
    Symlink,
    /// A device, pipe, socket, ...
    Other,
}

impl FileType {
    pub const fn is_file(self) -> bool { self == FileType::File }
    pub const fn is_dir(self) -> bool { self == FileType::Dir }
    pub const fn is_symlink(self) -> bool { self == FileType::Symlink }

    const fn index(self) -> i32 {
        match self {
            FileType::File => 1,
            FileType::Dir => 2,
            FileType::Symlink => 3,
            FileType::Other => 0,
        }
    }
}

impl Debug for FileType {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(match self {
            FileType::File => "File",
            FileType::Dir => "Dir",
            FileType::Symlink => "Symlink",
            FileType::Other => "Other",
        })
    }
}

/// `stat` of a file (301.1).
pub struct Metadata {
    kind: i64;
    len: u64;
    mode: u32;
    mtime: i64;
    mtime_ns: i64;
    atime: i64;
    ctime: i64;
    atime_ns: i64;
    ctime_ns: i64;
    /// Creation time, when the OS and file system keep one.
    btime: i64;
    btime_ns: i64;
    has_btime: bool;
}

impl Debug for Metadata {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"Metadata {{ file_type: {self.file_type():?}, len: {self.len}, permissions: {self.permissions():?} }}") }
}

impl Metadata {
    pub const fn len(self) -> u64 { self.len }
    pub const fn file_type(self) -> FileType {
        if self.kind == 1 { return FileType::File; }
        if self.kind == 2 { return FileType::Dir; }
        if self.kind == 3 { return FileType::Symlink; }
        FileType::Other
    }
    pub const fn is_file(self) -> bool { self.kind == 1 }
    pub const fn is_dir(self) -> bool { self.kind == 2 }
    pub const fn is_symlink(self) -> bool { self.kind == 3 }
    pub const fn permissions(self) -> Permissions { Permissions { mode: self.mode } }
    /// Last modification as a `SystemTime` (3.3.3). Never throws on
    /// Unix; `throws` keeps room for platforms without the field.
    pub const fn modified(self) throws (IoError) -> SystemTime { SystemTime::from_unix(self.mtime, self.mtime_ns as u32) }
    /// Last access as a `SystemTime`.
    pub const fn accessed(self) throws (IoError) -> SystemTime { SystemTime::from_unix(self.atime, self.atime_ns as u32) }
    /// Last change of the contents or the metadata (permissions, links,
    /// a rename) as a `SystemTime`.
    pub const fn status_changed(self) throws (IoError) -> SystemTime { SystemTime::from_unix(self.ctime, self.ctime_ns as u32) }
    /// Creation as a `SystemTime`; `Unsupported` where the OS or file
    /// system keeps none (Linux before 4.11, some file systems).
    pub const fn created(self) throws (IoError) -> SystemTime {
        if !self.has_btime {
            throw IoError::new(IoErrorKind::Unsupported, "creation time is not available on this platform or file system");
        }
        SystemTime::from_unix(self.btime, self.btime_ns as u32)
    }
}

/// `fd`'s size as a read size hint (0: unknown, as a pipe's).
fn size_hint(fd: i32, path: str) -> usize {
    (try stat_at(-1, path, true, fd) catch _ { return 0; }).len as usize
}

/// `stat` through the runtime: `fd >= 0` → `fstat(fd)`.
fn stat_at(dir: i32, path: str, follow: bool, fd: i32) throws (IoError) -> Metadata {
    unsafe {
        let out: GcBuf<i64> = buf_new(12);
        let f = if follow { 1 } else { 0 };
        try check(rok_os_stat(dir, path, f, fd, out) as i64, path);
        Metadata {
            kind: out[0],
            len: out[1] as u64,
            mode: out[2] as u32,
            mtime: out[3],
            mtime_ns: out[4],
            atime: out[5],
            ctime: out[6],
            atime_ns: out[7],
            ctime_ns: out[8],
            has_btime: out[9] != 0,
            btime: out[10],
            btime_ns: out[11],
        }
    }
}

/// An open file. `fd` is shared by copies of the handle, so `close()`
/// through any copy closes it for all.
pub struct File {
    /// `[fd, calls in flight]` (`io::use_begin`).
    fd: GcBuf<i32>;
    path: str;
}

impl Debug for File {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"File {{ path: {self.path:?} }}") }
}

pub(pkg) const fn file_of(fd: i32, path: str) -> File {
    unsafe {
        let cell: GcBuf<i32> = buf_new(2);
        cell[0] = fd;
        File { fd: cell, path: path }
    }
}

// Each opens as `Dir::root()`'s function of the same name (301.1.1a).
impl File {
    /// An existing file, opened for `access`; missing: `NotFound`.
    pub fn open<P: AsPath>(path: P, access: Access = Access::ReadOnly, flags: OpenFlags = OpenFlags {}) throws (IoError) -> File {
        try Dir::root().open(path, access, flags)
    }
    /// Created, or emptied when it exists; open for writing (and
    /// reading with `flags.read`).
    pub fn create<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try Dir::root().create(path, flags)
    }
    /// Created; `AlreadyExists` when anything is at `path`.
    pub fn create_new<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try Dir::root().create_new(path, flags)
    }
    /// Created when missing; the contents are kept.
    pub fn open_or_create<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try Dir::root().open_or_create(path, flags)
    }
    /// Created when missing; every write goes to the end.
    pub fn append<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try Dir::root().append(path, flags)
    }

    /// The runtime fd (`-1` once closed); `AsRawFd` / `AsRawHandle`
    /// give the OS value.
    pub(pkg) const fn fd(self) -> i32 {
        unsafe {
            if (self.fd[1] & 1) != 0 { return -1; }
            self.fd[0]
        }
    }

    /// The fd for one call, which `done` ends. A `close` meanwhile
    /// leaves the fd open until then.
    fn live(self) throws (IoError) -> i32 {
        let fd = unsafe { self.fd[0] };
        if fd < 0 || !use_begin(self.fd, 1) {
            throw IoError::new(IoErrorKind::InvalidInput, f"{self.path}: file is closed");
        }
        fd
    }

    fn done(self) {
        if use_end(self.fd, 1) { self.release(); }
    }

    /// `done`, then `r` checked.
    #[discardable]
    fn done_with(self, r: i64) throws (IoError) -> i64 {
        self.done();
        try check(r, self.path)
    }

    fn release(self) {
        unsafe {
            let fd = take_handle(self.fd, 0, -1);
            if fd >= 0 { _ = rok_os_close(fd); }
        }
    }

    /// Close now; later calls fail with `InvalidInput`. Closing twice is a
    /// no-op. With calls in flight through other copies, the last of them
    /// releases the fd.
    pub fn close(self) throws (IoError) {
        if use_close(self.fd, 1) != 0 { return; }
        unsafe {
            let fd = take_handle(self.fd, 0, -1);
            if fd < 0 { return; }
            try check(rok_os_close(fd) as i64, self.path);
        }
    }

    pub fn sync_all(self) throws (IoError) {
        let fd = try self.live();
        try self.done_with(unsafe { rok_os_fsync(fd, 0) } as i64);
    }

    pub fn sync_data(self) throws (IoError) {
        let fd = try self.live();
        try self.done_with(unsafe { rok_os_fsync(fd, 1) } as i64);
    }

    pub fn set_len(self, size: u64) throws (IoError) {
        let fd = try self.live();
        try self.done_with(unsafe { rok_os_ftruncate(fd, size) } as i64);
    }

    pub fn metadata(self) throws (IoError) -> Metadata {
        let fd = try self.live();
        let m = try stat_at(-1, self.path, true, fd) catch e { self.done(); throw e; };
        self.done();
        m
    }

    pub fn permissions(self) throws (IoError) -> Permissions {
        (try self.metadata()).permissions()
    }

    pub fn set_permissions(self, perm: Permissions) throws (IoError) {
        let fd = try self.live();
        try self.done_with(unsafe { rok_os_fchmod(fd, perm.mode) } as i64);
    }

    /// A second handle on the same open file (`dup`).
    pub fn try_clone(self) throws (IoError) -> File {
        let fd = try self.live();
        let new = try self.done_with(unsafe { rok_os_dup(fd) } as i64);
        file_of(new as i32, self.path)
    }

    pub fn lock_exclusive(self) throws (IoError) {
        let fd = try self.live();
        try self.done_with(unsafe { rok_os_flock(fd, 2) } as i64);
    }

    pub fn lock_shared(self) throws (IoError) {
        let fd = try self.live();
        try self.done_with(unsafe { rok_os_flock(fd, 1) } as i64);
    }

    /// `false` if another holder has it.
    pub fn try_lock_exclusive(self) throws (IoError) -> bool {
        let fd = try self.live();
        (try self.done_with(unsafe { rok_os_flock(fd, 6) } as i64)) == 1
    }

    pub fn unlock(self) throws (IoError) {
        let fd = try self.live();
        try self.done_with(unsafe { rok_os_flock(fd, 8) } as i64);
    }

    /// Map `len` bytes at `offset` (a multiple of the page size) read-only
    /// and shared. Unsafe: another writer of the file changes the bytes
    /// under the mapping, and truncating it makes reads fault.
    pub unsafe fn mmap(self, offset: u64, len: usize) throws (IoError) -> Mmap {
        let fd = try self.live();
        let addr = try self.done_with(unsafe { rok_os_mmap(fd, len, offset) });
        unsafe {
            let cell: GcBuf<usize> = buf_new(1);
            cell[0] = addr as usize;
            Mmap { addr: cell, len }
        }
    }
}

// Mmap (301.3)

/// A read-only shared mapping from `File::mmap`. Unmapped by `unmap` or
/// on leaving `using`; reads after that see an empty mapping.
pub struct Mmap {
    addr: GcBuf<usize>;
    len: usize;
}

impl Debug for Mmap {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"Mmap {{ len: {self.len} }}") }
}

impl Mmap {
    pub const fn len(self) -> usize { if self.live() { self.len } else { 0 } }
    pub const fn is_empty(self) -> bool { self.len() == 0 }

    /// Byte `i`, or `none` past the end.
    pub fn get(self, i: usize) -> u8 | none {
        if i >= self.len() { return none; }
        let b = byte_buf(1);
        self.copy_into(i, b);
        b[0]
    }

    /// The mapped bytes, not copied (`m.as_bytes()[a:b]` for a part).
    /// The view reads the mapping itself: use it only while the mapping
    /// is live (empty once unmapped).
    pub fn as_bytes(self) -> Slice<u8> {
        if !self.live() {
            let empty: List<u8> = List::new();
            return empty[0:0];
        }
        unsafe {
            // A buffer reference sits a header before element 0 (as
            // `rok::bare::ptr::ManyPtr::slice`); the GC skips memory it
            // did not allocate.
            let buf: GcBuf<u8> = transmute_unchecked(self.addr[0] - 16);
            Slice::from_raw_parts(buf, 0, self.len)
        }
    }

    /// Every byte as a new list.
    pub fn to_list(self) -> List<u8> {
        let out = byte_buf(self.len());
        self.copy_into(0, out);
        out
    }

    pub fn unmap(self) {
        unsafe {
            let addr = take_handle(self.addr, 0, 0);
            if addr != 0 {
                _ = rok_os_munmap(addr, self.len);
            }
        }
    }

    const fn live(self) -> bool { unsafe { self.addr[0] != 0 } }

    fn copy_into(self, at: usize, out: List<u8>) {
        let (dst, to, n) = region(out);
        if n > 0 { unsafe { rok_os_mmap_copy(self.addr[0], at, dst, to, n) }; }
    }
}

impl Drop for Mmap {
    fn drop(ref self) { self.unmap(); }
}

// async (see the top)

/// `f()` on a blocking thread, its error thrown here.
pub(pkg) async fn off<T: Send>(f: fn() throws (IoError) -> T + Send) throws (IoError) -> T {
    let r = await task::spawn_blocking(|| Result::catching(f));
    try r.get()
}

impl File {
    pub async fn open_async<P: AsPath>(path: P, access: Access = Access::ReadOnly, flags: OpenFlags = OpenFlags {}) throws (IoError) -> File {
        try await Dir::root().open_async(path, access, flags)
    }
    pub async fn create_async<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try await Dir::root().create_async(path, flags)
    }
    pub async fn create_new_async<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try await Dir::root().create_new_async(path, flags)
    }
    pub async fn open_or_create_async<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try await Dir::root().open_or_create_async(path, flags)
    }
    pub async fn append_async<P: AsPath>(path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try await Dir::root().append_async(path, flags)
    }

    pub async fn sync_all_async(self) throws (IoError) { try await off(|| try self.sync_all()); }
    pub async fn sync_data_async(self) throws (IoError) { try await off(|| try self.sync_data()); }
    pub async fn set_len_async(self, size: u64) throws (IoError) { try await off(|| try self.set_len(size)); }
    pub async fn metadata_async(self) throws (IoError) -> Metadata { try await off(|| try self.metadata()) }
    pub async fn lock_exclusive_async(self) throws (IoError) { try await off(|| try self.lock_exclusive()); }
    pub async fn lock_shared_async(self) throws (IoError) { try await off(|| try self.lock_shared()); }
}

impl Dir {
    pub async fn current_async() throws (IoError) -> Dir { try await off(|| try Dir::current()) }
    pub async fn home_async() throws (IoError) -> Dir { try await off(|| try Dir::home()) }
    pub async fn temp_async() throws (IoError) -> Dir { try await off(|| try Dir::temp()) }

    pub async fn open_async<P: AsPath>(self, path: P, access: Access = Access::ReadOnly, flags: OpenFlags = OpenFlags {}) throws (IoError) -> File {
        let p = path.as_path();
        try await off(|| try self.open(p, access, flags))
    }
    pub async fn create_async<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        let p = path.as_path();
        try await off(|| try self.create(p, flags))
    }
    pub async fn create_new_async<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        let p = path.as_path();
        try await off(|| try self.create_new(p, flags))
    }
    pub async fn open_or_create_async<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        let p = path.as_path();
        try await off(|| try self.open_or_create(p, flags))
    }
    pub async fn append_async<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        let p = path.as_path();
        try await off(|| try self.append(p, flags))
    }
    pub async fn open_dir_async<P: AsPath>(self, path: P) throws (IoError) -> Dir {
        let p = path.as_path();
        try await off(|| try self.open_dir(p))
    }
    /// This directory's entries as a `TryStream` (`try for await e in
    /// try await d.read_dir_async() { .. }`), read in batches on a
    /// blocking thread.
    pub async fn read_dir_async(self) throws (IoError) -> ReadDirStream {
        let rd = try await off(|| try self.read_dir());
        stream_of(rd)
    }
    pub async fn set_permissions_async<P: AsPath>(self, path: P, perm: Permissions) throws (IoError) {
        let p = path.as_path();
        try await off(|| try self.set_permissions(p, perm));
    }
    pub async fn metadata_async<P: AsPath>(self, path: P) throws (IoError) -> Metadata {
        let p = path.as_path();
        try await off(|| try self.metadata(p))
    }
    pub async fn symlink_metadata_async<P: AsPath>(self, path: P) throws (IoError) -> Metadata {
        let p = path.as_path();
        try await off(|| try self.symlink_metadata(p))
    }
    pub async fn exists_async<P: AsPath>(self, path: P) -> bool {
        let p = path.as_path();
        await task::spawn_blocking(|| self.exists(p))
    }
    pub async fn create_dir_async<P: AsPath>(self, path: P) throws (IoError) {
        let p = path.as_path();
        try await off(|| try self.create_dir(p));
    }
    pub async fn create_dir_all_async<P: AsPath>(self, path: P) throws (IoError) {
        let p = path.as_path();
        try await off(|| try self.create_dir_all(p));
    }
    pub async fn remove_file_async<P: AsPath>(self, path: P) throws (IoError) {
        let p = path.as_path();
        try await off(|| try self.remove_file(p));
    }
    pub async fn remove_dir_async<P: AsPath>(self, path: P) throws (IoError) {
        let p = path.as_path();
        try await off(|| try self.remove_dir(p));
    }
    pub async fn remove_dir_all_async<P: AsPath>(self, path: P) throws (IoError) {
        let p = path.as_path();
        try await off(|| try self.remove_dir_all(p));
    }
    pub async fn rename_async<P: AsPath, Q: AsPath>(self, from: P, to: Q) throws (IoError) {
        let a = from.as_path();
        let b = to.as_path();
        try await off(|| try self.rename(a, b));
    }
    pub async fn copy_async<P: AsPath, Q: AsPath>(self, from: P, to: Q) throws (IoError) -> u64 {
        let a = from.as_path();
        let b = to.as_path();
        try await off(|| try self.copy(a, b))
    }
    pub async fn symlink_async<P: AsPath, Q: AsPath>(self, target: P, link: Q) throws (IoError) {
        let a = target.as_path();
        let b = link.as_path();
        try await off(|| try self.symlink(a, b));
    }
    pub async fn hardlink_async<P: AsPath, Q: AsPath>(self, target: P, link: Q) throws (IoError) {
        let a = target.as_path();
        let b = link.as_path();
        try await off(|| try self.hardlink(a, b));
    }
    pub async fn close_async(self) throws (IoError) { try await off(|| try self.close()); }
}

/// Entries per blocking-thread trip of a `ReadDirStream`.
const DIR_BATCH: usize = 64;

/// `read_dir_async`: a `ReadDir` as a `TryStream`. Each refill reads up
/// to `DIR_BATCH` entries on a blocking thread while the task suspends.
/// Closed at its end or on leaving `using`; a cancelled task's refill
/// finishes in the background first.
pub struct ReadDirStream {
    rd: ReadDir;
    /// Held by a refill while it reads, and by `drop` to close.
    lock: Mutex<i32>;
    batch: List<Result<DirEntry, IoError>>;
    pos: usize;
    pending: Task<List<Result<DirEntry, IoError>>> | none;
}

impl Debug for ReadDirStream {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("ReadDirStream") }
}

const fn stream_of(rd: ReadDir) -> ReadDirStream {
    ReadDirStream { rd: rd, lock: Mutex::new(0), batch: List::new(), pos: 0, pending: none }
}

impl TryStream for ReadDirStream {
    type Item = DirEntry;
    type Error = IoError;
    fn poll_next(ref self, ref ctx: Context) throws (IoError) -> Poll<DirEntry | none> {
        unsafe {
            loop {
                if self.pos < self.batch.len() {
                    self.pos += 1;
                    return Poll::Ready(try self.batch[self.pos - 1].get());
                }
                let job = match self.pending {
                    b: Task<List<Result<DirEntry, IoError>>> => b,
                    none => {
                        if self.rd.d[0] == 0 { return Poll::Ready(none); }
                        // Only the refill holding `lock` touches `rd`.
                        let shared = Handoff::new(self.rd);
                        let lock = self.lock;
                        task::spawn_blocking(|| {
                            // The stream still owns `rd`: this is a second handle.
                            let rd = rok::core::marker::share(shared.get());
                            let out: List<Result<DirEntry, IoError>> = List::new();
                            using g = lock.lock() {
                                while out.len() < DIR_BATCH {
                                    // The batch ends at an error.
                                    let e = try rd.next() catch x { out.push(Result::Err(x)); break; };
                                    match e {
                                        d: DirEntry => out.push(Result::Ok(d)),
                                        none => break,
                                    }
                                }
                            }
                            out
                        })
                    }
                };
                match job.poll(ref ctx) {
                    Poll::Ready(b) => {
                        self.pending = none;
                        self.batch = b;
                        self.pos = 0;
                    }
                    Poll::Pending => {
                        self.pending = job;
                        return Poll::Pending;
                    }
                }
            }
        }
    }
}

impl Drop for ReadDirStream {
    fn drop(ref self) {
        using g = self.lock.lock() {
            close_dir(self.rd.d);
        }
    }
}

#[cfg(target_family = "unix")]
impl AsRawFd for File {
    const fn as_raw_fd(self) -> RawFd { self.fd() }
}

/// Its errors name it `fd N`.
#[cfg(target_family = "unix")]
impl FromRawFd for File {
    unsafe fn from_raw_fd(fd: RawFd) -> File { file_of(fd, f"fd {fd}") }
}

#[cfg(target_os = "windows")]
impl AsRawHandle for File {
    fn as_raw_handle(self) -> RawHandle { raw_handle(self.fd()) }
}

/// Its errors name it `handle N`; a value that is no kernel handle
/// gives a closed `File`.
#[cfg(target_os = "windows")]
impl FromRawHandle for File {
    unsafe fn from_raw_handle(h: RawHandle) -> File { file_of(handle_fd(h), f"handle {h}") }
}

impl Read for File {
    fn read(ref self, buf: SliceMut<u8>) throws (IoError) -> usize {
        let (dst, at, n) = mut_region(buf);
        let fd = try self.live();
        (try self.done_with(unsafe { rok_os_read(fd, dst, at, n) } as i64)) as usize
    }

    #[internal]
    const fn copy_handle(self) -> i32 { self.fd() }

    fn read_to_end(ref self) throws (IoError) -> List<u8> {
        let fd = try self.live();
        let out = try read_all(|b: GcBuf<u8>, at: usize, n: usize| unsafe { rok_os_read(fd, b, at, n) }, self.path, size_hint(fd, self.path))
            catch e { self.done(); throw e; };
        self.done();
        out
    }
}

impl Write for File {
    fn write<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        let (src, at, n) = region(buf);
        let fd = try self.live();
        (try self.done_with(unsafe { rok_os_write(fd, src, at, n) } as i64)) as usize
    }

    /// Nothing to flush: writes go straight to the OS.
    const fn flush(ref self) throws (IoError) {}

    #[internal]
    const fn copy_handle(self) -> i32 { self.fd() }

    fn write_all<B: AsBytes>(ref self, buf: B) throws (IoError) {
        let (src, at, n) = region(buf);
        let fd = try self.live();
        try write_region(src, at, n, |b: GcBuf<u8>, o: usize, k: usize| unsafe { rok_os_write(fd, b, o, k) }, self.path)
            catch e { self.done(); throw e; };
        self.done();
    }
}

impl Seek for File {
    fn seek(ref self, pos: SeekFrom) throws (IoError) -> u64 {
        let fd = try self.live();
        let r = match pos {
            SeekFrom::Start(n) => unsafe { rok_os_lseek(fd, n as i64, 0) },
            SeekFrom::Current(n) => unsafe { rok_os_lseek(fd, n, 1) },
            SeekFrom::End(n) => unsafe { rok_os_lseek(fd, n, 2) },
        };
        (try self.done_with(r)) as u64
    }

}

// The async twins run the call on a blocking thread; the task suspends.
// Not cancel-safe: a cancelled call still runs, and its result is lost.
impl AsyncRead for File {
    async fn read_async(ref self, buf: SliceMut<u8>) throws (IoError) -> usize {
        // The caller awaits the read: one thread uses `buf` at a time.
        let b = unsafe { Handoff::new(buf) };
        try await off(|| try self.read(b.get()))
    }

    async fn read_to_end_async(ref self) throws (IoError) -> List<u8> {
        try await off(|| try self.read_to_end())
    }
}

impl AsyncWrite for File {
    async fn write_async<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        let s = unsafe { Handoff::new(buf.byte_slice()) };
        try await off(|| try self.write(s.get()))
    }

    async fn flush_async(ref self) throws (IoError) {}

    async fn write_all_async<B: AsBytes>(ref self, buf: B) throws (IoError) {
        let s = unsafe { Handoff::new(buf.byte_slice()) };
        try await off(|| try self.write_all(s.get()));
    }
}

impl AsyncSeek for File {
    async fn seek_async(ref self, pos: SeekFrom) throws (IoError) -> u64 {
        try await off(|| try self.seek(pos))
    }
}

impl Close for File {
    fn close(self) throws (IoError) { try self.close(); }
}

impl AsyncClose for File {
    async fn close_async(self) throws (IoError) { try await off(|| try self.close()); }
}

/// `using f = try fs::open(..) { .. }` closes `f` on the way out.
impl Drop for File {
    fn drop(ref self) {
        if use_close(self.fd, 1) == 0 { self.release(); }
    }
}

// Dir (301.2)

/// A directory capability. `fd < 0` is `root()`: the whole namespace,
/// relative paths from the working directory.
pub struct Dir {
    fd: GcBuf<i32>;
    path: str;
}

impl Debug for Dir {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"Dir {{ path: {self.path:?} }}") }
}

const fn dir_of(fd: i32, path: str) -> Dir {
    unsafe {
        let cell: GcBuf<i32> = buf_new(1);
        cell[0] = fd;
        Dir { fd: cell, path: path }
    }
}

impl Dir {
    pub const fn root() -> Dir { dir_of(-1, "") }

    /// The working directory.
    pub fn current() throws (IoError) -> Dir { try Dir::root().open_dir(".") }

    pub fn home() throws (IoError) -> Dir {
        if let home: Path = env::home_dir() { return try Dir::root().open_dir(home); }
        throw IoError::new(IoErrorKind::NotFound, "HOME is not set");
    }

    pub fn temp() throws (IoError) -> Dir {
        try Dir::root().open_dir(env::temp_dir())
    }

    const fn fd(self) -> i32 {
        unsafe {
            self.fd[0]
        }
    }

    /// `p` checked against this capability; the string to pass to `*at`.
    const fn rel<P: AsPath>(self, p: P) throws (IoError) -> str {
        let path = p.as_path();
        if self.fd() >= 0 {
            // A root or a prefix (Windows `C:`) leaves the directory too.
            let escapes = false;
            for c in path.components() {
                if c is Component::ParentDir || c is Component::RootDir || c is Component::Prefix { escapes = true; }
            }
            if escapes {
                throw IoError::new(IoErrorKind::PermissionDenied,
                    f"{path}: path escapes the directory capability");
            }
        }
        if path.as_str() == "" { return "."; }
        path.as_str()
    }

    /// For messages: the path as the user would spell it.
    const fn shown(self, p: str) -> str {
        if self.path == "" { return p; }
        Path::new(self.path).join(Path::new(p)).as_str()
    }

    /// An existing file, opened for `access`; missing: `NotFound`
    /// (301.1.1a).
    pub fn open<P: AsPath>(self, path: P, access: Access = Access::ReadOnly, flags: OpenFlags = OpenFlags {}) throws (IoError) -> File {
        try self.open_file(path, access.index(), DISP_OPEN, flags.follow_symlinks, 0u32, open_knobs(flags.os), "open")
    }

    /// Created, or emptied when it exists; open for writing (and reading
    /// with `flags.read`).
    pub fn create<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try self.create_how(path, flags, DISP_CREATE, false, "create")
    }

    /// Created; `AlreadyExists` when anything is at `path` (a dangling
    /// symbolic link too).
    pub fn create_new<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try self.create_how(path, flags, DISP_CREATE_NEW, false, "create_new")
    }

    /// Created when missing; the contents are kept, the position is 0.
    pub fn open_or_create<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try self.create_how(path, flags, DISP_OPEN_OR_CREATE, false, "open_or_create")
    }

    /// Created when missing; every write goes to the end.
    pub fn append<P: AsPath>(self, path: P, flags: CreateFlags = CreateFlags {}) throws (IoError) -> File {
        try self.create_how(path, flags, DISP_OPEN_OR_CREATE, true, "append")
    }

    fn create_how<P: AsPath>(self, path: P, flags: CreateFlags, disp: u32, append: bool, name: str) throws (IoError) -> File {
        let access = if append {
            if flags.read { ACCESS_READ_APPEND } else { ACCESS_APPEND }
        } else {
            if flags.read { ACCESS_READ_WRITE } else { ACCESS_WRITE }
        };
        try self.open_file(path, access, disp, flags.follow_symlinks, flags.permissions.mode, create_knobs(flags.os), name)
    }

    /// The one open path: the function's fixed choice as an `OpenHow`.
    fn open_file<P: AsPath>(self, path: P, access: u32, disp: u32, follow: bool, mode: u32, k: Knobs, name: str) throws (IoError) -> File {
        let p = try self.rel(path);
        let shown = self.shown(p);
        try check_knobs(k.custom, shown, name);
        let how = unsafe {
            let h: GcBuf<u32> = buf_new(HOW_LEN);
            h[0] = access;
            h[1] = disp;
            h[2] = if follow { 0u32 } else { 1u32 };
            h[3] = 0u32;
            h[4] = mode;
            h[5] = k.custom;
            h[6] = k.share;
            h[7] = k.attrs;
            h[8] = k.sqos;
            h
        };
        let fd = try check(unsafe { rok_os_open(self.fd(), p, how) } as i64, shown) catch e {
            if !follow && e.kind() == IoErrorKind::FilesystemLoop {
                throw IoError::new(IoErrorKind::FilesystemLoop,
                    f"{shown}: is a symbolic link and follow_symlinks is false: open its target, or leave follow_symlinks: true");
            }
            if e.kind() == IoErrorKind::IsADirectory {
                throw IoError::new(IoErrorKind::IsADirectory, f"{shown}: is a directory: open it with Dir::open_dir");
            }
            throw e;
        };
        file_of(fd as i32, shown)
    }

    pub fn open_dir<P: AsPath>(self, path: P) throws (IoError) -> Dir {
        let p = try self.rel(path);
        let how = unsafe {
            let h: GcBuf<u32> = buf_new(HOW_LEN);
            for i in 0..HOW_LEN { h[i] = 0u32; }
            h[0] = ACCESS_READ;
            h[1] = DISP_OPEN;
            h[3] = 1u32;
            h[6] = SHARE_ALL;
            h
        };
        let fd = try check(unsafe { rok_os_open(self.fd(), p, how) } as i64, self.shown(p));
        dir_of(fd as i32, self.shown(p))
    }

    /// `DirExt::open_at`: openat(2) with `oflag` as given.
    #[cfg(target_family = "unix")]
    pub(pkg) fn open_raw<P: AsPath>(self, path: P, oflag: i32, mode: u32) throws (IoError) -> File {
        let p = try self.rel(path);
        let fd = try check(unsafe { rok_os_openat_raw(self.fd(), p, oflag, mode) } as i64, self.shown(p));
        file_of(fd as i32, self.shown(p))
    }

    /// `DirExt::create_file`: `CreateFile2` with the parameters as given.
    #[cfg(target_os = "windows")]
    pub(pkg) fn open_raw<P: AsPath>(self, path: P, access: u32, disposition: u32, share: u32, attrs: u32, flags: u32, sqos: u32) throws (IoError) -> File {
        let p = try self.rel(path);
        let params = unsafe {
            let v: GcBuf<u32> = buf_new(6);
            v[0] = access;
            v[1] = disposition;
            v[2] = share;
            v[3] = attrs;
            v[4] = flags;
            v[5] = sqos;
            v
        };
        let fd = try check(unsafe { rok_os_create_file2(self.fd(), p, params) } as i64, self.shown(p));
        file_of(fd as i32, self.shown(p))
    }

    /// Set the permissions of `path` (a final symbolic link is followed).
    /// Windows: only the read-only attribute.
    pub fn set_permissions<P: AsPath>(self, path: P, perm: Permissions) throws (IoError) {
        let p = try self.rel(path);
        try check(unsafe { rok_os_chmod(self.fd(), p, perm.mode) } as i64, self.shown(p));
    }

    /// `fsync` the directory itself, so a rename in it is durable (Windows:
    /// nothing to do).
    #[cfg(not(target_os = "windows"))]
    pub(pkg) fn sync(self) throws (IoError) {
        if self.fd() < 0 { return; }
        try check(unsafe { rok_os_fsync(self.fd(), 0) } as i64, self.path);
    }

    #[cfg(target_os = "windows")]
    pub(pkg) fn sync(self) throws (IoError) {}
    /// The entries of this directory.
    pub fn read_dir(self) throws (IoError) -> ReadDir {
        try self.list(".")
    }

    fn list(self, p: str) throws (IoError) -> ReadDir {
        unsafe {
            let d = try check(rok_os_opendir(self.fd(), p), self.shown(p));
            let base = if p == "." { "" } else { p };
            let cell: GcBuf<isize> = buf_new(1);
            cell[0] = d as isize;
            ReadDir { d: cell, dir: DirView { fd: self.fd, path: self.path }, base: base, name: byte_buf(NAME_MAX) }
        }
    }

    /// Follows symlinks.
    pub fn metadata<P: AsPath>(self, path: P) throws (IoError) -> Metadata {
        let p = try self.rel(path);
        try stat_at(self.fd(), p, true, -1) catch e { throw e.retold(self.shown(p)); }
    }

    /// Does not follow a final symlink.
    pub fn symlink_metadata<P: AsPath>(self, path: P) throws (IoError) -> Metadata {
        let p = try self.rel(path);
        try stat_at(self.fd(), p, false, -1) catch e { throw e.retold(self.shown(p)); }
    }

    pub fn exists<P: AsPath>(self, path: P) -> bool {
        try self.metadata(path) catch _ { return false; };
        true
    }

    pub fn create_dir<P: AsPath>(self, path: P) throws (IoError) {
        let p = try self.rel(path);
        try check(unsafe { rok_os_mkdir(self.fd(), p, 0o777u32) } as i64, self.shown(p));
    }

    /// `path` and any missing parents; fine if it already is a directory.
    pub fn create_dir_all<P: AsPath>(self, path: P) throws (IoError) {
        let p = Path::new(try self.rel(path));
        let chain: List<Path> = List::new();
        for a in p.ancestors() { chain.push(a); }
        let i = chain.len();
        while i > 0 {
            i -= 1;
            let step = chain[i].as_str();
            if step == "" || step == "/" { continue; }
            let r = unsafe { rok_os_mkdir(self.fd(), step, 0o777u32) };
            // Any failure is fine if a directory is there (EEXIST, races).
            if r < 0 && !self.is_dir_at(step) { try check(r as i64, self.shown(step)); }
        }
    }

    fn is_dir_at(self, p: str) -> bool {
        let m = try stat_at(self.fd(), p, true, -1) catch _ { return false; };
        m.is_dir()
    }

    pub fn remove_file<P: AsPath>(self, path: P) throws (IoError) {
        let p = try self.rel(path);
        try check(unsafe { rok_os_unlink(self.fd(), p, 0) } as i64, self.shown(p));
    }

    /// An empty directory.
    pub fn remove_dir<P: AsPath>(self, path: P) throws (IoError) {
        let p = try self.rel(path);
        try check(unsafe { rok_os_unlink(self.fd(), p, 1) } as i64, self.shown(p));
    }

    /// A directory and everything under it (symlinks are removed, not followed).
    pub fn remove_dir_all<P: AsPath>(self, path: P) throws (IoError) {
        let p = try self.rel(path);
        // The whole listing first: removing entries while reading the
        // directory may skip some (WASI's `fd_readdir` cookies are
        // positions).
        let entries: List<DirEntry> = List::new();
        try for e in self.list(p) {
            entries.push(e);
        }
        for e in entries {
            // Under `self`, not `e.path` (the shown path, absolute when
            // `self` was opened by one).
            let sub = Path::new(p).join(Path::new(e.name)).as_str();
            if e.meta.is_dir() {
                try self.remove_dir_all(sub);
            } else {
                try check(unsafe { rok_os_unlink(self.fd(), sub, 0) } as i64, self.shown(sub));
            }
        }
        try check(unsafe { rok_os_unlink(self.fd(), p, 1) } as i64, self.shown(p));
    }

    pub fn rename<P: AsPath, Q: AsPath>(self, from: P, to: Q) throws (IoError) {
        let a = try self.rel(from);
        let b = try self.rel(to);
        try check(unsafe { rok_os_rename(self.fd(), a, self.fd(), b) } as i64, self.shown(a));
    }

    /// Copy contents and permissions; returns the byte count.
    #[discardable]
    pub fn copy<P: AsPath, Q: AsPath>(self, from: P, to: Q) throws (IoError) -> u64 {
        let src = try self.open(from);
        let meta = try src.metadata() catch e { try src.close() catch _ {}; throw e; };
        // Reflink when the OS can (a new `to` on the same volume).
        let a = try self.rel(from) catch e { try src.close() catch _ {}; throw e; };
        let b = try self.rel(to) catch e { try src.close() catch _ {}; throw e; };
        if meta.is_file() && unsafe { rok_os_clone(self.fd(), a, b) } == 0 {
            try src.close() catch _ {};
            return meta.len();
        }
        let dst = try self.create(to, CreateFlags { permissions: meta.permissions() })
            catch e { try src.close() catch _ {}; throw e; };
        let n = unsafe { rok_os_copy_fd(src.fd(), dst.fd()) };
        let perm = unsafe { rok_os_fchmod(dst.fd(), meta.mode) };
        try src.close() catch _ {};
        try dst.close();
        try check(n, dst.path);
        try check(perm as i64, dst.path);
        n as u64
    }

    /// `link` → `target` (a symbolic link; `target` is stored verbatim).
    pub fn symlink<P: AsPath, Q: AsPath>(self, target: P, link: Q) throws (IoError) {
        let l = try self.rel(link);
        try check(unsafe { rok_os_link(self.fd(), target.as_path().as_str(), l, 0) } as i64, self.shown(l));
    }

    pub fn hardlink<P: AsPath, Q: AsPath>(self, target: P, link: Q) throws (IoError) {
        let t = try self.rel(target);
        let l = try self.rel(link);
        try check(unsafe { rok_os_link(self.fd(), t, l, 1) } as i64, self.shown(l));
    }

    /// Release the handle (`root()` has none).
    pub fn close(self) throws (IoError) {
        unsafe {
            let fd = take_handle(self.fd, 0, -1);
            if fd < 0 { return; }
            try check(rok_os_close(fd) as i64, self.path);
        }
    }
}

impl Drop for Dir {
    fn drop(ref self) {
        unsafe {
            let fd = take_handle(self.fd, 0, -1);
            if fd >= 0 {
                _ = rok_os_close(fd);
            }
        }
    }
}

/// One directory entry, with its `lstat` metadata.
pub struct DirEntry {
    path: Path;
    name: str;
    meta: Metadata;
}

impl Debug for DirEntry {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"DirEntry({self.path:?})") }
}

impl DirEntry {
    /// The listed directory's path joined with the name.
    pub const fn path(self) -> Path { self.path }
    pub const fn file_name(self) -> str { self.name }
    /// Metadata of the entry itself (a symlink is not followed).
    pub const fn metadata(self) -> Metadata { self.meta }
    pub const fn file_type(self) -> FileType { self.meta.file_type() }
    pub const fn is_dir(self) -> bool { self.meta.is_dir() }
    pub const fn is_file(self) -> bool { self.meta.is_file() }
    pub const fn is_symlink(self) -> bool { self.meta.is_symlink() }
}

/// The entries of one directory, in the order the OS returns them
/// (`.` / `..` skipped): a `TryIterator` (`try for e in
/// fs::read_dir(p) { .. }`).
pub struct ReadDir {
    /// The `DIR*` (0 once closed), shared by copies of the handle.
    d: GcBuf<isize>;
    dir: DirView;
    base: str;
    /// Room for the next entry name.
    name: List<u8>;
}

/// The listed `Dir`'s descriptor and path: a view, not an owner (the
/// `Dir` stays with its owner).
struct DirView {
    fd: GcBuf<i32>;
    path: str;
}

impl DirView {
    const fn fd(self) -> i32 { unsafe { self.fd[0] } }

    const fn shown(self, p: str) -> str {
        if self.path == "" { return p; }
        Path::new(self.path).join(Path::new(p)).as_str()
    }
}

impl Debug for ReadDir {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("ReadDir") }
}

/// Room for any entry name (macOS `d_name` holds 1024 bytes).
const NAME_MAX: usize = 1024;

impl TryIterator for ReadDir {
    type Item = DirEntry;
    type Error = IoError;
    /// The next entry. A throw closes the stream: `next` gives `none`
    /// after it.
    fn next(ref self) throws (IoError) -> DirEntry | none {
        unsafe {
            let d = self.d[0];
            if d == 0 { return none; }
            let (buf, at, cap) = region(self.name);
            let n = rok_os_readdir(d, buf, at, cap);
            if n <= 0 {
                close_dir(self.d);
                if n < 0 { throw IoError::from_os_code((0 - n) as i32, self.dir.shown(self.base)); }
                return none;
            }
            let name = try text_of(list_of(self.name[0:n as usize])) catch e {
                close_dir(self.d);
                throw e;
            };
            let path = Path::new(self.base).join(Path::new(name));
            let meta = try stat_at(self.dir.fd(), path.as_str(), false, -1) catch e {
                close_dir(self.d);
                throw e.retold(self.dir.shown(path.as_str()));
            };
            let shown = Path::new(self.dir.shown(path.as_str()));
            DirEntry { path: shown, name: name, meta: meta }
        }
    }
}

/// `using rd = try fs::read_dir(p) { .. }` closes the stream even when
/// the loop stops early. A `ReadDir` held by a plain `let` and dropped
/// before its end keeps the stream open until the process exits.
impl Drop for ReadDir {
    fn drop(ref self) {
        close_dir(self.d);
    }
}

fn close_dir(cell: GcBuf<isize>) {
    unsafe {
        let d = take_handle(cell, 0, 0);
        if d != 0 {
            rok_os_closedir(d);
        }
    }
}

/// Recursive walk, depth first, the root first and each directory's
/// entries sorted by name (Go `filepath.WalkDir`). Symlinks are listed,
/// not followed. Each directory is read whole when reached, so a `Walk`
/// never holds a stream open (stopping early leaks nothing). An
/// unreadable directory throws its error from `next`; calling `next`
/// again goes on with the rest.
pub struct Walk {
    stack: List<DirEntry>;
    errors: List<IoError>;
}

impl Debug for Walk {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Walk") }
}

impl TryIterator for Walk {
    type Item = DirEntry;
    type Error = IoError;
    fn next(ref self) throws (IoError) -> DirEntry | none {
        if let err: IoError = self.errors.pop() { throw err; }
        let e = self.stack.pop()?;
        if e.meta.is_dir() {
            let kids: List<DirEntry> = List::new();
            let rd = try Dir::root().list(e.path.as_str()) catch x {
                self.errors.push(x);
                return e;
            };
            loop {
                let k = try rd.next() catch x { self.errors.push(x); continue; };
                match k {
                    x: DirEntry => kids.push(x),
                    none => break,
                }
            }
            kids.sort_by(|a: DirEntry, b: DirEntry| a.name.cmp(b.name));
            let i = kids.len();
            while i > 0 {
                i -= 1;
                self.stack.push(kids[i]);
            }
        }
        e
    }
}

// convenience functions (301.4) over Dir::root()

/// `File::open(path)`: an existing file, for reading. The other ways
/// of opening are on `File` and `Dir`.
pub fn open<P: AsPath>(path: P) throws (IoError) -> File { try Dir::root().open(path) }
/// `File::create(path)`: created or emptied, for writing.
pub fn create<P: AsPath>(path: P) throws (IoError) -> File { try Dir::root().create(path) }

pub fn read<P: AsPath>(path: P) throws (IoError) -> List<u8> {
    let f = try open(path);
    let r = try f.read_to_end() catch e { try f.close() catch _ {}; throw e; };
    try f.close();
    r
}

pub fn read_to_str<P: AsPath>(path: P) throws (IoError) -> str {
    let f = try open(path);
    let r = try f.read_to_str() catch e { try f.close() catch _ {}; throw e; };
    try f.close();
    r
}

/// Create or truncate `path` and write `data` (a `str` or `List<u8>`).
pub fn write<P: AsPath, D: AsBytes>(path: P, data: D) throws (IoError) {
    let f = try create(path);
    try f.write_all(data) catch e { try f.close() catch _ {}; throw e; };
    try f.close();
}

/// Write via a temp file in the same directory, `fsync`, `rename`,
/// then `fsync` the directory: readers see the old or the new file,
/// never a torn one.
pub fn write_atomic<P: AsPath, D: AsBytes>(path: P, data: D) throws (IoError) {
    let target = path.as_path();
    let name = target.file_name() ?? "";
    if name == "" { throw IoError::new(IoErrorKind::InvalidInput, f"{target}: no file name"); }
    let parent = target.parent() ?? Path::empty();
    // A fresh temp name: pid + the first free counter.
    let pid = unsafe { rok_os_getpid() };
    let n = 0;
    let tmp = Path::empty();
    let f = loop {
        tmp = parent.join(Path::new(f".{name}.tmp.{pid}.{n}"));
        let opened = try File::create_new(tmp) catch e {
            if e.kind() == IoErrorKind::AlreadyExists { n += 1; continue; }
            throw e;
        };
        break opened;
    };
    try stage(f, data.byte_slice(), tmp, target) catch e {
        try remove_file(tmp) catch _ {};
        throw e;
    };
    let dir_path = if parent.as_str() == "" { Path::new(".") } else { parent };
    let d = try Dir::root().open_dir(dir_path);
    try d.sync() catch _ {}; // some filesystems refuse fsync on a directory
    try d.close();
}

/// Closes `f` on every path.
fn stage(f: File, data: Slice<u8>, tmp: Path, target: Path) throws (IoError) {
    try f.write_all(data) catch e { try f.close() catch _ {}; throw e; };
    try f.sync_all() catch e { try f.close() catch _ {}; throw e; };
    try f.close();
    try rename(tmp, target);
}

pub fn metadata<P: AsPath>(path: P) throws (IoError) -> Metadata { try Dir::root().metadata(path) }
pub fn symlink_metadata<P: AsPath>(path: P) throws (IoError) -> Metadata {
    try Dir::root().symlink_metadata(path)
}
pub fn exists<P: AsPath>(path: P) -> bool { Dir::root().exists(path) }
pub fn create_dir<P: AsPath>(path: P) throws (IoError) { try Dir::root().create_dir(path); }
pub fn create_dir_all<P: AsPath>(path: P) throws (IoError) { try Dir::root().create_dir_all(path); }
pub fn remove_file<P: AsPath>(path: P) throws (IoError) { try Dir::root().remove_file(path); }
pub fn remove_dir<P: AsPath>(path: P) throws (IoError) { try Dir::root().remove_dir(path); }
pub fn remove_dir_all<P: AsPath>(path: P) throws (IoError) { try Dir::root().remove_dir_all(path); }
pub fn rename<P: AsPath, Q: AsPath>(from: P, to: Q) throws (IoError) { try Dir::root().rename(from, to); }
#[discardable]
pub fn copy<P: AsPath, Q: AsPath>(from: P, to: Q) throws (IoError) -> u64 { try Dir::root().copy(from, to) }
pub fn symlink<P: AsPath, Q: AsPath>(target: P, link: Q) throws (IoError) { try Dir::root().symlink(target, link); }
pub fn hardlink<P: AsPath, Q: AsPath>(target: P, link: Q) throws (IoError) { try Dir::root().hardlink(target, link); }
pub fn read_dir<P: AsPath>(path: P) throws (IoError) -> ReadDir {
    try Dir::root().list(try Dir::root().rel(path))
}
/// Set the permissions of `path` (a final symbolic link is followed).
/// Windows: only the read-only attribute.
pub fn set_permissions<P: AsPath>(path: P, perm: Permissions) throws (IoError) {
    try Dir::root().set_permissions(path, perm);
}

/// Everything under `root`, `root` included (see `Walk`).
pub fn walk<P: AsPath>(root: P) -> Walk {
    let p = root.as_path();
    let w = Walk { stack: List::new(), errors: List::new() };
    let first = try symlink_metadata(p) catch e { w.errors.push(e); return w; };
    w.stack.push(DirEntry { path: p, name: p.file_name() ?? p.as_str(), meta: first });
    w
}

// async convenience functions (see the top)

pub async fn open_async<P: AsPath>(path: P) throws (IoError) -> File {
    let p = path.as_path();
    try await off(|| try open(p))
}
pub async fn create_async<P: AsPath>(path: P) throws (IoError) -> File {
    let p = path.as_path();
    try await off(|| try create(p))
}
pub async fn read_async<P: AsPath>(path: P) throws (IoError) -> List<u8> {
    let p = path.as_path();
    try await off(|| try read(p))
}
pub async fn read_to_str_async<P: AsPath>(path: P) throws (IoError) -> str {
    let p = path.as_path();
    try await off(|| try read_to_str(p))
}
pub async fn write_async<P: AsPath, D: AsBytes>(path: P, data: D) throws (IoError) {
    let p = path.as_path();
    let s = unsafe { Handoff::new(data.byte_slice()) };
    try await off(|| try write(p, s.get()));
}
pub async fn write_atomic_async<P: AsPath, D: AsBytes>(path: P, data: D) throws (IoError) {
    let p = path.as_path();
    let s = unsafe { Handoff::new(data.byte_slice()) };
    try await off(|| try write_atomic(p, s.get()));
}
pub async fn metadata_async<P: AsPath>(path: P) throws (IoError) -> Metadata {
    let p = path.as_path();
    try await off(|| try metadata(p))
}
pub async fn symlink_metadata_async<P: AsPath>(path: P) throws (IoError) -> Metadata {
    let p = path.as_path();
    try await off(|| try symlink_metadata(p))
}
pub async fn exists_async<P: AsPath>(path: P) -> bool {
    let p = path.as_path();
    await task::spawn_blocking(|| exists(p))
}
pub async fn create_dir_async<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path();
    try await off(|| try create_dir(p));
}
pub async fn create_dir_all_async<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path();
    try await off(|| try create_dir_all(p));
}
pub async fn remove_file_async<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path();
    try await off(|| try remove_file(p));
}
pub async fn remove_dir_async<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path();
    try await off(|| try remove_dir(p));
}
pub async fn remove_dir_all_async<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path();
    try await off(|| try remove_dir_all(p));
}
pub async fn rename_async<P: AsPath, Q: AsPath>(from: P, to: Q) throws (IoError) {
    let a = from.as_path();
    let b = to.as_path();
    try await off(|| try rename(a, b));
}
pub async fn copy_async<P: AsPath, Q: AsPath>(from: P, to: Q) throws (IoError) -> u64 {
    let a = from.as_path();
    let b = to.as_path();
    try await off(|| try copy(a, b))
}
pub async fn symlink_async<P: AsPath, Q: AsPath>(target: P, link: Q) throws (IoError) {
    let a = target.as_path();
    let b = link.as_path();
    try await off(|| try symlink(a, b));
}
pub async fn hardlink_async<P: AsPath, Q: AsPath>(target: P, link: Q) throws (IoError) {
    let a = target.as_path();
    let b = link.as_path();
    try await off(|| try hardlink(a, b));
}
/// The entries of `path` as a `TryStream`, read in batches on a
/// blocking thread (`Dir::read_dir_async`).
pub async fn read_dir_async<P: AsPath>(path: P) throws (IoError) -> ReadDirStream {
    let p = path.as_path();
    let rd = try await off(|| try read_dir(p));
    stream_of(rd)
}
pub async fn set_permissions_async<P: AsPath>(path: P, perm: Permissions) throws (IoError) {
    let p = path.as_path();
    try await off(|| try set_permissions(p, perm));
}

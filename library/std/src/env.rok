// rok::std::env (stdlib spec 306): arguments, environment variables,
// directories.
//
// `var`, `vars`, `vars_os`, `set_var` and `remove_var` share one lock;
// nothing guards a `getenv` in C code, so `set_var` / `remove_var` stay
// `unsafe` (306.3).
// Names and values from the OS are bytes (Windows: its UTF-16 as WTF-8);
// `var` hands out the UTF-8 ones as `str`, `args` / `vars` replace what
// is not UTF-8 with U+FFFD, and the `*_os` forms keep the bytes.

use rok::core::io::{IoError, IoErrorKind};
use rok::std::sys::{check, fetch, text_of, list_of_str};
use rok::std::path::{Path, AsPath};
use rok::bare::mem::GcBuf;

/// Command-line arguments; `[0]` is the program name. Bytes that are not
/// UTF-8 become U+FFFD (`args_os` keeps them).
pub fn args() -> List<str> {
    let n = unsafe { rok_os_argc() };
    let out: List<str> = List::with_capacity(n);
    for i in 0..n {
        out.push(lossy(unsafe { rok_os_arg(i) }.as_bytes()));
    }
    out
}

/// `b` as text, each ill-formed part as U+FFFD (`str::from_utf8_lossy`).
/// Windows: a lone surrogate (its 3-byte WTF-8 form) is one.
fn lossy(b: Slice<u8>) -> str {
    if !WINDOWS { return str::from_utf8_lossy(b); }
    let out = StrBuf::new();
    let n = b.len();
    let from = 0usize;
    let i = 0usize;
    while i + 2 < n {
        // In UTF-8, 0xED is never followed by 0xA0..0xBF.
        if b[i] == 0xEDu8 && b[i + 1] >= 0xA0u8 {
            out.push_str(str::from_utf8_lossy(b[from:i]));
            out.push('\u{FFFD}');
            i += 3;
            from = i;
        } else {
            i += 1;
        }
    }
    out.push_str(str::from_utf8_lossy(b[from:n]));
    out.to_str()
}

/// The arguments as raw OS bytes.
pub fn args_os() -> List<RawStr> {
    let n = unsafe { rok_os_argc() };
    let out: List<RawStr> = List::with_capacity(n);
    for i in 0..n {
        out.push(RawStr { raw: list_of_str(unsafe { rok_os_arg(i) }) });
    }
    out
}

/// Bytes from the OS that need not be UTF-8 (`args_os`, `var_os`).
#[derive(Clone, PartialEq, Eq, Hash)]
pub struct RawStr {
    raw: List<u8>;
}

impl RawStr {
    /// Byte length.
    pub const fn len(self) -> usize { self.raw.len() }
    pub const fn is_empty(self) -> bool { self.raw.len() == 0 }

    /// The bytes as text; throws if they are not UTF-8.
    pub const fn to_str(self) throws (Utf8Error) -> str { try str::from_utf8(self.raw) }

    /// The text with each ill-formed part as U+FFFD (Windows: each lone
    /// surrogate).
    pub fn to_str_lossy(self) -> str { lossy(self.as_bytes()) }

    /// The bytes, as a read-only view (no copy).
    pub const fn as_bytes(self) -> Slice<u8> { self.raw[0:self.raw.len()] }
}

/// Windows: the bytes are the OS's UTF-16 as WTF-8 (a lone surrogate is
/// its 3-byte form), so they convert both ways without loss.
#[cfg(target_os = "windows")]
impl RawStr {
    /// UTF-16 units from the OS, lone surrogates allowed.
    pub fn from_wide(wide: Slice<u16>) -> RawStr {
        let out: List<u8> = List::with_capacity(wide.len());
        let n = wide.len();
        let i = 0usize;
        while i < n {
            let c = wide[i] as u32;
            if c >= 0xD800u32 && c < 0xDC00u32 && i + 1 < n {
                let lo = wide[i + 1] as u32;
                if lo >= 0xDC00u32 && lo < 0xE000u32 {
                    c = 0x10000u32 + ((c - 0xD800u32) << 10u32) + (lo - 0xDC00u32);
                    i += 1;
                }
            }
            if c < 0x80u32 {
                out.push(c as u8);
            } else if c < 0x800u32 {
                out.push((0xC0u32 | (c >> 6u32)) as u8);
                out.push((0x80u32 | (c & 0x3Fu32)) as u8);
            } else if c < 0x10000u32 {
                out.push((0xE0u32 | (c >> 12u32)) as u8);
                out.push((0x80u32 | ((c >> 6u32) & 0x3Fu32)) as u8);
                out.push((0x80u32 | (c & 0x3Fu32)) as u8);
            } else {
                out.push((0xF0u32 | (c >> 18u32)) as u8);
                out.push((0x80u32 | ((c >> 12u32) & 0x3Fu32)) as u8);
                out.push((0x80u32 | ((c >> 6u32) & 0x3Fu32)) as u8);
                out.push((0x80u32 | (c & 0x3Fu32)) as u8);
            }
            i += 1;
        }
        RawStr { raw: out }
    }

    /// The UTF-16 units, as a view of a list made for it.
    pub fn as_wide(self) -> Slice<u16> {
        let w = self.wide_list();
        w[0:w.len()]
    }

    fn wide_list(self) -> List<u16> {
        let out: List<u16> = List::with_capacity(self.raw.len());
        let b = self.raw;
        let n = b.len();
        let i = 0usize;
        while i < n {
            let lead = b[i] as u32;
            let (c, k) = if lead < 0x80u32 {
                (lead, 1usize)
            } else if lead < 0xE0u32 {
                (lead & 0x1Fu32, 2usize)
            } else if lead < 0xF0u32 {
                (lead & 0x0Fu32, 3usize)
            } else {
                (lead & 0x07u32, 4usize)
            };
            for j in 1..k {
                c = (c << 6u32) | (b[i + j] as u32 & 0x3Fu32);
            }
            if c >= 0x10000u32 {
                out.push((0xD800u32 + ((c - 0x10000u32) >> 10u32)) as u16);
                out.push((0xDC00u32 + ((c - 0x10000u32) & 0x3FFu32)) as u16);
            } else {
                out.push(c as u16);
            }
            i += k;
        }
        out
    }
}

impl Debug for RawStr {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        let shown = try f"RawStr({self.to_str():?})" catch _ { f"RawStr({self.len()} bytes)" };
        try f.write_str(shown)
    }
}

/// Why `var` gave no `str`.
#[derive(Clone, Copy, PartialEq, Eq)]
pub enum VarError {
    /// The variable does not exist.
    NotPresent,
    /// Its value is not UTF-8 (read it with `var_os`).
    NotUnicode,
}

impl VarError {
    pub const fn message(self) -> str {
        match self {
            VarError::NotPresent => "environment variable not found",
            VarError::NotUnicode => "environment variable is not valid UTF-8",
        }
    }
}

impl Display for VarError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}
impl Debug for VarError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            VarError::NotPresent => try f.write_str("NotPresent"),
            VarError::NotUnicode => try f.write_str("NotUnicode"),
        }
    }
}
impl Error for VarError {}

/// Rok's own environment reads and writes; C code does not take it.
static ENV_LOCK: RwLock<bool> = RwLock::new(false);

/// `name`'s value as bytes, or `none` when unset.
fn var_bytes(name: str) -> List<u8> | none {
    using g = ENV_LOCK.read() {
        return try fetch(|b: GcBuf<u8>, at: usize, n: usize| unsafe { rok_os_getenv(name, b, at, n) }, name)
            catch _ { none };
    }
}

/// `name`'s value; `NotPresent` when unset, `NotUnicode` when not UTF-8.
pub fn var(name: str) throws (VarError) -> str {
    let bytes = match var_bytes(name) { b: List<u8> => b, none => throw VarError::NotPresent };
    try text_of(bytes) catch _ { throw VarError::NotUnicode; }
}

/// `name`'s value as raw bytes, or `none`.
pub fn var_os(name: str) -> RawStr | none {
    RawStr { raw: var_bytes(name)? }
}

/// `var(name)` or `none`.
fn var_opt(name: str) -> str | none {
    try text_of(var_bytes(name)?) catch _ { none }
}

/// `InvalidInput` for a name that is empty or holds `=` or NUL, on every
/// target.
fn check_name(name: str) throws (IoError) {
    if name == "" || name.contains("=") || name.contains("\0") {
        throw IoError::new(IoErrorKind::InvalidInput, f"invalid environment variable name {name:?}");
    }
}

/// Set `name` to `value` for this process and the children it spawns
/// later (`Command::env` sets one child's alone). Throws `InvalidInput`
/// for a name that is empty or holds `=` or NUL, or a value holding NUL;
/// else the OS error.
///
/// Safety: no other thread may read or write the environment during the
/// call, other than through this module (C code calling `getenv`, for
/// one). Sound in a single-threaded program, and on Windows.
pub unsafe fn set_var(name: str, value: str) throws (IoError) {
    try check_name(name);
    if value.contains("\0") {
        throw IoError::new(IoErrorKind::InvalidInput, f"value of environment variable {name} holds a NUL");
    }
    using g = ENV_LOCK.write() {
        try check(unsafe { rok_os_setenv(name, value, 0) } as i64, name);
    }
}

/// Unset `name` (unset already is not an error); throws as `set_var`.
///
/// Safety: as `set_var`.
pub unsafe fn remove_var(name: str) throws (IoError) {
    try check_name(name);
    using g = ENV_LOCK.write() {
        try check(unsafe { rok_os_setenv(name, "", 1) } as i64, name);
    }
}

/// Every `(name, value)` pair, a snapshot taken lazily as it goes. Bytes
/// that are not UTF-8 become U+FFFD (`vars_os` keeps them).
pub const fn vars() -> Vars { Vars { pos: 0 } }

pub struct Vars {
    pos: usize;
}

impl Debug for Vars {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Vars") }
}

impl Iterator for Vars {
    type Item = (str, str);
    fn next(ref self) -> (str, str) | none {
        loop {
            let kv = "";
            using g = ENV_LOCK.read() { kv = unsafe { rok_os_env_at(self.pos) }; }
            if kv.len() == 0 { return none; }
            self.pos += 1;
            let eq = kv.find("=") ?? 0usize;
            // Skip malformed entries (no `=`, or an empty name).
            if eq > 0 { return (lossy(kv[:eq].as_bytes()), lossy(kv[eq + 1:].as_bytes())); }
        }
    }
}

/// `vars` as raw OS bytes (names and values need not be UTF-8).
pub const fn vars_os() -> VarsOs { VarsOs { pos: 0 } }

pub struct VarsOs {
    pos: usize;
}

impl Debug for VarsOs {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("VarsOs") }
}

impl Iterator for VarsOs {
    type Item = (RawStr, RawStr);
    fn next(ref self) -> (RawStr, RawStr) | none {
        loop {
            let kv = "";
            using g = ENV_LOCK.read() { kv = unsafe { rok_os_env_at(self.pos) }; }
            if kv.len() == 0 { return none; }
            self.pos += 1;
            // `=` is ASCII, so the byte split is exact even in non-UTF-8.
            let eq = kv.find("=") ?? 0usize;
            if eq > 0 { return (RawStr { raw: list_of_str(kv[:eq]) }, RawStr { raw: list_of_str(kv[eq + 1:]) }); }
        }
    }
}

pub fn current_dir() throws (IoError) -> Path {
    let cwd = try fetch(|b: GcBuf<u8>, at: usize, n: usize| unsafe { rok_os_getcwd(b, at, n) }, "getcwd");
    Path::new(try text_of(cwd))
}

pub fn set_current_dir<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path().as_str();
    try check(unsafe { rok_os_chdir(p) } as i64, p);
}

/// `$HOME` (Windows: `%USERPROFILE%`).
pub fn home_dir() -> Path | none {
    let h = var_opt(if WINDOWS { "USERPROFILE" } else { "HOME" })?;
    if h == "" { return none; }
    Path::new(h)
}

/// `$TMPDIR`, else `/tmp`. Windows: the first set of `%TMP%`, `%TEMP%`,
/// `%USERPROFILE%`, `%SystemRoot%` (as `GetTempPath2W`).
pub fn temp_dir() -> Path {
    if WINDOWS {
        for v in ["TMP", "TEMP", "USERPROFILE", "SystemRoot"] {
            let t = var_opt(v) ?? "";
            if t != "" { return Path::new(t); }
        }
        return Path::new("C:\\Windows");
    }
    let t = var_opt("TMPDIR") ?? "";
    if t == "" { return Path::new("/tmp"); }
    Path::new(t)
}

const MACOS: bool = cfg!(target_os = "macos");
const WINDOWS: bool = cfg!(target_os = "windows");
/// The `PATH` list separator.
#[cfg(target_os = "windows")]
const LIST_SEP: str = ";";
#[cfg(not(target_os = "windows"))]
const LIST_SEP: str = ":";

/// macOS: `~/Library/<mac>`; Windows: `%<win>%`; elsewhere the XDG
/// variable `xdg` when it holds an absolute path, else `~/<home_rel>`.
/// `none` without a home (or the Windows variable).
fn user_dir(mac: str, win: str, xdg: str, home_rel: str) -> Path | none {
    if WINDOWS {
        let w = var_opt(win)?;
        if w == "" { return none; }
        return Path::new(w);
    }
    if !MACOS {
        let x = var_opt(xdg) ?? "";
        if x.starts_with("/") { return Path::new(x); }
    }
    let h = home_dir()?;
    if MACOS { return h / "Library" / mac; }
    h / home_rel
}

/// Per-user configuration: `~/Library/Application Support`,
/// `%APPDATA%`, or `$XDG_CONFIG_HOME` / `~/.config`.
pub fn config_dir() -> Path | none { user_dir("Application Support", "APPDATA", "XDG_CONFIG_HOME", ".config") }
/// Per-user cache: `~/Library/Caches`, `%LOCALAPPDATA%`, or
/// `$XDG_CACHE_HOME` / `~/.cache`.
pub fn cache_dir() -> Path | none { user_dir("Caches", "LOCALAPPDATA", "XDG_CACHE_HOME", ".cache") }
/// Per-user data: `~/Library/Application Support`, `%APPDATA%`, or
/// `$XDG_DATA_HOME` / `~/.local/share`.
pub fn data_dir() -> Path | none { user_dir("Application Support", "APPDATA", "XDG_DATA_HOME", ".local/share") }

/// `paths` split on `:` (Windows: `;`, `"` quoting dropped); empty
/// pieces dropped.
pub const fn split_paths(paths: str) -> List<Path> {
    let out: List<Path> = List::new();
    for p in paths.split(LIST_SEP) {
        let q = if WINDOWS { p.replace("\"", "") } else { p };
        if q != "" { out.push(Path::new(q)); }
    }
    out
}

/// `paths` joined with `:` (Windows: `;`), the `PATH` form; throws if one
/// holds the separator (or, on Windows, a `"`).
pub const fn join_paths<I: IntoIterator<Item = P>, P: AsPath>(paths: I) throws (JoinPathsError) -> str {
    let out = StrBuf::new();
    let first = true;
    for p in paths {
        let s = p.as_path().as_str();
        if s.contains(LIST_SEP) || (WINDOWS && s.contains("\"")) { throw JoinPathsError { path: s }; }
        if !first { out.push_str(LIST_SEP); }
        out.push_str(s);
        first = false;
    }
    out.to_str()
}

/// A `join_paths` entry that holds the separator.
#[derive(Clone, PartialEq, Eq)]
pub struct JoinPathsError {
    path: str;
}

impl JoinPathsError {
    /// The path that cannot be joined.
    pub const fn path(self) -> str { self.path }
    pub const fn message(self) -> str { f"path {self.path:?} contains the separator `{LIST_SEP}`" }
}

impl Display for JoinPathsError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}
impl Debug for JoinPathsError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"JoinPathsError({self.path:?})") }
}
impl Error for JoinPathsError {}

/// The running executable's absolute path.
pub fn current_exe() throws (IoError) -> Path {
    let exe = try fetch(|b: GcBuf<u8>, at: usize, n: usize| unsafe { rok_os_current_exe(b, at, n) }, "current_exe");
    Path::new(try text_of(exe))
}

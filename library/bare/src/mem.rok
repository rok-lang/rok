// rok::bare::mem - raw memory operations, `Pod` and bit casts (stdlib
// spec 1.2.5 / 1.2.6 / 1.3).
//
// A bit cast goes through a scratch block outside the GC (a generic
// value has no address of its own): the value is stored there as `A`
// and loaded as `B`, with nothing in between that could collect.
// `reinterpret` checks the sizes when called (the spec's `where
// sizeof::<A>() == sizeof::<B>()` has no compile-time form yet).

use rok::bare::ptr::{ConstPtr, Ptr};

/// Size of `T` in bytes.
#[intrinsic("rok.size_of")]
pub fn size_of<T>() -> usize;

/// Alignment of `T` in bytes.
#[intrinsic("rok.align_of")]
pub fn align_of<T>() -> usize;

extern "rok" {
    fn rok_alloc_raw(size: usize, align: usize, zeroed: i32) -> usize;
    fn rok_free(ptr: usize);
}

// `GcBuf<T>` (stdlib 2.9.12, re-exported as
// `rok::core::collections::raw::GcBuf`): one GC reference to an object
// holding a run of `T`s, compiler-known. The functions are compiler
// intrinsics (unchecked indexing); their bodies never run.

pub struct GcBuf<T> {}

/// The method forms of `buf_new` / `buf_get` / `buf_set` (2.9.12).
impl<T> GcBuf<T> {
    pub const unsafe fn new(len: usize) -> GcBuf<T> { unsafe { buf_new(len) } }
    pub const unsafe fn get(self, i: usize) -> T { unsafe { buf_get(self, i) } }
    pub const unsafe fn set(self, i: usize, v: T) { unsafe { buf_set(self, i, v); } }
}

/// A zeroed buffer of `len` elements; `T` comes from the slot's type.
#[intrinsic("rok.buf_new")]
pub unsafe fn buf_new<T>(len: usize) -> GcBuf<T> {
    buf_new(len)
}

/// Element `i` (no bounds check).
#[intrinsic("rok.buf_get")]
pub unsafe fn buf_get<T>(buf: GcBuf<T>, i: usize) -> T {
    buf_get(buf, i)
}

/// Store element `i` (no bounds check).
#[intrinsic("rok.buf_set")]
pub unsafe fn buf_set<T>(buf: GcBuf<T>, i: usize, v: T) {
    buf_set(buf, i, v);
}

/// Whether `a` and `b` are one buffer (identity, not contents). Pins
/// nothing.
#[intrinsic("rok.buf_same")]
pub fn buf_same<T>(a: GcBuf<T>, b: GcBuf<T>) -> bool {
    buf_same(a, b)
}

/// Plain old data: every bit pattern of the type is a valid value, its
/// layout is fixed and it has no `Drop` (spec 1.3.3). User structs opt
/// in with `#[derive(Pod)]` (`#[repr(C)]` / `#[repr(transparent)]`).
pub trait Pod {}

impl Pod for i8 {}
impl Pod for i16 {}
impl Pod for i32 {}
impl Pod for i64 {}
impl Pod for isize {}
impl Pod for u8 {}
impl Pod for u16 {}
impl Pod for u32 {}
impl Pod for u64 {}
impl Pod for usize {}
impl Pod for f32 {}
impl Pod for f64 {}
impl Pod for bool {}
impl Pod for char {}
impl Pod for c_char {}
impl<T: Pod, const N: usize> Pod for [T; N] {}
impl<A: Pod> Pod for (A,) {}
impl<A: Pod, B: Pod> Pod for (A, B) {}
impl<A: Pod, B: Pod, C: Pod> Pod for (A, B, C) {}
impl<A: Pod, B: Pod, C: Pod, D: Pod> Pod for (A, B, C, D) {}

#[impl_derive(Pod)]
pub @derive {
    impl rok::bare::mem::Pod for @Self {}
}

/// The bits of `a` as a `B`; both are `Pod` and the same size (a size
/// mismatch panics).
#[track_caller]
pub fn reinterpret<A: Pod, B: Pod>(a: A) -> B {
    if size_of::<A>() != size_of::<B>() {
        panic(f"mem::reinterpret: {size_of::<A>()} bytes do not fit {size_of::<B>()}; both types must have the same size");
    }
    unsafe { transmute_unchecked(a) }
}

/// The bits of `a` as a `B`, unchecked: validity, size and the GC
/// references inside are the caller's problem.
#[track_caller]
pub unsafe fn transmute_unchecked<A, B>(a: A) -> B {
    let size = if size_of::<A>() > size_of::<B>() { size_of::<A>() } else { size_of::<B>() };
    let align = if align_of::<A>() > align_of::<B>() { align_of::<A>() } else { align_of::<B>() };
    let at = rok_alloc_raw(if size == 0 { 1 } else { size }, align, 1);
    if at == 0 {
        panic("mem::transmute_unchecked: out of memory");
    }
    Ptr::<A>::dangling().with_addr(at).write(a);
    let b = Ptr::<B>::dangling().with_addr(at).read();
    rok_free(at);
    b
}

/// Size of `T` (the value's own type; rok has no unsized values yet).
pub const fn size_of_val<T>(val: T) -> usize { size_of::<T>() }
pub const fn align_of_val<T>(val: T) -> usize { align_of::<T>() }
pub const fn min_align_of<T>() -> usize { align_of::<T>() }

pub unsafe fn read<T>(src: ConstPtr<T>) -> T { src.read() }
pub unsafe fn write<T>(dst: Ptr<T>, value: T) { dst.write(value); }

/// Copy `count` `T`s; the ranges may overlap.
pub unsafe fn copy<T>(src: ConstPtr<T>, dst: Ptr<T>, count: usize) {
    if dst.addr() <= src.addr() {
        for i in 0..count {
            dst.add(i).write(src.add(i).read());
        }
    } else {
        let i = count;
        while i > 0 {
            i -= 1;
            dst.add(i).write(src.add(i).read());
        }
    }
}

/// Copy `count` `T`s between ranges that do not overlap.
pub unsafe fn copy_nonoverlapping<T>(src: ConstPtr<T>, dst: Ptr<T>, count: usize) {
    for i in 0..count {
        dst.add(i).write(src.add(i).read());
    }
}

/// Set `count * size_of::<T>()` bytes at `dst` to `value`.
pub unsafe fn write_bytes<T>(dst: Ptr<T>, value: u8, count: usize) {
    let bytes: Ptr<u8> = dst.cast::<u8>();
    let n = count * size_of::<T>();
    for i in 0..n {
        bytes.add(i).write(value);
    }
}

pub unsafe fn swap<T>(a: Ptr<T>, b: Ptr<T>) {
    let t = a.read();
    a.write(b.read());
    b.write(t);
}

/// Store `value` at `dst` and return what was there.
#[discardable]
pub unsafe fn replace<T>(dst: Ptr<T>, value: T) -> T {
    let old = dst.read();
    dst.write(value);
    old
}

/// Run the `Drop` of the `T` at `p` (and of its fields'); the memory
/// stays.
#[intrinsic("rok.drop_in_place")]
pub unsafe fn drop_in_place<T>(p: Ptr<T>);

/// A `T` that may not be initialized yet (spec 1.3.2): same size and
/// alignment as `T`, and `as_mut_ptr` points at the variable itself.
/// Its bits start zeroed (`uninit` is `zeroed`: a GC reference in it is
/// null until written, never garbage).
#[repr(transparent)]
pub struct MaybeUninit<T> {
    value: T;
}

impl<T> MaybeUninit<T> {
    pub fn uninit() -> MaybeUninit<T> { MaybeUninit::zeroed() }

    #[track_caller]
    pub fn zeroed() -> MaybeUninit<T> {
        let size = if size_of::<T>() == 0 { 1 } else { size_of::<T>() };
        unsafe {
            let at = rok_alloc_raw(size, align_of::<T>(), 1);
            if at == 0 {
                panic("MaybeUninit::zeroed: out of memory");
            }
            let value = Ptr::<T>::dangling().with_addr(at).read();
            rok_free(at);
            MaybeUninit { value: value }
        }
    }

    pub const fn new(value: T) -> MaybeUninit<T> { MaybeUninit { value: value } }

    pub const fn write(ref self, value: T) { self.value = value; }

    /// A pointer to this variable's `T` (the receiver must be a place).
    #[intrinsic("rok.addr_of")]
    pub fn as_ptr(self) -> ConstPtr<T>;
    #[intrinsic("rok.addr_of")]
    pub fn as_mut_ptr(ref self) -> Ptr<T>;

    /// The value; UB unless it was initialized (`write`, `new`, or
    /// through `as_mut_ptr`).
    pub const unsafe fn assume_init(self) -> T { self.value }
}

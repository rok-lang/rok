// rok::bare::ffi - NUL-terminated C strings (stdlib 1.7.2); `wit` is
// what the WIT bindings run on (1.8).
//
// `CStr` and `CString` keep their bytes, NUL included, in one `str`
// object, so `as_ptr` holds as `str::as_ptr` does (2.15.2).
// `CStr::from_ptr` copies.

pub mod wit;

use rok::bare::ptr::ConstPtr;
use rok::bare::mem::{GcBuf, buf_new};

extern "rok" {
    fn rok_str_from_buf(buf: GcBuf<u8>, off: usize, len: usize) -> str;
}

/// An interior NUL byte, at `position` (`CString::new`).
// By hand: bare cannot use the derives, which expand to core paths.
pub struct NulError {
    position: usize;
}

impl NulError {
    /// The byte offset of the NUL.
    pub const fn position(self) -> usize { self.position }
    pub const fn message(self) -> str { f"nul byte found at position {self.position}" }
}

impl PartialEq for NulError {
    const fn eq(self, rhs: NulError) -> bool { self.position == rhs.position }
}

impl Eq for NulError {}

impl Clone for NulError {
    fn clone(self) -> NulError { NulError { position: self.position } }
}

impl Display for NulError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message()) }
}

impl Debug for NulError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"NulError({self.position})") }
}

impl Error for NulError {}

/// Bytes that are not one C string: no final NUL, or one before it.
pub struct FromBytesWithNulError {
    message: str;
}

impl FromBytesWithNulError {
    pub const fn message(self) -> str { self.message }
}

impl PartialEq for FromBytesWithNulError {
    const fn eq(self, rhs: FromBytesWithNulError) -> bool { self.message == rhs.message }
}

impl Eq for FromBytesWithNulError {}

impl Clone for FromBytesWithNulError {
    fn clone(self) -> FromBytesWithNulError { FromBytesWithNulError { message: self.message } }
}

impl Display for FromBytesWithNulError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.message) }
}

impl Debug for FromBytesWithNulError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"FromBytesWithNulError({self.message})")
    }
}

impl Error for FromBytesWithNulError {}

/// `bytes` and a final NUL as one `str` object.
const fn with_nul(bytes: Slice<u8>) -> str {
    let n = bytes.len();
    unsafe {
        let buf: GcBuf<u8> = buf_new(n + 1);
        for i in 0..n {
            buf[i] = bytes[i];
        }
        buf[n] = 0u8;
        rok_str_from_buf(buf, 0, n + 1)
    }
}

/// The index of the first NUL in `bytes`.
const fn nul_in(bytes: Slice<u8>) -> usize | none {
    for i in 0..bytes.len() {
        if bytes[i] == 0u8 {
            return i;
        }
    }
    none
}

/// A NUL-terminated string (1.7.2).
pub struct CStr {
    /// The bytes and the NUL.
    s: str;
}

impl CStr {
    /// The C string at `p` (copied in); `none` for a null pointer.
    /// Without a NUL terminator the behavior is undefined.
    #[deprecated_safe("`p` must be null or point at a live NUL-terminated string")]
    pub fn from_ptr(p: ConstPtr<c_char>) -> CStr | none {
        if p.addr() == 0 {
            return none;
        }
        let at: ConstPtr<u8> = ConstPtr::<u8>::dangling().with_addr(p.addr());
        let n = 0usize;
        while unsafe { at.add(n).read() } != 0u8 {
            n += 1;
        }
        let bytes: List<u8> = [];
        for i in 0..n {
            bytes.push(unsafe { at.add(i).read() });
        }
        CStr { s: with_nul(bytes[0:n]) }
    }

    /// `bytes` when the last one is the only NUL.
    pub const fn from_bytes_with_nul<B: AsBytes>(bytes: B) throws (FromBytesWithNulError) -> CStr {
        let b = bytes.byte_slice();
        let n = b.len();
        match nul_in(b) {
            i: usize if i + 1 == n => CStr { s: with_nul(b[0:i]) },
            i: usize => throw FromBytesWithNulError { message: f"interior nul byte at {i}" },
            none => throw FromBytesWithNulError { message: "data provided is not nul terminated" },
        }
    }

    /// `bytes`, whose last byte must be the only NUL (not checked).
    /// Empty `bytes` gives the empty string.
    pub const fn from_bytes_with_nul_unchecked<B: AsBytes>(bytes: B) -> CStr {
        let b = bytes.byte_slice();
        let n = b.len();
        if n == 0 { return CStr { s: with_nul(b) }; }
        CStr { s: with_nul(b[0:n - 1]) }
    }

    pub fn as_ptr(self) -> ConstPtr<c_char> {
        ConstPtr::<c_char>::dangling().with_addr(self.s.as_ptr().addr())
    }

    /// The bytes without the NUL.
    pub fn as_bytes(self) -> Slice<u8> { self.s.as_bytes()[0:self.len()] }

    pub fn as_bytes_with_nul(self) -> Slice<u8> { self.s.as_bytes() }

    pub fn to_str(self) throws (Utf8Error) -> str { try str::from_utf8(self.as_bytes()) }

    /// Bytes before the NUL.
    pub const fn len(self) -> usize { self.s.len() - 1 }
}

/// An owned NUL-terminated string (1.7.2).
pub struct CString {
    c: CStr;
}

impl CString {
    /// `bytes` and a NUL; throws if `bytes` has a NUL of its own. A
    /// `str` gives its UTF-8.
    pub const fn new<B: AsBytes>(bytes: B) throws (NulError) -> CString {
        let b = bytes.byte_slice();
        if let i: usize = nul_in(b) {
            throw NulError { position: i };
        }
        CString { c: CStr { s: with_nul(b) } }
    }

    pub const fn as_c_str(self) -> CStr { self.c }
    pub fn as_ptr(self) -> ConstPtr<c_char> { self.c.as_ptr() }

    /// The bytes without the NUL.
    pub fn into_bytes(self) -> List<u8> { self.c.as_bytes().to_list() }

    pub fn into_bytes_with_nul(self) -> List<u8> { self.c.as_bytes_with_nul().to_list() }
}

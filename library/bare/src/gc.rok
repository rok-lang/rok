// rok::bare::gc - keeping GC objects in place for raw pointers.
// A `Pinned<T>` from `pin` keeps the object holding `T`'s
// data where it is (`rok_gc_pin`, counted) until it is released, where
// its owner leaves scope. `GcPtr<T>` is a managed reference to one `T`
// on the GC heap; `Weak<T>` refers to a `GcPtr<T>`'s object
// without keeping it alive (a `WEAK_REF` word).

use rok::bare::mem::transmute_unchecked;
use rok::bare::mem::size_of;
use rok::bare::ptr::{ConstPtr, ManyPtr, Ptr};
use rok::bare::mem::{GcBuf, buf_get, buf_new, buf_same, buf_set};

extern "rok" {
    fn rok_gc_collect();
    fn rok_gc_pin(obj: GcBuf<u8>) -> GcBuf<u8>;
    fn rok_gc_unpin(obj: GcBuf<u8>);
    fn rok_gc_weak_new(obj: GcBuf<u8>) -> GcBuf<u8>;
    fn rok_gc_weak_get(cell: GcBuf<u8>) -> GcBuf<u8>;
}

/// A full collection now (it may move every unpinned object).
pub fn collect() { unsafe { rok_gc_collect() } }

/// What `pin` keeps in place for a value: the GC object holding its
/// data, `none` when nothing can move (an empty list; a `str`, which
/// stays in place while the `Pinned` holding it is in scope).
#[sealed]
pub trait Pinnable {
    /// The GC object holding the value's data; `none` when nothing can
    /// move.
    #[internal("write `pin(x)` to keep a value in place")]
    fn gc_object(self) -> GcBuf<u8> | none;
}

impl<T> Pinnable for List<T> {
    #[internal("write `pin(x)` to keep a value in place")]
    fn gc_object(self) -> GcBuf<u8> | none {
        if self.is_empty() {
            return none;
        }
        let (buf, _, _) = unsafe { self[0:self.len()].raw_parts() };
        let erased: GcBuf<u8> = unsafe { transmute_unchecked(buf) };
        erased
    }
}

impl Pinnable for str {
    #[internal("write `pin(x)` to keep a value in place")]
    const fn gc_object(self) -> GcBuf<u8> | none { none }
}

impl<T> Pinnable for GcPtr<T> {
    #[internal("write `pin(x)` to keep a value in place")]
    fn gc_object(self) -> GcBuf<u8> | none {
        let erased: GcBuf<u8> = unsafe { transmute_unchecked(self.obj) };
        erased
    }
}

/// A reference to a GC object holding one `T`. Copies share the
/// object. The collector traces it from every frame and object that
/// holds it and updates it when the object moves; a raw `Ptr<T>` to the
/// value exists only under a pin (`Pinned<GcPtr<T>>::as_value_ptr`).
pub struct GcPtr<T> {
    obj: GcBuf<T>;
}

impl<T> Debug for GcPtr<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("GcPtr") }
}

// Shares its object like `List`.
impl<T> !Sync for GcPtr<T> {}

impl<T> GcPtr<T> {
    /// A new object holding `value`.
    pub const fn new(value: T) -> GcPtr<T> {
        let obj: GcBuf<T> = unsafe { buf_new(1) };
        unsafe { buf_set(obj, 0, value) };
        GcPtr { obj }
    }

    /// The value.
    pub const fn get(self) -> T { unsafe { buf_get(self.obj, 0) } }

    /// Replace the value; every copy sees it.
    pub const fn set(self, value: T) { unsafe { buf_set(self.obj, 0, value) }; }

    /// Whether `self` and `other` are one object (identity, not value).
    pub const fn same(self, other: GcPtr<T>) -> bool { buf_same(self.obj, other.obj) }
}

/// A reference to a `GcPtr<T>`'s object that does not keep it alive:
/// once a collection finds the object unreachable
/// except through weak references, it frees it and every `Weak` to it
/// reads `none` from then on. For caches and observers.
pub struct Weak<T> {
    /// A runtime weak cell: its one word is a `WEAK_REF`.
    cell: GcBuf<GcPtr<T>>;
}

impl<T> Debug for Weak<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Weak") }
}

impl<T> !Sync for Weak<T> {}
// A hand-off cannot copy what a weak reference names,
// so it stays with its thread.
impl<T> !Send for Weak<T> {}

impl<T> Weak<T> {
    /// A weak reference to `target`'s object.
    pub fn new(target: GcPtr<T>) -> Weak<T> {
        let obj: GcBuf<u8> = unsafe { transmute_unchecked(target.obj) };
        let cell: GcBuf<GcPtr<T>> = unsafe { transmute_unchecked(rok_gc_weak_new(obj)) };
        Weak { cell }
    }

    /// The object, `none` once it was collected.
    pub fn get(self) -> GcPtr<T> | none {
        let erased: GcBuf<u8> = unsafe { transmute_unchecked(self.cell) };
        let obj = unsafe { rok_gc_weak_get(erased) };
        let at: usize = unsafe { transmute_unchecked(obj) };
        if at == 0 {
            return none;
        }
        let typed: GcBuf<T> = unsafe { transmute_unchecked(obj) };
        GcPtr { obj: typed }
    }
}

/// `obj`'s data held in place.
pub struct Pinned<T> {
    obj: T;
    held: GcBuf<u8> | none;
}

impl<T> Debug for Pinned<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Pinned") }
}

/// Pin `obj`'s data until the returned guard is released, where its
/// owner leaves scope.
pub fn pin<T: Pinnable>(obj: T) -> Pinned<T> {
    let held = obj.gc_object();
    if let b: GcBuf<u8> = held {
        unsafe { rok_gc_pin(b) };
    }
    Pinned { obj, held }
}

impl<T> Pinned<T> {
    /// The pinned object.
    pub fn obj(self) -> T { self.obj }
}

impl<T> Pinned<List<T>> {
    /// The list's first element; dangling for an empty list.
    pub fn as_data_ptr(self) -> Ptr<T> {
        match self.held {
            b: GcBuf<u8> => {
                let (_, start, _) = unsafe { self.obj[0:self.obj.len()].raw_parts() };
                let at: usize = unsafe { transmute_unchecked(b) };
                // The payload follows the 16-byte object header.
                Ptr::<T>::dangling().with_addr(at + 16 + start * size_of::<T>())
            }
            none => Ptr::<T>::dangling(),
        }
    }

    /// `as_data_ptr` as a pointer to the run of elements.
    pub fn as_data_many_ptr(self) -> ManyPtr<T> { self.as_data_ptr().as_many() }
}

impl<T> Pinned<GcPtr<T>> {
    /// The value in the pinned object.
    pub fn as_value_ptr(self) -> Ptr<T> {
        let at: usize = unsafe { transmute_unchecked(self.obj.obj) };
        // The payload follows the 16-byte object header.
        Ptr::<T>::dangling().with_addr(at + 16)
    }
}

impl Pinned<str> {
    /// The UTF-8 bytes (no NUL promised).
    pub fn as_bytes_ptr(self) -> ConstPtr<u8> { self.obj.as_ptr() }

    /// The bytes as `c_char`s; NUL termination is not promised (use
    /// `ffi::CString`).
    pub fn as_c_ptr(self) -> ConstPtr<c_char> {
        ConstPtr::<c_char>::dangling().with_addr(self.obj.as_ptr().addr())
    }
}

impl<T> Drop for Pinned<T> {
    fn drop(ref self) {
        if let b: GcBuf<u8> = self.held {
            unsafe { rok_gc_unpin(b) };
        }
    }
}

// rok::bare - raw pointers, transmute, raw allocation, pinning and
// volatile access, over the runtime's `extern "rok"` symbols only. Never
// in the prelude: code that needs it says `use rok::bare::..`.

pub mod alloc;
pub mod ffi;
pub mod gc;
pub mod mem;
pub mod ptr;
pub mod volatile;

// Spec 1.2: the named casts live at the tier root.
pub use ptr::{align_cast, align_cast_unchecked, const_cast, ptr_cast};
pub use mem::{Pod, reinterpret, transmute_unchecked};

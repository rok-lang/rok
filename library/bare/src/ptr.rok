// rok::bare::ptr - raw pointers. A pointer is its
// address; reading / writing through it is `unsafe`.
//
// Provenance is not tracked at run time: `expose_provenance` /
// `from_exposed_provenance` are the address itself, and the latter is
// `unsafe` (it makes a pointer out of a plain integer). `Ptr` /
// `ConstPtr` / `ManyPtr` are never null: `#[niche(0)]` makes
// `Ptr<T> | none` one address, null = `none`.

// Compiler intrinsics over a pointer struct (field 0 = address); `T` is
// the pointer's type argument.
#[intrinsic("rok.ptr.read")]
unsafe fn raw_read<P, T>(p: P) -> T;
#[intrinsic("rok.ptr.write")]
unsafe fn raw_write<P, T>(p: P, value: T);
#[intrinsic("rok.ptr.read_volatile")]
unsafe fn raw_read_volatile<P, T>(p: P) -> T;
#[intrinsic("rok.ptr.write_volatile")]
unsafe fn raw_write_volatile<P, T>(p: P, value: T);

use rok::bare::mem::{align_of, size_of};

/// A non-null, mutable pointer to one `T` (C `T*`).
#[repr(transparent)]
#[niche(0)]
pub struct Ptr<T> {
    address: usize;
}

impl<T> Debug for Ptr<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"Ptr({self.address:#x})") }
}

// An address is a value: compared, ordered and hashed by address.
impl<T> Clone for Ptr<T> {
    const fn clone(self) -> Ptr<T> { self }
}
impl<T> Copy for Ptr<T> {}
impl<T> PartialEq for Ptr<T> {
    const fn eq(self, rhs: Ptr<T>) -> bool { self.address == rhs.address }
}
impl<T> Eq for Ptr<T> {}
impl<T> PartialOrd for Ptr<T> {
    const fn lt(self, rhs: Ptr<T>) -> bool { self.address < rhs.address }
    const fn gt(self, rhs: Ptr<T>) -> bool { self.address > rhs.address }
    const fn le(self, rhs: Ptr<T>) -> bool { self.address <= rhs.address }
    const fn ge(self, rhs: Ptr<T>) -> bool { self.address >= rhs.address }
}
impl<T> Ord for Ptr<T> {
    const fn cmp(self, rhs: Ptr<T>) -> Ordering { self.address.cmp(rhs.address) }
}
impl<T> Hash for Ptr<T> {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_usize(self.address) }
}

impl<T> Ptr<T> {
    /// Well aligned, never dereferenceable.
    pub const fn dangling() -> Ptr<T> { Ptr { address: align_of::<T>() } }
    /// Always `none` (a `Ptr` is never null).
    pub fn null() -> Ptr<T> | none { none }

    /// The address (provenance is lost).
    pub const fn addr(self) -> usize { self.address }
    /// The same pointer at address `addr`.
    pub const fn with_addr(self, addr: usize) -> Ptr<T> { Ptr { address: addr } }
    /// The same pointer at the address `f` maps the current one to.
    pub const fn map_addr(self, f: fn(usize) -> usize) -> Ptr<T> { Ptr { address: f(self.address) } }

    /// `count` elements further (`count * size_of::<T>()` bytes).
    pub fn offset(self, count: isize) -> Ptr<T> {
        Ptr { address: (self.address as isize + count * size_of::<T>() as isize) as usize }
    }
    /// `count` elements further; no overflow check.
    pub const fn add(self, count: usize) -> Ptr<T> {
        Ptr { address: self.address + count * size_of::<T>() }
    }
    /// `count` elements back; no overflow check.
    pub const fn sub(self, count: usize) -> Ptr<T> {
        Ptr { address: self.address - count * size_of::<T>() }
    }
    /// `count` bytes further.
    pub fn byte_offset(self, count: isize) -> Ptr<T> {
        Ptr { address: (self.address as isize + count) as usize }
    }
    /// `self.addr() - origin.addr()` in elements.
    pub const fn distance(self, origin: Ptr<T>) -> isize {
        (self.address as isize - origin.address as isize) / size_of::<T>() as isize
    }
    /// `true` when the address is a multiple of `align_of::<T>()`.
    pub const fn is_aligned(self) -> bool { self.address % align_of::<T>() == 0 }
    /// Elements to `add` so the address is a multiple of `align`, or
    /// `usize::MAX` when no element count gets there.
    pub const fn align_offset(self, align: usize) -> usize {
        let size = size_of::<T>();
        let n: usize = 0;
        // The remainders repeat within `align` steps.
        while n < align {
            if (self.address + n * size) % align == 0 { return n; }
            n += 1;
        }
        usize::MAX
    }

    /// The same address as a pointer to `U` (alignment is the caller's).
    pub const fn cast<U>(self) -> Ptr<U> { Ptr { address: self.address } }
    /// The same address as a read-only pointer.
    pub const fn as_const(self) -> ConstPtr<T> { ConstPtr { address: self.address } }
    /// The same address as a pointer to a run of `T`s.
    pub const fn as_many(self) -> ManyPtr<T> { ManyPtr { address: self.address } }

    /// The `T` it points at. UB unless it points at a live, initialized `T`.
    pub unsafe fn read(self) -> T { raw_read(self) }
    /// Store `value` where it points. UB unless that is writable `T` memory.
    pub unsafe fn write(self, value: T) { raw_write(self, value); }
    /// `read` that the optimizer keeps exactly as written (`volatile`).
    pub unsafe fn read_volatile(self) -> T { raw_read_volatile(self) }
    /// `write` that the optimizer keeps exactly as written (`volatile`).
    pub unsafe fn write_volatile(self, value: T) { raw_write_volatile(self, value); }
}

/// A non-null pointer to one `T` that is only read (C `const T*`).
#[repr(transparent)]
#[niche(0)]
pub struct ConstPtr<T> {
    address: usize;
}

impl<T> Debug for ConstPtr<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"ConstPtr({self.address:#x})") }
}

impl<T> Clone for ConstPtr<T> {
    const fn clone(self) -> ConstPtr<T> { self }
}
impl<T> Copy for ConstPtr<T> {}
impl<T> PartialEq for ConstPtr<T> {
    const fn eq(self, rhs: ConstPtr<T>) -> bool { self.address == rhs.address }
}
impl<T> Eq for ConstPtr<T> {}
impl<T> PartialOrd for ConstPtr<T> {
    const fn lt(self, rhs: ConstPtr<T>) -> bool { self.address < rhs.address }
    const fn gt(self, rhs: ConstPtr<T>) -> bool { self.address > rhs.address }
    const fn le(self, rhs: ConstPtr<T>) -> bool { self.address <= rhs.address }
    const fn ge(self, rhs: ConstPtr<T>) -> bool { self.address >= rhs.address }
}
impl<T> Ord for ConstPtr<T> {
    const fn cmp(self, rhs: ConstPtr<T>) -> Ordering { self.address.cmp(rhs.address) }
}
impl<T> Hash for ConstPtr<T> {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_usize(self.address) }
}

impl<T> ConstPtr<T> {
    /// Well aligned, never dereferenceable.
    pub const fn dangling() -> ConstPtr<T> { ConstPtr { address: align_of::<T>() } }
    /// The address (provenance is lost).
    pub const fn addr(self) -> usize { self.address }
    /// The same pointer at address `addr`.
    pub const fn with_addr(self, addr: usize) -> ConstPtr<T> { ConstPtr { address: addr } }
    /// Moved by `count` elements, either way; no overflow check.
    pub fn offset(self, count: isize) -> ConstPtr<T> {
        ConstPtr {
            address: (self.address as isize + count * size_of::<T>() as isize) as usize,
        }
    }
    /// `count` elements further; no overflow check.
    pub const fn add(self, count: usize) -> ConstPtr<T> {
        ConstPtr { address: self.address + count * size_of::<T>() }
    }
    /// Moved back by `count` elements; no overflow check.
    pub fn sub(self, count: usize) -> ConstPtr<T> {
        ConstPtr { address: self.address - count * size_of::<T>() }
    }
    /// The same address as a pointer to `U` (alignment is the caller's).
    pub fn cast<U>(self) -> ConstPtr<U> { ConstPtr { address: self.address } }
    /// The same address as a pointer to a run of `T`s.
    pub fn as_many(self) -> ManyPtr<T> { ManyPtr { address: self.address } }
    /// The `T` it points at. UB unless it points at a live, initialized `T`.
    pub unsafe fn read(self) -> T { raw_read(self) }
    /// `read` that the optimizer keeps exactly as written (`volatile`).
    pub unsafe fn read_volatile(self) -> T { raw_read_volatile(self) }
}

/// A pointer to a run of `T`s of unknown length (C `T*` array).
#[repr(transparent)]
#[niche(0)]
pub struct ManyPtr<T> {
    address: usize;
}

impl<T> Debug for ManyPtr<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"ManyPtr({self.address:#x})") }
}

impl<T> Clone for ManyPtr<T> {
    const fn clone(self) -> ManyPtr<T> { self }
}
impl<T> Copy for ManyPtr<T> {}
impl<T> PartialEq for ManyPtr<T> {
    const fn eq(self, rhs: ManyPtr<T>) -> bool { self.address == rhs.address }
}
impl<T> Eq for ManyPtr<T> {}
impl<T> PartialOrd for ManyPtr<T> {
    const fn lt(self, rhs: ManyPtr<T>) -> bool { self.address < rhs.address }
    const fn gt(self, rhs: ManyPtr<T>) -> bool { self.address > rhs.address }
    const fn le(self, rhs: ManyPtr<T>) -> bool { self.address <= rhs.address }
    const fn ge(self, rhs: ManyPtr<T>) -> bool { self.address >= rhs.address }
}
impl<T> Ord for ManyPtr<T> {
    const fn cmp(self, rhs: ManyPtr<T>) -> Ordering { self.address.cmp(rhs.address) }
}
impl<T> Hash for ManyPtr<T> {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_usize(self.address) }
}

impl<T> ManyPtr<T> {
    /// The address (provenance is lost).
    pub const fn addr(self) -> usize { self.address }
    /// The same pointer at address `addr`.
    pub fn with_addr(self, addr: usize) -> ManyPtr<T> { ManyPtr { address: addr } }
    /// Moved by `count` elements, either way; no overflow check.
    pub fn offset(self, count: isize) -> ManyPtr<T> {
        ManyPtr {
            address: (self.address as isize + count * size_of::<T>() as isize) as usize,
        }
    }
    /// Moved forward by `count` elements; no overflow check.
    pub fn add(self, count: usize) -> ManyPtr<T> {
        ManyPtr { address: self.address + count * size_of::<T>() }
    }
    /// The first element as a single-element pointer.
    pub const fn as_one(self) -> Ptr<T> { Ptr { address: self.address } }
    /// The same address as a pointer to `U`s (alignment is the caller's).
    pub const fn cast<U>(self) -> ManyPtr<U> { ManyPtr { address: self.address } }
    /// The same address as a read-only pointer to a run of `T`s.
    pub fn as_const(self) -> ConstPtr<T> { ConstPtr { address: self.address } }
    /// Element `idx` (no bounds: the caller knows the length).
    pub unsafe fn read(self, idx: usize) -> T {
        let p: Ptr<T> = Ptr { address: self.address + idx * size_of::<T>() };
        raw_read(p)
    }
    /// Store `value` as element `idx` (no bounds: the caller knows the
    /// length). UB unless that is writable `T` memory.
    pub unsafe fn write(self, idx: usize, value: T) {
        let p: Ptr<T> = Ptr { address: self.address + idx * size_of::<T>() };
        raw_write(p, value);
    }
    /// The `len` `T`s from here as a `Slice<T>`; they must stay valid
    /// while the view is used, and the GC neither traces nor moves them
    /// (elements holding GC references are UB here).
    pub unsafe fn slice(self, len: usize) -> Slice<T> {
        // A buffer reference sits `HEADER_SIZE` before element 0, like a
        // `str` literal's bytes (`rok_str_bytes_buf`).
        let buf: rok::bare::mem::GcBuf<T> = rok::bare::mem::transmute_unchecked(self.address - 16);
        Slice::from_raw_parts(buf, 0, len)
    }
}

/// A C-compatible nullable pointer (`T*` that may be `NULL`).
#[repr(transparent)]
pub struct CPtr<T> {
    address: usize;
}

impl<T> Debug for CPtr<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"CPtr({self.address:#x})") }
}

impl<T> Clone for CPtr<T> {
    const fn clone(self) -> CPtr<T> { self }
}
impl<T> Copy for CPtr<T> {}
impl<T> PartialEq for CPtr<T> {
    const fn eq(self, rhs: CPtr<T>) -> bool { self.address == rhs.address }
}
impl<T> Eq for CPtr<T> {}
impl<T> PartialOrd for CPtr<T> {
    const fn lt(self, rhs: CPtr<T>) -> bool { self.address < rhs.address }
    const fn gt(self, rhs: CPtr<T>) -> bool { self.address > rhs.address }
    const fn le(self, rhs: CPtr<T>) -> bool { self.address <= rhs.address }
    const fn ge(self, rhs: CPtr<T>) -> bool { self.address >= rhs.address }
}
impl<T> Ord for CPtr<T> {
    const fn cmp(self, rhs: CPtr<T>) -> Ordering { self.address.cmp(rhs.address) }
}
impl<T> Hash for CPtr<T> {
    const fn hash<H: Hasher>(self, ref h: H) { h.write_usize(self.address) }
}

impl<T> CPtr<T> {
    /// The null pointer.
    pub const fn null() -> CPtr<T> { CPtr { address: 0 } }
    /// The non-null `p` as a nullable pointer.
    pub fn from_ptr(p: Ptr<T>) -> CPtr<T> { CPtr { address: p.address } }
    /// The read-only `p` as a nullable pointer (C `const T*`).
    pub const fn from_const(p: ConstPtr<T>) -> CPtr<T> { CPtr { address: p.address } }
    /// A pointer at address `addr`; 0 is null.
    pub const fn from_addr(addr: usize) -> CPtr<T> { CPtr { address: addr } }
    /// `true` when the address is 0.
    pub const fn is_null(self) -> bool { self.address == 0 }
    /// The address; 0 when null.
    pub const fn addr(self) -> usize { self.address }
    /// `none` when null.
    pub const fn as_ptr(self) -> Ptr<T> | none {
        if self.address == 0 { return none; }
        let p: Ptr<T> = Ptr { address: self.address };
        p
    }
    /// The same address read-only; `none` when null.
    pub fn as_const(self) -> ConstPtr<T> | none {
        if self.address == 0 { return none; }
        let p: ConstPtr<T> = ConstPtr { address: self.address };
        p
    }
}

// Raw pointers never cross threads implicitly.
impl<T> !Send for Ptr<T> {}
impl<T> !Sync for Ptr<T> {}
impl<T> !Send for ConstPtr<T> {}
impl<T> !Sync for ConstPtr<T> {}
impl<T> !Send for ManyPtr<T> {}
impl<T> !Sync for ManyPtr<T> {}
impl<T> !Send for CPtr<T> {}
impl<T> !Sync for CPtr<T> {}

/// The same address as a pointer to `U` (`ptr_cast::<U>(p)`;
/// alignment is the caller's problem).
pub const fn ptr_cast<U, T>(p: Ptr<T>) -> Ptr<U> { Ptr { address: p.address } }

/// `p` as a `Ptr<T>` when its address suits `T`'s alignment.
pub const fn align_cast<T>(p: Ptr<u8>) -> Ptr<T> | none {
    if p.address % align_of::<T>() != 0 { return none; }
    let q: Ptr<T> = Ptr { address: p.address };
    q
}

/// `p` as a `Ptr<T>` with no alignment check, not even in debug builds.
pub const fn align_cast_unchecked<T>(p: Ptr<u8>) -> Ptr<T> { Ptr { address: p.address } }

/// Drop the `const`: writing through the result is the caller's
/// responsibility.
pub const fn const_cast<T>(p: ConstPtr<T>) -> Ptr<T> { Ptr { address: p.address } }

/// The address of `p`, marked as escaping (strict provenance).
pub const fn expose_provenance<T>(p: Ptr<T>) -> usize { p.address }

/// A pointer at `addr`, assumed to carry an exposed provenance.
pub const unsafe fn from_exposed_provenance<T>(addr: usize) -> Ptr<T> { Ptr { address: addr } }

/// A pointer to `place` itself (a local, or a field / array element of
/// one), valid while that local is in scope: the local lives in memory
/// and, holding GC references, stays a GC root (whose referents never
/// move) until its scope ends.
#[intrinsic("rok.addr_of")]
pub fn addr_of<T>(place: T) -> Ptr<T>;

/// `addr_of` as the start of a run of `T`s (`many_addr_of(buf[0])`).
#[intrinsic("rok.addr_of")]
pub fn many_addr_of<T>(place: T) -> ManyPtr<T>;

// Timers: 20k tasks `sleep` 1 ms (insert + fire), then 20k tasks
// sleeping an hour are cancelled (cancel cleanup of the timer heap).
let start = Instant::now();
let ts: List<Task<i32>> = List::new();
for i in 0..20000 {
    ts.push(task::spawn(async { await task::sleep(Duration::ms(1)); 1 }));
}
let fired = 0;
for t in ts { fired += await t; }
let fire_ms = start.elapsed().as_ms();
let mid = Instant::now();

let long: List<Task<i32>> = List::new();
for i in 0..20000 {
    long.push(task::spawn(async { await task::sleep(Duration::secs(3600)); 1 }));
}
await task::sleep(Duration::ms(10));
for t in long { t.cancel(); }
let cancelled = 0;
for t in long {
    try await t.join() catch _: task::CancellationError { cancelled += 1; 0 };
}
println(f"fired {fired} in {fire_ms} ms, cancelled {cancelled} in {mid.elapsed().as_ms()} ms, left {task::registrations()}");

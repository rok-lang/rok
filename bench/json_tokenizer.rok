// JSON-ish tokenizer: builds ~6 MB of JSON-like text from an LCG, then
// scans it byte by byte into strings / numbers / literals / punctuation.
// Output matches bench/c/json_tokenizer.c.
fn make(n: i64) -> str {
    let b = StrBuf::new();
    let x: u64 = 42;
    for _ in 0..n {
        x = x.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        let r = (x >> 33) as i64;
        let k = r % 8;
        if k == 0 {
            b.push_str("{\"key");
            b.push_str(f"{r % 100}");
            b.push_str("\": ");
        } else if k == 1 {
            b.push_str(f"{r % 100000}, ");
        } else if k == 2 {
            b.push_str(f"-{r % 1000}.5, ");
        } else if k == 3 {
            b.push_str("\"str\\\"ing\", ");
        } else if k == 4 {
            b.push_str(if r % 3 == 0 { "true, " } else if r % 3 == 1 { "false, " } else { "null, " });
        } else if k == 5 {
            b.push_str("[");
        } else if k == 6 {
            b.push_str("], ");
        } else {
            b.push_str("}\n");
        }
    }
    b.to_str()
}

fn is_digit(c: u8) -> bool { c >= 48u8 && c <= 57u8 }
fn is_alpha(c: u8) -> bool { c >= 97u8 && c <= 122u8 }

fn main() -> i32 {
    let s = make(1000000);
    let n = s.len();
    let strings: i64 = 0;
    let numbers: i64 = 0;
    let literals: i64 = 0;
    let punct: i64 = 0;
    let sum: i64 = 0;
    let i: usize = 0;
    while i < n {
        let c = s.byte(i);
        if c == 34u8 {
            i += 1;
            while i < n && s.byte(i) != 34u8 {
                if s.byte(i) == 92u8 {
                    i += 1;
                }
                i += 1;
            }
            i += 1;
            strings += 1;
        } else if c == 45u8 || is_digit(c) {
            let neg = c == 45u8;
            if neg {
                i += 1;
            }
            let v: i64 = 0;
            while i < n && is_digit(s.byte(i)) {
                v = v * 10 + (s.byte(i) - 48u8) as i64;
                i += 1;
            }
            if i < n && s.byte(i) == 46u8 {
                i += 1;
                while i < n && is_digit(s.byte(i)) {
                    i += 1;
                }
            }
            sum += if neg { -v } else { v };
            numbers += 1;
        } else if is_alpha(c) {
            while i < n && is_alpha(s.byte(i)) {
                i += 1;
            }
            literals += 1;
        } else {
            if c != 32u8 && c != 10u8 {
                punct += 1;
            }
            i += 1;
        }
    }
    println(f"{n} {strings} {numbers} {literals} {punct} {sum}");
    return 0;
}

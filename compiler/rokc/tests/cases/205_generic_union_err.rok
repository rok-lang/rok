// expect-error: help: add `T: Num` to `A`'s generics
// expect-error: 205_generic_union_err.rok:24:13: type `bool` does not satisfy trait bound `Num` required by `B<bool>`
// expect-error: 205_generic_union_err.rok:25:12: type `bool` does not satisfy trait bound `Num` required by `W<bool>`
// expect-error: 205_generic_union_err.rok:26:25: reading field `a` of union `U<i32>` needs an `unsafe` block

trait Num { fn zero() -> Self; }
impl Num for i32 { fn zero() -> i32 { 0 } }

union B<T: Num> { v: T; raw: u32; }

union W<T> where T: Num { v: T; raw: u32; }

type N<T: Num> = T;

union A<T> { v: N<T>; raw: u32; }

union E<T> {}

union U<T> { a: T; b: u64; }

fn main() {
    let b = B { v: true };
    let w: W<bool> = W { raw: 1u32 };
    let r = U { a: 1 }; r.a;
}

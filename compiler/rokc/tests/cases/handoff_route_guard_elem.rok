// needs: threads
// expect-error: `x` shares the value the `Mutex` protects (`g.get()`)
// An element read out of the locked value, kept after the block.
use rok::std::thread;
static M: Mutex<List<List<i32>>> = Mutex::new([[]]);
fn main() {
    let x: List<i32> = [];
    using g = M.lock() { x = g.get()[0]; }
    let t = thread::spawn(|| { for i in 0..200000 { using g = M.lock() { g.get()[0].push(i); } } 0 });
    for i in 0..200000 { x.push(i); }
    let _ = try! t.join();
    println(f"len {x.len()}");
}

// Two-pointer loops and `ctr + k` indexes are versioned too.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/cg_versioned_loop_two_pointer.rok:23:18:
// expect-stderr: index 2 out of bounds for length 2
// expect-stdout:
// [5, 4, 3, 2, 1] [1, 2, 3, 4, 5] [2, 1, 3]
// [2, 3, 4, 5, 5] 11
// [9, 9]

fn reverse(xs: List<i64>, lo: i64, hi: i64) {
    while lo < hi {
        let t = xs[lo as usize];
        xs[lo as usize] = xs[hi as usize];
        xs[hi as usize] = t;
        lo += 1;
        hi -= 1;
    }
}

fn reverse_u(xs: List<i64>, lo: usize, hi: usize) {
    while lo < hi {
        let t = xs[lo];
        xs[lo] = xs[hi];
        xs[hi] = t;
        lo += 1;
        hi -= 1;
    }
}

fn shift(xs: List<i64>, n: usize) {
    for i in 0..n {
        xs[i] = xs[i + 1];
    }
}

fn pairs(xs: List<i64>, n: i64) -> i64 {
    let s: i64 = 0;
    for i in 0..n {
        s += xs[(i + 2) as usize] - xs[i as usize];
    }
    s
}

fn main() -> i32 {
    let a: List<i64> = [1, 2, 3, 4, 5];
    reverse(a, 0, 4);
    let b: List<i64> = [5, 4, 3, 2, 1];
    reverse_u(b, 0, 4);
    let c: List<i64> = [1, 2, 3];
    reverse(c, 0, 1);
    reverse(c, 2, -1);
    println(f"{a:?} {b:?} {c:?}");
    let d: List<i64> = [1, 2, 3, 4, 5];
    shift(d, 4);
    println(f"{d:?} {pairs(d, 3) + 6}");
    let e: List<i64> = [9, 9];
    reverse(e, 5, 5);
    println(f"{e:?}");
    reverse_u(e, 0, 2);
    return 0;
}

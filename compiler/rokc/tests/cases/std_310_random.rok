// expect-exit: 0
// expect-stdout:
// len 32 0
// distinct true
// spread true
// fill true
// part true

// rok::std::random: the OS random source fills lists of any
// length (getentropy's 256-byte limit is chunked).
use rok::std::random;

fn main() {
    let a = random::bytes(32);
    println(f"len {a.len()} {random::bytes(0).len()}");
    println(f"distinct {a != random::bytes(32)}");
    let big = random::bytes(100000);
    let zeros = 0;
    for x in big {
        if x == 0u8 { zeros += 1; }
    }
    // Expected 390 zero bytes; 6 standard deviations either side.
    println(f"spread {zeros > 270 && zeros < 510}");
    let buf: List<u8> = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    random::fill(buf);
    let nonzero = false;
    for x in buf {
        if x != 0u8 { nonzero = true; }
    }
    println(f"fill {nonzero}");
    // A view fills only its own bytes.
    let part: List<u8> = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    random::fill(part[2:18]);
    let inner = false;
    for x in part[2:18] {
        if x != 0u8 { inner = true; }
    }
    println(f"part {inner && part[0] == 0u8 && part[1] == 0u8 && part[18] == 0u8 && part[19] == 0u8}");
}


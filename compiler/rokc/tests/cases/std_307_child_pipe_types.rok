// spec: std §3.7.1
// only-os: macos linux
// expect-exit: 0
// expect-stdout:
// HELLO
// true
// inherit out: ok

// Std 3.7.1 / 3.7.2: `Command::new` takes a `Path`; `Child`'s pipes are
// `ChildStdin` (a `Writer`) and `ChildStdout` / `ChildStderr`
// (`Reader`s); `output` pipes streams left inherited.
use rok::core::marker::replace;
use rok::std::process::{Command, Stdio, ChildStdin, ChildStdout};
use rok::std::io::{Reader, Writer};
use rok::std::path::Path;

fn main() throws (IoError) {
    let c = try Command::new(Path::new("tr")).args(["a-z", "A-Z"])
        .stdin(Stdio::Piped).stdout(Stdio::Piped).spawn();
    let si: ChildStdin = replace(ref c.stdin, none) ?? panic("no stdin");
    try si.write_str("hello\n");
    try si.close();
    let so: ChildStdout = replace(ref c.stdout, none) ?? panic("no stdout");
    print(try so.read_to_str());
    try so.close();
    println(f"{(try c.wait()).success()}");
    let o = try Command::new("echo").arg("ok").output();
    print(f"inherit out: {try str::from_utf8(o.stdout) catch _ { "" }}");
}

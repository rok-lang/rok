// spec: std 307
// spec: std 306
// only-target: wasm32-wasip2 wasm32-wasip1-threads wasm32-unknown-unknown
// expect-exit: 0
// expect-stdout:
// spawn: Unsupported
// output: Unsupported
// kill: Unsupported
// raise: Unsupported
// signal: Unsupported
// current_exe: Unsupported
// pid: 0

// wasm32 has no processes or signals (stdlib 307 / 306 per-platform
// tables): each call reports `IoErrorKind::Unsupported` at run time, and
// the process id is 0 (WASI has no such concept).
use rok::std::process;
use rok::std::process::{Command, Signal, SignalError};
use rok::core::io::{IoError, IoErrorKind};
use rok::std::env;

try Command::new("ls").spawn() catch e: IoError { println(f"spawn: {e.kind():?}"); };
try Command::new("ls").arg("-l").output() catch e: IoError { println(f"output: {e.kind():?}"); };
try process::send_signal(1u32, Signal::Terminate) catch e: IoError { println(f"kill: {e.kind():?}"); };
try process::raise(Signal::Terminate) catch e: IoError { println(f"raise: {e.kind():?}"); };
try process::on_signal(Signal::Terminate, || {}) catch e: SignalError {
    println(f"signal: {IoError::from_os_code(e.code, "signal").kind():?}");
};
try env::current_exe() catch e: IoError { println(f"current_exe: {e.kind():?}"); };
println(f"pid: {process::id()}");
// spec: std 307-process §3.7.6, 306-env §3.6.4

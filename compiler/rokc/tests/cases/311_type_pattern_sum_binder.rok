// expect-exit: 0
// expect-stdout:
// i32 1
// i64 2
// s

// `n: i32 | i64` is one type pattern narrowing to the sum
// `i32 | i64` (not `n: i32` or-ed with an `i64` pattern).
fn g(v: i32 | i64 | str) -> str {
    match v {
        n: i32 | i64 => match n {
            a: i32 => f"i32 {a}",
            b: i64 => f"i64 {b}",
        },
        s: str => s,
    }
}

fn main() {
    println(g(1));
    println(g(2i64));
    println(g("s"));
}


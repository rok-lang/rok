// spec: §2.10.5
// expect-exit: 0
// expect-stdout:
// W<i32>
// E<i64>
// S<u8, u8>
// Dflt<str, List<str>>
// List<i64>
// 4
// 1099511627776

// Generic parameter defaults (2.10.5): a type argument left out takes its
// default, resolved under the arguments before it (`B = A`); a generic
// type whose parameters all have defaults is an instance by its bare
// name; a generic fn with no inference signal takes its default.

struct W<T = i32> { v: T; }
enum E<T = i64> { A(T), B }
struct S<A, B = A> { a: A; b: B; }
struct Dflt<K, V = List<K>> { k: K; v: V; }
fn mk<T = i64>() -> List<T> { return []; }
fn take(w: W) -> i32 { w.v }

fn main() -> i32 {
    let w: W = W { v: 3 };
    let e: E = E::A(1 << 40);
    let s: S<u8> = S { a: 1, b: 2 };
    let d: Dflt<str> = Dflt { k: "k", v: ["a", "b"] };
    let xs = mk();
    println(w.type_name_of_val());
    println(e.type_name_of_val());
    println(s.type_name_of_val());
    println(d.type_name_of_val());
    println(xs.type_name_of_val());
    println(f"{take(W { v: 4 })}");
    let n = match e { E::A(x) => x, E::B => 0i64 };
    println(f"{n}");
    return 0;
}

fn config(cert: str, key: str) throws (TlsError) -> ServerConfig {
    try ServerConfig::new(try Certificate::from_pem(cert), try PrivateKey::from_pem(key))
}

fn serve(l: TcpListener) {
    for (cert, key) in [(PSS, PSS_KEY), (PSS_ANY, PSS_ANY_KEY)] {
        let cfg = try! config(cert, key);
        let (s, _) = try! l.accept();
        let srv = try Server::new(s, cfg) catch _ { continue; };
        try srv.write_all("hello") catch _ {};
        try! srv.close();
    }
    try! l.close();
}

fn main() {
    let l = try! tcp_listen("127.0.0.1:0");
    let port = (try! l.local_addr()).port();
    let t = thread::spawn(|| serve(l));
    let cfg = try! ClientConfig::new();
    cfg.root_certs = try! Certificate::from_pem(CA);
    for what in ["pss, sha-256 only", "pss, any hash"] {
        let s = try! tcp_connect(f"127.0.0.1:{port}");
        let c = try Client::with_config(s, "localhost", cfg) catch e {
            println(f"{what}: {e.kind():?} {e.message()}");
            continue;
        };
        println(f"{what}: {try str::from_utf8(try! c.read_to_end()) catch _ { "?" }}");
        try! c.close();
    }
    try! t.join();
    for (what, cert, key) in [("rsa", RSA, RSA_KEY), ("ec leaf, rsa key", EC, RSA_KEY), ("pss leaf, another pss key", PSS, PSS_ANY_KEY), ("ec leaf, other ec key", EC, "-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgi3F3cWqG4N4j0PGf
COyNvLhinAYS4S58OQdqcyT434KhRANCAAQ6vkUQQgpNYs8R9nWuwAlmi+7UWevT
6uT42GYD5Myk2nFMih/JEjfP3mU3UcCTZagXDGP3859X6YcwzsXwta6o
-----END PRIVATE KEY-----
")] {
        let _ = try config(cert, key) catch e {
            println(f"config {what}: {e.kind():?} {e.message()}");
            continue;
        };
        println(f"config {what}: ok");
    }
}


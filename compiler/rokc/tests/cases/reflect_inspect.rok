// expect-exit: 0
// expect-stdout:
// ["host", "port"]
// i32
// none
// true 9090
// false false
// true 200 false 200
// false 200
// bump 1 false ["i32"] i32
// new 0 true [] Config
// Box<f64> ["v", "n"]
// true 2.5
// get 0 [] T
// ["0", "1"]
// true 7
// [] 1
// 0 = i32
// 1 = str

// Spec 6.10.2 / stdlib 2.12.3: `#[derive(Inspect)]` (the meta block in
// `core/reflect.rok`) on named / tuple / generic structs and an enum:
// `field_names`, `get_field` / `set_field` through `any` (an integer
// converts when it fits the field), and `methods` (inherent only).
#[derive(Inspect)]
struct Config { host: str; port: i32; }
impl Config {
    fn new() -> Config { Config { host: "h", port: 1 } }
    fn bump(self, by: i32) -> i32 { self.port + by }
}

#[derive(Inspect)]
struct Small { b: u8; }

#[derive(Inspect)]
struct Box<T> { v: T; n: i32; }
impl<T> Box<T> {
    fn get(self) -> T { self.v }
}

#[derive(Inspect)]
struct Pair(i32, str);

#[derive(Inspect)]
enum Color { Red, Green(i32) }
impl Color {
    fn code(self) -> i32 { 1 }
}

fn dump<T: Inspect>(x: T) {
    for name in T::field_names() {
        if let v: any = x.get_field(name) {
            println(f"{name} = {v.type_name_of_val()}");
        }
    }
}

let c = Config { host: "localhost", port: 8080 };
println(f"{Config::field_names():?}");
match c.get_field("port") {
    p: any => println(p.type_name_of_val()),
    none => println("none"),
}
match c.get_field("nope") {
    p: any => println(p.type_name_of_val()),
    none => println("none"),
}
println(f"{c.set_field("port", 9090)} {c.port}");
println(f"{c.set_field("xxx", 1)} {c.set_field("port", "no")}");
let s = Small { b: 1u8 };
println(f"{s.set_field("b", 200)} {s.b} {s.set_field("b", 300)} {s.b}");
println(f"{s.set_field("b", -1)} {s.b}");
for m in Config::methods() {
    println(f"{m.name} {m.arity} {m.is_static} {m.arg_types:?} {m.return_type}");
}
let b = Box { v: 1.5, n: 2 };
println(f"{b.type_name_of_val()} {Box::<f64>::field_names():?}");
println(f"{b.set_field("v", 2.5)} {b.v}");
for m in Box::<f64>::methods() {
    println(f"{m.name} {m.arity} {m.arg_types:?} {m.return_type}");
}
let p = Pair(1, "x");
println(f"{Pair::field_names():?}");
println(f"{p.set_field("0", 7)} {p.0}");
println(f"{Color::field_names():?} {Color::methods().len()}");
dump(p);

// spec: 006.10-reflection
// spec: std §2.12.3
// spec: §6.10.2 §6.10.6

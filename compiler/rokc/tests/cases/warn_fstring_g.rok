// spec: 001.07.3-format-string
// expect-exit: 0
// expect-lint: 14:16 `{:.3g}` prints like `{:.3}` today; from Rok 0.2.0 `g` is the general format (`1.23e+03`)
// expect-lint: 15:17 `{:>10.1g}` prints like `{:>10.1}` today; from Rok 0.2.0 `g` is the general format (`1.23e+03`)
// expect-warning: help: write `{:.3}` to keep this output
// expect-stdout:
// 1234.568 1234.5678 1234.568
// |    1234.6| 1234.6
// 100000000000000000000 abc

// `g` is Display today (spec 1.7.3); a precision with it warns.
fn main() {
    let x = 1234.5678;
    println(f"{x:.3g} {x:g} {x:.3}");
    println(f"|{x:>10.1g}| {x:.1}");
    println(f"{1e20:g} {"abc":g}");
}

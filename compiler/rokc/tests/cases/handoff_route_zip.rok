// needs: threads
// expect-error: `p.1` shares `p.0`, which was sent through a channel
// zip of a list with itself: each pair holds one object twice.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let xs: List<List<i32>> = [[]];
    let q = xs.iter().zip(xs.iter()).collect::<List<(List<i32>, List<i32>)>>();
    let _ = xs.pop();
    if let p: (List<i32>, List<i32>) = q.pop() {
        try! tx.send(p.0);
        for i in 0..200000 { p.1.push(i); }
        let _ = try! t.join();
        println(f"len {p.1.len()}");
    }
}

// expect-exit: 0
// expect-stdout:
// 40
// -1
// 3
// 4

// `return` / `break` / `continue` as match arm bodies.
fn f(x: i32 | none) -> i32 {
    let v = match x {
        n: i32 => n,
        none => return -1,
    };
    return v * 10;
}
println(f"{f(4)}");
println(f"{f(none)}");
let i = 0;
loop {
    match i {
        3 => break,
        _ => { i = i + 1; }
    }
}
println(f"{i}");
let s = 0;
for k in 0..5 {
    match k % 2 {
        0 => continue,
        _ => { s = s + k; }
    }
}
println(f"{s}");


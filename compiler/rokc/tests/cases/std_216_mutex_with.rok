// needs: threads
// expect-exit: 0
// expect-stdout:
// 3
// [1, 2, 3, 9] 3
// 30
// done

// Mutex::with / RwLock::read_with / write_with: the lock held for one
// closure call, its value lent to it.
use rok::std::thread;

let log = Mutex::new([1, 2]);
log.with(|v| v.push(3));
println(log.with(|v| v.len()));
let items = log.with(|v| v.clone());
items.push(9);
println(f"{items:?} {log.with(|v| v.len())}");
let rw = RwLock::new([10]);
rw.write_with(|v| v.push(20));
println(rw.read_with(|v| v.sum()));
let total = Mutex::new(0);
let hs = (0..4).map(|i| thread::spawn(|| total.with(|t| t + i))).to_list();
for h in hs {
    let _ = try! h.join();
}
println("done");

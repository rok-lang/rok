// expect-exit: 0
// expect-stdout:
// 0
// 1
// 2
// 3
// held 1

// A `ref` method's `Poll::Ready(x)` holds `x` in its value, not in the
// other `ref` arguments copied back beside it: `poll_next` handing over
// a field it took out of `self` does not tie `self` to `ctx`, so the
// next poll of the loop may hand it over again.
use rok::core::task;
use rok::core::task::Task;
use rok::core::future::{Context, Poll};
use rok::core::stream::Stream;
use rok::core::marker::replace;

struct Src { n: List<i32>; }

struct S {
    src: Src | none;
    pending: Task<(Src, i32)> | none;
}

fn refill(s: Src) -> Task<(Src, i32)> {
    task::spawn_blocking([move s] || {
        let k = s.n.len() as i32;
        s.n.push(k);
        (s, k)
    })
}

impl Stream for S {
    type Item = i32;
    fn poll_next(ref self, ref ctx: Context) -> Poll<i32 | none> {
        let job = match self.pending {
            j: Task<(Src, i32)> => j,
            none => match replace(ref self.src, none) {
                s: Src => refill(s),
                none => return Poll::Ready(none),
            },
        };
        match job.poll(ref ctx) {
            Poll::Ready((s, k)) => {
                self.pending = none;
                if k < 3 { self.src = s; }
                Poll::Ready(k)
            }
            Poll::Pending => {
                self.pending = job;
                Poll::Pending
            }
        }
    }
}

struct Holder { items: List<i32>; }

// The value holds an element of `h`; `other` only comes back beside it.
fn first(ref h: Holder, ref other: List<i32>) -> Poll<i32> {
    other.push(0);
    Poll::Ready(h.items[0])
}

async fn go() {
    let s = S { src: Src { n: List::new() }, pending: none };
    for await k in s {
        println(f"{k}");
    }
    let h = Holder { items: [1] };
    let other: List<i32> = [];
    let p = first(ref h, ref other);
    let q = first(ref h, ref other);
    if let Poll::Ready(v) = q { println(f"held {v}"); }
}
task::block_on(go());

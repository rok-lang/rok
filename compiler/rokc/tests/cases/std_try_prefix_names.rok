// spec: std 218-task §2.18.1 / std 201-numbers §2.1.3 / refs-lang §6.2.7
// needs: threads
// expect-exit: 0
// expect-warning: use of deprecated function `try_id`
// expect-warning: use `task::current_id`
// expect-warning: use of deprecated method `Float::try_parse`
// expect-warning: use `Float::parse_or_none`
// expect-stdout:
// outside true true
// inside true
// 1.5 true

// A form that is `none` where the plain one panics is not a `try_` form:
// `task::current_id` and `Float::parse_or_none` replace `try_id` and
// `try_parse`, which still work.
async fn main() {
    println(f"outside {await task::spawn_blocking(|| task::current_id() is none)} {await task::spawn_blocking(|| task::try_id() is none)}");
    println(f"inside {task::current_id() == task::id()}");
    let z = float::from_f64(0.0);
    println(f"{float::parse_or_none("1.5") ?? z} {float::try_parse("x") is none}");
}

// A `fn() -> !` value fits a `fn() -> R` slot - a named
// function and a `fn` variable alike (the adapter captures the
// variable's value). Calling it never returns: it panics (exit 101).
fn die() -> ! { panic("die"); }
fn run(g: fn() -> i32) -> i32 { return g(); }
fn main() -> i32 {
    let f: fn() -> ! = die;
    let g: fn() -> i32 = f;
    println(f"{1}");
    return run(g);
}

// expect-error: 11:19: unreachable match arm 3
// expect-error: 18:22: unreachable match arm 2

// spec 3.12.6: integer / char literals and ranges subsume each other -
// an arm inside the union of earlier ranges is unreachable. The domain
// stays open (3.12.5), so the `_` arm is still required.
fn f(x: i32) -> i32 {
    return match x {
        0..=10 => 1,
        5..20 => 2,
        3..=19 => 3,
        _ => 4,
    };
}
fn g(c: char) -> i32 {
    return match c {
        'a'..='m' | 'n'..='z' => 1,
        'k'..='p' => 2,
        _ => 3,
    };
}
fn main() -> i32 {
    return f(1) + g('a');
}

// spec: 003.12-match-expression
// spec: §3.12.6

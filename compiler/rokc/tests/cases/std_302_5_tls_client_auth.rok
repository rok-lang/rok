/// Serve `n` connections: each reply names the client certificate's
/// subject size and whether the session resumed; the log comes back.
fn serve(l: TcpListener, n: i32, required: bool) -> List<str> {
    let cfg = try! ServerConfig::new(try! Certificate::from_pem(LEAF), try! PrivateKey::from_pem(KEY));
    cfg.client_roots = try! Certificate::from_pem(CA);
    cfg.require_client_cert = required;
    let log: List<str> = [];
    for _ in 0..n {
        let (s, _) = try! l.accept();
        let srv = try Server::new(s, cfg) catch e {
            log.push(f"error {e.message()} (alert {e.alert()})");
            continue;
        };
        let peer = srv.peer_certificates();
        let names: List<str> = if peer.len() > 0 { peer[0].dns_names() } else { [] };
        log.push(f"peer {peer.len()} certs, names {names.len()}, resumed {srv.is_resumed()}");
        let buf: List<u8> = [];
        for _ in 0..64 { buf.push(0u8); }
        let _ = try srv.read(buf) catch _ { 0usize };
        try srv.write_all("hello") catch _ {};
        try! srv.close();
    }
    try! l.close();
    log
}

fn with_cert(cert: str, key: str) -> ClientConfig {
    let cfg = try! ClientConfig::new();
    cfg.root_certs = try! Certificate::from_pem(CA);
    cfg.session_cache = none;
    if cert != "" {
        cfg.client_cert_chain = try! Certificate::from_pem(cert);
        cfg.client_key = try! PrivateKey::from_pem(key);
    }
    cfg
}

fn run(what: str, port: u16, cfg: ClientConfig) {
    let s = try tcp_connect(f"127.0.0.1:{port}") catch e { println(f"{what}: connect {e}"); return; };
    let c = try Client::with_config(s, "localhost", cfg) catch e {
        println(f"{what}: handshake: {e.kind():?} {e.message()}");
        return;
    };
    try c.write_all("hi") catch _ {};
    let r = try c.read_to_end() catch e {
        println(f"{what}: read: {e}");
        try! c.close();
        return;
    };
    println(f"{what}: {try str::from_utf8(r) catch _ { "?" }}, resumed {c.is_resumed()}");
    try! c.close();
}

fn main() {
    let l = try! tcp_listen("127.0.0.1:0");
    let port = (try! l.local_addr()).port();
    let t = thread::spawn(|| serve(l, 7, true));
    run("ed25519", port, with_cert(CLI2, CLI2_KEY));
    let p256 = with_cert(CLI, CLI_KEY);
    p256.session_cache = SessionCache::new();
    run("p256", port, p256);
    run("p256 again", port, p256);
    run("none", port, with_cert("", ""));
    run("serverAuth only", port, with_cert(SERVER_ONLY, CLI_KEY));
    run("other CA", port, with_cert(OTHER_CA_CLI, CLI2_KEY));
    run("key mismatch", port, with_cert(CLI2, CLI_KEY));
    for e in try! t.join() { println(f"server: {e}"); }

    let l2 = try! tcp_listen("127.0.0.1:0");
    let port2 = (try! l2.local_addr()).port();
    let t2 = thread::spawn(|| serve(l2, 2, false));
    run("optional, none", port2, with_cert("", ""));
    run("optional, ed25519", port2, with_cert(CLI2, CLI2_KEY));
    for e in try! t2.join() { println(f"optional server: {e}"); }
}

// spec: std 302-net §3.2.5

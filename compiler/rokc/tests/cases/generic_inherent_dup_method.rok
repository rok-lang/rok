// expect-error: duplicate method `first`

// Two generic inherent impls on structural types that both cover
// `[i32; 3]` and both define `first` are rejected at the declaration,
// not at a call.
impl<T, const N: usize> [T; N] {
    fn first(self) -> T { return self[0]; }
}
impl<const N: usize> [i32; N] {
    fn first(self) -> i32 { return 0; }
    fn total(self) -> i32 { return 1; }
}

fn main() -> i32 {
    let a: [i32; 3] = [1, 2, 3];
    return a.total();
}



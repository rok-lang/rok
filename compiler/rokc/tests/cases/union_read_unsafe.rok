// expect-exit: 42
// expect-stdout:
// 42

// Writing a union field (its initialiser) is safe; reading one back
// reinterprets bits and needs `unsafe`.
union Repr {
    bits: i64;
    low: i32;
}

fn main() -> i32 {
    let r = Repr { bits: 42i64 };
    let low = unsafe { r.low };
    println(f"{low}");
    return low;
}



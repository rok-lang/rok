// expect-exit: 0
// expect-stdout: 7 8

// Only the root module's `main` is the entry; a module's
// `main` (also an `async` one) is an ordinary function beside the
// implicit `main` made from the top-level statements.
mod a {
    pub fn main() -> i32 { 7 }
}
mod b {
    pub async fn main() -> i32 { 8 }
}

let n = await b::main();
println(f"{a::main()} {n}");

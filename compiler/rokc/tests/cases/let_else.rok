// expect-exit: 30
// expect-stdout:
// 10 0

fn pick(present: bool) -> i32 | none {
    if present {
        return 10i32;
    }
    return none;
}

fn unwrap_or_zero(present: bool) -> i32 {
    let v: i32 = pick(present) else {
        return 0;
    };
    return v;
}

fn main() -> i32 {
    println(f"{unwrap_or_zero(true)} {unwrap_or_zero(false)}");
    let total = 0;
    total += unwrap_or_zero(true);   // 10
    total += unwrap_or_zero(false);  // 0
    total += unwrap_or_zero(true);   // 10
    total += unwrap_or_zero(true);   // 10
    return total;
}

// needs: threads
// expect-exit: 0
// expect-stdout:
// inside: worker-1
// handle: worker-1
// main: none
// unnamed: none

// `Builder::name` names the thread; `current().name()` in
// that thread returns it, `none` elsewhere and for unnamed threads.
use rok::std::thread;

fn main() {
    let h = try! thread::Builder::new().name("worker-1").spawn(|| thread::current().name() ?? "none");
    println(f"inside: {try! h.join()}");
    println(f"handle: {h.thread().name() ?? "none"}");
    println(f"main: {thread::current().name() ?? "none"}");
    let u = thread::spawn(|| thread::current().name() ?? "none");
    println(f"unnamed: {try! u.join()}");
}

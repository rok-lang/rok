// spec: std §2.13.9
// expect-error: type `U` does not satisfy trait bound `Send`
// A union is `Send` only when every declared field is, whatever its
// byte storage.
struct Tok { v: i32; }
impl !Send for Tok {}
union U { t: Tok; n: i32; }
fn need_send<T: Send>(x: T) -> i32 { return 1; }
fn main() -> i32 { return need_send(U { n: 1 }); }

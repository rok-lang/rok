// spec: std §2.21.1
// expect-exit: 0
// expect-stdout:
// sha256 32 64
// digest 32
// sha3 32 64
// shake 16 32
// hmac true
// hkdf 42
// aead 12 16 28 3
// x25519 32
// mlkem 1184 1088 32
// ed25519 true
// ecdsa true
// rsa true
// same type true

// The unique names of 2.21 are reachable flat at `crypto::`, the submodule
// path naming the same definition; keys and HKDF are under their algorithm
// module.
use rok::core::crypto;
use rok::core::crypto::{
    HashAlgorithm, Digest, Sha3_256, Sha3_512, Shake128, Shake256, Hmac,
    AeadAlgorithm, Aead, EcCurve,
};
use rok::core::crypto::{hkdf, x25519, mlkem, ed25519, ecdsa, rsa};

fn main() {
    println(f"sha256 {HashAlgorithm::Sha256.output_len()} {HashAlgorithm::Sha256.block_len()}");
    let d = Digest::new(HashAlgorithm::Sha256);
    d.update("abc");
    println(f"digest {d.finish().len()}");
    println(f"sha3 {Sha3_256::digest("a").len()} {Sha3_512::digest("a").len()}");
    let s = Shake128::new();
    s.update("a");
    let t = Shake256::new();
    t.update("a");
    println(f"shake {s.squeeze(16).len()} {t.squeeze(32).len()}");
    let tag = Hmac::mac(HashAlgorithm::Sha256, "key", "msg");
    println(f"hmac {Hmac::verify(HashAlgorithm::Sha256, "key", "msg", tag)}");
    let prk = hkdf::extract(HashAlgorithm::Sha256, "salt", "ikm");
    let okm = try hkdf::expand(HashAlgorithm::Sha256, prk, "", 42usize) catch _ { crypto::Secret::zeroed(0) };
    println(f"hkdf {okm.len()}");
    let key: List<u8> = [];
    for _ in 0..32 { key.push(7u8); }
    let nonce: List<u8> = [];
    for _ in 0..12 { nonce.push(1u8); }
    let alg = AeadAlgorithm::ChaCha20Poly1305;
    let a = try Aead::new(alg, key) catch _ { panic("key") };
    let sealed = try a.seal(nonce, "", "hello world!") catch _ { [] };
    let opened = try a.open(nonce, "", sealed) catch _ { none };
    let n = match opened { p: List<u8> => p.len(), _: none => 0usize };
    println(f"aead {alg.nonce_len()} {alg.tag_len()} {sealed.len()} {n / 4usize}");
    let pk = (try! x25519::PrivateKey::from_bytes(key)).public_key();
    println(f"x25519 {pk.to_bytes().len()}");
    println(f"mlkem {mlkem::EncapsulationKey768::LEN} {mlkem::EncapsulationKey768::CIPHERTEXT_LEN} {mlkem::SHARED_KEY_LEN}");
    let ek = try! ed25519::SigningKey::from_seed(key);
    let sig = ek.sign("m");
    println(f"ed25519 {ek.verifying_key().verify("m", sig)}");
    let ck = try! ecdsa::SigningKey::from_bytes(EcCurve::P256, key);
    let csig = ck.sign(HashAlgorithm::Sha256, "m");
    println(f"ecdsa {ck.verifying_key().verify(HashAlgorithm::Sha256, "m", csig)}");
    let bad: rsa::PublicKey | none = try rsa::PublicKey::from_pkcs1_der("x") catch _ { none };
    let bad2: rsa::PrivateKey | none = try rsa::PrivateKey::from_pkcs1_der("x") catch _ { none };
    println(f"rsa {bad is none && bad2 is none}");
    let h: HashAlgorithm = crypto::sha2::HashAlgorithm::Sha384;
    let g: crypto::aead::Aead = a;
    println(f"same type {h.output_len() == 48usize && g.algorithm().key_len() == 32usize}");
}

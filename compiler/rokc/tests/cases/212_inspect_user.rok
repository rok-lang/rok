// expect-exit: 0
// expect-stdout:
// ["id", "name", "email"]
// str
// true
// 42
// id = u64
// name = str
// email = str

// The `User` example - an `i32` literal sets a `u64`
// field (it fits) - and `dump_struct` over `T: Inspect`.
#[derive(Inspect)]
struct User {
    id: u64;
    name: str;
    email: str;
}

fn dump_struct<T: Inspect>(x: T) {
    for name in T::field_names() {
        if let v: any = x.get_field(name) {
            println(f"{name} = {v.type_name_of_val()}");
        }
    }
}

let u = User { id: 1, name: "Alice", email: "a@b" };
println(f"{User::field_names():?}");
match u.get_field("name") {
    v: any => println(v.type_name_of_val()),
    none => println("none"),
}
println(f"{u.set_field("id", 42)}");
println(f"{u.id}");
dump_struct(u);

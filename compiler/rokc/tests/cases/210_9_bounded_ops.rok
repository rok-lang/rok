// spec: §2.10.9
// expect-exit: 0
// expect-stdout: 4 true -3

// Operators on a type parameter come from its bounds or their
// supertraits (`PartialOrd: PartialEq`).
fn double<T: ops::Add<T, Output = T>>(x: T) -> T { x + x }
fn same<T>(a: T, b: T) -> bool where T: PartialOrd { a == b }
fn neg<T: ops::Neg<Output = T>>(x: T) -> T { -x }
println(f"{double(2)} {same(1, 1)} {neg(3)}");

// only-target: wasm32-wasip2
// wasm-reactor
// expect-exit: 0
// wasm-invoke: hello("you") => "hello, you"
// wasm-invoke: deep(none) => some(some("none"))
// wasm-invoke: deep(some(none)) => some(none)
// wasm-invoke: deep(some(some("a"))) => none
// wasm-invoke: deep(some(some("b"))) => some(some("bb"))

// A world of exports only is a reactor; `include .. with` renames.
ffi::wit::export { "wit/lib.wit" }

#[wit::export]
fn hello(who: str) -> str { f"hello, {who}" }

#[wit::export]
fn deep(x: str??) -> str?? {
    let inner_none: str? = none;
    match x {
        none => {
            return "none";
        }
        v: str? => match v {
            none => {
                return inner_none;
            }
            s: str => {
                if s == "a" {
                    return none;
                }
                return f"{s}{s}";
            }
        },
    }
}

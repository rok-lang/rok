// expect-exit: 0
// gc-stress: 50
// expect-stdout:
// lines 3000 sum 4498500 last [line 2999]
// kept [line 7|line 1500|line 2999]
// split 4 [b] trim [mid] strip [tail]
// C 3 5 llo
// bytes 104 101 313 5 104
// literal 98 99
// ok

// Slices share their source's bytes and keep them alive.
extern "C" {
    fn strlen(s: str) -> usize;
    fn strchr(s: str, c: i32) -> str;
    fn rok_gc_collect();
}

fn build(n: i32) -> str {
    let b = StrBuf::new();
    for i in 0..n {
        b.push_str(f"line {i}");
        b.push_str(if i % 2 == 0 { "\n" } else { "\r\n" });
    }
    b.to_str()
}

fn keep() -> List<str> {
    let kept: List<str> = List::new();
    let count = 0;
    let sum = 0;
    let last = "";
    for l in build(3000).lines() {
        let n = l.strip_prefix("line ") ?? "x";
        sum += try! n.parse::<i32>();
        if count == 7 || count == 1500 || count == 2999 { kept.push(l); }
        last = l;
        count += 1;
    }
    println(f"lines {count} sum {sum} last [{last}]");
    kept
}

fn main() {
    let kept = keep();
    // Churn so the source string's block is collected or evacuated.
    let junk = "";
    for i in 0..20000 { junk = f"junk {i}"; }
    unsafe { rok_gc_collect() };
    println(f"kept [{kept[0]}|{kept[1]}|{kept[2]}]");

    let src = "a," + "b,  mid  ,tail";
    let parts: List<str> = List::new();
    for p in src.split(",") { parts.push(p); }
    let tail = src.strip_suffix("") ?? "";
    println(f"split {parts.len()} [{parts[1]}] trim [{parts[2].trim()}] strip [{(tail.strip_prefix("a,b,  mid  ,") ?? "?")}]");

    let hello = "hel" + "lo world";
    let head = hello[0:5];
    unsafe { rok_gc_collect() };
    let found = unsafe { strchr(head, 108) };
    unsafe { rok_gc_collect() };
    println(f"C {unsafe { strlen(head[0:3]) }} {unsafe { strlen(head) }} {found}");

    let bs = head.as_bytes();
    let total = 0usize;
    for b in head.bytes() { total += b as usize; }
    let sum3 = (bs[0] as usize) + (bs[1] as usize) + (bs[2] as usize);
    println(f"bytes {bs[0]} {head.byte(1)} {sum3} {bs.len()} {hello.byte(0)}");
    let lit = "abc"[1:3].as_bytes();
    println(f"literal {lit[0]} {lit[1]}");
    if total == 532 && head.byte(4) == 111u8 { println("ok"); }
}


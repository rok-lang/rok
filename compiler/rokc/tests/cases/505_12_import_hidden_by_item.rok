mod geo { pub struct Point { pub x: i32 } pub const MAX: i32 = 3; pub fn area(a: i32) -> i32 { a } pub fn len() -> i32 { 1 } }
use geo::area;
use geo::{Point, MAX};
use geo::{len as size};
enum Dir { Up, Down }
use Dir::{Up};

fn area() -> bool { true }
struct Point { y: i32 }
const MAX: i32 = 4;
fn size() -> i32 { 2 }

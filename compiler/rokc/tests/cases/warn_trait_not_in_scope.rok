// spec: 003.05-member-access-and-method-call
// expect-exit: 0
// expect-lint: 25:9 method `wave` comes from trait `b::Wave`, which is not in scope
// expect-lint: 30:13 method `hi` comes from trait `a::Greet`, which is not in scope
// expect-warning: help: add `use a::Greet;`
// expect-warning: help: add `use pkg::b::Wave;`
// expect-stdout: a.hi a.hi b.wave b.wave

// A method from a trait neither defined nor `use`d in the module still
// resolves, with a warning that names the `use` to add.
mod a {
    pub trait Greet { fn hi(self) -> str; }
    impl Greet for i32 { fn hi(self) -> str { "a.hi" } }
}

mod b {
    pub trait Wave { fn wave(self) -> str; }
    impl Wave for i32 { fn wave(self) -> str { "b.wave" } }
}

mod c {
    use pkg::a::Greet;
    pub fn greet() -> str { 2.hi() }
    pub fn wave() -> str {
        3.wave()
    }
}

fn main() {
    let s = 1.hi();
    let w = {
        use b::Wave;
        4.wave()
    };
    println(f"{s} {c::greet()} {c::wave()} {w}");
}

// expect-exit: 0
// expect-stdout:
// tuple: true false true true false true
// tcmp: Less Equal Greater true true
// tminmax: (1, "b") (2, "a") (1, "z")
// nan: false false
// smallest: (0, 9)
// derive: true
// sum: none 1 none 5
// clamp: 2 2 4

// Tuples are `PartialOrd` / `Ord` lexicographically, with
// the operators (`<`, `==`, ..) and `Ord`'s `min` / `max` / `clamp`;
// `T | none` (compiler-dispatched `Ord`, `none` first) gets `min` / `max` /
// `clamp` too.
fn name(o: Ordering) -> str {
    match o { Ordering::Less => "Less", Ordering::Equal => "Equal", Ordering::Greater => "Greater" }
}

fn smallest<T: Ord>(xs: List<T>) -> T {
    let m = xs[0];
    for i in 0..xs.len() { m = m.min(xs[i]); }
    m
}

#[derive(PartialEq, PartialOrd)]
struct Rec { k: (i32, str); }

fn main() -> i32 {
    let a = (1, "b");
    let b = (2, "a");
    let c = (1, "z");
    println(f"tuple: {a < b} {b < a} {a < c} {a <= a} {a > c} {c >= a}");
    println(f"tcmp: {name(a.cmp(b))} {name(a.cmp(a))} {name(c.cmp(a))} {a == (1, "b")} {a != b}");
    println(f"tminmax: {a.min(b):?} {a.max(b):?} {c.clamp(a, a.max(c)):?}");
    let nan = 0.0 / 0.0;
    println(f"nan: {(1, nan) < (1, 2.0)} {(1, nan) >= (1, 2.0)}");
    let ps: List<(i32, i32)> = [(3, 1), (0, 9), (1, 0)];
    println(f"smallest: {smallest(ps):?}");
    println(f"derive: {Rec { k: (1, "a") } < Rec { k: (1, "b") }}");

    let n: i32 | none = none;
    let one: i32 | none = 1;
    let five: i32 | none = 5;
    println(f"sum: {n.min(one):?} {n.max(one):?} {five.min(n):?} {five.max(one):?}");
    let lo: i32 | none = 2;
    let hi: i32 | none = 5;
    let v: i32 | none = 4;
    let lowv: i32 | none = 0;
    println(f"clamp: {lowv.clamp(lo, hi):?} {n.clamp(lo, hi):?} {v.clamp(lo, hi):?}");
    0
}

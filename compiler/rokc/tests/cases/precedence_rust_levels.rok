// spec: 003.02.3-precedence-table
// expect-exit: 0
// expect-stdout:
// 24 64 3 0 7 9
// 5 true true 4
// 24 64 3 2

// The binary operators bind as in Rust (spec 3.2.3): `* / %`, then
// `+ -`, then `<< >>`, then `&`, then `^`, then `|`, then comparisons,
// then `&&`, then `||`.
const SHIFT: i32 = 1 + 2 << 3;

fn main() {
    // `(1 + 2) << 3`, `1 << (3 * 2)`, `1 ^ (6 & 2)`, `8 | (3 & 1)`.
    let a = 1 + 2 << 3;
    let b = 1 << 3 * 2;
    let c = 1 ^ 6 & 2;
    let d = 6 & 3 ^ 2;
    let e = 1 | 2 ^ 4;
    let f = 8 | 3 & 1;
    println(f"{a} {b} {c} {d} {e} {f}");
    // Bitwise operators bind tighter than comparisons, which bind tighter
    // than `&&` and `||`.
    let g = 1 | 4 & 7;
    let h = 4 & 6 == 4;
    let i = false && true || 1 + 1 == 2;
    let j = 32 >> 2 + 2 - 1;
    println(f"{g} {h} {i} {j}");
    // The same in a constant and with parentheses written out.
    println(f"{SHIFT} {(1 << 3) * 8} {(1 ^ 6) & 3} {(6 & 3) ^ 0}");
}

// expect-error: where_on_types_unmet.rok:8:13: type `Tok` does not satisfy trait bound `Display` required by `W<Tok>`
// A struct's `where` bounds are checked at each
// instantiation, like inline bounds.
struct Tok { v: i32; }
struct W<T> where T: Display { v: T; }

fn main() -> i32 {
    let w = W { v: Tok { v: 1 } };
    return w.v.v;
}


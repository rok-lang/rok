// spec: std 218-task §2.18.3
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/task_host_leave_outside.rok:11:9:
// expect-stderr: task::host_leave without task::host_enter: only a WebAssembly component's export loop enters and leaves the host's executor
// expect-stdout:

// `host_leave` outside `host_enter` (here in `block_on`) says so, not
// that no executor runs.
fn main() {
    let v = task::block_on(async {
        task::host_leave();
        await task::sleep(Duration::ms(1));
        1
    });
    println(f"{v}");
}

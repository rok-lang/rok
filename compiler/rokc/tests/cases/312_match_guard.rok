// expect-exit: 0
// expect-stdout:
// big
// small
// big

// Match arm guard `if cond`.
fn classify(n: i32) -> i32 {
    let r = match n {
        x if x > 100 => 1,
        _ => 2,
    };
    return r;
}

fn main() -> i32 {
    if classify(150) == 1 { println("big"); }
    if classify(5) == 2 { println("small"); }
    if classify(101) == 1 { println("big"); }
    return 0;
}

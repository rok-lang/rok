// needs: threads
// expect-exit: 0
// gc-stress: 20
// expect-stdout:
// old [1, 2] now [7]
// took [7] left []
// count 5 6
// ptr 42 42

// The owned forms of `ThreadLocal`: `set`, `replace` (the old value
// out), `take` (`T: Default`), `get` for a `Copy` value; `as_ptr` points
// at this thread's value while the thread lives.
use rok::std::thread;

static TL: thread::ThreadLocal<List<i32>> = thread::local(|| -> List<i32> { [] });
static N: thread::ThreadLocal<i64> = thread::local(|| 0i64);

fn main() {
    TL.set([1, 2]);
    let old = TL.replace([7]);
    println(f"old {old:?} now {TL.with(|l| l.clone()):?}");
    let took = TL.take();
    println(f"took {took:?} left {TL.with(|l| l.clone()):?}");
    N.set(5);
    let a = N.get();
    N.set(N.get() + 1);
    println(f"count {a} {N.get()}");
    let p = unsafe { N.as_ptr() };
    unsafe { p.write(42) };
    let garbage: List<List<i32>> = [];
    for i in 0..2000 { garbage.push([i]); }
    println(f"ptr {N.get()} {unsafe { p.read() }}");
}

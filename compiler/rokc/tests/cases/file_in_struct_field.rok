// expect-exit: 0
// expect-stdout:
// log: one two

// spec: std 213-marker §2.13.4

// A struct holding a `File` must be closed too; its own `close` closes
// the field (a struct whose close can fail implements `io::Close`).

use rok::std::fs;
use rok::std::fs::File;
use rok::std::io::{Close, IoError};
use rok::std::{env, process};

struct Log { f: File; lines: i32; }

impl Log {
    fn add(self, s: str) throws (IoError) -> Log {
        try self.f.write_str(s);
        Log { f: self.f, lines: self.lines + 1 }
    }
}

impl Close for Log {
    fn close(self) throws (IoError) { try self.f.close(); }
}

fn main() throws (IoError) {
    let p = env::temp_dir() / f"rok_file_in_struct_{process::id()}.txt";
    let log = Log { f: try fs::create(p), lines: 0 };
    log = try log.add("one ");
    log = try log.add("two");
    try log.close();
    println(f"log: {try fs::read_to_str(p)}");
    try fs::remove_file(p);
}

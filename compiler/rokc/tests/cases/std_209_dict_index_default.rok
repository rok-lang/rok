// expect-exit: 0
// expect-stdout:
// {"a": 3, "b": 1, "c": 1}
// -1 3
// n 2 3
// s 1 5
// {2: ["aa", "cc"], 1: ["b"]}
// {"x": 9}

// `d[k, default: v]`: read without inserting (`get_or`); as an assignment
// or compound-assignment target, or a method receiver, `v` is stored
// first when `k` is absent (`get_or_insert`).
struct Group { orders: i32; units: i32; }

let counts: Dict<str, i32> = Dict::new();
for w in ["a", "b", "a", "c", "a"] {
    counts[w, default: 0] += 1;
}
println(f"{counts:?}");
println(counts["zz", default: -1], counts.len());
let groups: Dict<str, Group> = Dict::new();
for (r, u) in [("n", 2), ("s", 5), ("n", 1)] {
    groups[r, default: Group { orders: 0, units: 0 }].orders += 1;
    groups[r].units += u;
}
for (k, g) in groups {
    println(f"{k} {g.orders} {g.units}");
}
let by: Dict<i32, List<str>> = Dict::new();
for w in ["aa", "b", "cc"] {
    by[w.len() as i32, default: []].push(w);
}
println(f"{by:?}");
let d2: Dict<str, i32> = Dict::new();
d2["x", default: 5] = 9;
println(f"{d2:?}");

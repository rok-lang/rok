// expect-exit: 0
// expect-stdout:
// unit 2 3
// 2 4 7

// A block whose last statement omits its `;` has the value it
// has with the `;`: unit. A last expression is still the block's value.
struct P { x: i32; }

fn main() -> i32 {
    let x = 0;
    let p = P { x: 0 };
    let _a: () = { x = 1 };
    let _b: () = { x += 1 };
    let _c: () = { p.x += 3 };
    let _d: () = { let _y = x };
    let _e: () = { let (_f, _g) = (x, p.x) };
    println(f"unit {x} {p.x}");

    // Value expressions keep their meaning.
    let v: i32 = { x };
    let w: i32 = { let y = x; y * 2 };
    let t = if v > 1 { v + 5 } else { 0 };
    println(f"{v} {w} {t}");
    return 0;
}

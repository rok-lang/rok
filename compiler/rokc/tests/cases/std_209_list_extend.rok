// expect-exit: 0
// expect-stdout:
// cap ok true
// [1, 2, 3, 4]
// shrunk true

// Lists `extend<I: IntoIterator<Item = T>>` and `shrink_to_fit`
// among List's core methods.
fn main() {
    let xs: List<i32> = List::with_capacity(16);
    println(f"cap ok {xs.capacity() >= 16}");
    xs.push(1);
    xs.extend([2, 3, 4]);
    println(f"{xs:?}");
    xs.shrink_to_fit();
    println(f"shrunk {xs.capacity() >= xs.len()}");
}

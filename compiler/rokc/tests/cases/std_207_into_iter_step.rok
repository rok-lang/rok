// spec: std 207-iter §2.7.2 §2.7.3 §2.7.6-2.7.8 §2.7.10a
// expect-exit: 0
// expect-stdout:
// pairs 1:2 3:4
// countdown 3 2 1
// days Mon Tue Wed Thu Fri | Mon Tue | Sat Sun
// 2 none 254 none 3 none
// chars 2 55295 57344
// ordered b=1 a=2 | z y | 20 30 | 4 5
// 100 45 [4, 3, 2, 1, 0]
// [1, 4, 9] [11, 22]
// 0 1 2 shared
// try 1 2 caught 3

// `IntoIterator`, `Step`, per-collection orders, generator iterators.
struct Pairs { xs: List<i32>; }

impl IntoIterator for Pairs {
    type Item = (i32, i32);
    type IntoIter = PairIter;
    fn into_iter(self) -> PairIter { PairIter { xs: self.xs, at: 0 } }
}

struct PairIter { xs: List<i32>; at: usize; }

impl Iterator for PairIter {
    type Item = (i32, i32);
    fn next(ref self) -> (i32, i32) | none {
        if self.at + 1 >= self.xs.len() { return none; }
        let p = (self.xs[self.at], self.xs[self.at + 1]);
        self.at += 2;
        p
    }
}

struct Countdown { n: i32; }

impl Iterator for Countdown {
    type Item = i32;
    fn next(ref self) -> i32 | none {
        if self.n == 0 { return none; }
        self.n -= 1;
        self.n + 1
    }
}

#[derive(Clone, PartialEq, PartialOrd, Debug)]
enum Weekday { Mon, Tue, Wed, Thu, Fri, Sat, Sun }

fn day(i: usize) -> Weekday | none {
    match i {
        0 => Weekday::Mon, 1 => Weekday::Tue, 2 => Weekday::Wed, 3 => Weekday::Thu,
        4 => Weekday::Fri, 5 => Weekday::Sat, 6 => Weekday::Sun,
        _ => none,
    }
}

fn index(d: Weekday) -> usize {
    match d {
        Weekday::Mon => 0, Weekday::Tue => 1, Weekday::Wed => 2, Weekday::Thu => 3,
        Weekday::Fri => 4, Weekday::Sat => 5, Weekday::Sun => 6,
    }
}

impl range::Step for Weekday {
    fn forward_checked(self, n: usize) -> Weekday | none { day(index(self) + n) }
    fn backward_checked(self, n: usize) -> Weekday | none {
        if n > index(self) { none } else { day(index(self) - n) }
    }
    fn steps_between(s: Weekday, e: Weekday) -> usize | none {
        if index(e) < index(s) { none } else { index(e) - index(s) }
    }
}

fn sq(x: i32) -> i32 { x * x }
fn add(a: i32, b: i32) -> i32 { a + b }

yield fn counter() -> i32 {
    yield 0;
    yield 1;
    yield 2;
}

yield fn risky() throws (str) -> i32 {
    yield 1;
    yield 2;
    throw "3";
}

fn main() {
    print("pairs");
    for (a, b) in (Pairs { xs: [1, 2, 3, 4, 5] }) { print(f" {a}:{b}"); }
    println("");
    print("countdown");
    for v in (Countdown { n: 3 }) { print(f" {v}"); }
    println("");
    print("days");
    let week = Weekday::Mon..=Weekday::Fri;
    for d in week { print(f" {d:?}"); }
    print(" |");
    for d in Weekday::Mon..Weekday::Wed { print(f" {d:?}"); }
    print(" |");
    for d in Weekday::Sat..=Weekday::Sun { print(f" {d:?}"); }
    println("");
    println(f"{1i8.forward_checked(1) ?? 0} {127i8.forward_checked(1):?} {255u8.backward_checked(1) ?? 0} {0u8.backward_checked(1):?} {i32::steps_between(2, 5) ?? 0} {i32::steps_between(5, 2):?}");
    let cs: List<char> = ('\u{D7FE}'..='\u{E000}').collect();
    println(f"chars {cs.len() - 1} {cs[1] as u32} {cs[2] as u32}");
    let od: Dict<str, i32> = Dict::new();
    od["b"] = 1;
    od["a"] = 2;
    let os: Set<str> = Set::new();
    os.insert("z");
    os.insert("y");
    print("ordered");
    for (k, v) in od { print(f" {k}={v}"); }
    print(" |");
    for s in os { print(f" {s}"); }
    print(" |");
    let xs = [10, 20, 30];
    for x in xs[1:] { print(f" {x}"); }
    print(" |");
    for i in 4..6 { print(f" {i}"); }
    println("");
    let r: List<i32> = (0..5).rev().collect();
    println(f"{(0..).take(100).count()} {(0..).take(10).sum()} {r:?}");
    let ys: List<i32> = sq.([1, 2, 3]);
    let zs: List<i32> = add.([1, 2], [10, 20]);
    println(f"{ys:?} {zs:?}");
    let g = counter();
    let h = g;
    let first = g.next() ?? -1;
    let second = h.next() ?? -1;
    println(f"{first} {second} {g.next() ?? -1} shared");
    print("try");
    try for v in risky() { print(f" {v}"); } catch e { print(f" caught {e}"); }
    println("");
}

// expect-exit: 0
// expect-stdout:
// P { a: 1 }
// 2

// The `Rokon` derive's own names (`Dict`, ..) are the standard
// library's: a type of that name here does not take their place.
use rok::std::rokon;

struct Dict {
    n: i32;
}

#[derive(Rokon, Debug)]
struct P {
    a: i32;
}

fn main() {
    let back: P = try! rokon::from_str(try! rokon::to_str(P { a: 1 }));
    println(f"{back:?}");
    println(Dict { n: 2 }.n);
}

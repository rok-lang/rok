// spec: 003.11.1-identifier-pattern
// expect-exit: 0
// expect-lint: 18:15 `LIMIT` here is a new variable that matches every value, not the const `LIMIT`
// expect-lint: 19:15 `ORIGIN` here is a new variable that matches every value, not the static `ORIGIN`
// expect-lint: 20:57 `Gren` here is a new variable that matches every value
// expect-warning: help: to compare with the const, write `x if x == LIMIT`
// expect-warning: help: did you mean the variant `Color::Green`?
// expect-stdout: limit 3 | origin 4 | gren? | Foo=7 | five 5 | green

// A const, a static or a misspelled variant in a pattern is a new
// binding that matches everything: a warning names what to write.
const LIMIT: i32 = 5;
static ORIGIN: i32 = 0;
enum Color { Red, Green }

fn main() {
    let out = [];
    match 3 { LIMIT => out.push(f"limit {LIMIT}") };
    match 4 { ORIGIN => out.push(f"origin {ORIGIN}") };
    match Color::Green { Color::Red => out.push("red"), Gren => out.push("gren?") };
    // Capitalised but neither a value nor close to a variant: no warning.
    match 7 { Foo => out.push(f"Foo={Foo}") };
    // What the warning suggests.
    match 5 { x if x == LIMIT => out.push(f"five {x}"), _ => out.push("other") };
    match Color::Green { Color::Red => out.push("red"), Color::Green => out.push("green") };
    println(out.join(" | "));
}

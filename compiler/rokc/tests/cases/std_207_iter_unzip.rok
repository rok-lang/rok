// expect-exit: 0
// expect-stdout:
// list [1, 2, 3] ["a", "b", "c"]
// zip [1, 2] [true, false]
// map [1, 2, 3] ["1", "2", "3"]
// nested [1, 2] [(3, 4), (5, 6)]
// empty [] []

// `unzip` infers its list types from `Item = (A, B)`: on a list of
// pairs, on zipped iterators, on mapped items, with tuple seconds.

fn main() {
    let pairs: List<(i32, str)> = [(1, "a"), (2, "b"), (3, "c")];
    let (ns, cs) = pairs.iter().unzip();
    println(f"list {ns:?} {cs:?}");

    let xs: List<i64> = [1, 2, 3];
    let flags: List<bool> = [true, false];
    let (ys, fs) = xs.iter().zip(flags.iter()).unzip();
    println(f"zip {ys:?} {fs:?}");

    let (ms, ss) = xs.iter().map(|x| (x, f"{x}")).unzip();
    println(f"map {ms:?} {ss:?}");

    let deep: List<(u8, (i32, i32))> = [(1, (3, 4)), (2, (5, 6))];
    let (us, ts) = deep.iter().unzip();
    println(f"nested {us:?} {ts:?}");

    let none_: List<(i32, str)> = [];
    let (e0, e1) = none_.iter().unzip();
    println(f"empty {e0:?} {e1:?}");
}

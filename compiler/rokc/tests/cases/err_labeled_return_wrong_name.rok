// expect-error: `return@map`: no enclosing trailing closure of a call to `map`
// expect-error: help: the innermost closure here is the trailing closure of `each`: write `return@each`

// `return@name` names the innermost closure: the trailing closure of a
// call to `name`.
fn each(xs: List<i32>, f: fn(i32) -> ()) { for x in xs { f(x); } }

fn main() {
    each([1, 2]) |x| {
        if x == 1 { return@map; }
        println(f"{x}");
    }
}

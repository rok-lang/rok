// spec: std 307-process §3.7.1
// only-os: macos linux
// needs: process
// expect-exit: 0
// expect-warning: this command does nothing until it runs
// expect-stdout:
// base: 0
// a: 1 x
// b: 2 y z
// env: unset set

// A builder call returns a changed copy and leaves the command it was
// called on as it was, so copies of a `Command` are independent. A
// builder result left unused warns.
use rok::std::process::Command;
use rok::core::io::IoError;

fn run(c: Command) throws (IoError) -> str {
    let o = try c.output();
    (try! str::from_utf8(o.stdout)).trim()
}

fn main() throws (IoError) {
    let base = Command::new("/bin/sh").args(["-c", "echo $# \"$@\"", "sh"]);
    let a = base.arg("x");
    let b = base.args(["y", "z"]);
    base.arg("lost");
    println(f"base: {try run(base)}");
    println(f"a: {try run(a)}");
    println(f"b: {try run(b)}");
    let e = Command::new("/bin/sh").args(["-c", "echo ${ROK_COPY:-unset}"]);
    let f = e.env("ROK_COPY", "set");
    println(f"env: {try run(e)} {try run(f)}");
}

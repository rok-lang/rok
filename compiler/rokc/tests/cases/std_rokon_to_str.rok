// spec: std 309-rokon §3.9.3 §3.9.4 §3.9.5
// expect-exit: 0
// expect-stdout:
// Conf { a: 1, b: 2.5, tags: ["x"] }
// at .b: NaN/infinity has no ROKON form
// at [1][0]: NaN/infinity has no ROKON form
// at ["k"]: NaN/infinity has no ROKON form
// 1:22: unknown field `c` in Conf
// Item { v: 1 }
// Item { v: 2 }
// Tag::Named { v: 3 }
// (Item { v: 1 }, [["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"]])

// `to_str` throws on a NaN or infinite float, with its path, and
// `to_str_flat` writes one line. A read skips a field the type does not
// have; `#[rokon(deny_unknown_fields)]` makes it an error.
use rok::std::rokon;

#[derive(Rokon)]
#[rokon(deny_unknown_fields)]
struct Conf { a: i32; b: float; tags: List<str>; }

#[derive(Rokon)]
struct Item { v: i32; }

#[derive(Rokon)]
enum Tag { Named { v: i32; } }

fn main() {
    println(try! rokon::to_str(Conf { a: 1, b: 2.5, tags: ["x"] }));
    try rokon::to_str(Conf { a: 1, b: 0.0 / 0.0, tags: [] }) catch e { println(f"{e}"); "" };
    let rows: List<List<float>> = [[1.0], [1.0 / 0.0]];
    try rokon::to_str(rows) catch e { println(f"{e}"); "" };
    let d: Dict<str, f64> = {"k": f64::INFINITY};
    try rokon::to_str_flat(d) catch e { println(f"{e}"); "" };
    try rokon::from_str::<Conf>("Conf { a: 1, b: 2.0, c: 3, tags: [] }") catch e {
        println(f"{e}");
        Conf { a: 0, b: 0.0, tags: [] }
    };
    println(try! rokon::to_str(Item { v: 1 }));
    let i: Item = try! rokon::from_str("Item { v: 2, later: [1, 2] }");
    println(try! rokon::to_str(i));
    let t: Tag = try! rokon::from_str("Tag::Named { v: 3, w: 4 }");
    println(try! rokon::to_str(t));
    let long = "x".repeat(30);
    println(try! rokon::to_str_flat((Item { v: 1 }, [[long, long, long, long]])));
}

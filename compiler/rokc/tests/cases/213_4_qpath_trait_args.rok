// expect-exit: 0
// expect-stdout: 1.5 7

// `<P as Convert<f64>>::convert` picks the impl of those trait
// arguments among several impls of one trait.
trait Convert<T> { fn convert(self) -> T; }
struct P { v: i32; }
impl Convert<f64> for P { fn convert(self) -> f64 { 1.5 } }
impl Convert<i32> for P { fn convert(self) -> i32 { 7 } }
let p = P { v: 1 };
let a = <P as Convert<f64>>::convert(p);
let b = <P as Convert<i32>>::convert(p);
println(f"{a} {b}");

// needs: threads net
// expect-exit: 0
// expect-stdout:
// full: resumed false, peer 1, early false, cache 1 -> read:GET /1
// resumed: resumed true, peer 1, early false, cache 1 -> read:GET /2
// 0-rtt: resumed true, peer 1, early true, cache 1 -> early:GET /0rtt
// 0-rtt larger than the ticket allows: resumed true, peer 1, early false, cache 1 -> read:2000 bytes
// another name: resumed false, peer 1, early false, cache 2 -> read:GET /ip
// no cache: resumed false, peer 1, early false, cache 0 -> read:GET /plain
// sha384 ticket: resumed false, peer 1, early false, cache 1 -> read:GET /a256
// sha384 ticket, sha256 suites: resumed false, peer 1, early false, cache 2 -> read:GET /a128
// first: resumed false, peer 1, early false, cache 1 -> read:GET /first
// 0-rtt to a server without it: resumed true, peer 1, early false, cache 1 -> read:GET /late
// served: 8 and 2; store: 5 sessions

// TLS ticket resumption and 0-RTT between our client and server.
use rok::std::net::{tcp_listen, tcp_connect, TcpListener};
use rok::std::net::tls::{Client, Server, ClientConfig, ServerConfig, Certificate, PrivateKey, CipherSuite, SessionCache, TicketStore};
use rok::std::thread;

const CA: str = "-----BEGIN CERTIFICATE-----
MIIBcjCCARigAwIBAgIUesSSl98urNjXdIg9ZEchaXosKn8wCgYIKoZIzj0EAwIw

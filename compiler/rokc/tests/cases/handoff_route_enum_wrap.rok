// needs: threads
// expect-error: `q0` may hold one object twice
// An enum payload stored twice through a helper.
use rok::std::thread;
enum Slot { Full(List<i32>), Empty }
fn wrap(x: List<i32>) -> Slot { Slot::Full(x) }
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let q0: List<Slot> = [];
    let a: List<i32> = [];
    q0.push(wrap(a));
    q0.push(wrap(a));
    if let s: Slot = q0.pop() { match s { Slot::Full(e) => { try! tx.send(e); } Slot::Empty => {} } }
    if let s: Slot = q0.pop() { match s { Slot::Full(f) => { for i in 0..200000 { f.push(i); } let _ = try! t.join(); println(f"len {f.len()}"); } Slot::Empty => {} } }
}

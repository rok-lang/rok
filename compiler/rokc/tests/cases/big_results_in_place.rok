// rokc-arg: -O2
// gc-stress: 40
// expect-exit: 0
// expect-stdout:
// 101 9 9
// 3 7
// 10 hi 11 there 2
// 5 6 7

// Results over 64 bytes are built where they go: in the
// caller's local, or straight in the caller's result. A callee that
// reads its argument or another pointer to that local after it started
// on its result must still see the old value.
use rok::bare::ptr::{ConstPtr, addr_of};

struct Big {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
    e: i64;
    f: i64;
    g: i64;
    h: i64;
    i: i64;
}

struct Named {
    s: str;
    n: i64;
    t: str;
    m: i64;
    o: i64;
    p: i64;
    q: i64;
}

fn big(k: i64) -> Big {
    Big { a: k, b: k, c: k, d: k, e: k, f: k, g: k, h: k, i: k }
}

// Its result is built before it reads `x` again.
#[inline(never)]
fn rebuild(x: Big) -> Big {
    let r = big(x.i);
    r.a = x.a + 100;
    r
}

// Reads the caller's local through `p` while building its result.
#[inline(never)]
fn peek(p: ConstPtr<Big>) -> Big {
    let r = big(7);
    let seen = unsafe { p.read() };
    r.b = seen.b;
    r
}

// GC references in a result built in place, across collections.
#[inline(never)]
fn named(k: i64) -> Named {
    let s = f"h{"i"}";
    let t = f"th{"ere"}";
    let r = Named { s, n: k, t, m: k + 1, o: 0, p: 0, q: 0 };
    let junk: List<str> = [];
    for i in 0..200 {
        junk.push(f"junk{i}");
    }
    r.q = junk.len() as i64 / 100;
    r
}

// A temporary only the return reads, in one of several returns.
#[inline(never)]
fn either(c: bool, k: i64) -> Big {
    if c {
        return big(k);
    }
    let t = big(k + 1);
    t.c = k + 2;
    t
}

fn main() -> i32 {
    let v = big(1);
    v.i = 9;
    v = rebuild(v);
    println(f"{v.a} {v.b} {v.i}");

    let w = big(3);
    let p = addr_of(w).as_const();
    w = peek(p);
    println(f"{w.b} {w.c}");

    let n = named(10);
    println(f"{n.n} {n.s} {n.m} {n.t} {n.q}");

    let x = either(true, 5);
    let y = either(false, 5);
    println(f"{x.a} {y.a} {y.c}");
    return 0;
}

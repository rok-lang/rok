// expect-exit: 0
// expect-stdout:
// 99
// 25
// 60

// The left side of a compound assignment is evaluated once.
// `idx()` prints 99 each time it runs; it must run exactly once.
fn idx() -> usize {
    println(f"{99}");
    return 1usize;
}

fn main() -> i32 {
    let arr: [i32; 3] = [10, 20, 30];
    arr[idx()] += 5;
    println(f"{arr[1]}");
    let i: usize = 2usize;
    arr[i] *= 2;
    println(f"{arr[2]}");
    return 0;
}

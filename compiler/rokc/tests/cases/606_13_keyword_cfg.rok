// expect-exit: 0
// expect-stdout:
// 2

// `#[cfg]` applies to keyword handlers; only the handler whose
// cfg holds (here or on its enclosing module) registers the keyword.
#[cfg(target_os = "nonexistent")]
#[keyword("frob")]
fn frob_a(x: i32) -> i32 { x }

#[cfg(target_os = "nonexistent")]
mod off {
    #[keyword("frob")]
    pub fn frob_c(x: i32) -> i32 { x + 5 }
}

#[cfg(not(target_os = "nonexistent"))]
#[keyword("frob")]
fn frob_b(x: i32) -> i32 { x + 1 }

println(f"{frob(1)}");

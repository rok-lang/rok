fn certs(pems: List<str>) -> List<Certificate> {
    let out: List<Certificate> = [];
    for p in pems {
        for c in try Certificate::from_pem(p) catch _ { [] } { out.push(c); }
    }
    out
}

/// Serve one connection with `chain`; then try `name` against it.
fn attempt(label: str, chain: str, name: str) {
    let l = try tcp_listen("127.0.0.1:0") catch _ { return; };
    let port = (try! l.local_addr()).port();
    let t = thread::spawn(|| {
        let (s, _) = try! l.accept();
        try! l.close();
        let key = try! PrivateKey::from_pem(KEY);
        let certs = try! Certificate::from_pem(chain);
        let srv = try Server::new(s, try! ServerConfig::new(certs, key)) catch _ { return; };
        try srv.write_all("x") catch _ {};
        try! srv.close();
    });
    let cfg = ClientConfig { root_certs: certs([CA]), cipher_suites: CipherSuite::all(), alpn_protocols: [], enable_post_quantum: false, client_cert_chain: [], client_key: none, session_cache: none, early_data: [] };
    let s = try! tcp_connect(f"127.0.0.1:{port}");
    let c = try Client::with_config(s, name, cfg) catch e {
        println(f"{label}: {e.message()}");
        try t.join() catch _ {};
        return;
    };
    println(f"{label}: ok {c.peer_certificates()[0].dns_names()[0]}");
    try! c.close();
    try t.join() catch _ {};
}

fn main() {
    attempt("good", GOOD + INT, "www.rok.test");
    attempt("extra unrelated certificate", GOOD + OUTSIDE + INT, "www.rok.test");
    attempt("missing intermediate", GOOD, "www.rok.test");
    attempt("outside the name constraint", OUTSIDE + INT, "evil.example");
    attempt("expired", EXPIRED + INT, "www.rok.test");
    attempt("clientAuth only", CLIENTONLY + INT, "www.rok.test");
    attempt("issued by a leaf", DEEP + GOOD + INT, "deep.rok.test");
    attempt("wrong host", GOOD + INT, "rok.test");
    let k = try PrivateKey::from_pem(KEY) catch _ { return; };
    println(f"key from PEM: {k is PrivateKey}");
    let ec = try PrivateKey::from_pem(EC_KEY) catch _ { return; };
    println(f"ec key: {ec is PrivateKey}");
    let x25519 = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VuBCIEIAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8g\n-----END PRIVATE KEY-----\n";
    try PrivateKey::from_pem(x25519) catch e { println(f"bad key: {e.message()}"); };
    let roots = try tls::system_roots() catch _ { [] };
    println(f"system roots: {roots.len() > 0}");
}


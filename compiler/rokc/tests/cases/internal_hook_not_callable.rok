// spec: std 004-lang-slot-table §0.4.4
// expect-error: index_from_end
// expect-error: wake_task
// expect-error: fstr_display

// Compiler hooks and executor internals are `pub(pkg)` in core: lowered
// code reaches them through lang slots, user code cannot name them.
fn main() {
    let at = rok::core::index::index_from_end(-1, 3);
    let w = rok::core::task::wake_task;
    let s = rok::core::fmt::fstr_display("", 1);
    let _ = (at, w, s);
}

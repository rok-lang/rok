// expect-error: `r.n` was moved at line 22, and is used here
// expect-error: `f` was moved at line 28, and is used here
// expect-error: help: a `R` has one owner, and `r.n` gave it away; use the new owner
// expect-error: help: a `File` has one owner, and `f` gave it away; use the new owner, or keep a copy with `.try_clone()` before it moves
// forbid-error: keep a copy with `.clone()`

// The use-after-move help offers a copy only in a way the type has one:
// `clone()`, `try_clone()`, or none.

use rok::std::fs;

struct R {
    n: i32;
}

impl Drop for R {
    fn drop(ref self) {}
}

fn no_copy() -> i32 {
    let r = R { n: 1 };
    let other = r;
    r.n + other.n
}

fn try_copy() throws (rok::core::io::IoError) {
    let f = try fs::open("x");
    let g = f;
    try f.close();
    try g.close();
}

fn main() {}

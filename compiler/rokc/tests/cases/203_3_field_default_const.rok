// expect-error: 16:14: the default of field `a` cannot be evaluated at compile time: calls `f`, which is not a `const fn`
// expect-error: 17:13: constant expression overflows `u8`: the result is 400
// expect-error: 18:14: the default of field `c` cannot be evaluated at compile time: reads the static `S`

// Field defaults are constant expressions, checked
// at the declaration even when no literal omits the field, with names
// resolved in the struct's module (a local `three` at the use does not
// shadow the const fn).
const fn three() -> i32 { 3 }
fn f() -> i32 { 3 }
static S: i32 = 1;
struct Good {
    a: i32 = 1 + three();
}
struct Bad {
    a: i32 = f();
    b: u8 = 200 * 2;
    c: i32 = S;
}
fn main() -> i32 {
    let three = 10;
    let o = Good {};
    return o.a + three;
}

// expect-exit: 0
// expect-stdout:
// 2 9 7 [1, 50, 3] 8
// 64 1 1 10 3 12 3
// idx=1 [1, 2, 4]
// Acc(15) adds=2 Plain(7)

// Every lvalue takes `=` and the compound forms; the index runs once.
struct P { x: i32; y: i32; }
struct Pair(i32, i32);
struct Acc { total: i32; adds: i32; }
struct Plain { v: i32; }

impl ops::AddAssign<i32> for Acc {
    fn add_assign(ref self, rhs: i32) {
        self.total += rhs;
        self.adds += 1;
    }
}
impl ops::Add<i32> for Plain {
    type Output = Plain;
    fn add(self, rhs: i32) -> Plain { Plain { v: self.v + rhs } }
}

fn main() -> i32 {
    let x = 1;
    x = 2;
    let p = P { x: 0, y: 0 };
    p.x = 9;
    let t = Pair(0, 0);
    t.0 = 7;
    let arr = [1, 2, 3];
    arr[1] = 50;
    let tup = (1, 2);
    tup.1 = 8;
    println(f"{x} {p.x} {t.0} {arr:?} {tup.1}");

    let a = 2;
    a *= 32;
    let b = 17;
    b %= 5;
    b -= 1;
    let c = 5;
    c &= 3;
    c |= 4;
    c ^= 0;
    c <<= 1;
    let d = 48;
    d >>= 2;
    let e = 7;
    e /= 2;
    println(f"{a} {b} {c / 6} {c} {e} {d} {e}");

    let calls = 0;
    let at = [ref calls] || -> i32 { calls += 1; return 2; };
    let ys = [1, 2, 3];
    ys[at()] += 1;
    println(f"idx={calls} {ys:?}");

    let acc = Acc { total: 0, adds: 0 };
    acc += 10;
    acc += 5;
    let pl = Plain { v: 3 };
    pl += 4;
    println(f"Acc({acc.total}) adds={acc.adds} Plain({pl.v})");
    return 0;
}

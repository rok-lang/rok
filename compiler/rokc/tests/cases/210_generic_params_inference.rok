// spec: §2.10.1 §2.10.2 §2.10.3 §2.10.4 §2.10.6
// expect-exit: 0
// expect-stdout:
// 42 3.14 hello
// 3 a 7
// 0 2 List<i32>
// List<i64> 1 0
// 6 1,2,3
// 7.5 seen

use rok::core::num::Zero;

struct Pair<A, B> { first: A; second: B; }
enum Either<T, E> { Ok(T), Err(E) }
enum Two<A, B> { One(A), Both(A, B) }
type Maybe<T> = T | none;

trait Label<Target> { fn label(self) -> Target; }

impl<T> Label<str> for Pair<T, str> {
    fn label(self) -> str { self.second }
}

fn id<T>(x: T) -> T { x }

fn first<T>(pair: (T, T)) -> T { pair.0 }

fn empty<T>() -> List<T> { [] }

fn takes_ints(xs: List<i32>) -> usize { xs.len() }

fn sum_i64(xs: List<i64>) -> i64 { xs.iter().sum() }

fn sum<T: Zero + ops::Add<T, Output = T> + Clone>(xs: List<T>) -> T {
    let acc: T = T::zero();
    for x in xs { acc = acc + x; }
    acc
}

fn join_all<T: Display + Clone>(items: List<T>) -> str {
    let out = "";
    for (i, x) in items.iter().enumerate() {
        if i > 0 { out = out + ","; }
        out = out + f"{x}";
    }
    out
}

fn complex<T, U, V>(a: T, b: U) -> V
where
    T: ops::Add<U, Output = V>,
    V: Display + Clone,
{
    a + b
}

fn main() {
    // 2.10.6: one instance per type tuple.
    println(f"{id(42i32)} {id(3.14f64)} {id("hello")}");
    let p = Pair { first: 3, second: "a" };
    let m: Maybe<i32> = 7;
    let e: Either<i32, str> = Either::Ok(p.first);
    match e {
        Either::Ok(v) => println(f"{v} {p.label()} {m ?? 0}"),
        Either::Err(e) => println(e),
    }
    // 2.10.2: inference from the expected type and from later uses.
    let xs: List<i32> = empty();
    let zs = List::new();
    zs.push(1);
    zs.push(2);
    let ws = empty();
    let n = takes_ints(ws);
    println(f"{xs.len() + n} {zs.len()} {zs.type_name_of_val()}");
    // An integer literal's default yields to a later `i64` use.
    let ys = List::new();
    ys.push(1);
    let total = sum_i64(ys);
    let z: i32 = Zero::zero();
    println(f"{ys.type_name_of_val()} {total} {z}");
    // 2.10.3 / 2.10.4: bounds and `where`, `Output = V` included.
    println(f"{sum([1, 2, 3])} {join_all([1, 2, 3])}");
    let v: f64 = complex(7.0, 0.5);
    let t = Two::Both(1, "seen");
    match t {
        Two::Both(_, s) => println(f"{v} {s}"),
        Two::One(_) => println("one"),
    }
    let _ = first((1, 2));
}

// only-os: windows
// expect-exit: 0
// spec: std 308-path §3.8.2 / §3.8.5
//
// Windows OS surface: `RawPath` UTF-16 forms, `RawStr` as UTF-16, `ExitStatus` codes,
// argument quoting through `CreateProcessW`, user directories, `;` path
// lists and a file round trip through UTF-16 paths.
// expect-stdout:
// raw ok
// lone surrogate at 1
// a?b
// rawstr 5 true
// args ok
// exit 3
// quoted ok
// home ok
// split 2
// fs ok

use rok::std::path::{Path, RawPath};
use rok::std::process::Command;
use rok::std::env;
use rok::std::fs;

fn main() {
    let raw = Path::new("C:\\é😀").to_raw();
    let back = RawPath::from_wide(list_of(raw.as_wide()));
    if (try back.try_to_path() catch _ { Path::empty() }).as_str() == "C:\\é😀" { println("raw ok"); }

    let bad: List<u16> = List::new();
    bad.push(97u16);
    bad.push(0xD800u16);
    bad.push(98u16);
    let r = RawPath::from_wide(bad);
    try r.try_to_path() catch e { println(f"lone surrogate at {e.valid_up_to}"); };
    println(r.to_path_lossy().as_str().replace("\u{FFFD}", "?"));
    let rs = env::RawStr::from_wide(bad);
    println(f"rawstr {rs.len()} {rs.as_wide() == bad}");
    let a0 = env::args_os()[0];
    if env::RawStr::from_wide(a0.as_wide()) == a0 { println("args ok"); }

    let st = try Command::new("cmd").args(["/c", "exit 3"]).status() catch _ { panic("spawn") };
    println(f"exit {st.code() ?? -1}");

    let out = try Command::new("cmd").args(["/c", "echo", "a b"]).output() catch _ { panic("spawn") };
    let text = try str::from_utf8(out.stdout) catch _ { "" };
    if text.contains("a b") { println("quoted ok"); }

    if env::home_dir() is Path && env::config_dir() is Path && env::cache_dir() is Path { println("home ok"); }
    let parts = env::split_paths("C:\\a;;D:\\b");
    println(f"split {parts.len()}");

    let dir = env::temp_dir() / "rok_win_é";
    try fs::create_dir_all(dir) catch _ {};
    let f = dir / "t.txt";
    try fs::write(f, "hi") catch _ { panic("write") };
    let s = try fs::read_to_str(f) catch _ { "" };
    try fs::remove_dir_all(dir) catch _ {};
    if s == "hi" { println("fs ok"); }
}

fn list_of(s: Slice<u16>) -> List<u16> {
    let out: List<u16> = List::new();
    for u in s { out.push(u); }
    out
}

// `missing_docs` is allowed by default; a package turns it on. Private
// items, trait impls and `#[doc(hidden)]` ones need no docs; a
// `const fn` does.
#![warn(missing_docs)]

/// Documented.
pub fn documented() {}
pub fn bare() {}
pub const fn constant() -> i32 { 1 }

pub struct Point {
    x: i32;
    y: i32;
}

impl Point {
    /// Documented.
    pub fn sum(self) -> i32 { self.x + self.y }
    pub fn norm(self) -> i32 { self.x * self.x + self.y * self.y }
}

pub trait Shape {
    /// Documented.
    fn sides(self) -> i32;
    fn area(self) -> i32;
}

impl Shape for Point {
    fn sides(self) -> i32 { 0 }
    fn area(self) -> i32 { 0 }
}

#[doc(hidden)]
pub fn hidden() {}

let p = Point { x: 1, y: 2 };
println(f"{p.norm()}");

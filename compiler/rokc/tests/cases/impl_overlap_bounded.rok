// expect-error: 15:25: conflicting implementations of trait `Area`: `impl<..> Area for T` and `impl<..> Area for T` overlap on `T` - bounds don't make impls disjoint
// expect-error: 20:18: conflicting implementations of trait `Name`: `impl<..> Name for T` and `impl<..> Name for Wrap<U>` overlap on `Wrap<U>`
// expect-error: 24:26: method `get` is defined more than once for `Wrap<T>`

// Coherence: bounds on a type left generic never make two
// impls disjoint, even when no type meets both bounds yet (Rust-like).
trait Shape {}
trait Color {}
trait Area { fn area(self) -> i32; }
trait Name { fn name(self) -> i32; }
struct Wrap<T> { v: T; }

// No type implements both `Shape` and `Color` - still an overlap.
impl<T: Shape> Area for T { fn area(self) -> i32 { return 1; } }
impl<T: Color> Area for T { fn area(self) -> i32 { return 2; } }

// `Wrap<U>: Shape` may hold (`impl<V> Shape for Wrap<V>`).
impl<V> Shape for Wrap<V> {}
impl<T: Shape> Name for T { fn name(self) -> i32 { return 1; } }
impl<U> Name for Wrap<U> { fn name(self) -> i32 { return 2; } }

// Inherent impls: the same method name under different bounds.
impl<T: Shape> Wrap<T> { fn get(self) -> i32 { return 1; } }
impl<T: Color> Wrap<T> { fn get(self) -> i32 { return 2; } }

fn main() -> i32 { return 0; }


// needs: threads
// expect-exit: 0
// expect-stdout:
// read: hello async
// bytes: 11
// append: hello async more
// chunk 5: hello
// rest:  async more
// len=16 file=true
// dir: x.txt y.txt
// renamed: true false
// copied 16
// NotFound
// concurrent: 32
// cancelled: 0, then: 0123456789
// removed: false

// std::fs `*_async`: each call runs on a blocking thread
// (`task::spawn_blocking`) while the task suspends; errors throw as in
// the sync API; a cancelled task's call still finishes in the background.
use rok::std::fs;
use rok::std::fs::{File, OpenOptions};
use rok::std::io::IoError;
use rok::std::env;
use rok::std::thread;
use rok::std::process;

fn text(buf: List<u8>, n: usize) -> str {
    try! str::from_utf8(buf[0:n])
}

let base = env::temp_dir() / f"rok_std_fs_async_{process::id()}";
try! await fs::create_dir_all_async(base / "d");
let f = base / "d" / "x.txt";
try! await fs::write_async(f, "hello async");
println(f"read: {try! await fs::read_to_str_async(f)}");
println(f"bytes: {(try! await fs::read_async(f)).len()}");

let h = try! await fs::open_with_async(f, OpenOptions::new().append(true));
try! await h.write_all_async(" more");
try! h.close();
println(f"append: {try! await fs::read_to_str_async(f)}");

let r = try! await File::open_async(f);
let buf: List<u8> = [0u8, 0u8, 0u8, 0u8, 0u8];
let n = try! await r.read_async(buf);
println(f"chunk {n}: {text(buf, n)}");
println(f"rest: {try! await r.read_to_str_async()}");
let m = try! await r.metadata_async();
println(f"len={m.len()} file={m.is_file()}");
try! r.close();

let w = try! await File::create_async(base / "d" / "y.txt");
try! await w.write_str_async("y");
try! await w.sync_all_async();
try! w.close();
let names: List<str> = List::new();
for e in try! await fs::read_dir_async(base / "d") { names.push(e.file_name()); }
let a = names[0];
let b = names[1];
if a > b { names[0] = b; names[1] = a; }
println(f"dir: {names[0]} {names[1]}");

try! await fs::rename_async(base / "d" / "y.txt", base / "d" / "z.txt");
let z = await fs::exists_async(base / "d" / "z.txt");
let y = await fs::exists_async(base / "d" / "y.txt");
println(f"renamed: {z} {y}");
println(f"copied {try! await fs::copy_async(f, base / "c.txt")}");
println(try await fs::read_to_str_async(base / "nope") catch e { f"{e.kind():?}" });

// Many tasks at once: each waits on its own thread.
let tasks: List<Task<usize>> = List::new();
for i in 0..32 {
    let p = base / f"t{i}.txt";
    tasks.push(task::spawn(async {
        try! await fs::write_async(p, "abc");
        (try! await fs::read_async(p)).len()
    }));
}
let total: usize = 0;
for t in tasks { total += await t; }
println(f"concurrent: {total / 3}");

// Cancel a task while its blocking call runs: the call finishes in
// the background (the write lands), the task's result is gone. The call
// waits for `release`, so it is still running when the cancel lands.
let started = Mutex::new(false);
let release = Atomic::new(0);
let big = base / "big.txt";
let cw = task::spawn(async {
    let bl = task::spawn_blocking(|| {
        while release.load() == 0 {
            thread::sleep(Duration::ms(1));
        }
        try! fs::write(big, "0123456789");
        1
    });
    using s = started.lock() { s.set(true); }
    await bl
});
while true {
    let go = false;
    using s = started.lock() { go = s.get(); }
    if go { break; }
    await task::sleep(Duration::ms(1));
}
cw.cancel();
let gone = try await cw.join() catch _: CancellationError { 0 };
release.store(1);
while !fs::exists(big) || (try! fs::metadata(big)).len() != 10u64 {
    await task::sleep(Duration::ms(1));
}
println(f"cancelled: {gone}, then: {try! fs::read_to_str(big)}");

try! await fs::remove_dir_all_async(base);
println(f"removed: {await fs::exists_async(base)}");

// spec: std 301-fs

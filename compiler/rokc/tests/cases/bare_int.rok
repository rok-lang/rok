// expect-exit: 21
// expect-stdout:
// 10 21

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn main() -> i32 {
    let xs: [i32; 4] = [1, 2, 3, 4];
    let total = 0;
    let i = 0;
    while i < 4 {
        total += xs[i];
        i += 1;
    }
    println(f"{total} {add(total, 11)}");
    return add(total, 11);
}

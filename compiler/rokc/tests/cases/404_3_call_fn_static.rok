// expect-exit: 0
// expect-stdout:
// 2 3 6 40

// A `static` or `const` of function type is called like a local of that
// type, by name or through a path.

mod m {
    pub fn twice(x: i32) -> i32 { x * 2 }
    pub static G: fn(i32) -> i32 + Send = twice;
}

fn inc(x: i32) -> i32 { x + 1 }

static F: fn(i32) -> i32 + Send = inc;
static K: fn(i32) -> i32 + Send = |x: i32| x * 10;
const C: fn(i32) -> i32 = inc;

fn main() -> i32 {
    println(f"{F(1)} {C(2)} {m::G(3)} {K(4)}");
    return 0;
}

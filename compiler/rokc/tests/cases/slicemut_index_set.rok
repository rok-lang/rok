// expect-exit: 0
// expect-stdout:
// [1, 20, 30, 4] [20, 30] 2
// [1, 20, 31, 4] first 20 last 31 get none
// [1, 0, 0, 4] [0, 0]
// [1, 9, 8, 4]
// [4, 8, 1, 9]
// empty true []

// `s[i] = x` on a `SliceMut` writes the list it views;
// a negative index counts from the end, like `xs[i]`.
fn main() {
    let xs: List<i32> = [1, 2, 3, 4];
    let s: collections::SliceMut<i32> = xs[1:3];
    s[0] = 20;
    s[1] = 30;
    println(f"{xs:?} {s:?} {s.len()}");
    s[-1] += 1;
    println(f"{xs:?} first {s.first() ?? 0} last {s.last() ?? 0} get {if s.get(2) is none { "none" } else { "some" }}");
    s.fill(0);
    println(f"{xs:?} {s:?}");
    s[0] = 9;
    s[1] = 8;
    s.swap(0, 1);
    s.reverse();
    println(f"{xs:?}");
    let all: collections::SliceMut<i32> = xs[..];
    all.reverse();
    all[2..].reverse();
    println(f"{xs:?}");
    let e: collections::SliceMut<i32> = xs[9:];
    println(f"empty {e.is_empty()} {e:?}");
}


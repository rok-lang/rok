// spec: §4.14.11
// expect-error: `m` throws but `T::m` is declared without `throws`, so an impl can't add one (spec 4.14.11)

// Spec 4.14.11: an impl method's `throws` must be the trait method's.
trait T { fn m(self) -> i32; }
struct S {}
impl T for S {
    fn m(self) throws (str) -> i32 { 1 }
}

println(f"{S {}.m()}");
// expect-error-extra: allow
// (the call `S {}.m()` also reports the missing `try`, as the impl's
// throwing method is still the one called)

// spec: refs-lang §5.3 §5.3.9
// expect-error: 13:1: a `static` is shared by every thread, so it can't be a `Dict<i64, i64, RandomState>`: two threads could change it at once
// expect-error: help: write `static D: Mutex<Dict<i64, i64, RandomState>> = Mutex::new(Dict::new());` and use it inside `using g = D.lock() { .. }`
// expect-error: 14:1: a `static` is shared by every thread, so it can't be a `StrBuf`: two threads could change it at once
// expect-error: help: write `static B: Mutex<StrBuf> = Mutex::new(StrBuf::new());` and use it inside `using g = B.lock() { .. }`
// expect-error: 15:1: a `static` is shared by every thread, so it can't be a `RwLock<List<i32>>`: two threads could change it at once
// expect-error: help: write `static RW: Mutex<List<i32>> = Mutex::new(start());` and use it inside `using g = RW.lock() { .. }`

// Lazily initialized statics follow the same rule, and an `RwLock`
// of a collection is not shared-safe either (its readers write).
use rok::std::thread;

static D: Dict<i64, i64> = Dict::new();
static B: StrBuf = StrBuf::new();
static RW: RwLock<List<i32>> = RwLock::new(start());

fn start() -> List<i32> { return [1]; }

fn main() {
    let t = thread::spawn(|| { D.insert(1, 1); B.push_str("x"); 0 });
    D.insert(2, 2);
    try! t.join();
    using g = RW.read() { println(f"{D.len()} {g.get().len()}"); }
}

// expect-exit: 0
// expect-stdout:
// 41
// 1
// 51
// 6
// 9
// 10
// 3

// Narrowing: every `x is T` conjunct of an `&&` chain narrows
// the local `x` to `T` in the conjuncts after it, in the `if` then-block
// and in a `while` body. Assigning to a narrowed `x` writes the original
// slot (the value converted back to the slot's type).
struct P { a: i32; }
let v: any = 41;
if v is i32 && v > 40 { println(f"{v}"); }
let ok = v is i32 && v + 1i32 == 42;
if ok { println(f"{1}"); }
if v is i32 { v = v + 10; }
if v is i32 { println(f"{v}"); }
let w: any = 3;
while w is i32 && w < 6 { w = w + 1; }
if w is i32 { println(f"{w}"); }
let p: any = P { a: 1 };
if p is P { p.a = 9; }
if p is P { println(f"{p.a}"); }
let o: i32 | none = 2;
if o is i32 { o = o * 5; }
match o { n: i32 => println(f"{n}"), none => println(f"{0}"), }
// Nested narrowing writes back through both levels.
let q: any = 1;
if q is i32 { if q is i32 { q = 3; } }
if q is i32 { println(f"{q}"); }


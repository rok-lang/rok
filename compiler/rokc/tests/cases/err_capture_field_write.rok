// spec: 004.06.7-capturing-structs
// expect-error: 14:9: cannot assign to a field of `p`: it is value-captured, so the write would change the closure's copy, not the outer `p`
// expect-error: help: add `[ref p]` to the closure's capture list

// A field write on a value-captured struct would change the closure's
// own copy: an error, like rebinding the capture. `[ref p]` writes the
// outer variable.
struct Point { x: i32; y: i32; }

fn main() {
    let p = Point { x: 0, y: 0 };
    let q = Point { x: 0, y: 0 };
    let f = || {
        p.x = 5;
        p.x
    };
    let g = [ref q] || { q.x = 1; };
    let n = f();
    g();
    println(f"{p.x} {q.x} {n}");
}

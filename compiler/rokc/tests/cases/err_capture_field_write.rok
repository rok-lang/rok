// spec: 004.06.7-capturing-structs
// expect-exit: 0
// expect-lint: 16:9 `p` is value-captured: this write changes the closure's copy, not the outer `p`
// expect-warning: help: add `[ref p]` to the closure's capture list
// expect-stdout: 0 1 5

// A field write on a value-captured struct changes the closure's own
// copy; `[ref p]` writes the outer variable.
struct Point { x: i32; y: i32; }

fn main() {
    let p = Point { x: 0, y: 0 };
    let q = Point { x: 0, y: 0 };
    // The closure reads its copy back: the outer `p` stays.
    let f = || {
        p.x = 5;
        p.x
    };
    let g = [ref q] || { q.x = 1; };
    let n = f();
    g();
    println(f"{p.x} {q.x} {n}");
}

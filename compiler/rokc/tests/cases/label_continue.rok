// expect-exit: 9
// expect-stdout:
// i 1 j 0
// i 3 j 0
// 4 5

// `continue 'outer` skips the rest of the inner loop AND advances the
// outer loop. Sums i for i in 1..=4 only when i is odd (1+3 = 4),
// plus a fixed 5, makes 9.
fn main() -> i32 {
    let total = 0;
    let i = 0;
    'outer: loop {
        i += 1;
        if i > 4 { break; }
        // skip even i (2, 4)
        if i % 2 == 0 { continue 'outer; }
        // odd path: also iterate inner once and sum
        let j = 0;
        loop {
            if j == 1 { break; }
            total += i;       // adds i once per odd
            println(f"i {i} j {j}");
            j += 1;
        }
    }
    println(f"{total} {i}");
    return total + 5;
}

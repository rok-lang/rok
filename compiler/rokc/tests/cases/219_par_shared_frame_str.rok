// needs: threads
// gc-stress: 5
// spec: std 219-par §2.19.1 / std 213-marker §2.13.9
// Two `par` items holding one future's frame would run it on two workers:
// the frame is one object the check sees, so they run one at a time.
// expect-exit: 0
// expect-stderr: warning: par::map at tests/cases/219_par_shared_frame_str.rok:26:14: two items reach one collection or future, so they run one at a time on this thread; give each item its own copy, or share read-only data through `Frozen`
// expect-stdout:
// 101 101

struct Grab {}
impl Future for Grab {
    type Output = Waker;
    fn poll(ref self, ref ctx: Context) -> Poll<Waker> { Poll::Ready(ctx.waker()) }
}
async fn work() -> usize {
    let l: List<str> = [];
    for i in 0..200000 { l.push(f"s{i}"); if l.len() > 500 { l.clear(); } if i % 50 == 0 { await task::yield_now(); } }
    let bad = 0usize; for s in l { if s.len() == 0 { bad += 1; } } bad * 1000000 + l.len()
}
struct H { f: AsyncFuture<usize>; w: Waker; }
async fn main() {
    let w = await Grab {};
    let f = work();
    let hs: List<H> = [H { f, w }, H { f, w }];
    let ns = par::map(hs, |h: H| {
        let ctx = Context::from_waker(h.w);
        let n: usize = 0;
        loop {
            if let Poll::Ready(v) = h.f.poll(ref ctx) { n = v; break; }
        }
        n
    });
    println(f"{ns[0]} {ns[1]}");
}

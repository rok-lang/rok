// needs: threads
// expect-exit: 0
// expect-stdout:
// after notify_one: 1 returned
// after notify_all: 4 returned

// `Condvar::notify_one` wakes one blocked thread, not all of them (the
// woken one finds the flag unset and waits again: 1 + 3 returns).
use rok::std::thread;
use rok::std::time::Duration;

fn main() -> i32 {
    let m = Mutex::new(0);
    let cv = sync::Condvar::new();
    let ready = Atomic::new(0);
    let returned = Atomic::new(0);
    let hs: List<thread::JoinHandle<()>> = [];
    for i in 0..3 {
        hs.push(thread::spawn(|| {
            using g = m.lock() {
                ready.fetch_add(1);
                // Every return from `wait` counts, spurious or not.
                while g.get() == 0 {
                    g = cv.wait(g);
                    returned.fetch_add(1);
                }
            }
        }));
    }
    while ready.load() < 3 { thread::yield_now(); }
    // Until all three are blocked inside `wait`.
    thread::sleep(Duration::ms(200));
    cv.notify_one();
    thread::sleep(Duration::ms(200));
    println(f"after notify_one: {returned.load()} returned");
    using g = m.lock() { g.set(1); }
    cv.notify_all();
    for h in hs { try! h.join(); }
    println(f"after notify_all: {returned.load()} returned");
    0
}
// spec: std §2.16.4a

// needs: fs
// expect-exit: 0
// expect-stdout:
// made: true
// streamed 150 entries, 150 distinct, bytes 340
// sub: a.txt=3 b.txt
// escape: PermissionDenied
// early stop then closed: 3
// after: false

// `Dir`'s `*_async` methods and the `Dir::read_dir_async` stream: the
// entries are read in batches on a blocking thread (more than one batch
// here) while the task suspends between them.
use rok::core::marker::share;
use rok::std::fs;
use rok::std::fs::Dir;
use rok::core::io::IoError;
use rok::std::env;

let base = env::temp_dir() / "rok_std_fs_async_dir";
try! await fs::create_dir_all_async(base);
let d = try! await Dir::root().open_dir_async(base);
try! await d.create_dir_async("many");
try! await d.create_dir_all_async("sub/inner");
println(f"made: {await d.exists_async("sub/inner")}");

let many = try! await d.open_dir_async("many");
for i in 0..150 {
    let f = try! await many.create_async(f"{i}.txt");
    try! await f.write_all_async(f"{i}");
    try! f.close();
}
let seen = Set::<str>::new();
let count = 0;
let sum: u64 = 0;
try! for await x in try! await many.read_dir_async() {
    count += 1;
    seen.insert(x.file_name());
    sum += x.metadata().len();
}
println(f"streamed {count} entries, {seen.len()} distinct, bytes {sum}");

let sub = try! await d.open_dir_async("sub");
try! await sub.rename_async("inner", "gone");
try! await sub.remove_dir_async("gone");
let a_own = try! await sub.create_async("a.txt");
let a = unsafe { share(a_own) };
try! await a.write_all_async("abc");
try! a_own.close();
try! await sub.copy_async("a.txt", "b.txt");
let names: List<str> = List::new();
try! for await e in try! await sub.read_dir_async() {
    names.push(e.file_name());
}
let first = if names[0] < names[1] { names[0] } else { names[1] };
let second = if names[0] < names[1] { names[1] } else { names[0] };
let meta = try! await sub.metadata_async("a.txt");
println(f"sub: {first}={meta.len()} {second}");

try (try await sub.open_async("../many/1.txt")).close() catch e: IoError {
    println(f"escape: {e.kind():?}");
    a
};

// Stop early inside `using`: the stream closes.
let taken = 0;
using s = try! await many.read_dir_async() {
    try! for await e in s {
        taken += 1;
        if taken == 3 { break; }
    }
}
println(f"early stop then closed: {taken}");

try! await sub.close_async();
try! await many.close_async();
try! await d.remove_dir_all_async("many");
println(f"after: {await d.exists_async("many")}");
try! await d.close_async();
try! await fs::remove_dir_all_async(base);

// spec: std 301-fs

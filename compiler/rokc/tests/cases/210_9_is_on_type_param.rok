// expect-exit: 0
// expect-stdout:
// is: true false true true false
// narrow: 2 0 5 10 0
// if let: 1 -1 4 9 -1
// match: i32 1 | str s | i32 4 | i32 9 | other
// sub-sum: false true true true false
// nested: 3 0
// impl: true false

// `is` and type patterns work on an unbounded type
// parameter; each instance decides them by its type argument.
fn is_i32<T>(x: T) -> bool { x is i32 }

fn narrow<T>(x: T) -> i32 {
    if x is i32 { x + 1 } else { 0 }
}

fn if_let<T>(x: T) -> i32 {
    if let n: i32 = x { n } else { -1 }
}

fn kind<T>(x: T) -> str {
    match x {
        n: i32 => f"i32 {n}",
        s: str => f"str {s}",
        _ => "other",
    }
}

fn sub_sum<T>(x: T) -> bool { x is (i32 | str) }

fn first_i32<T>(xs: List<T>) -> i32 {
    for x in xs {
        if let n: i32 = x { return n; }
    }
    0
}

struct Cell<T> { v: T }

impl<T> Cell<T> {
    fn holds_str(self) -> bool { self.v is str }
}

fn main() {
    let s: i32 | str = 4;
    let t: i32 | str = "t";
    let v: any = 9i32;
    println(f"is: {is_i32(1i32)} {is_i32("s")} {is_i32(s)} {is_i32(v)} {is_i32(t)}");
    println(f"narrow: {narrow(1i32)} {narrow("s")} {narrow(s)} {narrow(v)} {narrow(2.0)}");
    println(f"if let: {if_let(1i32)} {if_let("s")} {if_let(s)} {if_let(v)} {if_let(t)}");
    println(f"match: {kind(1i32)} | {kind("s")} | {kind(s)} | {kind(v)} | {kind(2.0)}");
    let w: i32 | str | f64 = 1.5;
    let u: i32 | str | f64 = "u";
    println(f"sub-sum: {sub_sum(w)} {sub_sum(u)} {sub_sum(s)} {sub_sum(1i32)} {sub_sum(2.0)}");
    let xs: List<i32> = [3, 4];
    let ys: List<str> = ["a"];
    println(f"nested: {first_i32(xs)} {first_i32(ys)}");
    println(f"impl: {Cell { v: "a" }.holds_str()} {Cell { v: 1i32 }.holds_str()}");
}

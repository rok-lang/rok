// expect-exit: 0
// expect-stdout:
// true false true true
// true false true false
// true true false
// [1, 2, 3] [2]
// 7 7

// The standard `Contains` / `Subset` / `Union` / `Intersect` / `Compose`
// implementations behind `∈ ∉ ⊂ ⊆ ∪ ∩ ∘`.

fn sorted(s: Set<i32>) -> List<i32> {
    let l = s.to_list();
    l.sort();
    l
}

fn main() -> i32 {
    let xs = [1, 2, 3];
    let d: Dict<str, i32> = {"a": 1};
    println(f"{2 ∈ xs} {5 ∈ xs} {5 ∉ xs} {xs.contains(3)}");
    println(f"{"a" ∈ d} {"b" ∈ d} {"ell" ∈ "hello"} {10 ∈ (0..10)}");
    let a: Set<i32> = {1, 2};
    let b: Set<i32> = {2, 3};
    let c: Set<i32> = {1, 2, 3};
    println(f"{a ⊂ c} {a ⊆ a} {a ⊂ a}");
    println(f"{sorted(a ∪ b):?} {sorted(a ∩ b):?}");
    let inc: fn(i32) -> i32 = |x| x + 1;
    let dbl: fn(i32) -> i32 = |x| x * 2;
    let h = inc ∘ dbl;
    println(f"{h(3)} {inc.compose(dbl)(3)}");
    return 0;
}

// expect-exit: 0
// expect-stdout:
// inactive

// `#[cfg(feature = "x")]` conditional compilation. Without
// `--cfg feature=test` only the `not(feature="test")` branch survives
// (two survivors would be a fn redefinition).
#[cfg(feature = "test")]
fn enabled() -> i32 { return 1; }

#[cfg(not(feature = "test"))]
fn enabled() -> i32 { return 0; }

fn main() -> i32 {
    if enabled() == 0 { println("inactive"); }
    return 0;
}

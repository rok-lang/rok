// A nested fn sees no outer variable and is not visible outside its
// block; a variable and a nested fn of one name in one block conflict.
// expect-error: 10:17: cannot find value `n`
// expect-error: 17:5: cannot find function `helper`
// expect-error: 21:5: `helper` names both a variable and a nested function in this block
// expect-error: 27:5: nested function `twice` is defined twice in this block

fn outer(n: i32) -> i32 {
    fn inner() -> i32 {
        let x = n;
        x
    }
    inner()
}

fn other() {
    helper();
}

fn clash() {
    let helper = 42;
    fn helper() {}
}

fn dup() {
    fn twice() {}
    fn twice() {}
}

fn main() {
    fn helper() {}
    helper();
}

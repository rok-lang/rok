// expect-exit: 0
// expect-stdout:
// conversion: str value: bad input overflow: mul u8 add: value out of range for `i32`
// parse: cannot parse "x1": not a digit odd zero: true
// typed 7 / i32
// 7 none 42 none
// 4 ok

// Built-in error types, the `assert` family, and `Result` conversions.
fn pick(n: i32) throws (ConversionError | ValueError | OverflowError) -> i32 {
    if n == 0 { throw ConversionError::new("str"); }
    if n == 1 { throw ValueError::new("bad input"); }
    if n == 2 { throw OverflowError::new("mul", "u8"); }
    n
}

fn describe(n: i32) -> str {
    try { f"ok {pick(n)}" }
    catch e: ConversionError { f"conversion: {e.message()}" }
    catch e: ValueError { f"value: {e.message()}" }
    catch e: OverflowError { f"overflow: {e.operation()} {e.type_name()}" }
}

fn parse_digit(s: str) throws (ParseError) -> i32 {
    if s.len() != 1 { throw ParseError::new(s, 0, "not a digit"); }
    7
}

fn require_positive(x: i32) -> u32 {
    if x < 0 { rok::core::panic::unreachable() }
    x as u32
}

fn first_ok(rs: List<Result<i32, ParseError>>) throws (ParseError) -> i32 {
    try rs[0].get()
}

fn main() {
    let o = OverflowError::new("add", "i32");
    println(f"{describe(0)} {describe(1)} {describe(2)} {o}");
    let p = try parse_digit("x1") catch e { print(f"parse: {e} "); 0 };
    let c = ConversionError::new("odd");
    let z = try num::niche::NonZero::<i32>::try_from(0) catch e: num::niche::ZeroError { print(f"{c.message()} "); num::niche::NonZero::new(1) ?? panic("zero") };
    println(f"zero: {z.get() == 1 && p == 0}");
    let t = try parse_digit("7") catch e { 0 };
    println(f"typed {t} / {o.type_name()}");
    let r: Result<i32, ParseError> = Result::catching(|| try parse_digit("5"));
    let bad: Result<i32, ParseError> = Result::catching(|| try parse_digit("55"));
    let a: i32 | none = try? parse_digit("x9");
    let f = try first_ok([Result::Ok(42)]) catch _ { -1 };
    println(f"{r.ok() ?? -1} {bad.ok():?} {f} {a:?}");
    assert(true);
    assert_eq(require_positive(4), 4u32, "positive");
    assert_ne(1, 2);
    println(f"{require_positive(4)} ok");
}

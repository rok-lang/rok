// needs: threads
// expect-error: `q` still holds `e`, which was handed to another owner
// A copy made with extend: the copy is popped and sent, the source still holds it.
use rok::std::thread;

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let q: List<List<i32>> = [[]];
    let q2: List<List<i32>> = [];
    q2.extend(q);
    if let e: List<i32> = q2.pop() { try! tx.send(e); }
    for i in 0..200000 { q[0].push(i); }
    let _ = try! t.join();
    println(f"len {q[0].len()}");
}

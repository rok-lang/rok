// spec: std 303-time §3.3.4
// expect-exit: 0
// forbid-warning: warning
// expect-stdout:
// true 0ns true true

// `BootTime` has the checked and saturating spans `Instant` has: `none`
// and zero when `earlier` is later.
use rok::std::time::BootTime;

fn main() {
    let a = BootTime::now();
    rok::std::thread::sleep(Duration::ms(2));
    let b = BootTime::now();
    let back = a.checked_duration_since(b);
    let fwd = b.checked_duration_since(a) ?? Duration::ZERO;
    println(f"{back is none} {a.saturating_duration_since(b)} {fwd > Duration::ZERO} {b.saturating_duration_since(a) == fwd}");
}

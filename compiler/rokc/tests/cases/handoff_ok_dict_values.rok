// needs: threads
// expect-exit: 0
// expect-stdout:
// left 0 got 20

// Per-key buckets sent to a writer thread, removed as they go.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<(str, List<i32>)>();
    let c = thread::spawn(|| { let s: usize = 0; while let p: (str, List<i32>) = rx.recv() { s += p.1.len(); } s });
    let buckets: Dict<str, List<i32>> = Dict::new();
    for i in 0..20 {
        let k = if i % 2 == 0 { "even" } else { "odd" };
        if let b: List<i32> = buckets.get(k) { b.push(i); } else { buckets.insert(k, [i]); }
    }
    let keys = buckets.keys().collect::<List<str>>();
    for k in keys { if let b: List<i32> = buckets.remove(k) { try! tx.send((k, b)); } }
    tx.close();
    println(f"left {buckets.len()} got {try! c.join()}");
}

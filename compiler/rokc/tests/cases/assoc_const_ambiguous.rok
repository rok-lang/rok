// expect-error: associated const `N` of `S` is ambiguous: `A` and `B` define it
// Two impls giving a type the same const name need the
// qualified form `<S as A>::N`.
trait A { const N: i32; }
trait B { const N: i32; }
struct S { x: i32; }
impl A for S { const N: i32 = 1; }
impl B for S { const N: i32 = 2; }

fn main() -> i32 {
    let ok = <S as A>::N + <S as B>::N;
    return ok + S::N;
}

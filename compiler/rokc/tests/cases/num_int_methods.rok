// expect-exit: 0
// expect-stdout:
// -128 127 0 255
// -9223372036854775808 9223372036854775807 18446744073709551615
// none 7 none 0 none none
// none none 2 none none 0
// -2147483648 0 254 1
// -2147483648 true 0 true
// 127 -128 -128 255 0 255
// 18446744073709551613 0 0 true
// 8 24 31 32 0 3 2
// 2 -2147483647 255 128 16909060
// 4 3 2 1 16909060 513
// 81 1024 none 1073741824 0 -128
// 5 -1 0 1 128 4
// -4 1 3 -3 -1
// 3 4294967295 3037000499 0 none
// 3 3 9 none none
// true false 8 16 none

// The integer primitives' limits, bit operations,
// byte order and overflow-explicit arithmetic.

fn show<T: Display>(x: T | none) -> str {
    if x is T { return f"{x}"; }
    "none"
}

fn main() {
    println(f"{i8::MIN} {i8::MAX} {u8::MIN} {u8::MAX}");
    println(f"{i64::MIN} {i64::MAX} {u64::MAX}");

    // checked: overflow (and / 0, MIN / -1) is `none`.
    let a = i32::MAX.checked_add(1);
    let b = 3i32.checked_add(4);
    println(f"{show(a)} {show(b)} {show(0u8.checked_sub(1))} {show(5i16.checked_sub(5))} {show(i64::MAX.checked_mul(2))} {show(i64::MIN.checked_mul(-1))}");
    println(f"{show(7.checked_div(0))} {show(i32::MIN.checked_div(-1))} {show(7.checked_rem(5))} {show(i8::MIN.checked_neg())} {show(1.checked_shl(32))} {show(0u32.checked_neg())}");

    // wrapping
    println(f"{i32::MAX.wrapping_add(1)} {u8::MAX.wrapping_add(1)} {u8::MAX.wrapping_mul(2)} {1u8.wrapping_shl(8)}");
    let (w, o) = i32::MAX.overflowing_add(1);
    let (w2, o2) = 0u64.overflowing_sub(0);
    println(f"{w} {o} {w2} {i32::MIN.overflowing_neg().1}");

    // saturating
    println(f"{100i8.saturating_add(100)} {(-100i8).saturating_sub(100)} {(-100i8).saturating_mul(2)} {200u8.saturating_add(100)} {5u8.saturating_sub(9)} {16u8.saturating_mul(16)}");
    println(f"{u64::MAX.wrapping_mul(u64::MAX).wrapping_neg().wrapping_sub(2)} {i64::MIN.wrapping_div(-1).wrapping_rem(-1)} {i64::MIN.wrapping_rem(-1)} {i64::MIN.overflowing_div(-1).1}");

    // bits
    println(f"{255u8.count_ones()} {0xFFu32.leading_zeros()} {1.leading_zeros()} {0.trailing_zeros()} {u64::MAX.count_zeros()} {(-1i8).leading_ones() - 5} {12.trailing_zeros()}");
    println(f"{0x80000001u32.rotate_left(1) - 1} {(-2147483647).rotate_right(32)} {0x80u8.rotate_right(7) + 254} {1u8.rotate_left(7)} {0x04030201.swap_bytes()}");
    let le = 0x01020304u32.to_le_bytes();
    let be = 0x0102u16.to_be_bytes();
    println(f"{le[0]} {le[1]} {be[1]} {be[0]} {u32::from_be_bytes([1, 2, 3, 4])} {i16::from_le_bytes([1, 2])}");

    // pow / abs / signum
    println(f"{3.pow(4)} {2u64.pow(10)} {show(2i32.checked_pow(31))} {2i32.wrapping_pow(30)} {2i32.wrapping_pow(32)} {(-2i8).saturating_pow(9)}");
    println(f"{(-5).abs()} {(-5).signum()} {0.signum()} {9.signum()} {i8::MIN.unsigned_abs()} {(-1).abs_diff(3)}");

    // euclid
    println(f"{(-7).div_euclid(2)} {(-7).rem_euclid(2)} {7.rem_euclid(-4)} {7.div_euclid(-2)} {(-7) / 2 + 2}");

    // roots / logs
    println(f"{10.isqrt()} {u64::MAX.isqrt()} {i64::MAX.isqrt()} {0u8.isqrt()} {show((-1i64).checked_isqrt())}");
    println(f"{1000.ilog10()} {999.ilog10() + 1} {512.ilog2()} {show(0u64.checked_ilog2())} {show(0.checked_ilog10())}");
    println(f"{64u32.is_power_of_two()} {0u32.is_power_of_two()} {5u8.next_power_of_two()} {16u8.next_power_of_two()} {show(200u8.checked_next_power_of_two())}");
}

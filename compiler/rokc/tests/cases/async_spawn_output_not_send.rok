// expect-error: type `Cell<i32>` does not satisfy trait bound `Send` required by `task::spawn`

// `spawn(..) where F::Output: Send`: a `Send` future whose
// output is not `Send` (a hand-written one: `AsyncFuture<T>` is only
// `Send` for `T: Send`, so the `F: Send` bound would catch it first).
struct MakeCell {}
impl Future for MakeCell {
    type Output = Cell<i32>;
    fn poll(ref self, ref ctx: future::Context) -> future::Poll<Cell<i32>> { future::Poll::Ready(Cell::new(1)) }
}

let t = task::spawn(MakeCell {});


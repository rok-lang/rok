// expect-exit: 0
// expect-stdout:
// ("x", "x") ((1, "a"), (1, "a")) (1.5, 1.5) ('c', 'c') (true, true) 3
// [1, 2] [1, 2, 3]

// Primitives, `str`, tuples of `Copy` and `Range` are
// `Copy`; a collection is `Clone` (a deep copy), not `Copy`.
fn dup<T: Copy>(x: T) -> (T, T) { (x, x) }

fn main() {
    let r = dup(0..3);
    println(f"{dup("x"):?} {dup((1, "a")):?} {dup(1.5):?} {dup('c'):?} {dup(true):?} {r.1.end}");
    let xs = [1, 2];
    let ys = xs.clone();
    ys.push(3);
    println(f"{xs:?} {ys:?}");
}

// needs: threads
// expect-error: `d` still holds `e`, which was handed to another owner
// Dict values collected, one sent, dict still used.
use rok::std::thread;

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let d: Dict<str, List<i32>> = Dict::new();
    d.insert("k", []);
    let q = d.values().collect::<List<List<i32>>>();
    if let e: List<i32> = q.pop() { try! tx.send(e); }
    for i in 0..200000 { d["k"].push(i); }
    let _ = try! t.join();
    println(f"len {d["k"].len()}");
}

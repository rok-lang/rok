// needs: threads
// spec: std 213-marker §2.13.9

// Hand-offs are followed through calls.
use rok::std::thread;

struct Bag {
    items: List<i32>;
    n: i64;
}

impl Bag {
    fn lock_up(self) -> Mutex<List<i32>> {
        Mutex::new(self.items)
    }
}

fn id(x: List<i32>) -> List<i32> { x }
fn mk(xs: List<i32>) -> Bag { Bag { items: xs, n: 0 } }
fn items(b: Bag) -> List<i32> { b.items }
fn peek(g: MutexGuard<List<i32>>) -> List<i32> { g.get() }
fn post(tx: Sender<List<i32>>, xs: List<i32>) { try! tx.send(xs); }
fn store(xs: List<i32>) -> Mutex<List<i32>> {
    let m = Mutex::new(xs);
    m
}
fn outer(xs: List<i32>) -> i64 {
    let _m = store(xs);
    0
}
async fn post_later(tx: Sender<List<i32>>, xs: List<i32>) { try! tx.send(xs); }
fn down(xs: List<i32>, n: i32) -> Mutex<List<i32>> {
    if n == 0 { return Mutex::new(xs); }
    down(xs, n - 1)
}
fn keep(all: List<List<i32>>, x: List<i32>) { all.push(x); }
fn put(ref s: Bag, xs: List<i32>) { s.items = xs; }
fn later(xs: List<i32>) -> fn() -> usize { || xs.len() }
fn run(f: fn(List<i32>), xs: List<i32>) { f(xs); }

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let m: Mutex<List<i32>> = Mutex::new([]);
    let a = through_id() + through_peek(m) + through_post(tx) + through_mk();
    let b = through_outer() + through_async(tx) + through_recursion() + through_method();
    let c = through_keep() + through_ref() + through_closure() + through_items();
    let d = through_value(tx) + after_send(tx);
    for _ in 0..3 {
        let _ = rx.recv();
    }
    println(f"{a} {b} {c} {d}");
}

fn through_id() -> i64 {
    let xs: List<i32> = [];
    let m = Mutex::new(id(xs));
    xs.push(1);
    using g = m.lock() { g.get().len() as i64 }
}

fn through_peek(m: Mutex<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    using g = m.lock() { xs = peek(g); }
    xs.len() as i64
}

fn through_post(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    post(tx, xs);
    xs.push(1);
    0
}

fn through_mk() -> i64 {
    let xs: List<i32> = [];
    let _m = Mutex::new(mk(xs));
    xs.push(2);
    0
}

fn through_outer() -> i64 {
    let xs: List<i32> = [];
    outer(xs);
    xs.len() as i64
}

fn through_async(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    task::block_on(post_later(tx, xs));
    xs.len() as i64
}

fn through_recursion() -> i64 {
    let xs: List<i32> = [];
    let _m = down(xs, 3);
    xs.len() as i64
}

fn through_method() -> i64 {
    let b = Bag { items: [1], n: 0 };
    let _m = b.lock_up();
    b.items.len() as i64
}

fn through_keep() -> i64 {
    let all: List<List<i32>> = [];
    let x: List<i32> = [];
    keep(all, x);
    let _m = Mutex::new(all);
    x.len() as i64
}

fn through_ref() -> i64 {
    let b = Bag { items: [], n: 0 };
    let xs: List<i32> = [];
    put(ref b, xs);
    let _m = Mutex::new(b);
    xs.len() as i64
}

fn through_closure() -> i64 {
    let xs: List<i32> = [];
    let f = later(xs);
    let _m = Mutex::new(xs);
    f() as i64
}

fn through_items() -> i64 {
    let b = Bag { items: [], n: 0 };
    let ys = items(b);
    let _m = Mutex::new(b);
    ys.len() as i64
}

fn through_value(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    run(|x| { try! tx.send(x); }, xs);
    xs.len() as i64
}

// A callee that hands a value over only on its way out without an
// error, `none` or `false` still does so on that way: after a `catch`
// of an error it threw after the hand-off, on the value path of `try?`
// / `??` / `if`, and before an `await` of its future.
fn after_send(tx: Sender<List<i32>>) -> i64 {
    let a = after_early_send(tx) + after_catch(tx) + after_try_q(tx) + after_value(tx);
    let b = after_true(tx) + after_send_none(tx);
    a + b + try! task::block_on_try(after_await(tx)) + try! task::block_on_try(before_await(tx))
}

struct Oops { n: i64; }

fn post_first(tx: Sender<List<i32>>, xs: List<i32>, fail: bool) throws (Oops) -> i64 {
    try! tx.send(xs);
    if fail { throw Oops { n: 1 }; }
    0
}
fn post_ok(tx: Sender<List<i32>>, xs: List<i32>, fail: bool) throws (Oops) -> i64 {
    if fail { throw Oops { n: 1 }; }
    try! tx.send(xs);
    0
}
fn post_some(tx: Sender<List<i32>>, xs: List<i32>, skip: bool) -> i64 | none {
    if skip { return none; }
    try! tx.send(xs);
    0
}
fn posted(tx: Sender<List<i32>>, xs: List<i32>) -> bool {
    if xs.is_empty() { return false; }
    try! tx.send(xs);
    true
}
fn post_or_none(tx: Sender<List<i32>>, xs: List<i32>, skip: bool) throws (Oops) -> i64 | none {
    if skip { return none; }
    try! tx.send(xs);
    0
}
async fn post_maybe(tx: Sender<List<i32>>, xs: List<i32>, fail: bool) throws (Oops) -> i64 {
    if fail { throw Oops { n: 1 }; }
    try! tx.send(xs);
    0
}

fn after_early_send(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    try post_first(tx, xs, true) catch _ { xs.len() as i64 }
}

fn after_catch(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    let n = try post_ok(tx, xs, false) catch _ { 0 };
    n + xs.len() as i64
}

fn after_try_q(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    if let n: i64 = try? post_ok(tx, xs, false) { return n + xs.len() as i64; }
    0
}

fn after_value(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    let n = post_some(tx, xs, false) ?? { return 0; };
    n + xs.len() as i64
}

fn after_true(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [1];
    if posted(tx, xs) { return xs.len() as i64; }
    0
}

fn after_send_none(tx: Sender<List<i32>>) -> i64 {
    let xs: List<i32> = [];
    if let n: i64 = try! post_or_none(tx, xs, false) { return n + xs.len() as i64; }
    0
}

async fn after_await(tx: Sender<List<i32>>) throws (Oops) -> i64 {
    let xs: List<i32> = [];
    let n = try await post_maybe(tx, xs, false) catch _ { 0 };
    n + xs.len() as i64
}

async fn before_await(tx: Sender<List<i32>>) throws (Oops) -> i64 {
    let xs: List<i32> = [];
    let f = post_maybe(tx, xs, true);
    let k = xs.len() as i64;
    k + try await f catch _ { 0 }
}

// The same callees, used where they did hand the value over.
// expect-error: handoff_call_errors.rok:201:44: `xs` was sent through a channel by `post_first(tx, xs, true)` at line 201 (inside `post_first`, line 169)

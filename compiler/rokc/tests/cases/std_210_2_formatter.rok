// spec: std 210-fmt §2.10.2 §2.10.12
// spec: §6.2.7
// expect-exit: 0
// expect-stdout:
// ab-c
// [**hi**] [hel]
// * < + true 8 3
// none none false false - -
// [  -0x2a]

// Stdlib 2.10.2: a `Formatter` on its own buffer (`new`, `with_spec`,
// `finish`), `pad` applying fill / align / width / precision, the spec
// accessors after `FormatSpec::parse`, `pad_integral`; writes to memory
// never throw `FmtError` (2.10.12).
fn show_align(a: fmt::Alignment | none) -> str {
    match a {
        none => "-",
        v: fmt::Alignment => match v {
            fmt::Alignment::Left => "<",
            fmt::Alignment::Right => ">",
            fmt::Alignment::Center => "^",
            fmt::Alignment::Equal => "=",
        },
    }
}

fn show_sign(s: fmt::Sign | none) -> str {
    match s {
        none => "-",
        v: fmt::Sign => match v {
            fmt::Sign::Plus => "+",
            fmt::Sign::Minus => "-",
            fmt::Sign::Space => " ",
        },
    }
}

fn main() throws (FmtError) {
    let f = Formatter::new();
    try f.write_str("ab");
    try f.write_char('-');
    try f.write_char('c');
    println(f.finish());

    let g = Formatter::with_spec(try! fmt::FormatSpec::parse("*^6"));
    try g.pad("hi");
    let h = Formatter::with_spec(try! fmt::FormatSpec::parse(".3"));
    try h.pad("hello");
    println(f"[{g.finish()}] [{h.finish()}]");

    let k = Formatter::with_spec(try! fmt::FormatSpec::parse("*<+#08.3x"));
    println(f"{k.fill()} {show_align(k.align())} {show_sign(k.sign())} {k.alternate() && k.zero_pad()} {k.width() ?? 0} {k.precision() ?? 0}");
    let e = Formatter::new();
    println(f"{e.width():?} {e.precision():?} {e.alternate()} {e.zero_pad()} {show_align(e.align())} {show_sign(e.sign())}");

    let w = Formatter::with_spec(try! fmt::FormatSpec::parse("#7"));
    try w.pad_integral(false, "0x", "2a");
    println(f"[{w.finish()}]");
}

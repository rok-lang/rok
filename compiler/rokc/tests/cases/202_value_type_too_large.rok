// A value type whose flattened layout grows exponentially (each `W`
// doubles its payload) is refused instead of exhausting the compiler.
// expect-error: value type `W<..>` is too large

struct W<T> { a: T; b: T; }

fn main() {
    let x: W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<i64>>>>>>>>>>>>>>>>>>>>>>>>>>> = panic("unreachable");
}


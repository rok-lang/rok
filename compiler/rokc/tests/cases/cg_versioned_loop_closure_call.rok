// A counted loop calling a closure, which may shrink the list, keeps its
// bounds checks: the read after `x.clear()` panics.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/cg_versioned_loop_closure_call.rok:12:14:
// expect-stderr: index 0 out of bounds for length 0
// expect-stdout:

fn sum(x: List<i64>, n: usize, f: fn()) -> i64 {
    let s: i64 = 0;
    for j in 0..n {
        f();
        s += x[j];
    }
    s
}

fn main() -> i32 {
    let x: List<i64> = [1, 2, 3, 4, 5, 6, 7, 8];
    let k = || { x.clear(); };
    println(f"{sum(x, 8, k)}");
    return 0;
}

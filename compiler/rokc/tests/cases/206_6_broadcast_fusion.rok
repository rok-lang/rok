// spec: std 206-broadcast §2.6.6
// spec: std 206-broadcast §2.6.7
// expect-exit: 0
// expect-stdout:
// f1 g10 f2 g20
// [21, 42] [12, 32]
// [11, 22, 33] [2, 4, 6]
// [3, 5] [false, true]
// [11, 22, 33]
// V(4) [6, 7]
// [11, 12] none
// [false, true, false]

// A chain of dot operators and function broadcasts over core
// collections runs as one loop (calls interleave, no intermediate
// lists); arrays give arrays, slices and lists give lists; other
// containers dispatch the dot traits; `T | none` propagates `none`.
fn f(x: i64) -> i64 {
    print(f"f{x} ");
    x
}

fn g(x: i64) -> i64 {
    if x == 20 { println(f"g{x}"); } else { print(f"g{x} "); }
    x
}

struct V { n: i64; }

impl ops::DotAdd<i64> for V {
    type Output = V;
    fn dot_add(self, k: i64) -> V { V { n: self.n + k } }
}

fn bump(xs: List<i64> | none) -> List<i64> | none {
    xs .+ 10
}

fn main() {
    let a: List<i64> = [1, 2];
    let b: List<i64> = [10, 20];
    let r = f.(a) .+ g.(b) .* 2;
    let fs = [1.0, 2.0];
    let h = (fs .+ 2.0) .* fs .* 4.0;
    println(f"{r:?} {h:?}");
    let x: [i32; 3] = [1, 2, 3];
    let y: [i32; 3] = [10, 20, 30];
    let z: [i32; 3] = x .+ y;
    let w = 2 .* [1, 2, 3];
    println(f"{z:?} {w:?}");
    let l: List<i32> = [1, 2, 3, 4];
    let s = l[0:2];
    let t = l[1:3];
    println(f"{s .+ t:?} {s .> 1:?}");
    println(f"{l[0:3] .+ y:?}");
    println(f"V({(V { n: 1 } .+ 3).n}) {[1, 2] .+ 5:?}");
    let some: List<i64> = [1, 2];
    println(f"{bump(some):?} {bump(none):?}");
    let m: List<i32> = [0, 1, 5];
    println(f"{(m .< 2) .&& (m .!= 0) .|| [false, false, false]:?}");
}

// needs: threads
// expect-exit: 0
// expect-stdout:
// 4 2

// A pair: send one half, keep the other.
use rok::std::thread;
fn split(xs: List<i32>) -> (List<i32>, List<i32>) {
    let a: List<i32> = []; let b: List<i32> = [];
    for x in xs { if x % 2 == 0 { a.push(x); } else { b.push(x); } }
    (a, b)
}
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let c = thread::spawn(|| { if let r: List<i32> = rx.recv() { r.len() } else { 0 as usize } });
    let p = split([1, 2, 3, 4, 5]);
    try! tx.send(p.0);
    p.1.push(7);
    println(f"{p.1.len()} {try! c.join()}");
}

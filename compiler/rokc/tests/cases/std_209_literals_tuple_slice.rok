// spec: std 209-collections §2.9.1 §2.9.6-2.9.8 / std 203-ops §2.3.4
// expect-exit: 0
// expect-stdout:
// 1 2 1 7 | 3 true true
// shared [1, 2, 9] copy [1, 2]
// 42 hello true | 42 hello true | (1, "b") < (1, "c") true | 3 2
// 3 9 30 [2, 30, 4] [1, 30, 5] 5 | 5 4 | 2 | [2, 30]
// 6 9
// 20 99 none 3
// grid 5 7

// Collection literals, tuples, `Slice` views, `Index` / `IndexSet`.
struct Grid { w: usize; cells: List<i32>; }

impl index::Index<(usize, usize)> for Grid {
    type Output = i32;
    fn index(self, idx: (usize, usize)) -> i32 { self.cells[idx.0 * self.w + idx.1] }
}

impl index::IndexSet<(usize, usize)> for Grid {
    type Value = i32;
    fn index_set(self, idx: (usize, usize), value: i32) { self.cells[idx.0 * self.w + idx.1] = value; }
}

fn divmod(a: i32, b: i32) -> (i32, i32) {
    (a / b, a % b)
}

fn sum(xs: ...i32) -> i32 {
    let total = 0;
    for x in xs {
        total = total + x;
    }
    total
}

fn main() {
    let d = {"a": 1};
    let s = {1, 2};
    let one = {1,};
    let blk = { 7 };
    let a: [i32; 3] = [1, 2, 3];
    println(f"{d["a"]} {s.len()} {one.len()} {blk} | {a.len()} {a == [1, 2, 3]} {a < [1, 2, 4]}");
    let xs = [1, 2];
    let ys = xs;
    let zs = xs.clone();
    ys.push(9);
    println(f"shared {xs:?} copy {zs:?}");
    let t: (i32, str, bool) = (42, "hello", true);
    let (n, w, b) = t;
    let (q, r) = divmod(17, 5);
    println(f"{t.0} {t.1} {t.2} | {n} {w} {b} | (1, \"b\") < (1, \"c\") {(1, "b") < (1, "c")} | {q} {r}");
    let l: List<i32> = [1, 2, 3, 4, 5];
    let s1: Slice<i32> = l[1:4];
    let s2: Slice<i32> = l[::2];
    let s3: Slice<i32> = l[..];
    let len1 = s1.len();
    let sum1: i32 = s1.iter().sum();
    l[2] = 30;
    let owned: List<i32> = s1.to_list();
    println(f"{len1} {sum1} {s1[1]} {owned:?} {s2.to_list():?} {s3.len()} | {s3.last() ?? 0} {s3[-2]} | {s1.first() ?? 0} | {s1[0:2]:?}");
    println(f"{sum(1, 2, 3)} {sum(..[4, 5])}");
    let lst: List<i32> = [10, 20, 30];
    lst[1] = 99;
    println(f"{[10, 20, 30][1]} {lst[1]} {lst.get(100):?} {l[1:3:1].len() + 1}");
    let g = Grid { w: 3, cells: [0, 0, 0, 0, 0, 0] };
    g[(1, 2)] = 5;
    g[(0, 1)] = g[(1, 2)] + 2;
    println(f"grid {g[(1, 2)]} {g.cells[1]}");
}

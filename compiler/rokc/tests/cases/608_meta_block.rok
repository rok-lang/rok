// expect-exit: 0
// expect-stdout:
// 7

// The spec's own `#[impl_derive(MyHash)]` example -
// `@Self`, `@for_fields`, `self.@field` over a struct.
trait MyHash {
    fn my_hash(self) -> u64;
}

impl MyHash for i32 {
    fn my_hash(self) -> u64 { return self as u64; }
}

fn combine_hash(h: u64, x: u64) -> u64 {
    return h + x;
}

#[impl_derive(MyHash)]
@derive {
    impl MyHash for @Self {
        fn my_hash(self) -> u64 {
            let h: u64 = 0u64;
            @for_fields {
                h = combine_hash(h, self.@field.my_hash());
            }
            h
        }
    }
}

#[derive(MyHash)]
struct Point { x: i32; y: i32; }

fn main() -> i32 {
    let p = Point { x: 3, y: 4 };
    println(f"{p.my_hash()}");
    return 0;
}

// expect-exit: 0
// expect-lint: 19:5 `l` is a `ThreadLocal::get()` value used after an `await`: the task may resume on another thread, and this one's value is then shared
// expect-lint: 25:9 `l` is a `ThreadLocal::get()` value used after an `await`: the task may resume on another thread, and this one's value is then shared
// expect-warning: help: call `.get()` again after the `await` instead of keeping `l` across it
// spec: std 304-thread §3.4.4
// spec: §6.2.9
// expect-stdout: 2

// A task may resume on another worker after an `await`: a thread-local
// value kept across it is then another thread's, shared without a lock.

use rok::std::thread;

static TL: thread::ThreadLocal<List<i64>> = thread::local(|| -> List<i64> { [] });

pub async fn kept() {
    let l = TL.get();
    await task::yield_now();
    l.push(1);
}

pub async fn in_a_loop() {
    let l = TL.get();
    for i in 0..3i64 {
        l.push(i);
        await task::yield_now();
    }
}

// Not flagged: `get()` again after the `await`.
async fn fresh() -> usize {
    await task::yield_now();
    let l = TL.get();
    l.push(1);
    l.push(2);
    l.len()
}

fn main() {
    println(f"{task::block_on(fresh())}");
}

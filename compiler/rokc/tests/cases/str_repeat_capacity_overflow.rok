// expect-exit: 101
// expect-stdout: ab
// expect-stderr: thread 'main' panicked at tests/cases/str_repeat_capacity_overflow.rok:10:13:
// expect-stderr: capacity overflow

// `len * n` in `str::repeat` (and the byte size of any collection
// buffer) panics instead of wrapping, at every opt level.
fn main() {
    println("ab".repeat(1));
    let s = "ab".repeat(usize::MAX / 2 + 2);
    println(f"{s.len()}");
}

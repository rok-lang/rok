// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/panic_loc_library_helpers.rok:14:16:
// expect-stderr: index 3 out of bounds for length 3
// expect-stdout: 1

// `#[track_caller]` library helpers (`List` indexing, `assert`,
// `Result::unwrap`) report the user's call site, not their own line.
fn main() {
    let xs: List<i32> = [1, 2, 3];
    assert(xs.len() == 3);
    let r: Result<i32, str> = Result::Ok(1);
    println(f"{r.unwrap()}");
    let i = xs.len();
    println(f"{xs[i]}");
}

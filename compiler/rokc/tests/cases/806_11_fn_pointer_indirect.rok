// expect-exit: 0
// expect-stdout:
// 12 12
// 3.5
// 17

// An indirect call through a `fn(...)` value gives the same
// result as the direct call; a closure call sees its captures.
struct Op { f: fn(i32, i32) -> i32; }

fn mul(a: i32, b: i32) -> i32 { return a * b; }
fn halve(x: f64) -> f64 { return x / 2.0; }

fn apply(g: fn(f64) -> f64, x: f64) -> f64 { return g(x); }

fn main() -> i32 {
    let op = Op { f: mul };
    let g = op.f;
    println(f"{mul(3, 4)} {g(3, 4)}");
    println(f"{apply(halve, 7.0)}");
    let k = 10;
    let add_k = |x: i32| x + k;
    println(f"{add_k(7)}");
    return 0;
}

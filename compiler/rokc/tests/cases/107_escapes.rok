// expect-exit: 0
// expect-stdout:
// 가A😀 세계
// one two
// 1

// `\u{...}` (with `_`), `\xHH`, line continuation; non-ASCII
// text passes through unchanged. `0.5` and `1f32` literals (`.5` is a tuple index).
fn main() -> i32 {
    println("\u{AC00}\x41\u{1_F600} 세계");
    println("one \
                   two");
    let h: f64 = 0.5;
    let f: f32 = 1f32;
    if h < 1.0 {
        println(f"{1}");
    }
    return 0;
}


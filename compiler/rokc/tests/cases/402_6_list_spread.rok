// spec: 004.02.6-spread-args
// spec: 004.02.5-variadic-t
// expect-exit: 0
// expect-stdout:
// 9 12 0
// [1, 4, 5, 6] [0, 1, 2, 3, 7, 8, 9] 3
// 6 7
// 10 20 30
// 11 6 18
// 1 3

fn sum(xs: ...i32) -> i32 {
    let t = 0i32;
    for x in xs { t += x; }
    t
}

fn three(a: i32, b: i32, c: i32) -> i32 { a * 100 + b * 10 + c }

fn pass(xs: ...i32) -> i32 { sum(..xs) }

fn pair<T: ops::Add<T, Output = T>>(a: T, b: T) -> T { a + b }

fn add3(a, b, c) { a + b + c }

fn main() -> i32 {
    let ys: List<i32> = [4, 5];
    let none_: List<i32> = [];
    println(f"{sum(..ys)} {sum(1, ..ys, 2)} {sum(..none_)}");
    // `..x` in a `List` literal spreads a collection.
    let zs = [1, ..ys, 6];
    let arr: [i32; 3] = [7, 8, 9];
    let ws = [0, ..(1, 2, 3), ..arr];
    println(f"{zs:?} {ws:?} {[..ys, ..none_, 3].len()}");
    // Into fixed parameters: a `List` / `Slice` by its run-time length.
    let two: List<i32> = [5, 6];
    let r = three(..[0, 0, 6]) + three(0, ..two) - 56;
    println(f"{r} {pass(..[1, 2, 4])}");
    let s = arr[0:3];
    println(f"{three(..s) - 789 + 10} {three(..arr) / 39 - 0} {three(1, ..[2, 3]) / 4 - 0}");
    // Not a collection: `..3` stays a range.
    println(f"{pair(..two)} {add3(..[1, 2, 3])} {add3(1, ..arr[1:3])}");
    let rs = [..3];
    println(f"{rs.len()} {rs[0].end}");
    return 0;
}

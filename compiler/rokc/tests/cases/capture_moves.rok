// A closure or an `async` block that captures a resource takes it.

use rok::core::channel::channel;

async fn main() {
    let (tx, rx) = channel::<i32>();
    let t = task::spawn(async {
        try! await tx.send_async(1);
    });
    try! tx.send(2);
    await t;
    println(f"{rx.recv() ?? 0}");
}

// spec: std-216.4 std-216.5
// expect-error: 13:23: mismatched types: argument 1 of `thread::spawn` expects `fn() -> i32 + Send`, found `closure() -> i32`
// expect-error: note: the closure captures `rw` (type `RwLock<List<i32>>`), which is not `Sync`: its readers could change the `List<i32>` inside at once; use `Mutex<List<i32>>` and `.lock()` in place of `.read()` / `.write()`

// `RwLock<T>` is `Sync` only when `T` is `Send + Sync`: readers share
// the value, and two readers pushing to one list at once corrupt it.
use rok::std::thread;

fn main() {
    let rw: RwLock<List<i32>> = RwLock::new([]);
    // Two readers mutate the guarded list at once.
    let t =
        thread::spawn(|| { for i in 0..1000 { using g = rw.read() { g.get().push(i); } } 0 });
    for i in 0..1000 { using g = rw.read() { g.get().push(i); } }
    try! t.join();
    using g = rw.read() { println(f"{g.get().len()}"); }
}

// expect-exit: 0
// expect-stdout:
// after

// `throw` diverges, so a throw in the else branch does not
// affect the type of the if expression.
fn pick(b: i32) throws (i32) -> i32 {
    let v = if b == 1 { 7 } else { throw 99; };
    return v;
}

fn main() -> i32 {
    let v = try! pick(1);
    if v == 7 { println("after"); }
    return 0;
}

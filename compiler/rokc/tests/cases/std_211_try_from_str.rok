// spec: std 211-conversion §2.11.9
// expect-exit: 0
// expect-stdout:
// 42 -9000000000 255 18446744073709551615 -128
// none none none none
// [300] / [x] / []
// 7

// Spec 2.11.9: `impl TryFrom<str> for i32` with `type Error =
// ParseError`, so `try "42".try_into()` parses; every fixed-width
// integer has it, by its `FromStr`. Empty text, a bad digit and an
// out-of-range value all throw that `FromStr`'s `ParseError`.
const SEVEN: i32 = try! i32::try_from("7");

fn main() throws (ParseError) {
    let n: i32 = try "42".try_into();
    let m = try i64::try_from("-9000000000");
    let b: u8 = try "+255".try_into();
    let w = try u64::try_from("18446744073709551615");
    let s = try i8::try_from("-128");
    println(f"{n} {m} {b} {w} {s}");
    let a: u8 | none = try? "256".try_into();
    let c: i16 | none = try? i16::try_from("");
    let d: u32 | none = try? "-1".try_into();
    let e: isize | none = try? isize::try_from("1.5");
    println(f"{a:?} {c:?} {d:?} {e:?}");
    let x = try f"{u8::try_from("300")}" catch e: ParseError { f"[{e.input()}]" };
    let y = try f"{i32::try_from("x")}" catch e: ParseError { f"[{e.input()}]" };
    let z = try f"{usize::try_from("")}" catch e: ParseError { f"[{e.input()}]" };
    println(f"{x} / {y} / {z}");
    println(f"{SEVEN}");
}

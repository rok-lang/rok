// spec: std §2.7.11 §2.11.12 §2.12.5 §2.13.8 §2.14.8 §2.15.8 §2.18.7 §2.19.7
// expect-exit: 0
// expect-stdout:
// 0..3 true 6
// i64 7 8 255
// Point ["x", "y"]
// index 10 out of bounds (len 3) | IndexError { index: 10, len: 3 }
// bad | ValueError("bad")
// ab c 1 none true
// 5 [2, 4] 3 2s

// Module paths the stdlib's mapping tables name.
use rok::core::iter::{Iterator, IntoIterator, DoubleEndedIterator, ExactSizeIterator, FromIterator};
use rok::core::range::Step;
use rok::core::range::Range;
use rok::core::reflect::{Reflect, Inspect, MethodInfo};
use rok::core::marker::NoneSentinel;
use rok::core::task::{spawn, join, race, timeout, Task};
use rok::core::task::time::{Duration, Instant};
use rok::core::future::{Future, IntoFuture};
use rok::core::par;

#[derive(Inspect)]
struct Point { x: i32; y: i32; }

fn report<E: Display + Debug + Error>(e: E) -> str { f"{e} | {e:?}" }
fn sum_all<I: IntoIterator<Item = i32>>(xs: I) -> i32 {
    let t = 0;
    for x in xs { t += x; }
    t
}

async fn four() -> i32 { 4 }

async fn main() {
    let r: Range<i32> = 0..3;
    let it = [1, 2, 3].iter();
    println(f"{r.start}..{r.end} {it.len() == 3} {sum_all([1, 2, 3])}");
    let wide: i64 = From::from(7i32);
    let back: i32 = 8i64.wrapping_into();
    let sat: u8 = 300i32.saturating_into();
    println(f"{wide.type_name_of()} {wide} {back} {sat}");
    let fields: List<str> = Point::field_names();
    let methods: List<MethodInfo> = [];
    println(f"{Point::type_name()} {fields:?}");
    println(report(error::IndexError { index: 10, len: 3 }));
    println(report(ValueError::new("bad")));
    let buf = StrBuf::new();
    buf.push_str("ab");
    let ch: char = 'c';
    let cc: c_char = c'a';
    let n: NoneSentinel = none;
    let s: str = buf.to_str();
    println(f"{s} {ch} {cc as i32 - 96} {n.type_name_of()} {methods.is_empty()}");
    let t: Task<i32> = spawn(four());
    let got = (await t) + 1;
    let doubled = par::map([1, 2], |x| x * 2);
    let d = Duration::secs(2);
    let start = Instant::now();
    println(f"{got} {doubled:?} {par::fold([1, 1, 1], 0, |a, b| a + b)} {d}");
    let _ = start;
}

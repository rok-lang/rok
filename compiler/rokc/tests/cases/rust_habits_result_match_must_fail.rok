// Rust's `Ok(v)` / `Err(e)` patterns on a call that throws: one error
// each, with the `try` form to write. An unhandled call elsewhere, an
// arm's body included, still has its own error.

fn parse(s: str) throws -> i32 {
    if s == "" {
        throw "empty";
    }
    1
}

fn by_match() -> i32 {
    match parse("1") { Ok(v) => v, Err(e) => 0 }
}

fn by_if_let() {
    if let Ok(v) = parse("1") { println(v); }
}

fn by_let_else() -> i32 {
    let Ok(x) = parse("1") else { return 0; };
    x
}

fn by_arms() {
    match parse("1") { Ok(v) => println(v), Err(e) => println(e) }
}

fn err_only() {
    if let Err(e) = parse("1") { println(e); }
}

fn arm_throws() -> i32 {
    match parse("1") { Ok(v) => parse("2"), Err(e) => 0 }
}

fn unhandled() -> i32 {
    parse("3")
}

fn main() {}


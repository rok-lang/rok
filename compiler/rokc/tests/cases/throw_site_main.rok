// expect-stdout:

// An error leaving a throwing `main` names where it left and the `throw`
// that raised it.
use rok::core::io::{IoError, IoErrorKind};

fn parse(s: str) throws (IoError) -> i64 {
    if s == "" {
        throw IoError::new(IoErrorKind::InvalidData, "empty input");
    }
    1
}

fn load(s: str) throws (IoError) -> i64 { try parse(s) }

fn main() throws (IoError) {
    let v = try load("");
    println(f"{v}");
}

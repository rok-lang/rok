// only-pointer-width: 64
// expect-exit: 0
// expect-stdout:
// 6 14

// An `extern "ABI" fn` definition takes the ABI written.
// `"system"` is `"C"` on every 64-bit target, so its value is an
// `extern "C" fn` (32-bit x86 Windows: `509_2_extern_system_stdcall`).
extern "system" fn twice(x: i32) -> i32 { x * 2 }
extern "C" fn sum3(a: i32, b: i32, c: i32) -> i32 { a + b + c }

fn call(f: extern "C" fn(i32) -> i32, x: i32) -> i32 { f(x) }

println(f"{sum3(1, 2, 3)} {call(twice, 7)}");

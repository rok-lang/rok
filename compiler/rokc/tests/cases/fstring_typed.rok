// expect-exit: 0
// expect-stdout:
// [   42] [42   ] [-0042] [ 42] [+   42] [**42***]
// ff ffff ffffffff 0b11111111 377 0xCAFE 0x0000002a
// 3.14 3.1416 0.1 2.500 5.00
// 1.2345678e4 1.235e4 1.23E4 4.2e1 1e3 1.5e-1
// [3.1416] [    3.1416] [00042] [x$y] [cost: $100]
// [  -2.50] [ab   ] [abc] [  "q"] [P(1)      ] [p<1>]
// [1010] [ff] ["a"] [$$a] [hello]

// Typed f-strings: no align = numbers right,
// the rest left, precision on floats (any width), `b o x X` in the
// integer's own width, `e` / `E`, dynamic `${..}` width / precision / spec.
struct P { v: i32; }
impl Display for P { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"P({self.v})") } }
impl Debug for P { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"p<{self.v}>") } }

fn main() -> i32 {
    let n = 42;
    let neg = -42;
    println(f"[{n:5}] [{n:<5}] [{neg:05}] [{n: }] [{n:=+6}] [{n:*^7}]");
    let b: i8 = -1;
    let h: i16 = -1;
    let w: i32 = -1;
    let u: u8 = 255;
    let c: u32 = 0xCAFE;
    println(f"{b:x} {h:x} {w:x} {u:#b} {u:o} {c:#X} {n:#010x}");
    let x: f32 = 3.14159;
    let y = 3.14159265;
    let z: f32 = 0.1;
    println(f"{x:.2} {y:.4} {z} {2.5:.3} {5:.2f}");
    let big = 12345.678;
    println(f"{big:e} {big:.3e} {big:.2E} {n:e} {1000:e} {0.15:e}");
    let prec: usize = 4;
    let width = 10;
    let full = "05";
    println(f"[{y:.${prec}}] [{y:>${width}.${prec}}] [{n:${full}}] [{"x$y"}] [cost: $100]");
    let f = -2.5;
    let p = P { v: 1 };
    println(f"[{f:>7.2}] [{"ab":5}] [{"abcdef":.3}] [{"q":>5?}] [{p:10}] [{p:?}]");
    let spec = "b";
    let hex = "x";
    let dbg = "?";
    println(f"[{10:${spec}}] [{255:${hex}}] [{"a":${dbg}}] [{"a":$$>3}] [{"hello world":.${5}}]");
    return 0;
}


// expect-error: parameter `self` of `Bump::bump` is `ref` - pass `ref c`

struct Counter { c: i32; }
impl Counter {
    fn tick(ref self) { self.c = self.c + 1; }
}
trait Bump { fn bump(ref self); }
impl Bump for Counter { fn bump(ref self) { self.c = self.c + 10; } }
struct Box2<T> { v: T; }
impl<T> Box2<T> {
    fn set(ref self, v: T) { self.v = v; }
}

fn main() {
    let c = Counter { c: 0 };
    Bump::bump(c);
    c.tick();
    let b = Box2 { v: 1 };
    Box2::set(b, 5);
    println(f"{c.c} {b.v}");
}
// expect-error: parameter 1 of `Box2::set` is `ref` - pass `ref b`

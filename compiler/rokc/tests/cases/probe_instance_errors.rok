// expect-error: mismatched types: the return value expects `i32`, found `str`

// A generic instance first lowered while a throwing closure is probed
// for its types still reports its errors (an implicit parameter: its
// body is checked per instance).
fn bad(x) -> i32 {
    return x;
}

fn risky() throws (str) -> i32 {
    throw "no";
}

fn main() -> i32 {
    let f = || {
        let a = try risky();
        a + bad("s")
    };
    return 0;
}

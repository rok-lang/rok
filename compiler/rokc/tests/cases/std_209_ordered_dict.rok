// spec: std 209-collections §2.9.5
// expect-exit: 0
// expect-stdout:
// z a m
// 3 1 2

// spec 2.9.5: `OrderedDict` / `OrderedSet` keep insertion order; built only
// through constructors (`OrderedDict::from([...])`).
fn main() {
    let d = collections::OrderedDict::from([("z", 1), ("a", 2), ("m", 3)]);
    let ks = "";
    for k in d.keys() { ks = ks + k + " "; }
    println(ks.trim());
    let s = collections::OrderedSet::from([3, 1, 2]);
    let vs = "";
    for v in s { vs = vs + f"{v} "; }
    println(vs.trim());
}

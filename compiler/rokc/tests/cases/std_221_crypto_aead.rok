// rok::core::crypto::aead: AES-GCM (FIPS-197 via the GCM spec cases 1-4, 13-16),
// ChaCha20-Poly1305 (RFC 8439 2.8.2) and a Wycheproof subset.
use rok::core::crypto::aead::{Aead, AeadAlgorithm};

fn hex(b: List<u8>) -> str {
    let s = "";
    for x in b { s += f"{x:02x}"; }
    s
}

fn unhex(s: str) -> List<u8> {
    let out: List<u8> = [];
    let b = s.as_bytes();
    let i = 0usize;
    while i + 1 < b.len() {
        out.push((nib(b[i]) << 4) | nib(b[i + 1]));
        i += 2;
    }
    out
}

fn nib(c: u8) -> u8 {
    if c >= 0x30u8 && c <= 0x39u8 { return c - 0x30u8; }
    if c >= 0x61u8 && c <= 0x66u8 { return c - 0x61u8 + 10u8; }
    c - 0x41u8 + 10u8
}

fn check(name: str, got: List<u8>, want: str) {
    let g = hex(got);
    if g == want { println(f"ok {name}"); } else { println(f"FAIL {name}: {g} != {want}"); }
}

/// Seal and open one known-answer case.
fn kat(name: str, alg: AeadAlgorithm, k: str, n: str, a: str, p: str, c: str, t: str) {
    let ae = try Aead::new(alg, unhex(k)) catch _ { println(f"FAIL {name}: key"); return; };
    let sealed = try ae.seal(unhex(n), unhex(a), unhex(p)) catch _ { [] };
    check(name + " seal", sealed, c + t);
    let opened = try ae.open(unhex(n), unhex(a), sealed) catch _ { none };
    match opened {
        x: List<u8> => check(name + " open", x, p),
        none => println(f"FAIL {name} open"),
    }
}

fn wycheproof(row: str) {
    let f: List<str> = [];
    for x in row.split("|") { f.push(x); }
    let alg = if f[0] == "c" { AeadAlgorithm::ChaCha20Poly1305 } else if f[2].len() == 32 { AeadAlgorithm::Aes128Gcm } else { AeadAlgorithm::Aes256Gcm };
    let name = f"wycheproof {f[0]} {f[1]}";
    let ae = try Aead::new(alg, unhex(f[2])) catch _ { println(f"FAIL {name}: key"); return; };
    let valid = f[8] == "v";
    let got = try ae.open(unhex(f[3]), unhex(f[4]), unhex(f[6] + f[7])) catch _ {
        // Only nonce sizes other than 96 bits throw (out of scope).
        if f[3].len() != 24 { println(f"ok {name}"); } else { println(f"FAIL {name}: threw"); }
        return;
    };
    let ok = match got {
        x: List<u8> => valid && hex(x) == f[5],
        none => !valid,
    };
    if valid {
        let sealed = try ae.seal(unhex(f[3]), unhex(f[4]), unhex(f[5])) catch _ { [] };
        ok = ok && hex(sealed) == f[6] + f[7];
    }
    if ok { println(f"ok {name}"); } else { println(f"FAIL {name}"); }
}


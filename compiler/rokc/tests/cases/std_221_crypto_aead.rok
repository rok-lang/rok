fn main() {
    let sun = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
    let sunhex = hex(sun.as_bytes().to_list());
    kat("aead 2.8.2", AeadAlgorithm::ChaCha20Poly1305, "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f", "070000004041424344454647", "50515253c0c1c2c3c4c5c6c7", sunhex,
        "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116",
        "1ae10b594f09e26a7e902ecbd0600691");

    // GCM spec (McGrew-Viega) test cases 1-4, 13-16.
    let z12 = "000000000000000000000000";
    let z16 = "00000000000000000000000000000000";
    let kf = "feffe9928665731c6d6a8f9467308308";
    let iv = "cafebabefacedbaddecaf888";
    let p64 = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255";
    let p60 = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39";
    let ad = "feedfacedeadbeeffeedfacedeadbeefabaddad2";
    kat("gcm 1", AeadAlgorithm::Aes128Gcm, z16, z12, "", "", "", "58e2fccefa7e3061367f1d57a4e7455a");
    kat("gcm 2", AeadAlgorithm::Aes128Gcm, z16, z12, "", z16, "0388dace60b6a392f328c2b971b2fe78", "ab6e47d42cec13bdf53a67b21257bddf");
    kat("gcm 3", AeadAlgorithm::Aes128Gcm, kf, iv, "", p64, "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f5985", "4d5c2af327cd64a62cf35abd2ba6fab4");
    kat("gcm 4", AeadAlgorithm::Aes128Gcm, kf, iv, ad, p60, "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091", "5bc94fbc3221a5db94fae95ae7121a47");
    kat("gcm 13", AeadAlgorithm::Aes256Gcm, z16 + z16, z12, "", "", "", "530f8afbc74536b9a963b4f1c4cb738b");
    kat("gcm 14", AeadAlgorithm::Aes256Gcm, z16 + z16, z12, "", z16, "cea7403d4d606b6e074ec5d3baf39d18", "d0d1c8a799996bf0265b98b5d48ab919");
    kat("gcm 15", AeadAlgorithm::Aes256Gcm, kf + kf, iv, "", p64, "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662898015ad", "b094dac5d93471bdec1a502270e3cc6c");
    kat("gcm 16", AeadAlgorithm::Aes256Gcm, kf + kf, iv, ad, p60, "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662", "76fc6ece0f4e1768cddf8853bb2d551b");

    for row in WYCHEPROOF { wycheproof(row); }

    let bad = try Aead::new(AeadAlgorithm::Aes256Gcm, unhex(z16)) catch _ { println("ok bad key"); return; };
    println(f"FAIL bad key {bad.algorithm():?}");
}


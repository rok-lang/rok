// expect-exit: 5
// expect-stdout:
// 0 7 5 -1 -1

fn search(xs: [i32; 8], target: i32) -> i32 {
    let lo = 0;
    let hi = 8;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if xs[mid] == target {
            return mid;
        }
        if xs[mid] < target {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return -1;
}

fn main() -> i32 {
    let xs: [i32; 8] = [1, 3, 5, 8, 13, 21, 34, 55];
    let i = search(xs, 21);
    println(f"{search(xs, 1)} {search(xs, 55)} {i} {search(xs, 4)} {search(xs, 100)}");
    return i;
}

// expect-exit: 0
// expect-stdout:
// true false true
// 3

// Only `{ .. }` / `|params| { .. }` after a call start a
// trailing closure; `f() || x` is logical or (a 0-arg trailing closure
// is spelled `{ .. }`).

struct P { s: str; }

impl P {
    fn abs(self) -> bool { return self.s.starts_with("/"); }
    fn either(self, o: P) -> bool { return o.abs() || self.s == ""; }
}

fn twice(f: fn() -> i32) -> i32 { return f() + f(); }

fn main() {
    let a = P { s: "/x" };
    let b = P { s: "y" };
    println(f"{a.either(a)} {a.either(b)} {P { s: "" }.either(b)}");
    let n = twice() { 1 } + 1;
    println(f"{n}");
}

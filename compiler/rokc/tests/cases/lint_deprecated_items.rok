// spec: §6.2.7 §6.2.9
// expect-exit: 0
// expect-lint: 35:36 use of deprecated function `twice`
// expect-lint: 36:12 use of deprecated type `Old`
// expect-lint: 36:18 use of deprecated type `Old`
// expect-lint: 37:22 use of deprecated constant `MAX`
// expect-lint: 37:28 use of deprecated static `COUNT`
// expect-lint: 37:36 use of deprecated function `twice`
// expect-warning: deprecated since 0.1.6
// expect-warning: = note: use New
// expect-warning: `#[allow(deprecated)]` on the item that uses `COUNT`
// expect-stdout: 1 3 4 4 6

// Types (in a type and in a path), constants, statics, generic
// functions and functions used as values. A type's own impl and an
// `#[allow(deprecated)]` item stay quiet.
#[deprecated(since = "0.1.6", note = "use New")]
struct Old { v: i32; }
impl Old { fn make() -> Old { Old { v: 1 } } }

#[deprecated = "use LIMIT"]
const MAX: i32 = 3;
#[deprecated]
static COUNT: i32 = 4;

#[deprecated("use double")]
fn twice<T>(x: T) -> (T, T) { (x, x) }

fn double(x: i32) -> i32 { x * 2 }

#[allow(deprecated)]
fn quiet() -> i32 { COUNT + MAX - MAX }

fn main() {
    let f: fn(i32) -> (i32, i32) = twice;
    let o: Old = Old::make();
    println(f"{o.v} {MAX} {COUNT} {twice(4).0} {quiet() + double(1)}");
    let _ = f(1);
}

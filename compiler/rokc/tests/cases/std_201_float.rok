// spec: std 201-numbers §2.1.3 float, §2.1.5 literal
// expect-exit: 0
// expect-stdout:
// false 0.30000000000000004
// 1e309 true true
// inf false true
// 1e400 1.5 3.5 1e-400

// Spec 2.1.3: `float` is `f64` in range (`0.1 + 0.2 != 0.3`, IEEE NaN /
// inf, `PartialEq` only); a result past `f64`'s exponent range is
// promoted instead of becoming inf / 0. 2.1.5: an unsuffixed literal in
// a `float` slot is a `float` (an integer one too).
fn main() {
    let a: float = 0.1;
    let b: float = 0.2;
    println(f"{a + b == 0.3} {a + b}");
    let x: float = 1e308;
    let y = x * 10;
    println(f"{y} {y / 10 == x} {y.is_finite()}");
    let z: float = 0;
    let one: float = 1;
    let nan = z / z;
    println(f"{one / z} {nan == nan} {nan != nan}");
    let lit: float = 1e400;
    let n: float = 3;
    println(f"{lit} {n / 2} {float::from_f64(2.5) + 1} {float::parse_or_none("1e-400") ?? z}");
}

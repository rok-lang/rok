// expect-exit: 0
// expect-stdout:
// hello, 세😀xxxxxxxxxxxxxxxxxxxx
// 34 true
// [] 0
// 0:a
// 1:세
// 4:b
// one
// two
// three
// Z
// cannot parse "ab": too many characters
// héllo
// invalid UTF-8 at byte 1

// `StrBuf` (push / push_str / len / capacity / clear /
// to_str), `str::char_indices` / `split_whitespace` / `from_utf8` /
// `as_bytes`, and `FromStr` for `char`.

fn main() {
    let b = StrBuf::new();
    b.push('h');
    b.push_str("ello, ");
    b.push('세');
    b.push('😀');
    let i = 0;
    while i < 20 { b.push('x'); i += 1; }
    println(b.to_str());
    println(f"{b.len()} {b.capacity() >= b.len()}");
    let shared = b; // a handle: copies share the buffer
    shared.clear();
    println(f"[{b.to_str()}] {StrBuf::with_capacity(64).len()}");
    for (i, c) in "a세b".char_indices() { println(f"{i}:{c}"); }
    for w in "  one two\tthree\n ".split_whitespace() { println(w); }
    let c: char = try! "Z".parse();
    println(f"{c}");
    let bad = try "ab".parse::<char>() catch e { println(f"{e}"); 'q' };
    println(try! str::from_utf8("héllo".as_bytes()));
    let bytes: List<u8> = [104u8, 0xFFu8];
    println(try str::from_utf8(bytes) catch e { f"{e}" });
}


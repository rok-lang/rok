// A generic body sees only what its declaration and bounds give it.

use rok::core::ops::Add;

trait Shape { fn area(self) -> f64; }
trait Bag {
    type Elem;
    fn first(self) -> Elem;
}

fn elem_area<B: Bag>(b: B) -> f64 { b.first().area() }
fn sum_items<I: Iterator>(it: I) -> i64 {
    let s = 0i64;
    for x in it { s = s + x; }
    s
}
fn add_out<T: Add>(a: T, b: T) -> T { return a + b; }

trait Greet {
    fn name(self) -> str;
    fn greet(self) -> str { self.name() + self.title() }
}
struct Plain;
impl Greet for Plain { fn name(self) -> str { "p" } }

struct Pair<A, B> { a: A; b: B; }
impl<A: Clone, B> Pair<A, B> {
    fn left(self) -> A { self.a.clone() }
    fn right(self) -> B { self.b.clone() }
}

fn scaled<T>(xs: List<T>, k: T) -> List<T> { xs.iter().map(|x| x * k).collect() }
fn sorted<T>(xs: List<T>) { xs.sort(); }
async fn sent<T>(x: T) -> T { await task::spawn(async { x }) }
fn resize<T, const N: usize, const M: usize>(a: [T; N]) -> [T; M] { a }
fn mixed<T: Ord, U: Ord>(a: T, b: U) -> bool { a < b }

fn bad<T>(x: T) -> i32 { x.len() }

println(f"{bad("s")} {Plain.greet()}");
// expect-error-extra: allow
// (`sent` also reports `AsyncFuture<T>` not `Send`, from the same
// missing `T: Send`)

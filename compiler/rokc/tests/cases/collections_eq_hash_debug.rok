// expect-exit: 0
// expect-stdout:
// [1, 2, 3] true false true
// {"a": 1} true false true
// {"x"} true false true
// nested: 2 [[1], [2, 3]]

// `PartialEq` / `Eq` / `Hash` / `Debug` for `List`, `Dict`, `Set`:
// lists compare in order, dicts and sets ignore insertion order (and
// so does their hash); collections work as `Set` / `Dict` keys.

/// `x`'s hash under the process key.
fn hash_of<T: Hash>(x: T) -> u64 {
    let h = RandomState::new().build_hasher();
    x.hash(ref h);
    h.finish()
}

fn main() {
    let a = [1, 2, 3];
    let b = [1, 2, 3];
    let c = [3, 2, 1];
    println(f"{a:?} {a == b} {a == c} {hash_of(a) == hash_of(b)}");

    let d1: Dict<str, i32> = Dict::new();
    d1.insert("a", 1);
    d1.insert("b", 2);
    let d2: Dict<str, i32> = Dict::new();
    d2.insert("b", 2);
    d2.insert("a", 1);
    let d3: Dict<str, i32> = Dict::new();
    d3.insert("a", 1);
    d3.insert("b", 3);
    let one: Dict<str, i32> = Dict::new();
    one.insert("a", 1);
    println(f"{one:?} {d1 == d2} {d1 == d3} {hash_of(d1) == hash_of(d2)}");

    let s1: Set<str> = Set::new();
    s1.insert("x");
    s1.insert("y");
    let s2: Set<str> = Set::new();
    s2.insert("y");
    s2.insert("x");
    let s3: Set<str> = Set::new();
    s3.insert("x");
    println(f"{s3:?} {s1 == s2} {s1 == s3} {hash_of(s1) == hash_of(s2)}");

    let seen: Set<List<i32>> = Set::new();
    seen.insert([1]);
    seen.insert([2, 3]);
    seen.insert([1]);
    let shown: List<List<i32>> = [[1], [2, 3]];
    println(f"nested: {seen.len()} {shown:?}");
}
// spec: std §2.5.6

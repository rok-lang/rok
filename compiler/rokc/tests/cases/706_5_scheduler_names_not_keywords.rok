// expect-exit: 0
// expect-stdout:
// spawn=1 race=2 join=3 sleep=4
// task: 42

// Scheduler operations are library functions, not keywords:
// `spawn`, `race`, `join`, `sleep` stay usable as ordinary names.
fn spawn() -> i32 { 1 }

async fn main() {
    let race = 2;
    let join = 3;
    let sleep = |x: i32| x + 1;
    println(f"spawn={spawn()} race={race} join={join} sleep={sleep(3)}");
    let t = task::spawn(async { 42 });
    println(f"task: {await t}");
}

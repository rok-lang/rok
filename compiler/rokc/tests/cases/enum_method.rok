// expect-exit: 11
// expect-stdout:
// 6 4 18 12

enum Shape {
    Circle(i32),
    Square(i32),
}

impl Shape {
    fn perimeter(self) -> i32 {
        return match self {
            Shape::Circle(r) => r * 6,
            Shape::Square(s) => s * 4,
        };
    }
}

fn main() -> i32 {
    let c = Shape::Circle(1);
    let s = Shape::Square(1);
    let total = c.perimeter() + s.perimeter();
    println(f"{c.perimeter()} {s.perimeter()} {Shape::Circle(3).perimeter()} {Shape::Square(3).perimeter()}");
    return total + 1;
}


// needs: threads
// expect-exit: 0
// expect-stdout:
// io: NotFound none gone | true false
// rokon: 1:5 .b expected i32, found string
// join: Taken true | true
// v4: 10 1
// v6: 1
// tls: Certificate 42 | true
// env: true | true
// var: environment variable not found | NotPresent

// std errors read through methods: private fields, `message()`, and
// `PartialEq` / `Clone` on every one.
use rok::core::io::{IoError, IoErrorKind};
use rok::std::net::{Ipv4Addr, Ipv6Addr};
use rok::std::net::tls::{Certificate, TlsErrorKind};
use rok::std::rokon;
use rok::std::thread;
use rok::std::thread::JoinErrorKind;
use rok::std::env;
use rok::std::path::Path;

#[derive(Rokon)]
struct S { b: i32; }

fn same<T: Clone + Eq>(x: T) -> bool { x.clone() == x }

fn main() {
    let e = IoError::new(IoErrorKind::NotFound, "gone");
    let code = match e.os_code() { c: i32 => f"{c}", none => "none" };
    let other = IoError::new(IoErrorKind::Other, "gone");
    println(f"io: {e.kind():?} {code} {e.message()} | {same(e)} {e == other}");
    try rokon::from_str::<S>("{b: \"x\"}") catch x {
        println(f"rokon: {x.line()}:{x.column()} {x.path()} {x.message()}");
        S { b: 0 }
    };
    let h = thread::spawn(|| 1);
    _ = try! h.join();
    try h.join() catch x {
        println(f"join: {x.kind():?} {x.kind() == JoinErrorKind::Taken} | {same(x)}");
        0
    };
    let a = Ipv4Addr::new(10u8, 0u8, 0u8, 1u8);
    println(f"v4: {a.octets()[0]} {a.octets()[3]}");
    println(f"v6: {Ipv6Addr::LOCALHOST.segments()[7]}");
    let tls = try { Certificate::from_der([1u8, 2u8]); "parsed" } catch t {
        f"{t.kind():?} {t.alert()} | {same(t) && t.kind() == TlsErrorKind::Certificate}"
    };
    println(f"tls: {tls}");
    let sep = if cfg!(target_os = "windows") { ";" } else { ":" };
    let bad = f"a{sep}b";
    try env::join_paths([Path::new(bad)].iter()) catch j {
        println(f"env: {j.path() == bad} | {j.message().starts_with("path ")}");
        ""
    };
    try env::var("ROK_TEST_SURELY_UNSET_VARIABLE") catch v {
        println(f"var: {v.message()} | {v:?}");
        ""
    };
}

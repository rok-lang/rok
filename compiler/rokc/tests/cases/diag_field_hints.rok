// Field and method hints: a postfix `.await`, `.length`, a library
// type's private fields (never listed), and a method only one case of a
// sum has.
struct U { nick: str | none; }

async fn get() -> i32 { 1 }

fn main() {
    let a = get().await;
    let xs = [1, 2];
    let b = xs.length;
    let c = xs.items;
    let u = U { nick: "bob" };
    if u.nick is str {
        println(f"{u.nick.len()}");
    }
    let v: i32 | str = 5;
    let d = v.len();
}

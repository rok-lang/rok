// expect-exit: 0
// expect-stdout:
// Q(1) Q(1) 7
// local 5

// An `impl` in a function body is coherent as if declared at module
// level: its methods and trait impl hold everywhere, not only in the
// block. A local trait and its impl for a local type work too.
trait Show { fn show(self) -> str; }
struct Q { n: i32; }

fn install() {
    impl Show for Q {
        fn show(self) -> str { f"Q({self.n})" }
    }
    impl Q {
        fn plus(self, k: i32) -> i32 { self.n + k }
    }
}

fn local() -> str {
    trait Name { fn name(self) -> str; }
    struct L { v: i32; }
    impl Name for L {
        fn name(self) -> str { f"local {self.v}" }
    }
    L { v: 5 }.name()
}

fn main() {
    install();
    let q = Q { n: 1 };
    println(f"{q.show()} {Q { n: 1 }.show()} {q.plus(6)}");
    println(local());
}

// expect-error: the closure's captures don't meet the `fn` type's bounds
// `thread::spawn` takes `fn() -> T + Send` (304): a closure
// capturing a `Cell` (neither Send nor Sync) is rejected.
use rok::std::thread;

fn main() -> i32 {
    let c = Cell::new(1);
    let h = thread::spawn(|| { c.set(2); 0 });
    return try! h.join();
}


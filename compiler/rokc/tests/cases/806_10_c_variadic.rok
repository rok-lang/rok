// expect-exit: 0
// expect-stdout: sum=14 x=-3

// C variadic functions (`printf`) are callable through
// `extern "C" { fn printf(fmt: ConstPtr<c_char>, ...); }`, following the
// platform's C variadic convention.
extern "C" {
    fn printf(fmt: str, ...) -> i32;
}

fn main() {
    let _ = unsafe { printf("sum=%d x=%d\n", 14, -3) };
}

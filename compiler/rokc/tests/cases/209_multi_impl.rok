// expect-exit: 0
// expect-stdout:
// 5
// 25

// Several impl blocks for one type, for grouping.
struct V { n: i32; }

impl V {
    fn first(self) -> i32 { return self.n; }
}

impl V {
    fn squared(self) -> i32 { return self.n * self.n; }
}

fn main() -> i32 {
    let v = V { n: 5 };
    println(f"{v.first()}");
    println(f"{v.squared()}");
    return 0;
}

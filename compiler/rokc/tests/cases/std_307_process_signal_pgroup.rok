// spec: std 307-process §3.7.1 §3.7.5
// expect-exit: 0
// expect-stdout:
// grouped: true
// plain: false
// handled: 2
// sigkill: SignalError { sig: 9, code: 22 }

// spec 3.7.1: `Command::process_group(0)` makes the child lead a new
// process group. 3.7.5: `on_signal(sig, handler)` runs `handler` when the
// signal arrives (on a dispatcher thread), `raise(sig)` sends one to
// this process, and an uncatchable signal throws `SignalError`.
use rok::std::process;
use rok::std::process::{Command, Signal};
use rok::std::thread;
use rok::std::time::Duration;
use rok::std::io::IoError;

fn leads_group(cmd: Command) throws (IoError) -> bool {
    try cmd.args(["-c", "kill -0 -$$ 2>/dev/null"]).status().success()
}

fn main() throws (IoError) {
    println(f"grouped: {try leads_group(Command::new("sh").process_group(0))}");
    println(f"plain: {try leads_group(Command::new("sh"))}");

    let hits: Atomic<i64> = Atomic::new(0);
    try! process::on_signal(Signal::Hangup, || { hits.fetch_add(1, SeqCst); });
    try process::raise(1);
    // Wait for the dispatcher before the next one: a second signal
    // still pending in the kernel would merge with the first.
    for _ in 0..200 { if hits.load(SeqCst) >= 1 { break; } thread::sleep(Duration::ms(10)); }
    try process::raise(1);
    for _ in 0..200 { if hits.load(SeqCst) >= 2 { break; } thread::sleep(Duration::ms(10)); }
    println(f"handled: {hits.load(SeqCst)}");

    let e = try { process::on_signal(Signal::Kill, || {}); "ok" } catch e { f"{e:?}" };
    println(f"sigkill: {e}");
}
// only-os: macos linux

// expect-exit: 0
// expect-stdout:
// 7
// 6
// 20
// 1
// -6
// 1

// Stdlib spec 0.3: core's primitive trait methods are
// `#[intrinsic("rok.OP.TYPE")]` - calling them by name lowers to the
// machine op (method call, path call, through a type parameter).

fn twice<T: ops::Mul<T, Output = T>>(x: T, k: T) -> T { return T::mul(x, k); }

fn main() -> i32 {
    println(f"{3.add(4)}");
    println(f"{i32::sub(10, 4)}");
    println(f"{twice(10, 2)}");
    println(f"{if true.not() == false && 3.lt(4) { 1 } else { 0 }}");
    println(f"{5.bitnot()}");
    println(f"{if 2.5f64.ge(2.5f64) { 1 } else { 0 }}");
    return 0;
}
// spec: std 003-intrinsics §0.3.2 §0.3.3

// needs: threads
// expect-error: 9:31: `g.get()` is a view of what the `Mutex` behind `g` protects, and `keep` keeps it past the call
// A guarded value given to a fn value that stores it in a captured list.
use rok::std::thread;
static M: Mutex<List<i32>> = Mutex::new([]);
fn main() {
    let side: List<List<i32>> = [];
    let keep = |v: List<i32>| { side.push(v); };
    using g = M.lock() { keep(g.get()); }
    let t = thread::spawn(|| { for i in 0..200000 { using g = M.lock() { g.get().push(i); } } 0 });
    for i in 0..200000 { side[0].push(i); }
    let _ = try! t.join();
    println(f"len {side[0].len()}");
}

// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/std_209_14_array_fused_panics.rok:15:10:
// expect-stderr: broadcast: the result has shape [2, 3], which does not fit the destination of shape [1, 3]; the destination is not stretched
// expect-stdout: [[1, 2, 3]]

// In place, the operands stretch to the target; the target keeps its
// shape.
use rok::core::array::Array;

fn main() {
    let t: Array<i64, 2> = [[0, 0, 0]];
    let a: Array<i64, 2> = [[1, 2, 3], [4, 5, 6]];
    t .= a[:1];
    println(f"{t:?}");
    t .= a;
}

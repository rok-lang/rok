// spec: §3.11.1 §2.4.8
// expect-error: variant_target_typed_match.rok:20:37: variant `Color::Custom` has a payload: match it as `Custom(..)`
// forbid-error: new variable
// forbid-error: unreachable match arm

// spec 2.4.8 / 3.11: a bare name in a pattern that is a variant of the
// scrutinee's enum is that variant, imported or not. A payload variant
// still needs its payload pattern.

enum Color { Red, Green, Custom(i32) }

fn name(c: Color) -> str {
    match c {
        Red => "red",
        Green => "green",
        Custom(_) => "custom",
    }
}

fn bad(c: Color) -> str { match c { Custom => "custom", _ => "other" } }

println(name(Color::Green));

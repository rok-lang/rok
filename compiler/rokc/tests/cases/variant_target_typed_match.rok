// spec: §3.11.1
// expect-error: diag_bare_variant_pattern.rok:17:9: `Red` here is a new variable that matches every value, not the variant `Color::Red`
// expect-error: help: did you mean `Color::Red`?
// expect-error: diag_bare_variant_pattern.rok:18:9: `Green` here is a new variable that matches every value, not the variant `Color::Green`
// expect-error: diag_bare_variant_pattern.rok:19:9: `Custom` here is a new variable that matches every value, not the variant `Color::Custom`
// expect-error: help: did you mean `Color::Custom(..)`?
// forbid-error: unreachable match arm

// spec 3.11: a bare name in a pattern binds, unless it is an imported
// variant. One named like a variant of the scrutinee's enum, not
// imported, is an error: it would match every value.

enum Color { Red, Green, Custom(i32) }

fn name(c: Color) -> str {
    match c {
        Red => "red",
        Green => "green",
        Custom => "custom",
    }
}

println(name(Color::Green));

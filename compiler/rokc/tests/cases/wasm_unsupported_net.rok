// spec: std 302
// only-target: wasm32-wasip1-threads wasm32-unknown-unknown
// expect-exit: 0
// expect-stdout:
// bind: Unsupported
// connect: Unsupported
// udp: Unsupported
// resolve: Unsupported
// inherited: 0

// No socket of its own: a browser has none, and WASI preview 1
// (`wasm32-wasip1-threads`) only serves listeners the host hands in
// (`TcpListener::inherited`, none here). Everything else reports
// `IoErrorKind::Unsupported` at run time.
use rok::std::net::{TcpListener, TcpStream, UdpSocket, SocketAddr};
use rok::std::net;
use rok::core::io::{IoError, IoErrorKind};

let any: SocketAddr = try! "127.0.0.1:0".parse::<SocketAddr>();
try TcpListener::bind(any) catch e: IoError { println(f"bind: {e.kind():?}"); };
try TcpStream::connect(any) catch e: IoError { println(f"connect: {e.kind():?}"); };
try UdpSocket::bind(any) catch e: IoError { println(f"udp: {e.kind():?}"); };
try net::tcp_connect("localhost:80") catch e: IoError { println(f"resolve: {e.kind():?}"); };
println(f"inherited: {TcpListener::inherited().len()}");
// spec: std 302-net §3.2.8
// spec: std 001-tier-model §0.1.4

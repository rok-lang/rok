// spec: 006.02-built-in-attributes
// expect-exit: 0
// expect-warning: `#[bench]` is a built-in attribute; a meta block taking its name becomes an error in 0.2.0: rename it, e.g. `#[impl_attribute(my_bench)]`
// expect-warning: `#[path]` is a built-in attribute
// expect-lint: 13:3 `#[bench]` is a built-in attribute; a meta block taking its name becomes an error in 0.2.0: rename it, e.g. `#[impl_attribute(my_bench)]`
// expect-lint: 22:3 `#[path]` is a built-in attribute; a meta block taking its name becomes an error in 0.2.0: rename it, e.g. `#[impl_attribute(my_path)]`
// expect-stdout:
// bench f
// 3

// Spec 6.2: built-in attribute names are reserved. A meta block that
// took one before it was listed still expands, with a warning.
#[impl_attribute(bench)]
pub @attribute {
    @accept(fn)
    fn @item.name(@item.params) -> @item.return_type {
        println("bench @item.name");
        @item.body
    }
}

#[impl_attribute(path)]
pub @attribute {
    @accept(fn)
    @item
}

#[bench]
fn f() -> i32 { return 1; }

fn main() -> i32 {
    println(f() + 2);
    return 0;
}

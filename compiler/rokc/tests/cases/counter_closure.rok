// expect-exit: 30
// expect-stdout:
// 1 18 18
// 2 21 39
// 3 24 63
// 4 27 90

fn main() -> i32 {
    let base = 5;
    let multiplier = 3;
    let xs: [i32; 4] = [1, 2, 3, 4];
    let total = 0;
    let scale = |x: i32| -> i32 { (x + base) * multiplier };
    for v in xs {
        total += scale(v);
        println(f"{v} {scale(v)} {total}");
    }
    return total - 60;
}

// rokc-arg: --extern litdep=tests/cases/605_2_literal_dep
// expect-error: unknown numeric literal suffix `hport`
// expect-error: register one, `#[literal(number "hport")] fn ..`, here or as a `pub fn` in a package this one depends on

// A dependency's `#[literal]` with a handler that is not `pub` does
// not change how its dependents parse.
use litdep::Port;

let p: Port = 80hport;
println(f"{p.n}");

// spec: 001.03.4-block-like-expression-statements
// expect-exit: 0
// expect-stdout:
// a
// b
// 0
// c
// 6
// d
// e

// A trailing-closure call that starts a statement ends at its `}`, as an
// `if` statement does (spec 1.3.4): a binary operator after it starts a
// new statement, on the next line or the same one. In a `let` the call
// is an operand like any other.
fn run(f: fn() -> ()) { f(); }
fn one(f: fn() -> ()) -> i32 { f(); 1 }

fn main() {
    let y = 5;
    run {
        println("a");
    }
    - y;
    let w = one { println("b"); }
        - 1;
    println(f"{w}");
    let z = one { println("c"); } +
        y;
    println(f"{z}");
    run { println("d"); } - y;
    run { println("e"); }
}

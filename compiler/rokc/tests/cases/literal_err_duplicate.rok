// expect-error: `#[literal("<<" expr ">>")]` is already registered by `wrap_a` with the same priority and return type
// Two handlers of one pattern with the same priority and the
// same return type can never be told apart, so the second registration
// is an error even before any use (another priority or return type is
// fine: the slot type or `priority` picks).
struct W { n: i32; }
struct V { n: i32; }

#[literal("<<" expr ">>")]
fn wrap_a(x: i32) -> W { W { n: x } }

#[literal("<<" expr ">>")]
fn wrap_b(x: i32) -> W { W { n: x + 1 } }

#[literal("<<" expr ">>", priority = 1)]
fn wrap_c(x: i32) -> W { W { n: x + 2 } }

#[literal("<<" expr ">>")]
fn wrap_v(x: i32) -> V { V { n: x } }

fn main() -> i32 { 0 }

// expect-exit: 0
// expect-stdout:
// 5
// 1.4142135623730951
// 2.718281828459045

// User-declared `extern "C"` calls into libc math. Demonstrates the
// FFI path beyond the auto-injected runtime hooks.
extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
}

fn main() -> i32 {
    println(f"{unsafe { sqrt(25.0f64) }}");    // 5
    println(f"{unsafe { sqrt(2.0f64) }}");     // 1.4142135623730951
    println(f"{unsafe { exp(1.0f64) }}");      // 2.718281828459045
    return 0;
}

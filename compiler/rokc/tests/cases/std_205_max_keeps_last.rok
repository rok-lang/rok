// expect-exit: 0
// expect-stdout:
// 2 1
// 3 1
// 3 1

// `max` keeps the last of equals and `min` the first: `Ord`, `Iterator`
// and `TryIterator` agree.
struct K { key: i32; id: i32; }

impl PartialEq for K {
    fn eq(self, rhs: K) -> bool { self.key == rhs.key }
}
impl Eq for K {}
impl PartialOrd for K {
    fn lt(self, rhs: K) -> bool { self.key < rhs.key }
    fn gt(self, rhs: K) -> bool { self.key > rhs.key }
    fn le(self, rhs: K) -> bool { self.key <= rhs.key }
    fn ge(self, rhs: K) -> bool { self.key >= rhs.key }
}
impl Ord for K {
    fn cmp(self, rhs: K) -> Ordering { self.key.cmp(rhs.key) }
}

fn main() {
    let a = K { key: 7, id: 1 };
    let b = K { key: 7, id: 2 };
    println(f"{a.max(b).id} {a.min(b).id}");
    let ks: List<K> = [K { key: 5, id: 1 }, K { key: 5, id: 2 }, K { key: 5, id: 3 }];
    let hi = ks.iter().max() ?? a;
    let lo = ks.iter().min() ?? a;
    println(f"{hi.id} {lo.id}");
    let rs: List<Result<K, str>> = [Result::Ok(ks[0]), Result::Ok(ks[1]), Result::Ok(ks[2])];
    let thi = try iter::from_results(rs).max() catch _ { none };
    let tlo = try iter::from_results(rs).min() catch _ { none };
    println(f"{(thi ?? a).id} {(tlo ?? a).id}");
}

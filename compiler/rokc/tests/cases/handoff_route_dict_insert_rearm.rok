// needs: threads
// expect-error: `d` still holds `d["a"]`, which was handed to another owner
// A dict value sent, then another insert re-arms it.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let d: Dict<str, List<i32>> = Dict::new();
    d.insert("a", []);
    try! tx.send(d["a"]);
    d.insert("b", []);
    for i in 0..200000 { d["a"].push(i); }
    let _ = try! t.join();
    println(f"len {d["a"].len()}");
}

// spec: 003.14.3-try-opt
// expect-exit: 0
// expect-lint: 22:13 `try? find(-1) ?? 9` is `try? (find(-1) ?? 9)`: an error gives `none`, not `9`
// expect-warning: help: write `(try? find(-1)) ?? 9` to get `9` on an error, or `try? (find(-1) ?? 9)` to keep this meaning
// expect-stdout: none 9 none 9 9

// `try? f() ?? d` covers `f() ?? d`, so an error gives `none`, not `d`
// (spec 3.14.3). Either grouping written out is quiet.
#[derive(Debug)]
struct E {}
impl Display for E { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("E") } }
impl Error for E {}

// An error below zero, `none` at zero.
fn find(n: i32) throws (E) -> i32? {
    if n < 0 { throw E {}; }
    if n == 0 { return none; }
    n
}

fn main() {
    let a = try? find(-1) ?? 9;
    let b = (try? find(-1)) ?? 9;
    let c = try? (find(-1) ?? 9);
    let d = try? (find(0) ?? 9);
    println(f"{a:?} {b} {c:?} {d:?} {quiet()}");
}

#[allow(try_coalesce_precedence)]
fn quiet() -> i32 {
    (try? find(0) ?? 9) ?? 0
}

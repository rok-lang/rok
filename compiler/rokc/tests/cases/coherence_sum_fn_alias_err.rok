// expect-error: 20:15: conflicting implementations of trait `X`: `impl<..> X for W<T | A>` and `impl<..> X for W<A | U>` overlap
// expect-error: 22:15: conflicting implementations of trait `X`: `impl<..> X for V<fn(T) -> i32>` and `impl<..> X for V<fn(str) -> U>` overlap on `V<fn(str) -> i32>`
// expect-error: 24:15: conflicting implementations of trait `X`: `impl<..> X for (T, List<i32>)` and `impl<..> X for (str, IntList)` overlap on `(str, List<i32>)`
// expect-error: 26:15: conflicting implementations of trait `X`: `impl<..> X for Z<fn(T) -> i32>` and `impl<..> X for Z<fn(U) -> i32 + Send>` overlap

// Coherence unifies generic impl targets structurally: sum
// members as a set, `fn` types (auto bounds don't separate: a
// `+ Send` value fits the plain impl too), and through type aliases.

trait X { fn x(self) -> i32; }

struct A;
struct W<T> { t: T; }
struct V<T> { t: T; }
struct Z<T> { t: T; }

type IntList = List<i32>;

impl<T> X for W<T | A> { fn x(self) -> i32 { 1 } }
impl<U> X for W<A | U> { fn x(self) -> i32 { 2 } }
impl<T> X for V<fn(T) -> i32> { fn x(self) -> i32 { 3 } }
impl<U> X for V<fn(str) -> U> { fn x(self) -> i32 { 4 } }
impl<T> X for (T, List<i32>) { fn x(self) -> i32 { 5 } }
impl<U> X for (str, IntList) { fn x(self) -> i32 { 6 } }
impl<T> X for Z<fn(T) -> i32> { fn x(self) -> i32 { 7 } }
impl<U> X for Z<fn(U) -> i32 + Send> { fn x(self) -> i32 { 8 } }

fn main() -> i32 { return 0; }

// expect-exit: 30
// expect-stdout:
// 3
// 10
// 21

struct Pair<T> {
    a: T;
    b: T;
}

fn main() -> i32 {
    let xs: [Pair<i32>; 3] = [
        Pair { a: 1, b: 2 },
        Pair { a: 3, b: 4 },
        Pair { a: 5, b: 6 },
    ];
    let total = 0;
    let i = 0;
    while i < 3 {
        total += xs[i].a + xs[i].b;
        println(f"{total}");
        i += 1;
    }
    return total + 9;
}


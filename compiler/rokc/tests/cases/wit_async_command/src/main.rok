// only-target: wasm32-wasip2
// expect-exit: 0
// wasm-invoke: delayed-add(1, 2, 5) => 3
// wasm-invoke: check(21) => ok(42)
// wasm-invoke: check(-1) => err("negative")
// wasm-invoke: echo("x", 3) => ["x0", "x1", "x2"]
// expect-stdout:
// through a stream
// written true
// waited true
// stdin 0 bytes, done true

// A WASI preview 3 command: async `run`, async imports, streams, futures.
ffi::wit::import { "wit" }

use wasi::clocks::monotonic_clock;
use wasi::cli::{stdin, stdout};
use rok::core::channel::channel;

#[wit::export]
async fn run() -> Result<(), ()> {
    let (tx, rx) = channel::<u8>();
    let done = stdout::write_via_stream(rx);
    for b in "through a stream\n".bytes() {
        try! tx.send(b);
    }
    tx.close();
    let r = await done;
    println(f"written {r is Result::Ok}");
    let t0 = monotonic_clock::now();
    await monotonic_clock::wait_for(10000000u64);
    println(f"waited {monotonic_clock::now() - t0 >= 10000000u64}");
    let (input, status) = stdin::read_via_stream();
    let n = 0;
    for await b in input {
        n += 1;
    }
    println(f"stdin {n} bytes, done {(await status) is Result::Ok}");
    Result::Ok(())
}

#[wit::export]
async fn delayed_add(a: u32, b: u32, ms: u64) -> u32 {
    await monotonic_clock::wait_for(ms * 1000000u64);
    a + b
}

#[wit::export]
async fn check(x: i32) throws (str) -> i32 {
    await monotonic_clock::wait_for(1000000u64);
    if x < 0 {
        throw "negative";
    }
    x * 2
}

#[wit::export]
async fn echo(s: str, n: u32) -> List<str> {
    let out: List<str> = List::new();
    for i in 0..n {
        await monotonic_clock::wait_for(100000u64);
        out.push(f"{s}{i}");
    }
    out
}

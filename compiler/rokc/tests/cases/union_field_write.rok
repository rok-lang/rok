// expect-exit: 0
// expect-stdout:
// 7
// 1065353216

// Writing a union field is safe and rebuilds the union from
// that field; reading reinterprets the bits (in `unsafe`).
union Bits { i: i32; f: f32; }

struct Holder { b: Bits; tag: i32; }

fn main() -> i32 {
    let x = Bits { i: 5 };
    x.i = 7;
    println(f"{unsafe { x.i }}");
    let h = Holder { b: Bits { i: 0 }, tag: 1 };
    h.b.f = 1.0f32;
    println(f"{unsafe { h.b.i }}");
    return 0;
}



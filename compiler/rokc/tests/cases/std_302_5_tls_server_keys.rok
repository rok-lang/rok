fn config(cert: str, key: str) -> ServerConfig {
    try! ServerConfig::new(try! Certificate::from_pem(cert), try! PrivateKey::from_pem(key))
}

fn key_error(pem: str) -> str {
    let _ = try PrivateKey::from_pem(pem) catch e { return f"{e.kind():?} {e.message()}"; };
    "ok"
}

fn serve(l: TcpListener) -> i32 {
    let cfgs = [config(P256_CERT, P256_KEY), config(P384_CERT, P384_KEY), config(RSA_CERT, RSA_KEY)];
    let names = ["p256", "p384", "rsa"];
    let n = 0;
    for i in 0..3 {
        let (s, _) = try! l.accept();
        let srv = try Server::new(s, cfgs[i]) catch e { println(f"server: {e}"); continue; };
        n += 1;
        let buf = byte_buf(64);
        let k = try! srv.read(buf);
        try! srv.write_all(f"{srv.server_name() ?? "none"}|{names[i]}|{try! str::from_utf8(buf[0:k])}");
        try! srv.close();
    }
    try! l.close();
    n
}

fn main() {
    let l = try! tcp_listen("127.0.0.1:0");
    let port = (try! l.local_addr()).port();
    let t = thread::spawn(|| serve(l));
    let roots = try! Certificate::from_pem(CA);
    for what in ["p256 (PKCS #8)", "p384 (SEC1)", "rsa (PKCS #1)"] {
        let cfg = try! ClientConfig::new();
        cfg.root_certs = roots;
        let c = try! Client::with_config(try! tcp_connect(f"127.0.0.1:{port}"), "localhost", cfg);
        try! c.write_all("x");
        let back = try! str::from_utf8(try! c.read_to_end());
        println(f"{what} -> {back[0:back.len() - 2]}");
        try! c.close();
    }
    println(f"server saw {try t.join() catch _ { -1 }} connections");

    // A P-256 key of zero, PKCS #8 wrapped; text without a key.
    let zero = "-----BEGIN PRIVATE KEY-----\nMEECAQAwEwYHKoZIzj0CAQYIKoZIzj0DAQcEJzAlAgEBBCAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\n-----END PRIVATE KEY-----\n";
    println(f"bad key: {key_error(zero)}");
    println(f"no key block: {key_error(CA)}");
}

// spec: std 302-net §3.2.5

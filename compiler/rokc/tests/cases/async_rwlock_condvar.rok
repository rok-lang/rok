// expect-exit: 0
// expect-stdout:
// readers together: 2
// writes: 400
// waited for writer: true
// condvar: 64 woken, sum 2080
// cancelled waits: 3
// all free: true
// registrations left: 0

// `RwLock::read_async` / `write_async` and `Condvar::wait_async` suspend
// the task, not the worker; a cancelled wait leaves without keeping (or
// losing) a lock.
let rw = RwLock::new(0);

// Two readers hold the lock at once.
let inside = Atomic::new(0);
let most = Atomic::new(0);
let readers: List<Task<i32>> = List::new();
for i in 0..2 {
    readers.push(task::spawn(async {
        using r = await rw.read_async() {
            let n = inside.fetch_add(1) + 1;
            // The second one in sees 2 (nobody leaves before that).
            if n == 2 { most.store(n); }
            while most.load() < 2 { await task::yield_now(); }
            inside.fetch_sub(1);
        }
        0
    }));
}
await task::join(readers);
println(f"readers together: {most.load()}");

// Writers from many tasks: no lost update.
let writers: List<Task<i32>> = List::new();
for i in 0..40 {
    writers.push(task::spawn(async {
        for k in 0..10 {
            using w = await rw.write_async() {
                let v = w.get();
                await task::yield_now();
                w.set(v + 1);
            }
        }
        0
    }));
}
await task::join(writers);
using r = rw.read() { println(f"writes: {r.get()}"); }

// A reader waits (parked) while a writer holds it: the writer first,
// so the reader cannot get in before.
let order = Mutex::new("");
let reader: Task<i32> | none = none;
using w = await rw.write_async() {
    reader = task::spawn(async {
        using r = await rw.read_async() {
            using o = order.lock() { o.set(o.get() + "r"); }
        }
        0
    });
    await task::sleep(Duration::ms(20));
    using o = order.lock() { o.set(o.get() + "w"); }
}
if let t: Task<i32> = reader { await t; }
using o = order.lock() { println(f"waited for writer: {o.get() == "wr"}"); }

// Condvar: 64 tasks wait for a flag; one notify_all wakes them all.
let m = Mutex::new(0);
let cv = sync::Condvar::new();
let woken = Atomic::new(0);
let waiters: List<Task<i32>> = List::new();
for i in 0..64 {
    let me = i + 1;
    waiters.push(task::spawn(async {
        using g = await m.lock_async() {
            while g.get() == 0 {
                g = await cv.wait_async(g);
            }
            woken.fetch_add(1);
        }
        me
    }));
}
await task::sleep(Duration::ms(20));
using g = await m.lock_async() { g.set(1); }
cv.notify_all();
let sum = 0;
for v in await task::join(waiters) { sum += v; }
println(f"condvar: {woken.load()} woken, sum {sum}");

// Cancelled while parked: read_async / write_async under a writer, and
// wait_async (which must take the mutex back for its `using`).
let m2 = Mutex::new(0);
let cv2 = sync::Condvar::new();
let blocked: List<Task<i32>> = List::new();
let base = task::registrations();
using w = await rw.write_async() {
    blocked.push(task::spawn(async { using r = await rw.read_async() { } 1 }));
    blocked.push(task::spawn(async { using x = await rw.write_async() { } 1 }));
    blocked.push(task::spawn(async {
        using g = await m2.lock_async() {
            g = await cv2.wait_async(g);
        }
        1
    }));
    // Until all three are parked.
    let deadline = Instant::now() + Duration::secs(60);
    while task::registrations() < base + 3 && Instant::now() < deadline {
        await task::yield_now();
    }
    for t in blocked { t.cancel(); }
    let n = 0;
    for t in blocked {
        try await t.join() catch _: task::CancellationError { n += 1; 0 };
    }
    println(f"cancelled waits: {n}");
}
let free = rw.try_write() is sync::RwLockWriteGuard<i32> && m2.try_lock() is sync::MutexGuard<i32>;
println(f"all free: {free}");
println(f"registrations left: {task::registrations()}");


// expect-exit: 0
// expect-stdout:
// 3 unit unit
// 9 yes 1 outer
// 42 42 42 42
// 3 4 0 0
// -1 7
// a b c
// 5

// A block's tail is its value; `;` makes it unit; divergent blocks fit any type.
extern "C" {
    fn abs(x: i32) -> i32;
}

fn add(x: i32, y: i32) -> i32 {
    x + y
}
fn other(x: i32) -> i32 {
    let r = x + 1;
    return r;
}
fn early(x: i32) -> i32 {
    if x < 0 { return 0; }
    x * 2
}
fn f() -> i32 { 42 }
fn g() -> i32 { return 42; }

fn checked(v: i32) -> i32 {
    let x: i32 = if v > 0 {
        v
    } else {
        return -1;
    };
    let y = {
        if x > 5 { return x; }
        x + 5
    };
    y
}

fn main() {
    let a = {
        let x = 1;
        let y = 2;
        x + y
    };
    let b: () = {
        let x = 1;
        x + 2;
    };
    let e: () = {};
    println(f"{a} unit unit");

    let v = add({ 4 }, { let k = 2; k + 3 });
    let pos = if { v > 0 } { "yes" } else { "no" };
    let name = "outer";
    let inner = {
        let name = 1;
        name
    };
    println(f"{v} {pos} {inner} {name}");

    let x = 'b: { 42 };
    let y = 'b: { break 'b 42; };
    println(f"{f()} {g()} {x} {y}");

    println(f"{add(1, 2)} {other(3)} {early(-5)} {early(0)}");
    println(f"{checked(0)} {checked(7)}");

    let log: List<str> = [];
    let r = 'blk: {
        log.push("a");
        log.push("b");
        log.push("c");
        if log.len() == 3 { break 'blk log.len(); }
        log.push("d");
        0
    };
    println(f"{log[0]} {log[1]} {log[2]}");
    let n: i32 = unsafe { abs(-5) };
    if r == 3 { println(f"{n}"); }
}

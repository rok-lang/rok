// needs: threads
// expect-error: `items` still holds `items[0]`, which was handed to another owner
// Assigning one element re-arms the whole element place?
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let items: List<List<i32>> = [[], []];
    try! tx.send(items[0]);
    items[1] = [];
    for i in 0..200000 { items[0].push(i); }
    let _ = try! t.join();
    println(f"len {items[0].len()}");
}

// expect-exit: 0
// expect-lint: 79:11 `x` holds a `File` that is never closed
// expect-lint: 86:13 `f` holds a `File` that is never closed
// expect-lint: 92:13 `c` holds a `File` that is never closed
// expect-lint: 100:13 `v` holds a `File` that is never closed
// expect-lint: 105:13 `f` holds a `File` that is never closed
// spec: §6.2.9
// expect-stdout:
// ok

// `unclosed_resource` follows the value: a param is the caller's to
// close, and so is every binding that only renames, narrows or
// destructures it, in any kind of function. A binding of a value this
// function owns is judged with that value, reported where it is made.

use rok::std::fs::File;

pub fn sync_param(f: File) -> str { try! f.read_to_str() }

pub async fn async_param(f: File) -> str { try! f.read_to_str() }

pub yield fn gen_param(f: File) -> str { yield try! f.read_to_str(); }

pub async yield fn stream_param(f: File) -> str { yield try! f.read_to_str(); }

pub fn arm_param(v: File | i32) -> str {
    match v {
        x: File => try! x.read_to_str(),
        _ => "",
    }
}

pub async fn async_arm_param(v: File | i32) -> str {
    match v {
        x: File => try! x.read_to_str(),
        _ => "",
    }
}

pub fn is_param(v: File | i32) -> str {
    if v is File { try! v.read_to_str() } else { "" }
}

pub fn rename_param(f: File) -> str {
    let g = f;
    try! g.read_to_str()
}

pub fn destructure_param(pair: (File, i32)) -> str {
    let (a, _) = pair;
    try! a.read_to_str()
}

pub fn captured_param(f: File) -> str {
    let c = || try! f.read_to_str();
    c()
}

pub fn maybe(p: str) -> File | i32 {
    if p == "" { 0 } else { try! File::open(p) }
}

pub fn keep(v: File | i32) -> File | i32 { v }

// The narrowed value is handed on afterwards.
pub fn narrowed_handed(p: str) -> File | i32 {
    let c = maybe(p);
    let s = match c {
        x: File => try! x.read_to_str(),
        _ => "",
    };
    println(s);
    keep(c)
}

// Flagged: each of these owns a descriptor it never closes.

pub fn arm_owned(p: str) -> str {
    match maybe(p) {
        x: File => try! x.read_to_str(),
        _ => "",
    }
}

pub fn rename_owned(p: str) -> str {
    let f = try! File::open(p);
    let g = f;
    try! g.read_to_str()
}

pub fn narrowed_owned(p: str) -> str {
    let c = maybe(p);
    match c {
        x: File => try! x.read_to_str(),
        _ => "",
    }
}

pub fn is_owned(p: str) -> str {
    let v = maybe(p);
    if v is File { try! v.read_to_str() } else { "" }
}

pub async fn async_owned(p: str) -> str {
    let f = try! File::open(p);
    try! f.read_to_str()
}

fn main() {
    println("ok");
}

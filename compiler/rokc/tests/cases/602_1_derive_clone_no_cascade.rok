// A derive whose field lacks the trait reports that once; the
// generated impl's own errors (`no method clone`) are not repeated.
// expect-error: cannot derive `Clone` for `Holder`: `n` has type `NoClone`
// forbid-error: no method

struct NoClone { x: i32; }

#[derive(Clone)]
struct Holder { n: NoClone; }

fn main() {}

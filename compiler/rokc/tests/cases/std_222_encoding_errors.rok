// spec: std 222-encoding §2.22.3
// expect-exit: 0
// expect-stdout:
// hex: odd length 3; every byte takes two digits, so write "0f" rather than "f"
// hex: 'g' at byte 1 is not a hex digit; use 0-9, a-f or A-F
// hex: byte 0x20 at byte 2 is not a hex digit; use 0-9, a-f or A-F
// hex: byte 0xed at byte 0 is not a hex digit; use 0-9, a-f or A-F
// base64: '-' at byte 2 is url-safe base64; decode with url_safe: true
// base64: '+' at byte 0 is standard base64; decode with url_safe: false
// base64: '*' at byte 1 is not base64; use A-Z, a-z, 0-9, + and /
// base64: '.' at byte 3 is not base64; use A-Z, a-z, 0-9, - and _
// base64: byte 0x0a at byte 4 is not base64; use A-Z, a-z, 0-9, + and /
// base64: '=' at byte 1: '=' pads only the end of the text
// base64: '=' at byte 0: '=' pads only the end of the text
// base64: padded text must be a multiple of 4 characters long, not 3; fix the '=' count or drop the padding
// base64: padded text must be a multiple of 4 characters long, not 7; fix the '=' count or drop the padding
// base64: text is cut short at byte 4; a last group needs 2 to 4 characters
// base64: text is cut short at byte 0; a last group needs 2 to 4 characters
// ok [] [] [102]

// Every decode error names the offending byte offset and says what to
// write instead.
fn hex(s: str) {
    try { hex_decode(s); println("decoded"); } catch e { println(e.message()); }
}

fn b64(s: str, url_safe: bool) {
    try { base64_decode(s, url_safe: url_safe); println("decoded"); } catch e { println(e.message()); }
}

fn main() {
    hex("abc");
    hex("0g");
    hex("00 1");
    hex("한국");
    b64("ab-_", false);
    b64("+/+/", true);
    b64("a*bc", false);
    b64("abc.", true);
    b64("Zm9v\nYmFy", false);
    b64("a===", false);
    b64("====", false);
    b64("QQ=", false);
    b64("Zm9vYg=", false);
    b64("Zm9vY", false);
    b64("Q", false);
    let e: List<u8> = [];
    let ok = try! base64_decode(e);
    println(f"ok {ok:?} {try! hex_decode(e):?} {try! base64_decode("Zg", url_safe: true):?}");
}

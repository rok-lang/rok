// expect-exit: 0
// expect-stdout:
// 5
// 107
// 3
// 9
// 7
// 42
// 11

// Path calls reach impls, concrete and generic: `Tr::m(x)` (Self from
// the first argument, or the expected type), `Type::m(x)` through a
// generic trait impl, `T::f()` on a type parameter, `i32::add(..)`.

trait Show { fn show(self) -> i32; }
trait Origin { fn origin() -> Self; }
trait Num { fn num(self) -> i32; }

struct Box<T> { v: T; }
struct Meters { m: i32; }

impl<T> Show for Box<T> { fn show(self) -> i32 { return 5; } }
impl Show for Meters { fn show(self) -> i32 { return 100 + self.m; } }
impl Origin for i32 { fn origin() -> i32 { return 3; } }
impl Num for i32 { fn num(self) -> i32 { return self; } }
impl<T: Num> Show for [T; 2] { fn show(self) -> i32 { return self[0].num() + self[1].num(); } }

fn origin_of<T: Origin>() -> T { return T::origin(); }
fn shown<T: Show>(x: T) -> i32 { return T::show(x); }

fn main() -> i32 {
    let b: Box<bool> = Box { v: true };
    println(f"{Show::show(b)}");
    println(f"{Show::show(Meters { m: 7 })}");
    let z: i32 = Origin::origin();
    println(f"{z}");
    let pair: [i32; 2] = [4, 5];
    println(f"{Show::show(pair)}");
    println(f"{Box::show(Box { v: 1 }) + 2}");
    let o: i32 = origin_of() + 39;
    println(f"{o}");
    let small: [i32; 2] = [1, 2];
    println(f"{i32::add(shown(small), 8)}");
    return 0;
}


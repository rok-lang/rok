// spec: std 306-env §3.6.1
// expect-exit: 0
// expect-stdout:
// vars_os: true
// config: true
// cache: true
// data: true
// no home: true

// spec 3.6.1: `vars_os() -> VarsOs` (`(RawStr, RawStr)` pairs) and
// `config_dir` / `cache_dir` / `data_dir` (`Path | none`; XDG on Linux,
// `~/Library/..` on macOS - 3.6.6; an absolute XDG variable wins).
use rok::std::env;
use rok::std::path::Path;

fn under(p: Path | none, home: str) -> bool {
    match p {
        q: Path => q.as_str().starts_with(home) || q.as_str() == "/x/cfg" || q.as_str() == "/x/cache" || q.as_str() == "/x/data",
        none => false,
    }
}

fn main() {
    unsafe { try! env::set_var("ROK_PROBE_VARS_OS", "v1"); }
    let found = false;
    for (k, v) in env::vars_os() {
        if (try k.to_str() catch _ { "" }) == "ROK_PROBE_VARS_OS" && (try v.to_str() catch _ { "" }) == "v1" { found = true; }
    }
    println(f"vars_os: {found}");
    unsafe { try! env::set_var("HOME", "/tmp/rokhome"); }
    unsafe { try! env::set_var("XDG_CONFIG_HOME", "/x/cfg"); }
    unsafe { try! env::set_var("XDG_CACHE_HOME", "relative"); }
    unsafe { try! env::remove_var("XDG_DATA_HOME"); }
    println(f"config: {under(env::config_dir(), "/tmp/rokhome/")}");
    println(f"cache: {under(env::cache_dir(), "/tmp/rokhome/")}");
    println(f"data: {under(env::data_dir(), "/tmp/rokhome/")}");
    unsafe { try! env::remove_var("HOME"); }
    unsafe { try! env::remove_var("XDG_CACHE_HOME"); }
    println(f"no home: {env::cache_dir() is none}");
}
// only-os: macos linux

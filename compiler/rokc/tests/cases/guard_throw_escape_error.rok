// expect-error: 24:9: this throws a value out of the `Mutex`, and `g`'s `using` block releases the lock before the catcher uses it
// expect-error: help: the lock stops protecting it; build the error from a deep copy, `g.get_clone()`, or handle it inside the `using` block

// A `throw` inside `using` hands the error to a `catch` after the lock is
// released: an error holding what the lock protects would let the catcher
// change it unlocked, so it is an error, as `return` is.

struct Leak { xs: List<i64> }

impl Display for Leak {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("leak") }
}

impl Debug for Leak {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("leak") }
}

impl Error for Leak {}

static M: Mutex<List<i64>> = Mutex::new([]);

fn grab() throws (Leak) -> i64 {
    using g = M.lock() {
        throw Leak { xs: g.get() };
    }
    0
}

// A deep copy is the error's own.
fn copied() throws (Leak) -> i64 {
    using g = M.lock() {
        throw Leak { xs: g.get_clone() };
    }
    0
}

fn main() {
    try { let _ = grab(); } catch e: Leak { e.xs.push(1); }
    try { let _ = copied(); } catch e: Leak { e.xs.push(1); }
}

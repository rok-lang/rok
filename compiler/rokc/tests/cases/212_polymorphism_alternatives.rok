// expect-exit: 0
// expect-stdout:
// i32:32 f32:1.5
// <7> <x>
// 3.14 4
// no config: missing

trait Shape { fn area(self) -> f64; }

struct Circle { r: f64; }
struct Square { side: f64; }

impl Shape for Circle { fn area(self) -> f64 { 3.14 * self.r * self.r } }
impl Shape for Square { fn area(self) -> f64 { self.side * self.side } }

#[derive(Debug)]
struct Missing {}

impl Display for Missing {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("missing") }
}

impl Error for Missing {}

struct ConfigError { msg: str; cause: any Error | none; }

// 1. A closed set: a sum type.
fn process(x: i32 | f32) -> str {
    match x {
        n: i32 => f"i32:{n}",
        v: f32 => f"f32:{v}",
    }
}

// 2. An open set: generics (bounds and `where` name traits).
fn wrap<T: Display>(x: T) -> str { f"<{x}>" }

fn g<T>(x: T) -> T where T: Ord, T: Clone { x }

// 3. Mixed at run time: `any Trait`.
fn report(e: any Error) -> str { f"{e}" }

fn main() {
    println(f"{process(32)} {process(1.5f32)}");
    println(f"{wrap(g(7))} {wrap("x")}");
    let shapes: List<any Shape> = [Circle { r: 1.0 }, Square { side: 2.0 }];
    let areas = "";
    for s in shapes {
        areas = areas + f"{s.area()} ";
    }
    println(areas.trim());
    let e = ConfigError { msg: "no config", cause: Missing {} };
    match e.cause {
        none => println(e.msg),
        c: any Error => println(f"{e.msg}: {report(c)}"),
    }
}

// expect-exit: 0
// expect-stdout: 2 1
// expect-warning: identifier `σ2` looks like `σ²`
// The confusable check covers the whole package - `σ²` here
// and `σ2` in `calc.rok` warn though no one file has both.
mod calc;

fn σ²(x: i32) -> i32 { x * x }

fn main() {
    println(f"{calc::two()} {σ²(1)}");
}

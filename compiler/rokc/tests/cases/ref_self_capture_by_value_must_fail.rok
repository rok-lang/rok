// expect-error: 11:18: `[ref self]` needs a `ref self` method

// `[ref self]` shares the caller's receiver slot; a by-value `self` has
// none to write back to.

struct Acc { total: i32; }

impl Acc {
    fn add(ref self, x: i32) { self.total += x; }

    fn add_later(self) -> fn(i32) {
        return [ref self] |x: i32| { self.add(x); };
    }
}

fn main() {
    let a = Acc { total: 0 };
    let f = a.add_later();
    f(1);
}

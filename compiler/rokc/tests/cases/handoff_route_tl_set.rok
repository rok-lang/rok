// needs: threads
// expect-error: `a` can't be sent through a channel: other code reaches it through (a thread-local or a `Sync` object), so it would be used from two threads
// A list stored into a thread-local, then sent.
use rok::std::thread;
static TL: thread::ThreadLocal<List<i32>> = thread::local(|| { let l: List<i32> = []; l });
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let a: List<i32> = [];
    TL.set(a);
    try! tx.send(a);
    for i in 0..200000 { TL.with(|l| l.push(i)); }
    let _ = try! t.join();
    println(f"len {TL.with(|l| l.len())}");
}

// expect-error: error[E202]: `tx` was moved at line 14, and is used here
// expect-error: affine_move_then_use_error.rok:15:10: `tx` was moved at line 14, and is used here
// expect-error: help: a `Sender<i32>` has one owner, and `tx` gave it away; use the new owner, or keep a copy with `.clone()` before it moves
// expect-error: affine_move_then_use_error.rok:26:5: `a` may have been moved at line 23, and is used here
// spec: std 213-marker §2.13.4

// A `Drop` resource has one owner: `let b = a` moves it, and `a` is gone.

use rok::core::channel::channel;
use rok::bare::alloc::Allocation;

fn moved_sender() {
    let (tx, rx) = channel::<i32>();
    let other = tx;
    try! tx.send(1);
    try! other.send(2);
    println(f"{rx.recv() ?? 0}");
}

fn moved_on_one_path(c: bool) -> usize {
    let a = try! Allocation::<u8>::new(4);
    if c {
        let b = a;
        println(f"{b.len()}");
    }
    a.len()
}

fn main() {
    moved_sender();
    println(f"{moved_on_one_path(true)}");
}

// expect-error: 10:9: `inner::private_fn` is private but re-exported as `pub`
// expect-error: 11:9: `inner::Shared` is `pub(pkg)` but re-exported as `pub`

// A named re-export can't reach further than its item.
mod inner {
    fn private_fn() -> i32 { 1 }
    pub(pkg) struct Shared { pub v: i32; }
    pub fn open() -> i32 { 2 }
}
pub use inner::private_fn;
pub use inner::Shared;
pub use inner::open;

fn main() {
    println(f"{open()}");
}

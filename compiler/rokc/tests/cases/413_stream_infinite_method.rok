// expect-exit: 0
// expect-stdout:
// break 1 2 4 8
// take 3 6 9

// An infinite stream ends through `break` or `take(n)`;
// `async yield fn` as a method.
async yield fn doubling() -> i32 {
    let v = 1;
    loop {
        yield v;
        await task::yield_now();
        v = v * 2;
    }
}

struct Mult {
    k: i32;
}

impl Mult {
    async yield fn multiples(self) -> i32 {
        let i = 1;
        loop {
            await task::yield_now();
            yield self.k * i;
            i = i + 1;
        }
    }
}

async fn main() {
    let s = "break";
    for await v in doubling() {
        if v > 8 { break; }
        s = s + f" {v}";
    }
    println(s);
    let m = Mult { k: 3 };
    let xs = await m.multiples().take(3).collect();
    println(f"take {xs[0]} {xs[1]} {xs[2]}");
}

// expect-exit: 0
// expect-stdout:
// 3 [1, 22, 333]
// 12 15

// A nested function is called like a module-level one, can be
// passed by name, and serves as a stateless helper of its outer
// function; a closure is the stateful choice.
fn apply(f: fn(i32) -> i32, x: i32) -> i32 { f(x) }

fn parse(input: str) -> List<i32> {
    fn parse_num(s: str) -> i32 {
        try! s.trim().parse::<i32>()
    }
    fn parse_stmt(s: str) -> i32 {
        parse_num(s)
    }
    let result: List<i32> = [];
    for part in input.split(";") {
        result.push(parse_stmt(part));
    }
    result
}

fn compute(x: i32) -> str {
    fn triple(n: i32) -> i32 { n * 3 }
    let base = 5;
    let add_base = |n: i32| n + base;
    f"{apply(triple, x)} {apply(add_base, 10)}"
}

let xs = parse("1; 22 ;333");
println(f"{xs.len()} {xs:?}");
println(compute(4));

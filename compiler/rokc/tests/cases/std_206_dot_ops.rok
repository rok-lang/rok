// expect-exit: 0
// expect-stdout:
// [5, 7, 9] [-3, -3, -3] [4, 10, 18] [0, 0, 0] [1, 2, 3] [1, 2, 3]
// [true, false, true] [false, true, false] [false, true, false] [true, false, true] [true, true, true] [true, false, true]
// lhs rhs [true, false] [true, true] true
// [0, 0, 1] [5, 6, 7] [5, 7, 6] [2, 4, 6] [0, 2, 1]
// [11, 12, 13] [2, 4, 6] [true, false, false] [1, 2, 0]

// The 19 dot operators on `List` element-wise
// (comparisons too), `.&&` / `.||` evaluate both operands, and a
// scalar operand applies to every element.
fn side(tag: str, v: List<bool>) -> List<bool> {
    print(f"{tag} ");
    v
}

fn main() {
    let a = [1, 2, 3];
    let b = [4, 5, 6];
    println(f"{a .+ b:?} {a .- b:?} {a .* b:?} {a ./ b:?} {a .% b:?} {a .%% b:?}");
    let c = [1, 5, 3];
    println(f"{a .== c:?} {a .!= c:?} {a .< c:?} {a .> [0, 9, 2]:?} {a .<= c:?} {a .>= c:?}");
    let t = [true, false];
    let u = [false, true];
    let and = side("lhs", [false, false]) .&& side("rhs", [true, true]);
    print(f"{t .&& [true, true]:?} {t .|| u:?} ");
    println(f"{and == [false, false]}");
    println(f"{a .& [4, 4, 1]:?} {[4, 4, 4] .| a:?} {[4, 5, 5] .^ a:?} {a .<< [1, 1, 1]:?} {a .>> [1, 0, 1]:?}");
    println(f"{a .+ 10:?} {a .* 2:?} {a .< 2:?} {a .% 3:?}");
}

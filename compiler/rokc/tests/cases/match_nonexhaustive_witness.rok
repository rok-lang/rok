// expect-error: non-exhaustive match on `(bool, Shape)`: `(false, Shape::Dot)` not covered

// Every top-level case appears, so the error names a nested
// value no arm matches.
enum Shape { Dot, Line(i32) }

fn f(p: (bool, Shape)) -> i32 {
    return match p {
        (true, _) => 1,
        (false, Shape::Line(n)) => n,
    };
}
fn main() -> i32 {
    return f((true, Shape::Dot));
}


// spec: std 307-process §3.7.1 §3.7.2
// only-os: macos linux
// needs: process
// expect-exit: 0
// expect-stdout:
// file runs leak: 0
// file: [run 29]
// failed spawn leak: 0 NotFound
// rerun: InvalidInput
// rerun leak: 0
// taken: [PIPED]
// taken again: true true
// taken leak: 0
// left in child leak: 0
// output leak: 0

// A `File` moved into `Stdio::File` belongs to the command: running it
// closes the parent's copy, on success and on failure alike. A child's
// pipes are taken with `take_stdin` / `take_stdout` / `take_stderr`;
// the ones never taken close with the `Child`.
use rok::core::io::{IoError, IoErrorKind};
use rok::std::env;
use rok::std::fs;
use rok::std::fs::File;
use rok::std::path::Path;
use rok::std::process::{Command, Stdio};

fn open_fds() throws (IoError) -> usize {
    let n = 0usize;
    using rd = try fs::read_dir("/dev/fd") {
        try for _ in rd { n += 1; }
    }
    n
}

fn sh(script: str) -> Command {
    Command::new(Path::new("/bin/sh")).args(["-c", script])
}

fn main() throws (IoError) {
    let out = env::temp_dir() / "rok_stdio_ownership.txt";

    let before = try open_fds();
    for i in 0..30 {
        let f = try File::create(out);
        let st = try sh(f"echo run {i}").stdout(Stdio::File(f)).status();
        if !st.success() { panic("sh failed"); }
    }
    println(f"file runs leak: {(try open_fds()) - before}");
    println(f"file: [{(try fs::read_to_str(out)).trim()}]");

    before = try open_fds();
    let kind = IoErrorKind::Other;
    for _ in 0..10 {
        let f = try File::open(out);
        try Command::new("no-such-program-rok").stdin(Stdio::File(f)).spawn() catch e {
            kind = e.kind();
            continue;
        };
        panic("spawned a missing program");
    }
    println(f"failed spawn leak: {(try open_fds()) - before} {kind:?}");

    before = try open_fds();
    let f = try File::open(out);
    let cmd = sh("cat >/dev/null").stdin(Stdio::File(f));
    _ = try cmd.status();
    try cmd.status() catch e { println(f"rerun: {e.kind():?}"); };
    println(f"rerun leak: {(try open_fds()) - before}");

    before = try open_fds();
    let text = "";
    for _ in 0..20 {
        let child = try Command::new("tr").args(["a-z", "A-Z"])
            .stdin(Stdio::Piped).stdout(Stdio::Piped).spawn();
        let si = child.take_stdin() ?? panic("stdin not piped");
        try si.write_all("piped");
        try si.close();
        let so = child.take_stdout() ?? panic("stdout not piped");
        text = try so.read_to_str();
        try so.close();
        if !(try child.wait()).success() { panic("tr failed"); }
    }
    println(f"taken: [{text}]");
    let child = try sh("exit 0").stdout(Stdio::Piped).spawn();
    println(f"taken again: {child.take_stdin() is none} {child.take_stderr() is none}");
    let so = child.take_stdout() ?? panic("stdout not piped");
    try so.close();
    _ = try child.wait();
    println(f"taken leak: {(try open_fds()) - before}");

    before = try open_fds();
    for _ in 0..20 {
        let child = try sh("echo left").stdin(Stdio::Piped).stdout(Stdio::Piped).stderr(Stdio::Piped).spawn();
        _ = try child.wait();
    }
    println(f"left in child leak: {(try open_fds()) - before}");

    before = try open_fds();
    for _ in 0..20 {
        _ = try sh("echo out; echo err >&2").output();
    }
    println(f"output leak: {(try open_fds()) - before}");
    try fs::remove_file(out);
}

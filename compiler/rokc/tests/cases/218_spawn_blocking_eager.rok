// expect-exit: 0
// expect-stdout:
// ran before await true
// result 55

// `spawn_blocking`: `f` starts on the call, not at the first
// poll, and the future completes with its result.
fn sum_to(n: i32, started: Atomic<i32>) -> i32 {
    started.store(1);
    let s = 0;
    let i = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    s
}

async fn main() {
    let started = Atomic::new(0);
    let b = task::spawn_blocking(|| sum_to(10, started));
    while started.load() == 0 {
        await task::yield_now();
    }
    println(f"ran before await {started.load() == 1}");
    println(f"result {await b}");
}

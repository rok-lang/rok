// expect-exit: 0
// expect-stdout:
// main has an id: true
// outside: none
// matches Task::id: true
// distinct: 100
// nested par keeps the outer id: true

// `TaskId`: `task::id()` inside a task, `Task::id()` on its handle; ids
// are unique; `current_id` is `none` outside any task.

let seen: Set<task::TaskId> = Set::new();
let main_id = task::id();
println(f"main has an id: {main_id.as_u64() > 0}");
let blocking = await task::spawn_blocking(|| task::current_id() is none);
println(f"outside: {if blocking { "none" } else { "some" }}");

let tasks: List<Task<task::TaskId>> = List::new();
for i in 0..100 {
    tasks.push(task::spawn(async {
        await task::yield_now();
        task::id()
    }));
}
let all = true;
for t in tasks {
    let id = await t;
    if id != t.id() { all = false; }
    seen.insert(id);
}
println(f"matches Task::id: {all}");
println(f"distinct: {seen.len()}");
// `par` runs other tasks on this worker while it waits: the id after it
// is this task's again.
par::for_each(0..64, |x: i32| { });
println(f"nested par keeps the outer id: {task::id() == main_id}");

// spec: 004.12-async

// needs: net
// expect-exit: 0
// expect-stdout:
// client 0: resumed false, early accepted false, reply ok
// client 1: resumed true, early accepted true, reply ok
// client 2: resumed true, early accepted true, reply ok
// server: resumed false, early 0 bytes, got GET /async
// server: resumed true, early 10 bytes, got GET /async
// server: resumed true, early 10 bytes, got GET /async

// TLS resumption and 0-RTT through the async handshakes.
use rok::std::net::{TcpListener, SocketAddr};
use rok::std::net;
use rok::std::net::tls::{Client, Server, ClientConfig, ServerConfig, Certificate, PrivateKey};

const CA: str = "-----BEGIN CERTIFICATE-----
MIIBcjCCARigAwIBAgIUesSSl98urNjXdIg9ZEchaXosKn8wCgYIKoZIzj0EAwIw
FjEUMBIGA1UEAwwLcm9rIHRsczMgQ0EwIBcNMjYxMDE2MTY0NTI4WhgPMjEyNjA5
MjIxNjQ1MjhaMBYxFDASBgNVBAMMC3JvayB0bHMzIENBMFkwEwYHKoZIzj0CAQYI
KoZIzj0DAQcDQgAE4kV13G3nP06aBCX+u52Cuqk/R76W72DWLp1Lcfa7koO1hNfw
+10uBWWyPK4V60HuuPfxt7/JVLSKFadc3CQ7/KNCMEAwDwYDVR0TAQH/BAUwAwEB
/zAOBgNVHQ8BAf8EBAMCAQYwHQYDVR0OBBYEFPrNL2ff/ZhYdliVjlRBjXA7GCYA
MAoGCCqGSM49BAMCA0gAMEUCIQDG06e7A0VHI6ZAtQtQq28OOx1+iPizhjQAysBD
StWbYwIgS8FQ2a42r2yQGSPJtGddwkuhvTCs7eF3Cy1mpiSrCPc=
-----END CERTIFICATE-----
";
const LEAF: str = "-----BEGIN CERTIFICATE-----
MIIBuDCCAV6gAwIBAgIUNVBLVY9ZRZowYSKfPQfz7lmyco0wCgYIKoZIzj0EAwIw
FjEUMBIGA1UEAwwLcm9rIHRsczMgQ0EwIBcNMjYxMDE2MTY0NTI4WhgPMjEyNjA5
MjIxNjQ1MjhaMA4xDDAKBgNVBAMMA3NydjBZMBMGByqGSM49AgEGCCqGSM49AwEH
A0IABHm5n0+SWVTWbZ55MH0XSUNYxg+m1jgAdoYS25h8KzufL+QbzhTIqJLvDJi1
fncoKPluNud5yAE0IUMIJRJqve6jgY8wgYwwCQYDVR0TBAIwADAOBgNVHQ8BAf8E
BAMCB4AwEwYDVR0lBAwwCgYIKwYBBQUHAwEwGgYDVR0RBBMwEYIJbG9jYWxob3N0
hwR/AAABMB0GA1UdDgQWBBRrjj4b9HL+ckorpa4lMsfgs0dQyjAfBgNVHSMEGDAW
gBT6zS9n3/2YWHZYlY5UQY1wOxgmADAKBggqhkjOPQQDAgNIADBFAiAk4UEvAjbM
vnEoh4A8FgiBFfwDv6/OxYhtBLRLFbcskAIhAMorR5WRpyGXXY43jvoJoiKMV4hQ

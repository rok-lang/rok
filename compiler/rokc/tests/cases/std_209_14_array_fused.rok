// expect-exit: 0
// expect-stdout:
// [12.0, 44.0, 96.0]
// [[101.0, 202.0], [103.0, 204.0]] [[0.0, 1.0], [1.0, 2.0]]
// [[2.0, 6.0], [4.0, 8.0]] [[false, false], [true, true]]
// [2.0, 2.414213562373095, 2.732050807568877]
// [[101.0, 202.0], [103.0, 204.0]]
// [[0.0, 202.0], [0.0, 204.0]]
// [4.0, 3.0, 2.0, 1.0] [8.0, 6.0, 4.0, 2.0] [8.0, 6.0, 8.0, 6.0]
// [1.0, 1.0, 5.0, 7.0]
// [1.0, 0.0, NaN] [1.0, 8.0, NaN] [5, 2]

// A dot expression over arrays runs as one loop (no array per
// operator), operands of lower rank and axes of length 1 stretched;
// `.=` / `.+=` .. write into the target, views included, reading a
// copy of a source that overlaps the elements written.
use rok::core::array::Array;

fn main() {
    let a: Array<f64, 1> = [1.0, 2.0, 3.0];
    let x: Array<f64, 1> = [10.0, 20.0, 30.0];
    println(f"{a .* x .+ a .* 2.0:?}");
    let m: Array<f64, 2> = [[1.0, 2.0], [3.0, 4.0]];
    let row: Array<f64, 1> = [100.0, 200.0];
    let col: Array<f64, 2> = [[1.0], [2.0]];
    println(f"{m .+ row:?} {m .- col:?}");
    println(f"{m.t() .* 2.0:?} {m .> 2.0:?}");
    println(f"{f64::sqrt.(a) .+ 1.0:?}");
    m .+= row;
    println(f"{m:?}");
    m[:, 0] .= 0.0;
    println(f"{m:?}");
    let v: Array<f64, 1> = [1.0, 2.0, 3.0, 4.0];
    v .= v[::-1];
    let r = v.copy();
    v .*= 2.0;
    let w = v.copy();
    w[2:] .= w[:2];
    println(f"{r:?} {v:?} {w:?}");
    let s: Array<f64, 1> = [1.0, 3.0, 5.0, 7.0];
    s[:2] .= s[::4];
    println(f"{s:?}");
    // `.??` fills `none` only; NaN is a value.
    let o: Array<f64 | none, 1> = Array::from_list([1.0, none, f64::NAN], [3]);
    let d: Array<f64, 1> = [7.0, 8.0, 9.0];
    let l: List<i32 | none> = [none, 2];
    println(f"{o .?? 0.0:?} {o .?? d:?} {l .?? [5, 6]:?}");
}

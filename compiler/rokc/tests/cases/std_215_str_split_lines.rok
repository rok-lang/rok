// expect-exit: 0
// expect-stdout:
// split: [a] [] [b]
// lines: [x] [y] [z]
// ws: [p] [q] [r]
// find 1 rfind 4 miss none
// 14 10 세계
// trim [a b] start [a b ] end [ a b]

// `split` keeps empty pieces ("a,,b" -> "a", "", "b");
// `lines` drops a trailing `\r` and does not yield a final empty line;
// `find` / `rfind` return byte offsets or none: `len` is in
// bytes, `chars().count()` in scalars, `s[7:13]` slices on byte offsets.
fn show(v: usize | none) -> str {
    match v { x: usize => f"{x}", none => "none" }
}

fn main() {
    let out = "split:";
    for p in "a,,b".split(",") { out = out + " [" + p + "]"; }
    println(out);
    out = "lines:";
    for l in "x\r\ny\nz\n".lines() { out = out + " [" + l + "]"; }
    println(out);
    out = "ws:";
    for w in "  p \t q\nr  ".split_whitespace() { out = out + " [" + w + "]"; }
    println(out);
    println(f"find {show("abcab".find("b"))} rfind {show("abcab".rfind("b"))} miss {show("abc".find("z"))}");
    let s = "hello, 세계!";
    println(f"{s.len()} {s.chars().count()} {s[7:13]}");
    let t = " a b ";
    println(f"trim [{t.trim()}] start [{t.trim_start()}] end [{t.trim_end()}]");
}

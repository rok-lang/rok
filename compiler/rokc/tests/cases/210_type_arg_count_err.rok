struct S<T> { a: T; }
enum E<T> { A(T), B }
struct D<T, U = i32> { a: T; b: U; }
struct P<T, U> { a: T; b: U; }
type Al<T> = S<T>;
union U<T> { a: T; b: u64; }

fn main() -> i32 {
    let s = S::<i32, i32> { a: 1 };
    let t: S<i32, bool> = S { a: 1 };
    let f: E<i32, i32> = E::B;
    let e = E::<i32, u8, u8>::A(1);
    let d: D<i32, i32, i32> = D { a: 1, b: 2 };
    let p = P::<i64> { a: 1, b: 2u8 };
    let q: P<i64> = P { a: 1, b: 2 };
    let al: Al<i32, i32> = S { a: 2 };
    let u: U<i32, i32> = U { a: 1 };
    // The misfit types above add no errors where they are used.
    s.a + t.a + d.a + d.b + q.b + p.a as i32 + al.a
}

trait Tr<R = i32> { fn f(self) -> R; }
fn g<T: Tr<i32, i64>>(x: T) {}

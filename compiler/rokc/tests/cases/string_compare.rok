// expect-exit: 12
// expect-stdout:
// true false true false

extern "C" {
    fn strcmp(a: str, b: str) -> i32;
}

fn equal(a: str, b: str) -> bool {
    return unsafe { strcmp(a, b) } == 0;
}

fn main() -> i32 {
    println(f"{equal("hello", "hello")} {equal("foo", "bar")} {equal("rok", "rok")} {equal("rok", "ro")}");
    let total = 0;
    if equal("hello", "hello") {
        total += 5;
    }
    if equal("foo", "bar") {
        total += 100;
    }
    if equal("rok", "rok") {
        total += 7;
    }
    return total;
}


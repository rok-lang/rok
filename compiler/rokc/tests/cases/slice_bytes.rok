// needs: fs
// expect-exit: 0
// expect-stdout:
// bytes 5 [104, 101, 108, 108, 111] el
// wrote 3 [ell|lo]
use rok::std::fs;
use rok::std::env;
use rok::core::io::IoError;

// `Slice<u8>` as a byte view: `str::as_bytes`, `str::from_utf8`, and the
// `AsBytes` write paths.
fn main() throws (IoError) {
    let b = "hello".as_bytes();
    println(f"bytes {b.len()} {b:?} {try! str::from_utf8(b[1:3])}");
    let p = env::temp_dir() / "rok_slice_bytes.txt";
    let f = try fs::create(p);
    let buf: List<u8> = "hello".as_bytes().to_list();
    let n = try f.write(buf[1:4]);
    try f.write_all("|");
    try f.write_all(b[3:]);
    try f.close();
    println(f"wrote {n} [{try fs::read_to_str(p)}]");
    try fs::remove_file(p);
}

// spec: 003.06-indexing-and-slicing
// spec: std §2.9.7

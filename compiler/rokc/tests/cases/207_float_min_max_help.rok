// expect-error: 11:13: type `f64` does not satisfy trait bound `Ord` required by `min`
// expect-error: help: floats are not `Ord`, since NaN has no order; fold with the float method: `.reduce(|a, b| a.max(b))`
// expect-error: help: floats are not `Ord`, since NaN has no order; fold with the float method: `.reduce(|a, b| a.min(b))`

// `Iterator::max` / `min` need `Ord`, which floats lack; the help names
// the form that works.
fn main() {
    let xs: List<f64> = [1.5, 2.5];
    let m = xs.iter().max();
    let n = xs.iter().min();
}

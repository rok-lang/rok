// spec: §6.2.7 §6.2.14
// rokc-arg: --extern ddep=tests/cases/lint_deprecated_dependency/ddep
// expect-exit: 0
// expect-lint: 22:13 use of deprecated method `Cell::get`
// expect-lint: 26:33 use of deprecated function `old`
// expect-lint: 29:13 use of deprecated method `Conf::new`
// expect-lint: 30:13 `from_raw` will need `unsafe` in a later release: wrap the call in `unsafe { .. }`
// expect-lint: 33:16 use of deprecated field `Conf.lvl`
// expect-lint: 33:32 use of deprecated constant `MAX`
// expect-warning: = note: `x` must point at a live value
// forbid-warning: lib.rok
// expect-stdout: 1 3 4 9 7 2

// A dependency's marks reach this package's uses: its methods, fields,
// constants and generic methods, in a generic body too, even one no
// call instantiates. A `#[deprecated_safe]` call warns outside `unsafe`
// only. The dependency's own uses do not warn here.
use ddep::Cell;
use ddep::Conf;

fn unwrap<T>(c: Cell<T>) -> T {
    let v = c.get();
    v
}

pub fn never<T>(_x: T) -> i32 { ddep::old() }

fn main() {
    let c = Conf::new();
    let a = ddep::from_raw(3);
    let b = unsafe { ddep::from_raw(4) };
    let n = unwrap(Cell { v: 7 });
    println(f"{c.lvl} {a} {b} {ddep::MAX} {n} {ddep::uses_old()}");
}

// rokc-arg: --cfg feature=fast --cfg on
// only-os: macos linux windows
// expect-exit: 0
// expect-stdout:
// P { x: 1 }
// true false true true
// 3

// `#[cfg_attr]` applies its attributes when the predicate holds (before
// derive expansion); `cfg!` is a const `bool`.

#[cfg_attr(feature = "fast", derive(Debug), derive(Clone))]
#[cfg_attr(feature = "slow", derive(Hash))]
struct P { x: i32; }

#[cfg_attr(not(on), cfg(any()))]
fn kept() -> i32 { return 3; }

#[cfg_attr(on, cfg(any()))]
fn dropped() -> i32 { return 4; }

fn dropped() -> i32 { return 0; }

const FAST: bool = cfg!(feature = "fast");

fn main() -> i32 {
    let p = P { x: 1 };
    println(f"{p.clone():?}");
    let unix = cfg!(any(target_family = "unix", target_family = "windows"));
    println(f"{FAST} {cfg!(feature = "slow")} {cfg!(all(on, not(off)))} {unix}");
    println(f"{kept() + dropped()}");
    return 0;
}

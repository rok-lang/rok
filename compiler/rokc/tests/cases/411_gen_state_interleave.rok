// expect-exit: 0
// expect-stdout:
// a0 b100 a1 b101 a2 b102
// evens 2 4 6

// Each generator keeps its own locals and position between
// `next()` calls, so two live generators interleave independently.
// `yield fn` as a method.
yield fn from(start: i32) -> i32 {
    let i = start;
    loop {
        yield i;
        i = i + 1;
    }
}

struct Bag { items: List<i32>; }
impl Bag {
    yield fn evens(self) -> i32 {
        for x in self.items {
            if x % 2 == 0 { yield x; }
        }
    }
}

fn main() -> i32 {
    let a = from(0);
    let b = from(100);
    let s = "";
    let k = 0;
    while k < 3 {
        let x = match a.next() { v: i32 => v, none => -1 };
        let y = match b.next() { v: i32 => v, none => -1 };
        if k > 0 { s = s + " "; }
        s = s + f"a{x} b{y}";
        k = k + 1;
    }
    println(s);

    let bag = Bag { items: [1, 2, 3, 4, 5, 6] };
    let e = "evens";
    for x in bag.evens() { e = e + f" {x}"; }
    println(e);
    return 0;
}

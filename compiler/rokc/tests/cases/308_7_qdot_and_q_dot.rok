// expect-exit: 0
// expect-stdout:
// 3 none
// 3 -1

// `?.` is one token (longest match), `? .` two: `p?.x` chains
// (`none` stays a value), while `p? .x` is `(p?).x`, whose `?` returns
// `none` from the function.
struct P { x: i32; }

fn chained(p: P | none) -> i32 | none { p?.x }

fn early(p: P | none) -> i32 | none {
    let v = p? .x;
    return v + 0;
}

fn main() {
    let a = chained(P { x: 3 });
    let b = chained(none);
    println(f"{a ?? 0} {if b is none { "none" } else { "some" }}");
    println(f"{early(P { x: 3 }) ?? 0} {early(none) ?? -1}");
}

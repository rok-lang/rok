// needs: threads
// expect-error: `W { l: l }` can't be sent through a channel: it is the value `with` lends to its closure (a `ThreadLocal`'s, a locked `Mutex`'s)
// A thread-local's value sent inside a struct.
use rok::std::thread;
static TL: thread::ThreadLocal<List<i32>> = thread::local(|| { let l: List<i32> = []; l });
struct W { l: List<i32>; }
fn main() {
    let (tx, rx) = channel::<W>();
    let t = thread::spawn(|| { if let w: W = rx.recv() { for i in 0..200000 { w.l.push(i); } } 0 });
    TL.with(|l| { try! tx.send(W { l: l }); });
    for i in 0..200000 { TL.with(|l| l.push(i)); }
    let _ = try! t.join();
    println(f"len {TL.with(|l| l.len())}");
}

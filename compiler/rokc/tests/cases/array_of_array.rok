// expect-exit: 21
// expect-stdout:
// 0: 1 2 3
// 1: 3 4 10
// 2: 5 6 21

fn main() -> i32 {
    let grid: [[i32; 2]; 3] = [
        [1, 2],
        [3, 4],
        [5, 6],
    ];
    let total = 0;
    let i = 0;
    while i < 3 {
        total += grid[i][0] + grid[i][1];
        println(f"{i}: {grid[i][0]} {grid[i][1]} {total}");
        i += 1;
    }
    return total;
}

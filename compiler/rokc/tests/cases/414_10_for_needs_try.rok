// spec: §4.14.10
// expect-error: 9:1: `next` of `TryGenIter<str, str>` can throw, so this loop must be `try for`

// Spec 4.14.10: a `for` over a throwing generator throws at each `next`,
// so it needs `try for`.
yield fn lines() throws (str) -> str { yield "a"; }

try for l in lines() { println(l); } catch _ { }
for l in lines() { println(l); }

// expect-exit: 0
// expect-stdout: Cfg named retry=3 verbose=true

// `@Self.name`, `@Self.is_named`, and
// `@field.has_default` / `@field.default` (the field's `= expr`).
trait Defaults {
    fn defaults() -> str;
}

#[impl_derive(Defaults)] @derive {
    impl Defaults for @Self {
        fn defaults() -> str {
            let s = @Self.name.as_str();
            @apply_if(@Self.is_named) { s = s + " named"; }
            @for_fields {
                @apply_if(@field.has_default) {
                    {
                        let v = @field.default;
                        s = s + f" {@field.name.as_str()}={v}";
                    }
                }
            }
            s
        }
    }
}

#[derive(Defaults)]
struct Cfg {
    retry: i32 = 3;
    name: str;
    verbose: bool = true;
}

fn main() -> i32 {
    println(Cfg::defaults());
    return 0;
}

// expect-exit: 7
// expect-stdout:

// Impl_block ::= "impl" generics? type_expr ("for" type_expr)? ...
// type_expr is any type, so a trait impl on a tuple type is legal.
trait Foo {
    fn foo(self) -> i32;
}

impl Foo for (i32, i32) {
    fn foo(self) -> i32 {
        return 7;
    }
}

fn main() -> i32 {
    let t = (1, 2);
    return t.foo();
}

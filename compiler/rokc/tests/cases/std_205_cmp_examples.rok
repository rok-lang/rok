// spec: std 205-cmp §2.5.1 §2.5.2 §2.5.5 §2.5.7 §2.5.9 §2.5.10
// expect-exit: 0
// expect-stdout:
// false false false false true
// true true false true true true
// eq 2 false
// 3 10 50 b 5
// true true true true true
// true true true Greater
// 1.2.3 1.10.0 2.0.0 true true
// zero one other small big

// Comparison rules: NaN, aliases, lexicographic and set order, derived `Ord`.
struct Money { cents: i64; }

impl PartialEq for Money {
    fn eq(self, rhs: Money) -> bool {
        EQS.fetch_add(1);
        self.cents == rhs.cents
    }
}

static EQS: Atomic<i32> = Atomic::new(0);

#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
struct Version { major: u32; minor: u32; patch: u32; }

impl Display for Version {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"{self.major}.{self.minor}.{self.patch}");
    }
}

fn kind(x: i32) -> str {
    match x {
        0 => "zero",
        1 => "one",
        2..=9 => "small",
        100.. => "big",
        _ => "other",
    }
}

fn main() {
    let a: f64 = 0.0 / 0.0;
    let b: f64 = 0.0 / 0.0;
    let n: i32 = 42;
    println(f"{a == b} {a < b} {a > b} {a <= b} {n == n}");
    let nan: f64 = f64::NAN;
    println(f"{5i32 == 5i32} {"hi" != "hello"} {nan == nan} {3 ≡ 3} {3 ≠ 4} {2 ≤ 2 && 3 ≥ 2}");
    let m1 = Money { cents: 5 };
    let m2 = Money { cents: 5 };
    let same = m1 == m2;
    let differ = m1 != m2;
    println(f"eq {EQS.load()} {differ}");
    println(f"{3i32.min(7i32)} {5.max(10)} {100.clamp(0, 50)} {"a".max("b")} {same as i32 * 5}");
    let xs: List<i32 | none> = [none, 3, 1];
    xs.sort();
    let d1 = {"a": 1, "b": 2};
    let d2 = {"b": 2, "a": 1};
    let s1 = {1, 2};
    let s2 = {2, 1};
    println(f"{[1, 2] < [1, 3]} {[1, 2] < [1, 2, 0]} {(1, "b") > (1, "a")} {d1 == d2} {s1 == s2}");
    println(f"{[1, 2, 3] == [1, 2, 3]} {xs[0] is none} {xs[1] == 1} {[2, 0].cmp([1, 9]):?}");
    let vs = [
        Version { major: 2, minor: 0, patch: 0 },
        Version { major: 1, minor: 10, patch: 0 },
        Version { major: 1, minor: 2, patch: 3 },
    ];
    vs.sort();
    let s: Set<Version> = Set::new();
    s.insert(Version { major: 1, minor: 2, patch: 3 });
    println(f"{vs[0]} {vs[1]} {vs[2]} {vs[2] > vs[1]} {s.contains(Version { major: 1, minor: 2, patch: 3 })}");
    println(f"{kind(0)} {kind(1)} {kind(-4)} {kind(5)} {kind(300)}");
}

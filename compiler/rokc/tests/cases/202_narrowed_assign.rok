// expect-exit: 0
// expect-stdout:
// 3
// 9
// 7 i32
// 3 x
// none 0 1
// kept none
// 8

// Assigning a `T` keeps `x is T`; another member ends it until paths join.
fn show(v: i32 | str) -> str {
    match v { n: i32 => f"{n} i32", s: str => f"{s} str" }
}

fn text(v: i32 | none) -> str {
    match v { n: i32 => f"{n}", none => "none" }
}

fn main() -> i32 {
    let end: usize | none = none;
    for i in 0usize..5 {
        if end is none && i == 3 { end = i; }
    }
    println(f"{end ?? 0}");
    let other: usize | none = none;
    if other is none {
        other = none;
        other = 9;
        let back: usize | none = other;
        println(f"{back ?? 0}");
    }
    let v: i32 | str = 1;
    if v is i32 {
        v = v + 6;
        println(show(v));
    }
    let a: any = 1;
    let n = 0;
    while a is i32 {
        n += a;
        if n > 1 { a = "x"; } else { a = a + 1; }
    }
    match a { s: str => println(f"{n} {s}"), _ => println("?") }
    // The loop head sees the value the last iteration stored.
    let x: i32 | none = none;
    let seen = "";
    if x is none {
        for i in 0..3 {
            seen = if seen == "" { text(x) } else { f"{seen} {text(x)}" };
            x = i;
        }
    }
    println(seen);
    // Only the branch that assigns ends the narrowing.
    let y: i32 | none = none;
    if y is none {
        let kept = "";
        if false { y = 1; } else { kept = if y is none { "kept" } else { "lost" }; }
        let joined: i32 | none = y;
        println(f"{kept} {text(joined)}");
    }
    let z: i32 | none = 3;
    if z is i32 {
        match z { 3 => { z = none; }, _ => {} }
        z = 8;
        println(text(z));
    }
    return 0;
}

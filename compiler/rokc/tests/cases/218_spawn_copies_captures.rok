// needs: threads
// gc-stress: 5
// `task::spawn` gives the task a frame of its own holding copies of what
// the future captured, through one hand-off: what the captures shared
// (one list twice, a list and a future over it) they still share. An
// awaited future (not spawned) still shares with its maker.
// expect-exit: 0
// expect-stdout:
// 20004 20002
// 4 5
// 3 3 3
// 2 2

async fn grow(xs: List<i32>) -> usize {
    for i in 0..20000 { xs.push(i); }
    await fill(xs);
    xs.len()
}

async fn fill(xs: List<i32>) { xs.push(-1); xs.push(-2); }

async fn sum_of(xs: List<i32>) -> i32 { let s = 0; for x in xs { s += x; } s }

async fn push3(xs: List<i32>) -> usize { xs.push(3); xs.len() }

async fn main() {
    let t = task::spawn(grow([1, 2]));
    let b: List<i32> = [7];
    let u = task::spawn(async { for i in 0..20001 { b.push(i); } b.len() });
    println(f"{await t} {await u}");

    let m: List<i32> = [1, 2];
    await fill(m);
    let n = m.len();
    let pair: List<List<i32>> = [m, m];
    let v = task::spawn(async { pair[0].push(9); pair[1].len() });
    println(f"{n} {await v}");

    // The block's list and the inner future's list are one copy.
    let l: List<i32> = [1, 2];
    let g = push3(l);
    let w = task::spawn(async { let k = await g; f"{k} {l.len()} {l[2]}" });
    println(await w);

    let futs = [sum_of([1, 1]), sum_of([2])];
    let ts: List<Task<i32>> = [];
    for f in futs { ts.push(task::spawn(f)); }
    println(f"{await ts[0]} {await ts[1]}");
}

// expect-exit: 12
// expect-stdout:
// 3 9

// A function name used as a value is a function pointer.
fn add1(x: i32) -> i32 { return x + 1; }
fn apply(f: fn(i32) -> i32, v: i32) -> i32 { return f(v); }

fn main() -> i32 {
    let f = add1;
    println(f"{f(2)} {apply(add1, 8)}");
    return f(2) + apply(add1, 8);   // 3 + 9
}

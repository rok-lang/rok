// expect-error: does not apply to `Pair<bool, i32>`: its bound needs `bool: Num`

// A generic impl applies only where its bounds hold -
// `bool` has no `Num`, so `Pair<bool, i32>` has no `Show`.
trait Num { fn num(self) -> i32; }
trait Show { fn show(self) -> i32; }
struct Pair<A, B> { a: A; b: B; }

impl Num for i32 { fn num(self) -> i32 { return self; } }
impl<A: Num, B: Num> Show for Pair<A, B> {
    fn show(self) -> i32 { return self.a.num() + self.b.num(); }
}

fn main() -> i32 {
    let p: Pair<bool, i32> = Pair { a: true, b: 1 };
    return p.show();
}

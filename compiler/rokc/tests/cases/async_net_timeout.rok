// needs: net
// expect-exit: 0
// expect-stdout:
// read: timed out
// cancelled: true
// registrations left: 0
// read in time: 2
// select: timed out

// Timeouts on async socket calls (`set_read_timeout` is for
// the blocking calls; the async ones go through `task::timeout`, or
// `task::select` with a `sleep`). After a timeout the read keeps going
// until cancelled.
use rok::std::net::{TcpListener, TcpStream, SocketAddr};

let any: SocketAddr = try! "127.0.0.1:0".parse::<SocketAddr>();
let listener = try! TcpListener::bind(any);
let client = try! TcpStream::connect(try! listener.local_addr());
let (server, _) = try! listener.accept();

// Each reader owns a descriptor of its own (`try_clone`).
let s1 = try! server.try_clone();
let read = task::spawn(async {
    let n = try await s1.read_async(List::filled(16, 0u8)) catch _ { 0 };
    try s1.close() catch _ {};
    n
});
let r = try await task::timeout(Duration::ms(20), read) catch _: task::TimeoutError { 999 };
println(f"read: {if r == 999 { "timed out" } else { "data" }}");
read.cancel();
let gone = try await read.join() catch _: task::CancellationError { 999 };
println(f"cancelled: {gone == 999}");
println(f"registrations left: {task::registrations()}");

let s2 = try! server.try_clone();
let read2 = task::spawn(async {
    let n = try await s2.read_async(List::filled(16, 0u8)) catch _ { 0 };
    try s2.close() catch _ {};
    n
});
try! client.write_all("hi");
let n = try await task::timeout(Duration::secs(10), read2) catch _: task::TimeoutError { 999 };
println(f"read in time: {n}");

let s3 = try! server.try_clone();
let (which, _) = await task::select([
    async {
        let n = try await s3.read_async(List::filled(16, 0u8)) catch _ { 0 };
        try s3.close() catch _ {};
        n
    },
    async { await task::sleep(Duration::ms(20)); 0 },
]);
println(f"select: {if which == 1 { "timed out" } else { "data" }}");
try! client.close();
try! server.close();
try! listener.close();


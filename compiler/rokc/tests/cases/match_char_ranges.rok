// expect-exit: 0
// expect-stdout:
// 1 2 3 4 5

// Range patterns over `char` (`'a'..='z'`); overlapping
// ranges that still leave values for later arms are reachable.
fn class(c: char) -> i32 {
    return match c {
        'a'..='f' => 1,
        'a'..='z' => 2,
        '0'..'5' => 3,
        '0'..='9' => 4,
        _ => 5,
    };
}
println(f"{class('b')} {class('x')} {class('3')} {class('7')} {class('!')}");


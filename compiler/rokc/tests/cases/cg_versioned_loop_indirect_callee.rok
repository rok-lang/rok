// A loop calling a function that calls a `fn` value keeps its bounds
// checks: the closure pops the list each iteration.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/cg_versioned_loop_indirect_callee.rok:16:14:
// expect-stderr: index 4 out of bounds for length 3
// expect-stdout:

fn run(f: fn()) {
    f();
}

fn sum(x: List<i64>, n: usize, f: fn()) -> i64 {
    let s: i64 = 0;
    for j in 0..n {
        run(f);
        s += x[j];
    }
    s
}

fn main() -> i32 {
    let x: List<i64> = [1, 2, 3, 4, 5, 6, 7, 8];
    println(f"{sum(x, 8, || { x.pop(); })}");
    return 0;
}

// An error must be caught or be in the enclosing fn's `throws`.
// expect-error: error `ParseError` is not handled

enum ParseError { Bad }

fn parse(s: i32) throws (ParseError) -> i32 {
    if s < 0 { throw ParseError::Bad; }
    return s;
}

fn no_throws(s: i32) -> i32 {
    return try parse(s);
}

fn main() -> i32 {
    return no_throws(1);
}

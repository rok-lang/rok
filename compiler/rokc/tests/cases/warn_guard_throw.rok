// expect-exit: 0
// expect-warning: this throws a value out of the `Mutex`, and `g`'s `using` block releases the lock before the catcher uses it
// expect-warning: help: the lock stops protecting it; build the error from a copy, `g.get().clone()`
// expect-warning: `#[warn(guard_escape)]` on by default
// spec: std 216-sync §2.16.3
// spec: §6.2.9
// expect-stdout: pushed outside the lock: guarded list len 1

// A `throw` inside `using` hands the error to a `catch` after the lock is
// released: an error holding what the lock protects lets the catcher
// change it unlocked (0.2.0: an error, as `return` is).

struct Leak { xs: List<i64> }

impl Display for Leak {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("leak") }
}

impl Debug for Leak {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("leak") }
}

impl Error for Leak {}

static M: Mutex<List<i64>> = Mutex::new([]);

fn grab() throws (Leak) -> i64 {
    using g = M.lock() {
        throw Leak { xs: g.get() };
    }
    0
}

fn main() {
    let xs: List<i64> = [];
    try { let _ = grab(); } catch e: Leak { xs = e.xs; }
    xs.push(1);
    let n = 0usize;
    using g = M.lock() { n = g.get().len(); }
    println(f"pushed outside the lock: guarded list len {n}");
}

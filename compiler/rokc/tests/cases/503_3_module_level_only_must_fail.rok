// spec: refs-lang §5.3.8 §5.4.10 §5.9.8
// expect-error: 13:5: a `mod` is declared only at module level, not in a function body
// expect-error: 17:5: an `extern` block is declared only at module level, not in a function body
// expect-error: 22:5: a `static` is declared only at module level, not in an `impl`; an associated `const` goes there

// `mod` and `extern` blocks are module-level items: one in a function
// body is an error. A `static` is not an `impl` item (an associated
// `const` is).
struct Counter { n: i32; }
static APP_NAME: str = "rok";

fn g() {
    mod inner { pub fn h() {} }
}

fn k() {
    extern "C" { fn abs(x: i32) -> i32; }
}

impl Counter {
    const ZERO: i32 = 0;
    static GLOBAL: i32 = 0;
}

fn main() { g(); k(); }

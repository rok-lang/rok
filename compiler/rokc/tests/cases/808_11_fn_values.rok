// expect-exit: 0
// expect-stdout:
// add 5 mul 6
// table 3 8
// captured 15 13

// A function is a value that can be stored and
// called through; a closure carries its captured environment with it.
fn add(a: i32, b: i32) -> i32 { a + b }
fn mul(a: i32, b: i32) -> i32 { a * b }

fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 { f(a, b) }

fn adder(n: i32) -> fn(i32) -> i32 {
    |x: i32| x + n
}

fn main() -> i32 {
    println(f"add {apply(add, 2, 3)} mul {apply(mul, 2, 3)}");
    let table: List<fn(i32, i32) -> i32> = [add, mul];
    println(f"table {table[0](1, 2)} {table[1](2, 4)}");
    let ten = adder(10);
    let eight = adder(8);
    println(f"captured {ten(5)} {eight(5)}");
    return 0;
}

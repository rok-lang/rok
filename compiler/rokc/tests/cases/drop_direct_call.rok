// expect-error: `Drop::drop` cannot be called directly
// `drop` runs where the owner releases the value (scope end or `using`).
struct File { fd: i32; }

impl Drop for File {
    fn drop(ref self) { println(f"{self.fd}"); }
}

fn main() -> i32 {
    let f = File { fd: 3 };
    f.drop();
    return 0;
}

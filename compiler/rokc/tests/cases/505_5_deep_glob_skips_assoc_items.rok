// spec: §5.5.5 §5.5.7 §5.7.1
// A deep glob reaches module items and enum variants, not a type's
// associated items: the implicit prelude import does not make
// `Duration::MAX` a bare `MAX`, and the help never offers to `use` one.
// expect-error: 15:16: cannot find value `MAX` in this scope
// expect-error: help: add `use geo::MAX;`
// expect-error: 16:16: cannot find value `EPSILON` in this scope
mod geo {
    pub const MAX: i32 = 7;
}
fn main() -> i32 {
    // Variants still come in through the same glob.
    let v: i32 | none = none;
    let r: Result<i32, str> = Ok(1);
    println(f"{MAX}");
    println(f"{EPSILON}");
    return 0;
}

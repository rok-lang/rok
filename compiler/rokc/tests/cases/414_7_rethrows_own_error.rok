// expect-error: error `E` is not covered: the enclosing function is `rethrows`
// expect-error: help: catch it here, or declare `throws (E)` instead of `rethrows`

// A `rethrows` function throws only what its function parameters throw.
struct E {}
impl Display for E { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("E") } }
impl Debug for E { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("E") } }
impl Error for E {}

fn apply(f: fn(i32) throws -> i32, x: i32) rethrows -> i32 {
    if x > 3 { throw E {}; }
    try f(x)
}

fn main() {}

// expect-exit: 12
// expect-stdout:
// 12 3

// `break 'outer` exits the outer loop directly from the inner loop.
fn main() -> i32 {
    let i = 0;
    let result = 'outer: loop {
        let j = 0;
        loop {
            if i == 3 && j == 4 {
                break 'outer i + j + 5;   // 3 + 4 + 5 = 12
            }
            if j == 9 { break; }
            j += 1;
        }
        i += 1;
    };
    println(f"{result} {i}");
    return result;
}

// expect-exit: 0
// expect-stdout:
// dot3 32
// dot2 11
// len 3 2 5

// A `const` generic parameter is fixed per instance; each
// array length gets its own specialization with N as a constant.
fn dot<const N: usize>(a: [i32; N], b: [i32; N]) -> i32 {
    let t = 0;
    let i = 0usize;
    while i < N {
        t += a[i] * b[i];
        i += 1usize;
    }
    t
}

fn len<const N: usize>(a: [u8; N]) -> usize { N }

fn main() -> i32 {
    println(f"dot3 {dot([1, 2, 3], [4, 5, 6])}");
    println(f"dot2 {dot([1, 2], [3, 4])}");
    println(f"len {len([1u8, 2u8, 3u8])} {len([0u8; 2])} {len([7u8; 5])}");
    return 0;
}

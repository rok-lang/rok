const KEY: str = "-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgcgH7+8UZOnSmYIn9
1ftUi+QOk+yiBJQf//N6N0MgirqhRANCAASlRTaxGpC5fl2aWOE4A94IQYOlLaZE
FaEpq/6UIdEL3wPK3Oj3v+97CWRf3SsIe8X0/ZpoW+ppyMMO58QOQHyV
-----END PRIVATE KEY-----
";

async fn connect(s: TcpStream, name: str, cfg: ClientConfig) -> str {
    let c = try await Client::with_config_async(s, name, cfg) catch e { return f"{e.kind():?} {e.message()}"; };
    try! c.close();
    "unexpected success"
}

fn data() -> List<u8> {
    let d: List<u8> = [];
    for i in 0..300000 { d.push((i % 251) as u8); }
    d
}

let any: SocketAddr = try! "127.0.0.1:0".parse::<SocketAddr>();
let l = try! TcpListener::bind(any);
let addr = try! l.local_addr();
let cfg = try! ServerConfig::new(try! Certificate::from_pem(CERT), try! PrivateKey::from_pem(KEY));
cfg.alpn_protocols = ["h2".as_bytes().to_list()];
let server = task::spawn_local(async {
    let (s, _) = try! await l.accept_async();
    let srv = try! await Server::new_async(s, cfg);
    let got = try! await srv.read_to_end_async();
    println(f"server got {got.len()} bytes, intact {got == data()}");
    try! await srv.write_all_async(got);
    try! await srv.close_notify_async();
    try! await srv.close_async();
    // The second client rejects the certificate.
    let (s2, _) = try! await l.accept_async();
    try! l.close();
    let srv2 = try await Server::new_async(s2, cfg) catch e { return f"{e.kind():?} {e.message()}"; };
    try! srv2.close();
    "unexpected success"
});
// Only the test CA: the host's trust store (`SSL_CERT_FILE` from cargo)
// may be out of a wasm sandbox's reach.
let ccfg = ClientConfig { root_certs: try! Certificate::from_pem(CA) };
ccfg.alpn_protocols = ["h2".as_bytes().to_list()];
let s = try! await net::tcp_connect_async(f"{addr}");
let c = try! await Client::with_config_async(s, "localhost", ccfg);
println(f"handshake: alpn {try! str::from_utf8(c.negotiated_alpn() ?? [])}, sni localhost");
try! await c.write_all_async(data()[0:100000]);
try! await c.key_update_async();
try! await c.write_all_async(data()[100000:300000]);
try! await c.close_notify_async();
let back = try! await c.read_to_end_async();
println(f"client got {back.len()} bytes back, intact {back == data()}");
try! await c.close_async();

let s2 = try! await net::tcp_connect_async(f"{addr}");
println(f"wrong name: {await connect(s2, "example.com", ccfg)}");
println(f"server saw: {await server}");

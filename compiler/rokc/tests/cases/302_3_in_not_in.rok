// expect-exit: 0
// expect-stdout:
// true true false true
// true false true true true true
// true false true
// in range
// 1
// 2
// true true
// true

// `in` / `!in` are `∈` / `∉`; every range kind answers them, and a
// range on the right needs no parentheses.
fn main() {
    let xs = [1, 2, 3];
    let s = {"a", "b"};
    let d = {"k": 1};
    println(f"{2 in xs} {7 !in xs} {"z" in s} {"k" in d}");
    let n = 5;
    println(f"{4 in 0..=4} {4 in 0..4} {9 in 3..} {4 in ..=4} {0 in ..} {n in 0..n + 1}");
    println(f"{3 ∈ (0..=3)} {3 ∉ (0..=3)} {"ell" in "hello"}");
    let i: usize = 2;
    if i in 0..xs.len() && 5 !in xs {
        println("in range");
    }
    for x in xs {
        if x in 1..3 {
            println(x);
        }
    }
    // `in` binds like `==`: tighter than `&&`, looser than `+`.
    let lo = 1;
    println(f"{lo + 1 in lo..lo + 2 && true} {lo !in [2, 3]}");
    let c = 'q';
    println(c in 'a'..='z');
}

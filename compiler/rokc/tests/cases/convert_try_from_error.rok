// only-os: macos linux
// (RawPath::from_bytes is unix-only, std 3.8.5)
// expect-exit: 0
// expect-stdout:
// default: negative
// even 4
// overflow: try_from: value out of range for `u8`
// path: invalid UTF-8 at byte 1
// path ok a/b
// generic 200 / OverflowError
// generic even: odd
// from str: odd length 3
// propagated OverflowError
// char: try_from: value out of range for `char`

// Stdlib spec 2.11.4: `TryFrom<U>` throws its associated `Error`, which
// defaults to `ConversionError`; the numeric impls say `OverflowError`,
// `Path` says `Utf8Error`. `try_into` throws the target's `Error`,
// and a generic fn can name it as `T::Error`.

use rok::std::path::{Path, RawPath};

struct Even { v: i64; }

// No `type Error`: the default `ConversionError`.
impl TryFrom<i64> for Even {
    fn try_from(value: i64) throws (Self::Error) -> Even {
        if value < 0 { throw ConversionError::new("negative"); }
        if value % 2 != 0 { throw ConversionError::new("odd"); }
        Even { v: value }
    }
}

// A second `TryFrom` with another `Error`: `T::Error` under the bound
// `TryFrom<i64>` (and `try_into` from `str`) picks the matching impl.
impl TryFrom<str> for Even {
    type Error = ValueError;
    fn try_from(value: str) throws (ValueError) -> Even {
        if value.len() % 2 != 0 { throw ValueError::new(f"odd length {value.len()}"); }
        Even { v: value.len() as i64 }
    }
}

fn conv<T: TryFrom<i64>>(x: i64) throws (T::Error) -> T { try T::try_from(x) }

fn narrow(x: i64) throws (OverflowError) -> u8 {
    let b: u8 = try x.try_into();
    b
}

fn main() {
    let e = try Even::try_from(-1) catch e: ConversionError {
        println(f"default: {e}");
        Even { v: 0 }
    };
    let four: i64 = 4;
    let f: Even = try four.try_into() catch _: ConversionError { Even { v: 0 } };
    println(f"even {f.v}");
    let b: u8 = try 300.try_into() catch e: OverflowError {
        println(f"overflow: {e}");
        0
    };

    let bad = RawPath::from_bytes([0x61u8, 0xffu8]);
    let p = try Path::try_from(bad) catch e: Utf8Error {
        println(f"path: {e}");
        Path::empty()
    };
    let ok: Path = try RawPath::from_bytes([0x61u8, 0x2fu8, 0x62u8]).try_into() catch _: Utf8Error {
        Path::empty()
    };
    println(f"path ok {ok.as_str()}");

    let g: u8 = try conv::<u8>(200) catch _: OverflowError { 0 };
    let h: u8 = try conv::<u8>(-1) catch _: OverflowError { 0 };
    println(f"generic {g} / OverflowError");
    let i = try conv::<Even>(3) catch e: ConversionError {
        println(f"generic even: {e}");
        Even { v: 0 }
    };
    let s: str = "abc";
    let j: Even = try s.try_into() catch e: ValueError {
        println(f"from str: {e}");
        Even { v: 0 }
    };
    try narrow(1000) catch e: OverflowError { println("propagated OverflowError"); 0 };
    let c = try char::try_from(0xD800 as u32) catch e: OverflowError {
        println(f"char: {e}");
        'x'
    };
    let _ = (e.v, b, p, h, i.v, j.v, c);
}
// spec: std §2.11.9

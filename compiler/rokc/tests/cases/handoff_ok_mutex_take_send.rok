// needs: threads
// expect-exit: 0
// expect-stdout:
// 1

// Take the list out of a Mutex (set a fresh one) and send it on.
use rok::std::thread;
static BUF: Mutex<List<i32>> = Mutex::new([]);
fn main() {
    using g = BUF.lock() { g.get().push(1); }
    let mine: List<i32> = [];
    using g = BUF.lock() { mine = g.get(); g.set([]); }
    let (tx, rx) = channel::<List<i32>>();
    let c = thread::spawn(|| { if let r: List<i32> = rx.recv() { r.len() } else { 0 as usize } });
    try! tx.send(mine);
    println(f"{try! c.join()}");
}

// expect-exit: 6
// expect-stdout:
// 1 2 3 4 5

fn main() -> i32 {
    let xs: [i32; 5] = [4, 1, 3, 5, 2];
    let n = 5;
    let i = 0;
    while i < n - 1 {
        let j = 0;
        while j < n - 1 - i {
            if xs[j] > xs[j + 1] {
                let tmp = xs[j];
                xs[j] = xs[j + 1];
                xs[j + 1] = tmp;
            }
            j += 1;
        }
        i += 1;
    }
    println(f"{xs[0]} {xs[1]} {xs[2]} {xs[3]} {xs[4]}");
    return xs[0] + xs[1] + xs[2];
}

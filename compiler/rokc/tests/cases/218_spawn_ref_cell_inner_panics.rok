// needs: threads
// A `[ref x]` cell reached through a future the spawned block captured
// stays shared with the code that made it: the spawn stops.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/218_spawn_ref_cell_inner_panics.rok:13:13:
// expect-stderr: a future with a `[ref x]` capture cannot go to another task or thread: the code that made it shares the cell; capture a value, or share it through a `Mutex`
// expect-stdout:

async fn main() {
    let n = 0;
    let h = async [ref n] || { n += 1; };
    let g = h();
    let t = task::spawn(async { await g; });
    await t;
    println(f"{n}");
}

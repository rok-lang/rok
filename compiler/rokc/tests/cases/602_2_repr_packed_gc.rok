// expect-error: `#[repr(packed)]` struct `Named` holds a GC reference

// `packed` is for C data. Its fields may sit unaligned,
// where the collector could not read a reference.
#[repr(packed)]
struct Named { tag: u8; name: str; }

fn main() {
    let n = Named { tag: 1, name: "x" };
    println(f"{n.tag}");
}

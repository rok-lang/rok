// needs: threads
// expect-exit: 0
// expect-stdout:
// collections 20
// bounded: true
// scan ok

// A thread scanning lists in loops with no safepoint but their polls
// (its lists rooted only on the yield path) stops for every collection
// another thread runs, promptly.
use rok::core::sync::{LoadOrdering, StoreOrdering};
use rok::std::thread;
use rok::core::time::Instant;

extern "C" {
    fn rok_gc_collect();
}

fn main() -> i32 {
    let stop = Atomic::new(0);
    let started = Atomic::new(0);
    let h = thread::spawn(|| {
        let xs: List<List<i64>> = [];
        for i in 0..64i64 {
            let r: List<i64> = [];
            for j in 0..64i64 { r.push(i + j); }
            xs.push(r);
        }
        started.store(1, StoreOrdering::Relaxed);
        let t: i64 = 0;
        let rounds: i64 = 0;
        while stop.load(LoadOrdering::Relaxed) == 0 {
            let i: usize = 0;
            while i < xs.len() {
                let r = xs[i];
                let j: usize = 0;
                while j < r.len() { t += r[j]; j += 1; }
                i += 1;
            }
            rounds += 1;
        }
        t == rounds * 258048
    });
    while started.load(LoadOrdering::Relaxed) == 0 { thread::yield_now(); }
    let worst: u64 = 0;
    for _ in 0..20 {
        let junk: List<str> = [];
        for i in 0..2000 { junk.push(f"{i}-junk-junk-junk"); }
        let t0 = Instant::now();
        unsafe { rok_gc_collect(); }
        let ms = t0.elapsed().as_ms() as u64;
        if ms > worst { worst = ms; }
    }
    println("collections 20");
    println(f"bounded: {worst < 2000u64}");
    stop.store(1, StoreOrdering::Relaxed);
    println(if try! h.join() { "scan ok" } else { "scan wrong" });
    return 0;
}

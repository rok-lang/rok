// needs: threads
// expect-error: `q` and `a` share an object, and `race` hands over the one and keeps using the other
// Two params: an element of one list param equals another param.
use rok::std::thread;
fn race(tx: Sender<List<i32>>, q: List<List<i32>>, f: List<i32>) -> usize {
    if let e: List<i32> = q.pop() { try! tx.send(e); }
    for i in 0..200000 { f.push(i); }
    f.len()
}
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let a: List<i32> = [];
    let q: List<List<i32>> = [a];
    let n = race(tx, q, a);
    let _ = try! t.join();
    println(f"len {n}");
}

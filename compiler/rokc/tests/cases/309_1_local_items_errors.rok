// An item in a block sees no local or generic parameter of the code
// around it, and nothing outside the block sees it.
fn f(x: i32) -> i32 {
    struct P { a: i32; }
    impl P {
        fn get(self) -> i32 { self.a + x }
    }
    static S: i32 = x;
    struct B { a: [i32; 1] = [x]; }
    P { a: 1 }.get()
}


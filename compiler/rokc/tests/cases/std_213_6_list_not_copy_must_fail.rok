// spec: std §2.13.6
// expect-error: type `List<i32>` does not satisfy trait bound `Copy` required by `dup`

// Stdlib 2.13.6: a collection is not `Copy`: copying its handle would
// not copy its contents.
fn dup<T: Copy>(x: T) -> (T, T) { (x, x) }

fn main() {
    let xs = [1, 2];
    let p = dup(xs);
}

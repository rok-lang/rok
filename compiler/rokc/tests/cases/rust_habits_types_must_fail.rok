// Rust habits in types and parameters: each error names the Rok form.
fn read(p: &Point) -> i32 { p.x }
fn bump(p: &mut Point) { p.x += 1; }
fn name(s: &str) -> usize { s.len() }
fn total(xs: &[i32]) -> usize { xs.len() }
fn first<'a>(s: &'a str) -> str { s }

impl Point {
    fn get(&self) -> i32 { self.x }
    fn set(&mut self) { self.x = 1; }
    fn moved(mut self) -> Point { self }
}

fn inc(mut n: i32) -> i32 { n + 1 }
fn make() -> impl Shape { Point { x: 1 } }
fn show(s: impl Shape) {}
fn all(xs: List<Box<dyn Shape>>) {}
fn one(xs: List<dyn Shape>) {}
fn apply(f: impl Fn(i32) -> i32) {}
fn call<F: Fn(i32) -> i32>(f: F) {}
fn hold(f: Box<dyn FnMut()>) {}

trait Shape { fn area(self) -> i32; }
struct Point { x: i32; }
impl Shape for Point { fn area(self) -> i32 { self.x } }

fn main() {}

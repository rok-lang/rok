const KEY: str = "-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgcgH7+8UZOnSmYIn9
1ftUi+QOk+yiBJQf//N6N0MgirqhRANCAASlRTaxGpC5fl2aWOE4A94IQYOlLaZE
FaEpq/6UIdEL3wPK3Oj3v+97CWRf3SsIe8X0/ZpoW+ppyMMO58QOQHyV
-----END PRIVATE KEY-----
";

fn data(n: usize) -> List<u8> {
    let d: List<u8> = [];
    for i in 0..n { d.push((i % 251) as u8); }
    d
}

const BIG: usize = 4000000;
const ROUNDS: usize = 40;

let any: SocketAddr = try! "127.0.0.1:0".parse::<SocketAddr>();
let l = try! TcpListener::bind(any);
let addr = try! l.local_addr();
let cfg = try! ServerConfig::new(try! Certificate::from_pem(CERT), try! PrivateKey::from_pem(KEY));
let server = task::spawn_local(async {
    let (s, _) = try! await l.accept_async();
    try! l.close();
    let srv_own = try! await Server::new_async(s, cfg);
    let srv = unsafe { share(srv_own) };
    // A reader answering the client's KeyUpdate requests beside a writer
    // whose large write waits on a full socket.
    let reader = task::spawn_local(async {
        let err = "";
        let got = try await srv.read_to_end_async() catch e {
            err = f"read: {e.message()}";
            List::<u8>::new()
        };
        if err.len() > 0 { err } else { f"{got.len()} bytes, intact {got == data(ROUNDS * 100)}" }
    });
    let wrote = "ok";
    try await srv.write_all_async(data(BIG)) catch e { wrote = f"write: {e.message()}"; };
    let _ = try? await srv.close_notify_async();
    let r = await reader;
    try! srv_own.close();
    f"wrote {wrote}, read {r}"
});
// Only the test CA: the host's trust store (`SSL_CERT_FILE` from cargo)
// may be out of a wasm sandbox's reach.
let ccfg = ClientConfig { root_certs: try! Certificate::from_pem(CA) };
let s = try! await net::tcp_connect_async(f"{addr}");
let c_own = try! await Client::with_config_async(s, "localhost", ccfg);
let c = unsafe { share(c_own) };
let updates = task::spawn_local(async {
    let chunk = data(ROUNDS * 100);
    let r = "ok";
    for i in 0..ROUNDS {
        try await c.write_all_async(chunk[i * 100:(i + 1) * 100]) catch e { r = f"write: {e.message()}"; };
        try await c.key_update_async() catch e { r = f"key update: {e.message()}"; };
        if r != "ok" { break; }
        await task::yield_now();
    }
    let _ = try? await c.close_notify_async();
    r
});
let back = try await c.read_to_end_async() catch e { println(f"client read: {e.message()}"); [] };
println(f"client got {back.len()} bytes, intact {back == data(BIG)}");
println(f"client updates: {await updates}");
println(f"server: {await server}");
try! c_own.close();

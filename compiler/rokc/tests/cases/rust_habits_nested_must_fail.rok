// Rust's nested wrappers: one error on the outer constructor or type,
// its help the whole Rok form.

struct Point { x: i32; }

fn shared_count() {
    let c = Rc::new(RefCell::new(0));
}

fn shared_list() {
    let xs = Rc::new(RefCell::new(Vec::new()));
}

fn locked() {
    let m = Arc::new(Mutex::new(HashMap::new()));
}

fn boxed() {
    let p = Rc::new(RefCell::new(Box::new(Point { x: 1 })));
}

fn counter(c: Rc<RefCell<i32>>) {}
fn table(m: Arc<Mutex<HashMap<String, Vec<i32>>>>) {}
fn maybe(c: Option<Rc<RefCell<i32>>>) {}

fn main() {}


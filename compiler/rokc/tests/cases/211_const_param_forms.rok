// expect-exit: 0
// expect-stdout:
// 8 8 0
// 4 16 0
// 7 3 5
// true 4
// 12 5

struct Tagged<T, const TAG: u32> { value: T; }

impl<T, const TAG: u32> Tagged<T, TAG> {
    fn tag(self) -> u32 { TAG }
}

struct Matrix<const R: usize, const C: usize> { cells: [f64; R * C]; }

const SIZE: usize = 2;

fn replicate<T, const N: usize>(value: T) -> [T; N] { [value; N] }

fn zeros<const N: usize>() -> [f64; N] { [0.0; N] }

fn first<T, const N: usize>(arr: [T; N]) -> T { arr[0] }

fn middle<T, const N: usize>(arr: [T; N]) -> T { arr[N / 2] }

fn same(a: [i32; 4]) -> usize { a.len() }

fn main() {
    // Explicit, or inferred from the expected type.
    let arr: [i32; 8] = replicate(0i32);
    let arr2 = replicate::<i32, 8>(1i32);
    println(f"{arr.len()} {arr2.len()} {arr[7]}");
    let z: [f64; 4] = zeros();
    let w = [1u8; 16];
    println(f"{z.len()} {w.len()} {z[3]}");
    // A const parameter in value position.
    let t = Tagged::<i32, 3> { value: 7 };
    println(f"{t.value} {t.tag()} {middle([1, 3, 5, 7, 9])}");
    // `[i32; 2 + 2]` is `[i32; 4]`.
    let b: [i32; 2 + 2] = [1, 2, 3, 4];
    println(f"{same(b) == 4} {same(b)}");
    let m = Matrix::<SIZE, 3> { cells: [2.0; SIZE * 3] };
    println(f"{m.cells.len() * 2} {first([5, 6])}");
}

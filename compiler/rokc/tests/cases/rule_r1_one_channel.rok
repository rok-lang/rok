// expect-error: this call can throw `IoError` and must be marked with `try`
// expect-error: `try` is for calls that throw; `p.strip_prefix("a")` gives `Path | none`
// expect-error: this call can throw `ParseError` and must be marked with `try`
// expect-error: `??` needs an optional left operand (`T | none`), found `int`
// expect-error: missing argument `s` in call to `Path::new`

// Each function has one failure channel: a socket's `close` throws,
// `Path::strip_prefix` is `Path | none`, `Int::parse_radix` throws (its
// `T | none` form is `try?`), and the empty path is `Path::empty()`.
use rok::core::io::IoError;
use rok::std::net;
use rok::std::path::Path;

fn main() throws (IoError) {
    let l = try net::tcp_listen("127.0.0.1:0");
    l.close();
    let p = Path::new("a/b");
    let r = try p.strip_prefix("a");
    let i = int::parse_radix("ff", 16u32) ?? 0 as int;
    let e = Path::new();
}

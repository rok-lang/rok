// expect-exit: 36
// expect-stdout:
// 6 21

struct Cell<T> {
    v: T;
}

fn main() -> i32 {
    let grid: [[Cell<i32>; 2]; 3] = [
        [Cell { v: 1 }, Cell { v: 2 }],
        [Cell { v: 3 }, Cell { v: 4 }],
        [Cell { v: 5 }, Cell { v: 6 }],
    ];
    let total = 0;
    for row in grid {
        let i = 0;
        while i < 2 {
            total += row[i].v;
            i += 1;
        }
    }
    println(f"{grid[2][1].v} {total}");
    return total + 15;
}

// expect-error: type `P` does not satisfy trait bound `PartialOrd`
// expect-error: type `str` does not satisfy trait bound `Zero`

// `min` / `max` need `Item: PartialOrd`, `sum` needs
// `Item: Add<Output = Item> + Zero` (method `where` bounds on a trait's
// default methods).
struct P { x: i32; }

fn main() {
    let xs: List<P> = [P { x: 1 }, P { x: 2 }];
    let m = xs.into_iter().min();
    let ss: List<str> = ["a", "b"];
    let s = ss.into_iter().sum();
}

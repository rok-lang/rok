// expect-exit: 0
// expect-stdout:
// 3
// 3

// A struct may hold `any Tr | none` of its own trait (an error-cause
// chain) - the payload is a heap pointer, so the type stays finite.
trait Fault { fn code(self) -> i32; fn depth(self) -> i32; }
struct Leaf { c: i32; }
struct Wrap { c: i32; cause: any Fault | none; }
impl Fault for Leaf {
    fn code(self) -> i32 { return self.c; }
    fn depth(self) -> i32 { return 1; }
}
impl Fault for Wrap {
    fn code(self) -> i32 { return self.c; }
    fn depth(self) -> i32 {
        return match self.cause { e: any Fault => 1 + e.depth(), none => 1, };
    }
}
let e: any Fault = Wrap { c: 3, cause: Wrap { c: 2, cause: Leaf { c: 1 } } };
println(f"{e.depth()}");
println(f"{e.code()}");


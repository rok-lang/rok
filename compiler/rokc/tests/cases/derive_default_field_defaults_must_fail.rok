// expect-error: cannot derive `Default` for `Cfg`: `hook` has type `NoDefault`, which does not implement `Default`
// expect-error: no associated function `default` on `NoDefault`

// A field without a declared default still needs its type's `default()`.
struct NoDefault { v: i32; }

#[derive(Default)]
struct Cfg {
    level: i32 = 3;
    hook: NoDefault;
}

println(f"{Cfg::default().level}");

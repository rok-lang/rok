// `d[k]` with an absent key names the key and points at `get`.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/std_dict_missing_key_panic.rok:10:16:
// expect-stderr: key "b" not found; use `d.get(k)` to get `i64 | none`
// expect-stdout: 1

fn main() {
    let d: Dict<str, i64> = {"a": 1};
    println(f"{d["a"]}");
    println(f"{d["b"]}");
}

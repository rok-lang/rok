// needs: threads
// expect-error: `b.items` was sent through a channel
// A user Clone that shares a field: the help says `.clone()`.
use rok::std::thread;
struct Bag { items: List<i32>; }
impl Clone for Bag { fn clone(self) -> Bag { Bag { items: self.items } } }
fn main() {
    let (tx, rx) = channel::<Bag>();
    let t = thread::spawn(|| { if let b: Bag = rx.recv() { for i in 0..200000 { b.items.push(i); } } 0 });
    let b = Bag { items: [] };
    try! tx.send(b.clone());
    for i in 0..200000 { b.items.push(i); }
    let _ = try! t.join();
    println(f"len {b.items.len()}");
}

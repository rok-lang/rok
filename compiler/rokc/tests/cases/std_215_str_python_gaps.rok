// expect-exit: 0
// expect-stdout:
// olleH 2 2 3
// a+b+c-d x
// Hello World Don't 3rd
// -4 1 -4 -1 3 2
// 42px 2.5 c true

// Python's str / int helpers in Rok's names: reversed, count, replacen,
// to_titlecase; div_floor / rem_floor (Python's // and %); to_str on
// every Display type.
println("Hello".reversed(), "banana".count("an"), "aaaa".count("aa"), "ab".count(""));
println("a-b-c-d".replacen("-", "+", 2), "x".replacen("-", "+", 2));
println("hello wORLD don't 3rd".to_titlecase());
println((-7).div_floor(2), (-7).rem_floor(2), 7.div_floor(-2), 7.rem_floor(-2), 7u8.div_floor(2), 6.div_floor(3));
let n = 42;
println(n.to_str() + "px", 2.5.to_str(), 'c'.to_str(), true.to_str());

// expect-exit: 0
// A `const` item as an array length in a struct field and a signature.
// expect-stdout:
// 4 8 10 4 8

const N: usize = 4;
const M: usize = N * 2;

struct Buf {
    data: [i32; N];
    more: [u8; M];
}

mod inner {
    const K: usize = 3;
    pub struct T {
        pub a: [i32; K];
    }
}

fn len_of(a: [i32; N]) -> usize {
    a.len()
}

fn main() -> i32 {
    let b = Buf { data: [1, 2, 3, 4], more: [0; M] };
    if b.data.len() != 4 { return 1; }
    if b.more.len() != 8 { return 2; }
    let s = 0;
    for x in b.data { s += x; }
    if s != 10 { return 3; }
    if len_of(b.data) != 4 { return 4; }
    println(f"{b.data.len()} {b.more.len()} {s} {N} {M}");
    let t = inner::T { a: [7, 8, 9] };
    if t.a[2] != 9 { return 5; }
    0
}

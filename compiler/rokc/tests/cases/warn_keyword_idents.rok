// spec: 001.05.6-future-keywords
// expect-exit: 0
// expect-lint: 17:4 `gen` is a keyword from Rok 0.2.0 on
// expect-lint: 20:9 `move` is a keyword from Rok 0.2.0 on
// expect-lint: 21:9 `do` is a keyword from Rok 0.2.0 on
// expect-lint: 22:13 `gen` is a keyword from Rok 0.2.0 on
// expect-lint: 22:26 `move` is a keyword from Rok 0.2.0 on
// expect-lint: 25:63 `do` is a keyword from Rok 0.2.0 on
// expect-warning: help: write `r#move` to keep this name, or rename it
// expect-stdout: 4 1 2 3 9 6

// Names spelled `macro`, `defer`, `dyn`, `move`, `gen` or `do` become
// keywords in 0.2.0: each warns, with `r#name` as the way out. After `.`,
// in a field and as an argument label they stay names, so those don't.
struct Step { move: i32; dyn: i32; }

fn gen(n: i32) -> i32 { n * 2 }

fn main() {
    let move = 1;
    let do = 2;
    let s = gen(2) + 0 * move;
    let t = Step { move: 1, dyn: 2 };
    let r#gen = 3;
    println(f"{s} {t.move} {t.dyn} {r#gen} {quiet()} {r#gen + do + 1}");
}

#[allow(keyword_idents)]
fn quiet() -> i32 {
    let defer = 9;
    defer
}

// expect-exit: 0
// expect-stdout:
// freed 65
// 5 3

// `extern "C"` blocks: unsafe calls, `Ptr<T>`, one global name space.
use rok::bare::ptr::Ptr;

extern "C" {
    pub fn malloc(size: usize) -> Ptr<u8> | none;
    fn free(p: Ptr<u8>);
    pub fn llabs(x: i64) -> i64;
    fn abs(x: i32) -> i32;
}

mod inner {
    pub fn call() -> i64 { unsafe { llabs(-5) } }
}

let p = unsafe { malloc(1024usize) };
match p {
    q: Ptr<u8> => {
        unsafe { q.write(65u8); }
        let v = unsafe { q.read() };
        unsafe { free(q) };
        println(f"freed {v}");
    }
    none => println("no memory"),
}
println(f"{inner::call()} {unsafe { abs(-3) }}");

// An in-place broadcast from a list of another length panics.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/std_204_dot_assign_len_panics.rok:10:5:
// expect-stderr: broadcast: lengths 3 and 2 differ; make both sides the same length
// expect-stdout:

fn main() -> i32 {
    let p: List<i32> = [1, 2, 3];
    let q: List<i32> = [1, 2];
    p .+= q;
    p[0]
}

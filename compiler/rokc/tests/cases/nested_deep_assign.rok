// expect-exit: 22
// expect-stdout:
// 11 4 7

struct Pos {
    x: i32;
    y: i32;
}

struct Sprite {
    pos: Pos;
    z: i32;
}

fn main() -> i32 {
    let s = Sprite {
        pos: Pos { x: 3, y: 4 },
        z: 7,
    };
    s.pos.x = 11;
    println(f"{s.pos.x} {s.pos.y} {s.z}");
    return s.pos.x + s.pos.y + s.z;
}

// needs: threads
// expect-error: `all` still holds `xs`, which was handed to another owner
// The stored_then_sent case from the test suite, plus one push.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let xs: List<i32> = [];
    let all: List<List<i32>> = [];
    all.push(xs);
    try! tx.send(xs);
    all.push([]);
    for i in 0..200000 { all[0].push(i); }
    let _ = try! t.join();
    println(f"len {all[0].len()}");
}

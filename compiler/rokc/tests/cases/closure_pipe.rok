// expect-exit: 21
// expect-stdout:
// 9 -1

fn pipeline(x: i32, fns: [fn(i32) -> i32; 3]) -> i32 {
    let acc = x;
    for f in fns {
        acc = f(acc);
    }
    return acc;
}

fn main() -> i32 {
    let fns: [fn(i32) -> i32; 3] = [
        |n: i32| -> i32 { n + 1 },
        |n: i32| -> i32 { n * 2 },
        |n: i32| -> i32 { n - 3 },
    ];
    println(f"{pipeline(5, fns)} {pipeline(0, fns)}");
    return pipeline(5, fns) + 12;
}


// spec: 004.07-ref-keyword
// expect-exit: 0
// expect-lint: 18:5 the write to `cs[0]` is discarded: `set` takes `ref self` and changes a copy of the element
// expect-lint: 19:5 the write to `d["a"]` is discarded: `set` takes `ref self` and changes a copy of the element
// expect-warning: help: copy it out, call `set`, and store it back: `let v = cs[0]; v.set(..); cs[0] = v;`
// expect-stdout: 0 5 6 7

// A `ref self` method on an element or a Dict entry has no place to
// write back to: a warning says the write is discarded. (A static is
// an error: err_static_ref_write.)
struct Cell { v: i32; }
impl Cell { fn set(ref self, n: i32) { self.v = n; } }
static S: Cell = Cell { v: 0 };

fn main() {
    let cs = [Cell { v: 0 }];
    let d = {"a": Cell { v: 0 }};
    cs[0].set(1);
    d["a"].set(2);
    // A variable, and the element copied out and stored back.
    let c = Cell { v: 0 };
    c.set(5);
    let e = cs[0];
    e.set(6);
    cs[0] = e;
    let w = d["a"];
    w.set(7);
    d["a"] = w;
    println(f"{S.v} {c.v} {cs[0].v} {d["a"].v}");
}

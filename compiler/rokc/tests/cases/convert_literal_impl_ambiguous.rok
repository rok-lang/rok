// expect-error: `X::from`: the literal fits several `From` impls of `X` (`i32`, `u8`)
// A literal that fits several impls, none of them its
// default type (`i64`), needs a suffix.
struct X { v: i64; }
impl From<i32> for X { fn from(x: i32) -> X { X { v: x as i64 } } }
impl From<u8> for X { fn from(x: u8) -> X { X { v: x as i64 } } }
fn main() {
    let x = X::from(5);
    let _ = x.v;
}

// A `throw` in a `catch` raises the error anew: the report names the
// rethrow, not the first `throw`.
fn half(x: i32) throws (i32) -> i32 {
    if x % 2 == 1 {
        throw x;
    }
    x / 2
}

fn load(x: i32) throws (i32) -> i32 {
    try half(x) catch e: i32 {
        println(f"caught {e}");
        throw e;
    }
}

fn main() {
    let v = try! load(7);
    println(f"{v}");
}

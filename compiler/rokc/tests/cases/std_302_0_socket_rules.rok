// spec: std 302-net §3.2.0 §3.2.6
// needs: net posix-fs
// expect-exit: 0
// expect-stdout:
// got: str+list+slice
// copy shares: true
// clone after close: ok
// closed: InvalidInput
// using closed it: 2 0

// Socket rules: write / read forms, copies, `try_clone`, close.
use rok::std::net;
use rok::std::net::{Shutdown, TcpStream};
use rok::std::io::{IoError, IoErrorKind, byte_buf};

fn main() throws (IoError) {
    let l = try net::tcp_listen("127.0.0.1:0");
    let addr = try l.local_addr();
    let c = try net::tcp_connect(f"{addr}");
    let (s, _) = try l.accept();

    let bytes: List<u8> = [43u8, 108u8, 105u8, 115u8, 116u8];
    try c.write_str("str");
    try c.write_all(bytes);
    try c.write_all("+slice!"[0:6]);
    let alias = c;
    try alias.shutdown(Shutdown::Write);
    let all = try s.read_to_end();
    println(f"got: {try! str::from_utf8(all[0:all.len()])}");
    println(f"copy shares: {(try alias.local_addr()) == (try c.local_addr())}");

    let dup = try s.try_clone();
    s.close();
    try dup.write_str("x");
    println("clone after close: ok");
    let buf = byte_buf(4);
    let k = try s.read(buf) catch e: IoError { if e.kind() == IoErrorKind::InvalidInput { 99 } else { 98 } };
    println(f"closed: {if k == 99 { "InvalidInput" } else { "other" }}");

    using d = dup {
        try d.write_str("y");
    }
    let rest = try c.read_to_end();
    let n = try c.read(buf);
    println(f"using closed it: {rest.len()} {n}");
    c.close();
    l.close();
}

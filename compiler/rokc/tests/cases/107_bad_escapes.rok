// expect-error: unknown escape sequence `\q`

// Unknown escapes, `\x` above 0x7F and multi-code-point char literals are
// lexical errors, not passed through verbatim.
fn main() -> i32 {
    println("\q \x80");
    let c = 'ab';
    return 0;
}

// expect-error: 7:13: char literal must contain exactly one code point

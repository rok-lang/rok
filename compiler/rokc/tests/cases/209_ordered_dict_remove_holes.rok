// expect-exit: 0
// expect-stdout:
// 1 none 7 5
// {"k0": 100, "k2": 2, "k4": 4, "k5": 5, "k6": 6, "k7": 7, "k1": 10} 7
// 7 none 2 {"k7": 7, "k1": 10}
// [3, 2, 1] 3
// 0 true {}

// Stdlib 2.9.5: OrderedDict / OrderedSet remove in O(1) (holes), order kept
// across removal, re-insertion appends, holes skipped by iteration.
fn main() -> i32 {
    let d: collections::OrderedDict<str, i32> = collections::OrderedDict::new();
    for i in 0..8 {
        d.insert(f"k{i}", i);
    }
    println(f"{d.remove("k1"):?} {d.remove("k1"):?} {d.len()} {d["k5"]}");
    d.remove("k3");
    d.insert("k1", 10);
    d.insert("k0", 100);
    println(f"{d:?} {d.len()}");
    for k in ["k0", "k2", "k4", "k5", "k6"] {
        d.remove(k);
    }
    println(f"{d.get("k7"):?} {d.get("k2"):?} {d.len()} {d:?}");
    let s = collections::OrderedSet::from([3, 1, 2]);
    s.remove(1);
    s.insert(1);
    println(f"{s.to_list():?} {s.len()}");
    d.clear();
    println(f"{d.len()} {d.is_empty()} {d:?}");
    return 0;
}

// spec: std 209-collections §2.9.5

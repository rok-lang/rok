// spec: std 200-core/218-task §2.18.1 / §2.18.2
// expect-exit: 0
// expect-stdout:
// outside true
// distinct true
// own id matches true
// finished true cancelled false

// 2.18.1 `TaskId`: `task::id()` inside a task equals that task's
// `Task::id()`; ids are never reused; `current_id()` is `none` outside a
// task. 2.18.2: `is_finished` / `is_cancelled`.
async fn me() -> u64 {
    task::id().as_u64()
}

fn main() {
    println(f"outside {task::current_id() == none}");
    task::block_on(async {
        let a = task::spawn(me());
        let b = task::spawn(me());
        println(f"distinct {a.id() != b.id()}");
        let a_id = a.id().as_u64();
        let got = await a;
        println(f"own id matches {got == a_id}");
        await b;
        println(f"finished {b.is_finished()} cancelled {b.is_cancelled()}");
    });
}

// expect-exit: 0
// expect-lint: 18:11 `a` is released twice: an earlier `using` already released it
// expect-lint: 24:15 `a` is released twice: an earlier `using` already released it
// expect-warning: help: do all the work inside one `using` block
// spec: §3.17.6
// spec: §6.2.9
// expect-stdout: 2

// A `Drop` value is released once: a second `using` of it frees an
// `Allocation` twice.

use rok::bare::alloc::Allocation;

pub fn twice(a: Allocation<i64>) -> usize {
    let n = 0usize;
    using x = a { n += x.len(); }
    // flagged: `a` was released above
    using y = a { n += y.len(); }
    n
}

pub fn in_a_loop(a: Allocation<i64>) {
    for _ in 0..2 {
        using x = a { println(f"{x.len()}"); }
    }
}

// Not flagged: each `using` releases the value it makes.
fn fresh() -> usize {
    let n = 0usize;
    for _ in 0..2 {
        using x = try! Allocation::<i64>::new(1usize) { n += x.len(); }
    }
    n
}

fn main() {
    println(f"{fresh()}");
}

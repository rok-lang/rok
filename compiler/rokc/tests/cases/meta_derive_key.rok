// expect-exit: 0
// expect-stdout:
// strict
// loose

// `#[impl_derive_attribute(Trait, attr(k, ..))]` declares
// the keys `#[attr(..)]` takes; `@Self.has_derive_key(k)` reads one off
// the type.
trait Mode {
    fn mode() -> str;
}

#[impl_derive_attribute(Mode, mode(strict))]
pub @derive {
    impl Mode for @Self {
        fn mode() -> str {
            if @Self.has_derive_key(strict) { "strict" } else { "loose" }
        }
    }
}

#[derive(Mode)]
#[mode(strict)]
struct A { x: i32; }

#[derive(Mode)]
struct B { x: i32; }

fn main() {
    println(A::mode());
    println(B::mode());
}


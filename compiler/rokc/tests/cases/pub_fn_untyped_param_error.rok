// spec: 004.02.2-omitting-the-type
// expect-error: 9:12: parameter `x` of `pub fn add` has no type
// expect-error: 9:15: parameter `y` of `pub fn add` has no type
// expect-error: 14:34: parameter `n` of `pub(pkg) fn scale` has no type

// A `pub` / `pub(pkg)` fn writes every parameter type; private and
// `pub(sub)` fns and trait impl methods do not need to.

pub fn add(x, y) -> i32 {
    x + y
}

struct P {}
impl P { pub(pkg) fn scale(self, n) -> i32 { n * 2 } }

fn twice(x) -> i32 { x + x }
pub(sub) fn thrice(x) -> i32 { x * 3 }

println(f"{add(1, 2)} {P {}.scale(3)} {twice(4)} {thrice(5)}");

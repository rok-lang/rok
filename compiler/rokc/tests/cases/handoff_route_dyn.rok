// needs: threads
// expect-error: `s` shares `e`, which was sent through a channel
// A trait method behind `dyn` that stores twice.
use rok::std::thread;
trait Store { fn put(self, x: List<i32>); fn take(self) -> List<i32> | none; }
struct Twice { q: List<List<i32>>; }
impl Store for Twice {
    fn put(self, x: List<i32>) { self.q.push(x); self.q.push(x); }
    fn take(self) -> List<i32> | none { self.q.pop() }
}
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let s: any Store = Twice { q: [] };
    let a: List<i32> = [];
    s.put(a);
    if let e: List<i32> = s.take() { try! tx.send(e); }
    if let f: List<i32> = s.take() { for i in 0..200000 { f.push(i); } let _ = try! t.join(); println(f"len {f.len()}"); }
}

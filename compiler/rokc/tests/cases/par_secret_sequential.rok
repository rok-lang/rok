// needs: threads
// spec: std 219-par §2.19.1 / std 213-marker §2.13.9
// expect-exit: 0
// expect-stderr: warning: par::for_each at tests/cases/par_secret_sequential.rok:28:5: two items reach one collection or future, so they run one at a time on this thread; give each item its own copy, or share read-only data through `Frozen`
// expect-stdout:
// Secret: 800000
// own: 100000 100000

// Items sharing one `Secret` run one at a time, as with a `List`; items
// with their own `Secret` change it in place.
use rok::core::crypto::Secret;

fn count(s: Secret) -> u32 {
    (s[0] as u32) | ((s[1] as u32) << 8) | ((s[2] as u32) << 16) | ((s[3] as u32) << 24)
}

fn incr(s: Secret) {
    let n = count(s) + 1;
    s[0] = (n & 255) as u8;
    s[1] = ((n >> 8) & 255) as u8;
    s[2] = ((n >> 16) & 255) as u8;
    s[3] = (n >> 24) as u8;
}

fn main() {
    let s = Secret::zeroed(4);
    let items: List<Secret> = [s, s, s, s, s, s, s, s];
    par::for_each(items, |x: Secret| { for _ in 0..100000 { incr(x); } });
    println(f"Secret: {count(s)}");
    let a = Secret::zeroed(4);
    let b = Secret::zeroed(4);
    par::for_each([a, b], |x: Secret| { for _ in 0..100000 { incr(x); } });
    println(f"own: {count(a)} {count(b)}");
}

// needs: threads
// expect-error: `q` still holds `l`, which was handed to another owner
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let q: Deque<List<i32>> = Deque::new();
    q.push_back([]);
    for l in q { try! tx.send(l); }
    q.push_back([]);
    if let f: List<i32> = q.pop_front() { for i in 0..200000 { f.push(i); } let _ = try! t.join(); println(f"len {f.len()}"); }
}

// spec: std 311-os §3.11.3
// only-os: windows
// needs: net
// expect-exit: 0
// expect-stdout:
// stdout: true
// file: true
// adopted: hi
// socket: true
// echo: ping

// `os::windows::io`: the full pointer-sized HANDLE and the SOCKET as
// Win32 gives them, and back (`f` and `c` are shared, so only the
// adopting handle closes).
use rok::std::fs;
use rok::std::fs::File;
use rok::std::env;
use rok::std::process;
use rok::std::net::{TcpListener, TcpStream};
use rok::std::os::windows::io::{AsRawHandle, AsRawSocket, FromRawHandle, FromRawSocket, RawHandle, RawSocket};
use rok::core::marker::share;
use rok::core::io::IoError;

fn main() throws (IoError) {
    println(f"stdout: {io::stdout().as_raw_handle() != -1}");
    let path = env::temp_dir() / f"rok_raw_handle_{process::id()}";
    try fs::write(path, "hi");
    let f = unsafe { share(try File::open(path)) };
    let h: RawHandle = f.as_raw_handle();
    println(f"file: {h != -1 && h % 4 == 0}");
    let g = unsafe { File::from_raw_handle(h) };
    println(f"adopted: {try g.read_to_str()}");
    try g.close();
    try fs::remove_file(path);

    using l = try TcpListener::bind(try "127.0.0.1:0".parse()) {
        let c = unsafe { share(try TcpStream::connect(try l.local_addr())) };
        let s: RawSocket = c.as_raw_socket();
        println(f"socket: {s % 4u64 == 0u64}");
        let d = unsafe { TcpStream::from_raw_socket(s) };
        let (peer, _) = try l.accept();
        try d.write_all("ping");
        let buf: List<u8> = List::filled(4, 0u8);
        try peer.read_exact(buf);
        println(f"echo: {try str::from_utf8(buf)}");
        peer.close();
        d.close();
    }
}

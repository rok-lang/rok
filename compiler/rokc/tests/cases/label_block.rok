// expect-exit: 42
// expect-stdout:
// -1 0 14 30 999

// Labeled block: early exit with a value via `break 'label value;`.
fn classify(n: i32) -> i32 {
    return 'b: {
        if n < 0 { break 'b -1; }
        if n == 0 { break 'b 0; }
        if n > 100 { break 'b 999; }
        n * 2     // trailing - block value when no break taken
    };
}

fn main() -> i32 {
    let total = 0;
    total += classify(-5);   // -1
    total += classify(0);    // 0
    total += classify(7);    // 14
    total += classify(15);   // 30
    println(f"{classify(-5)} {classify(0)} {classify(7)} {classify(15)} {classify(101)}");
    return total - 1;        // (-1 + 0 + 14 + 30) - 1 = 42
}

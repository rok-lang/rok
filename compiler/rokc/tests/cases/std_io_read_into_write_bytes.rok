// spec: std 305-io §3.5.1
// expect-exit: 0
// expect-stdout:
// wrote: hi abc yz
// read 3 into 2..5: [0, 0, 104, 105, 32, 0]
// end: 0

// `Writer::write_bytes` takes anything `AsBytes` (a `Slice<u8>` too);
// `Reader::read_into` reads into part of a buffer. Both are default
// methods, so every reader and writer has them.
use rok::std::io::{IoError, Reader, Writer, byte_buf};

struct Sink { got: List<u8>; }

impl Writer for Sink {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize {
        for b in buf { self.got.push(b); }
        buf.len()
    }
    fn flush(ref self) throws (IoError) {}
}

struct Src { data: List<u8>; at: usize; }

impl Reader for Src {
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize {
        let n = 0usize;
        while n < buf.len() && self.at < self.data.len() {
            buf[n] = self.data[self.at];
            n += 1;
            self.at += 1;
        }
        n
    }
}

fn emit<W: Writer>(ref w: W, data: Slice<u8>) throws (IoError) { try w.write_bytes(data); }

fn main() throws (IoError) {
    let s = Sink { got: [] };
    try s.write_bytes("hi ");
    let list: List<u8> = [97u8, 98u8, 99u8, 32u8];
    try s.write_bytes(list);
    let tail: List<u8> = [120u8, 121u8, 122u8];
    try emit(ref s, tail[1:3]);
    println(f"wrote: {try! str::from_utf8(s.got)}");
    let r = Src { data: s.got, at: 0 };
    let buf = byte_buf(6);
    let n = try r.read_into(buf, 2..5);
    println(f"read {n} into 2..5: {buf:?}");
    r.at = r.data.len();
    println(f"end: {try r.read_into(buf, 0..6)}");
}

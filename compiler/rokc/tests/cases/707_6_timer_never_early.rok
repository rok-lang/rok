// expect-exit: 0
// expect-stdout:
// 20ms sleep not early: true
// deadline sleep not early: true
// zero sleep returns: true

// A timer never fires before its deadline (it may fire later
// by up to the timer resolution); a zero-length sleep just yields.
async fn main() {
    let t0 = Instant::now();
    await task::sleep(Duration::ms(20));
    println(f"20ms sleep not early: {t0.elapsed().as_ms() >= 20}");
    let at = Instant::now() + Duration::ms(15);
    await task::sleep_until(at);
    println(f"deadline sleep not early: {Instant::now() >= at}");
    await task::sleep(Duration::ms(0));
    println("zero sleep returns: true");
}

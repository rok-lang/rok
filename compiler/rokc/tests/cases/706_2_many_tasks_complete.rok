// expect-exit: 0
// expect-stdout:
// 200 tasks
// sum 1990000
// first 0 last 19900

// Spawned tasks go to the worker deques and idle
// workers steal them; every task runs exactly once whichever worker
// takes it, and `join` hands results back in spawn order.
async fn work(i: i32) -> i64 {
    let acc = 0i64;
    let k = 0;
    while k < 100 {
        acc = acc + (i as i64);
        k += 1;
        if k % 25 == 0 { await task::yield_now(); }
    }
    acc
}

async fn main() {
    let ts: List<Task<i64>> = [];
    let i = 0;
    while i < 200 {
        ts.push(task::spawn(work(i)));
        i += 1;
    }
    let rs = await task::join(ts);
    let sum = 0i64;
    for r in rs { sum = sum + r; }
    println(f"{rs.len()} tasks");
    println(f"sum {sum}");
    println(f"first {rs[0]} last {rs[199]}");
}

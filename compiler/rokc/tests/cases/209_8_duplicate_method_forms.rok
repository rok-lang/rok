// A method name once per type, across its inherent impl blocks, per
// trait impl, and per trait: there is no overloading.
// expect-error: 15:5: method `m` is defined more than once for `S`
// expect-error: help: rename one of them, e.g. `m2`; there is no overloading
// expect-error: 20:5: method `n` is defined more than once for `S`
// expect-error: 24:16: method `g` is defined more than once for `G<T>`
// expect-error: 26:5: method `g` is defined more than once for `G<T>`
// expect-error: 30:5: method `run` is defined more than once in trait `Tr`
// expect-error: 34:5: method `run` is defined more than once for `S`
// expect-error: 37:5: method `later` is defined more than once for `S`

struct S { x: i32 }
impl S {
    fn m(self) -> i32 { self.x }
    fn m(self, a: i32) -> i32 { self.x + a }
    fn n(self) -> i32 { self.x }
    async fn later(self) -> i32 { self.x }
}
impl S {
    fn n(self, a: i32) -> i32 { a }
}
struct G<T> { v: T }
impl<T> G<T> { fn g(self) -> i32 { 1 } }
impl<T> G<T> { fn g(self, a: i32) -> i32 { a } }
impl<T> G<T> {
    fn g(self, a: i32, b: i32) -> i32 { a + b }
}
trait Tr {
    fn run(self) -> i32;
    fn run(self, a: i32) -> i32;
}
impl Tr for S {
    fn run(self) -> i32 { 1 }
    fn run(self, a: i32) -> i32 { a }
}
impl S {
    async fn later(self, a: i32) -> i32 { a }
}

fn main() -> i32 { 0 }

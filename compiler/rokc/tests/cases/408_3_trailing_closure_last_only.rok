// expect-error: a trailing closure fills the last parameter, `output`, which is not a function
// expect-error: help: pass the closure inside the parentheses

// A trailing closure fills only the last argument; a
// closure in the middle needs the parentheses.
fn process(input: str, t: fn(str) -> str, output: str) -> str { t(input) }

println(process("in", |s| { s }, "out"));
println(process("in", "out") |s| { s });
// expect-error-extra: allow
// (the trailing closure, put in `output: str`, is also reported as
// a mismatch and as a closure whose parameter type can't be inferred)

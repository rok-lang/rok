// expect-exit: 13
// expect-stdout:
// 4 1 8 0 12

struct Pair {
    a: i32;
    b: i32;
}

fn classify(p: Pair) -> i32 {
    return match p {
        Pair { a: 0, b } => b,
        Pair { a: 1, b: 0 } => 1,
        Pair { a, b: 0 } => a + 5,
        Pair { a, b } => a * b,
    };
}

fn main() -> i32 {
    let s = classify(Pair { a: 0, b: 4 })
        + classify(Pair { a: 1, b: 0 })
        + classify(Pair { a: 3, b: 0 })
        + classify(Pair { a: 0, b: 0 });
    println(f"{classify(Pair { a: 0, b: 4 })} {classify(Pair { a: 1, b: 0 })} {classify(Pair { a: 3, b: 0 })} {classify(Pair { a: 0, b: 0 })} {classify(Pair { a: 3, b: 4 })}");
    return s;
}


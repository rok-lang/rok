// needs: threads
// expect-error: `b` may hold one object twice
// A user generic container whose method stores one value twice.
use rok::std::thread;
struct Bag<T> { items: List<T>; }
impl<T> Bag<T> {
    fn add2(self, x: T) { self.items.push(x); self.items.push(x); }
    fn take(self) -> T | none { self.items.pop() }
}
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let b: Bag<List<i32>> = Bag { items: [] };
    let a: List<i32> = [];
    b.add2(a);
    if let e: List<i32> = b.take() { try! tx.send(e); }
    if let f: List<i32> = b.take() { for i in 0..200000 { f.push(i); } let _ = try! t.join(); println(f"len {f.len()}"); }
}

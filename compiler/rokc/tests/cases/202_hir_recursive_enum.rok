// An enum / generic enum / sum that holds itself by value has no finite
// size: reported at the user's declaration.
// expect-error: 7:1: recursive type `L` has infinite size (an enum
// expect-error: 12:12: recursive type `G<..>` has infinite size (an enum
// expect-error: 9:1: recursive type `S` has infinite size (a struct

enum L { Nil, Cons(i64, L) }
enum G<T> { Nil, Cons(T, G<T>) }
struct S { next: (i32, S | none); }

fn main() {
    let g: G<i64> = G::Nil;
}

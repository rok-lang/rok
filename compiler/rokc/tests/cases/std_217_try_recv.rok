// spec: std 217-channel §2.17.2
// expect-exit: 0
// forbid-warning: warning
// expect-stdout:
// empty 7 closed

// `try_recv` tells an empty channel from a closed one.
fn show(r: i32 | channel::Empty | channel::Closed) -> str {
    match r {
        v: i32 => f"{v}",
        _: channel::Empty => "empty",
        _: channel::Closed => "closed",
    }
}

fn main() {
    let (tx, rx) = channel::<i32>();
    let a = show(rx.try_recv());
    try! tx.send(7);
    tx.close();
    let b = show(rx.try_recv());
    let c = show(rx.try_recv());
    println(f"{a} {b} {c}");
}

// expect-exit: 42
// expect-stdout: forty-two

// Calling a user-declared `extern "C"` function whose name doesn't
// collide with the auto-injected runtime hooks. `puts` from libc takes
// a null-terminated string and returns an int.
extern "C" {
    fn puts(s: str) -> i32;
}

fn main() -> i32 {
    unsafe { puts("forty-two") };
    return 42;
}


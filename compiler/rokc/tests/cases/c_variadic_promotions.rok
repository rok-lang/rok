// expect-exit: 0
// expect-stdout: a=1 b=-2 c=3.5 s=hi u=200
// C default argument promotions: `bool` / `i16` / `u8`
// widen to `int`, `f32` to `double`, `str` is a `char*`.
extern "C" {
    fn printf(fmt: str, ...) -> i32;
    fn fflush(f: usize) -> i32;
}
fn main() -> i32 {
    let b: i16 = -2;
    let c: f32 = 3.5;
    let u: u8 = 200;
    let n = unsafe { printf("a=%d b=%d c=%.1f s=%s u=%d\n", true, b, c, "hi", u) };
    unsafe { fflush(0) };
    return if n == 26 { 0 } else { 1 };
}

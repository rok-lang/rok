// A bare path root is a name the module sees: a child, an
// import, or one of `rok::core`'s. `std` without `rok::` is none of them,
// and a sibling module's child is not visible without `sup::`.
use std::io;
use std::io::Stdin;
use inner::Hidden;
use Ordering::*;
use task::spawn;

mod a { pub mod inner { pub struct Hidden {} } }
mod b { use sup::a::inner::Hidden; }

fn main() -> i32 { return 0; }

// needs: threads
// expect-exit: 0
// expect-stdout:
// 2 1
// got 1

// Two clones of one list stored.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let c = thread::spawn(|| { let n: usize = 0; while let r: List<i32> = rx.recv() { n += r.len(); } n });
    let a: List<i32> = [1];
    let q: List<List<i32>> = [a.clone(), a.clone()];
    if let e: List<i32> = q.pop() { try! tx.send(e); }
    q[0].push(1);
    println(f"{q[0].len()} {a.len()}");
    tx.close();
    println(f"got {try! c.join()}");
}

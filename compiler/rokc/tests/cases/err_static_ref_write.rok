// spec: 005.03-static
// expect-error: 12:5: cannot call `set` on `S`: it takes `ref self`, and a static is never written
// expect-error: help: copy it into a variable and call `set` there: `let v = S; v.set(..);`

// A `ref self` method on a static would write to a copy that is
// dropped: an error.
struct Cell { v: i32; }
impl Cell { fn set(ref self, n: i32) { self.v = n; } }
static S: Cell = Cell { v: 0 };

fn main() {
    S.set(3);
    let v = S;
    v.set(4);
    println(f"{S.v} {v.v}");
}

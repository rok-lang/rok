// expect-exit: 0
// expect-stdout:
// 42 42 42 42 7
// 2147483647 -2147483648 1 1 255
// 0 1 255 1 3.140000104904175 A 65 1
// 3.140000104904175 212 42 caught
// 8 8 8 3000005

// `from` / `into`, saturating / wrapping, `as`, and literal conversions.
struct Celsius { degree: f64; }
struct Fahrenheit { degree: f64; }

impl From<Celsius> for Fahrenheit {
    fn from(c: Celsius) -> Fahrenheit {
        Fahrenheit { degree: c.degree * 9.0 / 5.0 + 32.0 }
    }
}

struct Port { n: i32; }

impl TryFrom<str> for Port {
    type Error = ValueError;
    fn try_from(s: str) throws (ValueError) -> Port {
        let n: i32 = try s.parse() catch _ { throw ValueError::new("not a port"); };
        if n < 0 || n > 65535 { throw ValueError::new("out of range"); }
        Port { n: n }
    }
}

fn widen<T, U: From<T>>(x: T) -> U { x.into() }

fn main() {
    let n: i32 = 42;
    let big: i64 = i64::from(n);
    let x: int = int::from(42i32);
    let b2: i64 = n.into();
    let b3: i64 = (42i32).into();
    let w: i64 = widen(7i32);
    println(f"{big} {x} {b2} {b3} {w}");
    let huge: i64 = 9999999999;
    let s1: i32 = huge.saturating_into();
    let neg: i64 = -9999999999;
    let s2: i32 = neg.saturating_into();
    let bits: i64 = 0x100000001;
    let w1: i32 = bits.wrapping_into();
    let w2: u8 = 257i32.wrapping_into();
    let w3: u8 = (-1i32).wrapping_into();
    println(f"{s1} {s2} {w1} {w2} {w3}");
    let m: i32 = 256;
    let f: f64 = 1.7;
    let f2: f32 = 3.14f64 as f32;
    println(f"{m as u8} {257 as u8} {-1i32 as u8} {f as i32} {f2 as f64} {65u8 as char} {'A' as u8} {('\u{101}' as u8)}");
    let z: f32 = 3.14;
    let c = Celsius { degree: 100.0 };
    let fh: Fahrenheit = c.into();
    let pt: Port = try "42".try_into() catch _ { Port { n: -1 } };
    let p = pt.n;
    let qp: Port = try "99999".try_into() catch _ { print(f"{z as f64} {fh.degree} {p} "); println("caught"); Port { n: 0 } };
    let q = qp.n;
    let a: i32 = 5;
    let b: i32 = 3;
    let sum: i32 = a + b;
    let e1: i64 = (a + b) as i64;
    let e2: i64 = (a + b).into();
    println(f"{sum} {e1} {e2} {a + b * 1000000 + q}");
}

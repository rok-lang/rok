// expect-exit: 10
// `!` (never): `panic`, `process::exit` and `loop {}` without `break` have
// type `!`, which fits any slot - no dead `return` after them.
// expect-stdout:
// 3 3 4
use rok::std::process;

fn pick(x: i32) -> i32 {
    if x > 0 {
        return x;
    }
    process::exit(x + 10);
}

fn first(x: i32 | none) -> i32 {
    let v: i32 = x ?? panic("none!");
    return v;
}

fn spin() -> ! { loop {} }

fn main() -> i32 {
    let a = pick(3);
    let b: i32 = if a > 100 { panic("big") } else { a };
    let c = match a { 3 => first(4), _ => spin() };
    let msg = "dyn";
    if a > 1000 { panic(msg); }
    println(f"{a} {b} {c}");
    if a == 3 { process::exit(a + b + c); }
    return 0;
}

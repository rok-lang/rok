// expect-exit: 0
// expect-stdout:
// depth 2000

// `async fn` recursion allocates a frame per call. The
// implementation note allows nested `await` to run on the native stack,
// so this stays at a modest depth that any implementation must handle.
async fn deep(n: i32) -> i32 {
    if n == 0 { 0 } else { 1 + await deep(n - 1) }
}

async fn main() {
    let d = await deep(2000);
    println(f"depth {d}");
}

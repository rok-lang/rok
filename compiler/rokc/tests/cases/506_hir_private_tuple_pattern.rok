// A tuple-struct pattern binding a private field from outside is an error.
// expect-error: field `0` of `a::S` is private to module `a`

mod a {
    pub struct S(i32, pub i32);
    pub fn mk() -> S { return S(1, 2); }
}

fn main() -> i32 {
    match a::mk() {
        a::S(x, _) => { return x; }
    }
}

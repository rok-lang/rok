// needs: threads
// expect-error: `q0` may hold one object twice
// List<any> holding one list twice, cast back.
use rok::std::thread;

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let a: List<i32> = [];
    let q0: List<any> = [];
    let x: any = a;
    let y: any = a;
    q0.push(x);
    q0.push(y);
    if let e0: any = q0.pop() { if let e: List<i32> = rok::core::reflect::cast::<List<i32>>(e0) { try! tx.send(e); } }
    if let f0: any = q0.pop() { if let f: List<i32> = rok::core::reflect::cast::<List<i32>>(f0) { for i in 0..200000 { f.push(i); } let _ = try! t.join(); println(f"len {f.len()}"); } }
}

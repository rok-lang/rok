// expect-exit: 0
// expect-stdout:
// i32 4 4 1
// Config List<i64> Box<f64>
// Sq
// 4
// none
// i32
// none
// Color
// Color
// (i32, f64)
// List<i32>
// f64 | i32/f64
// Sq/Sq
// 7

// `Reflect` on every type; a type's own method of the same name wins.
trait Shape { fn area(self) -> i32; }
struct Sq { s: i32; }
impl Shape for Sq { fn area(self) -> i32 { self.s * self.s } }
struct Config { port: i32; }
struct Box<T> { v: T; }
enum Color { Red, Green(i32) }
struct Own { n: i32; }
impl Own { fn size(self) -> i32 { 7 } }

fn describe<T: reflect::Reflect>(x: T) -> str { f"{T::type_name()}/{x.type_name_of()}" }
fn pick() -> i32 | f64 { return 2.5; }

println(f"{i32::type_name()} {i32::size()} {i32::align()} {u8::size()}");
println(f"{Config::type_name()} {List::<i64>::type_name()} {Box::<f64>::type_name()}");
let s: any Shape = Sq { s: 2 };
println(s.type_name_of());
println(f"{s.size_of()}");
let o: i32 | none = none;
let a: any = o;
println(a.type_name_of());
let o2: i32 | none = 3;
let a2: any = o2;
println(a2.type_name_of());
println(o.type_name_of());
let c = Color::Green(3);
println(c.type_name_of());
println(reflect::Reflect::type_name_of(c));
println((1, 2.0).type_name_of());
println([1, 2, 3].type_name_of());
let v: i32 | f64 = pick();
println(describe(v));
println(describe(Sq { s: 1 }));
println(f"{Own { n: 1 }.size()}");

// spec: 006.10-reflection
// spec: std §2.12.2
// spec: §6.10.1

// spec: std 209-collections §2.9.3
// expect-exit: 0
// expect-stdout:
// first insert none
// replaced 1
// len 2 empty false
// get c: none, contains c: true
// removed 3, again none
// keys 2 values 21
// entries a=10 b=11
// order-free eq true

// spec 2.9.3: `insert` returns the previous value (or none), `remove`
// returns the removed value, `keys` / `values` / `entries` iterate, and
// (common rules) Dicts compare independent of order.
fn show(v: i32 | none) -> str {
    match v { x: i32 => f"{x}", none => "none" }
}

fn main() {
    let d: Dict<str, i32> = Dict::new();
    println(f"first insert {show(d.insert("a", 1))}");
    println(f"replaced {show(d.insert("a", 10))}");
    d.insert("b", 11);
    println(f"len {d.len()} empty {d.is_empty()}");
    let g = show(d.get("c"));
    d.insert("c", 3);
    println(f"get c: {g}, contains c: {d.contains_key("c")}");
    let r = show(d.remove("c"));
    println(f"removed {r}, again {show(d.remove("c"))}");
    let nk = 0;
    for k in d.keys() { nk += 1; }
    let sv = 0;
    for v in d.values() { sv += v; }
    println(f"keys {nk} values {sv}");
    let a = 0;
    let b = 0;
    for (k, v) in d.iter() {
        if k == "a" { a = v; } else { b = v; }
    }
    println(f"entries a={a} b={b}");
    let e: Dict<str, i32> = {"b": 11, "a": 10};
    println(f"order-free eq {d == e}");
}

// expect-error: error[E0134]: `tx` was moved at line 15, and is used here
// expect-error: affine_struct_field_moves.rok:16:10: `tx` was moved at line 15, and is used here
// expect-error: affine_struct_field_moves.rok:19:10: `tx2` was moved at line 18, and is used here
// expect-error: affine_struct_field_moves.rok:23:10: `tx3` was moved at line 22, and is used here
// spec: std 213-marker §2.13.4

// Storing a resource into a struct, a tuple or a list moves it there.

use rok::core::channel::{Sender, channel};

struct Holder { tx: Sender<i32>; }

fn main() {
    let (tx, rx) = channel::<i32>();
    let h = Holder { tx: tx };
    try! tx.send(1);
    let (tx2, _rx2) = channel::<i32>();
    let pair = (tx2, 1);
    try! tx2.send(2);
    let (tx3, _rx3) = channel::<i32>();
    let senders: List<Sender<i32>> = [];
    senders.push(tx3);
    try! tx3.send(3);
    try! h.tx.send(4);
    try! pair.0.send(5);
    println(f"{rx.recv() ?? 0}");
}

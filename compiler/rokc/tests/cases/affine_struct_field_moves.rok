// Storing a resource into a struct, a tuple or a list moves it there.

use rok::core::channel::{Sender, channel};

struct Holder { tx: Sender<i32>; }

fn main() {
    let (tx, rx) = channel::<i32>();
    let h = Holder { tx: tx };
    try! tx.send(1);
    let (tx2, _rx2) = channel::<i32>();
    let pair = (tx2, 1);
    try! tx2.send(2);
    let (tx3, _rx3) = channel::<i32>();
    let senders: List<Sender<i32>> = [];
    senders.push(tx3);
    try! tx3.send(3);
    try! h.tx.send(4);
    try! pair.0.send(5);
    println(f"{rx.recv() ?? 0}");
}

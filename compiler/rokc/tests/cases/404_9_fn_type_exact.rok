// expect-error: 8:35: mismatched types: `let f` expects `fn(f64 | i32) -> i32`
// expect-error: 9:34: mismatched types: `let h` expects `fn() -> i32 | str`

// No fn subtyping - a sum never widens inside a fn type.
fn g() -> i32 { 3 }

fn main() {
    let f: fn(i32 | f64) -> i32 = |x: i32| x;
    let h: fn() -> (i32 | str) = g;
}

// expect-exit: 0
// gc-stress: 50
// expect-stdout:
// 5 16
// 3

// `b[i]` / `b[i] = v` / `b[i] += v` on a `GcBuf<T>` lower to the
// `rok.buf_get` / `rok.buf_set` primitives (unchecked, no call).
use rok::bare::mem::{GcBuf, buf_get, buf_new, buf_set};

struct Cell { meta: GcBuf<usize>; }

fn main() {
    unsafe {
        let b: GcBuf<usize> = buf_new(4);
        b[0] = 5;
        b[1] = b[0] + 1;
        b[1] += 10;
        println(f"{b[0]} {b[1]}");
        let c = Cell { meta: buf_new(2) };
        c.meta[1] = 3;
        println(f"{c.meta[1]}");
    }
}
// spec: std §2.9.12

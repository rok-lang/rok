// spec: refs-lang §4.6.9
// expect-error: 14:27: mismatched types: argument 1 of `thread::spawn` expects `fn() -> i32 + Send`, found `closure() -> i32` - the closure holds a `[ref ..]` capture, which the code that made it could change at the same time; share the value through a `Mutex` or an `Atomic` instead
// expect-error: 16:27: mismatched types: argument 1 of `thread::spawn` expects `fn() -> i32 + Send`, found `closure() -> i32` - the closure holds a `[ref ..]` capture, which the code that made it could change at the same time; share the value through a `Mutex` or an `Atomic` instead
// expect-error: 22:13: `task::spawn` needs a `Send` future: it has a `[ref m]` capture, which the code that made it could change at the same time, and the task may resume on another worker; use `task::spawn_local`

// A closure holding a `[ref]` cell stays on its thread however it gets
// there: bound to a name first, inside another closure, or through an
// `async` closure's future.
use rok::std::thread;

fn main() {
    let n = 0;
    let f = [ref n] || { n += 1; n };
    let a = thread::spawn(f);
    let g = || f();
    let b = thread::spawn(g);
    try! a.join();
    try! b.join();
    let m = 0;
    // Its future shares the closure's cell.
    let h = async [ref m] || { m += 1; };
    let t = task::spawn(h());
    println(f"{n} {m}");
}

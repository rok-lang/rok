// expect-exit: 0
// expect-stdout:
// 7
// 33 40
// 9 8
// 4 4
// 40 4
// 42
// 30 31 32 33
// 11 12
// drop outer 2
// drop inner 1
// 5

// `addr_of` points at the variable itself; `MaybeUninit`, `drop_in_place`.
use rok::bare::alloc::Allocation;
use rok::bare::mem::{MaybeUninit, drop_in_place};
use rok::bare::ptr::{ManyPtr, Ptr, addr_of, many_addr_of};

struct P { a: i64; b: (i32, i8); }

struct Inner { id: i64; }
impl Drop for Inner {
    fn drop(ref self) { println(f"drop inner {self.id}"); }
}
struct Outer { id: i64; inner: Inner; }
impl Drop for Outer {
    fn drop(ref self) { println(f"drop outer {self.id}"); }
}

fn bump(p: Ptr<i32>) { unsafe { p.write(p.read() + 1); } }

fn through<T>(v: T) -> T {
    let x = v;
    let p = addr_of(x);
    unsafe { p.read() }
}

fn main() -> i32 {
    let x = 5;
    let p = addr_of(x);
    unsafe { p.write(6); }
    bump(p);
    println(f"{x}");

    // Elements: the address follows the index; the variable sees writes.
    let arr: [i32; 4] = [10, 20, 30, 40];
    let calls = 0;
    let q = addr_of(arr[{ calls += 1; 2 }]);
    unsafe { q.write(33); }
    println(f"{arr[2]} {unsafe { q.add(1).read() }}");
    if calls != 1 { return 1; }

    // Fields, nested.
    let s = P { a: 1, b: (2, 3) };
    unsafe {
        addr_of(s.b.0).write(9);
        addr_of(s.b.1).write(8i8);
    }
    println(f"{s.b.0} {s.b.1}");
    let grid: [[i32; 3]; 2] = [[1, 2, 3], [4, 5, 6]];
    let g = addr_of(grid[1][0]);
    unsafe { g.add(2).write(4); }
    println(f"{grid[1][2]} {unsafe { g.read() }}");

    let m: ManyPtr<i32> = many_addr_of(arr[0]);
    let view = unsafe { m.slice(4) };
    println(f"{view[3]} {view.len()}");

    // Wait for the bytes, then take the value out.
    let slot: MaybeUninit<i64> = MaybeUninit::uninit();
    unsafe { slot.as_mut_ptr().cast::<i32>().write(42); }
    println(f"{unsafe { slot.assume_init() }}");

    // A slice over memory outside the GC.
    using block = try! Allocation::<u16>::new(4) {
        let raw = block.as_many();
        for i in 0usize..4 {
            unsafe { raw.write(i, 30u16 + i as u16); }
        }
        let v = unsafe { raw.slice(4) };
        println(f"{v[0]} {v[1]} {v[2]} {v[3]}");
    }

    let pair: MaybeUninit<(i64, i64)> = MaybeUninit::zeroed();
    pair.write((11, 12));
    let t = unsafe { pair.assume_init() };
    println(f"{t.0} {t.1}");

    let o = Outer { id: 2, inner: Inner { id: 1 } };
    unsafe { drop_in_place(addr_of(o)); }

    let unit = ();
    if addr_of(unit).addr() == 0 { return 2; }
    println(f"{through(5)}");
    if through("s") != "s" { return 3; }
    0
}

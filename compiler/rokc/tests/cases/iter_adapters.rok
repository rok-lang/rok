// expect-exit: 0
// expect-stdout:
// 24
// 3
// 15
// 6
// 2
// 10
// 4

// Iterator adapters on the collections' iterators: lazy
// `map` / `filter`, eager `sum` / `count` / `fold` / `collect`, and a
// user iterator getting the same defaults through a concrete impl.

struct Counter { left: List<i32>; }

impl Iterator for Counter {
    type Item = i32;
    fn next(self) -> i32 | none {
        return self.left.pop();
    }
}

fn double(x: i32) -> i32 { return x * 2; }
fn big(x: i32) -> bool { return x > 4; }

fn main() -> i32 {
    let xs: List<i32> = [1, 2, 3, 4, 5];
    println(f"{xs.iter().map(double).filter(big).sum()}");
    println(f"{xs.iter().filter(|x| x > 2).count() as i32}");
    println(f"{xs.iter().fold(0, |a, x| a + x)}");
    let ys: List<i32> = xs.iter().map(|x| x * 3).collect();
    println(f"{ys[1]}");
    let ones: List<i32> = [1, 1, 2];
    let s: Set<i32> = ones.iter().collect();
    println(f"{s.len() as i32}");
    let c = Counter { left: [1, 2, 3, 4] };
    println(f"{c.sum()}");
    let n = 0;
    let c2 = Counter { left: [7, 8, 9, 10] };
    for x in c2.filter(|x| x % 2 == 0) {
        n = n + 1;
    }
    println(f"{n * 2}");
    return 0;
}


// only-os: macos linux
// (`#[link("m")]`: no separate libm on Windows / wasm32)
// expect-exit: 0
// expect-stdout:
// Point { x: 1.0, y: 2.0 } true
// 3 7 2
// 5 5 1

// Outer `#[..]` and inner `#![..]` attributes in their three
// body forms (bare, arguments, key-value), on every item kind, several
// per item and on one line, in any order with visibility.
#[derive(Debug, Clone, PartialEq)]
#[repr(C)]
struct Point { x: f64; y: f64; }

mod m {
    #![allow(unused)]
    fn helper() -> i32 { 1 }
    pub fn three() -> i32 { 3 }
}

#[doc = "Seven, documented in key-value form."]
#[inline(always)]
fn seven() -> i32 { 7 }

#[inline] #[cold] fn rarely_called() -> i32 { 2 }

#[inline]
pub fn g() -> i32 { 5 }

#[inline] pub async fn h() -> i32 { 5 }

#[deprecated]
const OLD: i32 = 1;

#[derive(Debug)]
enum Kind {
    #[deprecated] Old,
    New,
}

#[deprecated]
trait T { fn t(self) -> i32; }

#[deprecated]
impl T for Point { fn t(self) -> i32 { 1 } }

#[link("m")]
extern "C" {
    fn fabs(x: f64) -> f64;
}

let p = Point { x: 1.0, y: 2.0 };
println(f"{p:?} {p.clone() == p}");
println(f"{m::three()} {seven()} {rarely_called()}");
let k = Kind::New;
println(f"{g()} {await h()} {OLD + 0 * unsafe { fabs(-1.0) } as i32}");

// expect-exit: 0
// expect-stdout:
// 1
// 0.5
// less
// equal
// greater

// Float modulo (`arith.remf`) and ordered comparisons (`arith.cmpf`).
fn main() -> i32 {
    println(f"{7.0f64 % 3.0f64}");    // 1
    println(f"{5.5f64 % 2.5f64}");    // 0.5

    let a = 1.0f64;
    let b = 2.0f64;
    if a < b      { println("less"); }
    if a == 1.0f64 { println("equal"); }
    if b > a      { println("greater"); }
    return 0;
}


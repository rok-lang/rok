// expect-exit: 0
// expect-stdout:
// squares 0 1 4 9 16
// odd-squares 1 9 25
// sum 35

// A generator is an `Iterator`, so it feeds other
// generators and the library adapters; an infinite generator is
// cut off by `take(n)`.
yield fn naturals() -> i32 {
    let i = 0;
    loop {
        yield i;
        i = i + 1;
    }
}

yield fn squares(limit: i32) -> i32 {
    for n in naturals() {
        if n >= limit { return; }
        yield n * n;
    }
}

fn main() -> i32 {
    let s = "squares";
    for x in squares(5) { s = s + f" {x}"; }
    println(s);

    let odd = naturals().filter(|x| x % 2 == 1).map(|x| x * x).take(3).collect::<List<i32>>();
    let o = "odd-squares";
    for x in odd { o = o + f" {x}"; }
    println(o);

    let total = 0;
    for x in naturals().map(|x| x * x).filter(|x| x % 2 == 1).take(3) { total = total + x; }
    println(f"sum {total}");
    return 0;
}

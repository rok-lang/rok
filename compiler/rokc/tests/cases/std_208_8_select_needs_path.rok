// spec: std 208-stream §2.8.8 / refs-lang 005.05 §5.5.6
// expect-error: name `select` is ambiguous in module `<root>` - multiple glob imports resolve it: rok::core::task::select, rok::core::stream::select

// stdlib 2.8.8 / refs-lang 5.5.6: `stream::select` and `task::select`
// both come in through the implicit `use rok::core::**;`, so a bare
// `select` is ambiguous (each item once, however many paths reach it);
// write `stream::select` / `task::select`.
async yield fn nums(n: i32) -> i32 {
    for i in 1..=n {
        yield i;
    }
}

async fn main() {
    for await _ in select(nums(2), nums(1)) {}
}

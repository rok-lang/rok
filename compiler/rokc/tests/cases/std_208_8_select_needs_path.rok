// `stream::select` and `task::select` are not in
// the prelude, so a bare `select` names neither; write the module path.
async yield fn nums(n: i32) -> i32 {
    for i in 1..=n {
        yield i;
    }
}

async fn main() {
    for await _ in select(nums(2), nums(1)) {}
}

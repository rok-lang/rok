// expect-error: a coroutine (`async` / `yield`) fn cannot take `ref` parameters

// A coroutine body runs after the call returns, so there is
// no point to write a `ref` parameter back.
yield fn count_up(ref n: i32) -> i32 { n += 1; yield n; }

let a = 1;
for v in count_up(ref a) { println(f"{v}"); }

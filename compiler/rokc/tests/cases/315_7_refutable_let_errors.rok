// expect-error: this pattern can't destructure a value of type `Sh` here - it must be irrefutable
// expect-error: 12:18: mismatched types: `let v` expects `i32`, found `i32 | none`
// expect-error: the pattern `b` expects `str`, found `i32`
// expect-error: 14:5: invalid assignment target

// `let` takes only irrefutable patterns (no `enum` variant,
// no type check on a sum). An annotation is a slot type that
// must match. No destructuring reassignment without `let`.
enum Sh { C(f64), R(f64) }
fn main() -> i32 {
    let x: i32 | none = 1;
    let v: i32 = x;
    let Sh::C(r) = Sh::C(1.0);
    (v, r) = (1, 2.0);
    let (a: i32, b: str) = (1, 2);
    return 0;
}

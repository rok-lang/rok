// needs: fs
// expect-exit: 0
// expect-stdout:
// 3 [hi!]

// `fn write<B: AsBytes>(self, data: B)` / `write_all<B: AsBytes>`
// on `File` accept a `str` as well as bytes (like `fs::write`).
use rok::std::fs;
use rok::core::io::IoError;
use rok::std::env;

fn main() throws (IoError) {
    let p = env::temp_dir() / "rok_probe_301w.txt";
    let f = try fs::create(p);
    let n = try f.write("hi");
    try f.write_all("!");
    try f.close();
    println(f"{n + 1} [{try fs::read_to_str(p)}]");
    try fs::remove_file(p);
}

// expect-exit: 0
// expect-stdout:
// i32 1
// i32 1
// i64 1
// i64 1
// i64 3000000000
// i32 2
// i64 5
// from 7 i32
// from 7 i64

// With `impl Add<i64>` and `impl Add<i32>` for one type, a method call
// selects the impl as the operator does: an unsuffixed literal takes the
// default type's impl, else the one it fits; a typed argument the impl
// of its type. Path calls select the same way.
struct W { v: i64; }

impl ops::Add<i64> for W {
    type Output = str;
    fn add(self, rhs: i64) -> str { f"i64 {rhs}" }
}

impl ops::Add<i32> for W {
    type Output = str;
    fn add(self, rhs: i32) -> str { f"i32 {rhs}" }
}

struct F { s: str; }
impl From<i64> for F { fn from(v: i64) -> F { F { s: f"from {v} i64" } } }
impl From<i32> for F { fn from(v: i32) -> F { F { s: f"from {v} i32" } } }

fn main() {
    let w = W { v: 0 };
    println(w.add(1));
    println(w + 1);
    println(w.add(1i64));
    println(w + 1i64);
    println(w.add(3000000000));
    println(W::add(w, 2));
    let k: i64 = 5;
    println(w.add(k));
    println(F::from(7).s);
    println(F::from(7i64).s);
}

// expect-error: 7:5: this block-like statement leaves a value of type `i32` without `;`

// A block-like statement ends without `;`, so its value would be
// dropped silently; it must be `()` (or end the block as its value).
fn f(c: bool) -> i32 {
    if c { println("unit"); } else {}
    if c { 1 } else { 2 }
    3
}

fn main() {
    println(f"{f(true)}");
}

// expect-error: 22:1: associated type `Label` = `NoDisp` does not implement `Display`, a bound of `Shape::Label`
// expect-error: 29:1: associated type `Label` = `T` does not implement `Display` for every `T` the impl allows, a bound of `Shape::Label`

// An impl's associated type must meet the bounds the trait declares on
// it (2.8.3), whether written or taken from the default; a generic
// impl's only through its parameters' bounds.

use rok::core::fmt::Display;

trait Shape {
    type Label: Display = str;
    fn label(self) -> Label;
}

struct NoDisp;
struct Sq;

impl Shape for Sq {
    fn label(self) -> str { "sq" }
}

impl Shape for NoDisp {
    type Label = NoDisp;
    fn label(self) -> NoDisp { NoDisp }
}

struct W<T> { t: T; }

impl<T> Shape for W<T> {
    type Label = T;
    fn label(self) -> T { self.t }
}

struct V<T> { t: T; }

impl<T: Display> Shape for V<T> {
    type Label = T;
    fn label(self) -> T { self.t }
}

fn main() -> i32 { return 0; }
// spec: refs-lang §2.8.3

// expect-exit: 0
// expect-stdout:
// local 3
// yielded 0 1 2

// A non-`Send` capture (`Cell`) is fine for `spawn_local`,
// which pins the task to the current worker; `yield_now` hands control
// to other ready tasks and resumes.
async fn main() {
    let c = Cell::new(0);
    let t = task::spawn_local(async {
        let v = c.get() + 1;
        c.set(v);
        await task::yield_now();
        v = c.get() + 2;
        c.set(v);
        c.get()
    });
    println(f"local {await t}");

    let log: List<i32> = [];
    let i = 0;
    while i < 3 {
        log.push(i);
        await task::yield_now();
        i = i + 1;
    }
    println(f"yielded {log[0]} {log[1]} {log[2]}");
}

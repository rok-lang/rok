// expect-exit: 9
// expect-stdout:
// 5 4 true


type Maybe = i32 | none;

fn pick(b: bool) -> Maybe {
    if b {
        return 5;
    }
    return none;
}

fn main() -> i32 {
    let a: Maybe = pick(true);
    let b: Maybe = pick(false);
    let x = a ?? -1;
    let y = b ?? 4;
    println(f"{x} {y} {b is none}");
    return x + y;
}

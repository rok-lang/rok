// needs: threads
// expect-error: `p.y` shares `p.x`, which was sent through a channel
// One object in two fields of a struct in a list.
use rok::std::thread;
struct P { x: List<i32>; y: List<i32>; }
fn mk(a: List<i32>, b: List<i32>) -> P { P { x: a, y: b } }
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let ps: List<P> = [];
    let a: List<i32> = [];
    ps.push(mk(a, a));
    if let p: P = ps.pop() {
        try! tx.send(p.x);
        for i in 0..200000 { p.y.push(i); }
        let _ = try! t.join();
        println(f"len {p.y.len()}");
    }
}

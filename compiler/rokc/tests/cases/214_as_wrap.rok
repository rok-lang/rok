// expect-exit: 0
// expect-stdout:
// 1
// -1

// `as i32` wraps (bit reinterpretation).
fn main() -> i32 {
    let big: i64 = 4294967297i64;       // 2^32 + 1
    let wrapped: i32 = big as i32;      // 2^32 + 1 wrap → 1
    println(f"{wrapped}");

    let neg_big: i64 = -1i64;
    let neg_wrap: i32 = neg_big as i32; // -1 reinterpreted → -1
    println(f"{neg_wrap}");
    return 0;
}


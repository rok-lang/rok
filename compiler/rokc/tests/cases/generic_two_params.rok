// expect-exit: 18
// expect-stdout:
// 7 8 15

struct KV<K, V> {
    key: K;
    value: V;
}

impl KV<i32, i32> {
    fn sum(self) -> i32 {
        self.key + self.value
    }
}

fn make_kv<K, V>(k: K, v: V) -> KV<K, V> {
    KV { key: k, value: v }
}

fn main() -> i32 {
    let p: KV<i32, i32> = make_kv(7, 8);
    println(f"{p.key} {p.value} {p.sum()}");
    return p.sum() + 3;
}


// run-env: ROKR_GC_EVAC=always
// expect-exit: 0
// expect-stdout:
// Secret { len: 5, .. } 5 104 [101, 108]
// set 7 true
// kept through collections: true
// zero after using: 5 true
// zero after wipe: 32 true
// copies share the wipe: true
// aead after wipe: true
// random secret: 32 true
// hkdf into a secret: 42 true

// `Secret` bytes never move, are zeroed on `wipe` / release, never printed.
use rok::core::crypto::{Secret, Aead, AeadAlgorithm, HashAlgorithm, constant_time_eq, hkdf};
use rok::std::random;
use rok::bare::gc;

fn all_zero(v: Slice<u8>) -> bool {
    let d = 0u8;
    for b in v { d |= b; }
    d == 0u8
}

fn main() {
    let s = Secret::new("hello");
    let v = s.as_bytes();
    println(f"{s:?} {s.len()} {s[0]} {s[1:3].to_list():?}");
    s[0] = 7u8;
    println(f"set {v[0]} {constant_time_eq(s, v)}");
    for _ in 0..3 { gc::collect(); }
    s[1] = 9u8;
    println(f"kept through collections: {v[1] == 9u8 && constant_time_eq(v, s)}");

    let seen = "".as_bytes();
    using k = Secret::new("abcde") {
        seen = k.as_bytes();
    }
    println(f"zero after using: {seen.len()} {all_zero(seen)}");

    let r = random::secret(32);
    let rv = r.as_bytes();
    let was_zero = all_zero(rv);
    r.wipe();
    println(f"zero after wipe: {rv.len()} {all_zero(rv) && !was_zero}");

    let c = s;
    s.wipe();
    println(f"copies share the wipe: {all_zero(c.as_bytes()) && all_zero(v)}");

    let key: List<u8> = [];
    for i in 0..16 { key.push(i as u8); }
    let a = try! Aead::new(AeadAlgorithm::Aes128Gcm, key);
    let b = a;
    let nonce: List<u8> = [];
    for _ in 0..12 { nonce.push(1u8); }
    let before = try! a.seal(nonce, "", "msg");
    a.wipe();
    println(f"aead after wipe: {!constant_time_eq(try! b.seal(nonce, "", "msg"), before)}");

    println(f"random secret: {random::secret(32).len()} {!all_zero(random::secret(32).as_bytes())}");
    let okm = try! hkdf::expand(HashAlgorithm::Sha256, hkdf::extract(HashAlgorithm::Sha256, "salt", "ikm"), "info", 42);
    let ov = okm.as_bytes();
    using o = okm {}
    println(f"hkdf into a secret: {ov.len()} {all_zero(ov)}");
}

// spec: std 221-crypto §2.21.5

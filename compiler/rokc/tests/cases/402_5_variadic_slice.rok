// expect-exit: 0
// expect-stdout:
// 0 1 39 3 123
// 2 3 3

// `xs: ...T` is a `Slice<T>`; plain arguments and
// array / `List` / tuple spreads mix in the variadic position, a
// variadic passes on with `..xs`, an array spread fills fixed
// parameters, and `...any` takes mixed types.
fn sum(xs: ...i32) -> i32 {
    let total = 0i32;
    for x in xs { total += x; }
    total
}
fn fwd(xs: ...i32) -> i32 { sum(..xs) }
fn view(xs: ...i32) -> Slice<i32> { xs }
fn three(a: i32, b: i32, c: i32) -> i32 { a * 100 + b * 10 + c }
fn count<T>(xs: ...T) -> usize { xs.len() }
fn log_all(xs: ...any) -> usize { xs.len() }
fn main() -> i32 {
    let arr: [i32; 3] = [1, 2, 3];
    let ys: List<i32> = [4, 5];
    let t = (7, 8);
    println(f"{sum()} {sum(1)} {sum(0, ..arr, ..ys, ..t, 9)} {fwd(1, 2)} {three(..arr)}");
    println(f"{count(1, 2)} {log_all(1, "hi", 3.5)} {view(1, 2, 3).len()}");
    return 0;
}

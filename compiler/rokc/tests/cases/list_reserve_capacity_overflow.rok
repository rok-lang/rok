// expect-exit: 101
// expect-stdout: ok
// expect-stderr: thread 'main' panicked at tests/cases/list_reserve_capacity_overflow.rok:13:5:
// expect-stderr: capacity overflow

// Collection growth checks its arithmetic at every opt level: `len +
// additional` past `usize::MAX` panics instead of wrapping to a small
// buffer that later writes would overrun.
fn main() {
    let xs: List<i64> = [1, 2, 3];
    xs.reserve(10);
    println("ok");
    xs.reserve(usize::MAX);
    println("unreachable");
}

fn parse(s: str) throws -> i32 {
    let n = try s.parse::<i32>();
    if n < 0 { return Err("negative"); }
    Ok(n)
}

fn done() throws { Ok(()) }

fn ports(s: str) {
    let a = parse(s).unwrap();
    let b = parse(s).expect("bad port");
}


use std::collections::HashMap;

struct Point { x: i32; }
struct Node { next: Box<Node> | none; }

fn sizes(a: Vec<i32>, b: String, c: HashMap<str, i32>, d: Arc<Mutex<i32>>) {}

fn make() {
    let v: List<i32> = Vec::new();
    let s = String::from("x");
    let p = Point { x: 1 };
    let shared = Rc::new(RefCell::new(p));
    crate::geo::dist();
}

mod geo {

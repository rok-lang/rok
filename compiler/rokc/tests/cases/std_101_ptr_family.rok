// expect-exit: 0
// expect-stdout:
// ptr is a word: true
// 40 30
// with_addr: 20 exposed: 50
// const: 10 const_cast: 11
// null: true 0 none
// malloc: 42
// from_const: false
// many: 30 one: 11
// from_addr: true

// The pointer kinds and the conversions between them.
use rok::bare::mem::size_of;
use rok::bare::ptr::{CPtr, ConstPtr, ManyPtr, Ptr, addr_of, expose_provenance, from_exposed_provenance};

extern "C" {
    fn malloc(size: usize) -> CPtr<u8>;
    fn free(ptr: CPtr<u8>);
}

fn main() {
    println(f"ptr is a word: {size_of::<Ptr<i32>>() == size_of::<usize>()}");

    // Arithmetic over a local array.
    let arr: [i32; 5] = [10, 20, 30, 40, 50];
    let p: Ptr<i32> = addr_of(arr[0]);
    let p3 = p.add(3);
    println(f"{unsafe { p3.read() }} {unsafe { p3.sub(1).read() }}");
    let q = p.with_addr(p.addr() + 4);
    let exposed: usize = expose_provenance(p.add(4));
    let r: Ptr<i32> = unsafe { from_exposed_provenance(exposed) };
    println(f"with_addr: {unsafe { q.read() }} exposed: {unsafe { r.read() }}");

    // Adding const is safe, removing it is an explicit
    // named cast (a safe fn: only the write is unsafe).
    let c: ConstPtr<i32> = p.as_const();
    let m: Ptr<i32> = rok::bare::const_cast(c);
    unsafe { m.write(11); }
    println(f"const: 10 const_cast: {unsafe { c.read() }}");

    // CPtr is nullable itself.
    let n: CPtr<u8> = CPtr::null();
    println(f"null: {n.is_null()} {n.addr()} {match n.as_ptr() { _: Ptr<u8> => "ptr", none => "none" }}");
    let buf: CPtr<u8> = unsafe { malloc(16) };
    match buf.as_ptr() {
        b: Ptr<u8> => {
            unsafe { b.write(42u8); }
            println(f"malloc: {unsafe { b.read() }}");
        }
        none => panic("malloc failed"),
    }
    unsafe { free(buf) };
    println(f"from_const: {CPtr::from_const(c).is_null()}");

    // Ptr ↔ ManyPtr, usize → CPtr.
    let many: ManyPtr<i32> = p.as_many();
    let one: Ptr<i32> = many.as_one();
    println(f"many: {unsafe { many.read(2) }} one: {unsafe { one.read() }}");
    let back: CPtr<i32> = CPtr::from_addr(p.addr());
    println(f"from_addr: {back.addr() == p.addr()}");
}

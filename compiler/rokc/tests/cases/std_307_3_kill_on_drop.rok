// spec: std 307-process §3.7.3 §3.7.4
// needs: process
// expect-exit: 0
// expect-stdout:
// status: true
// output: [from child]
// on drop: killed fast: true
// kept: still running

// stdlib 3.7.3: `status` / `output`, and a `kill_on_drop` child bound
// with `using` is killed and reaped when the block ends; a child outside
// `using` is not.
use rok::core::marker::share;
use rok::std::process::{Command, ExitStatus, Stdio};
use rok::std::env;
use rok::std::io::IoError;
use rok::std::thread;
use rok::std::time::{Duration, Instant};

fn main() throws (IoError) {
    let args = env::args();
    if args.len() > 1 {
        if args[1] == "sleep" { thread::sleep(Duration::secs(30)); }
        print("from child");
        return;
    }
    let me = args[0];

    let status = try Command::new(me).arg("ok").stdout(Stdio::Null).status();
    println(f"status: {status.success()}");
    let out = try Command::new(me).arg("ok").output();
    println(f"output: [{try! str::from_utf8(out.stdout)}]");

    let start = Instant::now();
    let c = try Command::new(me).arg("sleep").kill_on_drop(true).spawn();
    using guard = unsafe { share(c) } {
        thread::sleep(Duration::ms(20));
    }
    let st = try c.try_wait();
    let how = match st {
        none => "running",
        s: ExitStatus => if s.success() { "exited" } else { "killed" },
    };
    println(f"on drop: {how} fast: {start.elapsed() < Duration::secs(20)}");

    let plain = try Command::new(me).arg("sleep").kill_on_drop(true).spawn();
    thread::sleep(Duration::ms(20));
    println(f"kept: {if (try plain.try_wait()) is none { "still running" } else { "ended" }}");
    try plain.kill();
    try plain.wait();
}

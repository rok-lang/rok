// expect-exit: 0
// expect-stdout:
// [7, 12] [52, 28]
// [11, 22, 33] [11, 22, 33]
// [false, false] calls=2

// A user type gets `.+` / `.*` by implementing the Dot
// traits, separately from `*` (`m * n` and `m .* n` differ).
// `a .+ b .* c` is `a .+ (b .* c)`, `.+` groups from the left.
// `.&&` does not short-circuit; both operands run.
struct Vec2 { a: i32; b: i32; }

impl ops::DotAdd for Vec2 {
    type Output = Vec2;
    fn dot_add(self, rhs: Vec2) -> Vec2 { Vec2 { a: self.a + rhs.a, b: self.b + rhs.b } }
}
impl ops::DotMul for Vec2 {
    type Output = Vec2;
    fn dot_mul(self, rhs: Vec2) -> Vec2 { Vec2 { a: self.a * rhs.a, b: self.b * rhs.b } }
}
// `*` on the same type: a dot product, not element-wise.
impl ops::Mul for Vec2 {
    type Output = i32;
    fn mul(self, rhs: Vec2) -> i32 { self.a * rhs.a + self.b * rhs.b }
}

fn show(v: Vec2) -> str { f"[{v.a}, {v.b}]" }

fn main() -> i32 {
    let x = Vec2 { a: 1, b: 2 };
    let y = Vec2 { a: 3, b: 5 };
    let z = Vec2 { a: 2, b: 2 };
    println(f"{show(x .+ y .* z)} {show((x .+ y) .* Vec2 { a: x * y, b: 4 })}");
    let p: List<i32> = [1, 2, 3];
    let q: List<i32> = [10, 20, 30];
    let r: List<i32> = [0, 0, 0];
    println(f"{p .+ q .+ r:?} {p .+ (q .+ r):?}");
    let calls = 0;
    let t = [ref calls] || -> List<bool> { calls += 1; return [true, false]; };
    let none_true: List<bool> = [false, false];
    let both = none_true .&& t();
    let again = t() .&& none_true;
    println(f"{both:?} calls={calls}");
    if again.len() != 2 { return 1; }
    return 0;
}

// spec: std §2.2.7
// expect-exit: 0
// expect-stdout:
// true false 5

// Stdlib 2.2.7: `NonZero::new` in const position is evaluated at
// compile time (`none` for 0).
const A: num::niche::NonZero<i32> | none = num::niche::NonZero::new(0);
const B: num::niche::NonZero<i32> | none = num::niche::NonZero::new(5);
const C: num::niche::NonZero<i32> = num::niche::NonZero::new(5) ?? panic("zero");

fn main() {
    println(f"{A is none} {B is none} {C}");
}

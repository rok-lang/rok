// expect-exit: 1
// expect-stderr: error: `main` returned an uncaught error: bad 7
// expect-stderr: --> tests/cases/416_entry_top_try.rok:21:13
// expect-stdout:
// 1

// The implicit `main` is `fn main() throws`; an error a
// top-level `try` lets escape is printed (Display) and exits 1.
struct Bad { n: i32; }
impl Display for Bad { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"bad {self.n}") } }
impl Debug for Bad { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Bad") } }
impl Error for Bad {}

fn parse(x: i32) throws (Bad) -> i32 {
    if x > 0 { throw Bad { n: x }; }
    return 1;
}

let a = try parse(0);
println(f"{a}");
let b = try parse(7);
println(f"{b}");

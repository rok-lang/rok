// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/slice_step_zero_panics.rok:11:16:
// expect-stderr: slice step must not be zero
// expect-stdout: [1, 2, 3, 4, 5]

// Bounds clamp, but a zero step panics (Python's ValueError).
fn main() {
    let xs: List<i32> = [1, 2, 3, 4, 5];
    println(f"{xs[-10:100]:?}");
    let k: isize = 0;
    println(f"{xs[: :k]:?}");
}


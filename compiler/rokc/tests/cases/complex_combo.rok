// expect-exit: 50
// expect-stdout:
// 23 10 4

const N: i32 = 4;

struct Point {
    x: i32;
    y: i32;
}

impl Point {
    fn area(self) -> i32 {
        self.x * self.y
    }
}

fn fold<T>(xs: [T; 4], init: T, f: fn(T, T) -> T) -> T {
    let acc = init;
    for v in xs {
        acc = f(acc, v);
    }
    return acc;
}

fn main() -> i32 {
    let shapes: [Point; 3] = [
        Point { x: 3, y: 4 },
        Point { x: 2, y: 5 },
        Point { x: 1, y: 1 },
    ];
    let total = 0;
    for s in shapes {
        total += s.area();
    }
    let nums: [i32; 4] = [1, 2, 3, 4];
    let sum = fold(nums, 0, |a: i32, b: i32| -> i32 { a + b });
    println(f"{total} {sum} {N}");
    return total + sum + N + 13;
}

// spec: 002.14-cast-and-conversion
// expect-exit: 0
// expect-lint: 11:13 `x as bool` truncates first: `0.5 as bool` is false, `1.5 as bool` is true
// expect-lint: 12:13 `(x - 1.0) as bool` truncates first: `0.5 as bool` is false, `1.5 as bool` is true
// expect-warning: help: compare instead: `x != 0.0`
// expect-stdout: false true true true false

// A float `as bool` truncates toward zero first; an integer is `x != 0`.
fn main() {
    let x = 0.5;
    let a = x as bool;
    let b = (x - 1.0) as bool;
    let n = -1;
    println(f"{a} {x != 0.0} {n as bool} {2 as bool} {b}");
}

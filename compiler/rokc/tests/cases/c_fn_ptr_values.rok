// `extern "C" fn(..)` values: a rok `extern "C" fn` and a C
// declaration (`abs`) as C function pointers, called from rok.
// expect-exit: 0
// expect-stdout: 7 5 6

extern "C" {
    fn abs(x: i32) -> i32;
}

extern "C" fn add(a: i32, b: i32) -> i32 { a + b }

fn apply(f: extern "C" fn(i32, i32) -> i32, a: i32, b: i32) -> i32 { f(a, b) }

fn main() -> i32 {
    let g: unsafe extern "C" fn(i32) -> i32 = abs;
    let n = unsafe { g(-5) };
    let opt: (extern "C" fn(i32, i32) -> i32) | none = add;
    let m = match opt { none => 0, h: extern "C" fn(i32, i32) -> i32 => h(1, 5) };
    println(f"{apply(add, 3, 4)} {n} {m}");
    return 0;
}

// needs: threads
// expect-error: `x` was sent through a channel
// clear() through one name, then the old element read via an earlier read.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let q: List<List<i32>> = [[]];
    let x = q[0];
    try! tx.send(q[0]);
    q.clear();
    for i in 0..200000 { x.push(i); }
    let _ = try! t.join();
    println(f"len {x.len()}");
}

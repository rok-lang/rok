// expect-exit: 0
// expect-stdout:
// 1
// 3
// 1
// 3
// 2 9
// 0
// 4

// `return@name` ends one call of the trailing closure of a call to `name`:
// a function's last path segment or a method's name. With
// a value it returns that value from the closure. A bare `return` is
// fine in a closure passed in parentheses, in one that is not a
// statement's trailing closure and in a closure nested inside.
fn each(xs: List<i32>, f: fn(i32) -> ()) { for x in xs { f(x); } }
fn first(xs: List<i32>, f: fn(i32) -> bool) -> i32 { for x in xs { if f(x) { return x; } } -1 }

struct Bag { xs: List<i32>; }

impl Bag {
    fn visit(self, f: fn(i32) -> ()) { for x in self.xs { f(x); } }
}

fn run(f: fn() -> ()) { f(); }

fn main() {
    let xs: List<i32> = [1, 2, 3];
    each(xs) |x| {
        if x == 2 { return@each; }
        println(f"{x}");
    }
    each(xs, |x| { if x == 2 { return; } println(f"{x}"); });
    let n = first(xs) |x| { if x > 1 { return@first true; } false };
    let m = first(xs) |x| { if x > 8 { return true; } false };
    println(f"{n} {9 + m + 1}");
    Bag { xs: [0, 5] }.visit() |x| {
        if x > 0 { return@visit; }
        println(f"{x}");
    }
    run {
        let skip = |x: i32| { if x == 0 { return; } };
        skip(0);
        match xs.len() {
            3 => return@run,
            _ => {}
        }
        println("not here");
    }
    println(f"{xs.len() + 1}");
}

// needs: threads
// expect-error: `side` shares the value the `Mutex` protects
// update's closure stores the guarded value into a captured list.
use rok::std::thread;
static M: Mutex<List<i32>> = Mutex::new([]);
fn main() {
    let side: List<List<i32>> = [];
    using g = M.lock() { g.update(|v: List<i32>| { side.push(v); v }); }
    let t = thread::spawn(|| { for i in 0..200000 { using g = M.lock() { g.get().push(i); } } 0 });
    for i in 0..200000 { side[0].push(i); }
    let _ = try! t.join();
    println(f"len {side[0].len()}");
}

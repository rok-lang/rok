// needs: threads
// expect-error: `q` may hold one object twice, and one of them was handed to another owner
// collect from a callback returning one object for several items:
// the list holds `a` twice but is not seen as a duplicate.
use rok::std::thread;

fn main() {
    let a: List<i32> = [];
    let q: List<List<i32>> = (0..2).map(|_i: i32| a).collect::<List<List<i32>>>();
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| {
        if let l: List<i32> = rx.recv() {
            for i in 0..200000 { l.push(i); }
        }
        0
    });
    if let e: List<i32> = q.pop() { try! tx.send(e); }
    let n: usize = 0;
    if let f: List<i32> = q.pop() {
        for i in 0..200000 { f.push(i); }
        let _ = try! t.join();
        n = f.len();
    }
    println(f"len {n} (400000 = one list touched by two threads)");
}

// spec: std 307-process §3.7.5 §3.7.6
// needs: process
// only-os: windows
// expect-exit: 0
// expect-stdout:
// Unsupported: kill: Windows can send only Signal::Kill, not Signal::Terminate
// cannot handle signal User1 (os error 50)
// interrupt: ok

// Windows sends only `Kill` and handles only `Interrupt` and `Hangup`;
// the rest is an error, not a silent no-op.
use rok::std::process;
use rok::std::process::Signal;

fn main() {
    try process::send_signal(process::id(), Signal::Terminate) catch e { println(f"{e.kind():?}: {e}"); };
    try process::on_signal(Signal::User1, || {}) catch e { println(f"{e}"); };
    try process::on_signal(Signal::Interrupt, || {}) catch e { println(f"{e}"); };
    println("interrupt: ok");
}

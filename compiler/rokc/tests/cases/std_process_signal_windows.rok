// needs: process
// only-os: windows
// expect-exit: 0
// expect-stdout:
// Unsupported: send_signal: Windows can send only Signal::Kill, not Signal::Terminate
// cannot handle signal User1 (os error 50)
// interrupt: ok
// Unsupported: raise: Windows can raise only Signal::Interrupt and Signal::Hangup, not Signal::Terminate
// break: ok

// Windows sends only `Kill`, handles and raises only `Interrupt` and
// `Hangup`, Ctrl-Break through `os::windows::process`; the rest is an
// error, not a silent no-op.
use rok::std::process;
use rok::std::process::Signal;
use rok::std::os::windows::process::on_ctrl_break;

fn main() {
    try process::send_signal(process::id(), Signal::Terminate) catch e { println(f"{e.kind():?}: {e}"); };
    try process::on_signal(Signal::User1, || {}) catch e { println(f"{e}"); };
    try process::on_signal(Signal::Interrupt, || {}) catch e { println(f"{e}"); };
    println("interrupt: ok");
    try process::raise(Signal::Terminate) catch e { println(f"{e.kind():?}: {e}"); };
    try on_ctrl_break(|| {}) catch e { println(f"{e}"); };
    println("break: ok");
}

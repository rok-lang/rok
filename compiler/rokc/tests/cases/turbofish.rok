// expect-exit: 0
// expect-stdout:
// 5 2.5 7 3 9

// Explicit generic arguments: `f::<T>(..)`,
// `x.m::<T>(..)`, `Type::<T>::assoc(..)`, `id::<i32>` as a value. They
// override inference; a partial list leaves the rest to inference.
fn id<T>(x: T) -> T { return x; }
fn pick<A, B>(a: A, b: B) -> B { return b; }
fn zero<T>() -> T | none { return none; }

struct Boxed<T> { v: T; }
impl<T> Boxed<T> {
    fn make(v: T) -> Boxed<T> { return Boxed { v: v }; }
    fn get(self) -> T { return self.v; }
    fn map_to<U>(self, u: U) -> U { return u; }
}

fn main() -> i32 {
    let a = id::<i64>(5);                       // literal becomes i64
    let a2: i64 = a;
    let b = pick::<i32>(1, 2.5);                // B inferred
    let f = id::<i32>;
    let c = f(7);
    let n: i32 | none = zero::<i32>();
    let bx = Boxed::<u8>::make(3);
    let d: u8 = bx.get();
    let e = bx.map_to::<i64>(9);
    println(f"{a2} {b} {c} {d} {e}");
    if a2 != 5i64 || b != 2.5 || c != 7 || d != 3u8 || e != 9i64 { return 1; }
    return n ?? 0;
}


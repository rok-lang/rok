// needs: threads
// expect-error: `all` still holds `s`, which was handed to another owner
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<StrBuf>();
    let t = thread::spawn(|| { if let b: StrBuf = rx.recv() { for _ in 0..200000 { b.push_str("x"); } } 0 });
    let s = StrBuf::new();
    let all: List<StrBuf> = [s];
    try! tx.send(s);
    for _ in 0..200000 { all[0].push_str("y"); }
    let _ = try! t.join();
    println(f"len {all[0].len()}");
}

// expect-exit: 0
// expect-stdout:
// ns 1 us 1000 ms 1000000 sec 1000000000
// min 60000000000 hours 3600000000000
// elapsed nonnegative true

// `Duration` constructors in ns units; `Instant::elapsed` is
// monotonic.
fn main() {
    println(f"ns {Duration::ns(1).as_ns()} us {Duration::us(1).as_ns()} ms {Duration::ms(1).as_ns()} sec {Duration::secs(1).as_ns()}");
    println(f"min {Duration::mins(1).as_ns()} hours {Duration::hours(1).as_ns()}");
    let t = Instant::now();
    println(f"elapsed nonnegative {t.elapsed().as_ns() >= 0}");
}

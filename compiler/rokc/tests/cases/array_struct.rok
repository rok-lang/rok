// expect-exit: 30
// expect-stdout:
// 21 5 6

struct Pair {
    a: i32;
    b: i32;
}

fn main() -> i32 {
    let xs: [Pair; 3] = [
        Pair { a: 1, b: 2 },
        Pair { a: 3, b: 4 },
        Pair { a: 5, b: 6 },
    ];
    let total = 0;
    let i = 0;
    while i < 3 {
        total += xs[i].a + xs[i].b;
        i += 1;
    }
    println(f"{total} {xs[2].a} {xs[2].b}");
    return total + 9;
}

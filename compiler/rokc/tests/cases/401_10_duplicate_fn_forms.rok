// One name, one function: no overloading by arity, async or generics;
// a const, a static and a fn share the value namespace. The error
// points at both and says what to write instead.
// expect-error: 18:1: function `post_later` is defined more than once
// expect-error: first defined here
// expect-error: help: rename one of them, e.g. `post_later2`; there is no overloading, so to take fewer arguments keep one and give its last parameters defaults, as in `b: i32 = 0`
// expect-error: 23:1: function `add` is defined more than once
// expect-error: 26:1: function `pick` is defined more than once
// expect-error: 30:9: function `inner::f` is defined more than once
// expect-error: 34:1: `K` is defined more than once, as a const and as a static
// expect-error: help: rename one of them, e.g. `K2`
// expect-error: 36:1: `S` is defined more than once, as a static and as a function
// expect-error: 38:1: `C` is defined more than once, as a const and as a function

async fn post_later(a: i32) -> i32 {
    return a;
}
async fn post_later(a: i32, b: i32) -> i32 {
    return a + b;
}

fn add(x: i32, y: i32) -> i32 { x + y }
fn add(x: f64, y: f64) -> f64 { x + y }

fn pick<T>(a: T) -> T { a }
fn pick(a: i32, b: i32) -> i32 { a + b }

mod inner {
    pub fn f() -> i32 { 1 }
    pub fn f(a: i32) -> i32 { a }
}

const K: i32 = 1;
static K: i32 = 2;
static S: i32 = 3;
fn S() -> i32 { 4 }
const C: i32 = 5;
fn C() -> i32 { 6 }

async fn main() -> i32 {
    return await post_later(1);
}

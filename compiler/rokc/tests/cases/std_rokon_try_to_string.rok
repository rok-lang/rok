// spec: std 309-rokon §3.9.3 §3.9.4
// expect-exit: 0
// expect-stdout:
// Conf { a: 1, b: 2.5, tags: ["x"] }
// at .b: NaN/infinity has no ROKON form
// at [1][0]: NaN/infinity has no ROKON form
// 1:22: unknown field `c` in Conf
// Item { v: 1 }

// `try_to_string` throws where `to_string` panics: on a NaN or infinite
// float, with its path. `#[rokon(deny_unknown_fields)]` says what reads
// already do today (an unknown field is an error) and keeps it so.
use rok::std::rokon;

#[derive(Rokon)]
#[rokon(deny_unknown_fields)]
struct Conf { a: i32; b: float; tags: List<str>; }

#[derive(Rokon)]
struct Item { v: i32; }

fn main() {
    println(try! rokon::try_to_string(Conf { a: 1, b: 2.5, tags: ["x"] }));
    try rokon::try_to_string(Conf { a: 1, b: 0.0 / 0.0, tags: [] }) catch e { println(f"{e}"); "" };
    let rows: List<List<float>> = [[1.0], [1.0 / 0.0]];
    try rokon::try_to_string(rows) catch e { println(f"{e}"); "" };
    try rokon::from_str::<Conf>("Conf { a: 1, b: 2.0, c: 3, tags: [] }") catch e {
        println(f"{e}");
        Conf { a: 0, b: 0.0, tags: [] }
    };
    println(rokon::to_string(Item { v: 1 }));
}

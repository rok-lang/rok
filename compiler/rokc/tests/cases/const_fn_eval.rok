// `const fn` calls run at compile time in const
// items, array lengths and const generic arguments; control flow,
// recursion, structs, enums and sums all evaluate.
// expect-exit: 0
// expect-stdout:
// 6 12 3628800 55
// 16 4
// 7 -3
// 2 1
// 120 true
// 4096
struct Pt {
    x: i32;
    y: i32;
}

enum Shape {
    Circle(i32),
    Rect(i32, i32),
}

const fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

const fn fact(n: i64) -> i64 {
    let acc: i64 = 1;
    let i: i64 = 2;
    while i <= n {
        acc = acc * i;
        i = i + 1;
    }
    acc
}

const fn fib(n: i32) -> i32 {
    let a = 0;
    let b = 1;
    for _ in 0..n {
        let t = a + b;
        a = b;
        b = t;
    }
    a
}

const fn cells(w: usize, h: usize) -> usize {
    w * h
}

const fn mirror(p: Pt) -> Pt {
    Pt { x: p.y, y: -p.x }
}

const fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
    }
}

const fn first_even(xs: [i32; 4]) -> i32 | none {
    for x in xs {
        if x % 2 == 0 {
            return x;
        }
    }
    none
}

const fn id<T>(x: T) -> T { x }

const SIX: i64 = gcd(24, 18) / 1;
const TWELVE: i64 = gcd(24, 36);
const F10: i64 = fact(10);
const FIB10: i32 = fib(10);
const N: usize = cells(4, 4);
const P: Pt = mirror(Pt { x: 3, y: 7 });
const RECT: i32 = area(Shape::Rect(2, 1));
const CIRCLE: i32 = area(Shape::Circle(1)) / 3;
const EVEN: i32 | none = first_even([1, 3, 120, 5]);
const BIG: i64 = id(1i64 << 12);

struct Grid<const W: usize> {
    cells: [i32; W];
}

fn main() -> i32 {
    let buf: [u8; N] = [0; N];
    let g: Grid<{ cells(2, 2) }> = Grid { cells: [1, 2, 3, 4] };
    println(f"{SIX} {TWELVE} {F10} {FIB10}");
    println(f"{buf.len()} {g.cells.len()}");
    println(f"{P.x} {P.y}");
    println(f"{RECT} {CIRCLE}");
    match EVEN {
        v: i32 => println(f"{v} {v == 120}"),
        none => println("none"),
    }
    println(f"{BIG}");
    // A const fn is an ordinary function at run time too.
    let n: i64 = 5;
    if fact(n) != 120 {
        return 1;
    }
    return 0;
}


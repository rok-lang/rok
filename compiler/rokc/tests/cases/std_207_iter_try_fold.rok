// expect-exit: 0
// expect-stdout:
// try_fold 6 err -3 empty 10
// try_for_each [1, 2] err -3 visited 3
// closure 3 err -1

// `try_fold` / `try_for_each` take a throwing `f`: the first error stops
// the loop (later items are not visited) and is thrown to the caller.

struct Neg {
    at: i32;
}

fn add_pos(acc: i32, x: i32) throws (Neg) -> i32 {
    if x < 0 {
        throw Neg { at: x };
    }
    acc + x
}

fn main() {
    let ok = try [1, 2, 3].iter().try_fold(0, add_pos) catch e { e.at };
    let bad = try [1, 2, -3, -4].iter().try_fold(0, add_pos) catch e { e.at };
    let none_: List<i32> = [];
    let empty = try none_.iter().try_fold(10, add_pos) catch e { e.at };
    println(f"try_fold {ok} err {bad} empty {empty}");

    let seen: List<i32> = [];
    let visited = [0];
    let err = [0];
    try [1, 2, -3, 4].iter().try_for_each(|x: i32| {
        visited[0] = visited[0] + 1;
        try add_pos(0, x);
        seen.push(x);
    }) catch e { err[0] = e.at; };
    println(f"try_for_each {seen:?} err {err[0]} visited {visited[0]}");

    let c = try (1..3).try_fold(0, |a: i32, x: i32| try add_pos(a, x)) catch e { e.at };
    let d = try (0..5).map(|x| 2 - x * 3).try_fold(0, |a: i32, x: i32| try add_pos(a, x)) catch e { e.at };
    println(f"closure {c} err {d}");
}

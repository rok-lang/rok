// expect-exit: 0
// expect-stdout:
// 4096 7
// 2000
// 40 hi
// 3

// A long `[v; N]` fills its elements with a loop.
fn sum<const N: usize>(a: [i32; N]) -> i32 {
    let s = 0;
    for i in 0..N { s = s + a[i]; }
    return s;
}

fn main() -> i32 {
    let big = [7; 4096];
    println(f"{sum(big) / 7} {big[4095]}");
    let f: [i64; 1000] = [2; 1000];
    let t = 0i64;
    for i in 0..1000 { t = t + f[i]; }
    println(f"{t}");
    // GC references keep the unrolled form.
    let words = ["hi"; 40];
    println(f"{40} {words[39]}");
    let small = [1; 3];
    println(f"{sum(small)}");
    return 0;
}

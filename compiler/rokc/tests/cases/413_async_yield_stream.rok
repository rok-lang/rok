// expect-exit: 0
// expect-stdout:
// for-await 0 1 2 3
// adapters 4 16 36
// skip 2 3

// `async yield fn` makes an `AsyncStream`, consumed with
// `for await`; each step may `await` before it yields. The
// `map` / `filter` / `take` / `skip` / `collect` adapters.
async yield fn nums(n: i32) -> i32 {
    let i = 0;
    while i < n {
        await task::yield_now();
        yield i;
        i = i + 1;
    }
}

async fn main() {
    let s = "for-await";
    for await x in nums(4) { s = s + f" {x}"; }
    println(s);

    let xs = await nums(10).filter(|x| x % 2 == 0 && x > 0).map(|x| x * x).take(3).collect();
    println(f"adapters {xs[0]} {xs[1]} {xs[2]}");

    let ys = await nums(4).skip(2).collect();
    println(f"skip {ys[0]} {ys[1]}");
}

// expect-exit: 0
// expect-stdout:
// a=2 b=1

// `fn entry(self, k: K) -> Entry<K, V>; // or_insert / and_modify`.
fn main() {
    let d: Dict<str, i32> = Dict::new();
    for w in ["a", "b", "a"] {
        d.entry(w).and_modify(|v: i32| v + 1).or_insert(1);
    }
    println(f"a={d["a"]} b={d["b"]}");
}

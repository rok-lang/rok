// needs: threads

// A guard's view is neither `Send` nor `Sync`: it can't be sent through a
// channel, captured by a spawned task or thread, or kept in a
// thread-local. A deep copy (`get_clone()`) can.
use rok::std::thread;

static M: Mutex<List<i32>> = Mutex::new([]);
static TL: thread::ThreadLocal<List<List<i32>>> = thread::local(|| -> List<List<i32>> { [] });

fn remember(xs: List<i32>) { TL.with(|l| l.push(xs)); }

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    using g = M.lock() { try! tx.send(g.get()); }
    using g = M.lock() {
        let v = g.get();
        let t = task::spawn(async { v.len() });
        let _ = task::block_on(t);
    }
    using g = M.lock() { remember(g.get()); }
    using g = M.lock() { try! tx.send(g.get_clone()); }
    let _ = rx.recv();
}

// expect-error: 15:39: `g.get()` can't be sent through a channel: the `Mutex` behind `g` still holds it
// expect-error: help: hand over a deep copy (`g.get_clone()`)
// expect-error: 18:29: `async { v.len() }` can't be spawned as a task: the `Mutex` behind `g` still holds it
// expect-error: 21:35: `g.get()` is a view of what the `Mutex` behind `g` protects, and `remember` keeps it past the call

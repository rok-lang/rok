// needs: threads
// expect-error: `q` may hold one object twice
// A closure that stores its argument twice.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let q: List<List<i32>> = [];
    let put = |x: List<i32>| { q.push(x); q.push(x); };
    let a: List<i32> = [];
    put(a);
    if let e: List<i32> = q.pop() { try! tx.send(e); }
    if let f: List<i32> = q.pop() { for i in 0..200000 { f.push(i); } let _ = try! t.join(); println(f"len {f.len()}"); }
}

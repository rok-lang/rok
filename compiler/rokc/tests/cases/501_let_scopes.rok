// expect-exit: 0
// expect-stdout:
// 2 1 none
// 15
// 42 10
// 1 2 1 any
// 3 4
// 6

// `let` declares, a bare `name =` reassigns the existing slot,
// a block's `let` is its own binding, and the left side may destructure.
struct Point { x: i32; y: i32; }

fn pair() -> (i32, i32) { return (3, 4); }

fn counter() -> fn() -> i32 {
    let n = 0;
    // The captured `n` outlives the call that declared it.
    return [ref n] || { n += 1; return n; };
}

let counter_ = 0i32;
counter_ = counter_ + 1i32;
counter_ = counter_ + 1i32;
let y = 1;
let cache: str | none = none;
if counter_ > 0 {
    let z = 2;
    y = z - 1;
}
println(f"{counter_} {y} {cache:?}");
cache = "filled";
let total = 0;
for i in 0..3 {
    let sq = i * i;
    total += sq + 1;
}
total += 7;
println(f"{total}");
let a = 1;
{
    let a: i32 = 42i32;
    let before = a;
    a = 10i32;
    println(f"{before} {a}");
}
let b: i32 = 2i32;
let c: any = 42i32;
let d = if a > 0 { 1i32 } else { 2i32 };
let kind = match c { _: i32 => "any", _ => "other" };
println(f"{a} {b} {d} {kind}");
let (p, q) = pair();
let Point { x, y: yy } = Point { x: p, y: q };
println(f"{x} {yy}");
let f = counter();
f();
f();
let m = 1; let n2 = 2;
println(f"{f() + m + n2}");

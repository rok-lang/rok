// expect-error: or-pattern binding `n` has inconsistent types across alternatives (`i32` and `i64`
// expect-error: write one type pattern: `n: i32 | i64`

// Alternatives bind each name at one type; `(n: i32) | (n: i64)`
// does not.
fn f(v: i32 | i64 | str) -> str {
    match v {
        (n: i32) | (n: i64) => "num",
        s: str => s,
    }
}

fn main() {
    println(f(1));
}

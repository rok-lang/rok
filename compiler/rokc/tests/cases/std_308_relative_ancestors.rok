// expect-exit: 0
// expect-stdout:
// [sub/inner] [sub] []
// none 0

// A relative path's ancestors end with the empty path, whose parent is
// none and which has no components (on Windows too, whose prefix check
// must not read its byte 0).
use rok::std::path::Path;

fn main() {
    let line = "";
    for a in Path::new("sub/inner").ancestors() {
        line = line + f"[{a.as_str()}] ";
    }
    println(line.trim());
    let e = Path::empty();
    println(f"{if e.parent() == none { "none" } else { "some" }} {e.components().count()}");
}

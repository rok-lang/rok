// spec: std §2.16.2
// only-pointer-width: 64
// expect-exit: 0
// expect-stdout:
// 8 16 true 16 24 false

// Stdlib 2.16.2: `Atomic<Ptr<T>>` (`AtomicPrimitive` covers `Ptr`):
// load / store / swap / compare_exchange on the address word.
use rok::core::sync::{LoadOrdering, UpdateOrdering};
use rok::bare::ptr::Ptr;

fn main() {
    let a: Ptr<u64> = Ptr::dangling();
    let b = a.with_addr(16);
    let c = a.with_addr(24);
    let at: Atomic<Ptr<u64>> = Atomic::new(a);
    let first = at.swap(b);
    let ok = at.compare_exchange(b, c, UpdateOrdering::SeqCst, LoadOrdering::SeqCst).is_ok();
    let bad = at.compare_exchange(b, a, UpdateOrdering::SeqCst, LoadOrdering::SeqCst).is_ok();
    println(f"{first.addr()} {b.addr()} {ok} {b.addr()} {at.load().addr()} {bad}");
}

// expect-exit: 0
// expect-stdout:
// block_on 42
// twice 8

// A sync caller gets a future's result with `task::block_on`.
async fn answer() -> i32 {
    await task::yield_now();
    42
}

async fn double(x: i32) -> i32 { x * 2 }

fn twice(x: i32) -> i32 {
    task::block_on(double(x))
}

fn main() {
    println(f"block_on {task::block_on(answer())}");
    println(f"twice {twice(4)}");
}

// expect-error: does not implement

// `any Source<bool>` takes only types whose impl has trait argument
// `bool`; the generic impl is `Source<i32>`.
trait Source<K> { fn id(self) -> i32; }
struct Box<T> { v: T; }
impl<T> Source<i32> for Box<T> { fn id(self) -> i32 { return 1; } }

let y: any Source<bool> = Box { v: 1 };

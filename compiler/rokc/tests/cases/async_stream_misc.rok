// expect-exit: 0
// expect-stdout:
// 0 1 2 3 = 6
// 2 4 6
// 1000
// gen
// 101
// 300
// race 2
// timeout -1
// in time 4
// slept true

// `async yield` streams + `for await`, stream adapters, deep `await`
// recursion, generic async fns, async blocks / closures, race, timeout.
async yield fn ticks(n: i32, ms: i64) -> i32 {
    let i = 0;
    while i < n {
        await task::sleep(Duration::ms(ms));
        yield i;
        i = i + 1;
    }
}

async fn deep(n: i32) -> i32 {
    if n == 0 { return 0; }
    1 + await deep(n - 1)
}

async fn generic_id<T>(x: T) -> T { x }

let total = 0;
for await t in ticks(4, 2) {
    total = total + t;
    print(f"{t} ");
}
println(f"= {total}");
let doubled = await ticks(5, 1).map(|x| x * 2).filter(|x| x > 2).take(2).collect();
println(f"{doubled.len()} {doubled[0]} {doubled[1]}");
println(f"{await deep(1000)}");
println(await generic_id("gen"));
let base = 100;
let f = async { base + 1 };
println(f"{await f}");
let mk = async |x: i32| { await task::yield_now(); x * base };
println(f"{await mk(3)}");
// Margins of seconds: scheduling noise can't flip the results.
let slow = task::spawn(async { await task::sleep(Duration::secs(5)); 1 });
let fast = task::spawn(async { await task::sleep(Duration::ms(5)); 2 });
println(f"race {await task::race([slow, fast])}");
let late = task::spawn(async { await task::sleep(Duration::secs(5)); 3 });
let r = try await task::timeout(Duration::ms(10), late) catch e: task::TimeoutError { -1 };
println(f"timeout {r}");
let ok = task::spawn(async { 4 });
let r2 = try await task::timeout(Duration::secs(5), ok) catch e: task::TimeoutError { -1 };
println(f"in time {r2}");
let start = Instant::now();
await task::sleep(Duration::ms(20));
println(f"slept {start.elapsed().as_ms() >= 20}");


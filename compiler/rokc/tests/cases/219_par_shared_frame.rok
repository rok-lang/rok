// needs: threads
// gc-stress: 5
// Two `par` items holding one future's frame would run it on two workers:
// the frame is one object the check sees, so they run one at a time.
// expect-exit: 0
// expect-stderr: warning: par::map at tests/cases/219_par_shared_frame.rok:25:14: two items reach one collection or future, so they run one at a time on this thread; give each item its own copy, or share read-only data through `Frozen`
// expect-stdout:
// 200000 200000

struct Grab {}
impl Future for Grab {
    type Output = future::Waker;
    fn poll(ref self, ref ctx: future::Context) -> future::Poll<future::Waker> { future::Poll::Ready(ctx.waker()) }
}
async fn work() -> usize {
    let l: List<i32> = [];
    for i in 0..200000 { l.push(i); if i % 50 == 0 { await task::yield_now(); } }
    l.len()
}
struct H { f: future::AsyncFuture<usize>; w: future::Waker; }
async fn main() {
    let w = await Grab {};
    let f = work();
    let hs: List<H> = [H { f, w }, H { f, w }];
    let ns = par::map(hs, |h: H| {
        let ctx = future::Context::from_waker(h.w);
        let n: usize = 0;
        loop {
            if let Ready(v) = h.f.poll(ref ctx) { n = v; break; }
        }
        n
    });
    println(f"{ns[0]} {ns[1]}");
}

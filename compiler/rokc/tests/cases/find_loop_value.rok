// expect-exit: 17
// expect-stdout:
// 17 3

fn main() -> i32 {
    let xs: [i32; 6] = [3, 9, 11, 17, 23, 5];
    let target = 17;
    let i = 0;
    let result = loop {
        if i >= 6 {
            break -1;
        }
        if xs[i] == target {
            break xs[i];
        }
        i += 1;
    };
    println(f"{result} {i}");
    return result;
}

// expect-exit: 0
// expect-stdout: 3 2 1 3 1 82 81
// `Send` / `Sync` are structural auto traits. `impl !Send` opts out,
// `unsafe impl Send` opts in; `fn() -> T + Send` slots take named
// functions, capture-free closures and `fn` values carrying the bound.
struct Tok { v: i32; }
impl !Send for Tok {}
impl !Sync for Tok {}

struct Shared { t: Tok; }
unsafe impl Send for Shared {}

struct Pt { x: i32; y: i32; }
enum Msg { Quit, Move(i32, i32), Text(str) }
struct Pair<T> { a: T; b: T; }

fn need_send<T: Send>(x: T) -> i32 { return 1; }
fn need_sync<T: Sync>(x: T) -> i32 { return 1; }
fn need_both<T: Send + Sync>(x: T) -> i32 { return 1; }
fn spawn<T: Send>(f: fn() -> T + Send) -> T { return f(); }
fn run(f: fn() -> i32) -> i32 { return f(); }
fn forty() -> i32 { return 40; }

trait Show { fn show(self) -> i32; }
impl<T: Send> Show for Pair<T> { fn show(self) -> i32 { return 2; } }

fn main() {
    let s = need_send(Pt { x: 1, y: 2 }) + need_sync("hi") + need_both((1, 2.0, true));
    let m = need_send(Msg::Move(1, 2)) + need_send([1, 2, 3]);
    let sh = need_send(Shared { t: Tok { v: 1 } });
    let p = Pair { a: 1, b: 2 };
    let g = need_send(p) + p.show();
    let b = 3;
    let c = |x: i32| -> i32 { x + b };
    let cl = need_send(c);
    let f = forty;
    let r = spawn(forty) + spawn(f) + spawn(|| -> i32 { 2 });
    let h: fn() -> i32 + Send + Sync = forty;
    let plain: fn() -> i32 = h;
    let q = run(h) + run(plain) + need_send(h);
    println(f"{s} {m} {sh} {g} {cl} {r} {q}");
}

// expect-exit: 0
// gc-stress: 50
// expect-stdout:
// 2
// 1
// 3
// none
// ab
// 2
// 1

// `str` keys and values in `Dict` / `Set` / `List` (`str`
// implements `Hash`). Runtime-built strings stay alive inside the
// collections across collections (their buffers are traced).
extern "C" {
    fn rok_gc_collect();
}

fn main() -> i32 {
    let d: Dict<str, i32> = {"a": 1, "b": 2};
    println(f"{d["b"]}");
    let k = "a" + "";
    println(f"{d[k]}");
    d["c" + ""] = 3;
    unsafe { rok_gc_collect() };
    println(f"{d["c"]}");
    match d.get("zz") {
        v: i32 => println(f"{v}"),
        none => println("none"),
    }
    let names: List<str> = ["a" + "b", "c"];
    unsafe { rok_gc_collect() };
    println(names[0]);
    let s: Set<str> = {"x", "y", "x" + ""};
    println(f"{s.len() as i32}");
    println(f"{if s.contains("y") { 1 } else { 0 }}");
    return 0;
}


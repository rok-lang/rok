// spec: std 308-path §3.8.3 §3.8.4 §3.8.5
// only-os: macos linux
// (RawPath::from_bytes is unix-only, std 3.8.5)
// expect-exit: 0
// expect-stdout:
// /etc/nginx/nginx.conf
// /a/b/c
// ok a/b true
// bad 1 a�b
// lossy x�y
// maximal a��b�
// bytes 3

// spec 3.8.3: `Div<str>` and `Div<Path>` on `Path` (and `/=`); 3.8.4 /
// 3.8.5: `RawPath` (`from_bytes`, `as_bytes`, `try_to_path`,
// `to_path_lossy`), `Path::to_raw`, `Path::try_from(raw)` throwing
// `NonUtf8Error`.
use rok::std::path::{Path, RawPath};

fn main() {
    println((Path::new("/etc") / "nginx" / Path::new("nginx.conf")).as_str());
    let p = Path::new("/a");
    p /= Path::new("b");
    p /= "c";
    println(p.as_str());
    let good = RawPath::from_bytes([97u8, 47u8, 98u8]);
    let gp = try Path::try_from(good) catch _ { Path::new("?") };
    println(f"ok {gp.as_str()} {gp.to_raw() == good}");
    let bad = RawPath::from_bytes([97u8, 0xFFu8, 98u8]);
    let msg = try bad.try_to_path().as_str() catch e { f"{e.valid_up_to}" };
    println(f"bad {msg} {bad.to_path_lossy().as_str()}");
    // A truncated sequence is one replacement (a maximal subpart, as
    // `str::from_utf8_lossy`); a stray continuation byte is its own.
    println(f"lossy {RawPath::from_bytes([120u8, 0xE2u8, 0x82u8, 121u8]).to_path_lossy().as_str()}");
    let mixed = RawPath::from_bytes([97u8, 0xFFu8, 0x80u8, 98u8, 0xF0u8, 0x9Fu8, 0x98u8]);
    println(f"maximal {mixed.to_path_lossy().as_str()}");
    println(f"bytes {good.as_bytes().len()}");
}

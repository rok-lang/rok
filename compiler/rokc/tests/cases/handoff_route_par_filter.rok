// needs: threads
// expect-error: `items` still holds `e`, which was handed to another owner
// par::filter results share the items.
use rok::std::thread;

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let items: List<List<i32>> = [[]];
    let r = par::filter(items, |l: List<i32>| true);
    if let e: List<i32> = r.pop() { try! tx.send(e); }
    for i in 0..200000 { items[0].push(i); }
    let _ = try! t.join();
    println(f"len {items[0].len()}");
}

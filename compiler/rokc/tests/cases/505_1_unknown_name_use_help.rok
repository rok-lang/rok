mod geo {
    pub struct Point { pub x: i32 }
    pub fn area(r: i32) -> i32 { r * r }
    pub const LIMIT: i32 = 7;
    fn secret_value() -> i32 { 1 }
    fn secret() -> i32 { secret_value() }
    mod inner { pub fn deep() -> i32 { 2 } }
    pub mod sub { pub fn under() -> i32 { sides() } }
    pub fn sides() -> i32 { 3 }
}

fn takes(p: Point) -> i32 { p.x }

impl Point { fn y(self) -> i32 { 0 } }

fn main() -> i32 {
    let a = area(2);
    let l = LIMIT;
    let s = secret();
    let d = deep();
    return a + l + s + d;
}

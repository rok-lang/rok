// expect-exit: 11
// expect-stdout:
// true false true false true false
// true

fn is_even(n: i32) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: i32) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn main() -> i32 {
    println(f"{is_even(0)} {is_even(1)} {is_even(2)} {is_even(3)} {is_even(4)} {is_even(5)}");
    println(f"{is_odd(7)}");
    let total = 0;
    for i in 0..6 {
        if is_even(i) {
            total += 1;
        }
    }
    return total + 8;
}

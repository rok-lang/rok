// spec: std 004-lang-slot-table §0.4.4 / refs-lang §6.4
// expect-exit: 0
// forbid-warning: warning
// expect-stdout:
// 5 [4, 5] [5, 4, 3, 2, 1] 6 8 é    1.5    7
// 3

// The hooks lowered code calls (negative indexes, slices, spreads,
// f-strings, cancellation points) go through their lang slots, so their
// `#[deprecated]` marks never warn about code the compiler wrote.
fn add3(a: i32, b: i32, c: i32) -> i32 { a + b + c }
fn named(x: i32, y: i32 = 2) -> i32 { x * y }

async fn work() -> i32 {
    await task::sleep(Duration::ms(1));
    3
}

async fn main() {
    let xs = [1, 2, 3, 4, 5];
    let i: isize = -1;
    let d: Dict<str, i32> = {"x": 4};
    let s = "héllo";
    let spec = ">6";
    println(f"{xs[i]} {xs[-2:]:?} {xs[::-1]:?} {add3(..xs[0:3])} {named(..d)} {s[1:3]} {1.5:{spec}} {Int::from_i64(7):>4}");
    println(f"{await work()}");
}

// expect-exit: 55
// expect-stdout:
// 0 1 55 5050


fn sum_to(n: i32) -> i32 {
    let total: i32 = 0i32;
    let i: i32 = 1i32;
    while i <= n {
        total = total + i;
        i = i + 1i32;
    }
    return total;
}

fn main() -> i32 {
    println(f"{sum_to(0)} {sum_to(1)} {sum_to(10)} {sum_to(100)}");
    return sum_to(10i32);
}


// only-os: macos linux
// (the expected output is a unix target's)
// expect-exit: 30
// expect-stdout:
// 30 0 0

// Items gated by `#[cfg(...)]` are filtered before HIR: without the
// matching flag an item never enters the program. `target_family =
// "unix"` holds on both macOS and Linux hosts.
#[cfg(target_family = "unix")]
fn unix_only() -> i32 { 30i32 }

#[cfg(not(target_family = "unix"))]
fn unix_only() -> i32 { 0i32 }

// Compound predicates: `all`, `any`, `not`.
#[cfg(any(
    target_arch = "x86_64",
    target_arch = "aarch64",
    target_arch = "x86",
    target_arch = "arm",
    target_arch = "riscv64"
))]
fn arch_check() -> i32 { 0i32 }

#[cfg(all(target_family = "unix", not(target_os = "windows")))]
fn portable_unix() -> i32 { 0i32 }

fn main() -> i32 {
    println(f"{unix_only()} {arch_check()} {portable_unix()}");
    return unix_only() + arch_check() + portable_unix();
}


// expect-error: 9:9: a trait item has no visibility of its own
// expect-error: 13:23: a trait impl's item has no visibility of its own
// expect-error: help: remove `pub`

// Trait items and a trait impl's items are as visible as the trait.
mod m {
    pub trait T {
        fn f(self) -> i32 { 1 }
        pub fn g(self) -> i32 { 2 }
    }
}
struct S {}
impl m::T for S { pub fn f(self) -> i32 { 3 } }

fn main() {}

// expect-exit: 0
// expect-stdout:
// 5
// 7

// Enum named-variant `Move { x: i32; y: i32; }`.
enum Cmd {
    Stop,
    Move { x: i32; y: i32; },
}

fn main() -> i32 {
    let c = Cmd::Move { x: 5, y: 7 };
    match c {
        Cmd::Move { x, y } => {
            println(f"{x}");
            println(f"{y}");
        }
        Cmd::Stop => println("stop"),
    };
    return 0;
}

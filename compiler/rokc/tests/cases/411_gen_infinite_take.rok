// expect-exit: 0
// expect-stdout:
// break 0 1 2 3
// take 0 1 4 9

// A generator is an `Iterator`; an infinite one ends through
// `break` in `for` or `take(n)`.
yield fn naturals() -> i32 {
    let i = 0;
    loop {
        yield i;
        i = i + 1;
    }
}

fn main() {
    let s = "break";
    for n in naturals() {
        if n > 3 { break; }
        s = s + f" {n}";
    }
    println(s);
    let t = "take";
    for n in naturals().map(|x| x * x).take(4) {
        t = t + f" {n}";
    }
    println(t);
}

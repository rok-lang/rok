/// An outer doc comment on the item.
fn add(a: i32, b: i32) -> i32 {
    //! An inner doc comment (ignored here).
    //// An ordinary comment.
    a + b
}

fn main() {
    // Several statements on one line, `;` attached on both sides.
    let a = 1;let b = 2;println(f"{add(a, b)}");
    ;;;
    // One statement over several lines.
    let c = add(
        3,
        4
    );
    println(f"{c}");
    let d = c
        + 2
        +3;
    if d > 0 { println(f"{d}"); }
    let e = if a > 0 { 1 } else { 0 };
    for i in 0..1 { let _ = i; }
    {
        println(f"{e + 1}");
    }
    -a;
    let s = "u2028: |nbsp: |";
    println(s);
}

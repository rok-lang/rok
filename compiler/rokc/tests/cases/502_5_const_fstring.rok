// "héllo\t\u{1}\u{202e}"|hé|---hél----|'\''|'|' '|true|  true|true|false |false
// same true true true true true true

// F-string formatting is pure, so a `const` / `const fn` can
// build one; the text equals the run-time one for the same values. Each
// table is built twice by the same `const fn`: at compile time (the
// `const`) and at run time (the call in `main`).
const fn floats(x: f64) -> str {
    f"{x}|{x:e}|{x:E}|{x:.3}|{x:.0}|{x:f}|{x:.2e}|{x:+12.4}|{x:*^14}|{x:<10}|{x:010.1}|"
}

// Shortest round-trip digits at the ends of the range.
const fn shortest(x: f64) -> str { f"{x:e} {x:.1e} {x:E}" }

const fn singles(x: f32) -> str { f"{x} {x:e} {x:.4}|{x:>12}" }

const fn ints(n: i64) -> str {
    f"{n}|{n:+}|{n:x}|{n:#X}|{n:#b}|{n:o}|{n:08}|{n:<8}|{n:^9}|{n:=+8}|{n:e}|{n:.2f}|{n as i8:x}|{n as u16}"
}

const fn texts(s: str, c: char, b: bool) -> str {
    f"{s:?}|{s:.2}|{s:-^10.3}|{c:?}|{c}|{' ':?}|{b}|{b:>6}|{b:?}|{!b:<6}|{!b:?}"
}

const F: [f64; 12] = [0.1, 0.1 + 0.2, 1.0, -0.0, 1e-7, 123456789.125, 2.5, -3.75, 1.0 / 3.0, 0.5, 1.0 / 0.0, -1.0 / 0.0];
const E: [f64; 6] = [1e21, 5e-324, 2.2250738585072014e-308, 1.7976931348623157e308, 1e100, 9007199254740993.0];
const S: [f32; 5] = [0.1f32, 16777216.0f32, 3.4028235e38f32, 1e-45f32, 0.0f32 / 0.0f32];
const N: [i64; 6] = [0, 42, -42, 255, -9223372036854775808, 9223372036854775807];

const fn table_f() -> str {
    let out = "";
    for x in F { out = out + floats(x) + "\n"; }
    out
}

const fn table_e() -> str {
    let out = "";
    for x in E { out = out + shortest(x) + "\n"; }
    out
}

const fn table_s() -> str {
    let out = "";
    for x in S { out = out + singles(x) + "\n"; }
    out
}

const fn table_n() -> str {
    let out = "";
    for n in N { out = out + ints(n) + "\n"; }
    out
}

const fn wide(u: u64) -> str { f"{u}|{u:x}|{u:e}" }

const CF: str = table_f();
const CE: str = table_e();
const CS: str = table_s();
const CN: str = table_n();
const CU: str = wide(18446744073709551615);
const CT: str = texts("héllo\t\u{1}\u{202e}", '\'', true);

fn main() {
    print(CF);
    print(CE);
    print(CS);
    print(CN);
    println(CU);
    println(CT);
    let same = f"{CF == table_f()} {CE == table_e()} {CS == table_s()} {CN == table_n()}";
    println(f"same {same} {CU == wide(18446744073709551615)} {CT == texts("héllo\t\u{1}\u{202e}", '\'', true)}");
}

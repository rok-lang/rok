// A call of a duplicated function or method reports nothing more: an
// argument count or type error would read as if one definition was
// picked. Errors inside the arguments themselves still show.
// expect-error: 16:1: function `f` is defined more than once
// expect-error: 19:1: function `g` is defined more than once
// expect-error: 24:5: method `m` is defined more than once for `S`
// expect-error: 27:5: method `m` is defined more than once for `S`
// expect-error: 32:5: method `n` is defined more than once for `B<T>`
// expect-error: 36:5: method `t` is defined more than once for `S`
// expect-error: 44:22: cannot find value `nope` in this scope
// expect-error: 49:5: nested function `h` is defined twice in this block

trait Tr { fn t(self, a: i32) -> i32; }

fn f(a: i32) -> i32 { a }
fn f(a: i32, b: i32) -> i32 { a + b }

fn g<T>(a: T) -> T { a }
fn g<T>(a: T, b: T) -> T { b }

struct S {}
impl S {
    fn m(self, a: i32) -> i32 { a }
    fn m(self, a: i32, b: i32) -> i32 { a + b }
}
impl S {
    fn m(self) -> i32 { 0 }
}
struct B<T> { x: T }
impl<T> B<T> {
    fn n(self, a: i32) -> i32 { a }
    fn n(self, a: i32, b: i32) -> i32 { a + b }
}
impl Tr for S {
    fn t(self, a: i32) -> i32 { a }
    fn t(self, a: i32, b: i32) -> i32 { a + b }
}

fn main() -> i32 {
    let s = S {};
    let b = B { x: 1 };
    let a = f(1, 2) + f("x") + g(1, 2) + s.m(1, 2) + s.m();
    let c = S::m(s, 1, 2) + b.n(1, 2) + s.t(1, 2);
    return a + c + f(nope);
}

fn nested() -> i32 {
    fn h(a: i32) -> i32 { a }
    fn h(a: i32, b: i32) -> i32 { a + b }
    h(1, 2) + h("x")
}

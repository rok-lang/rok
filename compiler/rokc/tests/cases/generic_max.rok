// expect-exit: 17
// expect-stdout:
// 8 2 7 2.5 -3

fn max<T: PartialOrd>(a: T, b: T) -> T {
    if a > b {
        return a;
    }
    return b;
}

fn main() -> i32 {
    let m1 = max(5, 8);
    let m2 = max(2, 1);
    let m3 = max(7, 6);
    println(f"{m1} {m2} {m3} {max(1.5, 2.5)} {max(-3i64, -4i64)}");
    return m1 + m2 + m3;
}


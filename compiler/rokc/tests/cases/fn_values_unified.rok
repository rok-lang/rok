// expect-exit: 0
// expect-stdout:
// 15
// 7
// 13
// 30
// 3
// 106
// 2

// Named fns and closures (capturing or not) are all
// values of one `fn` type - passed to `fn` parameters, returned, stored
// in struct fields and collections, called later. Captures are
// by-value snapshots. GC collections keep the captures alive.
extern "C" {
    fn rok_gc_collect();
}

struct Handler { name: str; run: fn(i32) -> i32; }

fn apply(f: fn(i32) -> i32, x: i32) -> i32 { return f(x); }
fn make_adder(n: i32) -> fn(i32) -> i32 { return |x| x + n; }
fn twice(x: i32) -> i32 { return x * 2; }

fn main() -> i32 {
    let n = 10;
    println(f"{apply(|x| x + n, 5)}");
    let add2 = make_adder(2);
    let add3 = make_adder(3);
    unsafe { rok_gc_collect() };
    println(f"{add2(5)}");
    println(f"{add3(add2(8))}");
    let hs: List<fn(i32) -> i32> = [twice, make_adder(100), |x| x * n];
    println(f"{hs[2](3)}");
    let h = Handler { name: "inc", run: |x| x + 1 };
    println(f"{(h.run)(2)}");
    let by_name: Dict<str, fn(i32) -> i32> = {"twice": twice, "plus": hs[1]};
    unsafe { rok_gc_collect() };
    println(f"{by_name["plus"](6)}");
    // Snapshot: a later change to `n` doesn't reach the closure.
    let snap = |x: i32| x + n;
    n = 1000;
    println(f"{snap(0) / 5}");
    return 0;
}

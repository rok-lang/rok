// needs: threads
// expect-error: `s` still holds `a`, which was handed to another owner
// Set of lists: one handed over while still a member.
use rok::std::thread;

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let s: Set<List<i32>> = Set::new();
    let a: List<i32> = [1];
    s.insert(a);
    try! tx.send(a);
    let hits = 0;
    for _ in 0..100000 { if s.contains([1]) { hits += 1; } }
    let _ = try! t.join();
    println(f"hits {hits}");
}

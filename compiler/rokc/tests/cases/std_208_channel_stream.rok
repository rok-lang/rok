// expect-exit: 0
// expect-stdout:
// got 1 2 3
// closed

// A channel `Receiver<T>` is a `Stream<Item = T>`, so
// `for await` drains it; the loop ends once the sender side is closed
// and the buffer is empty.
async fn main() {
    let (tx, rx) = channel::<i32>();
    let producer = task::spawn(async {
        let i = 1;
        while i <= 3 {
            try tx.send(i) catch _ {};
            await task::yield_now();
            i = i + 1;
        }
        tx.close();
        0
    });
    let s = "got";
    for await v in rx { s = s + f" {v}"; }
    println(s);
    await producer;
    println("closed");
}

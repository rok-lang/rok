// rokc-arg: --extern opdep=tests/cases/ext_op_scope_other_package/opdep
// expect-exit: 0
// expect-stdout: 11 false true

// A token that starts like a fixed one (`<-`) lexes only in the package
// that registers it: here `a<-1` is still `a < -1`.
fn main() -> i32 {
    let a = 0;
    let b = -5;
    println(f"{opdep::fed(opdep::Sink { v: 1 })} {a<-1} {b<-1}");
    return 0;
}

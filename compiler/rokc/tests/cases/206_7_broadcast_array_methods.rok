// expect-exit: 0
// expect-stdout: 0 0 [1, 4, 9] [true, false, false] [false, false] [1, 2, 3]

// The `[T; N]` dot trait impls, called as methods, work
// for every `N` including 0 and leave the receiver unchanged.
fn main() -> i32 {
    let x: [i32; 0] = [];
    let y: [i32; 0] = [];
    let z = x.dot_add(y);
    let e = x.dot_eq(3);
    let a: [i32; 3] = [1, 2, 3];
    let b = a.dot_mul(a);
    let c = a.dot_lt(2);
    let p: [bool; 2] = [true, false];
    let q = p.dot_logical_or(p).dot_logical_and([false, true]);
    println(f"{z.len()} {e.len()} {b:?} {c:?} {q:?} {a:?}");
    return 0;
}

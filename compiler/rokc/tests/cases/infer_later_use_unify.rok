// expect-exit: 0
// expect-stdout:
// 2 1 1 1
// 1 1
// 3
// 3
// 2
// 1
// 1
// 8
// 2 5 1

// An un-annotated `let` whose initializer leaves a type parameter open
// is solved by unification with the later code of the same body:
// method arguments, call slots, assignments, `return`, closures,
// other open `let`s.

fn wrap<T>(v: i32) -> Result<i32, T> { return Ok(v); }
fn take(r: Result<i32, str>) -> i32 { return r.unwrap_or(0); }
fn sum(xs: List<i64>) -> i64 {
    let t: i64 = 0;
    for x in xs { t = t + x; }
    return t;
}
fn id<T>(x: T) -> T { return x; }

async fn count() -> i32 {
    let xs = List::new();
    xs.push(await one());
    xs.push(2);
    return xs.len() as i32;
}
async fn one() -> i32 { 1 }

fn closure_sink() -> i64 {
    let acc = List::new();
    let f = |v| acc.push(v);
    f(5i64);
    let t: i64 = 0;
    for x in acc { t = t + x; }
    return t;
}

fn first(n: i32) -> i32 {
    let xs = List::new();
    if n > 100 { return 0; }
    xs.push(n);
    return xs[0] - 7;
}

async fn main() -> i32 {
    let xs = List::new();
    xs.push(1);
    xs.push(2);
    let m = Dict::new();
    m.insert("a", 2.0);
    let s = Set::new();
    s.insert("x");
    let e = [];
    e.push(3i64);
    println(f"{xs.len()} {m.len()} {s.len()} {e.len()}");
    // Nested generics: `inner` (open too) fixes `outer`.
    let outer = List::new();
    let inner = List::new();
    outer.push(inner);
    inner.push("a");
    println(f"{outer.len()} {outer[0].len()}");
    // An unsuffixed literal yields to a later concrete use.
    let ys = List::new();
    ys.push(1);
    ys.push(2);
    println(f"{sum(ys)}");
    // A generic return type fixed by a later argument slot.
    let r = wrap(3);
    println(f"{take(r)}");
    // Fixed inside a nested block and a closure.
    let zs = [];
    if true {
        zs.push(2.5);
    }
    let add = || zs.push(1.0);
    add();
    println(f"{zs.len()}");
    // Assignment.
    let q = List::new();
    let w: List<bool> = [true];
    q = w;
    println(f"{q.len()}");
    // Through a generic call.
    let d = Dict::new();
    d.insert(id("k"), [1u8]);
    println(f"{d.len()}");
    // A closure parameter from a later call.
    let dbl = |x| x * 2;
    println(f"{dbl(4)}");
    // A sum element type; `none` is a member of it.
    let o = List::new();
    let v: i32 | none = 4;
    o.push(v);
    o.push(none);
    println(f"{await count()} {closure_sink()} {o.len() - 1}");
    return first(7);
}

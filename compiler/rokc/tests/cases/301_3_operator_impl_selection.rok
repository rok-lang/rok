// spec: §3.1.1 §3.1.3 §3.1.5 §3.1.6 §3.2.1 §3.2.2 §3.2.6
// expect-exit: 0
// expect-stdout:
// V(4, 6) V(-1, -2) V(3, 6) 7.5
// 7 -1 14 20 -3 3
// 24 64 5 true

// Operators are trait calls; the right operand's type picks the impl.
struct V { x: i32; y: i32; }

impl ops::Add for V {
    type Output = V;
    fn add(self, rhs: V) -> V { V { x: self.x + rhs.x, y: self.y + rhs.y } }
}
impl ops::Neg for V {
    type Output = V;
    fn neg(self) -> V { V { x: -self.x, y: -self.y } }
}
impl ops::Mul<i32> for V {
    type Output = V;
    fn mul(self, k: i32) -> V { V { x: self.x * k, y: self.y * k } }
}
impl ops::Mul<f64> for V {
    type Output = f64;
    fn mul(self, k: f64) -> f64 { (self.x + self.y) as f64 * k }
}

fn show(v: V) -> str { f"V({v.x}, {v.y})" }

fn main() -> i32 {
    let a = V { x: 1, y: 2 };
    let b = V { x: 3, y: 4 };
    println(f"{show(a + b)} {show(-a)} {show(a * 3)} {a * 2.5}");
    // 3.2.1 / 3.2.2: `*` binds tighter than `+`; `-` groups from the left;
    // prefix `-` binds tighter than binary `+`.
    let (p, q, r) = (1, 2, 3);
    println(f"{p + q * r} {p - q - r + 5 - 3 + 1} {(p + q) * r + 5} {(p + q * r) * 20 / 7} {-p + q - 4} {-(p - q) * 3}");
    // 3.2.3 notes: arithmetic binds tighter than shift (`1 << 3 * 2` is 64); `-x as i64` is
    // `(-x) as i64`; `<` is weaker than `+`.
    let x: i32 = -5;
    println(f"{1 + 2 << 3} {1 << 3 * 2} {-x as i64} {p < q + r}");
    return 0;
}

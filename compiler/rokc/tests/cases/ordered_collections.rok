// spec: std §2.9.5
// expect-exit: 0
// expect-stdout:
// {"z": 10, "a": 2, "m": 3} len 3
// old 1 get 2 miss true
// removed 2 -> {"z": 10, "m": 3, "b": 4}
// m=3 b=4 eq true
// 10 3 4
// {3, 1, 2} contains true insert-dup false
// union {3, 1, 2, 9} inter {1} diff {3, 2} sub true
// collected {"x": 1, "y": 2} {5, 4}
// cleared 0 {}
fn main() {
    let d = collections::OrderedDict::from([("z", 1), ("a", 2), ("m", 3)]);
    let old = d.insert("z", 10);
    println(f"{d:?} len {d.len()}");
    println(f"old {old ?? 0} get {d.get("a") ?? 0} miss {d.get("q") is none}");
    let r = d.remove("a") ?? 0;
    d["b"] = 4;
    println(f"removed {r} -> {d:?}");
    let e = d.clone();
    println(f"m={d["m"]} b={d["b"]} eq {e == d}");
    let vs = "";
    for v in d.values() { vs = vs + f"{v} "; }
    println(vs.trim());

    let s = collections::OrderedSet::from([3, 1, 2, 1]);
    println(f"{s:?} contains {s.contains(2)} insert-dup {s.insert(3)}");
    let t = collections::OrderedSet::from([9, 1]);
    println(f"union {s.union(t):?} inter {s.intersection(t):?} diff {s.difference(t):?} sub {collections::OrderedSet::from([2, 3]).is_subset(s)}");

    let c: collections::OrderedDict<str, i32> = [("x", 1), ("y", 2)].iter().collect();
    let cs: collections::OrderedSet<i32> = [5, 4, 5].iter().collect();
    println(f"collected {c:?} {cs:?}");
    c.clear();
    println(f"cleared {c.len()} {c:?}");
}

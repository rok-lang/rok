// needs: threads
// A future something already polled holds what its body made and read so
// far: it cannot go to a task, which would share that with its maker.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/218_spawn_started_future_panics.rok:30:13:
// expect-stderr: a future that has started running cannot go to another task or thread: hand it over before anything polls it, or call the async fn again for a new one
// expect-stdout:
// polled

struct Once { f: future::AsyncFuture<usize>; }

impl Future for Once {
    type Output = ();
    fn poll(ref self, ref ctx: future::Context) -> future::Poll<()> {
        let _ = self.f.poll(ref ctx);
        future::Poll::Ready(())
    }
}

async fn grow(xs: List<i32>) -> usize {
    await task::yield_now();
    xs.push(1);
    xs.len()
}

async fn main() {
    let f = grow([]);
    await Once { f: f };
    println("polled");
    let t = task::spawn(f);
    println(f"{await t}");
}

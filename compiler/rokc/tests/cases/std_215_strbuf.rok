// expect-exit: 0
// expect-stdout:
// ab세계! 9
// cap ok true

// `StrBuf`: `push(char)` UTF-8-encodes, `push_str` appends,
// `to_str` yields the current contents as an immutable `str`.
fn main() {
    let b = StrBuf::new();
    b.push('a');
    b.push_str("b세");
    b.push('계');
    b.push('!');
    let s = b.to_str();
    println(f"{s} {s.len()}");
    println(f"cap ok {b.capacity() >= s.len()}");
}

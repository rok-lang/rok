// spec: 001.03.4-block-like-expression-statements
// expect-error: `-` can't start the line after a trailing-closure call
// expect-error: help: write `;` after the closure's `}` to end the call there; to keep one expression, move `-` to the end of the line above

// An operator can't start the line after a statement's trailing-closure
// call (spec 1.3.4). A `let`, a `;` and an operator at the end of the
// line above are fine.
fn run(f: fn() -> ()) -> i32 { f(); 1 }

fn main() {
    let y = 5;
    run {
        println("run");
    }
    - y;
    let w = run { println("run"); }
        - y;
    run {
        println("run");
    };
    let z = run { println("run"); } +
        y;
    println(f"{w} {z}");
}

fn floats(a: f64, b: f64) -> f64 {
    // Reused operands, chains, a square root between uses.
    let d2 = a * a + b * b + a * b;
    let m = 0.01 / (d2 * d2.sqrt());
    let r = (a - b) * m - (a + b) * m * 2.0;
    let s: f32 = (a as f32) * (b as f32) + 1.5;
    return r + (s as f64) + (if a < b { 1.0 } else { -1.0 });
}

fn sum_to(n: i64) -> i64 {
    // A loop: values live in registers within a block, in memory across
    // the back edge and the branches.
    let i: i64 = 0;
    let t: i64 = 0;
    while i < n {
        let k = i * 3 + 7;
        if k % 2 == 0 {
            t += k >> 1;
        } else {
            t -= k & 0xf;
        }
        i += 1;
    }
    return t;
}

fn main() -> i32 {
    let bad = check_i8() + check_u8() + check_i16() + check_u16()
        + check_i32() + check_u32() + check_i64() + check_u64();
    if bad == 0 { println("ints ok"); } else { println(f"ints: {bad} mismatches"); }
    let f = floats(id(1.25), id(-3.5));
    let g = floats(1.25, -3.5);
    if f == g && f == -3.8718095180954135 {
        println("floats ok");
    } else {
        println(f"floats: {f} {g}");
    }
    let s = sum_to(id(1000i64));
    if s == sum_to(1000) && s == 372750 {
        println("loops ok");
    } else {
        println(f"loops: {s}");
    }
    return 0;
}

// spec: §2.10.3 §2.1.8
// expect-exit: 30
// expect-stdout:
// 12 9

fn filter_sum<T: ops::Add<T, Output = T> + Default>(xs: [T; 6], pred: fn(T) -> bool) -> T {
    let acc = T::default();
    for v in xs {
        if pred(v) {
            acc += v;
        }
    }
    return acc;
}

fn main() -> i32 {
    let xs: [i32; 6] = [1, 2, 3, 4, 5, 6];
    let evens = filter_sum(xs, |n: i32| -> bool { n % 2 == 0 });
    let odds = filter_sum(xs, |n: i32| -> bool { n % 2 == 1 });
    println(f"{evens} {odds}");
    return evens + odds + 9;
}

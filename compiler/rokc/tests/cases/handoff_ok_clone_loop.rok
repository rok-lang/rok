// needs: threads
// expect-exit: 0
// expect-stdout:
// 2
// got 3

// Copy loop with clone, send the copy, keep using the source.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let c = thread::spawn(|| { let n: usize = 0; while let r: List<i32> = rx.recv() { n += r.len(); } n });
    let src: List<List<i32>> = [[1], [2, 3]];
    let mine: List<List<i32>> = [];
    for x in src { mine.push(x.clone()); }
    while let m: List<i32> = mine.pop() { try! tx.send(m); }
    src[0].push(9);
    println(f"{src[0].len()}");
    tx.close();
    println(f"got {try! c.join()}");
}

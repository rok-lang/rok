// spec: §2.5.3 §2.5.4 §2.5.5 §2.5.7
// expect-exit: 0
// expect-stdout:
// 1 1065353216
// 8 4
// i32 f32

#[repr(C)]
union CUnion {
    a: i32;
    b: f32;
}

union Wide { a: u8; b: u64; }

union Foo { a: i32; b: f32; }
type Bar = i32 | f32;

fn main() {
    // IEEE 754 bits both ways.
    let u = CUnion { a: 0x3F800000 };
    let back = CUnion { b: 1.0f32 };
    println(f"{unsafe { u.b }} {unsafe { back.a }}");
    // A union is as large as its largest field; a sum is tagged.
    println(f"{Wide::size()} {Foo::size()}");
    let x: Bar = 1;
    let y: Bar = 1.0f32;
    println(f"{x.type_name_of_val()} {y.type_name_of_val()}");
}

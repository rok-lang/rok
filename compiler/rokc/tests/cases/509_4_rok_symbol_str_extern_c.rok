// `rok_*` names the runtime's functions, whose `str` is
// `(ptr, len)`; an `extern "C"` `str` is a NUL-terminated `char*`.
extern "C" { fn rok_str_cstr(s: str) -> usize; }

println(f"{unsafe { rok_str_cstr("x") }}");

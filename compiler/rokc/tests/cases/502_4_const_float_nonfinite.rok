// expect-exit: 0
// expect-stdout: inf NaN -inf inf true [1, 2]

// Float consts may be infinite or NaN, `f32` ones included,
// and embed as such; a `List` const (heap) is checked now and
// built at each use, so pushing to one copy leaves the next untouched.
const INF: f32 = 1.0f32 / 0.0f32;
const NAN: f32 = 0.0f32 / 0.0f32;
static SINF: f32 = -1.0f32 / 0.0f32;
const L: List<i64> = [1, 2];
const fn half(x: f32) -> f32 { x / 2.0f32 }
fn main() -> i32 {
    const H: f32 = half(INF);
    let l = L;
    l.push(3);
    println(f"{INF} {NAN} {SINF} {H} {NAN.is_nan()} {L:?}");
    return 0;
}

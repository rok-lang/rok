// Python habits in expressions: each error names the Rok form.

fn and_word(a: i32) {
    if a > 0 and a < 10 { println("in"); }
}

fn or_word(a: i32) {
    if a < 0 or a > 10 { println("out"); }
}

fn not_word(done: bool) {
    if not done { println("todo"); }
}

fn is_not(x: i32 | none) {
    if x is not none { println("set"); }
}

fn ternary(c: bool) {
    let y = 1 if c else 2;
}

fn lambda_word() {
    let f = lambda x: x + 1;
}

fn list_comp(xs: List<i32>) {
    let ys = [x * x for x in xs if x > 1];
}

fn dict_comp(xs: List<i32>) {
    let d = {x: x * x for x in xs};
}

fn set_comp(xs: List<i32>) {
    let s = {x % 3 for x in xs};
}

fn range_comp() {
    let squares = [i * i for i in range(10)];
}

fn named_eq() {
    print("x", end="");
}

fn repr_conv(x: i32) {
    println(f"{x!r}");
}

fn main() {}

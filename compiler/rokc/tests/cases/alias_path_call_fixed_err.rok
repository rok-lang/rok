// `Al::f` leaves the alias's arguments to inference only when the
// aliased type's are its distinct parameters.
type Names<V> = Dict<str, V>;
struct Two<A, B> { a: A; b: B; }
impl<A, B> Two<A, B> { fn mk(a: A, b: B) -> Self { return Self { a: a, b: b }; } }
type Same<T> = Two<T, T>;
fn main() -> i32 {
    let ok = Names::<i32>::new();
    ok.insert("a", 1);
    let d = Names::new();
    let t = Same::mk(1, 2);
    return 0;
}

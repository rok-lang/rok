// spec: §2.10.9
// expect-error: no method `area` on type parameter `T`: it has no bounds
// expect-error: no method `name` on type parameter `T`: its bounds (`Shape`) do not declare it
// expect-error: operator `+` on `T` needs a `Add` bound on `T`
// expect-error: operator `*` on `T` needs a `Mul` bound on `T`
// expect-error: operator `-` on `T` needs a `Sub` bound on `T`
// expect-error: operator `==` on `T` needs a `PartialEq` bound on `T`
// expect-error: operator `-` on `T` needs a `Neg` bound on `T`
// expect-error: no field `x` on type `T`
// expect-error: cannot cast `T` as `i64`
// expect-error: `T` cannot be formatted with `{}`: it does not implement `Display`
// expect-error: mismatched types: `let n` expects `i32`, found `T`
// expect-error: cannot index into a value of type `T`
// expect-error: cannot iterate over a value of type `I`
// forbid-error: whatever

// Generic bodies are checked at their definition, called or not: a
// type parameter has only what its bounds give (spec 2.10.9). An
// implicit parameter (`fn f(x)`) is exempt: its body is checked per
// call (spec 4.2.2), so the uncalled `implicit` reports nothing.

trait Shape { fn area(self) -> f64; }
trait Named: Shape { fn name(self) -> str; }

fn no_bound<T>(x: T) -> f64 { x.area() }
fn wrong_bound<T: Shape>(x: T) -> str { x.name() }
fn add<T>(x: T) -> T { x + x }
// A value derived from `T` (an element, a clone) has no more than `T`.
fn derived<T: Clone>(xs: List<T>) -> T { xs[0].clone() * xs[1] }
// Compound assignment is the operator.
fn compound<T>(x: T, y: T) -> T {
    let z = x;
    z -= y;
    z
}
fn eq<T>(a: T, b: T) -> bool { a == b }
fn neg<T>(a: T) -> T { -a }
fn field<T>(a: T) -> i32 { a.x }
fn cast<T>(a: T) -> i64 { a as i64 }
fn show<T>(a: T) -> str { f"{a}" }
fn concrete<T>(a: T) -> i32 {
    let n: i32 = a;
    n
}
fn index<T>(a: T) -> i32 { a[0] }
fn iterate<I>(it: I) {
    for x in it {}
}
fn implicit(x) { x.whatever() }

println("unreached");

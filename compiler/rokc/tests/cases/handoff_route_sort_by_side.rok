// needs: threads
// expect-error: `side` may hold one object twice, and one of them was handed to another owner
// sort_by callback storing elements in a side list.
use rok::std::thread;

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let q: List<List<i32>> = [[], []];
    let side: List<List<i32>> = [];
    q.sort_by(|x: List<i32>, y: List<i32>| { side.push(x); side.push(y); rok::core::cmp::Ordering::Equal });
    if let e: List<i32> = q.pop() { try! tx.send(e); }
    let _ = q.pop();
    for s in side { for i in 0..200000 { s.push(i); } }
    let _ = try! t.join();
    println(f"side {side[0].len()} {side[1].len()} (one of them is the sent list)");
}

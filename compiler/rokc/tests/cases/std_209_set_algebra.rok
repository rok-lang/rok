// expect-exit: 0
// expect-stdout:
// union 4 inter 2 diff 1 sym 2
// subset true false superset true
// disjoint true false
// insert new true dup false, remove true false
// order-free eq true

// `Set<T>` algebra and predicates; `insert` / `remove` report
// whether the set changed; Sets compare independent of order.
fn main() {
    let a: Set<i32> = {1, 2, 3};
    let b: Set<i32> = {2, 3, 4};
    let s = a.symmetric_difference(b);
    println(f"union {a.union(b).len()} inter {a.intersection(b).len()} diff {a.difference(b).len()} sym {s.len()}");
    let small: Set<i32> = {2, 3};
    println(f"subset {small.is_subset(a)} {a.is_subset(small)} superset {a.is_superset(small)}");
    let far: Set<i32> = {9,};
    println(f"disjoint {a.is_disjoint(far)} {a.is_disjoint(b)}");
    let c: Set<i32> = Set::new();
    let n = c.insert(5);
    let d = c.insert(5);
    let r1 = c.remove(5);
    let r2 = c.remove(5);
    println(f"insert new {n} dup {d}, remove {r1} {r2}");
    let x: Set<i32> = {3, 1, 2};
    println(f"order-free eq {a == x}");
}

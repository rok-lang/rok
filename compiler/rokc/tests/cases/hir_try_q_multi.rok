// expect-exit: 23
// expect-stdout:
// 3 10 10

// `?` on a sum with several payload variants keeps the remaining sum and
// propagates `none` out of the enclosing function.
fn g(x: i32) -> i32 | bool | none {
    if x > 0 { return x; }
    if x < 0 { return true; }
    return none;
}

fn h(x: i32) -> i32 | none {
    let v = g(x)?;
    return match v { a: i32 => a + 1, b: bool => 10 };
}

fn main() -> i32 {
    let a = h(2) ?? 100;   // 3
    let b = h(-1) ?? 100;  // 10
    let c = h(0) ?? 10;    // none → 10
    println(f"{a} {b} {c}");
    return a + b + c;
}

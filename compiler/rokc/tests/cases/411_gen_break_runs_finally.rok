// spec: 004.11-generators §4.11.10
// expect-exit: 0
// expect-stdout:
// generator finally
// after break: try_lock is_none = false
// labelled: 0 0
// inner closed
// labelled: 1 0
// inner closed
// inner closed
// continue: 0 1 2 3
// kept: 0 1
// kept: 2 3

// 4.11.10: a `for` that leaves a generator early (here by `break`)
// runs the generator's `using` and `finally` cleanups; `continue` does
// not, and a generator held in a variable is left open.
static M: Mutex<i64> = Mutex::new(0);

yield fn items() -> i64 {
    using g = M.lock() {
        try {
            for i in 0..10 { yield i as i64; }
        } finally {
            println("generator finally");
        }
    }
}

yield fn counted(n: i64) -> i64 {
    try {
        let i: i64 = 0;
        while i < n {
            yield i;
            i += 1;
        }
    } finally {
        println("inner closed");
    }
}

fn main() {
    for x in items() { if x == 2 { break; } }
    println(f"after break: try_lock is_none = {M.try_lock() is none}");

    'outer: for a in 0..2 {
        for b in counted(5) {
            println(f"labelled: {a} {b}");
            continue 'outer;
        }
    }

    let seen = "continue:";
    for x in counted(4) {
        seen = f"{seen} {x}";
        if x < 10 { continue; }
    }
    println(seen);

    let g = counted(4);
    for x in g {
        println(f"kept: {x} {g.next() ?? -1}");
        break;
    }
    for x in g {
        println(f"kept: {x} {g.next() ?? -1}");
        break;
    }
}

// needs: threads
// expect-exit: 0
// gc-stress: 50
// expect-stdout:
// waited true
// full 9
// 11
// 199800
// freed

// channel: `channel_bounded(0)` is a rendezvous (a `send` returns
// once the receiver took the value; `try_send` is `Full` with nobody
// waiting); `for v in rx` (IntoIterator); a received value is not kept
// alive by the channel.
use rok::std::thread;
use rok::core::time::{Duration, Instant};

extern "C" {
    fn rok_gc_collect();
    fn rok_gc_stats_live_bytes() -> usize;
}

fn main() -> i32 {
    // Rendezvous: `send` returns only after `recv` took the value.
    let (tx, rx) = channel_bounded::<i64>(0);
    // The receiver starts after 20 ms, so a rendezvous `send` waits for it.
    // The clock starts before the spawn: a main thread descheduled after it
    // would otherwise see less than the receiver's 20 ms.
    let t0 = Instant::now();
    let h = thread::spawn(|| {
        thread::sleep(Duration::ms(20));
        let total: i64 = 0;
        for v in rx { total += v; }
        total
    });
    try! tx.send(5);
    println(f"waited {t0.elapsed() >= Duration::ms(15)}");
    // Nobody is waiting in `recv`: a rendezvous `try_send` is `Full`.
    let (lonely, _unused) = channel_bounded::<i64>(0);
    try lonely.try_send(9) catch e {
        match e {
            channel::TrySendError::Full(v) => println(f"full {v}"),
            channel::TrySendError::Closed(_) => println("closed"),
        };
    };
    try! tx.send(6);
    tx.close();
    println(f"{try! h.join()}");

    // Received values are not kept alive by the channel.
    let (tx2, rx2) = channel::<List<i64>>();
    let i = 0;
    while i < 200 {
        let big: List<i64> = [];
        let j: i64 = 0;
        while j < 1000 { big.push(j); j += 1; }
        try! tx2.send(big);
        i += 1;
    }
    let sum: i64 = 0;
    let k = 0;
    while k < 200 {
        match rx2.recv() { xs: List<i64> => { sum += xs[999]; }, none => {}, }
        k += 1;
    }
    println(f"{sum}");
    unsafe { rok_gc_collect() };
    if unsafe { rok_gc_stats_live_bytes() } > 200000usize { return 1; }
    println("freed");
    return 0;
}


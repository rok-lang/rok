// A literal-bound `let` gets one type from its uses: no conversion is
// added, and the fix goes on the declaration.

fn take32(x: i32) -> i32 { x }
fn take64(x: i64) -> i64 { x }
fn takef(x: f64) -> f64 { x }

fn main() {
    let c = 0;
    _ = take32(c);
    _ = take64(c);
    let t = 0;
    _ = takef(t);
    let b = 1;
    if b { }
}

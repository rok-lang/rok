// expect-exit: 0
// expect-stdout:
// 5
// 6
// 7
// odd 1
// odd 3

// `for i in a..` counts up until a `break`; `continue` still
// advances.
fn main() {
    for i in 5.. {
        if i == 8 { break; }
        println(f"{i}");
    }
    for i in 0i8.. {
        if i % 2 == 0 { continue; }
        if i > 3 { break; }
        println(f"odd {i}");
    }
}

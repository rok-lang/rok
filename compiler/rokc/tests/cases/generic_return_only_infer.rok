// expect-exit: 0
// expect-stdout:
// 3
// 0
// 8
// 1
// 4

// A type parameter that only appears in the return type is inferred
// from the expected type: the `let` annotation, the argument slot, the
// enclosing function's return type.

struct Box<T> { v: T; }

fn make<T>(n: i32) -> Box<T> | none { return none; }
fn wrap<T>(v: i32) -> Result<i32, T> { return Ok(v); }
fn first<T>(xs: [i32; 2]) -> Result<i32, T> { return Ok(xs[0]); }
fn take(b: Result<i32, bool>) -> i32 { return b.unwrap_or(0) * 2; }
fn give() -> Result<i32, str> { return wrap(4); }

fn main() -> i32 {
    let r: Result<i32, str> = wrap(3);
    println(f"{r.unwrap_or(0)}");
    let z: Result<i32, i64> = first([0, 5]);
    println(f"{z.unwrap_or(9)}");
    println(f"{take(wrap(4))}");
    let m: Box<i64> | none = make(1);
    println(f"{match m { none => 1, _ => 0 }}");
    println(f"{give().unwrap_or(0)}");
    return 0;
}


mod nums {
    pub type Evens = some Iterator<Item = i64>;

    pub fn evens(n: i64) -> Evens { (0..n).filter(|x| x % 2 == 0) }

    // A second defining function must give the same type.
    pub fn odds(n: i64) -> Evens { (0..n).map(|x| x * 2 + 1) }

    pub type Lost = some Display;

    pub type Gen<T> = some Iterator<Item = T>;

    pub type Count = some Display;

    pub fn count<T>(x: T) -> Count { 1 }

    pub type Bad = some Display;

    pub fn bad() -> Bad { [1, 2] }

    pub type Shown = some Display;

    pub fn shown() -> Shown { 5 }
}

struct Holder { e: nums::Evens; }

fn take(h: Holder) -> i64 { h.e.len() }

// Only `nums` defines `Shown`.
fn mine() -> nums::Shown { 7 }

fn main() {
    let a = nums::evens(10);
    println(a.len());
    let n: i64 = nums::shown();
    println(take(Holder { e: nums::evens(3) }) + n);
    println(mine());
}

// In the root module too: other modules see only the bound.
type Root = some Display;

fn root() -> Root { 1 }

mod user {
    pub fn read() -> i64 {
        let r: i64 = sup::root();
        r
    }
}

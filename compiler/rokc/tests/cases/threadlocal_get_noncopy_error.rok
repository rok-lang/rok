// expect-error: 12:13: type `List<i64>` does not satisfy trait bound `Copy` required by `ThreadLocal::get`
// expect-error: help: use the value inside `with`: `tl.with(|v| ..)`, or take it out with `tl.replace(v)` / `tl.take()`

// `ThreadLocal::get` copies the value, so it needs `T: Copy`: a shared
// handle kept across an `await` could be used from two threads once the
// task resumes elsewhere.
use rok::std::thread;

static TL: thread::ThreadLocal<List<i64>> = thread::local(|| -> List<i64> { [] });

async fn work() {
    let l = TL.get();
    await task::yield_now();
    l.push(1);
}

fn main() {
    task::block_on(work());
}

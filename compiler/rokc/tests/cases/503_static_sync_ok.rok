// spec: refs-lang §5.3 §5.3.4 §5.3.9 §4.6.9
// needs: threads
// expect-exit: 0
// expect-stdout:
// 200 200 2 rok
// 3 1 3
// 3

// What a `static` may be: `Sync` values - a `Mutex` of a collection,
// an `Atomic`, an `RwLock` of a `Sync` value, a lazily built one, a
// per-thread `ThreadLocal`. A same-thread closure may still use
// `[ref x]`.
use rok::std::thread;

static XS: Mutex<List<i32>> = Mutex::new([]);
static N: Atomic<i64> = Atomic::new(0);
static NAME: RwLock<str> = RwLock::new("rok");
static D: Mutex<Dict<str, i64>> = Mutex::new(table());
static TL: thread::ThreadLocal<List<i32>> = thread::local(fresh);

fn fresh() -> List<i32> { return []; }

fn table() -> Dict<str, i64> {
    let d: Dict<str, i64> = Dict::new();
    d.insert("a", 1);
    return d;
}

fn work(k: i32) -> i64 {
    for i in 0..100 {
        using g = XS.lock() { g.get().push(k * 100 + i); }
        N.fetch_add(1);
        TL.with(|l| l.push(i));
    }
    using g = D.lock() { g.get().insert(f"t{k}", k as i64); }
    using g = NAME.read() { return g.get().len() as i64 + TL.with(|l| l.len()) as i64; }
}

fn main() {
    let a = thread::spawn(|| work(0));
    let b = thread::spawn(|| work(1));
    let ra = try! a.join();
    let rb = try! b.join();
    using g = XS.lock() {
        using h = NAME.read() {
            println(f"{g.get().len()} {N.load()} {if ra == rb { 2 } else { 0 }} {h.get()}");
        }
    }
    using g = D.lock() { println(f"{g.get().len()} {g.get()["a"]} {TL.with(|l| l.len()) + 3}"); }
    let n = 0;
    let bump = [ref n] || { n += 1; };
    bump();
    bump();
    bump();
    println(f"{n}");
}

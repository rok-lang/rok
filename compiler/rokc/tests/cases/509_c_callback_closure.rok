// expect-error: a `fn` argument must name a function

// A C function takes a plain function pointer: a capturing closure (a
// `{code, env}` value) can't be passed to it.
extern "C" {
    fn rok_par_for(start: i64, end: i64, step: i64, callback: fn(i64));
}

fn main() -> i32 {
    let k = 2i64;
    unsafe { rok_par_for(0i64, 3i64, 1i64, |i| { println(f"{i * k}"); }) };
    return 0;
}

// expect-exit: 15
// expect-stdout:
// 4
// 3
// 2
// 1
// 0


fn step(n: i32) -> i32 | none {
    if n > 0 {
        return n - 1;
    }
    return none;
}

fn main() -> i32 {
    let count = 0;
    let cur: i32 | none = step(5);
    while let n: i32 = cur {
        println(f"{n}");
        count += 1;
        cur = step(n);
    }
    return count + 10;
}


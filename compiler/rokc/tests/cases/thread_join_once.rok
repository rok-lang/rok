// needs: threads
// expect-exit: 0
// expect-stdout:
// 7
// thread join failed: the handle was already joined or detached
// true
// thread join failed: the handle was already joined or detached

// A `JoinHandle` copy shares the handle: the OS thread is joined or
// detached once. A second `join` (through any copy), or a `join` after
// `detach`, throws `JoinError` of kind `Taken`; a second `detach` does
// nothing.
use rok::std::thread;

fn main() {
    let h = thread::spawn(|| 7);
    let copy = h;
    println(f"{try! h.join()}");
    let taken = try { copy.join(); false } catch e: thread::JoinError { println(f"{e}"); e.kind() == thread::JoinErrorKind::Taken };
    println(f"{taken}");
    let d = thread::spawn(|| 1);
    d.detach();
    d.detach();
    try d.join() catch e: thread::JoinError { println(f"{e}"); 0 };
}

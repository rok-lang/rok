// expect-exit: 0
// expect-stdout:
// 03 ok
// 010001 ok
// 1ffffffff ok
// 0100000001 ok
// 01ffffffff ok
// 0200000001 RSA exponent must be odd, at least 3 and below 2^33
// 0000000200000001 RSA exponent must be odd, at least 3 and below 2^33
// 010000000000000001 RSA exponent must be odd, at least 3 and below 2^33
// 01 RSA exponent must be odd, at least 3 and below 2^33
// 010000 RSA exponent must be odd, at least 3 and below 2^33

// rok::core::crypto::rsa: the public exponent is odd and 3 <= e < 2^33,
// leading zero bytes aside.
use rok::core::crypto::rsa::PublicKey;

fn nib(c: u8) -> u8 {
    if c >= 0x30u8 && c <= 0x39u8 { return c - 0x30u8; }
    c - 0x61u8 + 10u8
}

fn unhex(s: str) -> List<u8> {
    let out: List<u8> = [];
    let b = s.as_bytes();
    let i = b.len() % 2;
    if i == 1 { out.push(nib(b[0])); }
    while i + 1 < b.len() {
        out.push((nib(b[i]) << 4) | nib(b[i + 1]));
        i += 2;
    }
    out
}

fn main() {
    let n = unhex("");
    for e in ["03", "010001", "1ffffffff", "0100000001", "01ffffffff", "0200000001", "0000000200000001", "010000000000000001", "01", "010000"] {
        let r = try PublicKey::new(n, unhex(e)) catch err { println(f"{e} {err.message()}"); continue; };
        println(f"{e} {if r.bits() == 2048 { "ok" } else { "bits" }}");
    }
}

// spec: std 221-crypto §2.21.4

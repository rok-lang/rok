// What the `learn_*` diagnostics' help lines say to write compiles and
// does what the habit meant.
// expect-exit: 0
// expect-stdout:
// 2 1 15 count: 3 2
// small 3 none
// 5 0 h 2 012
// x = 3
// 7 1
// 0 -1 1

let xs = [1, 2, 3];
let total: i32 = 6;
let d: Dict<str, i32> = {"a": 1};
let v = d.get("a");
let a: int = 10;
let b = 5;
let n = 3;
async fn get() -> i32 { 1 }
let x = get();
let one = await x + 1;
println(f"{total / (xs.len() as i32)} {v ?? 0} {a + (b as int)} {f"count: {n}"} {one}");

let i = 0;
while i < 3 { i += 1; }
let s = if n > 2 { "small" } else { "big" };
let later: i32 | none = none;
println(f"{s} {i} {later:?}");

let w: i32 | none = 5;
match w {
    k: i32 => print(f"{k} "),
    none => print("none "),
}
let e: Dict<str, i32> = Dict::new();
let name = "héllo";
let c = name.chars().nth(0) ?? ' ';
print(f"{e.len()} {c} {xs.len() - 1} ");
for j in 0..3 { print(f"{j}"); }
println("");
println(f"x = {n}");

struct P { x: i32; y: i32; }
struct Conn { n: i32; }
impl Drop for Conn { fn drop(ref self) {} }
using cn = (Conn { n: 7 }) {
    print(f"{cn.n} ");
}
fn parse_it(s: str) throws -> i32 {
    let m: i32 = try s.parse();
    m
}
println(f"{try! parse_it("1")}");

fn find(xs: List<i32>) -> usize | none {
    for i in 0..xs.len() { if xs[i] == 2 { return i; } }
    none
}
let q = (try? "x".parse::<i32>()) ?? 0;
fn neg(k: i32) throws -> i32 {
    if k < 0 { throw ValueError::new("negative"); }
    k
}
let r = try neg(-1) catch _ { -1 };
println(f"{q} {r} {find(xs) ?? 9}");

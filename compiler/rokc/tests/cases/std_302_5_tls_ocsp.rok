const GOOD: str = "";
const REVOKED: str = "";
const DELEGATED: str = "";
const SHA256_ID: str = "";
const OTHER: str = "";
const STAPLE: str = "";

fn nib(c: u8) -> u8 {
    if c >= 0x30u8 && c <= 0x39u8 { return c - 0x30u8; }
    c - 0x61u8 + 10u8
}

fn unhex(s: str) -> List<u8> {
    let out: List<u8> = [];
    let b = s.as_bytes();
    let i = 0usize;
    while i + 1 < b.len() {
        out.push((nib(b[i]) << 4) | nib(b[i + 1]));
        i += 2;
    }
    out
}

/// The server side of each case: `(leaf, key, response)`.
fn cases() -> List<(str, str, List<u8>)> {
    let damaged = unhex(GOOD);
    // A byte of the responder name: the signed data changes.
    damaged[55] = damaged[55] ^ 1u8;
    let not_ok: List<u8> = [0x30u8, 0x03u8, 0x0au8, 0x01u8, 0x01u8];
    let empty: List<u8> = [];
    [
        (LEAF, KEY, unhex(GOOD)),
        (LEAF, KEY, unhex(DELEGATED)),
        (LEAF, KEY, unhex(SHA256_ID)),
        (RSA_LEAF, RSA_KEY, unhex(REVOKED)),
        (LEAF, KEY, unhex(OTHER)),
        (LEAF, KEY, damaged),
        (LEAF, KEY, not_ok),
        (LEAF, KEY, empty),
        (STAPLE_LEAF, KEY, empty),
        (STAPLE_LEAF, KEY, unhex(STAPLE)),
    ]
}

fn serve(l: TcpListener) {
    for (leaf, key, resp) in cases() {
        let cfg = try! ServerConfig::new(try! Certificate::from_pem(leaf), try! PrivateKey::from_pem(key));
        cfg.ocsp_response = resp;
        cfg.ticket_store = none;
        let (s, _) = try l.accept() catch _ { return; };
        let srv = try Server::new(s, cfg) catch _ { continue; };
        try srv.write_all("hello") catch _ {};
        srv.close();
    }
}

fn main() {
    let l = try! tcp_listen("127.0.0.1:0");
    let port = (try! l.local_addr()).port();
    let t = thread::spawn(|| serve(l));
    let cfg = try! ClientConfig::try_new();
    cfg.root_certs = try! Certificate::from_pem(CA);
    for what in ["good", "delegated responder", "sha-256 CertID", "revoked", "for another certificate", "bad signature", "not successful", "none stapled", "must-staple, none stapled", "must-staple, good"] {
        let s = try! tcp_connect(f"127.0.0.1:{port}");
        let c = try Client::with_config(s, "localhost", cfg) catch e {
            println(f"{what}: {e.kind():?} {e.message()} (alert {e.alert()})");
            continue;
        };
        let got = try c.read_to_end() catch e { println(f"{what}: read {e}"); continue; };
        println(f"{what}: {try str::from_utf8(got) catch _ { "?" }}");
        c.close();
    }
    try! t.join();
}


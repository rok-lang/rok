// Free functions and modules `#[cfg]` dropped are named too.
#[cfg(target_os = "plan9")]
fn plan9_fn() -> i32 { 3 }

#[cfg(target_os = "plan9")]
mod plan9 { pub fn inner() -> i32 { 4 } }

mod sys { #[cfg(feature = "extra")] pub fn extra() -> i32 { 5 } }

let c =
    plan9_fn() +
    plan9::inner() +
    sys::extra();

// expect-exit: 0
// expect-stdout:
// circle 2
// rect 3x4
// empty
// areas 12 12 0

// An enum is a tag plus the largest variant's payload;
// construction stores the tag and payload, matching reads the tag and
// then the payload of that variant.
enum Shape {
    Circle(i32),
    Rect { w: i32; h: i32; },
    Empty,
}

fn describe(s: Shape) -> str {
    match s {
        Shape::Circle(r) => f"circle {r}",
        Shape::Rect { w, h } => f"rect {w}x{h}",
        Shape::Empty => "empty",
    }
}

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Empty => 0,
    }
}

fn main() -> i32 {
    let all = [Shape::Circle(2), Shape::Rect { w: 3, h: 4 }, Shape::Empty];
    for s in all { println(describe(s)); }
    println(f"areas {area(all[0])} {area(all[1])} {area(all[2])}");
    return 0;
}

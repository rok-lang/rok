// spec: std 004-lang-slot-table §0.4.4 / refs-lang §6.2.7
// expect-exit: 0
// expect-warning: use of deprecated function `index_from_end`
// expect-warning: a compiler hook, not callable in 0.2.0: write `xs[i]`, which counts a negative `i` from the end
// expect-warning: use of deprecated function `slice_bound`
// expect-warning: write `xs[i:]`
// expect-stdout:
// 2 3

// A hook called by name still works, with a warning: it is not
// callable in 0.2.0.
fn main() {
    let at = rok::core::index::index_from_end(-1, 3);
    let t = rok::core::index::slice_bound(-2, 5);
    println(f"{at} {t}");
}

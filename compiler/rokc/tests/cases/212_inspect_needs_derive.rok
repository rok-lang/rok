// spec: std §2.12.3
// expect-error: 18:13: no associated function `fields` on `Point`
// expect-error: help: add `#[derive(Inspect)]` to `Point` to use `fields`
// expect-error: 19:13: no method `variant_name` found for type `Shape`
// expect-error: help: add `#[derive(Inspect)]` to `Shape` to use `variant_name`
// expect-error: 20:13: no method `get_field` found for type `Box<i32>`
// expect-error: help: add `#[derive(Inspect)]` to `Box` to use `get_field`
// expect-error: 21:5: type `Point` does not satisfy trait bound `Inspect`
// expect-error: help: add `#[derive(Inspect)]` to `Point`

// Stdlib 2.12.3: field and variant introspection is opt-in; using it on a
// type without `#[derive(Inspect)]` says to add the derive.
struct Point { x: i32; }
enum Shape { Dot, Line(i32) }
struct Box<T> { v: T; }

fn main() {
    let a = Point::fields();
    let b = Shape::Dot.variant_name();
    let c = Box { v: 1 }.get_field("v");
    reflect::fields_of::<Point>();
}

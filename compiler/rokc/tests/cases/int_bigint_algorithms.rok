// `int` past every algorithm cut-off; LCG operands, Python-computed results.

fn make(seed: u64, limbs: usize) -> int {
    let x: int = 0;
    let s = seed;
    for _ in 0..limbs {
        s = s.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        let v = if s % 7u64 == 0u64 { 0xFFFF_FFFFu64 } else { s >> 32u64 };
        x = (x << 32u32) + int::from(v);
    }
    x
}

fn hstr(t: str) -> u64 {
    let b = t.as_bytes();
    let h = 0u64;
    for i in 0..b.len() { h = h.wrapping_mul(31u64).wrapping_add(b[i] as u64); }
    h
}

fn main() {
    let md: int = 2305843009213693951;
    let cases = [(1usize, 1usize, 1u64, 2u64, false, false), (1usize, 3usize, 3u64, 4u64, true, false), (2usize, 1usize, 5u64, 6u64, false, true), (2usize, 2usize, 7u64, 8u64, false, false), (2usize, 3usize, 9u64, 10u64, true, false), (3usize, 1usize, 11u64, 12u64, false, false), (3usize, 2usize, 13u64, 14u64, false, false), (3usize, 3usize, 15u64, 16u64, true, true), (33usize, 3usize, 17u64, 18u64, false, false), (33usize, 16usize, 19u64, 20u64, false, false), (33usize, 32usize, 21u64, 22u64, true, false), (33usize, 33usize, 23u64, 24u64, false, false), (40usize, 3usize, 25u64, 26u64, false, true), (40usize, 20usize, 27u64, 28u64, true, false), (40usize, 39usize, 29u64, 30u64, false, false), (40usize, 40usize, 31u64, 32u64, false, false), (41usize, 3usize, 33u64, 34u64, true, false), (41usize, 20usize, 35u64, 36u64, false, true), (41usize, 40usize, 37u64, 38u64, false, false), (41usize, 41usize, 39u64, 40u64, true, false), (63usize, 3usize, 41u64, 42u64, false, false), (63usize, 31usize, 43u64, 44u64, false, false), (63usize, 62usize, 45u64, 46u64, true, true), (63usize, 63usize, 47u64, 48u64, false, false), (64usize, 3usize, 49u64, 50u64, false, false), (64usize, 32usize, 51u64, 52u64, true, false), (64usize, 63usize, 53u64, 54u64, false, false), (64usize, 64usize, 55u64, 56u64, false, true), (65usize, 3usize, 57u64, 58u64, true, false), (65usize, 32usize, 59u64, 60u64, false, false), (65usize, 64usize, 61u64, 62u64, false, false), (65usize, 65usize, 63u64, 64u64, true, false), (121usize, 3usize, 65u64, 66u64, false, true), (121usize, 60usize, 67u64, 68u64, false, false), (121usize, 120usize, 69u64, 70u64, true, false), (121usize, 121usize, 71u64, 72u64, false, false), (129usize, 3usize, 73u64, 74u64, false, false), (129usize, 64usize, 75u64, 76u64, true, true), (129usize, 128usize, 77u64, 78u64, false, false), (129usize, 129usize, 79u64, 80u64, false, false), (199usize, 3usize, 81u64, 82u64, true, false), (199usize, 99usize, 83u64, 84u64, false, false), (199usize, 198usize, 85u64, 86u64, false, true), (199usize, 199usize, 87u64, 88u64, true, false), (201usize, 3usize, 89u64, 90u64, false, false), (201usize, 100usize, 91u64, 92u64, false, false), (201usize, 200usize, 93u64, 94u64, true, false), (201usize, 201usize, 95u64, 96u64, false, true), (299usize, 3usize, 97u64, 98u64, false, false), (299usize, 149usize, 99u64, 100u64, true, false), (299usize, 298usize, 101u64, 102u64, false, false), (299usize, 299usize, 103u64, 104u64, false, false), (301usize, 3usize, 105u64, 106u64, true, true), (301usize, 150usize, 107u64, 108u64, false, false), (301usize, 300usize, 109u64, 110u64, false, false), (301usize, 301usize, 111u64, 112u64, true, false), (401usize, 3usize, 113u64, 114u64, false, false), (401usize, 200usize, 115u64, 116u64, false, true), (401usize, 400usize, 117u64, 118u64, true, false), (401usize, 401usize, 119u64, 120u64, false, false), (700usize, 3usize, 121u64, 122u64, false, false), (700usize, 350usize, 123u64, 124u64, true, false), (700usize, 699usize, 125u64, 126u64, false, true), (700usize, 700usize, 127u64, 128u64, false, false), (1399usize, 3usize, 129u64, 130u64, true, false), (1399usize, 699usize, 131u64, 132u64, false, false), (1399usize, 1398usize, 133u64, 134u64, false, false), (1399usize, 1399usize, 135u64, 136u64, true, true), (1401usize, 3usize, 137u64, 138u64, false, false), (1401usize, 700usize, 139u64, 140u64, false, false), (1401usize, 1400usize, 141u64, 142u64, true, false), (1401usize, 1401usize, 143u64, 144u64, false, false), (2001usize, 3usize, 145u64, 146u64, false, true), (2001usize, 1000usize, 147u64, 148u64, true, false), (2001usize, 2000usize, 149u64, 150u64, false, false), (2001usize, 2001usize, 151u64, 152u64, false, false), (2900usize, 3usize, 153u64, 154u64, true, false), (2900usize, 1450usize, 155u64, 156u64, false, true), (2900usize, 2899usize, 157u64, 158u64, false, false), (2900usize, 2900usize, 159u64, 160u64, true, false)];
    for (n, m, sa, sb, na, nb) in cases {
        let a = make(sa, n);
        if na { a = -a; }
        let b = make(sb, m);
        if nb { b = -b; }
        let p = a * b;
        let (q, r) = (a * b + make(sa + 7u64, if m / 2 > 0 { m / 2 } else { 1 })).div_rem(b);
        let sq = a * a;
        let ok = q * b + r == a * b + make(sa + 7u64, if m / 2 > 0 { m / 2 } else { 1 }) && r.abs() < b.abs();
        if !ok { println(f"bad division {n} {m}"); }
        println(f"{n} {m} {p %% md} {sq %% md} {q %% md} {r %% md} {q.bit_length()} {r.bit_length()}");
    }
    for n in [1usize, 3usize, 40usize, 41usize, 81usize, 200usize, 401usize, 1000usize, 2001usize, 6500usize] {
        let x = make(1000u64 + (n as u64), n);
        let s = f"{x}";
        let back = try! s.parse::<int>();
        if back != x { println(f"bad round trip {n}"); }
        let l = n * 9 + 5;
        let v = try! "3074185296".repeat(l / 10 + 1)[0:l].parse::<int>();
        println(f"{n} {s.len()} {hstr(s)} {v %% md} {v.bit_length()}");
    }
    for (n, r) in [(70usize, 16u32), (70usize, 2u32), (90usize, 7u32), (300usize, 36u32), (1500usize, 3u32)] {
        let x = -make(2000u64 + (n as u64), n);
        let t = x.to_str_radix(r);
        let back = int::parse_radix(t, r) ?? 0;
        if back != x { println(f"bad radix round trip {r}"); }
        println(f"r{r} {n} {t.len()} {hstr(t)}");
    }
    let f: int = 1;
    for i in 2..=20000 { f = f * int::from(i); }
    let fs = f"{f}";
    let t3 = int::from(3).pow(200000u32);
    let t3s = f"{t3}";
    println(f"fact {fs.len()} {hstr(fs)} {fs[0:12]} {(t3 * t3) %% md} {t3s.len()}");
}

// Rust's macros, visibility and lifetimes: each error names the Rok form.

macro_rules! sq {
    ($x:expr) => { $x * $x };
}

fn prints() {
    let x = 1;
    let y = [2];
    let n = 3;
    println!("{} and {:?}", x, y);
    println!("{n} {}", x);
    println!("plain");
    let s = format!("{}-{}", x, y);
    let v = vec![1, 2, 3];
    let w = vec![0; n];
    assert_eq!(x, 1);
    assert!(x > 0, "bad {}", x);
    panic!("no {x}");
}


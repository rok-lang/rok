// expect-exit: 18
// expect-stdout:
// 10 1 2 3 10

fn main() -> i32 {
    let xs: [i32; 5] = [1, 2, 3, 4, 5];
    let total = 0;
    for v in xs {
        let scaled = match v {
            1 | 5 => 10,
            n => n - 1,
        };
        if v > 1 { print(" "); }
        print(f"{scaled}");
        total += scaled;
    }
    println("");
    return total - 8;
}


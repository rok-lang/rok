// expect-exit: 3
// expect-stdout:
// before
// inner

// `rok_exit` (behind `process::exit`) ends the process at once
// with the code; `finally` and `Drop` do not run, but what was already
// printed is not lost.
use rok::std::process;

fn work() throws (str) {
    try {
        println("inner");
        process::exit(3);
    } finally {
        println("finally ran");
    }
}

fn main() throws (str) {
    println("before");
    try work();
    println("after");
}

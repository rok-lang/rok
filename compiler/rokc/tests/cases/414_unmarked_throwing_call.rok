// A call to a throwing function must sit under `try`; no unmarked propagation.
// expect-error: must be marked with `try`

fn parse(s: i32) throws (i32) -> i32 {
    if s < 0 { throw -1; }
    return s;
}

fn caller() throws (i32) -> i32 {
    let v = parse(1);
    return v;
}

fn main() -> i32 {
    return try caller() catch _ { 0 };
}

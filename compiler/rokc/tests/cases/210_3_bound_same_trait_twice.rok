// expect-exit: 0
// expect-stdout:
// V+i32 2 | 102 | V+i32 4 | V+i32 5 | 105 | 106
// V+i32 3 200
// int 5, str x, int 7
// i32 3 false 12 11 true
// 11 true
// true

// `T: Add<i32> + Add<f64>`: the arguments pick the bound, as for impls.
use rok::core::ops::Add;

struct V { n: i64; }
impl Add<i32> for V {
    type Output = str;
    fn add(self, rhs: i32) -> str { f"V+i32 {self.n + rhs as i64}" }
}
impl Add<f64> for V {
    type Output = i64;
    fn add(self, rhs: f64) -> i64 { self.n * 100 + rhs as i64 }
}

fn ops<T: Add<i32, Output = str> + Add<f64, Output = i64>>(x: T) {
    let a: str = x + 1i32;
    let b: i64 = x + 2.5;
    let c = x + 3;
    let d = x.add(4i32);
    let e = x.add(5.0);
    let f = <T as Add<f64>>::add(x, 6.0);
    println(f"{a} | {b} | {c} | {d} | {e} | {f}");
}

// Opaque outputs: each projection is its own bound's.
fn outs<T: Add<i32> + Add<f64>>(x: T) -> (<T as Add<i32>>::Output, <T as Add<f64>>::Output) {
    (x + 1, x + 0.5)
}

struct W { s: str; }
impl From<i64> for W { fn from(v: i64) -> W { W { s: f"int {v}" } } }
impl From<str> for W { fn from(v: str) -> W { W { s: f"str {v}" } } }
fn conv<T: From<i64> + From<str>>() -> List<T> { [T::from(5i64), T::from("x"), T::from(7)] }

trait Tag<K> {
    const ID: u32;
    type Out;
    fn tag(self, k: K) -> Out;
    fn make(self) -> K;
}
struct P {}
impl Tag<i32> for P {
    const ID: u32 = 1;
    type Out = str;
    fn tag(self, k: i32) -> str { f"i32 {k}" }
    fn make(self) -> i32 { 11 }
}
impl Tag<bool> for P {
    const ID: u32 = 2;
    type Out = bool;
    fn tag(self, k: bool) -> bool { !k }
    fn make(self) -> bool { true }
}
fn tags<T: Tag<i32, Out = str> + Tag<bool, Out = bool>>(x: T) -> str {
    let a: str = x.tag(3);
    let b: bool = x.tag(true);
    let m: bool = x.make();
    let n: i32 = x.make();
    let ids = <T as Tag<i32>>::ID * 10 + <T as Tag<bool>>::ID;
    f"{a} {b} {ids} {n} {m}"
}
fn qualified<T: Tag<i32> + Tag<bool>>(x: T) -> str {
    let a = <T as Tag<i32>>::make(x);
    let b = <T as Tag<bool>>::make(x);
    f"{a} {b}"
}

fn main() {
    ops(V { n: 1 });
    let (s, n) = outs(V { n: 2 });
    println(f"{s} {n}");
    let ws: List<W> = conv();
    println(f"{ws[0].s}, {ws[1].s}, {ws[2].s}");
    println(tags(P {}));
    println(qualified(P {}));
    let m: bool = P {}.make();
    println(f"{m}");
}

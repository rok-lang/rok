// expect-exit: 0
// expect-stdout:
// 1000000000000000000
// 1000000000000000000000
// 1000000000000000000000000000000000000000000
// 3 -3
// 9999999999 3000 1003 42
// 10000003999 29999999997000000 0 true 9999999999
// true false


// `int` never wraps (the 10^42 example), `/` truncates
// (`7 / 2 = 3`, `-7 / 2 = -3`), Eq / Ord / Hash; `let big: int
// = 9999999999;`; `int + int = int`, `a + int::from_i32(b)`;
// 2.1.5 Zero / One drive `sum` / `product`; 2.13.10 default is 0.
fn main() {
    let big: int = 1;
    big = big * 1000;
    big = big * 1000;
    big = big * 1000;
    big = big * 1000;
    big = big * 1000;
    big = big * 1000;
    println(f"{big}");
    big = big * 1000;
    println(f"{big}");
    big = big * big;
    println(f"{big}");
    let seven: int = 7;
    let two: int = 2;
    println(f"{seven / two} {-seven / two}");
    let lit: int = 9999999999;
    let a: int = 1000;
    let b: int = 2000;
    let c = a + b;
    let i: i32 = 3;
    println(f"{lit} {c} {a + int::from_i32(i)} {int::from(42i32)}");
    let xs: List<int> = [lit, c, a];
    let total: int = xs.iter().sum();
    let prod: int = xs.iter().product();
    println(f"{total} {prod} {int::default()} {lit > c} {xs.iter().max() ?? a}");
    let s: Set<int> = Set::new();
    s.insert(lit * lit);
    println(f"{s.contains(lit * lit)} {s.contains(lit)}");
}

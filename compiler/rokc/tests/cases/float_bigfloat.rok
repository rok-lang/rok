// gc-stress: 5
// expect-exit: 0
// expect-stdout:
// 0.30000000000000004 false true
// 1.0000000000000002e900  0 -1.0000000000000002e900 true true true
// 1e-600 1 0 true true true
// 5e-324 1e-323 0.
// 1.5e400 -2.5e-400 100000000000000000000000000000 -3.7499999999999996
// inf -inf NaN false false true inf NaN
// 1e-5000 true -inf 0.5 6.02214076e123456 1
// [1.000e300] [1.000e900] [1E-600] [     0.1] [1.0000000000000002e900] [+1.00] [1.50e400]
// [1000000000000000019884624838656.0] [0.000]
// 1.5 -1.5 -0.5 3.7464414834955154e599 3.7464414834955154e599
// 7 -75000000000 inf  inf inf 1.5 true
// 123456789012345690000000000000000 123456789012345686040493921665024 true 2990 7
//  0 true true true 1.0000000000000002e900
// true true 0.1

// A finite `float` result past `f64`'s range is promoted (53-bit
// significand, unbounded exponent) instead of becoming inf or 0
// (std 2.1.3). Expected values come from an exact fractions model.

fn main() {
    let a: float = 0.1;
    let b: float = 0.2;
    println(f"{a + b} {a + b == 0.3} {(a + b).to_f64() == 0.1 + 0.2}");
    let h: float = 1e300;
    let big = h * h * h;
    println(f"{big} {big / h / h} {big * 0} {-big} {big > h} {-big < h} {big == big}");
    let t: float = 1e-300;
    let tiny = t * t;
    println(f"{tiny} {tiny * 1e300 * 1e300} {tiny.to_f64()} {tiny > 0} {tiny < t} {-tiny < 0}");
    let sub: float = 5e-324;
    println(f"{sub} {sub * 2} {sub.to_f64()}");
    let lit: float = 1.5e400;
    let lit2: float = -2.5e-400;
    let lit3: float = 100000000000000000000000000000;
    println(f"{lit} {lit2} {lit3} {lit * lit2}");

    // IEEE specials.
    let one: float = 1;
    let z: float = 0;
    let inf = one / z;
    let nan = z / z;
    println(f"{inf} {-inf} {nan} {nan == nan} {nan < one} {inf > big} {big + inf} {inf - inf}");

    // Parse.
    let p: float = try! "6.02214076e123456".parse::<float>();
    println(f"{float::parse_or_none("1e-5000") ?? z} {float::parse_or_none("abc") is none} {float::parse_or_none("-inf") ?? z} {float::parse_or_none(".5") ?? z} {p} {p / p}");

    // f-strings.
    println(f"[{h:.3e}] [{big:.3e}] [{tiny:E}] [{a:>8}] [{big:>15}] [{one:+.2f}] [{lit:.2}]");
    println(f"[{float::parse_or_none("1e30") ?? z:.1f}] [{tiny:.3f}]");

    // `%` is exact (fmod), `%%` floored.
    let r: float = 7.5;
    let m: float = 2;
    println(f"{r % m} {-r % m} {r %% -m} {big % (h * h)} {(big + h * h * 3) % (h * h)}");

    // Conversions (2.11.8): into f64 rounds, try_into truncates.
    let i: i32 = try! r.try_into();
    let j: i64 = try! (-r * 1e10).try_into();
    let x: f64 = big.into();
    let y: f64 = h.into();
    let bad: i32 | none = try? big.try_into::<i32>();
    println(f"{i} {j} {x} {y} {big as f64} {h as f32} {float::from(1.5f32)} {bad is none}");
    let fi: float = float::from_int(int::parse_radix("123456789012345678901234567890123", 10u32) ?? 0 as int);
    println(f"{fi} {fi.to_int() ?? 0 as int} {inf.to_int() is none} {(big.to_int() ?? 0 as int).bit_length()} {(r.to_int() ?? 0 as int)}");
    let s = [a, b, h].iter().fold(z, |acc, v| acc + v);
    println(f"{s} {float::default()} {big.is_finite()} {inf.is_infinite()} {nan.is_nan()} {big.abs()}");
    let ovf: f32 | none = big.to_f32();
    println(f"{ovf is none} {h.to_f32() is none} {(a.to_f32() ?? 0.0f32)}");
}

// spec: std 201-numbers

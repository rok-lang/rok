// only-os: macos linux
// (RawPath::from_bytes is unix-only, std 3.8.5)
// needs: process
// expect-exit: 0
// expect-stderr: hi
// expect-stdout:
// exact: [abcd] [efgh] eof: UnexpectedEof
// copy: 20000 same: true
// chunk: 3 [xyz]
// raw: true "h�i�!"
// raw err: 1
// utf8: é세 bad at 1
// push: aé세🎉 10
// affix: true false true false true
// stdout bytes: ok
// env: true none
// canonical: true exe: true
// read_dir names: 2

// Byte paths of std::io / fs / env / path: `read_exact` across short
// reads, `io::copy`, `RawPath` lossy and checked conversion, `var_os`,
// `canonicalize`, `current_exe`, byte writes to stdout, and the
// `StrBuf` / `str` byte primitives.

use rok::std::io;
use rok::std::io::{IoError, IoErrorKind, Reader, Writer};
use rok::std::fs;
use rok::std::env;
use rok::std::path::{Path, RawPath};
use rok::std::process;

/// Hands out at most `step` bytes per `read`.
struct Trickle {
    data: List<u8>;
    pos: usize;
    step: usize;
}

impl Reader for Trickle {
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize {
        let n = 0usize;
        while n < buf.len() && n < self.step && self.pos < self.data.len() {
            buf[n] = self.data[self.pos];
            n += 1;
            self.pos += 1;
        }
        n
    }
}

fn text(b: List<u8>) -> str { try! str::from_utf8(b) }

fn main() throws (IoError) {
    let t = Trickle { data: "abcdefghij".as_bytes().to_list(), pos: 0, step: 3 };
    let a = io::byte_buf(4);
    try t.read_exact(a);
    let b = io::byte_buf(4);
    try t.read_exact(b);
    let kind = try { t.read_exact(io::byte_buf(4)); "none" } catch e { f"{e.kind():?}" };
    println(f"exact: [{text(a)}] [{text(b)}] eof: {kind}");

    // Its own directory: other processes come and go in the temp dir.
    let dir = env::temp_dir() / f"rok_bytes_io_{process::id()}";
    try fs::create_dir_all(dir);
    let src = dir / f"rok_bytes_io_{process::id()}.bin";
    let dst = dir / f"rok_bytes_io_{process::id()}.out";
    let big: List<u8> = List::new();
    for i in 0..20000 { big.push((i % 251) as u8); }
    try fs::write(src, big);
    let n = 0u64;
    using r = try fs::open(src) {
        using w = try fs::create(dst) {
            n = try io::copy(ref r, ref w);
        }
    }
    println(f"copy: {n} same: {(try fs::read(dst)) == big}");

    let tail = big[19997:20000];
    try fs::write(dst, "xyz".as_bytes());
    try fs::write_atomic(src, tail);
    println(f"chunk: {(try fs::read(src)).len()} [{try fs::read_to_str(dst)}]");

    let raw = RawPath::from_bytes([104u8, 0xFFu8, 105u8, 0xE2u8, 0x82u8, 33u8]);
    println(f"raw: {raw.as_bytes().len() == 6} {raw.to_path_lossy().as_str():?}");
    let e = try { raw.try_to_path(); 0usize } catch x { x.valid_up_to };
    println(f"raw err: {e}");

    let bad = try { str::from_utf8([0x61u8, 0xC3u8]); 99usize } catch x { x.valid_up_to };
    println(f"utf8: {try! str::from_utf8("é세".as_bytes())} bad at {bad}");

    let sb = StrBuf::new();
    sb.push('a');
    sb.push('é');
    sb.push('세');
    sb.push('🎉');
    println(f"push: {sb.to_str()} {sb.len()}");
    println(f"affix: {"".starts_with("")} {"a".starts_with("ab")} {"ab".ends_with("b")} {"b".ends_with("ab")} {"ab".ends_with("")}");

    let out = io::stdout();
    try out.write_all("stdout bytes: ".as_bytes().to_list());
    try out.write_str("ok\n");
    try out.flush();
    try io::stderr().write_all([104u8, 105u8, 10u8]);

    unsafe { env::set_var("ROK_BYTES_IO", "v"); }
    let v = env::var_os("ROK_BYTES_IO");
    let present = if let x: env::RawStr = v { (try! x.to_str()) == "v" } else { false };
    unsafe { env::remove_var("ROK_BYTES_IO"); }
    let gone = if env::var_os("ROK_BYTES_IO") is none { "none" } else { "set" };
    println(f"env: {present} {gone}");

    let real = try Path::from(".").canonicalize();
    let exe = try env::current_exe();
    println(f"canonical: {real.is_absolute()} exe: {exe.is_absolute()}");

    let names = 0;
    using rd = try fs::read_dir(dir) {
        for entry in rd {
            let name = (try entry.get()).file_name();
            if name.starts_with(f"rok_bytes_io_{process::id()}") { names += 1; }
        }
    }
    println(f"read_dir names: {names}");
    try fs::remove_dir_all(dir);
}

// spec: std 305-io
// spec: std 305-io §3.5.2 §3.5.4

// expect-exit: 0
// expect-stdout:
// sum: true false false true true
// cmp: Less Equal Greater Greater
// list: true true false true false true
// lcmp: Less Equal Greater
// derive: true false
// eq: true true false
// generic: 1 none

// `PartialOrd` / `Ord` for `T | none` (`none` first, then the payload),
// compiler-dispatched like the sum's Clone / Eq / Hash, and
// for `List<T>` (lexicographic).
fn name(o: Ordering) -> str {
    match o { Ordering::Less => "Less", Ordering::Equal => "Equal", Ordering::Greater => "Greater" }
}

// With `T = i32 | none`, `next()` is the nested `(i32 | none)?`:
// the loop sees the stored `none`.
fn smallest<T: Ord>(xs: List<T>) -> T {
    let m = xs[0];
    for x in xs { if x < m { m = x; } }
    m
}

#[derive(PartialEq, PartialOrd)]
struct Rec { k: i32 | none; tag: List<i32>; }

fn main() -> i32 {
    let a: i32 | none = 1;
    let b: i32 | none = 2;
    let n: i32 | none = none;
    let m: i32 | none = 5;
    println(f"sum: {a < b} {b < a} {m < n} {n <= n} {n < a}");
    println(f"cmp: {name(a.cmp(b))} {name(n.cmp(n))} {name(b.cmp(a))} {name(m.cmp(n))}");

    let x: List<i32> = [1, 2, 3];
    let y: List<i32> = [1, 2, 4];
    let z: List<i32> = [1, 2];
    println(f"list: {x < y} {z < x} {y <= x} {x >= z} {x > x} {x <= x}");
    println(f"lcmp: {name(x.cmp(y))} {name(x.cmp(x))} {name(x.cmp(z))}");

    let r1 = Rec { k: 1, tag: x };
    let r2 = Rec { k: 1, tag: y };
    println(f"derive: {r1 < r2} {r2 < r1}");
    println(f"eq: {a == a} {a != n} {n == m}");

    let opts: List<i32 | none> = [3, none, 1];
    let low = smallest(opts);
    let ls: List<List<i32>> = [y, x, z];
    println(f"generic: {smallest(ls).len() - 1} {low:?}");
    0
}


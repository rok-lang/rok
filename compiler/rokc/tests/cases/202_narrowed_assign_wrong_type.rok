// expect-error: 8:23: mismatched types: assignment to `v` expects `i32 | str`, found `bool`

// Inside the narrowed block `v` is `i32`; a value of another member of the
// declared type ends the narrowing, but one outside the
// declared type is still an error, reported against the declared type.
fn main() -> i32 {
    let v: i32 | str = 1;
    if v is i32 { v = true; }
    return 0;
}

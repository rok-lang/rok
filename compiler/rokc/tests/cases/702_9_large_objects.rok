// expect-exit: 0
// expect-stdout:
// 200000 19999900000
// 65536 true true
// live drops after release: true

// Objects at or over the LOS threshold are allocated
// directly (not in the TLAB); they survive collection while reachable and
// are reclaimed once unreachable.
extern "C" {
    fn rok_gc_collect();
    fn rok_gc_stats_live_bytes() -> usize;
}

fn sum(xs: List<i64>) -> i64 {
    let t = 0i64;
    for x in xs { t += x; }
    return t;
}

fn main() -> i32 {
    let big: List<i64> = [];
    let i = 0i64;
    while i < 200000i64 { big.push(i); i += 1i64; }
    let s = "x";
    let k = 0;
    while k < 16 { s = s + s; k += 1; }
    unsafe { rok_gc_collect() };
    let j = 0;
    while j < 10000 { let _junk = f"junk{j}"; j += 1; }
    unsafe { rok_gc_collect() };
    println(f"{big.len()} {sum(big)}");
    println(f"{s.len()} {s.starts_with("xxxx")} {s.ends_with("xxxx")}");
    let before = unsafe { rok_gc_stats_live_bytes() };
    big = [];
    s = "";
    unsafe { rok_gc_collect() };
    let after = unsafe { rok_gc_stats_live_bytes() };
    println(f"live drops after release: {after + 1000000usize < before}");
    return 0;
}

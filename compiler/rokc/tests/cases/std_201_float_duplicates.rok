// spec: std 201-numbers §2.1.4 / std 215-string §2.15.4 / refs-lang §6.2.7
// expect-exit: 0
// expect-warning: use of deprecated method `f64::powf`
// expect-warning: use `pow`, which is the same
// expect-warning: use of deprecated method `f32::nan`
// expect-warning: use `f32::NAN`
// expect-stdout:
// 8 8 true true 0.5
// SS ß i̇ X

// `powf` duplicates `pow` and `nan()` duplicates `NAN`; both still work.
// `char::to_uppercase_str` / `to_lowercase_str` map a char fully, to
// several chars where Unicode says so.
fn main() {
    let a = 2.0.pow(3.0);
    let b = 2.0.powf(3.0);
    let n = f32::nan();
    println(f"{a} {b} {n.is_nan()} {f64::NAN.is_nan()} {Int::from_i64(1).to_f64() / 2.0}");
    println(f"{'ß'.to_uppercase_str()} {'ß'.to_lowercase_str()} {'\u{130}'.to_lowercase_str()} {'x'.to_uppercase_str()}");
}

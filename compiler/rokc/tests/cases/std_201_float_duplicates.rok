// spec: std 201-numbers §2.1.4 / std 215-string §2.15.4 / refs-lang §6.2.7
// expect-exit: 0
// expect-stdout:
// 8 8 true 0.5
// SS ß i̇ X

// `pow` is the one float power (`powi` takes an i32); `NAN` the one NaN.
// `char::to_uppercase` / `to_lowercase` map a char fully, to several
// chars where Unicode says so.
fn main() {
    let a = 2.0.pow(3.0);
    let b = 2.0.powi(3);
    println(f"{a} {b} {f64::NAN.is_nan()} {Int::from_i64(1).to_f64() / 2.0}");
    println(f"{'ß'.to_uppercase()} {'ß'.to_lowercase()} {'\u{130}'.to_lowercase()} {'x'.to_uppercase()}");
}

// expect-exit: 0
// expect-stdout:
// fn 0 1 2
// block 1 2 3
// closure 10 20 / 10 20

// The three generator forms (`yield fn`, `yield { }`,
// `yield || { }`) all produce an iterator; each call of a `yield` closure
// makes a fresh iterator.
yield fn count_up_to(n: i32) -> i32 {
    let i = 0;
    while i < n {
        yield i;
        i = i + 1;
    }
}

fn main() -> i32 {
    let s = "fn";
    for x in count_up_to(3) { s = s + f" {x}"; }
    println(s);

    let it = yield {
        yield 1i32;
        yield 2i32;
        yield 3i32;
    };
    let b = "block";
    for x in it { b = b + f" {x}"; }
    println(b);

    let make = yield || {
        yield 10i32;
        yield 20i32;
    };
    let c = "closure";
    for x in make() { c = c + f" {x}"; }
    c = c + " /";
    for x in make() { c = c + f" {x}"; }
    println(c);
    return 0;
}

// spec: refs-lang 909-debug-tools §9.9.8
// needs: threads
// run-env: ROKR_GC_STRESS=often
// run-env: ROKR_GC_EVAC=never
// run-env: ROKR_GC_CONCURRENT=never
// run-env: ROKR_GC_STATS=yes
// run-env: ROKR_GC_LOG=2
// run-env: ROKR_HEAP_DUMP=always
// run-env: ROKR_WORKERS=0
// run-env: ROKR_THREAD_PER_CORE=on
// run-env: ROKR_DYNAMIC_WORKERS=true
// expect-exit: 0
// expect-stderr: rok: warning: ignoring ROKR_GC_STRESS=often (expected a number)
// expect-stderr: rok: warning: ignoring ROKR_GC_EVAC=never (expected always)
// expect-stderr: rok: warning: ignoring ROKR_GC_CONCURRENT=never (expected auto|always|off)
// expect-stderr: rok: warning: ignoring ROKR_GC_STATS=yes (expected 0|1)
// expect-stderr: rok: warning: ignoring ROKR_GC_LOG=2 (expected 0|1)
// expect-stderr: rok: warning: ignoring ROKR_HEAP_DUMP=always (expected on_oom)
// expect-stderr: rok: warning: ignoring ROKR_THREAD_PER_CORE=on (expected 0|1)
// expect-stderr: rok: warning: ignoring ROKR_DYNAMIC_WORKERS=true (expected 0|1)
// expect-stderr: rok: warning: ignoring ROKR_WORKERS=0 (expected a positive number)
// expect-stdout:
// workers true
// sum 5050

// A runtime knob set to a value outside its accepted ones warns once on
// stderr and keeps its default: no stress, no evacuation forced, auto
// concurrent marking, no stats, no log, no heap dump, the online CPUs as
// workers, stealing, a fixed pool.
use rok::bare::gc;

async fn run() -> i64 {
    println(f"workers {task::worker_count() > 0}");
    let tasks: List<Task<i64>> = List::new();
    for i in 1..101 {
        tasks.push(task::spawn(async { i as i64 }));
    }
    let sum = 0i64;
    for t in tasks {
        sum = sum + await t;
    }
    sum
}

fn main() {
    let words: List<str> = [];
    for i in 0..1000 {
        words.push(f"w{i}");
    }
    gc::collect();
    println(f"sum {task::block_on(run())}");
}

// only-os: macos linux
// expect-exit: 0
// expect-stdout:
// stdio: 0 1 2
// file: true
// adopted: hi
// socket: ping

// `os::unix::io`: `AsRawFd` gives the descriptor a handle owns (-1 once
// closed), `IntoRawFd` gives it up and `FromRawFd` hands it to a new
// owner, so only `g` closes it.
use rok::std::fs;
use rok::std::fs::File;
use rok::std::env;
use rok::std::os::unix::io::{AsRawFd, FromRawFd, IntoRawFd, RawFd};
use rok::std::net::{TcpListener, TcpStream};
use rok::core::io::IoError;

fn main() throws (IoError) {
    println(f"stdio: {io::stdin().as_raw_fd()} {io::stdout().as_raw_fd()} {io::stderr().as_raw_fd()}");
    let path = env::temp_dir() / "rok_raw_fd";
    try fs::write(path, "hi");
    let f = try File::open(path);
    let shown: RawFd = f.as_raw_fd();
    let fd: RawFd = f.into_raw_fd();
    println(f"file: {fd > 2 && fd == shown}");
    let g = unsafe { File::from_raw_fd(fd) };
    println(f"adopted: {try g.read_to_str()}");
    try g.close();
    try fs::remove_file(path);

    using l = try TcpListener::bind("127.0.0.1:0") {
        let s = (try TcpStream::connect(try l.local_addr())).into_raw_fd();
        let d = unsafe { TcpStream::from_raw_fd(s) };
        let (peer, _) = try l.accept();
        try d.write_all("ping");
        try d.close();
        println(f"socket: {try str::from_utf8(try peer.read_to_end())}");
        try peer.close();
    }
}

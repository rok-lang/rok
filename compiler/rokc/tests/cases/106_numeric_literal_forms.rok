// spec: §1.6.1 §1.6.2 §1.6.3 §1.6.4 §1.6.6
// expect-exit: 0
// expect-stdout:
// 123 26 1 493 4294967295 165 3.141592653
// 1 0.5 15000000000 0.002 2 3 3
// i32 f64 u8 i64 f32 f64 i64 i64
// f64 f64 i32 i64 u8 i32 i64
// -1 -128 -2147483648
// 300 8

fn ident(x: f64) -> f64 { x }

fn main() {
    // 1.6.1: no leading zero on a decimal (`0o` is octal); every radix takes `_`.
    let lead = 123;
    let hex = 0X1a;
    let bin = 0B1;
    let oct = 0o755;
    let sep = 0xFFFF_FFFFu32;
    let bits = 0b1010_0101;
    let pi = 3.141_592_653;
    println(f"{lead} {hex} {bin} {oct} {sep} {bits} {pi}");
    // `1.` and `2e10` are floats; `1..3` is a range, `1.+2` a float sum.
    let one = 1.;
    let exp = 1.5e10;
    let small = 2e-3;
    let n = (1..3).len();
    let sum = 1.+2;
    let t = (1, 3);
    println(f"{one} {0.5} {exp} {small} {n} {sum} {t.1}");
    // 1.6.2: numeric suffixes fix the type; `f64` may follow an integer form.
    let a = 42i32;
    let b = 3.14f64;
    let c = 0xFFu8;
    let d = 1_000_000i64;
    let e = 2f32;
    let f = 1f64;
    println(f"{a.type_name_of_val()} {b.type_name_of_val()} {c.type_name_of_val()} {d.type_name_of_val()} {e.type_name_of_val()} {f.type_name_of_val()} {(w() + (1 + 2)).type_name_of_val()} {(if a > 0 { 0 } else { w() }).type_name_of_val()}");
    // 1.6.3: the expected type, then the other operand, then the defaults.
    let x: f64 = 1;
    let s: f64 = 2.0;
    let r = a * 2;
    let v: i64 | f64 = 1;
    let m: u8 = 2 * 100;
    let k = 1 + 2;
    let p = 7i64 - 2;
    println(f"{x.type_name_of_val()} {(s * 2).type_name_of_val()} {r.type_name_of_val()} {v.type_name_of_val()} {m.type_name_of_val()} {k.type_name_of_val()} {p.type_name_of_val()}");
    // 1.6.4 / 1.6.6: `as` for a bit pattern; `-` admits MAX + 1.
    let g = 0xFFu8 as i8;
    let h = -128i8;
    let i = -2147483648;
    println(f"{g} {h} {i}");
    println(f"{ident(100) * 3} {lead / 15}");
}

fn w() -> i64 { 5 }

// expect-exit: 0
// expect-stdout:
// steps 3

// `yield;` advances one step without a value (unit).
yield fn ticks(n: i32) -> () {
    let i = 0;
    while i < n {
        yield;
        i = i + 1;
    }
}

fn main() -> i32 {
    let steps = 0;
    for _ in ticks(3) { steps = steps + 1; }
    println(f"steps {steps}");
    return 0;
}

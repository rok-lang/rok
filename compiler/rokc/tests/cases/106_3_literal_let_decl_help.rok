// A variable that took its type from an unsuffixed literal gets the fix at
// its declaration, not a cast at the use; a value the type can't hold
// keeps the cast.
fn take(x: f32) {}

fn count() -> i64 {
    let c = 0;
    c += 1;
    c
}

fn add(x: i64) -> i64 {
    let t = 3;
    t + x
}

fn main() {
    let s = -1.5;
    take(s);
    let w = 2;
    let b: u8 = 7u8;
    if w < b { }
    let big = 300;
    let k: u8 = big;
}

// spec: 007.07-io-and-timer §7.7.1 §7.7.2 §7.7.3 / 008.05 §8.5.5
// only-os: macos linux
// (POSIX pipe / read / write)
// needs: process threads
// expect-exit: 0
// expect-stdout:
// writable at once: true
// other task ran while parked: true
// read after readiness: 1 z

// spec 7.7.2: a readiness wait (`rok_io_register`, 8.5.5) registers
// the fd with the reactor (7.7.1) and parks the task; the worker runs
// other tasks meanwhile, and the readiness edge from another thread's
// write wakes the task, which then reads. A pipe's write end is
// writable at once.
use rok::core::sync::{LoadOrdering, StoreOrdering, UpdateOrdering};
use rok::bare::alloc::{Layout, alloc};
use rok::bare::ptr::{CPtr, Ptr};
use rok::bare::mem::{GcBuf, buf_new, transmute_unchecked};
use rok::std::thread;

/// Byte `at` of the scratch memory (an address is `Send`, a `Ptr` not).
fn byte(base: usize, at: usize) -> Ptr<u8> { unsafe { transmute_unchecked(base + at) } }

extern "C" {
    fn pipe(fds: Ptr<i32>) -> i32;
    fn read(fd: i32, buf: Ptr<u8>, n: usize) -> isize;
    fn write(fd: i32, buf: Ptr<u8>, n: usize) -> isize;
    fn rok_io_register(fd: i32, interest: u32, waker: GcBuf<future::Waker>);
}

/// Ready once `fd` may be read (`interest` 1) or written (2).
struct Ready { fd: i32; interest: u32; armed: bool; }
impl Future for Ready {
    type Output = ();
    fn poll(ref self, ref ctx: future::Context) -> future::Poll<()> {
        if self.armed { return future::Poll::Ready(()); }
        self.armed = true;
        let w: GcBuf<future::Waker> = unsafe { buf_new(1) };
        unsafe { w[0] = ctx.waker() };
        unsafe { rok_io_register(self.fd, self.interest, w) };
        future::Poll::Pending
    }
}

// No `main` combines `throws` with `-> i32` (spec 4.16.3).
fn main() -> i32 { try! run() }

fn run() throws (rok::bare::alloc::LayoutError) -> i32 {
    let raw: CPtr<u8> = unsafe { alloc(try Layout::array::<i32>(4usize)) };
    let mem: Ptr<u8> = raw.as_ptr() ?? panic("alloc failed");
    let fds = rok::bare::ptr_cast::<i32>(mem);
    if unsafe { pipe(fds) } != 0 { return 1; }
    let rfd = unsafe { fds.read() };
    let wfd = unsafe { fds.add(1usize).read() };
    let base = mem.addr();

    let w = task::block_on(async {
        await Ready { fd: wfd, interest: 2, armed: false };
        true
    });
    println(f"writable at once: {w}");

    let ticks = Atomic::new(0);
    let done = Atomic::new(0);
    let writer = thread::spawn(|| {
        while ticks.load(LoadOrdering::SeqCst) < 3 { thread::sleep(Duration::ms(1)); }
        let c = byte(base, 12);
        unsafe { c.write(122u8) };
        unsafe { write(wfd, c, 1usize) };
    });
    let got = task::block_on(async {
        let reader = task::spawn(async {
            await Ready { fd: rfd, interest: 1, armed: false };
            let b = byte(base, 8);
            let n = unsafe { read(rfd, b, 1usize) };
            done.store(1, StoreOrdering::SeqCst);
            f"{n} {char::from_u32(unsafe { b.read() } as u32) ?? '?'}"
        });
        let other = task::spawn(async {
            while done.load(LoadOrdering::SeqCst) == 0 {
                ticks.fetch_add(1, UpdateOrdering::SeqCst);
                await task::sleep(Duration::ms(1));
            }
        });
        let r = await reader;
        await other;
        r
    });
    try! writer.join();
    println(f"other task ran while parked: {ticks.load(LoadOrdering::SeqCst) >= 3}");
    println(f"read after readiness: {got}");
    return 0;
}

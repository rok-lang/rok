// expect-exit: 0
// expect-stdout:
// rsa2048 sha256: matches true, verifies true, other message false, as pss false
// rsa2048 sha384: matches true, verifies true, other message false, as pss false
// rsa2048 sha512: matches true, verifies true, other message false, as pss false
// rsa2049 sha256: matches true, verifies true, other message false, as pss false
// rsa2049 sha384: matches true, verifies true, other message false, as pss false
// rsa2049 sha512: matches true, verifies true, other message false, as pss false
// pss salt 0: with 0 true, with hash length false
// pss salt 20: with 20 true, with hash length false
// pss salt 64: with 64 true, with hash length false
// pss salt 222: with 222 true, with hash length false
// pss default salt: hash length true
// modulus round trip true, exponent 010001

// RSA PKCS #1 v1.5 signing (must equal OpenSSL's) and PSS verification.

use rok::core::crypto::HashAlgorithm;
use rok::core::crypto::rsa::{PrivateKey, PublicKey};

fn nib(c: u8) -> u8 {
    if c >= 0x30u8 && c <= 0x39u8 { return c - 0x30u8; }
    c - 0x61u8 + 10u8
}

fn unhex(s: str) -> List<u8> {
    let out: List<u8> = [];
    let b = s.as_bytes();
    let i = 0usize;
    while i + 1 < b.len() {
        out.push((nib(b[i]) << 4) | nib(b[i + 1]));
        i += 2;
    }
    out
}

fn hex(b: List<u8>) -> str {
    let digits = "0123456789abcdef";
    let s = "";
    for x in b { s = s + digits[(x >> 4) as usize:(x >> 4) as usize + 1] + digits[(x & 15u8) as usize:(x & 15u8) as usize + 1]; }
    s
}

fn hash(s: str) -> HashAlgorithm {
    if s == "sha256" { return HashAlgorithm::Sha256; }
    if s == "sha384" { return HashAlgorithm::Sha384; }
    HashAlgorithm::Sha512
}

const K2048: str = "";
const K2049: str = "";

fn pkcs1() -> List<str> {
    [
        "rsa2048 sha256 ",
        "rsa2048 sha384 ",
        "rsa2048 sha512 ",
        "rsa2049 sha256 ",
        "rsa2049 sha384 ",
        "rsa2049 sha512 ",
    ]
}

fn pss() -> List<str> {
    [
        "0 ",
        "20 ",
        "64 ",
        "222 ",
    ]
}

fn main() {
    let msg = "rok pkcs1 message";
    for v in pkcs1() {
        let f: List<str> = [];
        for x in v.split(" ") { f.push(x); }
        let key = try! PrivateKey::from_pkcs1_der(unhex(if f[0] == "rsa2048" { K2048 } else { K2049 }));
        let h = hash(f[1]);
        let sig = try key.sign_pkcs1v15(h, msg) catch e { println(f"FAIL {e.message()}"); [] };
        let pk = key.public_key();
        println(f"{f[0]} {f[1]}: matches {sig == unhex(f[2])}, verifies {pk.verify_pkcs1v15(h, msg, sig)}, other message {pk.verify_pkcs1v15(h, "other", sig)}, as pss {pk.verify_pss(h, msg, sig)}");
    }
    let pk = (try! PrivateKey::from_pkcs1_der(unhex(K2048))).public_key();
    let h = HashAlgorithm::Sha256;
    for v in pss() {
        let f: List<str> = [];
        for x in v.split(" ") { f.push(x); }
        let s = try! f[0].parse::<usize>();
        let sig = unhex(f[1]);
        println(f"pss salt {s}: with {s} {pk.verify_pss(h, msg, sig, s)}, with hash length {pk.verify_pss(h, msg, sig, 32)}");
    }
    let key = try! PrivateKey::from_pkcs1_der(unhex(K2048));
    let own = try! key.sign_pss(h, msg, unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"));
    println(f"pss default salt: hash length {pk.verify_pss(h, msg, own)}");
    let again = try! PublicKey::new(pk.modulus(), pk.exponent());
    println(f"modulus round trip {again.modulus() == pk.modulus() && again.verify_pss(h, msg, own)}, exponent {hex(pk.exponent())}");
}

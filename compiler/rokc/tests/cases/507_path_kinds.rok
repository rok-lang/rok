// expect-exit: 0
// expect-stdout:
// 5 23
// 1 2 3 4
// 7 9 8 2
// 9 true

// A path starts at `pkg`, `sup`, `rok` or a visible name; its
// last segment names a function, type, const, static, module, static
// method or associated const, in expression and type position alike.
// The nearest declaration wins over the implicit core import.
mod geom {
    pub mod shapes {
        pub struct Circle { pub r: i32; }
        impl Circle {
            pub const UNIT: i32 = 1;
            pub fn origin() -> Circle { Circle { r: 0 } }
        }
    }
    pub const DEFAULT: i32 = 3;
    pub static LIMIT: i32 = 4;
    pub fn distance(a: i32, b: i32) -> i32 { b - a }

    pub mod inner {
        use sup::{distance, DEFAULT as D};
        pub fn two() -> i32 { distance(1, 3) }
        pub fn three() -> i32 { D }
        pub fn up() -> i32 { sup::sup::top() }
    }
}

pub(sub) fn top() -> i32 { 9 }

// A non-generic `channel` here hides the generic one of `rok::core`.
fn channel(a: i32, b: i32) -> i32 { a * 10 + b }

use pkg::geom::shapes::Circle;

fn make() -> pkg::geom::shapes::Circle { Circle { r: 7 } }

let f = pkg::geom::distance;
let c: geom::shapes::Circle = pkg::geom::shapes::Circle::origin();
println(f"{f(1, 6)} {channel(2, 3)}");
println(f"{geom::shapes::Circle::UNIT} {geom::inner::two()} {geom::inner::three()} {geom::LIMIT}");
let (tx, rx) = rok::core::channel::channel::<i32>();
try! tx.send(8);
let s = rx.recv() ?? 0;
println(f"{make().r} {geom::inner::up()} {s} {c.r + 2}");
let shapes_mod_r = geom::shapes::Circle { r: 9 }.r;
println(f"{shapes_mod_r} {rok::core::cmp::Ordering::Less is Ordering}");

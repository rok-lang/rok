// expect-exit: 0
// expect-stdout:
// ok rsa2048 sha256: bits 2048, signature matches, verifies true, other message false
// ok rsa3072 sha384: bits 3072, signature matches, verifies true, other message false
// ok rsa2049 sha256: bits 2049, signature matches, verifies true, other message false
// ok rsa2048 sha512: bits 2048, signature matches, verifies true, other message false
// rejected: short salt true, damaged key true, malformed true

// RSA PSS signing against a reference; the 2049-bit key's leading zero byte.

use rok::core::crypto::HashAlgorithm;
use rok::core::crypto::rsa::PrivateKey;

fn nib(c: u8) -> u8 {
    if c >= 0x30u8 && c <= 0x39u8 { return c - 0x30u8; }
    if c >= 0x61u8 && c <= 0x66u8 { return c - 0x61u8 + 10u8; }
    c - 0x41u8 + 10u8
}

fn unhex(s: str) -> List<u8> {
    let out: List<u8> = [];
    let b = s.as_bytes();
    let i = 0usize;
    while i + 1 < b.len() {
        out.push((nib(b[i]) << 4) | nib(b[i + 1]));
        i += 2;
    }
    out
}

fn vectors() -> List<str> {
    [
        "rsa2048 sha256  030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc ",
        "rsa3072 sha384  030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c ",
        "rsa2049 sha256  030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc ",
        "rsa2048 sha512  030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bc ",
    ]
}

fn hash(s: str) -> HashAlgorithm {
    if s == "sha256" { return HashAlgorithm::Sha256; }
    if s == "sha384" { return HashAlgorithm::Sha384; }
    HashAlgorithm::Sha512
}

fn main() {
    let first: List<u8> = [];
    for v in vectors() {
        let f: List<str> = [];
        for x in v.split(" ") { f.push(x); }
        let h = hash(f[1]);
        let der = unhex(f[2]);
        if first.len() == 0 { first = der; }
        let key = try! PrivateKey::from_pkcs1_der(der);
        let msg = f"rok pss {f[0]}";
        let sig = try key.sign_pss(h, msg, unhex(f[3])) catch e { println(f"FAIL {f[0]}: {e.message()}"); [] };
        let pk = key.public_key();
        println(f"ok {f[0]} {f[1]}: bits {key.bits()}, signature {if sig == unhex(f[4]) { "matches" } else { "differs" }}, verifies {pk.verify_pss(h, msg, sig)}, other message {pk.verify_pss(h, "other", sig)}");
    }

    let key = try! PrivateKey::from_pkcs1_der(first);
    let short = (try key.sign_pss(HashAlgorithm::Sha256, "m", unhex("00")) catch _ { [] }).len() == 0;
    // Flip a bit of q^-1 mod p (the last field): the fault check fails.
    let damaged = first.clone();
    damaged[damaged.len() - 1] = damaged[damaged.len() - 1] ^ 1u8;
    let dk = try! PrivateKey::from_pkcs1_der(damaged);
    let salt: List<u8> = [];
    for _ in 0..32 { salt.push(7u8); }
    let fault = (try dk.sign_pss(HashAlgorithm::Sha256, "m", salt) catch _ { [] }).len() == 0;
    let cut = first[0:first.len() - 1].to_list();
    let malformed = try PrivateKey::from_pkcs1_der(cut).bits() == 0 catch _ { true };
    println(f"rejected: short salt {short}, damaged key {fault}, malformed {malformed}");
}


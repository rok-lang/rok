// expect-exit: 0
// expect-stdout:
// 7 8

// `impl<F: Future> IntoFuture for F` - a generic `I: IntoFuture`
// accepts a plain future, and `into_future` returns it.
async fn seven() -> i32 { 7 }

async fn run<I: IntoFuture<Output = i32>>(x: I) -> i32 {
    await x.into_future()
}

async fn main() {
    let a = await run(seven());
    let b = await run(async { 8 });
    println(f"{a} {b}");
}

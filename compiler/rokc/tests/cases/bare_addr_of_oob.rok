// `addr_of(a[i])` checks `i` like a read of `a[i]`.
use rok::bare::ptr::addr_of;

fn main() -> i32 {
    let a: [i64; 3] = [1, 2, 3];
    let i = a.len();
    let p = addr_of(a[i]);
    p.addr() as i32
}

// needs: threads
// expect-exit: 0
// expect-stdout:
// 2
// got 1

// remove(i) then send, keep using the others.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let c = thread::spawn(|| { let n: usize = 0; while let r: List<i32> = rx.recv() { n += r.len(); } n });
    let q: List<List<i32>> = [[1], [2], [3]];
    try! tx.send(q.remove(1));
    q[1].push(4);
    println(f"{q[1].len()}");
    tx.close();
    println(f"got {try! c.join()}");
}

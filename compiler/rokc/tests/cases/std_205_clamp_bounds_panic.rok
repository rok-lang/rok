// `Ord::clamp` with `low > high` is a caller bug and panics, as float
// clamp does.
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/std_205_clamp_bounds_panic.rok:11:13:
// expect-stderr: Ord::clamp: low > high; pass the bounds in order, `x.clamp(low, high)`
// expect-stdout: 5

fn main() {
    println(f"{7i32.clamp(1, 5)}");
    let x: i32 = 3;
    let y = x.clamp(9, 2);
    println(f"{y}");
}

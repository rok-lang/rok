// expect-exit: 0
// gc-stress: 50
// expect-stdout:
// spawned
// slow woke on time
// fast woke on time
// mid woke on time
// all done after the last deadline: true

// Spawned tasks run concurrently and no sleep wakes before its deadline.
// The deadlines are absolute (fixed before spawning) and the workers
// don't print: when each task is first polled, and in which order tasks
// woken together print, is up to OS scheduling.
async fn worker(name: str, at: Instant) -> str {
    await task::sleep_until(at);
    if Instant::now() >= at { f"{name} woke on time" } else { f"{name} woke EARLY" }
}

async fn main() {
    let t0 = Instant::now();
    let a = task::spawn(worker("slow", t0 + Duration::ms(30)));
    let b = task::spawn(worker("fast", t0 + Duration::ms(10)));
    let c = task::spawn(worker("mid", t0 + Duration::ms(20)));
    println("spawned");
    await task::yield_now();
    let xs = await task::join([a, b, c]);
    for x in xs { println(x); }
    println(f"all done after the last deadline: {t0.elapsed().as_ms() >= 30}");
}


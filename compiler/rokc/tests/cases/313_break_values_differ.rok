// expect-error: `break` values have different types

// A loop's `break` values share one type. Differing types are an
// error unless the slot is annotated (`let v: i32 | bool = loop ...`),
// as for `if` / `match` arms - no sum type is inferred.
fn main() -> i32 {
    let n = 3;
    let v = loop {
        if n > 2 { break 1; }
        break true;
    };
    return 0;
}

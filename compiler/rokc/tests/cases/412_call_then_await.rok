// expect-exit: 0
// expect-stdout:
// other 5
// sum 30

// An async call returns a future at once; it is awaited when
// the result is needed. Each `await` binds the result and the
// body goes on.
async fn op(x: i32) -> i32 {
    await task::yield_now();
    x * 10
}

async fn both() -> i32 {
    let a = await op(1);
    let b = await op(2);
    a + b
}

async fn main() {
    let f = both();
    let other = 2 + 3;
    println(f"other {other}");
    println(f"sum {await f}");
}

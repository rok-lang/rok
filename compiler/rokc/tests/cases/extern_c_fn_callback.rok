// needs: process
// expect-exit: 0
// expect-stdout:
// 4

// `extern "C" fn`: a rok function with the C ABI, passed
// to C as a plain function pointer. `raise` runs the handler at once on
// this thread.
extern "C" {
    fn signal(sig: i32, handler: fn(i32)) -> usize;
    fn raise(sig: i32) -> i32;
}

static TOTAL: Atomic<i64> = Atomic::new(0);

extern "C" fn show_twice(sig: i32) {
    TOTAL.fetch_add((sig * 2) as i64);
}

fn main() -> i32 {
    unsafe { signal(2, show_twice) };
    unsafe { raise(2) };
    println(f"{TOTAL.load()}");
    return 0;
}


// needs: net threads
// expect-exit: 0
// expect-stdout:
// addr 127.0.0.1:0 [::1]:8080 10.1.2.3 2001:db8::1
// blocking echo: hello over tcp
// peer is local: true
// async echo: 3 clients ok
// async read_to_end: 100000 bytes
// incoming: ping
// resolve localhost: true
// refused: true

// std::net (302): a TCP echo server and its clients in one program,
// with the blocking API (an OS thread serves) and the async one (tasks
// on the pool suspend in accept / read / write).
use rok::std::net::{TcpListener, TcpStream, SocketAddr, Ipv4Addr, Ipv6Addr, Shutdown};
use rok::std::net;
use rok::std::io::{IoError, Reader, Writer, byte_buf};
use rok::std::thread;

fn text(buf: List<u8>, n: usize) -> str {
    return try! str::from_utf8(buf[0:n]);
}

let any: SocketAddr = try! "127.0.0.1:0".parse::<SocketAddr>();
let v6: SocketAddr = try! "[::1]:8080".parse::<SocketAddr>();
let ip: Ipv4Addr = try! "10.1.2.3".parse::<Ipv4Addr>();
let ip6: Ipv6Addr = try! "2001:db8:0:0:0:0:0:1".parse::<Ipv6Addr>();
println(f"addr {any} {v6} {ip} {ip6}");

// Blocking: a thread echoes one connection.
let listener = try! TcpListener::bind(any);
let addr = try! listener.local_addr();
let server = thread::spawn(|| {
    let (conn, peer) = try! listener.accept();
    let buf = byte_buf(64);
    loop {
        let n = try! conn.read(buf);
        if n == 0 { break; }
        let part: List<u8> = List::new();
        let i: usize = 0;
        while i < n { part.push(buf[i]); i = i + 1; }
        try! conn.write_all(part);
    }
    conn.close();
    peer.port() as i32
});
let c = try! TcpStream::connect(addr);
try! c.write_str("hello over tcp");
try! c.shutdown(Shutdown::Write);
let back = try! c.read_to_end();
println(f"blocking echo: {text(back, back.len())}");
let peer_port = try! server.join();
println(f"peer is local: {(try! c.local_addr()).port() as i32 == peer_port}");
c.close();
listener.close();

// Async: the server task accepts, a task per connection echoes.
let l2 = try! TcpListener::bind(any);
let a2 = try! l2.local_addr();
let srv = task::spawn(async {
    let served = 0;
    while served < 4 {
        let (conn, peer) = try! await l2.accept_async();
        task::spawn(async {
            let buf = byte_buf(4096);
            loop {
                let n = try! await conn.read_async(buf);
                if n == 0 { break; }
                let part: List<u8> = List::new();
                let i: usize = 0;
                while i < n { part.push(buf[i]); i = i + 1; }
                try! await conn.write_all_async(part);
            }
            conn.close();
            0
        });
        served = served + 1;
    }
    served
});
let clients: List<Task<bool>> = [];
let k = 0;
while k < 3 {
    let me = k;
    clients.push(task::spawn(async {
        let s = try! await TcpStream::connect_async(a2);
        let msg = f"client {me}";
        try! await s.write_str_async(msg);
        let buf = byte_buf(64);
        let n = try! await s.read_async(buf);
        s.close();
        text(buf, n) == msg
    }));
    k = k + 1;
}
let oks = 0;
for ok in await task::join(clients) { if ok { oks = oks + 1; } }
println(f"async echo: {oks} clients ok");

// A large payload: write and read concurrently (the socket buffers fill).
let big = task::spawn(async {
    let s = try! await net::tcp_connect_async(a2);
    // The writer task owns its buffer: a list cannot be shared with it.
    let w = task::spawn(async {
        let data = byte_buf(100000);
        try! await s.write_all_async(data);
        try! s.shutdown(Shutdown::Write);
        0
    });
    let got = try! await s.read_to_end_async();
    await w;
    got.len()
});
println(f"async read_to_end: {await big} bytes");
await srv;
l2.close();

// `incoming()` over a blocking listener.
let l3 = try! net::tcp_listen("127.0.0.1:0");
let a3 = try! l3.local_addr();
let t3 = thread::spawn(|| {
    let c = try! net::tcp_connect(f"{a3}");
    try! c.write_str("ping");
    c.close();
    0
});
for r in l3.incoming() {
    let s = try! r.get();
    let all = try! s.read_to_end();
    println(f"incoming: {text(all, all.len())}");
    s.close();
    break;
}
try! t3.join();
l3.close();

let found = (try! net::resolve("localhost:80"))[0];
println(f"resolve localhost: {found.port() == 80u16}");

// Nobody listens on the closed listener's port any more.
let refused = false;
try TcpStream::connect(a3) catch e: IoError { refused = true; };
println(f"refused: {refused}");
// spec: std 302-net §3.2.1

// expect-exit: 0
// expect-stdout: 4 8 true 23 false

// A registered token that starts like a fixed one lexes by longest
// match: `<-` over `<`, `**` over `*`. Where the fixed token is longer
// (`<=`), the fixed one wins.
struct C { v: i32; }

trait Push {
    #[infix("<-", like = "+")]
    fn push_in(self, o: i32) -> i32;
}

trait Pow {
    #[infix("**", like = "*")]
    fn pow_of(self, e: i32) -> i32;
}

impl Push for C { fn push_in(self, o: i32) -> i32 { self.v + o } }
impl Pow for C { fn pow_of(self, e: i32) -> i32 { self.v * e * e } }

fn main() -> i32 {
    let c = C { v: 1 };
    let d = C { v: 2 };
    let a = 1;
    // `a < -1` needs the space when the file registers `<-`.
    println(f"{c <- 3} {d ** 2} {a <= 1} {(c <- 2) * 10 - 7} {a < -1}");
    return 0;
}

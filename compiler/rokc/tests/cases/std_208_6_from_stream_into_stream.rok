// expect-exit: 0
// expect-stdout:
// [1, 2, 3]
// [10, 20]
// 2

// `FromStream::from_stream` takes any `IntoStream` (a stream is its own),
// so a type that only converts into a stream collects too.

use rok::core::stream::{Stream, IntoStream, FromStream, AsyncStream};
use rok::core::task;

async yield fn upto(n: i32) -> i32 {
    let i = 1;
    while i <= n {
        yield i;
        i += 1;
    }
}

struct Tens { n: i32; }

impl IntoStream for Tens {
    type Item = i32;
    type IntoStream = AsyncStream<i32>;
    fn into_stream(self) -> AsyncStream<i32> {
        let n = self.n;
        async yield {
            let i = 1;
            while i <= n {
                yield i * 10;
                i += 1;
            }
        }
    }
}

fn main() -> i32 {
    task::block_on(async {
        let a: List<i32> = await List::<i32>::from_stream(upto(3));
        let b: List<i32> = await List::<i32>::from_stream(Tens { n: 2 });
        let s: Set<i32> = await upto(2).collect();
        println(f"{a:?}");
        println(f"{b:?}");
        println(f"{s.len()}");
    });
    return 0;
}

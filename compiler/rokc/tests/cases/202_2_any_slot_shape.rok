// only-pointer-width: 64
// expect-exit: 0
// expect-stdout:
// any 16
// niches 1 8 8

// An `any` slot is a tag and a payload (here two words).
// `bool | none` is one byte and `Ptr<T> | none` one pointer
// (null is `none`); `i32 | none` gets no niche.
use rok::bare::mem::size_of;
use rok::bare::ptr::Ptr;

fn main() {
    println(f"any {size_of::<any>()}");
    println(f"niches {size_of::<bool | none>()} {size_of::<Ptr<i32> | none>()} {size_of::<i32 | none>()}");
}

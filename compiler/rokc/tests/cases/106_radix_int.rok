// expect-exit: 0
// expect-stdout:
// 31
// 5
// 15
// 1000000

// Radix prefixes `0x`, `0b`, `0o` and `_` separators.
fn main() -> i32 {
    let h = 0x1F;
    let b = 0b101;
    let o = 0o17;
    let big = 1_000_000;
    println(f"{h}");
    println(f"{b}");
    println(f"{o}");
    println(f"{big}");
    return 0;
}


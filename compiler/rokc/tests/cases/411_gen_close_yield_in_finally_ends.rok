// spec: 004.11-generators §4.11.10
// expect-exit: 0
// expect-stdout:
// got 0
// cleanup start
// outer cleanup
// after: 0
// drained: 0 1 99 100

// 4.11.10: a `yield` reached while a generator is being closed ends it:
// the cleanups around that `yield` still run, the yielded value goes
// nowhere and nothing after it runs. A generator left normally yields
// from its `finally` as usual.
yield fn tail() -> i64 {
    try {
        try {
            yield 0;
            yield 1;
        } finally {
            println("cleanup start");
            yield 99;
            println("not reached");
        }
    } finally {
        println("outer cleanup");
        yield 100;
    }
}

yield fn quiet() -> i64 {
    try {
        yield 0;
        yield 1;
    } finally {
        yield 99;
    }
    yield 100;
}

fn main() {
    let seen: i64 = -1;
    for x in tail() {
        println(f"got {x}");
        seen = x;
        break;
    }
    println(f"after: {seen}");
    let all = "drained:";
    for x in quiet() {
        all = f"{all} {x}";
    }
    println(all);
}

// needs: threads
// expect-error: error[E0134]: `f` was spawned as a task at line 18: it may own values moved into it (`[move ..]`), so it can be handed over only once
// expect-error: help: the task owns the closure and what it moved in
// expect-error: 406_11_move_owner_once_must_fail.rok:26:27: `g` was spawned as a task at line 25
// expect-error: 406_11_move_owner_once_must_fail.rok:34:27: `j.run` was spawned as a task at line 33
// expect-error: 406_11_move_owner_once_must_fail.rok:40:34: `h` was spawned as a task at line 39
// expect-error: 406_11_move_owner_once_must_fail.rok:47:18: `k` was spawned as a task by `via(k)` at line 47

// A closure that owns values moved into it is handed over once, however
// it travels: a variable, a `fn` parameter, a struct field.
use rok::std::thread;

struct Job { run: fn() -> usize + Send; }

fn main() {
    let xs: List<i32> = [1, 2];
    let f = [move xs] || xs.len();
    let a = thread::spawn(f);
    let b = thread::spawn(f);
    println(f"{try! a.join()} {try! b.join()} {twice(|| 0)}");
}

// A `+ Send` fn value may own moved values: it moves on hand-off.
fn twice(g: fn() -> usize + Send) -> usize {
    let a = thread::spawn(g);
    let b = thread::spawn(g);
    let ys: List<i32> = [3];
    let j = Job { run: [move ys] || ys.len() };
    (try! a.join()) + (try! b.join()) + field(j)
}

fn field(j: Job) -> usize {
    let a = thread::spawn(j.run);
    let b = thread::spawn(j.run);
    (try! a.join()) + (try! b.join()) + spawn_it(|| 1)
}

fn spawn_it(h: fn() -> usize + Send) -> usize {
    let t = task::spawn_blocking(h);
    let u = task::spawn_blocking(h);
    task::block_on(t) + task::block_on(u)
}


// Through a parameter that hands it over.
fn pass_on(k: fn() -> usize + Send) -> usize {
    via(k) + via(k)
}

fn via(h: fn() -> usize + Send) -> usize {
    try! thread::spawn(h).join()
}

// spec: refs-lang 003.01-operator-dispatch §3.1.1
// expect-exit: 31
// expect-stdout:
// 10 21


struct Vec2 {
    x: i32;
    y: i32;
}

impl ops::Add for Vec2 {
    fn add(self, rhs: Vec2) -> Vec2 {
        return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

impl ops::Sub for Vec2 {
    fn sub(self, rhs: Vec2) -> Vec2 {
        return Vec2 { x: self.x - rhs.x, y: self.y - rhs.y };
    }
}

fn main() -> i32 {
    let a: Vec2 = Vec2 { x: 1i32, y: 2i32 };
    let b: Vec2 = Vec2 { x: 10i32, y: 20i32 };
    let c: Vec2 = a + b - Vec2 { x: 1i32, y: 1i32 };
    println(f"{c.x} {c.y}");
    return c.x + c.y;
}

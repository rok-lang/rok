// spec: std 213-marker §2.13.9
// expect-error: does not satisfy trait bound `Send`

// Send is structural: a tuple holding a type that opted out is not Send.
struct Cellish { v: i32; }
impl !Send for Cellish {}
fn spawn_with<T: Send>(x: T) -> i32 { return 0; }
fn main() -> i32 { return spawn_with((1, Cellish { v: 2 })); }

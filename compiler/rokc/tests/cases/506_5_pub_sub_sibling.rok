// expect-error: 9:25: function `parent::shared` is `pub(sub)`: visible only in module `parent` and its descendants, not from `sibling`

// `pub(sub)` reaches the defining module and its
// descendants only, not a sibling.
mod parent {
    pub(sub) fn shared() -> i32 { 1 }
}
mod sibling {
    pub fn f() -> i32 { pkg::parent::shared() }
}
println(f"{sibling::f()}");

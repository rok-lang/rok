// only-os: macos linux
// expect-exit: 0
// expect-stdout:
// hello
// hello
// hello

// The UCRT's stdout is in text mode: `puts` writes CRLF on Windows.
extern "C" {
    fn puts(s: str) -> i32;
}

fn say(msg: str, times: i32 = 1) {
    let i = 0;
    while i < times {
        let _ = unsafe { puts(msg) };
        i += 1;
    }
}

fn main() {
    say("hello", 3);
}

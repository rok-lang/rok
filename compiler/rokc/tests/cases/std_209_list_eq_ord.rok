// expect-exit: 0
// expect-stdout:
// true false
// true true false
// clone independent: [1, 2] [1, 2, 3]
// [0, 1, 2, 3, 4]

// Trait table: `PartialEq` element-wise, `Ord` lexicographic,
// `Clone` is a deep copy, `FromIterator` (`(0..5).collect::<List<i32>>()`).
fn main() {
    let a: List<i32> = [1, 2, 3];
    let b: List<i32> = [1, 2, 3];
    let c: List<i32> = [1, 2];
    println(f"{a == b} {a == c}");
    println(f"{c < a} {[1, 2, 3] < [1, 3]} {a < b}");
    let d = c.clone();
    d.push(3);
    println(f"clone independent: {c:?} {d:?}");
    println(f"{(0..5).collect::<List<i32>>():?}");
}

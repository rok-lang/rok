// only-pointer-width: 64
// expect-exit: 0
// expect-stdout:
// 4 1 2 4 8 8 8 8 4 8 4 8 8
// 42 true false 42 NonZero(42)
// 252 48 36 7 14 false true Greater true
// caught zero is not a valid `NonZero` value
// 42 5 5 5 9
// true 1.5 3 true true Greater NonNan(1.5)
// true true 0 2 Finite(2)
// true false 0
// 3,9,
// zero one
// -4 -0 1.5

// Stdlib 2.2: `NonZero<T>` / `NonNan<F>` / `Finite<F>` / `Positive<T>`
// - sizes of `W | none`, construction, `get`, the arithmetic table,
// comparison / hashing, `TryFrom` (`ZeroError`), `From` back, and the
// wrappers as `Dict` keys / sorted.

use rok::bare::mem::size_of;

fn main() {
    println(f"{size_of::<num::niche::NonZero<i32> | none>()} {size_of::<num::niche::NonZero<u8> | none>()} {size_of::<num::niche::NonZero<i16> | none>()} {size_of::<num::niche::NonZero<u32> | none>()} {size_of::<num::niche::NonZero<i64> | none>()} {size_of::<num::niche::NonZero<usize> | none>()} {size_of::<num::niche::NonNan<f64> | none>()} {size_of::<num::niche::Finite<f64> | none>()} {size_of::<num::niche::NonNan<f32> | none>()} {size_of::<f32 | none>()} {size_of::<num::niche::Positive<i32> | none>()} {size_of::<num::niche::Positive<u32> | none>()} {size_of::<i32 | none>()}");
    let n: num::niche::NonZero<i32> = num::niche::NonZero::new(42) ?? panic("zero");
    let z: num::niche::NonZero<i32> | none = num::niche::NonZero::new(0);
    let m: num::niche::NonZero<i32> | none = num::niche::NonZero::new(7);
    println(f"{n.get()} {z is none} {m is none} {n} {n:?}");
    let b: num::niche::NonZero<i32> = num::niche::NonZero::new(6) ?? panic("zero");
    println(f"{n * b} {n + b} {n - b} {n / b} {84 / b} {n == b} {n > b} {n.cmp(b):?} {n.hash() == 42.hash()}");
    let e = try num::niche::NonZero::<i32>::try_from(0) catch err: num::niche::ZeroError { println(f"caught {err}"); n };
    let t: num::niche::NonZero<i32> = try 5.try_into() catch _ { n };
    let v: i32 = t.into();
    let u = unsafe { num::niche::NonZero::new_unchecked(9 as u8) };
    println(f"{e} {t} {v} {i32::from(t)} {u}");
    let nn: num::niche::NonNan<f64> | none = num::niche::NonNan::new(0.0 / 0.0);
    let one = num::niche::NonNan::new(1.5) ?? panic("nan");
    let mz = num::niche::NonNan::new(-0.0) ?? panic("nan");
    let pz = num::niche::NonNan::new(0.0) ?? panic("nan");
    println(f"{nn is none} {one} {one + one} {mz == pz} {mz.hash() == pz.hash()} {one.cmp(pz):?} {one:?}");
    let inf: num::niche::Finite<f64> | none = num::niche::Finite::new(1.0 / 0.0);
    let big = num::niche::Finite::new(1.0e308) ?? panic("inf");
    let two = num::niche::Finite::new(2.0) ?? big;
    println(f"{inf is none} {(big + big).is_err()} {(big - big).unwrap()} {two} {two:?}");
    let p: num::niche::Positive<i32> | none = num::niche::Positive::new(-3);
    let q: num::niche::Positive<i32> | none = num::niche::Positive::new(0);
    println(f"{p is none} {q is none} {(q ?? num::niche::Positive::new(5) ?? panic("neg")).get()}");
    let xs: List<num::niche::NonZero<u64> | none> = List::new();
    xs.push(num::niche::NonZero::new(3 as u64));
    xs.push(none);
    for x in xs {
        let w = x ?? num::niche::NonZero::new(9 as u64) ?? panic("zero");
        print(f"{w},");
    }
    println("");
    let d: Dict<num::niche::NonNan<f64>, str> = Dict::new();
    d[one] = "one";
    d[pz] = "zero";
    println(f"{d[mz]} {d[one]}");
    let ys: List<num::niche::NonNan<f64>> = [one, mz, num::niche::NonNan::new(-4.0) ?? one];
    ys.sort();
    println(f"{ys[0]} {ys[1]} {ys[2]}");
}

// spec: std 202-non-zero

// spec: refs-lang §2.7.6
// spec: std §2.2.1-2.2.6

// expect-exit: 0
// expect-stdout:
// 6
// -1
// 1

// Untyped `throws` = `throws (any Error)`; a cause chain
// through `Error::source`.
struct NotFound { id: i32; }
impl Display for NotFound { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("not found") } }
impl Debug for NotFound { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("NotFound") } }
impl Error for NotFound {}

struct Wrapped { code: i32; cause: any Error | none; }
impl Display for Wrapped { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("wrapped") } }
impl Debug for Wrapped { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Wrapped") } }
impl Error for Wrapped {
    fn source(self) -> any Error | none { return self.cause; }
}

fn find(id: i32) throws -> i32 {
    if id > 10 { throw NotFound { id: id }; }
    return id * 2;
}

fn load(id: i32) throws -> i32 {
    let v = try find(id) catch e { throw Wrapped { code: 7, cause: e }; };
    return v;
}

println(f"{try find(3) catch _ { -1 }}");
println(f"{try find(30) catch _ { -1 }}");
let r = try load(40) catch e: any Error {
    match e.source() {
        c: any Error => 1,
        none => 2,
    }
};
println(f"{r}");


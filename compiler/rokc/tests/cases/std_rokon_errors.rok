// What ROKON leaves out, and typed-decoding errors,
// each with its `line:col`.

use rok::std::rokon;
use rok::std::rokon::{Value, RokonError, FromRokon};

#[derive(Rokon)]
enum Mode { Fast, Slow }

#[derive(Rokon)]
#[rokon(deny_unknown_fields)]
enum Shape {
    Circle(f64),
    Rect { w: i32; h: i32; },
}

#[derive(Rokon)]
struct Server { host: str; port: u16; }

#[derive(Rokon)]
#[rokon(deny_unknown_fields)]
struct Config {
    name: str;
    mode: Mode;
    servers: List<Server>;
    limits: Dict<str, i32>;
    shape: Shape | none;
}

fn read(s: str) {
    let _ = try rokon::parse(s) catch e { println(f"parse: {e}"); return; };
    println("parse: ok");
}

fn decode(s: str) {
    let _ = try rokon::from_str::<Config>(s) catch e {
        println(f"decode: {e} [{e.path()}]");
        return;
    };
    println("decode: ok");
}

fn main() {
    read("foo");
    read("[1, nan]");
    read("1 + 2");
    read("-x");
    read("--1");
    read("[1, 2].len()");
    read("p.x");
    read("[0..3]");
    read("Point { ..base }");
    read("{ let x = 1; x }");
    read("{ 1, 2 }");
    read("f\"{x}\"");
    read("5i32");
    read("1.5f64");
    read("[1, 2] [3]");
    read("[1 2]");
    read("\"open");
    read("'ab'");
    read("\"bad \\q escape\"");
    read("0x");
    read("1__0");
    read("1e");
    read("/* open");
    read("{ \"a\": 1, \"a\": 2 }");
    read("P { x: 1, x: 2 }");
    read("E::V(a: 1, 2)");
    read("[\n  1,\n  $\n]");
    read("");
    read("[1e999]");
    read("-1e999");

    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: {}, extra: 1 }");
    decode("Config { name: \"x\", servers: [], limits: {} }");
    decode("Other { name: \"x\" }");
    decode("Config {\n    name: 7,\n}");
    decode("Config {\n    name: \"x\",\n    mode: Mode::Medium,\n    servers: [],\n    limits: {},\n}");
    decode("Config {\n    name: \"x\",\n    mode: Kind::Fast,\n}");
    decode("Config {\n    name: \"x\",\n    mode: Mode::Fast,\n    servers: [\n        Server { host: \"a\", port: 80 },\n        Server { host: \"b\", port: 70000 },\n    ],\n    limits: {},\n}");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [Server { host: \"a\" }], limits: {} }");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: { \"cpu\": \"two\" } }");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: { 1: 2 } }");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: {}, shape: Shape::Circle(1, 2) }");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: {}, shape: Shape::Rect(1, h: \"t\") }");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: {}, shape: Shape::Rect { w: 1, d: 2 } }");
    decode("Config { name: \"x\", mode: Mode::Fast(1), servers: [], limits: {} }");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: [] }");
    decode("Config { name: \"x\", mode: Mode::Fast, servers: [], limits: {}, shape: Shape::Circle(1.5) }");

    // Without a document there is no position, only the path.
    let v = Value::List([Value::Int(1), Value::Str("x")]);
    let _ = try List::<i32>::from_rokon(v) catch e { println(f"value: {e}"); return; };
}


// expect-exit: 0
// expect-stdout:
// race fast
// timeout ok 7
// timeout TimeoutError

// `race` yields the first finished task's result;
// `timeout` returns the value when the task beats the deadline and
// throws `TimeoutError` (via `try await`) when it doesn't. The margins
// are seconds wide so scheduling noise can't flip the result.
async fn after(ms: i64, name: str) -> str {
    await task::sleep(Duration::ms(ms));
    name
}

async fn main() {
    let first = await task::race([
        task::spawn(after(5000, "slow")),
        task::spawn(after(1, "fast")),
    ]);
    println(f"race {first}");

    let v = try await task::timeout(Duration::secs(5), task::spawn(async { 7 })) catch e: task::TimeoutError { -1 };
    println(f"timeout ok {v}");

    let w = try await task::timeout(Duration::ms(5), task::spawn(after(5000, "late"))) catch e: task::TimeoutError { f"{e:?}" };
    println(f"timeout {w}");
}

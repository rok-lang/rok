// expect-exit: 0
// expect-stdout:
// 1003 6004 1.510516 1004
// [] 0
// ["a!", "bb!"] [2, 4]
// [5, 1, -3] [9, 33]
// [0, 2, 8, 18]
// [2.0, 3.0] [2.0, 3.0]

// A fused list result is allocated at its final length and filled by
// index; every element is written once, in order, whatever its type.
fn bang(s: str) -> str { s + "!" }

fn twice(n: i64) -> i64 { n * 2 }

fn main() {
    let n = 1003usize;
    let a: List<f64> = List::from_fn(n, |i| i as f64);
    let x: List<f64> = List::from_fn(n, |i| (i % 7) as f64);
    let b: List<f64> = List::from_fn(n, |i| 1.0 + (i % 3) as f64);
    let r = a .* x .+ b .* 2.0;
    let sum = 0.0;
    for i in 0..n {
        if r[i] != a[i] * x[i] + b[i] * 2.0 {
            println(f"bad {i}");
        }
        sum += r[i];
    }
    println(f"{r.len()} {r[1000]} {sum / 1000000.0} {r[n - 1]}");
    let e: List<i64> = [];
    let er = e .* 3 .+ e;
    println(f"{er:?} {er.len()}");
    let ss: List<str> = ["a", "bb"];
    let ls: List<i64> = [1, 2];
    println(f"{bang.(ss):?} {twice.(ls):?}");
    let l: List<i64> = [1, 2, 3, 4, 5, 6];
    let fx: [i64; 3] = [4, -2, -8];
    let ev = l[::2];
    println(f"{ev .+ fx:?} {l[1::3] .* l[1::3] .+ [5, 8]:?}");
    let sq: List<i64> = List::from_fn(4, |i| i as i64);
    println(f"{sq .* sq .* 2:?}");
    let out: List<f64> = [0.0, 0.0];
    out .= [1.0, 2.0] .+ 1.0;
    println(f"{out:?} {[1.0, 2.0] .+ 1.0:?}");
}

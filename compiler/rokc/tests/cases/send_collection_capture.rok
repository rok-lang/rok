// expect-error: mismatched types: argument 1 of `thread::spawn` expects `fn() -> usize + Send`
// expect-error: the closure's captures don't meet the `fn` type's bounds

// Collections are `!Sync` handles, so a `+ Send` closure cannot capture one.
use rok::std::thread;

fn main() {
    let xs: List<i32> = [1, 2, 3];
    let h = thread::spawn(|| { xs.push(4); xs.len() });
    xs.push(5);
    println(f"{try! h.join()}");
}

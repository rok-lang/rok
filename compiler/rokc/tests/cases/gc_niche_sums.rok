// expect-exit: 0
// gc-stress: 400
// expect-stdout:
// recs ok
// dict ok
// enums ok

// Niche sums with GC references: `none` is all zero, fields survive moves.
extern "C" {
    fn rok_gc_collect();
}

struct Rec { name: str; id: num::niche::NonZero<u32>; tags: List<str>; }

enum Slot { Name(str), Num(i64) }

fn junk(i: i64) -> i64 {
    let n: i64 = 0;
    for k in 0..10 {
        let s = f"garbage-{i}-{k}-xxxxxxxxxxxxxxxx";
        n += s.len() as i64;
    }
    n
}

fn rec(i: u32) -> Rec | none {
    if i % 3 == 0 { return none; }
    let id = num::niche::NonZero::new(i) ?? panic("zero");
    Rec { name: f"rec-{i}", id, tags: [f"t{i}", f"u{i}"] }
}

fn main() {
    let recs: List<Rec | none> = [];
    let dict: Dict<num::niche::NonZero<u32>, Rec | none> = Dict::new();
    let slots: List<Slot | none> = [];
    let i: u32 = 1;
    while i <= 600 {
        recs.push(rec(i));
        dict[num::niche::NonZero::new(i) ?? panic("zero")] = rec(i);
        slots.push(if i % 2 == 0 { Slot::Name(f"s{i}") } else if i % 5 == 0 { none } else { Slot::Num(i as i64) });
        junk(i as i64);
        if i % 100 == 0 { unsafe { rok_gc_collect(); } }
        i += 1;
    }
    unsafe { rok_gc_collect(); }
    let ok = true;
    for (k, r) in recs.iter().enumerate() {
        let i = (k + 1) as u32;
        ok = ok && match r {
            none => i % 3 == 0,
            x: Rec => x.name == f"rec-{i}" && x.id.get() == i && x.tags[1] == f"u{i}",
        };
    }
    println(if ok { "recs ok" } else { "recs BAD" });
    let dok = true;
    let j: u32 = 1;
    while j <= 600 {
        let r = dict[num::niche::NonZero::new(j) ?? panic("zero")];
        dok = dok && match r { none => j % 3 == 0, x: Rec => x.tags[0] == f"t{j}" };
        j += 1;
    }
    println(if dok { "dict ok" } else { "dict BAD" });
    let eok = true;
    for (k, s) in slots.iter().enumerate() {
        let i = k + 1;
        eok = eok && match s {
            none => i % 2 != 0 && i % 5 == 0,
            v: Slot => match v { Slot::Name(n) => n == f"s{i}", Slot::Num(n) => n == i as i64 },
        };
    }
    println(if eok { "enums ok" } else { "enums BAD" });
}

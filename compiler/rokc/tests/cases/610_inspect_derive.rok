// spec: 006.10-inspect
// expect-exit: 0
// expect-stdout:
// ["host", "port"]
// i32
// true
// 9090
// false

// 6.10.2: `#[derive(Inspect)]` - field names, dynamic get / set via `any`.
#[derive(Inspect)]
struct Config { host: str; port: i32; }

let c = Config { host: "localhost", port: 8080 };
println(f"{Config::field_names():?}");
match c.get_field("port") {
    v: any => println(v.type_name_of_val()),
    none => println("none"),
}
println(f"{c.set_field("port", 9090)}");
println(f"{c.port}");
println(f"{c.set_field("xxx", 1)}");
// spec: §6.10.2

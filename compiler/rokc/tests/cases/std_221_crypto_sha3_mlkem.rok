// expect-exit: 0
// expect-stdout:
// ok sha3-256 empty
// ok sha3-256 abc
// ok sha3-512 empty
// ok sha3-512 abc
// ok shake128 abc
// ok shake256 empty
// ok keygen 0 ek
// ok keygen 1 ek
// ok keygen 2 ek
// ok keygen 3 ek
// ok keygen 4 ek
// ok encaps 0 K
// ok encaps 0 c
// ok encaps 1 K
// ok encaps 1 c
// ok round trip
// ok flipped bit rejected
// ok ek modulus check
// ok ciphertext length check

// rok::core::crypto: SHA-3 / SHAKE (FIPS 202) and ML-KEM-768 (FIPS 203, ACVP
// keyGen / encapsulation vectors, implicit rejection, input checks).
use rok::core::crypto::sha3::{Sha3_256, Sha3_512, Shake128, Shake256};
use rok::core::crypto::mlkem::{DecapsulationKey768, EncapsulationKey768};
use rok::core::crypto::{Secret, constant_time_eq};

fn hex(b: List<u8>) -> str {
    let s = "";
    for x in b { s += f"{x:02x}"; }
    s
}

fn nib(c: u8) -> u8 {
    if c >= 0x30u8 && c <= 0x39u8 { return c - 0x30u8; }
    c - 0x61u8 + 10u8
}

fn unhex(s: str) -> List<u8> {
    let out: List<u8> = [];
    let b = s.as_bytes();
    let i = 0usize;
    while i + 1 < b.len() {
        out.push((nib(b[i]) << 4) | nib(b[i + 1]));
        i += 2;
    }
    out
}

fn none_secret() -> Secret { Secret::zeroed(0) }

fn check(name: str, got: List<u8>, want: str) {
    let g = hex(got);
    if g == want { println(f"ok {name}"); } else { println(f"FAIL {name}: {g} != {want}"); }
}

fn flag(name: str, cond: bool) {
    if cond { println(f"ok {name}"); } else { println(f"FAIL {name}"); }
}

fn main() {
    check("sha3-256 empty", Sha3_256::digest(""), "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a");
    check("sha3-256 abc", Sha3_256::digest("abc"), "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532");
    check("sha3-512 empty", Sha3_512::digest(""), "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26");
    check("sha3-512 abc", Sha3_512::digest("abc"), "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0");
    // 200 bytes: two squeezes across the 168-byte rate.
    let s1 = Shake128::new();
    s1.update("abc");
    let o1 = s1.squeeze(100);
    for x in s1.squeeze(100) { o1.push(x); }
    check("shake128 abc", o1, "");
    let s2 = Shake256::new();
    check("shake256 empty", s2.squeeze(64), "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be");

    // ACVP ML-KEM-keyGen-FIPS203, ML-KEM-768: d, z, SHA3-256(ek).
    let kg: List<(str, str, str)> = [
        ("e582b7d75e6c80b05ae392a1fc9f7153b12390fd99930368cc67a768baebc8a0", "1cdacb8740c0b87c4a379575f187b367cbfa3b300bf591b109f79816e9cbe8f0",
            "81e66ef5a7a221619f6a64039cc369843e10df5c859f6959cc3fd8e5272330fd"),
        ("3e5848db624613f7ac144457cc1375f006fa8cb953e767dc9e7428d00f5dad8b", "012dd6c2f0918b9eb6182474eb86d848f65974759d59ce151a396deee4ca10d1",
            "423290e0ccb74da11b95294fef12ec690815ff103075053b89c5021aeff4ca0c"),
        ("882fdea55c6b497a6f2a1321fc82160c630d9a1f2e35bbe0d3332e3a0cfbc8c9", "3a21f601923c559179a3aa5839a148487379eaad934bf27f3071e1b1fdc21d1a",
            "5f13ee3fd74b1366afa7f3fff4b8f645331db5526fdd7998a4eeb5c27c884db8"),
        ("aee013310d04215b77f073a7e22b77bf0221394a08e96bd07e3c99a9af45f16b", "7dcb9d6a2c3832e5fe9261e29172375a78cbecda0ef5484c4b3f6940ea20edd9",
            "6e2b36020e42c91f7be2fcdfdbc37b117984406f46374188d1a2264445d3f44d"),
        ("b5dcc09f5402f5da7695e1d61b4c1ce11380347d4c6bef40ba11e94e755b1afc", "ab6eae982dda0008cf1bdc59b5c8ac88ba11f169798aa56374ed7a550bc4f552",
            "2210baee60864394042f2e190edac61e3c72ac42214318c84151d6e12d56cab2"),
    ];
    // ACVP encapsulation, ML-KEM-768: dk (holds ek), m, K, SHA3-256(c).
    let enc: List<(str, str, str, str)> = [
        ("",
            "4e77596168711e913965d8175ac3bd76aab08b7f9385a02ae883cf6c6e17dd81", "79d74f6c6c2d916bec47bd828fd9b67295a37f54927fab1263c0d122f1c6f1ed", "684da17d93e27520cb78ae6169c020d73ef770e6fa89589cc7d653a76a8b1751"),
        ("",
            "c465031f7464614109c7ddb28ab216181db5002ae54eaf6c5d6a6eefc4f72b9e", "3d58d95a3556fc5f5784b5b537f4a99c3d83cb0c9d80b1e4fa96f8d1ab08554e", "fac643f5c1cfbb70f7ab7bb2bfd1d7af4443116c7f1e941a9dd81faf42fd64a7"),
    ];
    for (i, t) in kg.iter().enumerate() {
        let (d, z, hek) = t;
        let dk = try! DecapsulationKey768::from_seed(unhex(d), unhex(z));
        check(f"keygen {i} ek", Sha3_256::digest(dk.encapsulation_key().to_bytes()), hek);
    }
    for (i, t) in enc.iter().enumerate() {
        let (dkh, m, k, hc) = t;
        let ek = try! EncapsulationKey768::from_bytes(unhex(dkh)[1152:2336]);
        let (key, c) = try ek.encapsulate(unhex(m)) catch _ { (none_secret(), []) };
        check(f"encaps {i} K", key.as_bytes().to_list(), k);
        check(f"encaps {i} c", Sha3_256::digest(c), hc);
    }

    // Round trip, a flipped ciphertext bit, and the input checks.
    let seed: List<u8> = [];
    for i in 0..32 { seed.push(i as u8); }
    let dk = try! DecapsulationKey768::from_seed(seed, seed);
    let ek = dk.encapsulation_key();
    let (k1, c) = try ek.encapsulate(seed) catch _ { (none_secret(), []) };
    let k2 = try dk.decapsulate(c) catch _ { none_secret() };
    flag("round trip", k1.len() == 32 && constant_time_eq(k1, k2));
    c[5] = c[5] ^ 1u8;
    let k3 = try dk.decapsulate(c) catch _ { none_secret() };
    flag("flipped bit rejected", k3.len() == 32 && !constant_time_eq(k3, k1));
    let bad = ek.to_bytes();
    bad[0] = 0xffu8;
    bad[1] = bad[1] | 0x0fu8;
    let r1: EncapsulationKey768 | none = try EncapsulationKey768::from_bytes(bad) catch _ { none };
    flag("ek modulus check", r1 is none);
    let r3 = try dk.decapsulate(c[0:1087]) catch _ { Secret::new([9u8]) };
    flag("ciphertext length check", r3.len() == 1);
}

// spec: std 221-crypto §2.21.1
// spec: std 221-crypto §2.21.3

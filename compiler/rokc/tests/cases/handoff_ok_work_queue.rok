// needs: threads
// expect-exit: 0
// expect-stdout:
// done 8 left 0

// Work queue: jobs popped off a list and sent to workers; results back.
use rok::core::marker::share;
use rok::std::thread;
struct Job { id: i32; data: List<i32>; }
fn main() {
    let jobs: List<Job> = [];
    for i in 0..8 { jobs.push(Job { id: i, data: [i, i * 2] }); }
    let (tx, rx) = channel::<Job>();
    let (rt_own, rr) = channel::<i32>();
    let rt = unsafe { share(rt_own) };
    let workers: List<thread::JoinHandle<i32>> = [];
    for _ in 0..2 {
        workers.push(thread::spawn(|| {
            let n = 0;
            while let j: Job = rx.recv() { j.data.push(1); try! rt.send(j.id); n += 1; }
            n
        }));
    }
    while let j: Job = jobs.pop() { try! tx.send(j); }
    tx.close();
    let done = 0;
    for _ in 0..8 { if let _id: i32 = rr.recv() { done += 1; } }
    println(f"done {done} left {jobs.len()}");
    for w in workers { let _ = try! w.join(); }
}

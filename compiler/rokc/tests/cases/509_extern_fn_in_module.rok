// expect-exit: 0
// expect-stdout:
// 4 4 5

// A `pub` function of an `extern` block in a module is reachable by its
// path; inside the module and elsewhere its bare name still works (one
// global name space of extern functions).
mod m {
    extern "C" {
        pub fn abs(x: i32) -> i32;
    }
    pub fn via() -> i32 { unsafe { abs(-5) } }
}

println(f"{unsafe { m::abs(-4) }} {unsafe { abs(-4) }} {m::via()}");

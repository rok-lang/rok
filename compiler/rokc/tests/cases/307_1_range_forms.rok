// spec: §3.7.1 §3.7.2 §3.7.3 §3.7.7
// expect-exit: 0
// expect-stdout:
// 10 11 45 55
// 5 6 [1, 2, 3]
// 0 0 0 0
// 4 7 2 3
// 5 6

// spec 3.7.1 / 3.7.2: the six forms are distinct values of distinct
// library types. 3.7.3: `+` and `??` bind tighter than `..`; in call
// arguments `..x` spreads, so a `RangeTo` argument is parenthesized while
// `..=x` stays a range. 3.7.7: a start past the end iterates zero times.
fn width(r: range::RangeTo<i32>) -> i32 { r.end }
fn width_inc(r: range::RangeToInclusive<i32>) -> i32 { r.end + 1 }
fn sum3(a: i32, b: i32, c: i32) -> i32 { a + b + c }

fn main() {
    let a: Range<i32> = 0..10;
    let b: RangeInclusive<i32> = 0..=10;
    let c: range::RangeFrom<i32> = 10..;
    let d: range::RangeTo<i32> = ..10;
    let e: range::RangeToInclusive<i32> = ..=10;
    let f: range::RangeFull = ..;
    println(f"{a.count()} {b.count()} {a.sum()} {b.sum()}");
    let xs = [1, 2, 3, 4, 5, 6];
    println(f"{width(d) - width((..5))} {width_inc(..=5)} {xs[..][..3]:?}");
    if c.start != 10 || e.end != 10 { println("bad"); }

    let n = 3;
    let empty = (5..3).count() + (5..=3).count();
    let none_v: i32 | none = none;
    let some_v: i32 | none = 2;
    let iters = 0;
    for _ in 5..3 { iters += 1; }
    println(f"{empty} {iters} {(n..n).count()} {(4..=3).count()}");
    let r1 = 0..n + 1;
    let r2 = none_v ?? 0..3;
    let r3 = some_v ?? 0..9;
    let r4 = 1..n;
    println(f"{r1.count()} {r3.count()} {r4.count()} {r2.count()}");
    let parts = [1, 2, 3];
    println(f"{sum3(..parts) - 1} {r1.end + 2}");
}

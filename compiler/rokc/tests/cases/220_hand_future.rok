// expect-exit: 0
// expect-stdout:
// polls 3 value 99
// ready true pending true

// `await` polls a user `Future` until `Ready`; on
// `Pending` the future wakes itself through `ctx.waker()` and is polled
// again.
struct Countdown { left: i32; polls: List<i32>; }

impl Future for Countdown {
    type Output = i32;
    fn poll(ref self, ref ctx: future::Context) -> future::Poll<i32> {
        self.polls.push(self.left);
        if self.left == 0 { return future::Poll::Ready(99); }
        self.left = self.left - 1;
        ctx.waker().wake();
        future::Poll::Pending
    }
}

async fn main() {
    let polls: List<i32> = [];
    let c = Countdown { left: 2, polls: polls };
    let v = await c;
    println(f"polls {polls.len()} value {v}");
    let r: future::Poll<i32> = future::Poll::Ready(1);
    let p: future::Poll<i32> = future::Poll::Pending;
    println(f"ready {r.is_ready()} pending {p.is_pending()}");
}

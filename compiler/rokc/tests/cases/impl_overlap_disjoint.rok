// expect-exit: 0
// expect-stdout: 1 2 3 4 5

// Impls whose targets cannot unify, given the impls that exist, are disjoint.
trait Num {}
impl Num for i32 {}
trait Tag { fn tag(self) -> i32; }
struct Box<T> { v: T; }
struct Pair<A, B> { a: A; b: B; }

impl<T: Num> Tag for T { fn tag(self) -> i32 { return 1; } }
impl<U> Tag for Box<U> { fn tag(self) -> i32 { return 2; } }
impl<U: Num> Tag for Pair<U, i32> { fn tag(self) -> i32 { return 3; } }
impl<U> Tag for Pair<str, U> { fn tag(self) -> i32 { return 4; } }
impl<U> Tag for (U, bool) { fn tag(self) -> i32 { return 5; } }

fn main() -> i32 {
    let p = Pair { a: 1, b: 2 };
    let q = Pair { a: "s", b: 2 };
    print(f"{(7).tag()} {Box { v: 1 }.tag()} {p.tag()} {q.tag()} {(1, true).tag()}");
    return 0;
}


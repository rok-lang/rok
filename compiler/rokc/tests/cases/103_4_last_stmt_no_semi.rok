// spec: §1.3.4 §3.4.3
// expect-exit: 0
// expect-stdout:
// fn 3 3
// loops 3 4 6 2
// if 1 2 | match 10 20
// closure 2 5
// ops 11 9 20 5 2 3 4 6 7 16 4
// places 7 3 12 4 8
// let 1 2 3 4 5
// exits 2 5 1 9
// caught 7

// spec 1.3.4: the last statement before `}` may omit its `;`; leaving it
// out is the same as writing it. Every block kind and statement form.
struct P { x: i32; y: i32; }
struct Pair(i32, i32);

#[derive(Debug)]
struct Oops { v: i32; }
impl Error for Oops {}
impl Display for Oops {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("oops") }
}

fn set(ref n: i32) { n = 3 }
fn bump(ref n: i32) { n += 3 }
fn unused() { let _z = 1 }
fn early(x: i32) -> i32 {
    if x > 0 { return x }
    9
}
fn bare(ref n: i32) {
    n = 2;
    return
}
fn fail(v: i32) throws -> i32 {
    if v > 0 { throw Oops { v: v } }
    v
}

fn main() -> i32 {
    // Function bodies.
    let a = 0;
    set(ref a);
    let b = 0;
    bump(ref b);
    unused();
    println(f"fn {a} {b}");

    // Loop bodies.
    let i = 0;
    while i < 3 { i += 1 }
    let j = 0;
    loop {
        j += 1;
        if j == 4 { break }
    }
    let s = 0;
    for k in 1..4 { s += k }
    let c = 0;
    for k in 0..4 {
        if k % 2 == 0 { continue }
        c += 1
    }
    println(f"loops {i} {j} {s} {c}");

    // if / else and match arm blocks.
    let x = 0;
    let y = 0;
    if i == 3 { x = 1 } else { x = 5 }
    if i == 0 { y = 9 } else { y = 2 }
    let m = 0;
    let n = 0;
    match i {
        3 => { m = 10 },
        _ => { m = 0 },
    }
    match j {
        4 => { n += 20 }
        _ => {}
    }
    println(f"if {x} {y} | match {m} {n}");

    // Closure bodies.
    let count = 0;
    let inc = [ref count] || { count += 1 };
    inc();
    inc();
    let total = 0;
    let put = [ref total] |v: i32| { total = v };
    put(5);
    println(f"closure {count} {total}");

    // Every compound operator.
    let o1 = 10;
    { o1 += 1 }
    let o2 = 10;
    { o2 -= 1 }
    let o3 = 10;
    { o3 *= 2 }
    let o4 = 10;
    { o4 /= 2 }
    let o5 = 11;
    { o5 %= 3 }
    let o6 = -7;
    { o6 %%= 5 }
    let o7 = 12;
    { o7 &= 6 }
    let o8 = 4;
    { o8 |= 2 }
    let o9 = 5;
    { o9 ^= 2 }
    let o10 = 1;
    { o10 <<= 4 }
    let o11 = 16;
    { o11 >>= 2 }
    println(f"ops {o1} {o2} {o3} {o4} {o5} {o6} {o7} {o8} {o9} {o10} {o11}");

    // Field, tuple field and index targets; an index evaluated once.
    let p = P { x: 1, y: 2 };
    if true { p.x = 7 }
    if true { p.y += 1 }
    let q = Pair(10, 4);
    if true { q.0 += 2 }
    let arr: [i32; 3] = [1, 2, 3];
    if true { arr[0] = 4 }
    let at = 0;
    let idx = [ref at] || { at += 1; 2 };
    if true { arr[idx()] += 5 }
    println(f"places {p.x} {p.y} {q.0} {arr[0]} {arr[2] + at - 1}");

    // `let` of every form as the last statement.
    let l1 = 0;
    if true { let t = 1; l1 = t }
    { let _u = 1 }
    { let _v: i32 = 2 }
    { let (_d, _e) = (3, 4) }
    { let P { x: _x, y: _y } = p }
    let opt: i32 | none = 5;
    { let _w: i32 = opt else { return 1 } }
    { let (_f, (_g, _h)) = (1, (2, 3)) }
    { let _whole @ (_k1, _k2) = (1, 2) }
    if true { let _r = 1 } else { let _r = 2 }
    while false { let _r = 1 }
    loop { let _r = 1; break }
    for _ in 0..1 { let _r = 1 }
    match l1 { _ => { let _r = 1 } }
    let cl = || { let _r = 1 };
    cl();
    println(f"let {l1} 2 3 4 5");

    // return / break / continue / throw.
    let r = 0;
    bare(ref r);
    let lv = loop { break 5 };
    let lb = 'out: { if true { break 'out 1 } 0 };
    println(f"exits {r} {lv} {lb} {early(0)}");
    let caught = try fail(7) catch e: Oops { e.v } catch _ { 0 };
    println(f"caught {caught}");
    return 0
}

// expect-exit: 0
// expect-stdout:
// 5

// An or-pattern binding the same name with the same type in
// each alternative (`Ok(x) | OkAlt(x)`) is allowed.
enum E {
    A(i32),
    B(i32),
}

fn main() -> i32 {
    let e = E::A(5);
    let n = match e {
        E::A(x) | E::B(x) => x,
    };
    println(f"{n}");
    return 0;
}

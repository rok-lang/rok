// expect-error: 7:13: a byte string holds ASCII only; write other bytes as `\xHH`
// expect-error: 8:13: a byte string escape must be at most `\xFF`
// expect-error: 9:13: unknown escape sequence `\q`

// Only ASCII is written directly; escapes stop at `\xFF`.
fn main() {
    let a = b"café";
    let b = b"\u{100}";
    let c = b"\q";
}

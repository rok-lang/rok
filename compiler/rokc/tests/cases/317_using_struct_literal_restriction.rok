// expect-error: 14:15: a struct literal can't start a block's head: its `{` would open the body
// expect-error: help: wrap the struct literal in parentheses: `(R { n: 2 })`

// `using` takes the same top-level struct-literal restriction as `if` /
// `while` / `match` / `for`: `{` after the initializer opens the body,
// so a struct literal there needs parentheses.
struct R { n: i32; }
impl Drop for R {
    fn drop(ref self) {}
}

fn main() {
    using a = (R { n: 1 }) {}
    using b = R { n: 2 } {}
}

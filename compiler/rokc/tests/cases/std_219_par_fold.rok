// needs: threads
// expect-exit: 0
// forbid-warning: warning
// expect-stdout:
// 16 6 none [0, 2, 4, 6] 10 [2]

// `par::fold` folds an `init` in once; `par::reduce` takes none, as
// `Iterator::reduce`, and is `none` for no items. `filter`, `fold` and
// `reduce` take any `IntoIterator`, as `map` does.
fn main() {
    let a = par::fold([1, 2, 3], 10, |x: i32, y: i32| x + y);
    let b = par::reduce([1, 2, 3], |x: i32, y: i32| x + y) ?? -1;
    let none_left: List<i32> = [];
    let c = par::reduce(none_left, |x: i32, y: i32| x + y);
    let evens = par::filter(0..8, |x: i32| x % 2 == 0);
    let r = par::fold(0..5, 0, |x: i32, y: i32| x + y);
    let s = par::filter([1, 2, 3].iter(), |x: i32| x == 2);
    let empty = if c is none { "none" } else { "some" };
    println(f"{a} {b} {empty} {evens:?} {r} {s:?}");
}

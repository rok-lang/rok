// `int` past the subquadratic cut-offs; Python-computed results.

fn make(seed: u64, limbs: usize) -> int {
    let x: int = 0;
    let s = seed;
    for _ in 0..limbs {
        s = s.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        let v = if s % 7u64 == 0u64 { 0xFFFF_FFFFu64 } else if s % 11u64 == 0u64 { 0u64 } else { s >> 32u64 };
        x = (x << 32u32) + int::from(v);
    }
    x
}

fn hstr(t: str) -> u64 {
    let b = t.as_bytes();
    let h = 0u64;
    for i in 0..b.len() { h = h.wrapping_mul(31u64).wrapping_add(b[i] as u64); }
    h
}

fn divisor(kind: usize, n: usize) -> int {
    let one: int = 1;
    if kind == 0 { return (make((n * 7) as u64, n)) | (one << ((32 * n - 1) as u32)); }
    if kind == 1 { return (one << ((32 * n) as u32)) - one; }
    if kind == 2 { return one << ((32 * n - 1) as u32); }
    (one << ((32 * n - 1) as u32)) + one
}

fn main() {
    let md: int = 2305843009213693951;
    let one: int = 1;
    for (n, qn) in [(3000usize, 3000usize), (3001usize, 7000usize), (6000usize, 3100usize), (4096usize, 4097usize)] {
        for kind in 0usize..4usize {
            let b = divisor(kind, n);
            let a = make((n + qn + kind) as u64, qn) * b + (b - one);
            let (q, r) = a.div_rem(b);
            let c = make((n * 3 + kind) as u64, n + qn);
            let (q2, r2) = c.div_rem(b);
            let ok = q * b + r == a && r == b - one && q2 * b + r2 == c && !r2.is_negative() && r2 < b;
            println(f"d {n} {qn} {kind} {ok} {q %% md} {q2 %% md} {r2 %% md}");
        }
    }
    let ten: int = 10;
    for n in [4000usize, 30000usize] {
        let xs = [make(n as u64, n), ten.pow((n * 9) as u32) - one, ten.pow((n * 9) as u32)];
        for xi in 0..3 {
            let t = f"{xs[xi]}";
            let back = try! t.parse::<int>();
            let s = xs[xi].isqrt();
            let sq = s * s <= xs[xi] && (s + one) * (s + one) > xs[xi];
            println(f"s {n} {xi} {back == xs[xi]} {t.len()} {hstr(t)} {sq} {s %% md}");
        }
    }
    for (n, m, gl) in [(2400usize, 2400usize, 1usize), (2600usize, 2500usize, 1300usize), (9000usize, 6000usize, 500usize)] {
        let g = make((n * 5 + gl) as u64, gl);
        let a = make((n * 11) as u64, n - gl) * g;
        let b = make((m * 13 + 1) as u64, m - gl) * g;
        let d = a.gcd(b);
        println(f"g {n} {m} {gl} {d %% md} {d.bit_length()}");
    }
    let f0: int = 0;
    let f1: int = 1;
    for _ in 0..120000 {
        let t = f0 + f1;
        f0 = f1;
        f1 = t;
    }
    println(f"fib {f1.gcd(f0)} {(f1 * int::from(12345)).gcd(f0 * int::from(12345))} {f1.bit_length()}");
}

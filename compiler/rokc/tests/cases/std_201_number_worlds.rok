// expect-exit: 0
// expect-stdout:
// i32 f64 i64 2147483648
// i8 i16 u8 u16 u32 u64 isize usize f32 bool c_char char str int float

// An unsuffixed literal is `i32` / `f64` without an
// expected type and follows one when there is; `int` promotes past the
// `i32` range instead of overflowing. The primitive names and the
// `int` / `float` keywords.
fn main() {
    let n = 0;
    let f = 3.14;
    let w: i64 = 0;
    let big: int = 2147483647;
    big = big + 1;
    println(f"{n.type_name_of_val()} {f.type_name_of_val()} {w.type_name_of_val()} {big}");
    let a: i8 = 1; let b: i16 = 1; let c: u8 = 1; let d: u16 = 1;
    let e: u32 = 1; let g: u64 = 1; let h: isize = 1; let i: usize = 1;
    let j: f32 = 1.0; let k: bool = true; let l: c_char = c'a'; let m: char = 'a';
    let s: str = "s"; let fl: float = 1.5;
    println(f"{a.type_name_of_val()} {b.type_name_of_val()} {c.type_name_of_val()} {d.type_name_of_val()} {e.type_name_of_val()} {g.type_name_of_val()} {h.type_name_of_val()} {i.type_name_of_val()} {j.type_name_of_val()} {k.type_name_of_val()} {l.type_name_of_val()} {m.type_name_of_val()} {s.type_name_of_val()} {big.type_name_of_val()} {fl.type_name_of_val()}");
}

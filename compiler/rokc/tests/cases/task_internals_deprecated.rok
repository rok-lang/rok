// spec: std 218-task §2.18.3 / refs-lang §6.2.7
// expect-exit: 0
// expect-warning: use of deprecated function `wake_task`
// expect-warning: call `wake()` on the task's `Waker`
// expect-warning: use of deprecated function `cancel_requested`
// expect-warning: use of deprecated function `unwinding`
// expect-lint: 19:12 use of deprecated type `Pool`
// expect-lint: 19:27 use of deprecated type `Worker`
// expect-lint: 19:44 use of deprecated type `TaskRef`
// expect-lint: 21:13 use of deprecated function `wake_task`
// expect-lint: 22:13 use of deprecated function `cancel_requested`
// expect-lint: 23:13 use of deprecated function `unwinding`
// expect-stdout:
// ok

// The executor's internals are public only for the compiler and the
// runtime: naming one warns, and 0.2.0 makes them private.
#[allow(unused)]
fn uses(p: task::Pool, w: task::Worker, t: task::TaskRef) {}
fn main() {
    let a = task::wake_task;
    let b = task::cancel_requested;
    let c = task::unwinding;
    let _ = (a, b, c);
    println("ok");
}

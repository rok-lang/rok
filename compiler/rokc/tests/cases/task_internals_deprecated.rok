// The executor's internals are public only for the compiler and the
// runtime: naming one warns, and 0.2.0 makes them private.
#[allow(unused)]
fn uses(p: task::Pool, w: task::Worker, t: task::TaskRef) {}
fn main() {
    let a = task::wake_task;
    let b = task::cancel_requested;
    let c = task::unwinding;
    let d = task::host_enter;
    let e = task::host_run;
    let _ = (a, b, c, d, e);
    println("ok");
}

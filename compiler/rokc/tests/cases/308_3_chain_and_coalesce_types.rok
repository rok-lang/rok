// expect-exit: 0
// expect-stdout:
// ada anonymous anonymous
// 4 4 9
// 2 3 2
// D D none
// 1 2

// Types and precedence of `?.` chains and `??`.
struct Profile { name: str; }
struct User { profile: Profile | none; }
struct C { d: str; }
struct B { c: C | none; }
struct A { b: B | none; }

fn user(n: i32) -> User | none {
    if n == 0 { return none; }
    if n == 1 { return User { profile: none }; }
    return User { profile: Profile { name: "ada" } };
}

fn pick(n: i32) -> i32 | none {
    if n > 0 { n } else { none }
}

fn deep(a: A | none) -> str {
    let x = a?.b?.c?.d ?? "none";
    let y = match a {
        av: A => match av.b {
            bv: B => match bv.c {
                cv: C => cv.d,
                none => "none",
            },
            none => "none",
        },
        none => "none",
    };
    if x != y { return "differ"; }
    return x;
}

fn main() {
    let names: List<str> = [];
    for n in [2, 1, 0] {
        let name: str | none = user(n)?.profile?.name;
        names.push(name ?? "anonymous");
    }
    println(f"{names[0]} {names[1]} {names[2]}");

    let a: i32 | none = none;
    let b: i32 | none = 4;
    let s: i32 = a ?? b ?? 0i32;
    let t: i32 | none = a ?? b;
    let u: i32 = pick(0) ?? pick(0) ?? 9;
    println(f"{s} {t ?? 0} {u}");

    println(f"{pick(2) ?? 0 + 3} {(pick(0) ?? 1) + 2} {(a ?? 0..2).count()}");

    let full = A { b: B { c: C { d: "D" } } };
    let cut = A { b: B { c: none } };
    println(f"{deep(full)} {deep(A { b: B { c: C { d: "D" } } })} {deep(cut)}");
    let one: i32 | none = 1;
    println(f"{one ?? 5} {pick(2) ?? 7}");
}

// needs: threads
// expect-error: `a` is passed twice to `race`, which hands one over and keeps using the other
// Two parameters that are one object at the call.
use rok::std::thread;

fn race(tx: Sender<List<i32>>, e: List<i32>, f: List<i32>) -> usize {
    try! tx.send(e);
    for i in 0..200000 { f.push(i); }
    f.len()
}

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| {
        if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } }
        0
    });
    let a: List<i32> = [];
    let n = race(tx, a, a);
    let _ = try! t.join();
    println(f"len {n}");
}

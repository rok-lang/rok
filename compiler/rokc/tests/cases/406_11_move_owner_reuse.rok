// needs: threads
// expect-exit: 0
// expect-stdout:
// local 1 2
// shared 6 6
// sync 1 2

// A closure that owns moved values is called locally as often as needed:
// a call does not move it. A closure whose captures are all `Send + Sync`
// moves nothing in, so it can be spawned again, as can a `fn` value whose
// type says `+ Send + Sync`.
use rok::std::thread;

fn main() {
    let xs: List<i32> = [];
    let push = [move xs] || { xs.push(1); xs.len() };
    let a = push();
    let b = push();
    println(f"local {a} {b}");

    let k: [i32; 3] = [1, 2, 3];
    let sum = || k[0] + k[1] + k[2];
    let t1 = thread::spawn(sum);
    let t2 = thread::spawn(sum);
    println(f"shared {try! t1.join()} {try! t2.join()}");

    println(f"sync {twice(|| 1)}");
}

fn twice(f: fn() -> i32 + Send + Sync) -> str {
    let t1 = task::spawn_blocking(f);
    let t2 = task::spawn_blocking(f);
    f"{task::block_on(t1) + task::block_on(t2) - 1} {f() + 1}"
}

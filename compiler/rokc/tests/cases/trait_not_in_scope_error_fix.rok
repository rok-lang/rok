// spec: 003.05-member-access-and-method-call
// expect-error: 28:9: method `wave` comes from trait `b::Wave`, which is not in scope
// expect-error: help: add `use pkg::b::Wave;`
// expect-error: 33:13: method `hi` comes from trait `a::Greet`, which is not in scope
// expect-error: help: add `use a::Greet;`

// A method resolves only from a trait in scope: defined in the module,
// `use`d there or in the block, a bound, or a `rok::` trait. Otherwise
// the error names the `use` to add.
mod a {
    pub trait Greet { fn hi(self) -> str; }
    impl Greet for i32 { fn hi(self) -> str { "a.hi" } }
}

mod b {
    pub trait Wave { fn wave(self) -> str; }
    impl Wave for i32 { fn wave(self) -> str { "b.wave" } }
}

fn bound<T: a::Greet>(x: T) -> str { x.hi() }

mod c {
    use pkg::a::Greet;
    pub fn greet() -> str { 2.hi() }
    pub fn qualified() -> str { pkg::b::Wave::wave(5) }
    pub fn wave() -> str {
        // Not in scope here: `c` uses only `Greet`.
        3.wave()
    }
}

fn main() {
    let s = 1.hi();
    let w = {
        use b::Wave;
        4.wave()
    };
    println(f"{s} {c::greet()} {c::qualified()} {c::wave()} {w} {bound(6)}");
}

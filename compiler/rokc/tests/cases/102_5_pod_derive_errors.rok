// expect-error: 8:1: `Loose` cannot be `Pod`: it needs `#[repr(C)]` or `#[repr(transparent)]`
// expect-error: 12:1: `Named` cannot be `Pod`: `name` has type `str`, which is not `Pod`
// expect-error: 16:1: `Held` cannot be `Pod`: it implements `Drop`

// `#[derive(Pod)]` needs a fixed layout, `Pod` fields and
// no `Drop`.
#[derive(Pod)]
struct Loose { a: u32; }

#[derive(Pod)]
#[repr(C)]
struct Named { id: u32; name: str; }

#[derive(Pod)]
#[repr(C)]
struct Held { fd: i32; }

impl Drop for Held {
    fn drop(ref self) {}
}

fn main() {}


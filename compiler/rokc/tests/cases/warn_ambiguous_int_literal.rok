// spec: 001.06-numeric-literals
// expect-exit: 0
// expect-lint: 17:15 integer literal `1` into `f32 | u16 | u8` becomes the `f32`: the sum has more than one integer member
// expect-lint: 18:29 integer literal `5` into `f32 | u16 | u8` becomes the `f32`: the sum has more than one integer member
// expect-warning: help: write `1u16` or `1u8`, or `1.0` for the `f32`
// expect-stdout: f32 f32 u16 u8 f32 i64

// An unsuffixed integer into a sum with several integer members and a
// float member becomes the float: a warning asks for a suffix.
fn f(x: u16 | u8 | f32) -> str {
    match x { _: u16 => "u16", _: u8 => "u8", _: f32 => "f32" }
}

fn g(x: i64 | f64) -> str { match x { _: i64 => "i64", _: f64 => "f64" } }

fn main() {
    let a = f(1);
    let v: u16 | u8 | f32 = 5;
    // A suffix, or a single integer member: no warning.
    println(f"{a} {f(v)} {f(1u16)} {f(1u8)} {f(1.0)} {g(1)}");
}

// expect-exit: 0
// expect-stdout:
// lr=0.01 momentum=0.9 epochs=10
// lr=0.2 momentum=0.5 epochs=3
// a=1 b=2 tag=x
// n=4 scale=0.5 name=run

// A defaulted parameter the dict's value type does not fit takes its
// default.
fn train(lr: f64, momentum: f64, epochs: i32 = 10) {
    println(f"lr={lr} momentum={momentum} epochs={epochs}");
}

fn pick<T: Display>(a: T, b: T, tag: str = "x") {
    println(f"a={a} b={b} tag={tag}");
}

fn job(n: i32 = 1, scale: f64 = 1.0, name: str = "run") {
    println(f"n={n} scale={scale} name={name}");
}

fn main() {
    let opts = {"lr": 0.01, "momentum": 0.9};
    train(..opts);
    train(..{"lr": 0.2, "momentum": 0.5}, epochs: 3);
    pick(..{"a": 1, "b": 2});
    let a = {"n": 4};
    let b = {"scale": 0.5};
    job(..a, ..b);
}

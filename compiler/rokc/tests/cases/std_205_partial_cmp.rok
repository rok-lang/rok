// expect-exit: 0
// expect-stdout:
// Less Equal Greater
// nan: true true
// str: Less
// user: Greater none

// `PartialOrd::partial_cmp` (provided) returns
// `Ordering | none`; `none` for incomparable values (NaN).
struct Half { v: f64; }

impl PartialEq for Half {
    fn eq(self, rhs: Half) -> bool { self.v == rhs.v }
}

impl PartialOrd for Half {
    fn lt(self, rhs: Half) -> bool { self.v < rhs.v }
    fn gt(self, rhs: Half) -> bool { self.v > rhs.v }
    fn le(self, rhs: Half) -> bool { self.v <= rhs.v }
    fn ge(self, rhs: Half) -> bool { self.v >= rhs.v }
}

fn show(o: Ordering | none) -> str {
    match o {
        x: Ordering => f"{x:?}",
        none => "none",
    }
}

fn main() {
    println(f"{show(1.partial_cmp(2))} {show(2.0.partial_cmp(2.0))} {show(3u8.partial_cmp(2u8))}");
    let nan = 0.0 / 0.0;
    println(f"nan: {nan.partial_cmp(1.0) is none} {1.0.partial_cmp(nan) is none}");
    println(f"str: {show("a".partial_cmp("b"))}");
    println(f"user: {show(Half { v: 2.0 }.partial_cmp(Half { v: 1.0 }))} {show(Half { v: nan }.partial_cmp(Half { v: 1.0 }))}");
}

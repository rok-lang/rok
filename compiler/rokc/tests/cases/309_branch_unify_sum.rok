// expect-exit: 0
// expect-stdout:
// from_int

// Differing branch types are not inferred as a sum type. With the sum type
// written on the slot, each branch value goes into it; omitting it is an
// error (`309_branch_types_differ`).
fn pick(b: i32) -> i32 | f64 {
    let v: i32 | f64 = if b == 1 { 7 } else { 3.14 };
    return v;
}

fn main() -> i32 {
    let r = pick(1);
    match r {
        n: i32 => println("from_int"),
        d: f64 => println("from_float"),
    };
    return 0;
}

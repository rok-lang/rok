// expect-exit: 0
// expect-lint: 25:20 `self.n` is set on a copy of the receiver, so the change is lost when `inc` returns
// expect-lint: 30:17 `p.x` is set on a copy of the argument, so the change is lost when `lost` returns
// expect-lint: 31:33 `p.x` is set on a copy of the argument, so the change is lost when `spin` returns
// expect-lint: 33:34 `p.y` is set on a copy of the argument, so the change is lost when `feeds` returns
// expect-lint: 60:15 `p.x` is set on a copy of the element, so `ps` does not change
// expect-lint: 69:1 `first.x` is set on a copy of `ps[1]`, so `ps[1]` does not change
// expect-stdout:
// 1 0
// 2 2
// 5
// 30 2
// 9
// 2 3
// 1 1

// `write_to_copy`: a field set on a copy that no read can
// follow. A write some later read, loop iteration, return or call sees
// is not one.

struct P { x: i32; y: i32; }
struct Counter { n: i32; }

impl Counter {
    fn inc(self) { self.n += 1; }
    fn with_n(self, n: i32) -> Counter { self.n = n; self }
    fn bump(ref self) { self.n += 1; }
}

fn lost(p: P) { p.x += 1; }
fn spin(p: P) { for i in 0..3 { p.x += i; } }
fn twice(p: P) -> i32 { p.x * 2 }
fn feeds(p: P) -> i32 { p.x = 1; p.y = twice(p); 0 }
fn kept(ref p: P) { p.x += 1; }
fn moved(p: P) -> P { p.x += 1; p }
fn shown(p: P) { p.x = 5; println(f"{p.x}"); }
fn branch(p: P, c: bool) -> i32 { if c { p.x = 1; } p.x }
fn again(p: P) -> i32 {
    let n = 0;
    while n < 4 {
        if p.x > 0 { n += 1; }
        p.x = 1;
        n += 1;
    }
    n
}

let c = Counter { n: 0 };
c.inc();
c.bump();
println(f"{c.n} {c.with_n(5).n - 5}");
let a = P { x: 1, y: 0 };
lost(a);
spin(a);
_ = feeds(a);
kept(ref a);
println(f"{moved(a).x - 1} {a.x}");
shown(a);
let ps = [P { x: 1, y: 0 }, P { x: 2, y: 0 }];
for p in ps { p.x *= 10; }
let total = 0;
for p in ps { p.x *= 10; total += p.x; }
println(f"{total} {ps[1].x}");
let q = ps[0];
q.x = 9;
ps[0] = q;
println(f"{ps[0].x}");
let first = ps[1];
first.x = 99;
println(f"{branch(a, true) + 1} {again(a) - 1}");
for i in 0..ps.len() { ps[i].x = i as i32 + 1; }
println(f"{ps[0].x} {ps[0].y + 1}");

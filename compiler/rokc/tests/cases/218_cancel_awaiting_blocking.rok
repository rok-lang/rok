// spec: std 2.18.4
// needs: threads
// expect-exit: 0
// expect-stdout:
// join: finished 7
// write landed: true

// `spawn_blocking` gives a `Task`, awaited as any other: a task cancelled
// while it waits on one that finishes before the task polls again takes
// the result, and with no cancellation point left it finishes with it.
use rok::std::thread;

let release = Atomic::new(0);
let started = Atomic::new(0);
let landed = Atomic::new(0);
let bl = task::spawn_blocking(|| {
    while release.load() == 0 {
        thread::sleep(Duration::ms(1));
    }
    landed.store(1);
    7
});
// Pinned to this worker: it cannot run again until this body awaits.
let t = task::spawn_local(async {
    started.store(1);
    await bl
});
while started.load() == 0 {
    await task::yield_now();
}
// Let it suspend in `await bl`.
await task::sleep(Duration::ms(5));
t.cancel();
release.store(1);
// Wait for the task itself: its closure's last write comes before the
// task is finished.
while !bl.is_finished() {
    thread::sleep(Duration::ms(1));
}
let r = try await t.join() catch _: task::CancellationError { -1 };
println(f"join: {if r == -1 { "cancelled" } else { f"finished {r}" }}");
println(f"write landed: {landed.load() == 1}");

// expect-error: overlap on `T` - bounds don't make impls disjoint

// One impl of a trait per type. Two blanket impls whose
// bounds a single type (`i32`: `A` and `B`) meets conflict, even if no
// call reaches them.
trait A { fn a(self) -> i32; }
trait B { fn b(self) -> i32; }
trait Show { fn show(self) -> i32; }

impl A for i32 { fn a(self) -> i32 { return 1; } }
impl B for i32 { fn b(self) -> i32 { return 2; } }
impl<T: A> Show for T { fn show(self) -> i32 { return self.a(); } }
impl<T: B> Show for T { fn show(self) -> i32 { return self.b(); } }

fn main() -> i32 { return 0; }

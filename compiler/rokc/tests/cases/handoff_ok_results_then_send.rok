// needs: threads
// expect-exit: 0
// expect-stdout:
// sent; total 30; rows 5

// Build a list of result rows, send the whole thing, keep a summary.
use rok::std::thread;
fn compute(i: i32) -> List<i32> { [i, i * i] }
fn main() {
    let (tx, rx) = channel::<List<List<i32>>>();
    let c = thread::spawn(|| { if let rows: List<List<i32>> = rx.recv() { rows.len() } else { 0 as usize } });
    let rows: List<List<i32>> = [];
    let total = 0;
    for i in 0..5 { let r = compute(i); total += r[1]; rows.push(r); }
    try! tx.send(rows);
    println(f"sent; total {total}; rows {try! c.join()}");
}

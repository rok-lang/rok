// expect-exit: 0
// expect-lint: 25:10 the `File` made here is never closed: nothing closes it after this call
// expect-lint: 29:13 `f` holds a `File` that is not closed on every path
// expect-lint: 42:13 `f` holds a `File` that is never closed
// expect-lint: 47:17 `f` holds a `File` that is not closed on every path
// expect-lint: 54:14 `_f` holds a `File` that is never closed
// expect-lint: 59:13 `f` holds a `File` that is never closed
// expect-lint: 67:25 `h.f` holds a `File` that is never closed
// expect-lint: 73:17 `f` holds a `File` that is never closed
// expect-lint: 135:13 `d` holds a `Dir` that is never closed
// expect-warning: it is still open if this throws
// expect-warning: it is still open when this replaces it
// spec: §6.2.9
// expect-stdout: ok

// `unclosed_resource` checks every path out of the function: each one
// closes the value, binds it with `using` or hands it on.

use rok::std::fs::{Dir, File};
use rok::std::io::IoError;

pub struct Holder { f: File }

pub fn temporary(p: str) -> str {
    try! (try! File::open(p)).read_to_str()
}

pub fn one_branch(p: str, c: bool) -> str {
    let f = try! File::open(p);
    let s = try! f.read_to_str();
    if c {
        try! f.close();
    }
    s
}

pub fn reads(f: File) -> str {
    try! f.read_to_str()
}

pub fn passed_to_reader(p: str) -> str {
    let f = try! File::open(p);
    reads(f)
}

pub fn throws_between(p: str) throws (IoError) -> str {
    let f = try File::open(p);
    let s = try f.read_to_str();
    try f.close();
    s
}

pub fn underscored(p: str) -> str {
    let _f = try! File::open(p);
    try! _f.read_to_str()
}

pub fn reassigned(p: str) -> str {
    let f = try! File::open(p);
    f = try! File::open(p);
    let s = try! f.read_to_str();
    try! f.close();
    s
}

pub fn stored(p: str) -> str {
    let h = Holder { f: try! File::open(p) };
    try! h.f.read_to_str()
}

pub fn looped(p: str) {
    for _ in 0..3 {
        let f = try! File::open(p);
        println(try! f.read_to_str());
    }
}

// Not flagged: closed or handed on on every path.

pub fn closes(p: str) -> str {
    let g = try! File::open(p);
    let s = try! g.read_to_str();
    try! g.close();
    s
}

pub fn scoped(p: str) throws (IoError) -> str {
    using h = try File::open(p) { try h.read_to_str() }
}

pub fn handed(p: str) -> File {
    try! File::open(p)
}

pub fn kept(p: str) -> Holder {
    let k = try! File::open(p);
    Holder { f: k }
}

pub fn closes_early(p: str, c: bool) {
    let f = try! File::open(p);
    if c {
        try! f.close();
        return;
    }
    println(try! f.read_to_str());
    try! f.close();
}

pub fn caught(p: str) -> str {
    let f = try! File::open(p);
    let s = try f.read_to_str() catch _ { "" };
    try! f.close();
    s
}

pub fn listed(dir: str) {
    for e in try! rok::std::fs::read_dir(dir) {
        println((try! e.get()).file_name());
    }
}

// `Dir::root()` holds no descriptor; what it opens does.
pub fn rooted(p: str) -> bool {
    let r = Dir::root();
    try! r.create_dir_all(p);
    try! Dir::root().remove_dir_all(p);
    let d = try! r.open_dir(p);
    let ok = d.exists(".");
    try! d.close();
    ok
}

pub fn rooted_open(p: str) -> bool {
    let d = try! Dir::root().open_dir(p);
    d.exists(".")
}

// A secret's bytes are wiped by the collection that frees it: `wipe`
// is early, not required.
pub fn secret_kept() -> usize {
    let s = rok::core::crypto::Secret::new(b"key");
    s.len()
}

pub fn secret_wiped() -> usize {
    let s = rok::core::crypto::Secret::new(b"key");
    let n = s.len();
    s.wipe();
    n
}

fn main() {
    println("ok");
}

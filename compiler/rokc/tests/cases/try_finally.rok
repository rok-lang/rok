// expect-exit: 11
// expect-stdout:
// 4 7


// `try { body } finally { fin }`: with no throw, the body runs and then
// `finally` still fires.
fn main() -> i32 {
    let total = 0;
    let result = try {
        total += 4;
        7
    } finally {
        total += 0;
    };
    println(f"{total} {result}");
    return total + result;   // 4 + 7 = 11
}


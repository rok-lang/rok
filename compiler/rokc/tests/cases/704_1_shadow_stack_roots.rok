// expect-exit: 0
// expect-stdout:
// alpha-0 beta-1
// gamma 3
// depth 20 ok

// Every GC reference held in a local (or a struct field in a
// local) across a call is a shadow-stack root; a collection inside a
// callee must not free or corrupt it, at any call depth.
extern "C" {
    fn rok_gc_collect();
}

struct Holder { name: str; items: List<str>; }

fn churn() {
    let i = 0;
    while i < 5000 { let _g = f"tmp{i}"; i += 1; }
    unsafe { rok_gc_collect() };
}

fn deep(n: i32, acc: str) -> str {
    if n == 0 { churn(); return acc; }
    let mine = f"{acc}.{n}";
    let r = deep(n - 1, mine);
    if mine.len() == 0 { return ""; }
    return r;
}

fn main() -> i32 {
    let a = f"alpha-{0}";
    let b = f"beta-{1}";
    churn();
    println(f"{a} {b}");
    let h = Holder { name: f"gam{"ma"}", items: [f"a{1}", f"b{2}", f"c{3}"] };
    churn();
    println(f"{h.name} {h.items.len()}");
    let r = deep(20, "r");
    println(f"depth 20 {if r.starts_with("r.20.19") && r.ends_with(".2.1") { "ok" } else { r }}");
    return 0;
}
